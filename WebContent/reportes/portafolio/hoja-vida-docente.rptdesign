                        <property name="dataType">string</property>
                    </structure>
                </list-property>
            </structure>
            <property name="dataSource">Oracle</property>
            <list-property name="parameters">
                <structure>
                    <property name="name">inv</property>
                    <property name="paramName">inv</property>
                    <property name="dataType">string</property>
                    <property name="position">1</property>
                    <property name="isInput">true</property>
                    <property name="isOutput">false</property>
                </structure>
            </list-property>
            <list-property name="resultSet">
                <structure>
                    <property name="position">1</property>
                    <property name="name">NOMBREPROYECTO</property>
                    <property name="nativeName">NOMBREPROYECTO</property>
                    <property name="dataType">string</property>
                </structure>
            </list-property>
            <property name="queryText">select '- '||p.PRY_NOMBRE as nombreProyecto
from HER_INVESTIGADOR_PROYECTO ip , HER_PROYECTO P
where
ip.INV_ID = ?1
and ip.INP_TIPO = 'P'
and ip.PRY_ID = p.PRY_ID
and p.EPR_ID in ('A','AP','F')
order by p.PRY_NOMBRE</property>
        </oda-data-set>

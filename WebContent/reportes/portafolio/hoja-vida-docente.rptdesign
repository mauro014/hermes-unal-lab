            <property name="queryText">select '- '||g.GRU_NOMBRE as nombreGrupo
from HER_INVESTIGADOR_GRUPO ig, HER_GRUPO g
where ig.INV_ID = ?1
and g.EGR_ID in ('A')
and g.GRU_ID = ig.GRU_ID
order by g.GRU_NOMBRE</property>

            </list-property>
            <property name="queryText">select decode(ip.IPU_TIPO,'PUB_NAC','Publicación nacional','PUB_INT','Publicación internacional','PUB_LIB','Libro','PUB_TES','Tesis','') as tipo,
'- ' ||ip.IPU_AUTORES || ' ' || ip.IPU_PUBLICACION as publicacion
from HER_INVESTIGADOR_PUBLICACION ip
where ip.INV_ID = ?1
and ip.IPU_TIPO = 'PUB_INT'
order by ip.IPU_TIPO asc</property>
        </oda-data-set>
        <oda-data-set extensionID="org.eclipse.birt.report.data.oda.jdbc.JdbcSelectDataSet" name="Obras" id="8925">
            <structure name="cachedMetaData">
                <list-property name="resultSet">
                    <structure>
                        <property name="position">1</property>
                        <property name="name">OBRA</property>
                        <property name="dataType">string</property>
                    </structure>
                </list-property>
            </structure>
            <property name="dataSource">Oracle</property>
            <list-property name="parameters">
                <structure>
                    <property name="name">inv</property>
                    <property name="paramName">inv</property>
                    <property name="dataType">string</property>
                    <property name="position">1</property>
                    <property name="isInput">true</property>
                    <property name="isOutput">false</property>
                </structure>
            </list-property>
            <list-property name="resultSet">
                <structure>
                    <property name="position">1</property>
                    <property name="name">OBRA</property>
                    <property name="nativeName">OBRA</property>
                    <property name="dataType">string</property>
                </structure>
            </list-property>
            <property name="queryText">select '- '||ioe.IOE_NOMBRE_OBRA ||' - '|| TO_CHAR(ioe.IOE_FECHA_OBRA, 'FMMonth DD, YYYY') || ', en ' || ioe.IOE_NOMBRE_EXPOSICION
|| ', ' ||p.PAIS_NOMBRE || ', ' || TO_CHAR(ioe.IOE_FECHA_EXPOSICION, 'FMMonth DD, YYYY') as obra
from HER_INVESTIGADOR_OBRA_EXP ioe left join HER_PAIS p on ioe.PAIS_ID = p.PAIS_ID
where ioe.INV_ID = ?1
and p.PAIS_ID &lt;> '00'
order by ioe.IOE_NOMBRE_OBRA</property>
        </oda-data-set>

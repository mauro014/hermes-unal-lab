                </structure>
            </list-property>
            <property name="queryText">select '- '||a.NMBRE_ASIGNATURA ||' ('||a.NIVEL||') - '||d.dpn_nombre AS ASIGNATURA
from HER_INVESTIGADOR_ASIGNATURA ia, SIA_V_ASIGNATURAS_HERMES a left join HER_DEPENDENCIA d on d.dpn_id = a.uab
where ia.INV_ID = ?1
and ia.ASI_ID = a.ASI_ID
order by a.NMBRE_ASIGNATURA</property>
        </oda-data-set>

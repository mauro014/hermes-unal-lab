            <list-property name="parameters">
                <structure>
                    <property name="name">inv</property>
                    <property name="paramName">inv</property>
                    <property name="dataType">string</property>
                    <property name="position">1</property>
                    <property name="isInput">true</property>
                    <property name="isOutput">false</property>
                </structure>
            </list-property>
            <list-property name="resultSet">
                <structure>
                    <property name="position">1</property>
                    <property name="name">EVENTO</property>
                    <property name="nativeName">EVENTO</property>
                    <property name="dataType">string</property>
                </structure>
            </list-property>
            <property name="queryText">select '- '|| ie.INE_TITULO_TRABAJO || '; ' || ie.INE_NOMBRE_EVENTO || ', ' || ie.INE_CIUDAD_PAIS || ', ' || p.PAIS_NOMBRE || ', ' ||TO_CHAR(ie.INE_FECHA, 'FMMonth DD, YYYY') as evento
from HER_INVESTIGADOR_EVENTO ie, HER_PAIS p
where ie.INV_ID = ?1
and p.PAIS_ID = ie.PAIS_ID
order by ie.INE_FECHA asc</property>
        </oda-data-set>
    </data-sets>

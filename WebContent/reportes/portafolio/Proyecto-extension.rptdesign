    <data-sets>
        <oda-data-set extensionID="org.eclipse.birt.report.data.oda.jdbc.JdbcSelectDataSet" name="Proyecto" id="1195">
            <structure name="cachedMetaData"/>
            <property name="dataSource">Oracle</property>
            <list-property name="parameters">
                <structure>
                    <property name="name">pry</property>
                    <property name="paramName">pry</property>
                    <property name="dataType">string</property>
                    <property name="position">1</property>
                    <property name="isInput">true</property>
                    <property name="isOutput">false</property>
                </structure>
            </list-property>
            <property name="queryText">select p.id_proyecto as id, p.nombre as nombre, p.uab as DEPENDENCIA, 
	p.responsable as investigador, p.email as emailResp,
	'Sede '|| p.sede as sede, p.estado as estado, p.objeto as resumen,
	p.sub_modalidad as tituloModalidad, p.modalidad as tituloConvocatoria
from proyectos_ext@extension p where 
	p.id_proyecto = ?


</property>
        </oda-data-set>
    </data-sets>

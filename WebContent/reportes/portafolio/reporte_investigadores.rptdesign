    <data-sets>
        <oda-data-set extensionID="org.eclipse.birt.report.data.oda.jdbc.JdbcSelectDataSet" name="FiltroFacultad" id="8285">
            <structure name="cachedMetaData">
                <list-property name="resultSet">
                    <structure>
                        <property name="position">1</property>
                        <property name="name">FACULTAD</property>
                        <property name="dataType">string</property>
                    </structure>
                </list-property>
            </structure>
            <property name="dataSource">Oracle</property>
            <list-property name="parameters">
                <structure>
                    <property name="name">fac</property>
                    <property name="paramName">fac</property>
                    <property name="dataType">string</property>
                    <property name="position">1</property>
                    <property name="isInput">true</property>
                    <property name="isOutput">false</property>
                </structure>
            </list-property>
            <list-property name="resultSet">
                <structure>
                    <property name="position">1</property>
                    <property name="name">FACULTAD</property>
                    <property name="nativeName">FACULTAD</property>
                    <property name="dataType">string</property>
                </structure>
            </list-property>
            <property name="queryText">select decode(d.dpn_id,'0','Toda la sede','1','Todas',d.dpn_nombre) as facultad
from her_dependencia d
where
d.dpn_id = ?

</property>
        </oda-data-set>
        <oda-data-set extensionID="org.eclipse.birt.report.data.oda.jdbc.JdbcSelectDataSet" name="FiltroSede" id="8282">
            <structure name="cachedMetaData">
                <list-property name="resultSet">
                    <structure>
                        <property name="position">1</property>
                        <property name="name">SEDE</property>
                        <property name="dataType">string</property>
                    </structure>
                </list-property>
            </structure>
            <property name="dataSource">Oracle</property>
            <list-property name="parameters">
                <structure>
                    <property name="name">sed</property>
                    <property name="paramName">sed</property>
                    <property name="dataType">string</property>
                    <property name="position">1</property>
                    <property name="isInput">true</property>
                    <property name="isOutput">false</property>
                </structure>
            </list-property>
            <list-property name="resultSet">
                <structure>
                    <property name="position">1</property>
                    <property name="name">SEDE</property>
                    <property name="nativeName">SEDE</property>
                    <property name="dataType">string</property>
                </structure>
            </list-property>
            <property name="queryText">select decode(s.sed_id,0,'Nivel Nacional','Sede '||s.sed_nombre) as sede
from her_sede s
where
s.sed_id = ?

</property>
        </oda-data-set>

            <list-property name="parameters">
                <structure>
                    <property name="name">PARAM_ID</property>
                    <property name="paramName">ListaId</property>
                    <property name="dataType">string</property>
                    <property name="position">1</property>
                    <property name="isInput">true</property>
                    <property name="isOutput">false</property>
                </structure>
            </list-property>
            <list-property name="resultSet">
                <structure>
                    <property name="position">1</property>
                    <property name="name">PER_ID</property>
                    <property name="nativeName">PER_ID</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">2</property>
                    <property name="name">INVESTIGADOR</property>
                    <property name="nativeName">INVESTIGADOR</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">3</property>
                    <property name="name">PER_EMAIL</property>
                    <property name="nativeName">PER_EMAIL</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">4</property>
                    <property name="name">FACULTAD</property>
                    <property name="nativeName">FACULTAD</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">5</property>
                    <property name="name">SEDE</property>
                    <property name="nativeName">SEDE</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">6</property>
                    <property name="name">DEPENDENCIA</property>
                    <property name="nativeName">DEPENDENCIA</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">7</property>
                    <property name="name">EMAIL</property>
                    <property name="nativeName">EMAIL</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">8</property>
                    <property name="name">TELEFONO</property>
                    <property name="nativeName">TELEFONO</property>
                    <property name="dataType">string</property>
                </structure>
            </list-property>
            <property name="queryText">select per.PER_ID,per.PER_NOMBRE1 ||' '|| per.PER_NOMBRE2 ||' '|| per.PER_APELLIDO1 ||' '|| per.PER_APELLIDO2 as investigador,
per.PER_EMAIL, d2.dpn_nombre as facultad, 'Sede '||s.sed_nombre as sede, d.dpn_nombre as dependencia, decode (per.PER_EMAIL, null , 'No disponible', per.PER_EMAIL ) email,
dd.domdet_descripcion || ' Ext. ' || decode (inv.INI_TEXTENSION, null , 'No disponible', inv.INI_TEXTENSION ) telefono
from her_investigador_interno inv, her_dependencia d, her_dependencia d2, her_persona per, her_sede s, her_dominio_detalle dd 
where per.PER_ID in (select COLUMN_VALUE from TABLE(SPLIT(?))) and per.PER_ID = inv.INV_ID
and inv.dpn_id = d.dpn_id
and d2.dpn_id = d.dpn_facultad
and s.sed_id = d2.sed_id
and s.sed_id = dd.domdet_tipo
and dd.dom_id = 122
ORDER BY per.per_nombre1, per.per_nombre2, per.per_apellido1, per.per_apellido2

</property>
        </oda-data-set>
    </data-sets>

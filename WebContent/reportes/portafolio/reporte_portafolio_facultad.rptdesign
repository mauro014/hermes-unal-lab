            <property name="queryText">select   decode (rtrim (xmlagg (xmlelement (e,LIN_NOMBRE || '; ')).extract ('//text()'), ','),null,'No disponible',rtrim (xmlagg (xmlelement (e,LIN_NOMBRE || '; ')).extract ('//text()'))) LINEAS
from HERMES.HER_GRUPO_LINEA gl , HER_LINEA_INVESTIGACION li
where gl.GRU_ID = ?1 and gl.LIN_ID = li.LIN_ID</property>

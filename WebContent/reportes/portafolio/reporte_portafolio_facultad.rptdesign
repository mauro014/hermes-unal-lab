            <property name="queryText">select G.GRU_ID, G.GRU_NOMBRE as nombre, D.DPN_NOMBRE as dependencia, per.PER_NOMBRE1 ||' '|| per.PER_NOMBRE2 ||' '|| per.PER_APELLIDO1 ||' '|| per.PER_APELLIDO2 as investigador,
EG.EGR_NOMBRE as estado, decode (G.GRU_DIRECCION, null , 'No disponible', G.GRU_DIRECCION) direccion, decode (G.GRU_URL, null ,'No disponible',G.GRU_URL) sitio, 'Sede '||S.SED_NOMBRE AS SEDE, d2.dpn_nombre as facultad, 
decode (g.GRU_TELEFONO, null ,'No disponible',g.GRU_TELEFONO) telefono, decode (g.GRU_EMAIL, null , 'No disponible', g.GRU_EMAIL ) email
from HERMES.HER_GRUPO G , HERMES.HER_DEPENDENCIA D left join her_dependencia d2 on (d.DPN_FACULTAD = d2.dpn_id), 
HERMES.HER_ESTADO_GRUPO EG, her_sede s, her_persona per, her_investigador_grupo ig
where G.DPN_ID=D.DPN_ID and EG.EGR_ID=G.EGR_ID 
and d.sed_id = s.sed_id
and per.per_id = ig.inv_id
and per.tdo_id = ig.tdo_id
and ig.gru_id = g.gru_id
and ig.ing_tipo = 'L'
and d.dpn_facultad = ?
order by G.GRU_NOMBRE</property>
        </oda-data-set>

                </structure>
            </list-property>
            <list-property name="resultSet">
                <structure>
                    <property name="position">1</property>
                    <property name="name">ID</property>
                    <property name="nativeName">ID</property>
                    <property name="dataType">decimal</property>
                </structure>
                <structure>
                    <property name="position">2</property>
                    <property name="name">NOMBRE</property>
                    <property name="nativeName">NOMBRE</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">3</property>
                    <property name="name">DEPENDENCIA</property>
                    <property name="nativeName">DEPENDENCIA</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">4</property>
                    <property name="name">INVESTIGADOR</property>
                    <property name="nativeName">INVESTIGADOR</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">5</property>
                    <property name="name">SEDE</property>
                    <property name="nativeName">SEDE</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">6</property>
                    <property name="name">ESTADO</property>
                    <property name="nativeName">ESTADO</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">7</property>
                    <property name="name">FACULTAD</property>
                    <property name="nativeName">FACULTAD</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">8</property>
                    <property name="name">TIPO</property>
                    <property name="nativeName">TIPO</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">9</property>
                    <property name="name">CONVOCATORIA</property>
                    <property name="nativeName">CONVOCATORIA</property>
                    <property name="dataType">string</property>
                </structure>
            </list-property>
            <property name="queryText">select id, nombre, DEPENDENCIA, investigador, sede, estado, facultad, tipo, convocatoria
from (
select p.pry_id as id, p.pry_nombre as nombre, d.DPN_NOMBRE as DEPENDENCIA, per.PER_NOMBRE1 ||' '|| per.PER_NOMBRE2 ||' '|| per.PER_APELLIDO1 ||' '|| per.PER_APELLIDO2 as investigador,
       s.SED_NOMBRE as sede, ep.EPR_NOMBRE as estado, d2.dpn_nombre as facultad, decode(p.pry_id,NULL,' ','(Investigación)') as tipo,
       cp.cnp_titulo||' - Año '||cp.cnp_ano as convocatoria
       from her_proyecto p left join her_convocatoria con on p.mod_id = con.con_id left join her_convocatoria_padre cp on 
       con.cnp_id = cp.cnp_id, her_investigador_proyecto ip left join her_persona per on (ip.inv_id = per.per_id and ip.tdo_id = per.tdo_id), her_investigador_interno ii, 
       her_dependencia d left join her_dependencia d2 on (d.DPN_FACULTAD = d2.dpn_id), her_sede s, her_estado_proyecto ep
       where p.PRY_ID = ip.PRY_ID and ip.INV_ID = ii.INV_ID and ip.INP_TIPO = 'P' 
       and ii.DPN_ID = d.DPN_ID 
       and d.dpn_facultad = ?
       and d.SED_ID  = s.SED_ID 
       and p.EPR_ID  = ep.EPR_ID 
       and p.epr_id in ('A','AP','F'))proyectos
order by nombre
                        
                        
                 			

</property>
        </oda-data-set>

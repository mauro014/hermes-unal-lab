                    <property name="nativeName">DEPENDENCIA</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">6</property>
                    <property name="name">EMAIL</property>
                    <property name="nativeName">EMAIL</property>

                </structure>
                <structure>
                    <property name="position">7</property>
                    <property name="name">TELEFONO</property>
                    <property name="nativeName">TELEFONO</property>
                    <property name="dataType">string</property>
                </structure>
            </list-property>
            <property name="queryText">select per.PER_ID,per.PER_NOMBRE1 ||' '|| per.PER_NOMBRE2 ||' '|| per.PER_APELLIDO1 ||' '|| per.PER_APELLIDO2 as investigador,
d2.dpn_nombre as facultad, 'Sede '||s.sed_nombre as sede, d.dpn_nombre as dependencia, decode (per.PER_EMAIL, null , 'No disponible', per.PER_EMAIL ) email,
dd.domdet_descripcion || ' Ext. ' || decode (inv.INI_TEXTENSION, null , 'No disponible', inv.INI_TEXTENSION ) telefono

from her_dependencia d left join her_investigador_interno inv on inv.dpn_id = d.dpn_id and d.dpn_facultad = ?, her_investigador i, her_dependencia d2, her_persona per, her_sede s, her_dominio_detalle dd 

where per.PER_ID = inv.INV_ID
and per.tdo_id = inv.tdo_id
and per.PER_ID = i.INV_ID
and per.tdo_id = i.tdo_id
and i.inv_interno = 'S'
and d2.dpn_id = d.dpn_facultad
and s.sed_id = d2.sed_id
and s.sed_id = dd.domdet_tipo
and dd.dom_id = 122
ORDER BY per.per_nombre1, per.per_nombre2, per.per_apellido1, per.per_apellido2

</property>
        </oda-data-set>

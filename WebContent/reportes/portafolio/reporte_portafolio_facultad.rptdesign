                    </structure>
                    <structure>
                        <property name="position">6</property>
                        <property name="name">TELEFONO</property>
                        <property name="dataType">string</property>
                    </structure>
                    <structure>
                        <property name="position">7</property>
                        <property name="name">EMAIL</property>
                        <property name="dataType">string</property>
                    </structure>
                </list-property>
            </structure>
            <property name="dataSource">Oracle</property>
            <list-property name="parameters">
                <structure>
                    <property name="name">PARAM_ID</property>
                    <property name="paramName">fac</property>
                    <property name="dataType">string</property>
                    <property name="position">1</property>
                    <property name="isInput">true</property>
                    <property name="isOutput">false</property>
                </structure>
            </list-property>
            <list-property name="resultSet">
                <structure>
                    <property name="position">1</property>
                    <property name="name">LAB_ID</property>
                    <property name="nativeName">LAB_ID</property>
                    <property name="dataType">decimal</property>
                </structure>
                <structure>
                    <property name="position">2</property>
                    <property name="name">SEDE</property>
                    <property name="nativeName">SEDE</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">3</property>
                    <property name="name">NOMBRELABORATORIO</property>
                    <property name="nativeName">NOMBRELABORATORIO</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">4</property>
                    <property name="name">FACULTAD</property>
                    <property name="nativeName">FACULTAD</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">5</property>
                    <property name="name">DEPTO</property>
                    <property name="nativeName">DEPTO</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">6</property>
                    <property name="name">TELEFONO</property>
                    <property name="nativeName">TELEFONO</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">7</property>
                    <property name="name">EMAIL</property>
                    <property name="nativeName">EMAIL</property>
                    <property name="dataType">string</property>
                </structure>
            </list-property>
            <property name="queryText">select unique(l.LAB_ID), 'Sede '||s.sed_nombre as Sede, L.LAB_NOMBRE as nombreLaboratorio, d.dpn_nombre as facultad, d2.dpn_nombre as depto,
decode (l.LAB_TELEFONO, null , 'No disponible', l.LAB_TELEFONO ) telefono, decode (l.LAB_EMAIL, null , 'No disponible', l.LAB_EMAIL ) email
from HER_LABORATORIO l, HER_SEDE s, HER_DEPENDENCIA d, HER_DEPENDENCIA 	d2 
where  s.SED_ID = l.SED_ID
and l.LAB_FACULTAD = d.dpn_id
and d.dpn_id = ?
and l.LAB_DEPTO = d2.dpn_id
and l.LAB_ACTIVO = '1'
ORDER BY nombreLaboratorio</property>
        </oda-data-set>
    </data-sets>

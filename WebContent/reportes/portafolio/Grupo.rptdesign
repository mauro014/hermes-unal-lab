            <property name="queryText">SELECT 
	PE.PLE_NOMBRE AS PLANEST
FROM 
	HER_GRUPO_PLAN GP, HER_PLAN_ESTUDIOS PE
WHERE 
	GP.GRU_ID = ?
	AND GP.PLE_ID = PE.PLE_ID
	ORDER BY PE.PLE_NOMBRE ASC</property>

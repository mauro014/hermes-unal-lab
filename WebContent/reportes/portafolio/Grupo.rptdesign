                    <property name="dataType">string</property>
                </structure>
            </list-property>
            <property name="queryText">select li.LIN_NOMBRE as nombreLinea
from HERMES.HER_GRUPO_LINEA gl , HER_LINEA_INVESTIGACION li
where
gl.GRU_ID = ?1
and gl.LIN_ID = li.LIN_ID
order by li.LIN_NOMBRE</property>
        </oda-data-set>

                    <property name="nativeName">AGENDA</property>
                    <property name="dataType">string</property>
                </structure>
            </list-property>
            <property name="queryText">SELECT 'Principal' tipo ,x.AGG_NOMBRE as agenda FROM HER_GRUPO g
INNER JOIN HER_POSIBLE_AGENDA_GRUPO x ON x.AGG_ID = g.AGG_ID
WHERE g.GRU_ID=?1
union all
SELECT 
	'Secundaria' tipo,x2.AGG_NOMBRE AS AGENDA
FROM 
	HER_GRUPO_AGENDA A
  INNER JOIN HER_POSIBLE_AGENDA_GRUPO x2 ON A.AGG_ID = x2.AGG_ID
WHERE 
	A.GRU_ID = ?2
order by tipo,agenda</property>
        </oda-data-set>

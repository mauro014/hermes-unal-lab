            <property name="queryText">select 'Primaria' Tipo,dd2.DOMDET_DESCRIPCION AREA_PADRE,dd.DOMDET_DESCRIPCION AREA from HER_GRUPO g
inner join HER_DOMINIO_DETALLE dd on dd.DOMDET_TIPO=g.DOMDET_TIPO_SUBAREA
inner join HER_DOMINIO_DETALLE dd2 on dd2.DOMDET_TIPO=dd.DOMDET_ESTADO
where g.GRU_ID=?
union all
SELECT 'Secundaria' Tipo,DD_PADRE.DOMdET_DESCRIPCION AS AREA_PADRE, DD.DOMdET_DESCRIPCION AS AREA
FROM HER_DOMINIO_DETALLE DD, HER_GRUPO_AREA_TEMATICA GAT, HER_DOMINIO_DETALLE DD_PADRE
WHERE GAT.GRU_ID = ?2
AND GAT.DOMDET_TIPO = DD.DOMDET_TIPO 
AND GAT.DOM_ID = DD.DOM_ID
AND DD.DOMDET_ESTADO = DD_PADRE.DOMDET_TIPO</property>
        </oda-data-set>

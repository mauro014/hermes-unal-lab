            <property name="queryText">select G.GRU_ID, G.GRU_NOMBRE, D.DPN_NOMBRE as dependencia, per.PER_NOMBRE1 ||' '|| per.PER_NOMBRE2 ||' '|| per.PER_APELLIDO1 ||' '|| per.PER_APELLIDO2 as investigador,
per.PER_EMAIL as emailLider,
EG.EGR_NOMBRE as estado, G.GRU_DIRECCION, G.GRU_URL, rownum as cantidad, 'Sede '||S.SED_NOMBRE AS SEDE, DBMS_LOB.substr(g.gru_presentacion, 3000) as PRESENTACION,
G.GRU_EMAIL AS EMAIL, DBMS_LOB.substr(g.gru_vision, 3000) as enfoEstrateg, DBMS_LOB.substr(g.gru_PRIORIDAD, 3000) as prioridad, ec.EGC_ID as idCol,
DBMS_LOB.substr(g.GRU_PERSPECTIVA, 3000) as perspectiva, g.GRU_CATEGORIA_COLCIENCIAS as categoria, ec.egc_nombre as estadoCol, g.GRU_COLCIENCIAS as colciencias
from HERMES.HER_GRUPO G left join HERMES.HER_DEPENDENCIA D on G.DPN_ID=D.DPN_ID
left join her_sede s on g.SED_ID = s.sed_id
left join her_estado_grupo_colciencias ec on ec.egc_id = g.egc_id, 
HERMES.HER_ESTADO_GRUPO EG, her_persona per, her_investigador_grupo ig
where EG.EGR_ID=G.EGR_ID 
and G.GRU_ID = ?1
and per.per_id = ig.inv_id
and per.tdo_id = ig.tdo_id
and ig.gru_id = g.gru_id
and ig.ing_tipo = 'L'
order by G.GRU_NOMBRE</property>
        </oda-data-set>
        <oda-data-set extensionID="org.eclipse.birt.report.data.oda.jdbc.JdbcSelectDataSet" name="LíneaGrupo" id="8383">

                </structure>
                <structure>
                    <property name="position">2</property>
                    <property name="name">NOMBRETIPO</property>
                    <property name="nativeName">NOMBRETIPO</property>
                    <property name="dataType">string</property>
                </structure>
            </list-property>
            <property name="queryText">select p.PER_NOMBRE1 ||' '|| p.PER_NOMBRE2 ||' '|| p.PER_APELLIDO1 ||' '|| p.PER_APELLIDO2 as integrante,
itg.IGT_NOMBRE as nombreTipo
from HER_INVESTIGADOR_GRUPO ig , HER_PERSONA p, HER_INVESTIGADOR_GRUPO_TIPO itg
where
ig.GRU_ID = ?1
and ig.INV_ID = p.PER_ID
and ig.TDO_ID = p.TDO_ID
and itg.IGT_ID = ig.ING_TIPO
and ig.ING_TIPO &lt;> 'L'
order by itg.IGT_NOMBRE</property>
        </oda-data-set>

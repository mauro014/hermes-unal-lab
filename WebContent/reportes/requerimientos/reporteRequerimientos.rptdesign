                </structure>
            </list-property>
            <property name="queryText">SELECT
	R.REQ_ID AS "ID Requerimiento",
	R.REQ_FECHA_SOLICITUD AS "Fecha Solicitud",
	R.REQ_PRIORIDAD AS "Prioridad",
	R.REQ_ESTADO AS "Estado",
	R.TDO_ID||'-'||R.PER_ID AS "Documento Solicitante",
	PER.PER_EMAIL AS "Correo Solicitante",
	PER.PER_APELLIDO1||' '||DECODE(PER.PER_APELLIDO2, PER.PER_APELLIDO2,PER.PER_APELLIDO2,NULL,' ')||' '||PER.PER_NOMBRE1||' '||DECODE(PER.PER_NOMBRE2, PER.PER_NOMBRE2,PER.PER_NOMBRE2,NULL,' ') AS "Nombre Solicitante",
	dd.DOMDET_DESCRIPCION AS "Módulo",
	R.REQ_DESCRIPCION AS "Descripción de Solicitud",
	R.REQ_COMENTARIOS AS "Comentarios al Solicitante",
	R.REQ_FECHA_ESTIMADA AS "Fecha Estimada Entrega",
	R.REQ_FECHA_ENTREGA AS "Fecha Solución",
	PER2.PER_APELLIDO1||' '||DECODE(PER2.PER_APELLIDO2, PER2.PER_APELLIDO2,PER2.PER_APELLIDO2,NULL,' ')||' '||PER2.PER_NOMBRE1||' '||DECODE(PER2.PER_NOMBRE2, PER2.PER_NOMBRE2,PER2.PER_NOMBRE2,NULL,' ') AS "Ingeniero Asignado",
	decode(PER2.PER_ID,null,'',PER2.TDO_ID||'-'||PER2.PER_ID) AS "Documento Ingeniero",
	PER2.PER_EMAIL AS "Correo Ingeniero",
	R.REQ_COMENTARIOS_ING AS "Comentarios al Ingeniero",
	R.REQ_SPRINT AS "Sprint Asignado"
FROM
	HER_REQUERIMIENTO R
		LEFT JOIN HER_DOMINIO_DETALLE dd ON MDL_NOMBRE = dd.DOMDET_TIPO AND dd.DOM_ID = '113'
		LEFT JOIN HER_PERSONA PER ON R.PER_ID = PER.PER_ID AND R.TDO_ID = PER.TDO_ID
		LEFT JOIN HER_PERSONA PER2 ON R.REQ_RECURSO = PER2.PER_ID AND PER2.PER_ID &lt;>'0'
WHERE
	R.REQ_TIPO = 'Mejora' AND
	R.REQ_FECHA_SOLICITUD >= ?1 AND
	R.REQ_FECHA_SOLICITUD &lt;= ?2 
order by
	R.REQ_ID</property>
        </oda-data-set>

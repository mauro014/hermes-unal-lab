            <property name="queryText">SELECT PRY.PRY_NOMBRE, PRY.PRY_ID, PRY.PRY_CODIGO_DIB,PAR.VALOR Director,
PER.PER_NOMBRE1||' '||DECODE(PER.PER_NOMBRE2, PER.PER_NOMBRE2,PER.PER_NOMBRE2,NULL,' ')
||' '||PER.PER_APELLIDO1||' '||DECODE(PER.PER_APELLIDO2, PER.PER_APELLIDO2,PER.PER_APELLIDO2,NULL,' ')PRINCIPAL,
DPN1.DPN_NOMBRE FAC, 
DPN.DPN_NOMBRE DEPTO, 
CNP.CNP_TITULO, 
CON.CON_TITULO,
PRY.PRY_DURACION, 
S.SED_CIUDAD SEDE , 
SYSDATE FECHA,
to_char(pry.PRY_OBJETIVO_GENERAL) as PRY_OBJETIVO_GENERAL,
domdet_descripcion || ' ' || pry.PRY_ACTO_ADM_EXTERNO as tipoActo,
dpa.dpn_nombre dpa_acto,
'De conformidad con lo aprobado por el ' AS TXT1,
'En su sesión del ' AS TXT2,
', sobre los proyectos analizados ' || decode(CON.CON_id,2,'',10,'en el marco de la Convocatoria externa ', ' en el marco de la ' || CNP.CNP_TITULO || ', ' 
|| CON.CON_TITULO) || ', el (la) profesor(a) ' || PER.PER_NOMBRE1||' '||DECODE(PER.PER_NOMBRE2, PER.PER_NOMBRE2,PER.PER_NOMBRE2,NULL,' ')||' '||PER.PER_APELLIDO1||' '||
DECODE(PER.PER_APELLIDO2, PER.PER_APELLIDO2,PER.PER_APELLIDO2,NULL,' ') || ', adscrito(a) al ' || DPN.DPN_NOMBRE || ' de la (del) ' || DPN1.DPN_NOMBRE || ', responsable del proyecto ' || '"' || PRY.PRY_NOMBRE || '"' AS TXT3,
'De conformidad con el ' || domdet_descripcion || ' ' || PRY_CUPOS_DESCUENTO || ' de la ' || dpa.dpn_nombre || 
', en el marco de la convocatoria ' || CNP.CNP_TITULO || ', ' || CON.CON_TITULO || ', se aprobó la ejecución del proyecto "' as text1,
'", código HERMES ' || PRY.PRY_ID || ',' AS TEXT2,
' por un monto de ' AS TEXTFINANC,
', bajo la dirección del (de la) profesor(a) ' || 
PER.PER_NOMBRE1 || ' ' || DECODE(PER.PER_NOMBRE2, PER.PER_NOMBRE2,PER.PER_NOMBRE2,NULL,' ')||' '||PER.PER_APELLIDO1||' '||DECODE(PER.PER_APELLIDO2, PER.PER_APELLIDO2,PER.PER_APELLIDO2,NULL,' ') ||
', identificado con el documento ' || PER.TDO_ID || ' - ' || PER.PER_ID || ', adscrito(a) al ' || DPN.DPN_NOMBRE || ' de la (del) ' || DPN1.DPN_NOMBRE 
|| ' con la empresa QUIPU ' || PRY.PRY_EMPRESA_EJECUTORA || ' con las siguientes condiciones:' AS TEXT3,
add_months(pry.PRY_FECHA_TENTATIVA_INICIO,pry.PRY_DURACION) FFinal,
PRY.PRY_FECHA_TENTATIVA_INICIO, 
    (
    SELECT SUM(FIN.FIN_VALOR)
    FROM HER_FINANCIACION FIN, 
    HER_FUENTE_FINANCIACION FFI WHERE
    PRY.PRY_ID = FIN.PRY_ID
    AND  FIN.FFI_ID = FFI.FFI_ID
    AND  FFI.FFI_INTERNA_EXTERNA in ('I','O')
    AND (FIN.FFE_TIPO_ENTIDAD = 'F' OR FIN.FFE_TIPO_ENTIDAD is null)
    AND (FIN.FIN_ES_LEGALIZACION IS NULL OR  FIN.FIN_ES_LEGALIZACION = 'NO')) AS FIN_VALOR
FROM HER_CONVOCATORIA_PADRE CNP, HER_CONVOCATORIA CON, HER_SEDE S,
HER_PROYECTO PRY, HER_INVESTIGADOR_PROYECTO INP, HER_PERSONA PER,
HER_DEPENDENCIA DPN,  HER_DEPENDENCIA DPN1, HER_INVESTIGADOR_INTERNO INI,
HER_PARAMETRO PAR, her_dominio_detalle dd, her_dominio d,
her_dependencia dpa
WHERE
     PRY.MOD_ID = CON.CON_ID
AND  CON.CNP_ID = CNP.CNP_ID
AND  PRY.PRY_ID = ?
AND  PER.PER_ID = INI.INV_ID
AND  PER.TDO_ID = INI.TDO_ID
AND  INP.INV_ID = PER.PER_ID
AND  PRY.PRY_ID = INP.PRY_ID
AND INP.INP_TIPO ='P'
AND  DPN.DPN_ID   = INI.DPN_ID
AND  DPN.DPN_ID_2 = DPN1.DPN_ID
AND  DPN.SED_ID = S.SED_ID
AND  PAR.NOMBRE = 'SEG_DIRECTOR_DIB'
AND d.dom_id = dd.dom_id 
AND d.DOM_TIPO = 'TIPO_ACTO_ADMINISTRATIVOS'
AND dd.domdet_tipo = PRY.PRY_ACTO_ADM_EXTERNO
and dpa.dpn_id = pry.PRY_UNIDAD_EJECUTORA</property>

            <property name="queryText">SELECT PRY.PRY_NOMBRE, PRY.PRY_ID, PRY.PRY_CODIGO_DIB,PAR.VALOR Director,
add_months(pry.PRY_FECHA_TENTATIVA_INICIO,pry.PRY_DURACION) FECHAFinal,
PER.PER_NOMBRE1||' '||DECODE(PER.PER_NOMBRE2, PER.PER_NOMBRE2,PER.PER_NOMBRE2,NULL,' ')||' '||PER.PER_APELLIDO1||' '||
DECODE(PER.PER_APELLIDO2, PER.PER_APELLIDO2,PER.PER_APELLIDO2,NULL,' ')PRINCIPAL,
DPN1.DPN_NOMBRE FAC, DPN.DPN_NOMBRE DEPTO, CNP.CNP_TITULO, CON.CON_TITULO, PRY.PRY_DURACION, 
S.SED_CIUDAD SEDE , SYSDATE FECHA, decode(pry.pry_es_jorn_docente,null,'N',pry.pry_es_jorn_docente)pry_es_jorn_docente,
pry.PRY_FECHA_TENTATIVA_INICIO,
'De conformidad con lo aprobado por el ' AS TEXT1,
', en su sesión del ' AS TEXT2,', sobre los proyectos analizados ' || decode(CON.CON_id,2,'',10,'en el marco de la Convocatoria externa ', ' en el marco de la ' || CNP.CNP_TITULO || ', ' 
|| CON.CON_TITULO) || ', el (la) profesor(a) ' || PER.PER_NOMBRE1||' '||DECODE(PER.PER_NOMBRE2, PER.PER_NOMBRE2,PER.PER_NOMBRE2,NULL,' ')||' '||PER.PER_APELLIDO1||' '||
DECODE(PER.PER_APELLIDO2, PER.PER_APELLIDO2,PER.PER_APELLIDO2,NULL,' ') || ', adscrito(a) al ' || DPN.DPN_NOMBRE || ' de la (del) ' || DPN1.DPN_NOMBRE || ', responsable del proyecto ' || '"' || PRY.PRY_NOMBRE || '"' AS TEXT3,
(SELECT decode(AVANCE.NUMERO_INFORMES,1,' un informe ', 0,' un informe ', AVANCE.NUMERO_INFORMES || ' informes ' ) as TEXTO_INFORMES 
FROM (SELECT COUNT(*) AS NUMERO_INFORMES FROM HER_PROYECTO_COMPROMISO PC WHERE PC.PRY_ID = ?  AND TIN_ID = '1') AVANCE WHERE NUMERO_INFORMES > 0) as PARCIALES,
(SELECT COM_FECHA_VENCIMIENTO FROM HER_PROYECTO_COMPROMISO PC WHERE PC.PRY_ID = ?  AND TIN_ID = '2') as FINAL
FROM HER_CONVOCATORIA_PADRE CNP, HER_CONVOCATORIA CON, HER_SEDE S,
HER_PROYECTO PRY, HER_INVESTIGADOR_PROYECTO INP, HER_PERSONA PER,
HER_DEPENDENCIA DPN,  HER_DEPENDENCIA DPN1, HER_INVESTIGADOR_INTERNO INI,HER_PARAMETRO PAR
WHERE
     PRY.MOD_ID = CON.CON_ID
AND  CON.CNP_ID = CNP.CNP_ID
AND  PRY.PRY_ID = ? 
AND  PER.PER_ID = INI.INV_ID
AND  PER.TDO_ID = INI.TDO_ID
AND  INP.INV_ID = PER.PER_ID
AND  PRY.PRY_ID = INP.PRY_ID
AND INP.INP_TIPO ='P'
AND  DPN.DPN_ID   = INI.DPN_ID
AND  DPN.DPN_ID_2 = DPN1.DPN_ID
AND  DPN.SED_ID = S.SED_ID
AND  PAR.NOMBRE = 'SEG_DIRECTOR_DIB'</property>

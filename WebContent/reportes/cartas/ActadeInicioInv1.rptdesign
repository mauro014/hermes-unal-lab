            <property name="queryText">SELECT 'De conformidad con lo aprobado por el ' T1,
'Comité de selección' || ',' T2,
' en su sesión del ' || ',' T3,
' sobre los proyectos analizados en el marco de la ' || CNP.CNP_TITULO || ', ' 
|| CON.CON_TITULO || ', el (la) profesor(a) ' T4,
', adscrito(a) al ' T5,
' del (de la) ' T6,
', responsable del proyecto " ' T7,
'" , código ' T8,
', por un monto de ' T9,
' quien es director de la tesis de ' || PLE_NOMBRE || ' desarrollada por el estudiante ' T10, 
' se compromete con los términos descritos a continuación:  ' T11,
PRY.PRY_NOMBRE, PRY.PRY_ID, PRY.PRY_CODIGO_DIB,PAR.VALOR Director, pry_duracion,
PER.PER_NOMBRE1||' '||DECODE(PER.PER_NOMBRE2, PER.PER_NOMBRE2,PER.PER_NOMBRE2,NULL,' ')||' '||PER.PER_APELLIDO1||' '||DECODE(PER.PER_APELLIDO2, PER.PER_APELLIDO2,PER.PER_APELLIDO2,NULL,' ')PRINCIPAL,
EST.EST_NOMBRE1||' '||DECODE(EST.EST_NOMBRE2, EST.EST_NOMBRE2,EST.EST_NOMBRE2,NULL,' ')||' '||EST.EST_APELLIDO1||' '||DECODE(EST.EST_APELLIDO2, EST.EST_APELLIDO2,EST.EST_APELLIDO2,NULL,' ')ESTUDIANTE,
DPN1.DPN_NOMBRE FAC, DPN.DPN_NOMBRE DEPTO, CNP.CNP_TITULO, CON.CON_TITULO,FIN.FIN_VALOR, PLE.PLE_NOMBRE
FROM HER_CONVOCATORIA_PADRE CNP, HER_CONVOCATORIA CON, 
HER_PROYECTO PRY, HER_INVESTIGADOR_PROYECTO INP, HER_PERSONA PER,
HER_DEPENDENCIA DPN,  HER_DEPENDENCIA DPN1, HER_INVESTIGADOR_INTERNO INI,HER_FINANCIACION FIN, HER_FUENTE_FINANCIACION FFI, HER_PARAMETRO PAR,
HER_INVESTIGADOR_PROYECTO INP1, HER_TMP_ESTUDIANTE EST, HER_PLAN_ESTUDIOS PLE
WHERE
     PRY.MOD_ID = CON.CON_ID
AND  CON.CNP_ID = CNP.CNP_ID
AND  PRY.PRY_ID = ?
AND  PER.PER_ID = INI.INV_ID
AND  PER.TDO_ID = INI.TDO_ID
AND  INP.INV_ID = PER.PER_ID
AND  PRY.PRY_ID = INP.PRY_ID
AND  FIN.FFI_ID = FFI.FFI_ID
AND PRY.PRY_ID = FIN.PRY_ID
AND  FFI.FFI_INTERNA_EXTERNA IN ('I','O')
AND INP.INP_TIPO ='P'
AND  DPN.DPN_ID   = INI.DPN_ID
AND  DPN.DPN_ID_2 = DPN1.DPN_ID
AND  PAR.NOMBRE = 'SEG_DIRECTOR_DIB'
AND EST.EST_ID = ?
AND PRY.PRY_ID = INP1.PRY_ID
AND INP1.INV_ID = EST.EST_ID
AND INP1.TDO_ID = EST.TDO_ID
AND EST.EST_PLAN = PLE.PLE_ID</property>
            <xml-property name="designerValues"><![CDATA[<?xml version="1.0" encoding="UTF-8"?>

            <property name="queryText">SELECT decode(AVANCE.NUMERO_INFORMES,1,' un informe ', 0,' un informe ', AVANCE.NUMERO_INFORMES || ' informes ' ) as TEXTO_INFORMES 
FROM (SELECT COUNT(*) AS NUMERO_INFORMES FROM HER_PROYECTO_COMPROMISO PC WHERE PC.PRY_ID = ? AND TIN_ID = '1') AVANCE WHERE NUMERO_INFORMES > 0</property>

                </structure>
            </list-property>
            <list-property name="resultSet">
                <structure>
                    <property name="position">1</property>
                    <property name="name">SOL_ID</property>
                    <property name="nativeName">SOL_ID</property>
                    <property name="dataType">decimal</property>
                </structure>
                <structure>
                    <property name="position">2</property>
                    <property name="name">TSO_ID</property>
                    <property name="nativeName">TSO_ID</property>
                    <property name="dataType">decimal</property>
                </structure>
                <structure>
                    <property name="position">3</property>
                    <property name="name">TIPO_SOLICITUD</property>
                    <property name="nativeName">TIPO_SOLICITUD</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">4</property>
                    <property name="name">NOMBRE</property>
                    <property name="nativeName">NOMBRE</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">5</property>
                    <property name="name">TDO_NOMBRE</property>
                    <property name="nativeName">TDO_NOMBRE</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">6</property>
                    <property name="name">PER_ID</property>
                    <property name="nativeName">PER_ID</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">7</property>
                    <property name="name">TEXT1</property>
                    <property name="nativeName">TEXT1</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">8</property>
                    <property name="name">TEXT2</property>
                    <property name="nativeName">TEXT2</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">9</property>
                    <property name="name">FACULTAD_DOCENTE</property>
                    <property name="nativeName">FACULTAD_DOCENTE</property>
                    <property name="dataType">string</property>
                </structure>
            </list-property>
            <property name="queryText">select s.sol_id 
       ,s.tso_id
       ,decode(s.tso_id, 22, 'Prórroga'
                       , 23, 'Traslado presupuestal entre rubros'
                       , 24, 'Cambio de investigador principal'
                       , 7,  'Cancelación'
                       , 8,  'Adición presupuestal') TIPO_SOLICITUD,
    pe.per_nombre1
    || ' '
    || nvl(pe.per_nombre2, '')
    || ' '
    || pe.per_apellido1
    || ' '
    || nvl(pe.per_apellido2, '')                                        AS nombre,
    td.tdo_nombre,
    pe.per_id,
    ' presentó una propuesta para la realización del proyecto ' AS text1,
    ', en adelante EL PROYECTO, a la entidad '                             text2,
    (select fac.dpn_nombre from her_dependencia fac where fac.dpn_id = d.dpn_facultad) AS facultad_docente
                
  from her_solicitud s left join her_solicitud_investigador si on s.sol_id = si.sol_id and si.sin_tipo_solicitud in ('E') 
  left join her_persona pe on pe.tdo_id = si.tdo_id and pe.per_id = si.inv_id left join her_investigador_interno  ii on 
  si.inv_id = ii.inv_id AND si.tdo_id = ii.tdo_id left join her_dependencia d on ii.dpn_id = d.dpn_id left join 
  her_tipo_documento td on pe.tdo_id = td.tdo_id     
 where s.sol_id = ?</property>

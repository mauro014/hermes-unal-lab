            <property name="queryText">select sa.sap_valor
       ,tr.TRU_NOMBRE rubro
       ,da.DAP_VALOR valor_rubro_adicion
       ,da.DAP_VALOR_POSTERIOR valor_rubro_adicion_posterior
       ,s.tso_id
  from HER_SOLICITUD_ADICION sa
 	   inner join her_solicitud s on sa.sol_id = s.sol_id
       inner join HER_DETALLE_ADICION da on da.sap_id = sa.sap_id
            inner join HER_TIPO_RUBRO tr on tr.TRU_ID = da.TRU_ID
 where sa.SOL_ID = ?</property>

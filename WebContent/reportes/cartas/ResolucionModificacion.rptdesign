                    <property name="name">FACULTAD_DOCENTE</property>
                    <property name="nativeName">FACULTAD_DOCENTE</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">13</property>
                    <property name="name">SOL_ID</property>
                    <property name="nativeName">SOL_ID</property>
                    <property name="dataType">decimal</property>
                </structure>

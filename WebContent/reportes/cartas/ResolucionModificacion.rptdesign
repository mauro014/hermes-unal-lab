            </list-property>
            <property name="queryText">select p.PRY_ACTO_ADM_EXTERNO
       ,p.PRY_ACT_NOMBRE 
       ,p.PRY_ACT_NUMERO
       ,c.CNV_NOMBRE
       ,c.CNV_NUM_CONTRATO
       ,c.CNV_VALOR_TOTAL
       ,c.CNV_FECHA_INICIO 
       ,c.CNV_FECHA_FIN
       ,c.CNV_VIGENCIA_LEG
       ,c.CNV_OBJETO
       ,c.CNV_MONTO_EJECUTAR_UN
       ,co.COS_NUMERO
       ,co.COS_FECHA
--       ,'mediante el Otrosí No. ' || ? || ' de fecha ' ||  to_char(to_date(?,'dd/mm/YYYY'),'dd') || ' de ' || trim(to_char(to_date(?,'dd/mm/YYYY'),'month', 'NLS_DATE_LANGUAGE = spanish')) || ' de ' || to_char(to_date(?,'dd/mm/YYYY'),'YYYY')|| ' se modifica el convenio o contrato No. ' || c.CNV_NUM_CONTRATO || '.'  TEXTO_CONVENIO
--       ,'mediante el Otrosí No. ' || ? || ' de fecha ' ||  to_char(to_date(?,'DD/MM/YYYY'),'DD') || ' de ' || trim(to_char(to_date(?,'DD/MM/YYYY'),'month', 'NLS_DATE_LANGUAGE = spanish')) || ' de ' || to_char(to_date(?,'DD/MM/YYYY'),'YYYY')|| ' se modifica el convenio o contrato No. ' || c.CNV_NUM_CONTRATO || '.'  TEXTO_CONVENIO
--       ,'mediante el Otrosí No. ' || ?1 || ' de fecha ' ||  to_char(NVL(?2,''),'DD') || ' de ' || trim(to_char(NVL(?3,''),'month', 'NLS_DATE_LANGUAGE = spanish')) || ' de ' || to_char(NVL(?4,''),'YYYY')|| ' se modifica el convenio o contrato No. ' || c.CNV_NUM_CONTRATO || '.'  TEXTO_CONVENIO
from her_proyecto p 
     ,her_convenio c left join her_convenio_otrosi co on c.CNV_ID = co.CNV_ID
where p.PRY_ID = ?
  and p.PRY_ID = c.PRY_ID  </property>

                    <property name="name">TEXT3</property>
                    <property name="nativeName">TEXT3</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">8</property>
                    <property name="name">TEXT4</property>
                    <property name="nativeName">TEXT4</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">9</property>
                    <property name="name">TEXT5</property>
                    <property name="nativeName">TEXT5</property>
                    <property name="dataType">string</property>
                </structure>
            </list-property>
            <property name="queryText">select 
s.SED_NOMBRE, 
d2.DPN_NOMBRE, 
d.DPN_ID, 
s.SED_CIUDAD,
'conforme a lo establecido en el Acuerdo 014 de 2006 que crea y organiza el Sistema de Investigación de la Universidad Nacional de Colombia y el Acuerdo 031 de 2006 del Consejo Superior Universitario "Por el cual se estructura y se establecen disposiciones para el funcionamiento del Fondo de Investigación de la Universidad Nacional de Colombia" La Universidad Nacional de Colombia por intermedio de la ' AS TEXT1,
', viene desarrollando proyectos y programas de investigación con entidades públicas y privadas.' AS TEXT2,
'de conformidad con la Resolución de Rectoría No. 040 del 15 de febrero de 2001 modificada por la Resolución de Rectoría No. 2030 de 2002 es necesario aprobar y distribuir el presupuesto para la realización de EL PROYECTO.' AS text3,
'se hace necesario aprobar la solicitud de ' as TEXT4,
'para EL PROYECTO, de acuerdo a la solicitud que reposa en el sistema HERMES.' as TEXT5
from 
her_proyecto p,
her_investigador_proyecto ip, 
her_investigador_interno i, 
her_dependencia d, 
her_sede s, 
her_dependencia d2
where 
p.PRY_ID = ?
and p.PRY_ID = ip.PRY_ID
and ip.INV_ID = i.INV_ID
and ip.TDO_ID = i.TDO_ID
and i.DPN_ID = d.DPN_ID
and ip.INP_TIPO = 'P'
and d.SED_ID = s.SED_ID
and d.DPN_FACULTAD = d2.DPN_ID

</property>

                    <property name="dataType">decimal</property>
                </structure>
                <structure>
                    <property name="position">3</property>
                    <property name="name">TEXT_RES_APR</property>
                    <property name="nativeName">TEXT_RES_APR</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">4</property>
                    <property name="name">F_RES</property>
                    <property name="nativeName">F_RES</property>
                    <property name="dataType">date-time</property>
                </structure>
                <structure>
                    <property name="position">5</property>
                    <property name="name">T_PROY</property>
                    <property name="nativeName">T_PROY</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">6</property>
                    <property name="name">NA_PROY</property>
                    <property name="nativeName">NA_PROY</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">7</property>
                    <property name="name">COM</property>
                    <property name="nativeName">COM</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">8</property>
                    <property name="name">ID</property>
                    <property name="nativeName">ID</property>
                    <property name="dataType">decimal</property>
                </structure>
            </list-property>
            <property name="queryText">SELECT pca.pca_id, pca.pry_id, '"Por la cual se modifica la resolución No ' || PCA.PCA_NUMERO  || ' del ' as TEXT_RES_APR , 
PCA.PCA_FECHA_RESOLUCION as F_RES, 
' del proyecto: ' AS T_PROY,
INITCAP(P.PRY_NOMBRE) || '.'  AS NA_PROY,
'"' AS COM,
max(pca.pca_id) over (partition by pca.pca_id) id
from HER_PROYECTO_CARTA PCA, HER_PROYECTO P
where PCA.PRY_ID = P.PRY_ID and
pca.pca_id = (
select max(pca_id) from her_proyecto_carta where pry_id = ? and etc_id in ('G','F') and TPC_ID IN ('16','17') and PCA_SUBTIPO in ('285','330','22')
group by pry_id)</property>

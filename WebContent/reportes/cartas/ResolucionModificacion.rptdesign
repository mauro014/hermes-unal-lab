            <list-property name="resultSet">
                <structure>
                    <property name="position">1</property>
                    <property name="name">RUBRO</property>
                    <property name="nativeName">RUBRO</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">2</property>
                    <property name="name">CREDITO</property>
                    <property name="nativeName">CREDITO</property>
                    <property name="dataType">decimal</property>
                </structure>
                <structure>
                    <property name="position">3</property>
                    <property name="name">CONTRA_CREDITO</property>
                    <property name="nativeName">CONTRA_CREDITO</property>
                    <property name="dataType">decimal</property>
                </structure>
            </list-property>
            <property name="queryText">SELECT RUBRO, SUM(CREDITO) AS CREDITO, SUM(CONTRA_CREDITO) CONTRA_CREDITO FROM (SELECT TRU_ORI.TRU_NOMBRE RUBRO, 0 CREDITO, DCR.DCR_VALOR CONTRA_CREDITO
FROM HER_SOLICITUD SOL, HER_TIPO_RUBRO TRU_ORI, HER_GASTO GST, HER_DETALLE_CAMBIO_RUBRO DCR
WHERE
SOL.SOL_ID = DCR.SOL_ID
AND DCR.GST_ID = GST.GST_ID
AND sol.SOL_RESPUESTA = 'A'
AND TRU_ORI.TRU_ID =  GST.TRU_ID
AND SOL.SOL_ID = ?
UNION ALL
SELECT TRU_DEST.TRU_NOMBRE RUBRO, DCR.DCR_VALOR CREDITO, 0 CONTRA_CREDITO
FROM HER_SOLICITUD SOL,  HER_TIPO_RUBRO TRU_DEST, HER_GASTO GST, HER_DETALLE_CAMBIO_RUBRO DCR
WHERE
SOL.SOL_ID = DCR.SOL_ID
AND DCR.TRU_ID = TRU_DEST.TRU_ID
AND DCR.GST_ID = GST.GST_ID
AND sol.SOL_RESPUESTA = 'A'
AND SOL.SOL_ID = ?) GROUP BY RUBRO</property>

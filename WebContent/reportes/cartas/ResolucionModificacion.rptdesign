            <property name="queryText">select ff.FFI_DESCRIPCION as firmante, ff.FFE_NIT_ENTIDAD
from her_proyecto p, her_financiacion fin, her_fuente_financiacion ff
where p.PRY_ID = ?
and p.PRY_ID = fin.PRY_ID
and fin.FFE_TIPO_ENTIDAD = 'FM'
and fin.FFI_ID = ff.FFI_ID</property>

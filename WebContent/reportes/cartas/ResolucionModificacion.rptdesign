            <property name="queryText">SELECT
    per_genero,
    pe.per_nombre1,
    pe.per_nombre2,
    pe.per_apellido1,
    pe.per_apellido2,
    pe.per_nombre1
    || ' '
    || nvl(pe.per_nombre2, '')
    || ' '
    || pe.per_apellido1
    || ' '
    || nvl(pe.per_apellido2, '')                                        AS nombre,
    td.tdo_nombre,
    pe.per_id,
    ip.inp_dedicacion_horas_semana,
    ' presentó una propuesta para la realización del proyecto ' AS text1,
    ', en adelante EL PROYECTO, a la entidad '                             text2,
    (select fac.dpn_nombre from her_dependencia fac where fac.dpn_id = d.dpn_facultad) AS facultad_docente,
    s.sol_id                                                     
FROM
    her_proyecto              p left join her_solicitud s on s.pry_id = p.pry_id and s.sol_id in ('24') and s.sol_id = ?,
    her_investigador_proyecto ip,
    her_investigador_interno  ii,
    her_dependencia           d,
    her_persona               pe,
    her_tipo_documento        td
WHERE
        p.pry_id = ?
    AND p.pry_id = ip.pry_id
    AND ip.inv_id = pe.per_id
    AND ip.tdo_id = pe.tdo_id
    AND ip.inp_tipo in ('P')
    AND pe.tdo_id = td.tdo_id
    AND ip.inv_id = ii.inv_id
    AND ip.tdo_id = ii.tdo_id
    AND ii.dpn_id = d.dpn_id</property>

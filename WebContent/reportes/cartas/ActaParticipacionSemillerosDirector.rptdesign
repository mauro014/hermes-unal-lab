            </list-property>
            <property name="queryText">select per.PER_NOMBRE1 || ' ' || nvl(per.PER_NOMBRE2,'') || ' ' || per.PER_APELLIDO1 || ' ' || nvl(per.PER_APELLIDO2, '') AS "NOMBRE_PARTICIPANTE", 
inv.INV_ID as "DOC_PARTICIPANTE", 
tipodoc.TDO_NOMBRE "TIPO_DOC_PARTICIPANTE",
sem.sem_NOMBRE as "nombre_proyecto", 
dep.DPN_NOMBRE as "depDirector", 
fac.DPN_NOMBRE as "facDirector", 
sed.SED_NOMBRE as "sedeDirector",
sem.sem_id id
from her_semillero sem, 
her_investigador_interno ii, 
her_sede sed, her_dependencia dep, 
her_dependencia fac, 
her_semillero_integrante inv, 
her_persona per,
her_tipo_documento tipodoc
where sem.sem_ID = ?
and sem.sem_ID = inv.sem_ID
and inv.INV_ID = per.PER_ID
and inv.INV_ID = ii.inv_ID
and inv.TDO_ID = per.TDO_ID
and inv.TDO_ID = tipodoc.TDO_ID
and inv.sit_id = 'DD'
and dep.DPN_ID = ii.DPN_ID
and fac.DPN_ID = dep.DPN_FACULTAD
and sed.SED_ID = dep.SED_ID</property>

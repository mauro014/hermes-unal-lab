                    <property name="nativeName">INTEGRANTE</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">2</property>
                    <property name="name">SEMANAS</property>
                    <property name="nativeName">SEMANAS</property>
                    <property name="dataType">decimal</property>
                </structure>
                <structure>
                    <property name="position">3</property>
                    <property name="name">VALOR</property>
                    <property name="nativeName">VALOR</property>
                    <property name="dataType">decimal</property>
                </structure>
            </list-property>
            <property name="queryText">select 
PER.PER_NOMBRE1||' '||DECODE(PER.PER_NOMBRE2, PER.PER_NOMBRE2,PER.PER_NOMBRE2,NULL,' ')||' '||PER.PER_APELLIDO1||' '||DECODE(PER.PER_APELLIDO2, PER.PER_APELLIDO2,PER.PER_APELLIDO2,NULL,' ')integrante,
inp.SPI_NUMERO_SEMANAS semanas,
inp.spi_valor_pagar valor
from
her_solicitud_prorroga_inv inp, HER_PERSONA PER
where
inp.SOL_ID = ?
AND  INP.INV_ID = PER.PER_ID
AND  INP.TDO_ID = PER.TDO_ID
and inp.spi_estado not in ('B','N')</property>

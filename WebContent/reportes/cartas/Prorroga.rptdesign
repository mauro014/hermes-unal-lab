            <property name="queryText">select pry.PRY_ID, sol.SOL_ID, sol.SOL_FECHA,pry.PRY_ID , pry.PRY_NOMBRE, 
pry.PRY_FECHA_TENTATIVA_INICIO,pry.PRY_DURACION,
add_months(pry.PRY_FECHA_TENTATIVA_INICIO,pry.PRY_DURACION_ACUMULADA) + decode(pry.PRY_DURACION_DIAS_ACUMULADA,
NULL,0,pry.PRY_DURACION_DIAS_ACUMULADA) FFinal,
DECODE(PRY.PRY_CODIGO_QUIPU,NULL,', ','y código QUIPU '||PRY.PRY_CODIGO_QUIPU ||',') QUIPU,
sol.sol_descripcion sol_justificacion,
'Remito para su respectivo trámite, la aprobación de la solicitud de prórroga del plazo del proyecto "'||
PRY.PRY_NOMBRE || '" código HERMES '||PRY.PRY_ID||', código QUIPU '||PRY.PRY_CODIGO_QUIPU||', dirigido por ' || 
PER.PER_NOMBRE1||' '||DECODE(PER.PER_NOMBRE2, PER.PER_NOMBRE2,PER.PER_NOMBRE2,NULL,' ')||' '||
PER.PER_APELLIDO1||' '||DECODE(PER.PER_APELLIDO2, PER.PER_APELLIDO2,PER.PER_APELLIDO2,NULL,' ') ||', adscrito(a) a la '|| D2.DPN_NOMBRE || ' y sede '|| S.SED_NOMBRE || ' en el marco de la convocatoria "'||
CP.CNP_TITULO ||'". Por lo tanto la fecha de finalización será el ' TEXTO
from
her_solicitud sol, HER_PROYECTO PRY  LEFT JOIN HER_CONVOCATORIA CON ON PRY.MOD_ID = CON.CON_ID LEFT JOIN HER_CONVOCATORIA_PADRE CP ON 
CP.CNP_ID = CON.CNP_ID, HER_INVESTIGADOR_PROYECTO INP left join HER_INVESTIGADOR_INTERNO II ON II.TDO_ID = INP.TDO_ID
AND II.INV_ID = INP.INV_ID LEFT JOIN HER_DEPENDENCIA D ON II.DPN_ID = D.DPN_ID LEFT JOIN HER_DEPENDENCIA D2 
ON D.DPN_FACULTAD = D2.DPN_ID LEFT JOIN HER_SEDE S ON S.SED_ID = D.SED_ID, HER_PERSONA PER
where
    sol.TSO_ID = 22
and sol.PRY_ID = ?
AND PRY.PRY_ID = SOL.PRY_ID
and sol.SOL_ID = ?
and sol.SOL_RESPUESTA = 'A'
AND  INP.INV_ID = PER.PER_ID
AND  INP.TDO_ID = PER.TDO_ID
AND  PRY.PRY_ID = INP.PRY_ID
AND INP.INP_TIPO ='P'</property>

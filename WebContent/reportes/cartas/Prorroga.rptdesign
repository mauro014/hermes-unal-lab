            <property name="queryText">SELECT  PRY.PRY_ID, PAR.VALOR Director,
PER.PER_NOMBRE1||' '||DECODE(PER.PER_NOMBRE2, PER.PER_NOMBRE2,PER.PER_NOMBRE2,NULL,' ')||' '||PER.PER_APELLIDO1||' '||DECODE(PER.PER_APELLIDO2, PER.PER_APELLIDO2,PER.PER_APELLIDO2,NULL,' ')PRINCIPAL,
DPN1.DPN_NOMBRE FAC, DPN.DPN_NOMBRE DEPTO
FROM HER_PROYECTO PRY, HER_INVESTIGADOR_PROYECTO INP, HER_PERSONA PER,
HER_DEPENDENCIA DPN,  HER_DEPENDENCIA DPN1, HER_INVESTIGADOR_INTERNO INI,HER_PARAMETRO PAR
WHERE
     PRY.PRY_ID = ?
AND  PER.PER_ID = INI.INV_ID
AND  PER.TDO_ID = INI.TDO_ID
AND  INP.INV_ID = PER.PER_ID
AND  PRY.PRY_ID = INP.PRY_ID
AND INP.INP_TIPO ='P'
AND  DPN.DPN_ID   = INI.DPN_ID
AND  DPN.DPN_ID_2 = DPN1.DPN_ID
AND  PAR.NOMBRE = 'SEG_DIRECTOR_DIB'</property>

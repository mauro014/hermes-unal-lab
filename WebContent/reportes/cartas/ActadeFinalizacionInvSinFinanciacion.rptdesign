                    <property name="dataType">string</property>
                </structure>
            </list-property>
            <property name="queryText">SELECT '- A través de la ' || CNP.CNP_TITULO || ' en la modalidad: ' 
|| con.CON_TITULO || ' , se aprobó el proyecto ' || PRY.PRY_NOMBRE
|| ', cuyo investigador principal es el (la) profesor(a) ' 
|| PER.PER_NOMBRE1||' '||DECODE(PER.PER_NOMBRE2, PER.PER_NOMBRE2,PER.PER_NOMBRE2,NULL,' ')||
' '||PER.PER_APELLIDO1||' '||DECODE(PER.PER_APELLIDO2, PER.PER_APELLIDO2,PER.PER_APELLIDO2,NULL,' ') || '.'
as text,PRY.PRY_ID PRY_ID,PRY.PRY_CODIGO_QUIPU, DECODE(PRY.PRY_CODIGO_QUIPU,NULL,', ','y código QUIPU '||PRY.PRY_CODIGO_QUIPU||',') QUIPU 
FROM HER_CONVOCATORIA_PADRE CNP, HER_CONVOCATORIA CON, 
HER_PROYECTO PRY, HER_INVESTIGADOR_PROYECTO INP, HER_PERSONA PER,
HER_PARAMETRO PAR
WHERE
     PRY.MOD_ID = CON.CON_ID
AND  CON.CNP_ID = CNP.CNP_ID
AND  PRY.PRY_ID = ?
AND  INP.INV_ID = PER.PER_ID
AND  INP.TDO_ID = PER.TDO_ID
AND  PRY.PRY_ID = INP.PRY_ID
AND INP.INP_TIPO ='P'
AND  PAR.NOMBRE = 'SEG_DIRECTOR_DIB'</property>

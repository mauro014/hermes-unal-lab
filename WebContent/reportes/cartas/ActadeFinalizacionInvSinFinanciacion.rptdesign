                </structure>
            </list-property>
            <property name="queryText">SELECT FIN.FIN_VALOR
FROM HER_PROYECTO PRY,
HER_FINANCIACION FIN, HER_FUENTE_FINANCIACION FFI
WHERE
PRY.PRY_ID = ?
AND  FIN.FFI_ID = FFI.FFI_ID
AND PRY.PRY_ID = FIN.PRY_ID
AND  FFI.FFI_INTERNA_EXTERNA IN ('I','O')
UNION
SELECT FIN.FIN_VALOR
FROM HER_JORNADA_DOCENTE JOR, 
HER_PROYECTO PRY, 
HER_FINANCIACION FIN, HER_FUENTE_FINANCIACION FFI
WHERE
     PRY.MOD_ID = JOR.JOD_ID
AND  PRY.PRY_ID = ?
AND  FIN.FFI_ID = FFI.FFI_ID
AND PRY.PRY_ID = FIN.PRY_ID
AND  FFI.FFI_INTERNA_EXTERNA IN ('I','O')</property>

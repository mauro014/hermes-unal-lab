            </list-property>
            <list-property name="resultSet">
                <structure>
                    <property name="position">1</property>
                    <property name="name">DIRECTOR</property>
                    <property name="nativeName">DIRECTOR</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">2</property>
                    <property name="name">CARGO</property>
                    <property name="nativeName">CARGO</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">3</property>
                    <property name="name">FIRMA</property>
                    <property name="nativeName">FIRMA</property>
                    <property name="dataType">blob</property>
                </structure>
                <structure>
                    <property name="position">4</property>
                    <property name="name">CIUDAD</property>
                    <property name="nativeName">CIUDAD</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">5</property>
                    <property name="name">SYSDATE</property>
                    <property name="nativeName">SYSDATE</property>
                    <property name="dataType">date-time</property>
                </structure>
                <structure>
                    <property name="position">6</property>
                    <property name="name">NOMBREPRINCIPAL</property>
                    <property name="nativeName">NOMBREPRINCIPAL</property>
                    <property name="dataType">string</property>
                </structure>
            </list-property>
            <property name="queryText">select PAR.VALOR Director, PAR.DESCRIPCION Cargo, PAR.ADJUNTO Firma, S.SED_CIUDAD Ciudad, SYSDATE
, p.per_nombre1 || ' ' || p.per_nombre2 || ' ' || p.per_apellido1 || ' ' || p.per_apellido2 NOMBREPRINCIPAL
from 
her_parametro par, her_dependencia dep, HER_SEDE S, her_investigador_proyecto pi, her_persona p
where 
par.PROFESION = ?
and par.NOMBRE = 'SEG_FIRMA'
and dep.dPN_id = par.PROFESION
AND DEP.SED_ID = S.SED_ID
and pi.pry_id = ?
and pi.inv_id = p.per_id and pi.tdo_id = p.tdo_id
and pi.inp_tipo = 'P'</property>

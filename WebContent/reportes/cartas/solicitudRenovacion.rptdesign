            <property name="queryText">select 'Bogotá, ' || sysdate as fecha,
'Ref: Renovación créditos condonable Colciencias estudiante de ' || est.est_nombre_carrera as referencia,
'Atentamente solicito la renovación del crédito condonable del primer semestre del año 2014 del estudiante beneficiario(a) '|| 
est.est_nombre1 || ' ' || est.est_nombre2 || ' ' || est.est_apellido1 || ' ' || est.est_apellido2 || ' , identificado con C.C. número '|| est.est_id ||' como se describe a continuación:' as renovacion,
'Ya realicé la pasantía: ' || infpro.pin_prod_sara as pregunta_pasantia_vista,
'Pais: ' || infpro.pin_resumen_tecnico || ', ciudad: ' || infpro.pin_motivo_no_aprobacion || ', institución: ' || infpro.pin_observaciones || ', año: ' || infpro.PIN_DEP_AVAL_FAC || ', duración: ' ||  infpro.pin_impacto_d || ', tema: ' || infpro.pin_sipnosis_d  as informacionPasantia,
infpro.pin_avance as matricula, infpro.pin_cuadro_nombre as meses_sostenimiento, infpro.pin_dificultades as valor_sostenimiento,
infpro.pin_conclusiones as meses_pasantia, infpro.pin_sipnosis as valor_pasantia, infpro.pin_impacto as tesis, 
infpro.pin_prod_sara as preguntaPasantia,
est.est_nombre1 || ' ' || est.est_nombre2 || ' ' || est.est_apellido1 || ' ' || est.est_apellido2 as nombreEstudiante,
'Cédula de ciudadanía: ' || est.est_id as identificacion,
'Email: ' || est.est_email as email,
'Telefono: ' || est.est_telefono as telefono,
'- Fotocopia del recibo de pago o constancia de la Secretaría Académica o Tesorería de la Facultad donde se indique el valor completo a pagar por concepto de matrícula (derechos académicos y administrativos).' info
from her_tmp_estudiante est, her_proyecto_informe infpro
where infpro.pin_acto_adm_fac = est.est_id
and infpro.pin_tiene_saldo_ejec = est.tdo_id
and infpro.pin_id = ?</property>

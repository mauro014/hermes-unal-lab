                    </structure>
                </list-property>
            </structure>
            <property name="dataSource">Produccion</property>
            <list-property name="parameters">
                <structure>
                    <property name="name">param_1</property>
                    <property name="paramName">IdSol</property>
                    <property name="dataType">string</property>
                    <property name="position">1</property>
                    <property name="isInput">true</property>
                    <property name="isOutput">false</property>
                </structure>
            </list-property>
            <list-property name="resultSet">
                <structure>
                    <property name="position">1</property>
                    <property name="name">CIUDAD</property>
                    <property name="nativeName">CIUDAD</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">2</property>
                    <property name="name">DEPARTAMENTO</property>
                    <property name="nativeName">DEPARTAMENTO</property>
                    <property name="dataType">string</property>
                </structure>
            </list-property>
            <property name="queryText">SELECT C.CIU_NOMBRE AS CIUDAD,
D.DEP_NOMBRE AS DEPARTAMENTO
FROM HER_SOLICITUD_CIUDAD sc, 
HER_CIUDAD C LEFT JOIN HER_DEPARTAMENTO D ON D.DEP_ID = C.DEP_ID
WHERE 
SC.SOL_ID = ?
AND SC.CIU_ID = C.CIU_ID
</property>

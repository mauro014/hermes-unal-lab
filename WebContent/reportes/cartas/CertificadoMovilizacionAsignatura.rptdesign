            <property name="queryText">SELECT distinct PER.PER_NOMBRE1 || ' ' || PER.PER_NOMBRE2 || ' ' || PER.PER_APELLIDO1 || ' ' || PER.PER_APELLIDO2 AS NOMBRE_PERSONA,
PER.PER_ID AS DOCUMENTO,
SOL.SOL_NUMERO_ESPECIMENES AS NUMERO_ESP, SOL.SOL_FAMILIA_TAXONOMICA AS ESPECIMENES, SOL.SOL_UBICACION AS UBICACION, 
SED.SED_NOMBRE AS SEDE, decode(col_nombre,null,DD.DOMDET_DESCRIPCION,col_nombre) COLE,
'El/La Profesor(a) ' || PER.PER_NOMBRE1 || ' ' || PER.PER_NOMBRE2 || ' ' || PER.PER_APELLIDO1 || ' ' || PER.PER_APELLIDO2 ||
', identificado(a) con '|| TD.TDO_NOMBRE || ' ' || PER.PER_ID || ', vinculado(a) a la Universidad Nacional de Colombia e integrante del grupo de investigación '|| G.GRU_NOMBRE || '-' || G.GRU_COLCIENCIAS ||',  adelantará actividades de recolección de  especímenes de especies silvestres de ' ||
SOL.SOL_FAMILIA_TAXONOMICA || ', dentro de la salida de campo de la asignatura "' || decode(p.pry_asignatura_nombre,null,asig.NMBRE_ASIGNATURA ||'-'|| ASIG.COD_ASIGNATURA,p.pry_asignatura_nombre) ||
'", durante el '||SOL.SOL_FECHA_INICIO_RECOLECTA||' y '||SOL.SOL_FECHA_ESPERADA_TERMINACION||', en la(s) siguiente(s) localidad(es):' as primer_parrafo,
sysdate as fecha
FROM 
HER_PERSONA PER, HER_PROYECTO P 
LEFT JOIN HER_PROYECTO P2 ON P.PRY_CODIGO_DIB = P2.PRY_ID 
LEFT JOIN HER_DOMINIO_DETALLE DD ON DD.DOM_ID = '66' AND DD.DOMDET_TIPO = P.PRY_PMAR_CB 
LEFT JOIN HER_COLECCION C ON C.COL_ID = P.PRY_PMAR_CB
left join SIA_V_ASIGNATURAS_HERMES asig on asig.ASI_ID = p.PRY_ASIGNATURA, 
HER_INVESTIGADOR_PROYECTO IPR 
LEFT JOIN HER_AVAL A ON A.INV_ID = IPR.INV_ID AND A.AVI_TIPO = 'BI' AND A.AVI_CONVOCATORIA = '2' AND AVI_ESTADO='F' AND A.AVI_AVALFACULTAD = 'S' 
LEFT JOIN HER_GRUPO G ON A.AVI_GRUPO = G.GRU_ID,
HER_SOLICITUD SOL, HER_SEDE SED,
HER_TIPO_DOCUMENTO TD
WHERE
SOL.SOL_ID = ?
AND SOL.PRY_ID = P.PRY_ID
AND IPR.PRY_ID = P.PRY_ID
AND IPR.INV_ID = PER.PER_ID 
AND IPR.TDO_ID = PER.TDO_ID
AND SOL.SOL_SEDE = SED.SED_ID
AND TD.TDO_ID = PER.TDO_ID
AND IPR.INP_TIPO = 'P'</property>

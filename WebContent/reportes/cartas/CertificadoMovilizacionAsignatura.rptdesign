            <property name="queryText">SELECT P.PER_NOMBRE1 || ' ' || P.PER_NOMBRE2 || ' ' || P.PER_APELLIDO1 || ' ' || P.PER_APELLIDO2 AS COINVESTIGADOR,
TP.TDO_NOMBRE ||' No. '|| P.PER_ID as doc,
p.per_email as email
FROM HER_PERSONA P, HER_SOLICITUD_INVESTIGADOR SI, HER_SOLICITUD S, HER_TIPO_DOCUMENTO TP
WHERE 
SI.INV_ID = P.PER_ID AND SI.TDO_ID = P.TDO_ID
AND S.SOL_ID = SI.SOL_ID
AND S.SOL_ID = ?
AND TP.TDO_ID = P.TDO_ID

</property>

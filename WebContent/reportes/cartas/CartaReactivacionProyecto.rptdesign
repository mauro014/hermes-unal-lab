                    <property name="nativeName">SED_NOMBRE</property>
                    <property name="dataType">string</property>
                </structure>
            </list-property>
            <property name="queryText">select  PER.PER_ID, PER_NOMBRE1||' '||  PER_NOMBRE2||' '|| PER_APELLIDO1||' '|| PER_APELLIDO2 JEFE,
DPN.DPN_NOMBRE, DPN1.DPN_NOMBRE, PAR.DESCRIPCION, 'Sede ' || SED.SED_NOMBRE as SED_NOMBRE
from
HER_PERSONA PER, HER_PARAMETRO PAR, HER_DEPENDENCIA DPN, HER_DEPENDENCIA DPN1, HER_SEDE SED
WHERE
    PER.PER_ID = PAR.VALOR
AND PAR.NOMBRE = DPN.DPN_ID_2
AND DPN.DPN_ID_2 = DPN1.DPN_ID
AND DPN.SED_ID = SED.SED_ID
AND DPN.DPN_ID = ?</property>

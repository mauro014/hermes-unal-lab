            <property name="queryText">select PAR.VALOR Director, PAR.DESCRIPCION Cargo, PAR.ADJUNTO Firma, S.SED_CIUDAD Ciudad
from 
her_parametro par, her_dependencia dep, HER_SEDE S
where 
par.PROFESION = ?
and par.NOMBRE = 'SEG_FIRMA'
and dep.dPN_id = par.PROFESION
AND DEP.SED_ID = S.SED_ID</property>

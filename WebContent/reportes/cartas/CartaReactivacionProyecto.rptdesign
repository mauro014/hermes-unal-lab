            <property name="queryText">SELECT PRY.PRY_NOMBRE, PRY.PRY_ID,
PER.PER_NOMBRE1||' '||DECODE(PER.PER_NOMBRE2, PER.PER_NOMBRE2,PER.PER_NOMBRE2,NULL,' ')||' '||
PER.PER_APELLIDO1||' '||DECODE(PER.PER_APELLIDO2, PER.PER_APELLIDO2,PER.PER_APELLIDO2,NULL,' ')PRINCIPAL,
DECODE(PRY.PRY_CODIGO_QUIPU,NULL,', ','y código QUIPU '||PRY.PRY_CODIGO_QUIPU ||',') QUIPU,
SOL.SOL_ID, SOL.SOL_DESCRIPCION SOL_JUSTIFICACION,
'Remito para su respectivo trámite, la aprobación de la solicitud de reactivación del proyecto "'||
PRY.PRY_NOMBRE || '" código HERMES '||PRY.PRY_ID||', código QUIPU '||PRY.PRY_CODIGO_QUIPU||', dirigido por ' || 
PER.PER_NOMBRE1||' '||DECODE(PER.PER_NOMBRE2, PER.PER_NOMBRE2,PER.PER_NOMBRE2,NULL,' ')||' '||
PER.PER_APELLIDO1||' '||DECODE(PER.PER_APELLIDO2, PER.PER_APELLIDO2,PER.PER_APELLIDO2,NULL,' ') ||', adscrito(a) a la '|| D2.DPN_NOMBRE || ' y sede '|| S.SED_NOMBRE || ' en el marco de la convocatoria "'||
CP.CNP_TITULO ||'".'TEXTO,
decode(add_months(pry.PRY_FECHA_TENTATIVA_INICIO,pry.PRY_DURACION_ACUMULADA) + decode(pry.PRY_DURACION_DIAS_ACUMULADA,
NULL,0,pry.PRY_DURACION_DIAS_ACUMULADA),null,pry.PRY_FECHA_FINAL,add_months(pry.PRY_FECHA_TENTATIVA_INICIO,pry.PRY_DURACION_ACUMULADA) + decode(pry.PRY_DURACION_DIAS_ACUMULADA,
NULL,0,pry.PRY_DURACION_DIAS_ACUMULADA))fecha_finalizacion, pry.PRY_FECHA_TENTATIVA_INICIO as fecha_inicio, 
decode(pry.PRY_DURACION_ACUMULADA,null,pry.PRY_DURACION,pry.PRY_DURACION_ACUMULADA) as duracion 
FROM 
HER_PROYECTO PRY LEFT JOIN HER_CONVOCATORIA CON ON PRY.MOD_ID = CON.CON_ID LEFT JOIN HER_CONVOCATORIA_PADRE CP ON 
CP.CNP_ID = CON.CNP_ID, HER_INVESTIGADOR_PROYECTO INP left join HER_INVESTIGADOR_INTERNO II ON II.TDO_ID = INP.TDO_ID
AND II.INV_ID = INP.INV_ID LEFT JOIN HER_DEPENDENCIA D ON II.DPN_ID = D.DPN_ID LEFT JOIN HER_DEPENDENCIA D2 
ON D.DPN_FACULTAD = D2.DPN_ID LEFT JOIN HER_SEDE S ON S.SED_ID = D.SED_ID, HER_PERSONA PER, HER_SOLICITUD SOL
WHERE
  PRY.PRY_ID = ?
AND  INP.INV_ID = PER.PER_ID
AND  PRY.PRY_ID = INP.PRY_ID
AND INP.INP_TIPO ='P'
AND SOL.PRY_ID = PRY.PRY_ID
AND SOL.SOL_ID = ?</property>

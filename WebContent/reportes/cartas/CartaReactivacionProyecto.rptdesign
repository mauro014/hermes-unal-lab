            <property name="queryText">select 
sol.sol_id, sol.SOL_FECHA_PROCESAMIENTO
from
her_solicitud sol
where 
sol.TSO_ID = 31
and sol.PRY_ID = ?
and sol.SOL_RESPUESTA = 'A'
AND SOL.SOL_ID = ?</property>

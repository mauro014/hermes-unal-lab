                    <property name="paramName">Id</property>
                    <property name="dataType">string</property>
                    <property name="position">2</property>
                    <property name="isInput">true</property>
                    <property name="isOutput">false</property>
                </structure>
            </list-property>
            <list-property name="resultSet">
                <structure>
                    <property name="position">1</property>
                    <property name="name">DIRECTOR</property>
                    <property name="nativeName">DIRECTOR</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">2</property>
                    <property name="name">CARGO</property>
                    <property name="nativeName">CARGO</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">3</property>
                    <property name="name">FIRMA</property>
                    <property name="nativeName">FIRMA</property>
                    <property name="dataType">blob</property>
                </structure>
            </list-property>
            <property name="queryText">SELECT PAR.VALOR Director, PAR.DESCRIPCION Cargo, PAR.ADJUNTO Firma
 FROM HER_PARAMETRO PAR, (
(select PAR.ID as par, p.PRY_ID as pry
from her_parametro par, her_proyecto p, her_convocatoria c, her_convocatoria_padre cp, HER_DEPENDENCIA DPN, HER_INVESTIGADOR_INTERNO II,  HER_INVESTIGADOR_PROYECTO IP
where p.MOD_ID = c.CON_ID
and c.CNP_ID = cp.CNP_ID
and par.PROFESION = ?
and par.NOMBRE = 'SEG_FIRMA' 
and II.DPN_ID = DPN.DPN_ID
and IP.INV_ID = II.INV_ID AND IP.TDO_ID = II.TDO_ID AND IP.INP_TIPO = 'P'
AND p.PRY_ID = IP.PRY_ID) UNION (
select PAR.ID as par, p.PRY_ID as pry
from her_parametro par, her_proyecto p, her_convocatoria c, her_convocatoria_padre cp, HER_DEPENDENCIA DPN, HER_INVESTIGADOR_INTERNO II,  HER_INVESTIGADOR_PROYECTO IP
where p.MOD_ID = c.CON_ID
and c.CNP_ID = cp.CNP_ID
AND cp.CNP_ID = 0
and DPN.DPN_FACULTAD = par.PROFESION
and par.NOMBRE = 'SEG_FIRMA' 
and II.DPN_ID = DPN.DPN_ID
and IP.INV_ID = II.INV_ID AND IP.TDO_ID = II.TDO_ID AND IP.INP_TIPO = 'P'
AND p.PRY_ID = IP.PRY_ID)) UNI WHERE PAR.ID = par and pry = ?</property>

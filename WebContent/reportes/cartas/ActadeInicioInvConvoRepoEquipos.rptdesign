        <table id="7027">
            <property name="height">0.23958333333333334in</property>
            <property name="width">7.96875in</property>
            <property name="dataSet">ActadeInicioGru</property>
            <list-property name="boundDataColumns">
                <structure>
                    <property name="name">PRY_NOMBRE</property>
                    <expression name="expression">dataSetRow["PRY_NOMBRE"]</expression>
                    <property name="dataType">string</property>
                </structure>

                </structure>
            </list-property>
            <list-property name="resultSet">
                <structure>
                    <property name="position">1</property>
                    <property name="name">RUBRO</property>
                    <property name="nativeName">RUBRO</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">2</property>
                    <property name="name">GST_DESCRIPCION</property>
                    <property name="nativeName">GST_DESCRIPCION</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">3</property>
                    <property name="name">ANIO1</property>
                    <property name="nativeName">ANIO1</property>
                    <property name="dataType">decimal</property>
                </structure>
                <structure>
                    <property name="position">4</property>
                    <property name="name">ANIO2</property>
                    <property name="nativeName">ANIO2</property>
                    <property name="dataType">decimal</property>
                </structure>
                <structure>
                    <property name="position">5</property>
                    <property name="name">ANIO3</property>
                    <property name="nativeName">ANIO3</property>
                    <property name="dataType">decimal</property>
                </structure>
                <structure>
                    <property name="position">6</property>
                    <property name="name">TOTAL</property>
                    <property name="nativeName">TOTAL</property>
                    <property name="dataType">decimal</property>
                </structure>
                <structure>
                    <property name="position">7</property>
                    <property name="name">FFI_DESCRIPCION</property>
                    <property name="nativeName">FFI_DESCRIPCION</property>
                    <property name="dataType">string</property>
                </structure>
            </list-property>
            <property name="queryText">SELECT TRU_NOMBRE  Rubro,
		g.GST_DESCRIPCION, 
       NVL(g.gst_valor,0) ANIO1,
       NVL(g.gst_valor2,0) ANIO2,
       NVL(g.gst_valor3,0) ANIO3,
       NVL(g.gst_valor,0) + NVL(g.gst_valor2,0) + NVL(g.gst_valor3,0) TOTAL,
       ff.ffi_descripcion
  FROM HER_GASTO g, 
       HER_TIPO_RUBRO tr, 
       HER_FINANCIACION f , 
       her_fuente_financiacion ff
WHERE g.fin_ID = f.fin_ID 
  AND ff.FFI_ID = f.FFI_ID 
  AND g.tru_id =tr.TRU_ID
  AND PRY_ID = ?
  AND tr.TRU_DESCRIPCION = 'INGRESO'
ORDER BY g.GST_DESCRIPCION</property>

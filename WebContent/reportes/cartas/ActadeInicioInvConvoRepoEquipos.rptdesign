            <property name="queryText">select tr.tru_nombre,  
       nvl(g.gst_valor,0) + nvl(g.gst_valor2,0) + nvl(g.gst_valor3,0) + nvl(g.gst_valor4,0) + nvl(g.gst_valor5,0) as valor
from 
    her_financiacion f, 
    her_gasto g, 
    her_fuente_financiacion ff, 
    her_tipo_rubro tr
 where 
 g.fin_id = f.fin_id and 
 f.PRY_ID = ? and 
 f.ffi_id = ff.ffi_id and 
 ff.ffi_iNTERNA_EXTERNA in ('I','O') and 
 (F.FFE_TIPO_ENTIDAD = 'F' OR F.FFE_TIPO_ENTIDAD is null) and
 (FIN_ES_LEGALIZACION IS NULL OR  FIN_ES_LEGALIZACION = 'NO') and
 g.tru_id = tr.tru_id</property>

       NVL(g.gst_valor,0) ANIO1,
       NVL(g.gst_valor2,0) ANIO2,
       NVL(g.gst_valor3,0) ANIO3,
       NVL(g.gst_valor,0) + NVL(g.gst_valor2,0) + NVL(g.gst_valor3,0) TOTAL,
       ff.ffi_descripcion
  FROM HER_GASTO g, 
       HER_TIPO_RUBRO tr, 
       HER_FINANCIACION f , 
       her_fuente_financiacion ff
WHERE g.fin_ID = f.fin_ID 
  AND ff.FFI_ID = f.FFI_ID 
  AND g.tru_id =tr.TRU_ID
  AND PRY_ID = ?
  AND tr.TRU_DESCRIPCION = 'INGRESO'
ORDER BY g.GST_DESCRIPCION</property>

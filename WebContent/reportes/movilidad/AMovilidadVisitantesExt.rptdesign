            <property name="queryText">SELECT DISTINCT P.PER_NOMBRE1 || ' ' || P.PER_NOMBRE2 || ' ' || P.PER_APELLIDO1 || ' ' ||  PER_APELLIDO2 RESPONSABLE_NOMBRE 
FROM
HER_MOVILIDAD_REQUISITO PR, HER_PERSONA P, HER_MOVILIDAD_VISITANTES_EXT MVE

            <property name="queryText">SELECT DPN_NOMBRE FROM HER_DEPENDENCIA DPN 
WHERE 
DPN.DPN_ID IN
(SELECT DPN2.DPN_ID_2
FROM
HER_MOVILIDAD_VISITANTES_EXT MVE, HER_PERSONA PER, HER_INVESTIGADOR_INTERNO INI, HER_DEPENDENCIA DPN2
WHERE 
    PER.PER_ID = MVE.MOV_ID_PER
AND PER.PER_ID = INI.INV_ID
AND INI.DPN_ID = DPN2.DPN_ID
AND MVE.MOV_ID = ?)</property>
        </oda-data-set>

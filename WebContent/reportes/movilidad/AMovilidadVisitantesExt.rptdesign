            <property name="queryText">SELECT TPR.TPR_NOMBRE, decode (PRR.REQ_CUMPLIDO, 'S', 'Si', 'N', 'No' )SINO, PRR.REQ_COMENTARIO, MOV_ACEPT
FROM
HER_MOVILIDAD_REQUISITO prr,HER_TIPO_REQUISITO TPR, HER_MOVILIDAD_VISITANTES_EXT MVE
WHERE
PRR.MOV_ID = ?
AND TPR.REQ_SELECCION = 'S'
AND PRR.TPR_ID = TPR.TPR_ID
AND MVE.MOV_ID = PRR.MOV_ID
AND MVE.MOV_ACEPT is NOT NULL
AND (MVE.MOV_CUMPLE_REQUISITOS IS NULL OR MVE.MOV_CUMPLE_REQUISITOS = 'SI')
ORDER BY tpr_descripcion</property>

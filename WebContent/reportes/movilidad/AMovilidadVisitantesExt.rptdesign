                    <property name="nativeName">DIRIGIDO_OTRA_DEPENDENCIA</property>
                    <property name="dataType">string</property>
                </structure>
            </list-property>
            <property name="queryText">select 
MOV_ID, MOV_NOMBRE_DOCENTE,MOV_DOC_VISITANTE, MOV_NACIONALIDAD, PAIS_NOMBRE, (select nvl(INS_NOMBRE,MOV_UNIVERSIDAD) from HER_INSTITUCION WHERE INS_ID=MOV_UNIVERSIDAD)MOV_UNIVERSIDAD, 
MOV_PLAN,MOV_VALOR_APORTE_FAC,MOV_FEC_INI_EV,MOV_FEC_FIN_EV, MOV_EVENTO, TO_NUMBER(MOV_COSTO_TIQ), TO_NUMBER(MOV_MONTO),
TO_NUMBER(MOV_NUM_DIAS), MOV_FEC_SOL, SED.SED_NOMBRE, MOV_ACEPT, MOV_COMENTARIOS_FAC, MOV_APROB, MOV_COMENTARIOS_DIR, MOV_FECHA_ACEPTACION
, MOV_FECHA_APROBACION, MOV_VALOR_APORTE_SEDE,MVE.MOV_FACULTAD,
RESPONSABLE_FAC.PER_NOMBRE1 || ' ' || RESPONSABLE_FAC.PER_NOMBRE2 || ' ' || RESPONSABLE_FAC.PER_APELLIDO1 || ' ' || RESPONSABLE_FAC.PER_APELLIDO2 RES_FACULTAD,
RESPONSABLE_SED.PER_NOMBRE1 || ' ' || RESPONSABLE_SED.PER_NOMBRE2 || ' ' || RESPONSABLE_SED.PER_APELLIDO1 || ' ' || RESPONSABLE_SED.PER_APELLIDO2 RES_SED,
MOV_CUMPLE_REQUISITOS, DECODE(mve.MOV_TIPO,'P','Presencial','V','Virtual')MOV_TIPO,mve.CON_ID,
    case
        when mve.mov_tipo='V' then to_number(mve.mov_estim_virtual)
        else 0
    end as mov_est_virtual,
MOV_EMAIL_VISITANTE, DECODE(mve.MOV_DIR_OTRA_DPN,'S','Si','N','No')DIRIGIDO_OTRA_DEPENDENCIA
 from HER_MOVILIDAD_VISITANTES_EXT MVE LEFT JOIN HER_PERSONA RESPONSABLE_FAC ON 
RESPONSABLE_FAC.PEr_id = MVE.MOV_ID_PER_APROB AND RESPONSABLE_FAC.TDO_ID = MVE.MOV_TDO_ID_PER_APROB LEFT JOIN HER_PERSONA RESPONSABLE_SED ON 
RESPONSABLE_SED.PEr_id = MVE.MOV_ID_PER_APROB_SED AND RESPONSABLE_SED.TDO_ID = MVE.MOV_TDO_ID_PER_APROB_SED, HER_PAIS PAIS, HER_SEDE SED
where MVE.MOV_ID = ?
AND MVE.MOV_PAIS= PAIS.PAIS_ID
AND MVE.MOV_SEDE = SED.SED_ID</property>
        </oda-data-set>

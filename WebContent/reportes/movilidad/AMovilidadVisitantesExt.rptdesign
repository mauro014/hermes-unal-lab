                </structure>
                <structure>
                    <property name="position">3</property>
                    <property name="name">DOCUMENTO</property>
                    <property name="nativeName">DOCUMENTO</property>
                    <property name="dataType">string</property>
                </structure>
            </list-property>
            <property name="queryText">SELECT  PER.PER_NOMBRE1||' '||PER.PER_NOMBRE2||' '|| PER.PER_APELLIDO1||' '||PER.PER_APELLIDO2 Docente, DPN.DPN_NOMBRE, PER.TDO_ID||'-'||PER.PER_ID DOCUMENTO
FROM
HER_MOVILIDAD_VISITANTES_EXT MVE, HER_PERSONA PER, HER_DEPENDENCIA DPN, HER_INVESTIGADOR_INTERNO INI
WHERE 
    PER.PER_ID = MVE.MOV_ID_PER
AND PER.PER_ID = INI.INV_ID
AND INI.DPN_ID = DPN.DPN_ID
AND MVE.MOV_ID = ?</property>
        </oda-data-set>

                </structure>
            </list-property>
            <property name="queryText">SELECT (PER.PER_NOMBRE1||' '||PER.PER_NOMBRE2||' '||PER.PER_APELLIDO1||' '||PER.PER_APELLIDO2) Docente,DPN.DPN_NOMBRE
FROM
HER_MOVILIDAD_ESTUDIANTE_POS MEP,HER_PERSONA PER, HER_DEPENDENCIA DPN, HER_INVESTIGADOR_INTERNO INI
WHERE 
    PER.PER_ID = MEP.MOV_ID_PER
AND PER.TDO_ID = MEP.MOV_TDO_ID_PER
AND PER.PER_ID = INI.INV_ID
AND INI.DPN_ID = DPN.DPN_ID
AND MEP.MOV_ID = ?</property>
        </oda-data-set>

            <property name="queryText">Select 
MOV_ID,MOV_EVENTO, MOV_TITULO, PAIS_NOMBRE, MOV_CIUDAD,MOV_FEC_INI_EV,MOV_FEC_FIN_EV,
TPO.TPO_DESCRIPCION , MOV_ABSTRACT, to_number(MOV_COSTO_TIQ) CTIQ, to_number(MOV_COSTO_EV) CEVE,  MOV_ACEPT, MOV_COMENTARIOS_FAC, MOV_APROB, MOV_COMENTARIOS_DIR,
mep.MOV_FEC_SOL, mep.MOV_PASANTIA_ESTANCIA PASE, MOV_INSTITUCION_OFRECE INST, mov_valor_aporte_fac, mov_fecha_aceptacion, mov_valor_aporte_sede, mov_fecha_aprobacion, MEP.MOV_FACULTAD, mep.MOV_VALOR_VIATICOS,
RESPONSABLE_FAC.PER_NOMBRE1 || ' ' || RESPONSABLE_FAC.PER_NOMBRE2 || ' ' || RESPONSABLE_FAC.PER_APELLIDO1 || ' ' || RESPONSABLE_FAC.PER_APELLIDO2 RES_FACULTAD,
RESPONSABLE_SED.PER_NOMBRE1 || ' ' || RESPONSABLE_SED.PER_NOMBRE2 || ' ' || RESPONSABLE_SED.PER_APELLIDO1 || ' ' || RESPONSABLE_SED.PER_APELLIDO2 RES_SED,  decode(mep.MOV_MEDIO_TRANSPORTE, '1', 'Terrestre','2', 'Aereo') as medioTransporte,
CONV.CON_GRUPOS_RECONOCIDOS AS mostrarAportesDepe, mep.MOV_OTROS_APORTES, mep.MOV_DEP_OTROS_APORTES
 from HER_MOVILIDAD_ESTUDIANTE_POS MEP LEFT JOIN HER_PERSONA RESPONSABLE_FAC ON 
RESPONSABLE_FAC.PEr_id = MEP.MOV_ID_PER_APROB AND RESPONSABLE_FAC.TDO_ID = MEP.MOV_TDO_ID_PER_APROB LEFT JOIN HER_PERSONA RESPONSABLE_SED ON 
RESPONSABLE_SED.PEr_id = MEP.MOV_ID_PER_APROB_SED AND RESPONSABLE_SED.TDO_ID = MEP.MOV_TDO_ID_PER_APROB_SED, HER_PAIS PAIS, HER_TIPO_PONENCIA TPO, HER_CONVOCATORIA CONV
where MEP.MOV_ID = ?
AND MEP.MOV_PAIS= PAIS.PAIS_ID 
AND MEP.MOV_TIPO_PONENCIA = TPO.TPO_ID 
AND MEP.CON_ID = CONV.CON_ID</property>
        </oda-data-set>
        <oda-data-set extensionID="org.eclipse.birt.report.data.oda.jdbc.JdbcSelectDataSet" name="Dependencia" id="3010">
            <structure name="cachedMetaData">

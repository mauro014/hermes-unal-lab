                    <property name="name">param_1</property>
                    <property name="paramName">id</property>
                    <property name="dataType">string</property>
                    <property name="position">1</property>
                    <property name="isInput">true</property>
                    <property name="isOutput">false</property>
                </structure>
            </list-property>
            <list-property name="resultSet">
                <structure>
                    <property name="position">1</property>
                    <property name="name">TAM_NOMBRE</property>
                    <property name="nativeName">TAM_NOMBRE</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">2</property>
                    <property name="name">AMV_NOMBRE</property>
                    <property name="nativeName">AMV_NOMBRE</property>
                    <property name="dataType">string</property>
                </structure>
            </list-property>
            <property name="queryText">SELECT 
TAM.TAM_NOMBRE, AME.AMV_NOMBRE 
FROM
HER_ARCHIVO_MOVILIDAD_EP AME, HER_MOVILIDAD_ESTUDIANTE_POS  MEP, HER_TIPO_ARCHIVO_MOVILIDAD TAM
WHERE
    AME.MOV_ID = MEP.MOV_ID
AND AME.TAM_ID = TAM.TAM_ID
AND  AME.MOV_ID = ?
ORDER BY TAM.TAM_ID</property>
        </oda-data-set>

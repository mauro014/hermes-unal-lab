            <property name="queryText">SELECT (EST.EST_NOMBRE1||' '||EST.EST_NOMBRE2||' '||EST.EST_APELLIDO1||' '||EST.EST_APELLIDO2) Estudiante,
PLE.PLE_NOMBRE, est.est_id || ' - ' || est.tdo_id documento, EST.EST_EMAIL, est.EST_PAPA
FROM
HER_MOVILIDAD_ESTUDIANTE_POS MEP,HER_TMP_ESTUDIANTE EST, HER_PLAN_ESTUDIOS PLE
WHERE 
    EST.EST_ID = MEP.MOV_ID_EST
AND EST.TDO_ID = MEP.MOV_TDO_ID_EST
AND EST.EST_PLAN = PLE.PLE_ID
AND MEP.MOV_ID = ?</property>
        </oda-data-set>

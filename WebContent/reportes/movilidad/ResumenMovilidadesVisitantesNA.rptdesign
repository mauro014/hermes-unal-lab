            <property name="queryText">select MOV_ID, mov.MOV_APROB,  SED.SED_NOMBRE sede,  dpn1.DPN_NOMBRE Fac, dpn.DPN_NOMBRE dpto, MOV_ID_PER IdSol,
per.PER_APELLIDO1||' '||per.PER_APELLIDO2||' '||per.PER_NOMBRE1||' '||per.PER_NOMBRE2 Solicita,
GRU.GRU_NOMBRE Grupo, PPS_NOMBRE ProgP, MOV_NOMBRE_DOCENTE Visita,  MOV_NACIONALIDAD Nacional,
MOV_EVENTO Evento , PAIS.pais_nombre  Pais, MOV_UNIVERSIDAD Entidad, MOV_PLAN Ruta,
to_number(MOV_COSTO_TIQ) Tiquet, to_number(MOV_MONTO) Diario, MOV_NUM_DIAS Dias, 
MOV_FEC_SOL FecSol, MOV_FEC_INI_EV IniEve, MOV_FEC_FIN_EV FinEve
from HER_MOVILIDAD_VISITANTES_EXT mov, her_persona per,her_pais pais ,
HER_DEPENDENCIA DPN, HER_DEPENDENCIA DPN1, HER_INVESTIGADOR_INTERNO INI, HER_SEDE SED,
HER_GRUPO GRU , HER_PROGRAMA_POSGRADO PPS 
where MOV_ID_SUBTIPO_MOV = 'A1' 
and per.PER_ID = mov.MOV_ID_PER
and MOV_ID_GRUPO = gru.GRU_ID
AND MOV.MOV_ID_PROG = PPS.PPS_ID
and pais.PAIS_ID = mov.MOV_PAIS
AND  DPN.DPN_ID = INI.DPN_ID
AND  DPN.DPN_ID_2 = DPN1.DPN_ID
AND  INI.INV_ID = PER.PER_ID
AND SUBSTR(INI.DPN_ID,1,1) = SED.SED_ID
AND MOV.MOV_APROB IS NULL
and MOV_FEC_SOL > ? 
and MOV_FEC_SOL &lt; ? 
order by dpn.dpn_id, to_number(mov_id)</property>
        </oda-data-set>
    </data-sets>

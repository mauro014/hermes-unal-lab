                    <property name="name">MOV_CONTRIBUCION</property>
                    <property name="nativeName">MOV_CONTRIBUCION</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">59</property>
                    <property name="name">MOV_ESPECIALISTAS_AREA</property>
                    <property name="nativeName">MOV_ESPECIALISTAS_AREA</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">60</property>
                    <property name="name">MOV_TRABAJOS</property>
                    <property name="nativeName">MOV_TRABAJOS</property>
                    <property name="dataType">string</property>
                </structure>
            </list-property>
            <property name="queryText">SELECT PER.PER_NOMBRE1, PER.PER_NOMBRE2 ,PER.PER_APELLIDO1, PER.PER_APELLIDO2, PER.PER_ID, PER.PER_EMAIL, 
SE.SED_NOMBRE, DEP2.DPN_NOMBRE, DEP.DPN_NOMBRE,
HMEA.MOV_NOMBRE_ARTISTICO, HP2.PAIS_NOMBRE as "NACIONALIDAD", HMEA.MOV_PASAPORTE, HMEA.MOV_PAGINA_WEB, HMEA.MOV_TELEFONO_FIJO, HMEA.MOV_TELEFONO_MOVIL, HMEA.MOV_DIRECCION, HMEA.MOV_NOMBRE_PROYECTO, HMEA.MOV_STATEMENT, HMEA.MOV_DESCRIPCION_PROYECTO, 
HMEA.MOV_OBJETIVO_GENERAL, HMEA.MOV_OBJETIVOS_ESPECIFICOS, HMEA.MOV_RELACION_LOCAL, HMEA.MOV_FECHA_INICIO, HMEA.MOV_FECHA_FIN, HC.CONTINENTE_NOMBRE, HP.PAIS_NOMBRE , HMEA.MOV_CIUDAD, HMEA.MOV_AREA_ARTE, HMEA.MOV_METODO_SELECCION, HMEA.MOV_INSTITUCION, 
HMEA.MOV_TIPO_INSTITUCION, HMEA.MOV_DESCRIPCION_PROGRAMA, HMEA.MOV_ANTERIOR_RESIDENCIA, HMEA.MOV_TIQUETE_UN, HMEA.MOV_TALLER_UN, HMEA.MOV_ALOJAMIENTO_UN, HMEA.MOV_ALIMENTACION_UN, HMEA.MOV_MATERIALES_UN, HMEA.MOV_TRANSPORTE_UN, HMEA.MOV_SOCIALIZACION_UN, 
HMEA.MOV_TOTAL_UN, HMEA.MOV_TIQUETE_PRO, HMEA.MOV_TALLER_PRO, HMEA.MOV_ALOJAMIENTO_PRO, HMEA.MOV_ALIMENTACION_PRO, HMEA.MOV_MATERIALES_PRO, HMEA.MOV_TRANSPORTE_PRO, HMEA.MOV_SOCIALIZACION_PRO, HMEA.MOV_TOTAL_PROPIO, HMEA.MOV_SOCIALIZACION_RESIDENCIA, HMEA.MOV_SOCIALIZACION_CAMPUS,
HMEA.MOV_AVAL_FACULTAD, HMEA.MOV_AVAL_SEDE, HMEA.MOV_DESCRIPCION_FACULTAD, HMEA.MOV_DESCRIPCION_SEDE,
HMEA.MOV_COMO_ENTERO, HMEA.MOV_APORTE_RED, HMEA.MOV_CONTRIBUCION, HMEA.MOV_ESPECIALISTAS_AREA, HMEA.MOV_TRABAJOS
FROM HER_PERSONA PER, HER_INVESTIGADOR_INTERNO II, HER_DEPENDENCIA DEP, HER_SEDE SE, HER_DEPENDENCIA DEP2, HER_MOVILIDAD_ESTUDIANTES_ART HMEA, HER_CONTINENTE HC, HER_PAIS HP, HER_PAIS HP2
WHERE PER.PER_ID = HMEA.MOV_ID_PER  AND II.INV_ID = HMEA.MOV_ID_PER AND II.TDO_ID = HMEA.MOV_TDO_ID_PER  AND DEP.DPN_ID = II.DPN_ID AND SE.SED_ID = DEP.SED_ID AND DEP2.DPN_ID = DEP.DPN_FACULTAD AND HC.CONTINENTE_ID = HMEA.MOV_CONTINENTE AND HP2.PAIS_ID = HMEA.MOV_NACIONALIDAD AND HP.PAIS_ID = HMEA.MOV_PAIS  AND HMEA.MOV_ID = ?</property>
        </oda-data-set>
    </data-sets>

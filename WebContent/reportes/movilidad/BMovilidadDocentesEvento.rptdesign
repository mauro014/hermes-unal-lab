                </structure>
            </list-property>
            <property name="queryText">SELECT TPR.TPR_NOMBRE, decode (PRR.REQ_CUMPLIDO, 'S', 'Si', 'N', 'No' )SINO, PRR.REQ_COMENTARIO, CONV.CON_CRITERIOS_CALIFICACION AS MOD_VER_REQ, EVE.MOV_ACEPT
FROM
HER_MOVILIDAD_REQUISITO prr,HER_TIPO_REQUISITO TPR, HER_CONVOCATORIA CONV, HER_MOVILIDAD_DOCENTES_EVENTOS EVE
WHERE
PRR.MOV_ID = ?
AND PRR.TPR_ID = TPR.TPR_ID
AND PRR.MOV_ID = EVE.MOV_ID
AND EVE.CON_ID = CONV.CON_ID
AND EVE.MOV_ACEPT IS NOT NULL
ORDER BY tpr_descripcion</property>

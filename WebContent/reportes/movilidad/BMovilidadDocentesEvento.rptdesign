            <property name="queryText">select 
MDE.MOV_ID_SUBTIPO_MOV, MDE.MOV_UNIVERSIDAD, MDE.MOV_TESIS, mov_id,MOV_EVENTO, MOV_TITULO, PAIS_NOMBRE, nvl((SELECT CIU_NOMBRE from HER_CIUDAD where CIU_ID=MOV_CIUDAD),MOV_CIUDAD) MOV_CIUDAD, CIU.CIU_NOMBRE ,MOV_FEC_INI_EV,MOV_FEC_FIN_EV, DECODE(MDE.MOV_CARACTER_EVENTO,'1','Internacional en Colombia','2','Internacional en el extranjero','3','Nacional','7','Virtual') AS CARACTER_EVE, DECODE(MDE.MOV_MEDIO_TRANSPORTE,'1','Terrestre','2','Aereo') AS MEDIO_TRANS,
TPO.TPO_DESCRIPCION , MOV_ABSTRACT, MOV_RES_VIAJE , to_number(MOV_COSTO_TIQ) CTIQ, 
to_number(MOV_COSTO_EV) CEVE, to_number(MOV_APORTE_FAC) AFAC, MOV_ACEPT , MOV_COMENTARIOS_FAC, MOV_APROB, MOV_COMENTARIOS_DIR,
mde.MOV_FEC_SOL, mde.MOV_NOMBRE_UNIVERSIDAD, mde.mov_valor_viaticos viaticos, mde.mov_fecha_aceptacion, mde.mov_fecha_aprobacion, 
mde.mov_valor_aporte_fac,mde.mov_valor_aporte_sede,mde.MOV_FACULTAD, mde.MOV_SUBMODALIDAD as submodalidad,
RESPONSABLE_FAC.PER_NOMBRE1 || ' ' || RESPONSABLE_FAC.PER_NOMBRE2 || ' ' || RESPONSABLE_FAC.PER_APELLIDO1 || ' ' || RESPONSABLE_FAC.PER_APELLIDO2 RES_FACULTAD,
RESPONSABLE_SED.PER_NOMBRE1 || ' ' || RESPONSABLE_SED.PER_NOMBRE2 || ' ' || RESPONSABLE_SED.PER_APELLIDO1 || ' ' || RESPONSABLE_SED.PER_APELLIDO2 RES_SED,
CONV.CON_GRUPOS_CATEGORIA_A AS "MOSTRAR_VIATICOS", CONV.CON_GRUPOS_CATEGORIA_B AS "MOSTRAR_INSCRIPCION_EVENTO", CONV.CON_GRUPOS_CATEGORIA_C AS "MOSTRAR_VALOR_TIQUETES", CONV.CON_GRUPOS_CATEGORIA_D AS "MOSTRAR_VALOR_TOTAL", CONV.CON_RESTRICCION AS "TIPO_MOVILIDAD", MDE.MOV_VALOR_TOTAL_SOLICITADO, DECODE(mde.MOV_TIPO,'P','Presencial','V','Virtual')MOV_TIPO
 from HER_MOVILIDAD_DOCENTES_EVENTOS MDE LEFT JOIN HER_PERSONA RESPONSABLE_FAC ON 
RESPONSABLE_FAC.PEr_id = MDE.MOV_ID_PER_APROB AND RESPONSABLE_FAC.TDO_ID = MDE.MOV_TDO_ID_PER_APROB LEFT JOIN HER_PERSONA RESPONSABLE_SED ON 
RESPONSABLE_SED.PEr_id = MDE.MOV_ID_PER_APROB_SED AND RESPONSABLE_SED.TDO_ID = MDE.MOV_TDO_ID_PER_APROB_SED LEFT JOIN HER_CIUDAD CIU ON CIU.CIU_ID = MDE.MOV_CIUDAD, HER_PAIS PAIS, HER_TIPO_PONENCIA TPO, HER_CONVOCATORIA CONV
WHERE MDE.MOV_ID = ?
AND MDE.MOV_PAIS= PAIS.PAIS_ID 
AND MDE.MOV_TIPO_PONENCIA = TPO.TPO_ID 
AND MDE.CON_ID = CONV.CON_ID</property>
        </oda-data-set>
        <oda-data-set extensionID="org.eclipse.birt.report.data.oda.jdbc.JdbcSelectDataSet" name="Dependencia" id="3010">
            <structure name="cachedMetaData">
                <list-property name="resultSet">
                    <structure>
                        <property name="position">1</property>
                        <property name="name">DPN_NOMBRE</property>
                        <property name="dataType">string</property>
                    </structure>
                </list-property>
            </structure>
            <property name="dataSource">Data Source</property>
            <list-property name="parameters">
                <structure>
                    <property name="name">param_1</property>
                    <property name="paramName">id</property>
                    <property name="dataType">string</property>
                    <property name="position">1</property>
                    <property name="isInput">true</property>
                    <property name="isOutput">false</property>
                </structure>
            </list-property>
            <list-property name="resultSet">
                <structure>
                    <property name="position">1</property>
                    <property name="name">DPN_NOMBRE</property>
                    <property name="nativeName">DPN_NOMBRE</property>
                    <property name="dataType">string</property>
                </structure>
            </list-property>
            <property name="queryText">SELECT DPN_NOMBRE FROM HER_DEPENDENCIA DPN 
WHERE 
DPN.DPN_ID IN
(SELECT DPN2.DPN_ID_2
FROM
HER_MOVILIDAD_DOCENTES_EVENTOS MDE, HER_PERSONA PER, HER_INVESTIGADOR_INTERNO INI, HER_DEPENDENCIA DPN2
WHERE 
    PER.PER_ID = MDE.MOV_ID_PER
AND PER.PER_ID = INI.INV_ID
AND INI.DPN_ID = DPN2.DPN_ID
AND MDE.MOV_ID = ?)</property>
        </oda-data-set>

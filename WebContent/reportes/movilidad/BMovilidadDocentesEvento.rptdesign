            <property name="queryText">select
nvl(mtd.MOV_EVENTO,mde.MOV_EVENTO)MOV_EVENTO, mtd.MOV_TITULO, tpo.TPO_DESCRIPCION, 
mde.MOV_ID, mde.MOV_SUBMODALIDAD as submodalidad,

                </structure>
                <structure>
                    <property name="position">2</property>
                    <property name="name">REQ_REV</property>
                    <property name="nativeName">REQ_REV</property>
                    <property name="dataType">string</property>
                </structure>
            </list-property>
            <property name="queryText">SELECT DISTINCT P.PER_NOMBRE1 || ' ' || P.PER_NOMBRE2 || ' ' || P.PER_APELLIDO1 || ' ' ||  PER_APELLIDO2 RESPONSABLE_NOMBRE, conv.CON_CRITERIOS_CALIFICACION as req_rev 
FROM
HER_MOVILIDAD_REQUISITO PR, HER_PERSONA P, HER_CONVOCATORIA CONV, HER_MOVILIDAD_DOCENTES_EVENTOS EVE
WHERE PR.MOV_ID = ?
AND PR.REQ_RESPONSABLE_ID = P.PER_ID
AND PR.REQ_RESPONSABLE_TDO_ID = P.TDO_ID
AND PR.MOV_ID = EVE.MOV_ID
AND EVE.MOV_ACEPT IS NOT NULL
AND EVE.CON_ID = CONV.CON_ID</property>
        </oda-data-set>

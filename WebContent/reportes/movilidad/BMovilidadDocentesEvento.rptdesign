                    </structure>
                    <structure>
                        <property name="position">5</property>
                        <property name="name">MOV_ACEPT</property>
                        <property name="dataType">string</property>
                    </structure>
                </list-property>
            </structure>
            <property name="dataSource">Data Source</property>
            <list-property name="parameters">
                <structure>
                    <property name="name">param_1</property>
                    <property name="paramName">id</property>
                    <property name="dataType">string</property>
                    <property name="position">1</property>
                    <property name="isInput">true</property>
                    <property name="isOutput">false</property>
                </structure>
            </list-property>
            <list-property name="resultSet">
                <structure>
                    <property name="position">1</property>
                    <property name="name">TPR_NOMBRE</property>
                    <property name="nativeName">TPR_NOMBRE</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">2</property>
                    <property name="name">SINO</property>
                    <property name="nativeName">SINO</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">3</property>
                    <property name="name">REQ_COMENTARIO</property>
                    <property name="nativeName">REQ_COMENTARIO</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">4</property>
                    <property name="name">MOD_VER_REQ</property>
                    <property name="nativeName">MOD_VER_REQ</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">5</property>
                    <property name="name">MOV_ACEPT</property>
                    <property name="nativeName">MOV_ACEPT</property>
                    <property name="dataType">string</property>
                </structure>
            </list-property>
            <property name="queryText">SELECT TPR.TPR_NOMBRE, decode (PRR.REQ_CUMPLIDO, 'S', 'Si', 'N', 'No' )SINO, PRR.REQ_COMENTARIO, CONV.CON_CRITERIOS_CALIFICACION AS MOD_VER_REQ, EVE.MOV_ACEPT
FROM
HER_MOVILIDAD_REQUISITO prr,HER_TIPO_REQUISITO TPR, HER_CONVOCATORIA CONV, HER_MOVILIDAD_DOCENTES_EVENTOS EVE
WHERE
PRR.MOV_ID = ?
AND PRR.TPR_ID = TPR.TPR_ID
AND PRR.MOV_ID = EVE.MOV_ID
AND TPR.REQ_SELECCION = 'S'
AND EVE.CON_ID = CONV.CON_ID
AND EVE.MOV_ACEPT IS NOT NULL
AND (EVE.MOV_CUMPLE_REQUISITOS IS NULL OR EVE.MOV_CUMPLE_REQUISITOS = 'SI')
ORDER BY tpr_descripcion</property>
        </oda-data-set>
        <oda-data-set extensionID="org.eclipse.birt.report.data.oda.jdbc.JdbcSelectDataSet" name="ResponsableRequisitos" id="8334">
            <structure name="cachedMetaData">

            <property name="queryText">SELECT (PER.PER_NOMBRE1||' '||PER.PER_NOMBRE2||' '||PER.PER_APELLIDO1||' '||PER.PER_APELLIDO2) Docente,DPN.DPN_NOMBRE, mde.MOV_PASAPORTE_INV, PER.TDO_ID||'-'||PER.PER_ID DOCUMENTO

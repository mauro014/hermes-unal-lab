            <property name="queryText">select MDE.MOV_ID_SUBTIPO_MOV, MDE.MOV_UNIVERSIDAD, MDE.MOV_TESIS, mov_id,MOV_EVENTO, MOV_TITULO, PAIS_NOMBRE, MOV_CIUDAD,MOV_FEC_INI_EV,MOV_FEC_FIN_EV,
TPO.TPO_DESCRIPCION , MOV_ABSTRACT, MOV_RES_VIAJE , to_number(MOV_COSTO_TIQ) CTIQ, to_number(MOV_COSTO_EV) CEVE, to_number(MOV_APORTE_FAC) AFAC, MOV_ACEPT , MOV_COMENTARIOS_FAC, MOV_APROB, MOV_COMENTARIOS_DIR,
mde.MOV_FEC_SOL, mde.MOV_NOMBRE_UNIVERSIDAD, mde.MOV_VALOR_VIATICOS , mde.MOV_VALOR_APORTE_FAC , mde.MOV_OTROS_APORTES
 from HER_MOVILIDAD_DOCENTES_EVENTOS MDE, HER_PAIS PAIS, HER_TIPO_PONENCIA TPO 
WHERE MDE.MOV_ID = ?
AND MDE.MOV_PAIS= PAIS.PAIS_ID 
AND MDE.MOV_TIPO_PONENCIA = TPO.TPO_ID </property>

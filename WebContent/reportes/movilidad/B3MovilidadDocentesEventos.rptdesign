        <label id="172">
            <property name="style">TituloCentrado</property>
            <property name="fontSize">9pt</property>
            <text-property name="text">APOYO A  DOCENTES DE LA UN PARA PARTICIPAR EN EVENTOS EN EL EXTRANJERO</text-property>
        </label>
        <table id="3159">
            <property name="width">100%</property>
            <property name="dataSet">Eventos</property>
            <list-property name="boundDataColumns">
                <structure>
                    <property name="name">MOV_ID</property>
                    <property name="displayName">MOV_ID</property>

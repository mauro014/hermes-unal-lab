            <property name="queryText">select
mde.MOV_EVENTO, mde.MOV_TITULO, tpo.TPO_DESCRIPCION, mde.MOV_ID
from
HER_MOVILIDAD_TIPO_DE mtd, HER_MOVILIDAD_docentes_eventos mde, HER_TIPO_PONENCIA tpo
where
mtd.MOV_ID = mde.MOV_ID
and mtd.TPO_ID = tpo.TPO_ID
and mde.MOV_ID = ?</property>
        </oda-data-set>

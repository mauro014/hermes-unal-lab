            </list-property>
            <property name="queryText">select 
mov_id,MOV_EVENTO, MOV_TITULO, PAIS_NOMBRE, MOV_CIUDAD,MOV_FEC_INI_EV,MOV_FEC_FIN_EV,
TPO.TPO_DESCRIPCION , MOV_ABSTRACT, MOV_RES_VIAJE , to_number(MOV_COSTO_TIQ) CTIQ, to_number(MOV_COSTO_EV) CEVE, to_number(MOV_APORTE_FAC) AFAC, MOV_ACEPT,
mde.MOV_FEC_SOL
 from HER_MOVILIDAD_DOCENTES_EVENTOS MDE, HER_PAIS PAIS, HER_TIPO_PONENCIA TPO 
where
MOV_ID_SUBTIPO_MOV = 'B1'
and MDE.MOV_ID = ?
AND MDE.MOV_PAIS= PAIS.PAIS_ID 
AND MDE.MOV_TIPO_PONENCIA = TPO.TPO_ID </property>
        </oda-data-set>
        <oda-data-set extensionID="org.eclipse.birt.report.data.oda.jdbc.JdbcSelectDataSet" name="Dependencia" id="3010">
            <structure name="cachedMetaData">
                <list-property name="resultSet">
                    <structure>
                        <property name="position">1</property>
                        <property name="name">DPN_NOMBRE</property>

            </list-property>
            <property name="queryText">SELECT 
TAM.TAM_NOMBRE, AMV.AMV_NOMBRE 
FROM
HER_ARCHIVO_MOVILIDAD_VE AMV, HER_MOVILIDAD_VISITANTES_EXT MVE, HER_TIPO_ARCHIVO_MOVILIDAD TAM
WHERE
    AMV.MOV_ID = MVE.MOV_ID
AND AMV.TAM_ID = TAM.TAM_ID
AND  AMV.MOV_ID = ?
ORDER BY TAM.TAM_ID</property>
        </oda-data-set>

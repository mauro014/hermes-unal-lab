            <property name="queryText">select 
MOV_ID, MOV_NOMBRE_DOCENTE,MOV_DOC_VISITANTE, MOV_NACIONALIDAD, PAIS_NOMBRE,  MOV_UNIVERSIDAD,
MOV_PLAN,MOV_FEC_INI_EV,MOV_FEC_FIN_EV, MOV_EVENTO, TO_NUMBER(MOV_COSTO_TIQ), TO_NUMBER(MOV_MONTO),
TO_NUMBER(MOV_NUM_DIAS), MOV_FEC_SOL, SED.SED_NOMBRE, MOV_ACEPT, MOV_COMENTARIOS_FAC, MOV_APROB, MOV_COMENTARIOS_DIR, MOV_VALOR_VIATICOS , MOV_VALOR_APORTE_FAC , MOV_OTROS_APORTES
 from HER_MOVILIDAD_VISITANTES_EXT MVE, HER_PAIS PAIS, HER_SEDE SED
where
MOV_ID_SUBTIPO_MOV = 'CF_MOV3'
and MVE.MOV_ID = ?
AND MVE.MOV_PAIS= PAIS.PAIS_ID
AND MVE.MOV_SEDE = SED.SED_ID</property>
        </oda-data-set>

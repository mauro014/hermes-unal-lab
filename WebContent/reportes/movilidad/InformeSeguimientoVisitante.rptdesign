                    <property name="nativeName">CNP_TITULO</property>
                    <property name="dataType">string</property>
                </structure>
            </list-property>
            <property name="queryText">SELECT C.CON_TITULO, CP.CNP_TITULO FROM HER_CONVOCATORIA C, HER_CONVOCATORIA_PADRE CP, HER_MOVILIDAD_VISITANTES_EXT MOV
WHERE C.CON_ID = MOV.CON_ID AND MOV.MOV_ID = ? AND C.CNP_ID = CP.CNP_ID</property>
        </oda-data-set>
    </data-sets>

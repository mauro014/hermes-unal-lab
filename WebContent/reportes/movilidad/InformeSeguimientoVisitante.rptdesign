                    <property name="name">DOCENTE</property>
                    <property name="nativeName">DOCENTE</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">2</property>
                    <property name="name">DPN_NOMBRE</property>
                    <property name="nativeName">DPN_NOMBRE</property>
                    <property name="dataType">string</property>
                </structure>
            </list-property>
            <property name="queryText">SELECT  PER.PER_NOMBRE1||' '||PER.PER_NOMBRE2||' '|| PER.PER_APELLIDO1||' '||PER.PER_APELLIDO2 Docente, DPN.DPN_NOMBRE
FROM
HER_MOVILIDAD_VISITANTES_EXT MVE, HER_PERSONA PER, HER_DEPENDENCIA DPN, HER_INVESTIGADOR_INTERNO INI
WHERE 
    PER.PER_ID = MVE.MOV_ID_PER
AND PER.PER_ID = INI.INV_ID
AND INI.DPN_ID = DPN.DPN_ID
AND MVE.MOV_ID = ?</property>
        </oda-data-set>

                </structure>
                <structure>
                    <property name="position">3</property>
                    <property name="name">HOR</property>
                    <property name="nativeName">HOR</property>
                    <property name="dataType">decimal</property>
                </structure>
                <structure>
                    <property name="position">4</property>
                    <property name="name">FECHA</property>
                    <property name="nativeName">FECHA</property>
                    <property name="dataType">date-time</property>
                </structure>
            </list-property>
            <property name="queryText">SELECT ACT_MOV_DESCRIPCION, ACMVE.TAMVE_NOMBRE, ACT_MOV_DURACION HOR, ACT_MOV_FECHA FECHA
FROM 
HER_MOVILIDAD_VISITANTES_EXT MVE, HER_ACTIVIDAD_MOVILIDAD_VE ACT,
HER_TIPO_ACTIVIDAD_MOV_VE ACMVE
WHERE MVE.MOV_ID_SUBTIPO_MOV = 'A1'
AND     MVE.MOV_ID = ACT.MOV_ID
AND     MVE.MOV_ID = ?
AND     ACT.TAMVE_ID = ACMVE.TAMVE_ID

                <structure>
                    <property name="position">1</property>
                    <property name="name">ACT_MOV_DESCRIPCION</property>
                    <property name="nativeName">ACT_MOV_DESCRIPCION</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">2</property>
                    <property name="name">TAMVE_NOMBRE</property>
                    <property name="nativeName">TAMVE_NOMBRE</property>

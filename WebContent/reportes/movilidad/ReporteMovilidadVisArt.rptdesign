            <property name="queryText">SELECT HAM.ACT_MOV_DESCRIPCION, HAM.ACT_MOV_FECHA, HAM.ACT_MOV_DURACION
FROM HER_ACTIVIDAD_MOVILIDAD HAM, HER_MOVILIDAD_VISITANTES_ART HMVA
WHERE HAM.MOV_ID = HMVA.MOV_ID AND HMVA.MOV_ID = ?</property>

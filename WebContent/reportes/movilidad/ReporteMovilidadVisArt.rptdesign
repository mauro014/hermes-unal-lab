            <property name="queryText">SELECT HMVA.MOV_AVAL_FACULTAD,MOV_COMENTARIOS_FAC, HMVA.MOV_DESCRIPCION_FACULTAD, HMVA.MOV_AVAL_SEDE, HMVA.MOV_DESCRIPCION_SEDE, 
HMVA.MOV_NOMBRES_VIS, HMVA.MOV_APELLIDOS_VIS, HTF.TFO_NOMBRE, HMVA.MOV_NOMBRE_ARTISTICO, HC.CONTINENTE_NOMBRE, HP.PAIS_NOMBRE AS "NACIONALIDAD", HMVA.MOV_PASAPORTE, HMVA.MOV_PAGINA_WEB, HMVA.MOV_TELEFONO_FIJO, HMVA.MOV_TELEFONO_MOVIL, HMVA.MOV_DIRECCION,
HMVA.MOV_NOMBRE_PROYECTO, HMVA.MOV_STATEMENT, HMVA.MOV_DESCRIPCION_PROYECTO, HMVA.MOV_OBJETIVO_GENERAL, HMVA.MOV_OBJETIVOS_ESPECIFICOS, HMVA.MOV_RELACION_LOCAL,
HMVA.MOV_FECHA_INICIO, HMVA.MOV_FECHA_FIN, HMVA.MOV_AREA_ARTE, HMVA.MOV_FRONTERA,
HMVA.MOV_CONVENIO, HMVA.MOV_CONVENIO_DESCRIPCION, 
HMVA.MOV_TIQUETE_UN, HMVA.MOV_TALLER_UN, HMVA.MOV_ALOJAMIENTO_UN, HMVA.MOV_ALIMENTACION_UN, HMVA.MOV_MATERIALES_UN, HMVA.MOV_TRANSPORTE_UN, HMVA.MOV_SOCIALIZACION_UN, HMVA.MOV_TOTAL_UN,
HMVA.MOV_TIQUETE_PRO, HMVA.MOV_TALLER_PRO, HMVA.MOV_ALOJAMIENTO_PRO, HMVA.MOV_ALIMENTACION_PRO, HMVA.MOV_MATERIALES_PRO, HMVA.MOV_TRANSPORTE_PRO, HMVA.MOV_SOCIALIZACION_PRO, HMVA.MOV_TOTAL_PROPIO,
HMVA.MOV_SOCIALIZACION_RESIDENCIA, HMVA.MOV_SOCIALIZACION_CAMPUS,
HMVA.MOV_COMO_ENTERO, HMVA.MOV_APORTE_RED, HMVA.MOV_CONTRIBUCION, HMVA.MOV_ESPECIALISTAS_AREA, HMVA.MOV_TRABAJOS
FROM HER_MOVILIDAD_VISITANTES_ART HMVA, HER_TIPO_FORMACION HTF, HER_CONTINENTE HC, HER_PAIS HP
WHERE HTF.TFO_ID = HMVA.TFO_ID AND HC.CONTINENTE_ID = HMVA.MOV_CONTINENTE AND HP.PAIS_ID = HMVA.MOV_NACIONALIDAD AND HMVA.MOV_ID = ?</property>
        </oda-data-set>
        <oda-data-set extensionID="org.eclipse.birt.report.data.oda.jdbc.JdbcSelectDataSet" name="ActividadMovilidadVisitanteArtes" id="7289">

            </list-property>
            <property name="queryText">select * from (
select mov.mov_id as idmovilidad, mov.MOV_FEC_SOL as fecha, 
decode ((decode(mov.mov_aprob, '', '','SI','A','NO','R','') || decode(mov.mov_acept, '', 'I','SI','AP','NO','N','')),'I','Ingresado','AP','Aprobado Facultad','N','No Aprobado Facultad','AAP','Aprobado Sede','R','No Aprobado Sede','RAP','No Aprobado Sede','') nombreEstado,
mov.MOV_FEC_INI_EV as fechaInicio, mov.MOV_FEC_FIN_EV as fechaFinal, mov.MOV_COSTO_TIQ as tiquetes, pe.PLE_NOMBRE as programa, mov.MOV_VALOR_VIATICOS as viaticos, mov.MOV_COSTO_EV as inscripcionEvento,
mov.MOV_EVENTO as evento, pais.PAIS_NOMBRE as pais, c.CON_TITULO as modalidad, cp.CNP_TITULO as convocatoria_padre, '' as grupo, '' as dias, '' as valorDiario,
PER.PER_NOMBRE1||' '||DECODE(PER.PER_NOMBRE2, PER.PER_NOMBRE2,PER.PER_NOMBRE2,NULL,' ')||' '||PER.PER_APELLIDO1||' '||DECODE(PER.PER_APELLIDO2, PER.PER_APELLIDO2,PER.PER_APELLIDO2,NULL,' ') inv,
per.tdo_id as tipoDoc, per.per_id as documento, d.dpn_nombre as depto, d2.dpn_nombre as facultad, s.SED_NOMBRE as sede, '' as estudiante, '' as visitante, mov.mov_nombre_universidad as institucion,
to_char(mov.mov_valor_aporte_fac) as aporteFac, to_char(mov.mov_valor_aporte_sede) as aporteSede, DECODE(MOV.MOV_ESTADO_SEG,'F','SI','NO') as informe, TO_CHAR(MOV.MOV_TOTAL_APOYO) AS TOTALAPOYO,
'' as paisProcedencia, decode(mov.mov_estado_revision_seg,'L','Revisado','D','Devuelto','')estado_revision, MOV_DIS_PRESUPUESTAL_SEDE as disp_Presupuestal_sede, MOV_DIS_PRESUPUESTAL as disp_presupuestal_fac
from HER_MOVILIDAD_DOCENTES_EVENTOS mov 
left join HER_PLAN_ESTUDIOS pe on mov.MOV_PROGRAMA = pe.PLE_ID 
left join HER_PAIS pais on pais.PAIS_ID = mov.MOV_PAIS
left join her_convocatoria c on c.CON_ID = mov.CON_ID 
left join her_convocatoria_padre cp on cp.cnp_id = c.cnp_id, 
HER_INVESTIGADOR_INTERNO ii left join her_persona per on per.per_id = ii.inv_id and per.tdo_id = ii.tdo_id, 
her_dependencia d left join her_dependencia d2 on d.dpn_facultad = d2.dpn_id left join her_sede s on s.sed_id = d.sed_id
where mov.CON_ID in (SELECT COLUMN_VALUE FROM TABLE(SPLIT(?))) 
and mov.MOV_ID_PER = ii.INV_ID 
and mov.MOV_TDO_ID_PER = ii.TDO_ID 
and d.DPN_ID = ii.DPN_ID 
and (d.dpn_facultad = ?
or d.SED_ID in (SELECT COLUMN_VALUE FROM TABLE(SPLIT(?))))
union
select mov.mov_id as idmovilidad, mov.MOV_FEC_SOL as fecha,
decode ((decode(mov.mov_aprob, '', '','SI','A','NO','R','') || decode(mov.mov_acept, '', 'I','SI','AP','NO','N','')),'I','Ingresado','AP','Aprobado Facultad','N','No Aprobado Facultad','AAP','Aprobado Sede','R','No Aprobado Sede','RAP','No Aprobado Sede','') nombreEstado,
mov.MOV_FEC_INI_EV as fechaInicio, mov.MOV_FEC_FIN_EV as fechaFinal, mov.MOV_COSTO_TIQ as tiquetes, pe.PLE_NOMBRE as programa, mov.MOV_VALOR_VIATICOS as viaticos, mov.MOV_COSTO_EV as inscripcionEvento,
mov.MOV_EVENTO, pais.PAIS_NOMBRE as pais, c.CON_TITULO as modalidad, cp.CNP_TITULO as convocatoria_padre, '' as grupo, '' as dias, '' as valorDiario,
PER.PER_NOMBRE1||' '||DECODE(PER.PER_NOMBRE2, PER.PER_NOMBRE2,PER.PER_NOMBRE2,NULL,' ')||' '||PER.PER_APELLIDO1||' '||DECODE(PER.PER_APELLIDO2, PER.PER_APELLIDO2,PER.PER_APELLIDO2,NULL,' ') inv,
per.tdo_id as tipoDoc, per.per_id as documento, d.dpn_nombre as depto, d2.dpn_nombre as facultad, s.SED_NOMBRE as sede,
est.est_NOMBRE1||' '||DECODE(est.est_NOMBRE2, est.est_NOMBRE2,est.est_NOMBRE2,NULL,' ')||' '||est.est_APELLIDO1||' '||DECODE(est.est_APELLIDO2, est.est_APELLIDO2,est.est_APELLIDO2,NULL,' ') estudiante,
'' as visitante, mov.mov_institucion_ofrece as institucion, to_char(mov.mov_valor_aporte_fac) as aporteFac, to_char(mov.mov_valor_aporte_sede) as aporteSede, DECODE(MOV.MOV_ESTADO_SEG,'F','SI','NO') as informe, TO_CHAR(MOV.MOV_TOTAL_APOYO) AS TOTALAPOYO,
'' as paisProcedencia,decode(mov.mov_estado_revision_seg,'L','Revisado','D','Devuelto','')estado_revision, MOV_DIS_PRESUPUESTAL_SEDE as disp_Presupuestal_sede, MOV_DIS_PRESUPUESTAL as disp_presupuestal_fac
from HER_MOVILIDAD_ESTUDIANTE_POS mov 
left join HER_PAIS pais on pais.PAIS_ID = mov.MOV_PAIS
left join her_convocatoria c on c.CON_ID = mov.CON_ID 
left join her_convocatoria_padre cp on cp.cnp_id = c.cnp_id left join her_persona per on per.per_id = mov.MOV_ID_PER and per.tdo_id = mov.MOV_TDO_ID_PER, HER_TMP_ESTUDIANTE est  
left join HER_PLAN_ESTUDIOS pe on est.EST_PLAN = pe.PLE_ID, 
her_dependencia d left join her_dependencia d2 on d.dpn_facultad = d2.dpn_id left join her_sede s on s.sed_id = d.sed_id
where mov.CON_ID in (SELECT COLUMN_VALUE FROM TABLE(SPLIT(?)))
and mov.MOV_ID_EST = est.EST_ID
and mov.MOV_TDO_ID_EST = est.TDO_ID
and d.DPN_ID = est.DPN_ID
and (d.dpn_facultad = ?
or d.SED_ID in (SELECT COLUMN_VALUE FROM TABLE(SPLIT(?))))
union
select mov.mov_id as idmovilidad, mov.MOV_FEC_SOL as fecha, 
decode ((decode(mov.mov_aprob, '', '','SI','A','NO','R','') || decode(mov.mov_acept, '', 'I','SI','AP','NO','N','')),'I','Ingresado','AP','Aprobado Facultad','N','No Aprobado Facultad','AAP','Aprobado Sede','R','No Aprobado Sede','RAP','No Aprobado Sede','') nombreEstado,
mov.MOV_FEC_INI_EV as fechaInicio, mov.MOV_FEC_FIN_EV as fechaFinal, mov.MOV_COSTO_TIQ as tiquetes, pe.PLE_NOMBRE as programa, mov.MOV_VALOR_VIATICOS as viaticos, '' as inscripcionEvento,
mov.MOV_EVENTO as evento, '' as pais, c.CON_TITULO as modalidad, cp.CNP_TITULO as convocatoria_padre, g.gru_nombre as grupo, mov.MOV_NUM_DIAS as dias, mov.MOV_MONTO as valorDias,
PER.PER_NOMBRE1||' '||DECODE(PER.PER_NOMBRE2, PER.PER_NOMBRE2,PER.PER_NOMBRE2,NULL,' ')||' '||PER.PER_APELLIDO1||' '||DECODE(PER.PER_APELLIDO2, PER.PER_APELLIDO2,PER.PER_APELLIDO2,NULL,' ') inv,
per.tdo_id as tipoDoc, per.per_id as documento, d.dpn_nombre as depto, d2.dpn_nombre as facultad, s.SED_NOMBRE as sede, '' as estudiante,
mov.MOV_NOMBRE_DOCENTE as visitante, mov.mov_universidad as institucion, to_char(mov.mov_valor_aporte_fac) as aporteFac, to_char(mov.mov_valor_aporte_sede) as aporteSede,
DECODE(MOV.MOV_ESTADO_SEG,'F','SI','NO') as informe, TO_CHAR(MOV.MOV_TOTAL_APOYO) AS TOTALAPOYO, pais.PAIS_NOMBRE as paisProcedencia,
decode(mov.mov_estado_revision_seg,'L','Revisado','D','Devuelto','')estado_revision, MOV_DIS_PRESUPUESTAL_SEDE as disp_Presupuestal_sede, MOV_DIS_PRESUPUESTAL as disp_presupuestal_fac
from HER_MOVILIDAD_VISITANTES_EXT mov 
left join HER_PLAN_ESTUDIOS pe on mov.MOV_ID_PROG = pe.PLE_ID 
left join HER_PAIS pais on pais.PAIS_ID = mov.MOV_PAIS
left join her_convocatoria c on c.CON_ID = mov.CON_ID 
left join her_convocatoria_padre cp on cp.cnp_id = c.cnp_id
left join her_grupo g on g.gru_id = mov.MOV_ID_GRUPO, HER_INVESTIGADOR_INTERNO ii left join her_persona per on per.per_id = ii.inv_id and per.tdo_id = ii.tdo_id, 
her_dependencia d left join her_dependencia d2 on d.dpn_facultad = d2.dpn_id left join her_sede s on s.sed_id = d.sed_id
where mov.CON_ID in (SELECT COLUMN_VALUE FROM TABLE(SPLIT(?))) 
and mov.MOV_ID_PER = ii.INV_ID 
and mov.MOV_TDO_ID_PER = ii.TDO_ID 
and d.DPN_ID = ii.DPN_ID 
and (d.dpn_facultad = ?
or d.SED_ID in (SELECT COLUMN_VALUE FROM TABLE(SPLIT(?))))
union
select mov.mov_id as idmovilidad, mov.MOV_FECHA_SOLICITUD as fecha, 
decode ((decode(mov.MOV_AVAL_SEDE, '', '','SI','A','NO','R','') || decode(mov.MOV_AVAL_FACULTAD, '', 'I','SI','AP','NO','N','')),'I','Ingresado','AP','Aprobado Facultad','N','No Aprobado Facultad','AAP','Aprobado Sede','R','No Aprobado Sede','RAP','No Aprobado Sede','') nombreEstado,
mov.MOV_FECHA_INICIO as fechaInicio, mov.MOV_FECHA_FIN as fechaFinal, TO_CHAR(mov.MOV_TIQUETE_UN) as tiquetes, '' as programa, '' as viaticos, '' as inscripcionEvento,
'' as evento, '' as pais, c.CON_TITULO as modalidad, cp.CNP_TITULO as convocatoria_padre, '' as grupo, '' as dias, '' as valorDias,
'' as inv,
'' as tipoDoc, '' as documento, d.dpn_nombre as depto, d2.dpn_nombre as facultad, s.SED_NOMBRE as sede, '' as estudiante,
PER.PER_NOMBRE1||' '||DECODE(PER.PER_NOMBRE2, PER.PER_NOMBRE2,PER.PER_NOMBRE2,NULL,' ')||' '||PER.PER_APELLIDO1||' '||DECODE(PER.PER_APELLIDO2, PER.PER_APELLIDO2,PER.PER_APELLIDO2,NULL,' ') visitante, '' as institucion, '' as aporteFac, '' as aporteSede, '' as informe,
'' AS TOTALAPOYO, pais.PAIS_NOMBRE as paisProcedencia, '' as estado_revision, MOV_DIS_PRESUPUESTAL_SEDE as disp_Presupuestal_sede, MOV_DIS_PRESUPUESTAL as disp_presupuestal_fac
from HER_MOVILIDAD_VISITANTES_ART mov 
left join HER_PAIS pais on pais.PAIS_ID = mov.MOV_NACIONALIDAD
left join her_convocatoria c on c.CON_ID = mov.CON_ID 
left join her_convocatoria_padre cp on cp.cnp_id = c.cnp_id left join HER_INVESTIGADOR_INTERNO ii on mov.MOV_ID_PER = ii.INV_ID and mov.MOV_TDO_ID_PER = ii.TDO_ID  left join her_persona per on per.per_id = mov.MOV_ID_PER and per.tdo_id = mov.MOV_TDO_ID_PER, 
her_dependencia d left join her_dependencia d2 on d.dpn_facultad = d2.dpn_id left join her_sede s on s.sed_id = d.sed_id
where mov.CON_ID in (SELECT COLUMN_VALUE FROM TABLE(SPLIT(?))) 
and d.DPN_ID = mov.DPN_ID 
and (d.dpn_facultad = ?
or d.SED_ID in (SELECT COLUMN_VALUE FROM TABLE(SPLIT(?))))
union
select mov.mov_id as idmovilidad, mov.MOV_FECHA_SOLICITUD as fecha, 
decode ((decode(mov.MOV_AVAL_SEDE, '', '','SI','A','NO','R','') || decode(mov.MOV_AVAL_FACULTAD, '', 'I','SI','AP','NO','N','')),'I','Ingresado','AP','Aprobado Facultad','N','No Aprobado Facultad','AAP','Aprobado Sede','R','No Aprobado Sede','RAP','No Aprobado Sede','') nombreEstado,
mov.MOV_FECHA_INICIO as fechaInicio, mov.MOV_FECHA_FIN as fechaFinal, TO_CHAR(mov.MOV_TIQUETE_UN) as tiquetes, '' as programa, '' as viaticos, '' as inscripcionEvento,
'' as evento, pais.pais_nombre as pais, c.CON_TITULO as modalidad, cp.CNP_TITULO as convocatoria_padre, '' as grupo, '' as dias, '' as valorDias,
PER.PER_NOMBRE1||' '||DECODE(PER.PER_NOMBRE2, PER.PER_NOMBRE2,PER.PER_NOMBRE2,NULL,' ')||' '||PER.PER_APELLIDO1||' '||DECODE(PER.PER_APELLIDO2, PER.PER_APELLIDO2,PER.PER_APELLIDO2,NULL,' ') inv,
per.tdo_id as tipoDoc, per.per_id as documento, d.dpn_nombre as depto, d2.dpn_nombre as facultad, s.SED_NOMBRE as sede, '' as estudiante,
'' as visitante, mov.mov_institucion as institucion, '' as aporteFac, '' as aporteSede, '' as informe, '' AS TOTALAPOYO, '' as paisProcedencia, '' as estado_revision, MOV_DIS_PRESUPUESTAL_SEDE as disp_Presupuestal_sede, MOV_DIS_PRESUPUESTAL as disp_presupuestal_fac
from HER_MOVILIDAD_DOCENTES_ART mov 
left join her_convocatoria c on c.CON_ID = mov.CON_ID 
left join her_convocatoria_padre cp on cp.cnp_id = c.cnp_id
left join HER_PAIS pais on pais.PAIS_ID = mov.MOV_PAIS, HER_INVESTIGADOR_INTERNO ii left join her_persona per on per.per_id = ii.inv_id and per.tdo_id = ii.tdo_id, 
her_dependencia d left join her_dependencia d2 on d.dpn_facultad = d2.dpn_id left join her_sede s on s.sed_id = d.sed_id
where mov.CON_ID in (SELECT COLUMN_VALUE FROM TABLE(SPLIT(?))) 
and mov.MOV_ID_PER = ii.INV_ID 
and mov.MOV_TDO_ID_PER = ii.TDO_ID 
and d.DPN_ID = ii.DPN_ID 
and (d.dpn_facultad = ?
or d.SED_ID in (SELECT COLUMN_VALUE FROM TABLE(SPLIT(?))))
union
select mov.mov_id as idmovilidad, mov.MOV_FECHA_SOLICITUD as fecha, 
decode ((decode(mov.MOV_AVAL_SEDE, '', '','SI','A','NO','R','') || decode(mov.MOV_AVAL_FACULTAD, '', 'I','SI','AP','NO','N','')),'I','Ingresado','AP','Aprobado Facultad','N','No Aprobado Facultad','AAP','Aprobado Sede','R','No Aprobado Sede','RAP','No Aprobado Sede','') nombreEstado,
mov.MOV_FECHA_INICIO as fechaInicio, mov.MOV_FECHA_FIN as fechaFinal, TO_CHAR(mov.MOV_TIQUETE_UN) as tiquetes, pe.ple_nombre as programa, '' as viaticos, '' as inscripcionEvento,
'' as evento, pais.pais_nombre as pais, c.CON_TITULO as modalidad, cp.CNP_TITULO as convocatoria_padre, '' as grupo, '' as dias, '' as valorDias,
PER.PER_NOMBRE1||' '||DECODE(PER.PER_NOMBRE2, PER.PER_NOMBRE2,PER.PER_NOMBRE2,NULL,' ')||' '||PER.PER_APELLIDO1||' '||DECODE(PER.PER_APELLIDO2, PER.PER_APELLIDO2,PER.PER_APELLIDO2,NULL,' ') inv,
per.tdo_id as tipoDoc, per.per_id as documento, d.dpn_nombre as depto, d2.dpn_nombre as facultad, s.SED_NOMBRE as sede,
est.est_NOMBRE1||' '||DECODE(est.est_NOMBRE2, est.est_NOMBRE2,est.est_NOMBRE2,NULL,' ')||' '||est.est_APELLIDO1||' '||DECODE(est.est_APELLIDO2, est.est_APELLIDO2,est.est_APELLIDO2,NULL,' ') estudiante,
'' as visitante, mov.mov_institucion as institucion, '' as aporteFac, '' as aporteSede, '' as informe, '' AS TOTALAPOYO, '' as paisProcedencia, '' as estado_revision, MOV_DIS_PRESUPUESTAL_SEDE as disp_Presupuestal_sede, MOV_DIS_PRESUPUESTAL as disp_presupuestal_fac
from HER_MOVILIDAD_ESTUDIANTES_ART mov 
left join her_convocatoria c on c.CON_ID = mov.CON_ID 
left join her_convocatoria_padre cp on cp.cnp_id = c.cnp_id
left join HER_PAIS pais on pais.PAIS_ID = mov.MOV_PAIS left join her_persona per on per.per_id = mov.MOV_ID_PER and per.tdo_id = mov.MOV_TDO_ID_PER, 
her_dependencia d left join her_dependencia d2 on d.dpn_facultad = d2.dpn_id left join her_sede s on s.sed_id = d.sed_id,
HER_TMP_ESTUDIANTE est left join HER_PLAN_ESTUDIOS pe on est.EST_PLAN = pe.PLE_ID
where mov.CON_ID in (SELECT COLUMN_VALUE FROM TABLE(SPLIT(?))) 
and mov.MOV_ID_EST = est.EST_ID
and mov.MOV_TDO_ID_EST = est.TDO_ID
and d.DPN_ID = est.DPN_ID 
and (d.dpn_facultad = ?
or d.SED_ID in (SELECT COLUMN_VALUE FROM TABLE(SPLIT(?))))
) movilidades where documento not in ('19380666','52980878','79750255') or documento is null order by movilidades.idmovilidad asc</property>

PLE.PLE_NOMBRE, EST.EST_ID || ' - ' || EST.TDO_ID documento, EST.EST_EMAIL, EST.EST_PAPA, mep.MOV_PASAPORTE_EST, DPN.DPN_NOMBRE Facultad

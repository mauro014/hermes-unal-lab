                    <property name="nativeName">MOV_INSTITUCION_OFRECE</property>
                    <property name="dataType">string</property>
                </structure>
            </list-property>
            <property name="queryText">Select 
MOV_ID,MOV_EVENTO, MOV_TITULO, PAIS_NOMBRE, nvl((SELECT CIU_NOMBRE from HER_CIUDAD where CIU_ID=MOV_CIUDAD),MOV_CIUDAD) MOV_CIUDAD,MOV_FEC_INI_EV,MOV_FEC_FIN_EV,
TPO.TPO_DESCRIPCION , MOV_ABSTRACT, to_number(MOV_COSTO_TIQ) CTIQ, to_number(MOV_COSTO_EV) CEVE,  MOV_ACEPT, MOV_COMENTARIOS_FAC, MOV_APROB, MOV_COMENTARIOS_DIR,
mep.MOV_FEC_SOL, mep.MOV_PASANTIA_ESTANCIA PASE, MOV_INSTITUCION_OFRECE INST, mep.mov_valor_viaticos, mep.mov_fecha_aceptacion, mep.mov_valor_aporte_fac,
mep.mov_fecha_aprobacion, mep.mov_valor_aporte_sede, MEP.MOV_FACULTAD,
RESPONSABLE_FAC.PER_NOMBRE1 || ' ' || RESPONSABLE_FAC.PER_NOMBRE2 || ' ' || RESPONSABLE_FAC.PER_APELLIDO1 || ' ' || RESPONSABLE_FAC.PER_APELLIDO2 RES_FACULTAD,
RESPONSABLE_SED.PER_NOMBRE1 || ' ' || RESPONSABLE_SED.PER_NOMBRE2 || ' ' || RESPONSABLE_SED.PER_APELLIDO1 || ' ' || RESPONSABLE_SED.PER_APELLIDO2 RES_SED
 , mep.MOV_OTROS_APORTES, DECODE(mep.MOV_CARACTER_EVENTO, '1', 'Internacional en Colombia','2', 'Internacional en el extranjero','3', 'Nacional','4', 'Nacional en Colombia','5', 'Nacional en el extranjero','7','Virtual') as caracterEvento, decode(mep.MOV_MEDIO_TRANSPORTE, '1', 'Terrestre','2', 'Aereo') as medioTransporte, mep.MOV_DEP_OTROS_APORTES as "OtrosAportesDependencia",
 CONV.CON_AREA_DIRIGIDA AS ESCONCURSO, CONV.CON_GRUPOS_CATEGORIA_A AS mostrarViaticos, CONV.CON_GRUPOS_CATEGORIA_B AS mostrarInscEvento, CONV.CON_GRUPOS_CATEGORIA_C AS mostrarTiquetes,CONV.CON_GRUPOS_CATEGORIA_D AS mostrarTotalSol, CONV.CON_GRUPOS_RECONOCIDOS AS mostrarAportesDepe,
 DECODE(mep.MOV_TIPO,'P','Presencial','V','Virtual')MOV_TIPO,mep.CON_ID, mep.MOV_INSTITUCION_OFRECE
 from HER_MOVILIDAD_ESTUDIANTE_POS MEP  LEFT JOIN HER_PERSONA RESPONSABLE_FAC ON 
RESPONSABLE_FAC.PEr_id = MEP.MOV_ID_PER_APROB AND RESPONSABLE_FAC.TDO_ID = MEP.MOV_TDO_ID_PER_APROB LEFT JOIN HER_PERSONA RESPONSABLE_SED ON 
RESPONSABLE_SED.PEr_id = MEP.MOV_ID_PER_APROB_SED AND RESPONSABLE_SED.TDO_ID = MEP.MOV_TDO_ID_PER_APROB_SED, HER_PAIS PAIS, HER_TIPO_PONENCIA TPO, HER_CONVOCATORIA CONV
where MEP.MOV_ID = ?
AND MEP.MOV_PAIS= PAIS.PAIS_ID 
AND MEP.MOV_TIPO_PONENCIA = TPO.TPO_ID 
AND MEP.CON_ID = CONV.CON_ID</property>
        </oda-data-set>
        <oda-data-set extensionID="org.eclipse.birt.report.data.oda.jdbc.JdbcSelectDataSet" name="Dependencia" id="3010">

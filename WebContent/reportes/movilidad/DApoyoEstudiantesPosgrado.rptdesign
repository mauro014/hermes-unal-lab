            <property name="queryText">SELECT TPR.TPR_NOMBRE, decode (PRR.REQ_CUMPLIDO, 'S', 'Si', 'N', 'No' )SINO, PRR.REQ_COMENTARIO
FROM
HER_MOVILIDAD_REQUISITO prr,HER_TIPO_REQUISITO TPR, HER_MOVILIDAD_ESTUDIANTE_POS MEP

            <property name="queryText">select distinct
	*
from (
	select
		cp.CNP_TITULO as "NOMBRE CONVOCATORIA",
		c.CON_TITULO as "MODALIDAD",
		m.MOV_ID as "CÓDIGO HERMES",
		case
			when m.mov_estado='C' then 'Cancelada'
			else
		decode(
			decode(m.mov_aprob, '', '','SI','A','NO','R','') || decode(m.mov_acept, '', 'I','SI','AP','NO','N',''),
			'I','Ingresado',
			'AP','Aprobado Facultad',
			'N','No Aprobado Facultad',
			'AAP','Aprobado Sede',
			'R','No Aprobado Sede',
			'RAP','No Aprobado Sede',
			''
		)
		end as "ESTADO",
		to_char(m.MOV_FEC_SOL) as "FECHA REGISTRO",
		m.MOV_EVENTO as "NOMBRE DEL EVENTO",
		'Investigador' as "TIPO MOVILIDAD",
		tam.act as "TIPO ACTIVIDAD",
		m.MOV_TDO_ID_PER||'-'||m.MOV_ID_PER as "DOCUMENTO DOC. RESPONSABLE",
		per.PER_APELLIDO1||' '||per.PER_APELLIDO2||', '||per.PER_NOMBRE1||' '||per.PER_NOMBRE2||' ' as "DOCENTE RESPONSABLE",
		per.PER_EMAIL as "E-MAIL DOCENTE",
		s.SED_NOMBRE as "SEDE",
		d2.DPN_NOMBRE as "FACULTAD",
		d.DPN_NOMBRE as "DEPARTAMENTO",
		pp.PPS_NOMBRE as "PROGRAMA ACADÉMICO",
		g.GRU_NOMBRE as "GRUPO DE INVESTIGACIÓN",
		m.MOV_NOMBRE_DOCENTE as "NOMBRE VISITANTE",
		decode(m.MOV_DOC_VISITANTE,null,'','P-'||m.MOV_DOC_VISITANTE) as "DOCUMENTO VISITANTE",
		m.MOV_EMAIL_VISITANTE as "CORREO VISITANTE",
		m.MOV_NACIONALIDAD as "NACIONALIDAD VISITANTE",
		pa.PAIS_NOMBRE as "PAÍS VISITANTE",
		decode(ins.ins_nombre,null,m.MOV_UNIVERSIDAD,ins.ins_nombre) as "INSTITUCIÓN VIS.",
		to_char(m.MOV_FEC_INI_EV) as "FECHA INICIO",
		to_char(m.MOV_FEC_FIN_EV) as "FECHA FINAL",
		m.MOV_NUM_DIAS as "DURACIÓN",
		m.MOV_MONTO as "VALOR VIATICOS D.",
		to_char(to_number(trim(replace(nvl(m.MOV_NUM_DIAS,'0'),',','.')))*nvl(m.MOV_MONTO,'0')) as "VALOR VIATICOS T.",
		m.MOV_COSTO_TIQ as "VALOR TIQUETES",
		to_char(to_number(trim(replace(nvl(m.MOV_NUM_DIAS,'0'),',','.')))*nvl(m.MOV_MONTO,'0')+nvl(m.MOV_COSTO_TIQ,'0')) as "VALOR PROP.",
		nvl(m.MOV_VALOR_APORTE_FAC,0) as "TOTAL FAC.",
		nvl(m.MOV_VALOR_APORTE_SEDE,0) as "TOTAL SED.",
		to_char(nvl(m.MOV_VALOR_APORTE_FAC,0)+nvl(m.MOV_VALOR_APORTE_SEDE,0)) as "VALOR APROB.",
		m.MOV_COMENTARIOS_DIR as "COMENTARIO SEDE",
		decode(m.MOV_ESTADO_SEG,'F','SI','NO') as "INFORME DE SEGUIMIENTO",
		decode(m.MOV_ESTADO_SEG,'F','Registrado','P','Ingresando')||decode(m.MOV_ESTADO_REVISION_SEG,null,'','-')||decode(m.MOV_ESTADO_REVISION_SEG,'L','Revisado','D','Devuelto Para Correcciones','A','Aprobación Sede',m.MOV_ESTADO_REVISION_SEG) as "ESTADO INFORME DE SEGUIMIENTO",
		decode(m.MOV_ESTADO_SEG,'F',m.MOV_REALIZACION_MOVILIDAD,decode(m.MOV_ESTADO,'C',m.MOV_REALIZACION_MOVILIDAD,'')) as "MOV. REALIZADA",
	    decode(m.MOV_ESTADO_SEG,'F',decode(m.MOV_REALIZACION_MOVILIDAD,'NO',MOV_RAZONES_NO_REALIZACION,''),'') as "MOTIVOS NO REALIZACION",
		decode(m.MOV_ESTADO_SEG,'F',decode(m.MOV_REALIZACION_MOVILIDAD,'SI',to_char(m.MOV_TOTAL_VIATICOS),''),'') as "VALOR VIATICOS SEG.",
		decode(m.MOV_ESTADO_SEG,'F',decode(m.MOV_REALIZACION_MOVILIDAD,'SI',to_char(m.MOV_TOTAL_TIQUETES),''),'') as "VALOR TIQUETES SEG.",
		decode(m.MOV_ESTADO_SEG,'F',decode(m.MOV_REALIZACION_MOVILIDAD,'SI',to_char(m.MOV_TOTAL_APOYO),''),'') as "VALOR EJECT.",
		had.fecha as "FECHA APROBACION"
	from
		HER_MOVILIDAD_VISITANTES_EXT m
			left join HER_CONVOCATORIA c on m.CON_ID=c.CON_ID
		    left join HER_CONVOCATORIA_PADRE cp on c.CNP_ID = cp.CNP_ID
    		left join (
    			select
    				x.MOV_ID,
    				listagg(x.TAMVE_NOMBRE,'; ') WITHIN GROUP (ORDER BY x.TAMVE_NOMBRE) as act
	    		from (
    				select
    					distinct MOV_ID,
    					TAMVE_NOMBRE
    				from
	    				HER_ACTIVIDAD_MOVILIDAD_VE am
    	    				left join HER_TIPO_ACTIVIDAD_MOV_VE tam on tam.TAMVE_ID = am.TAMVE_ID
					)x
					group by x.MOV_ID
			) tam on m.MOV_ID=tam.MOV_ID
			left join HER_PERSONA per on per.TDO_ID = m.MOV_TDO_ID_PER and m.MOV_ID_PER=per.PER_ID
			left join HER_INVESTIGADOR_INTERNO ii on per.PER_ID = ii.INV_ID and per.TDO_ID = ii.TDO_ID
			left join HER_DEPENDENCIA d on ii.DPN_ID = d.DPN_ID
			left join HER_DEPENDENCIA d2 on d.DPN_FACULTAD = d2.DPN_ID
			left join HER_SEDE s on s.SED_ID = d2.SED_ID
			left join HER_PROGRAMA_POSGRADO pp on pp.PPS_ID = m.mov_id_prog
			left join HER_GRUPO g on g.GRU_ID=m.mov_id_grupo
			left join HER_INSTITUCION INS ON M.MOV_UNIVERSIDAD = INS.INS_id
			left join HER_PAIS pa on pa.PAIS_ID=m.MOV_PAIS
			left join (
    	    	select
					MOV_ID,
					to_char(max(HEM_FECHA)) fecha
				from
					HER_HISTORICO_ESTADO_MOVILIDAD
				where
					MOV_APROB='SI'
				group by MOV_ID
			) had on had.MOV_ID=m.MOV_ID
	where
        c.CON_ID in (SELECT COLUMN_VALUE FROM TABLE(SPLIT(?1)))
		--c.CON_ID in ('897','704')
    	and per.PER_ID not in ('52015719', '52585723', '52116940', '1023876575', '1032380386', '1053799116','19380666')
        and (d.dpn_facultad = ?2 or d.SED_ID in (SELECT COLUMN_VALUE FROM TABLE(SPLIT(?3))))
union all
	select
		cp.CNP_TITULO as "NOMBRE CONVOCATORIA",
		c.CON_TITULO as "MODALIDAD",
		m.MOV_ID as "CÓDIGO HERMES",
		case
			when m.mov_estado='C' then 'Cancelada'
			else
		decode(
			decode(m.MOV_AVAL_SEDE, '', '','SI','A','NO','R','') || decode(m.MOV_AVAL_FACULTAD, '', 'I','SI','AP','NO','N',''),
			'I','Ingresado',
			'AP','Aprobado Facultad',
			'N','No Aprobado Facultad',
			'AAP','Aprobado Sede',
			'R','No Aprobado Sede',
			'RAP','No Aprobado Sede',
			''
		) end as "ESTADO",
		to_char(m.MOV_FECHA_SOLICITUD) as "FECHA REGISTRO",
		'' as "NOMBRE DEL EVENTO",
		'Residencia Artística' as "TIPO MOVILIDAD",
		'' as "TIPO ACTIVIDAD",
		m.MOV_TDO_ID_PER||'-'||m.MOV_ID_PER as "DOCUMENTO DOC. RESPONSABLE",
		per.PER_APELLIDO1||' '||per.PER_APELLIDO2||', '||per.PER_NOMBRE1||' '||per.PER_NOMBRE2||' ' as "DOCENTE RESPONSABLE",
		per.PER_EMAIL as "E-MAIL DOCENTE",
		s.SED_NOMBRE as "SEDE",
		d2.DPN_NOMBRE as "FACULTAD",
		d.DPN_NOMBRE as "DEPARTAMENTO",
		tf.TFO_NOMBRE as "PROGRAMA ACADÉMICO",
		'' as "GRUPO DE INVESTIGACIÓN",
		'' as "NOMBRE VISITANTE",
		'' as "DOCUMENTO VISITANTE",
		'' as "CORREO VISITANTE",
		'' as "NACIONALIDAD VISITANTE",
		pa.PAIS_NOMBRE as "PAÍS VISITANTE",
		'' as "INSTITUCIÓN VIS.",
		to_char(m.MOV_FECHA_INICIO) as "FECHA INICIO",
		to_char(m.MOV_FECHA_FIN) as "FECHA FINAL",
		'' as "DURACIÓN",
		'' as "VALOR VIATICOS D.",
		'' as "VALOR VIATICOS T.",
		'' as "VALOR TIQUETES",
		'' as "VALOR PROP.",
		'' as "TOTAL FAC.",
		'' as "TOTAL SED.",
		'' as "VALOR APROB.",
		m.MOV_DESCRIPCION_SEDE as "COMENTARIO SEDE",
		'' as "INFORME DE SEGUIMIENTO",
		'' as "ESTADO INFORME DE SEGUIMIENTO",
		'' as "MOV. REALIZADA",
		'' as "MOTIVOS NO REALIZACION",
		'' as "VALOR VIATICOS SEG.",
		'' as "VALOR TIQUETES SEG.",
		'' as "VALOR EJECT.",
		had.fecha as "FECHA APROBACION"
	from
		HER_MOVILIDAD_VISITANTES_ART m
			left join HER_CONVOCATORIA c on m.CON_ID=c.CON_ID
			left join HER_CONVOCATORIA_PADRE cp on c.CNP_ID = cp.CNP_ID
			left join HER_PERSONA per on per.TDO_ID = m.MOV_TDO_ID_PER and m.MOV_ID_PER=per.PER_ID
			left join HER_INVESTIGADOR_INTERNO ii on per.PER_ID = ii.INV_ID and per.TDO_ID = ii.TDO_ID
			left join HER_DEPENDENCIA d on ii.DPN_ID = d.DPN_ID
			left join HER_DEPENDENCIA d2 on d.DPN_FACULTAD = d2.DPN_ID
			left join HER_SEDE s on s.SED_ID = d2.SED_ID
			left join HER_TIPO_FORMACION tf on tf.TFO_ID = m.TFO_ID
			left join HER_PAIS pa on pa.PAIS_ID=m.MOV_NACIONALIDAD
			left join (
				select
					MOV_ID,
					to_char(max(HEM_FECHA)) fecha
				from
					HER_HISTORICO_ESTADO_MOVILIDAD
				where
					MOV_APROB='SI'
				group by MOV_ID
			) had on had.MOV_ID=m.MOV_ID
	where
		--c.CON_ID in ('897','704')
        c.CON_ID in (SELECT COLUMN_VALUE FROM TABLE(SPLIT(?4)))
		and per.PER_ID not in ('52015719', '52585723', '52116940', '1023876575', '1032380386', '1053799116','19380666')
        and (d.dpn_facultad = ?5 or d.SED_ID in (SELECT COLUMN_VALUE FROM TABLE(SPLIT(?6))))
) x
order by x."CÓDIGO HERMES"</property>
        </oda-data-set>

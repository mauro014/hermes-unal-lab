            <property name="queryText">select ACT_MOV_DESCRIPCION,ACT_MOV_DURACION Horas,ACT_MOV_FECHA Fecha
from 
Her_movilidad mov, her_Actividad_movilidad act
where MOV_ID_SUBTIPO_MOV = 'V'
and mov.MOV_ID = act.MOV_ID
and mov.mov_id = ?
order by ACT_MOV_FECHA</property>

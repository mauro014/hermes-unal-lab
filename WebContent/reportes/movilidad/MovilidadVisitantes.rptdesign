            <property name="queryText">select 
MOV_ID, MOV_NOMBRE_DOCENTE,MOV_DOC_VISITANTE, MOV_NACIONALIDAD, PAIS_NOMBRE,  MOV_UNIVERSIDAD,
MOV_PLAN,MOV_FEC_INI_EV,MOV_FEC_FIN_EV, MOV_EVENTO, TO_NUMBER(MOV_COSTO_TIQ), TO_NUMBER(MOV_MONTO),
TO_NUMBER(MOV_NUM_DIAS)
 from her_movilidad MOV, HER_PAIS PAIS
where
MOV_ID_SUBTIPO_MOV = 'V'
and MOV_ID = ?
AND MOV.MOV_PAIS= PAIS.PAIS_ID</property>
        </oda-data-set>
        <oda-data-set extensionID="org.eclipse.birt.report.data.oda.jdbc.JdbcSelectDataSet" name="Dependencia" id="3010">

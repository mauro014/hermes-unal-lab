                    <property name="nativeName">PER.PER_APELLIDO1||''||PER.PER_APELLIDO2||''||PER.PER_NOMBRE1||''||PER.PER_NOMBRE2</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">2</property>
                    <property name="name">DPN_NOMBRE</property>
                    <property name="nativeName">DPN_NOMBRE</property>
                    <property name="dataType">string</property>
                </structure>
            </list-property>
            <property name="queryText">select per.PER_APELLIDO1||' '||per.PER_APELLIDO2||' '|| per.PER_NOMBRE1||' '||per.PER_NOMBRE2,dpn.DPN_NOMBRE
from
her_movilidad mov,her_persona per, her_dependencia dpn, her_investigador_interno ini
where 
    per.per_id = mov.MOV_ID_PER
and per.per_id = ini.inv_id
and ini.dpn_id = dpn.DPN_ID
and mov.MOV_ID = ?</property>
        </oda-data-set>

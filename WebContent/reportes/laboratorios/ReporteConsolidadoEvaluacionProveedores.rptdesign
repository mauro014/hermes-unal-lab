            <property name="queryText">select nombre as Evaluacion,
round(count(*) *100.0/sum(count(*)) over(), 2)||'%' as Porcentaje,
count(*) as Cantidad
from HER_LAB_EVALUACION_PROVEEDORES, HER_TIPOS
where HLEP_EMPRESA_ID = ?
and hlep_calidad_tipo_id = id
group by nombre
order by cantidad desc</property>
        </oda-data-set>

            <property name="queryText">select * from (
select COUNT(*) as CANTIDAD, sede.SED_NOMBRE as SEDE, campus.CAMPUS_NOMBRE as CAMPUS, fac.DPN_NOMBRE as FACULTAD, 'Ninguno' as DEPARTAMENTO
from HER_LABORATORIO lab, HER_SEDE sede, HER_DEPENDENCIA fac,
HER_CAMPUS campus, HER_EDIFICIO edificio, HER_TIPOS tipo_lab, HER_PERSONA persona_reg
where lab.LAB_DEPTO is null
and lab.SED_ID = sede.SED_ID
and lab.LAB_FACULTAD = fac.DPN_ID
and lab.LAB_CAMPUS = campus.CAMPUS_ID
and lab.EDF_ID = edificio.EDF_ID 
and lab.LAB_TIPO = tipo_lab.ID
and lab.LAB_REGISTRO_PER_ID = persona_reg.PER_ID
and lab.LAB_REGISTRO_TDO_ID = persona_reg.TDO_ID
group by sede.SED_NOMBRE, campus.CAMPUS_NOMBRE, fac.DPN_NOMBRE
union
select COUNT(*) as CANTIDAD, sede.SED_NOMBRE as SEDE, campus.CAMPUS_NOMBRE as CAMPUS, fac.DPN_NOMBRE as FACULTAD, depto.DPN_NOMBRE as DEPARTAMENTO
from HER_LABORATORIO lab, HER_SEDE sede, HER_DEPENDENCIA fac, HER_DEPENDENCIA depto, 
HER_CAMPUS campus, HER_EDIFICIO edificio, HER_TIPOS tipo_lab, HER_PERSONA persona_reg
where lab.LAB_DEPTO is not null
and lab.SED_ID = sede.SED_ID
and lab.LAB_FACULTAD = fac.DPN_ID
and lab.LAB_DEPTO = depto.DPN_ID
and lab.LAB_CAMPUS = campus.CAMPUS_ID
and lab.EDF_ID = edificio.EDF_ID 
and lab.LAB_TIPO = tipo_lab.ID
and lab.LAB_REGISTRO_PER_ID = persona_reg.PER_ID
and lab.LAB_REGISTRO_TDO_ID = persona_reg.TDO_ID
group by sede.SED_NOMBRE, campus.CAMPUS_NOMBRE, fac.DPN_NOMBRE , depto.DPN_NOMBRE
) order by SEDE, CAMPUS, FACULTAD, DEPARTAMENTO</property>

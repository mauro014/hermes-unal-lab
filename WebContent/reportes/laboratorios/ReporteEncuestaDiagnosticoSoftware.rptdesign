                    <property name="name">POSGRADO</property>
                    <property name="nativeName">POSGRADO</property>
                    <property name="dataType">decimal</property>
                </structure>
            </list-property>
            <property name="queryText">select HDS.CLC_ID as CODIGO, HCC.CLC_NOMBRE as NOMBRE, HDS_PROFESORES as PROFESORES,
HDS_ESTUDIANTES_PREGRADO as PREGRADO, HDS_ESTUDIANTES_POSGRADO as POSGRADO 
from HER_DIAG_SOFTWARE HDS, HER_CLASIFICACION_CONOCIMIENTO HCC
where HDS_TIPO_REGISTRO = 'DI'
and HDS.CLC_ID = HCC.CLC_ID
and HDS_ID_PADRE = ?</property>
        </oda-data-set>

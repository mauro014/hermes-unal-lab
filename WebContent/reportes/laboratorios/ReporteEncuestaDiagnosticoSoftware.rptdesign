            <property name="queryText">select COD_ASIGNATURA as CODIGO, NMBRE_ASIGNATURA as ASIGNATURA, HDS_PROFESORES as PROFESORES,
HDS_ESTUDIANTES_PREGRADO as PREGRADO, HDS_ESTUDIANTES_POSGRADO as POSGRADO 
from HER_DIAG_SOFTWARE, SIA_V_ASIGNATURAS_HERMES@SIABTA 
where HDS_TIPO_REGISTRO = 'DD'
and CURSO = HDS_ASIGNATURA
and HDS_ID_PADRE = ?</property>
        </oda-data-set>

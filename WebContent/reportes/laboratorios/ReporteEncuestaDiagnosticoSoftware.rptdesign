                    <property name="nativeName">DEPARTAMENTO</property>
                    <property name="dataType">string</property>
                </structure>
            </list-property>
            <property name="queryText">select HDS_ID as ID, HDS_FECHA as FECHA, 
PER_NOMBRE1||' '||PER_NOMBRE2||' '||PER_APELLIDO1||' '||PER_APELLIDO2||' ('||P.PER_ID||')' as NOMBRE,
HDS_CARGO_PER as CARGO,
SED_NOMBRE as SEDE, F.DPN_NOMBRE as FACULTAD, DEPTO.DPN_NOMBRE as DEPARTAMENTO
from HER_DIAG_SOFTWARE D, HER_PERSONA P, HER_SEDE S, HER_DEPENDENCIA F, HER_DEPENDENCIA DEPTO
where HDS_TIPO_REGISTRO = 'REG'
and D.PER_ID = P.PER_ID
and D.TDO_ID = P.TDO_ID 
and D.SED_ID = S.SED_ID
and HDS_FACULTAD = F.DPN_ID
and nvl(HDS_DEPTO, 0)= DEPTO.DPN_ID
and HDS_ID = ?</property>
        </oda-data-set>

                    <property name="name">AREA_PRINCIPAL</property>
                    <property name="nativeName">AREA_PRINCIPAL</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">2</property>
                    <property name="name">SUB_AREA_PRINCIPAL</property>
                    <property name="nativeName">SUB_AREA_PRINCIPAL</property>
                    <property name="dataType">string</property>
                </structure>
            </list-property>
            <property name="queryText">SELECT 
PRI.NOMBRE AS AREA_PRINCIPAL,
SUB.NOMBRE AS SUB_AREA_PRINCIPAL
FROM
HER_LABORATORIO LAB
LEFT JOIN HER_LABORATORIO_AREA_SEC_OCDE ASO ON LAB.LAB_ID = ASO.LAB_ID
LEFT JOIN HER_TIPOS PRI ON ASO.LAS_AREA = PRI.ID
LEFT JOIN HER_TIPOS SUB ON ASO.LAS_SUBAREA = SUB.ID
WHERE
LAB.LAB_ID = ?
ORDER BY ASO.LAS_AREA</property>
        </oda-data-set>

                    <property name="nativeName">ACREDITADO</property>
                    <property name="dataType">string</property>
                </structure>
            </list-property>
            <property name="queryText">select 
LDENS.LDENS_NOMBRE as NOMBRE,
case LDENS.LDENS_DOCENCIA when '1' then 'SI' else 'NO' end as D,
case LDENS.LDENS_INVESTIGACION when '1' then 'SI' else 'NO' end as I,
case LDENS.LDENS_EXTENSION when '1' then 'SI' else 'NO' end as E,
LDENS.LDENS_VALOR_SERVICIO as VALOR,
LDENS.LDENS_ENSAYOS_MES AS EM,
LDENS.LDENS_TIEMPO_TOTAL_ESTIMADO || ' ' || t.NOMBRE as TE,
LDENS.LDENS_PERSONAS as P,
--case LDENS.LDENS_PROTOCOLO_MUESTRA when '1' then 'SI' else 'NO' end as MUESTRA,
--case LDENS.LDENS_PROTOCOLO_ENSAYO when '1' then 'SI' else 'NO' end as ENSAYO,
TNORMA.NOMBRE || ' ' || LDENS.LDENS_NORMA_TECNICA_NUMERO AS NORMA_TECNICA,
TENSAYO.NOMBRE AS TIPO_ENSAYO,
LDENS.LDENS_TIPO_ENSAYO_OTROS AS TIPO_ENSAYO_OTROS,
case LDENS.LDENS_ACREDITADO when '1' then 'SI' else 'NO' end as ACREDITADO
from HER_LABORATORIO_DETALLE_ENSAYO LDENS
LEFT JOIN HER_TIPOS t ON t.ID = LDENS_TIEMPO_TOTAL_ESTIMADO_UN
LEFT JOIN HER_TIPOS TNORMA ON TNORMA.ID = LDENS.LDENS_NORMA_TECNICA_TIPO
LEFT JOIN HER_TIPOS TENSAYO ON TENSAYO.ID = LDENS.LDENS_TIPO_ENSAYO
WHERE LAB_ID = ?</property>
        </oda-data-set>

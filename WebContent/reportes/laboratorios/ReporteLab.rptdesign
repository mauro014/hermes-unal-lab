            <property name="queryText">SELECT 
PRY.PRY_ID AS ID, 
SED.SED_NOMBRE AS SEDE, 
PRY.PRY_NOMBRE AS NOMBRE, 
(DIRECTOR.PER_NOMBRE1 || ' ' || DIRECTOR.PER_NOMBRE2 ||' '|| DIRECTOR.PER_APELLIDO1||' '||DIRECTOR.PER_APELLIDO2 ) as DIRECTOR, 
NUMERO_INTEGRANTES_PROYECTO(PRY.PRY_ID, 'ESTUDIANTES_PREGRADO') AS EPR, 
NUMERO_INTEGRANTES_PROYECTO(PRY.PRY_ID, 'ESTUDIANTES_POSGRADO') AS EPOS, 
NUMERO_INTEGRANTES_PROYECTO(PRY.PRY_ID, 'ESTUDIANTES_LIDERES') AS ELI, 
NUMERO_INTEGRANTES_PROYECTO(PRY.PRY_ID, 'ESTUDIANTES_VISITANTES') AS EVI, 
NUMERO_INTEGRANTES_PROYECTO(PRY.PRY_ID, 'DOCENTES') AS DO, 
NUMERO_INTEGRANTES_PROYECTO(PRY.PRY_ID, 'EGRESADOS') AS EG, 
NUMERO_INTEGRANTES_PROYECTO(PRY.PRY_ID, 'CONTRATISTAS') AS CO, 
NUMERO_INTEGRANTES_PROYECTO(PRY.PRY_ID, 'ADMINISTRATIVOS') AS ADM, 
NUMERO_INTEGRANTES_PROYECTO(PRY.PRY_ID, 'EXTERNOS') AS EXT 
FROM HER_PROYECTO PRY 
INNER JOIN HER_LABORATORIO_PROYECTO LAP ON PRY.PRY_ID = LAP.PRY_ID 
LEFT JOIN HER_INVESTIGADOR_PROYECTO INVP ON INVP.PRY_ID = PRY.PRY_ID AND INVP.INP_TIPO ='P' 
LEFT JOIN HER_PERSONA DIRECTOR ON DIRECTOR.PER_ID = INVP.INV_ID 
LEFT JOIN HER_INVESTIGADOR_INTERNO II on INVP.INV_ID = II.INV_ID and INVP.TDO_ID = II.TDO_ID 
LEFT JOIN HER_DEPENDENCIA DEP on DEP.DPN_ID = II.DPN_ID 
LEFT JOIN HER_DEPENDENCIA FAC on FAC.DPN_ID = DEP.DPN_FACULTAD 
LEFT JOIN HER_SEDE SED on DEP.SED_ID = SED.SED_ID 
WHERE PRY.EPR_ID IN ('AP', 'A', 'CN', 'S', 'PF', 'F')
AND lap.lab_id = ?</property>

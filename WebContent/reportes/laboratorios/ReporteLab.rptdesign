                <structure>
                    <property name="position">14</property>
                    <property name="name">ALMACENAMIENTO_DETALLE</property>
                    <property name="nativeName">ALMACENAMIENTO_DETALLE</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">15</property>

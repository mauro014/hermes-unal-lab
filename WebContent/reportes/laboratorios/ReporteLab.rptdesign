                    <property name="position">4</property>
                    <property name="name">LDE_EQUIPO</property>
                    <property name="nativeName">LDE_EQUIPO</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">5</property>
                    <property name="name">LDE_MARCA</property>
                    <property name="nativeName">LDE_MARCA</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">6</property>
                    <property name="name">LDE_MODELO</property>
                    <property name="nativeName">LDE_MODELO</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">7</property>
                    <property name="name">ESPECIALIZADO</property>
                    <property name="nativeName">ESPECIALIZADO</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">8</property>
                    <property name="name">ESTADO_FISICO</property>
                    <property name="nativeName">ESTADO_FISICO</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">9</property>
                    <property name="name">MAYOR_DIEZ_ANNIOS</property>
                    <property name="nativeName">MAYOR_DIEZ_ANNIOS</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">10</property>
                    <property name="name">EN_USO</property>
                    <property name="nativeName">EN_USO</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">11</property>
                    <property name="name">BAJA</property>
                    <property name="nativeName">BAJA</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">12</property>
                    <property name="name">ESTADO_FISICO_CENSO</property>
                    <property name="nativeName">ESTADO_FISICO_CENSO</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">13</property>
                    <property name="name">MANTENIMIENTO</property>
                    <property name="nativeName">MANTENIMIENTO</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">14</property>
                    <property name="name">CALIBRACION</property>
                    <property name="nativeName">CALIBRACION</property>
                    <property name="dataType">string</property>
                </structure>
            </list-property>
            <property name="queryText">select ROWNUM as ITEM,
LDE_PLACA, LDE_SERIAL, LDE_EQUIPO, LDE_MARCA, LDE_MODELO, ESPECIALIZADO,
ESTADO_FISICO, MAYOR_DIEZ_ANNIOS, EN_USO, BAJA, ESTADO_FISICO_CENSO, MANTENIMIENTO,
CALIBRACION 
from(
select 
LDE_PLACA, LDE_SERIAL, LDE_EQUIPO, LDE_MARCA, LDE_MODELO,
case LDE_ESPECIALIZADO when '1' then 'SI' else 'NO' end as ESPECIALIZADO,
ef.NOMBRE as ESTADO_FISICO,
case LDE_MAYOR_DIEZ_ANNIOS when '1' then 'SI' else 'NO' end as MAYOR_DIEZ_ANNIOS,
case LDE_EN_USO when '1' then 'SI' else 'NO' end as EN_USO,
case LDE_DADO_DE_BAJA when '1' then 'SI' else 'NO' end as BAJA,
efc.NOMBRE as ESTADO_FISICO_CENSO,
mantto.NOMBRE as MANTENIMIENTO,
calib.NOMBRE as CALIBRACION    
FROM 
HER_LABORATORIO_DETALLE_EQUIPO E 
LEFT JOIN HER_TIPOS mantto ON mantto.ID = LDE_MANTENIMIENTO
LEFT JOIN HER_TIPOS calib ON calib.ID = LDE_CALIBRACION
LEFT JOIN HER_TIPOS efc ON efc.ID = E.LDE_ESTADO_FISICO_CENSO
LEFT JOIN HER_TIPOS ef ON ef.ID = LDE_ESTADO_FISICO
WHERE
LAB_ID &lt;> '49' 
AND LDE_DADO_DE_BAJA = 0	
and lab_id = ?
order by LDE_DADO_DE_BAJA, LDE_PLACA)</property>
        </oda-data-set>

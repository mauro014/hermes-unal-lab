                    <property name="nativeName">FECHA_REGISTRO</property>
                    <property name="dataType">date-time</property>
                </structure>
            </list-property>
            <property name="queryText">SELECT
LDI.LDI_ID ID_REGISTRO,
LDI.LAB_ID AS LAB_ID,
LAB.LAB_NOMBRE LABORATORIO,
IL.HIL_NOMBRE SUSTANCIA,
LDI.LDI_CONSUMO AS CANTIDAD,
UNI.NOMBRE AS UNIDAD,
LDI.LDI_CONSUMO || ' ' || UNI.NOMBRE AS CANTIDAD_UNIDAD,
LDI.LDI_ALMACENAMIENTO AS DESCRIPCION_ALMACEMAMIENTO,
LDI.LDI_MES AS MES,
LDI.LDI_ANNIO AS ANNIO,
AM.NOMBRE AS ACTIVIDAD_MANEJO,
PRO.EMP_NOMBRE AS PROVEEDOR,
LDI.LDI_DESC_ACT_CONSUMO AS DESC_ACT_CONSUMO,
CASE WHEN LDI.LDI_ALMACENAMIENTO_DETALLE='A' THEN 'Almacén' WHEN LDI.LDI_ALMACENAMIENTO_DETALLE='I' THEN 'In situ' END AS ALMACENAMIENTO_DETALLE,
LDI.LDI_FECHA_REGISTRO AS FECHA_REGISTRO
FROM
HER_LABORATORIO_DET_INSUMO LDI 
LEFT JOIN HER_INSUMO_LABORATORIO IL ON LDI.HIL_ID = IL.HIL_ID
LEFT JOIN HER_TIPOS UNI ON UNI.ID = IL.HIL_UNIDAD_DE_MEDIDA
LEFT JOIN HER_TIPOS AM ON AM.ID = LDI.LDI_ACTIVIDAD_MANEJO
LEFT JOIN HER_LABORATORIO LAB ON LAB.LAB_ID = LDI.LAB_ID
LEFT JOIN HER_TIPOS AM ON AM.ID = LDI.LDI_ACTIVIDAD_MANEJO
LEFT JOIN HER_EMPRESA PRO ON PRO.EMP_ID = LDI.LDI_PROVEEDOR
WHERE LAB.LAB_ID = ?
ORDER BY LDI.LDI_ID DESC</property>

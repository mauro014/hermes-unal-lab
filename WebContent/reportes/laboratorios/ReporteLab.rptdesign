                </structure>
            </list-property>
            <property name="queryText">select p.pry_id as CODIGO, pry_nombre as PROYECTO, 
gru_nombre as GRUPO, 
LDP_PERSONAS_PREGRADO as P, 
LDP_PERSONAS_ESPECIALIZACION as E, 
LDP_PERSONAS_MAESTRIA as M, 
LDP_PERSONAS_DOCTORADO as D, 
LDP_HORAS_SEMANALES as HS
from HER_LABORATORIO_DET_PROYECTO l, HER_PROYECTO p, HER_GRUPO g
where p.pry_id = l.pry_id
and l.gru_id = g.gru_id
and LDP_ESTADO = 'P'
and lab_id = ?
order by LDP_FECHA_REGISTRO</property>
        </oda-data-set>

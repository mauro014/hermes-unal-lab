            <property name="queryText">select 
LAB_ID,
LAB_ETAPA_REGISTRO,
LAB_OBSERVACIONES,
instal.NOMBRE as ESTADO_INSTAL_FISICAS,
clima.NOMBRE as ESTADO_CLIMATIZACION,
vent.NOMBRE as ESTADO_VENTILACION,
ilum.NOMBRE as ESTADO_ILUMINACION,
ruido.NOMBRE as ESTADO_RUIDO,
case when LAB_REQUIERE_AMPLIACION = 1 then 'SI' else 'NO' end as REQUIERE_AMPLIACION,
case when LAB_REQUIERE_ADECUACION = 1 then 'SI' else 'NO' end as REQUIERE_ADECUACION,
case when LAB_REQUIERE_REDISTRIBUCION = 1 then 'SI' else 'NO' end as REQUIERE_REDISTRIBUCION,
case when LAB_REQUIERE_PAREDES = 1 then 'SI' else 'NO' end as REQUIERE_PAREDES,
case when LAB_REQUIERE_CUBIERTAS = 1 then 'SI' else 'NO' end as REQUIERE_CUBIERTAS,
case when LAB_REQUIERE_PISOS = 1 then 'SI' else 'NO' end as REQUIERE_PISOS,
LAB_REQUIERE_OTROS,
LAB_REQUIERE_OBSERVACIONES,
case when LAB_RIESGO_BIOLOGICO = 0 then 'NO' when LAB_RIESGO_BIOLOGICO = 1 then 'SI' end as RIESGO_BIOLOGICO,
LAB_RIESGO_BIOLOGICO_CUAL,
case when LAB_RIESGO_QUIMICO = 0 then 'NO' when LAB_RIESGO_QUIMICO = 1 then 'SI' end as RIESGO_QUIMICO,
LAB_RIESGO_QUIMICO_CUAL,
case when LAB_RIESGO_ELECTRICO = 0 then 'NO' when LAB_RIESGO_ELECTRICO = 1 then 'SI' end as RIESGO_ELECTRICO,
LAB_RIESGO_ELECTRICO_CUAL,
case when LAB_EMISIONES_ATMOSFERICA = 0 then 'NO' when LAB_EMISIONES_ATMOSFERICA = 1 then 'SI' end as EMISIONES_ATMOSFERICA,
LAB_EMISIONES_ATMOSFERICA_CUAL,
case when LAB_EXP_ALTA_TENSION = 0 then 'NO' when LAB_EXP_ALTA_TENSION = 1 then 'SI' end as EXP_ALTA_TENSION,
LAB_EXP_ALTA_TENSION_CUAL,
case when LAB_ALMACENAMIENTO_REACTIVOS = 0 then 'NO' when LAB_ALMACENAMIENTO_REACTIVOS = 1 then 'SI' end as ALMACENAMIENTO_REACTIVOS,
case when LAB_RESIDUOS_SOL_BIOLOGICOS = 0 then 'NO' when LAB_RESIDUOS_SOL_BIOLOGICOS = 1 then 'SI' end as RESIDUOS_SOL_BIOLOGICOS,
case when LAB_RESIDUOS_SOL_QUIMICOS = 0 then 'NO' when LAB_RESIDUOS_SOL_QUIMICOS = 1 then 'SI' end as RESIDUOS_SOL_QUIMICOS,
case when LAB_RESIDUOS_SOL_RADIOACTIVOS = 0 then 'NO' when LAB_RESIDUOS_SOL_RADIOACTIVOS = 1 then 'SI' end as RESIDUOS_SOL_RADIOACTIVOS,
case when LAB_RESIDUOS_SOL_CITOTOXICOS = 0 then 'NO' when LAB_RESIDUOS_SOL_CITOTOXICOS = 1 then 'SI' end as RESIDUOS_SOL_CITOTOXICOS,
case when LAB_RESIDUOS_SOL_ELECTRICOS = 0 then 'NO' when LAB_RESIDUOS_SOL_ELECTRICOS = 1 then 'SI' end as RESIDUOS_SOL_ELECTRICOS,
LAB_RESIDUOS_SOL_OTROS,
case when LAB_RESIDUOS_LIQ_BIOLOGICOS = 0 then 'NO' when LAB_RESIDUOS_LIQ_BIOLOGICOS = 1 then 'SI' end as RESIDUOS_LIQ_BIOLOGICOS,
case when LAB_RESIDUOS_LIQ_QUIMICOS = 0 then 'NO' when LAB_RESIDUOS_LIQ_QUIMICOS = 1 then 'SI' end as RESIDUOS_LIQ_QUIMICOS,
case when LAB_RESIDUOS_LIQ_RADIOACTIVOS = 0 then 'NO' when LAB_RESIDUOS_LIQ_RADIOACTIVOS = 1 then 'SI' end as RESIDUOS_LIQ_RADIOACTIVOS,
LAB_RESIDUOS_LIQ_OTROS,
LAB_SEGURIDAD_EXTINTORES,
case when LAB_SEGURIDAD_BOTIQUIN = 0 then 'NO' when LAB_SEGURIDAD_BOTIQUIN = 1 then 'SI' end as SEGURIDAD_BOTIQUIN,
case when LAB_SEGURIDAD_SENALIZACION_GEN = 0 then 'NO' when LAB_SEGURIDAD_SENALIZACION_GEN = 1 then 'SI' end as SEGURIDAD_SENALIZACION_GEN,
case when LAB_SEGURIDAD_DUCHA_EMERGENCIA = 0 then 'NO' when LAB_SEGURIDAD_DUCHA_EMERGENCIA = 1 then 'SI' end as SEGURIDAD_DUCHA_EMERGENCIA,
case when LAB_SEGURIDAD_SENALIZACION_SEG = 0 then 'NO' when LAB_SEGURIDAD_SENALIZACION_SEG = 1 then 'SI' end as SEGURIDAD_SENALIZACION_SEG,
case when LAB_SEGURIDAD_SENALIZACION_EME = 0 then 'NO' when LAB_SEGURIDAD_SENALIZACION_EME = 1 then 'SI' end as SEGURIDAD_SENALIZACION_EME,
case when LAB_SEG_ELEM_PROTEC_PERS = 0 then 'NO' when LAB_SEG_ELEM_PROTEC_PERS = 1 then 'SI' end as SEG_ELEM_PROTEC_PERS,
LAB_SEG_ELEM_PROTEC_PERS_CUAL,
case when LAB_MANUAL_PROTECC_RADIOLOGICA = 0 then 'NO' when LAB_MANUAL_PROTECC_RADIOLOGICA = 1 then 'SI' end as MANUAL_PROTECC_RADIOLOGICA,
case when LAB_MANUAL_PROTECC_BIOLOGICA = 0 then 'NO' when LAB_MANUAL_PROTECC_BIOLOGICA = 1 then 'SI' end as MANUAL_PROTECC_BIOLOGICA,
case when LAB_MANUAL_PROTECC_QUIMICA = 0 then 'NO' when LAB_MANUAL_PROTECC_QUIMICA = 1 then 'SI' end as MANUAL_PROTECC_QUIMICA,
case when LAB_MANUAL_PROTECC_ELECTRICA = 0 then 'NO' when LAB_MANUAL_PROTECC_ELECTRICA = 1 then 'SI' end as MANUAL_PROTECC_ELECTRICA,
case when LAB_RADIACION_EXP_IONIZANTE = 0 then 'NO' when LAB_RADIACION_EXP_IONIZANTE = 1 then 'SI' end as RADIACION_EXP_IONIZANTE,
case when LAB_RADIACION_EQ_EMISOR = 0 then 'NO' when LAB_RADIACION_EQ_EMISOR = 1 then 'SI' end as RADIACION_EQ_EMISOR,
LAB_RADIACION_EQ_EMISOR_CUAL,
case when LAB_RADIACION_FUENTE = 0 then 'NO' when LAB_RADIACION_FUENTE = 1 then 'SI' end as RADIACION_FUENTE,
LAB_RADIACION_FUENTE_CUAL,
case when LAB_RADIACION_MATERIAL = 0 then 'NO' when LAB_RADIACION_MATERIAL = 1 then 'SI' end as RADIACION_MATERIAL,
LAB_RADIACION_MATERIAL_CUAL,
case when LAB_RADIACION_EXP_NO_ION = 0 then 'NO' when LAB_RADIACION_EXP_NO_ION = 1 then 'SI' end as RADIACION_EXP_NO_ION,
LAB_RADIACION_EXP_NO_ION_CUAL,
case when LAB_RADIACION_RESIDUO_RAD = 0 then 'NO' when LAB_RADIACION_RESIDUO_RAD = 1 then 'SI' end as RADIACION_RESIDUO_RAD,
LAB_RADIACION_RESIDUO_RAD_CUAL,
LAB_RADIACION_OBSERVACIONES,
case when LAB_RADIACION_EMISION_DIARIO = 0 then 'NO' when LAB_RADIACION_EMISION_DIARIO = 1 then 'SI' end as RADIACION_EMISION_DIARIO,
case when LAB_RADIACION_EMISION_SEMANAL = 0 then 'NO' when LAB_RADIACION_EMISION_SEMANAL = 1 then 'SI' end as RADIACION_EMISION_SEMANAL,
case when LAB_RADIACION_EMISION_MENSUAL = 0 then 'NO' when LAB_RADIACION_EMISION_MENSUAL = 1 then 'SI' end as RADIACION_EMISION_MENSUAL,
LAB_RADIACION_DOSIM_PERSONALES,
LAB_RADIACION_DOSIM_AMBIENTAL,
LAB_RADIACION_DOSIM_CONTROL,
case when LAB_RADIACION_PROG_MONITOREO = 0 then 'NO' when LAB_RADIACION_PROG_MONITOREO = 1 then 'SI' end as RADIACION_PROG_MONITOREO,
case when LAB_RADIACION_CARNE_PROT_RAD = 0 then 'NO' when LAB_RADIACION_CARNE_PROT_RAD = 1 then 'SI' end as RADIACION_CARNE_PROT_RAD,
case when LAB_RADIACION_LIC_MANEJO_FUNC = 0 then 'NO' when LAB_RADIACION_LIC_MANEJO_FUNC = 1 then 'SI' end as RADIACION_LIC_MANEJO_FUNC,
case when LAB_RADIACION_CUARTO_DECAIM = 0 then 'NO' when LAB_RADIACION_CUARTO_DECAIM = 1 then 'SI' end as RADIACION_CUARTO_DECAIM
from HER_LABORATORIO lab,
HER_TIPOS instal,
HER_TIPOS clima,
HER_TIPOS vent,
HER_TIPOS ilum,
HER_TIPOS ruido
where 
instal.ID = lab.LAB_ESTADO_INSTAL_FISICAS
and clima.ID = lab.LAB_ESTADO_CLIMATIZACION
and vent.ID = lab.LAB_ESTADO_VENTILACION
and ilum.ID = lab.LAB_ESTADO_ILUMINACION
and ruido.ID = lab.LAB_ESTADO_RUIDO
and lab.LAB_ETAPA_REGISTRO > 1
and lab.LAB_ID = ?</property>
        </oda-data-set>
        <oda-data-set extensionID="org.eclipse.birt.report.data.oda.jdbc.JdbcSelectDataSet" name="RecursoHumano" id="10039">

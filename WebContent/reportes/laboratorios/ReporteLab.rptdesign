                </structure>
                <structure>
                    <property name="position">6</property>
                    <property name="name">EPO</property>
                    <property name="nativeName">EPO</property>
                    <property name="dataType">decimal</property>
                </structure>
                <structure>
                    <property name="position">7</property>
                    <property name="name">EVI</property>
                    <property name="nativeName">EVI</property>
                    <property name="dataType">decimal</property>
                </structure>
                <structure>
                    <property name="position">8</property>
                    <property name="name">DO</property>
                    <property name="nativeName">DO</property>
                    <property name="dataType">decimal</property>
                </structure>
                <structure>
                    <property name="position">9</property>
                    <property name="name">ADM</property>
                    <property name="nativeName">ADM</property>
                    <property name="dataType">decimal</property>
                </structure>
                <structure>
                    <property name="position">10</property>
                    <property name="name">EGR</property>
                    <property name="nativeName">EGR</property>
                    <property name="dataType">decimal</property>
                </structure>
                <structure>
                    <property name="position">11</property>
                    <property name="name">EXT</property>
                    <property name="nativeName">EXT</property>
                    <property name="dataType">decimal</property>
                </structure>
            </list-property>
            <property name="queryText">SELECT 
GRUPO.GRU_ID AS ID_GRUPO, 
GRUPO.GRU_NOMBRE AS NOMBRE_GRUPO, 
(LIDER.PER_NOMBRE1 || ' ' || LIDER.PER_NOMBRE2 ||' '|| LIDER.PER_APELLIDO1||' '||LIDER.PER_APELLIDO2 ) as LIDER, 
SED.SED_NOMBRE AS SEDE,  
NUMERO_INTEGRANTES_GRUPO(GRUPO.GRU_ID, 'ESTUDIANTES_PREGRADO') AS EPR, 
NUMERO_INTEGRANTES_GRUPO(GRUPO.GRU_ID, 'ESTUDIANTES_POSGRADO') AS EPO, 
NUMERO_INTEGRANTES_GRUPO(GRUPO.GRU_ID, 'ESTUDIANTES_VISITANTES') AS EVI, 
NUMERO_INTEGRANTES_GRUPO(GRUPO.GRU_ID, 'DOCENTES') AS DO, 
NUMERO_INTEGRANTES_GRUPO(GRUPO.GRU_ID, 'ADMINISTRATIVOS') AS ADM, 
NUMERO_INTEGRANTES_GRUPO(GRUPO.GRU_ID, 'EGRESADOS') AS EGR, 
NUMERO_INTEGRANTES_GRUPO(GRUPO.GRU_ID, 'EXTERNOS') AS EXT
FROM HER_PROYECTO PRY 
INNER JOIN HER_LABORATORIO_PROYECTO LAP ON PRY.PRY_ID = LAP.PRY_ID 
INNER JOIN HER_GRUPO_PROYECTO GRP ON GRP.PRY_ID = PRY.PRY_ID 
INNER JOIN HER_GRUPO GRUPO ON GRUPO.GRU_ID = GRP.GRU_ID 
LEFT JOIN HER_INVESTIGADOR_GRUPO ING ON ING.GRU_ID = GRUPO.GRU_ID AND ING.ING_TIPO = 'L'   
LEFT JOIN HER_GRUPO_CATEGORIA CAT ON CAT.GRC_ID = GRUPO.GRU_CATEGORIA_COLCIENCIAS 
LEFT JOIN HER_ESTADO_GRUPO_COLCIENCIAS EGC ON EGC.EGC_ID = GRUPO.EGC_ID 
LEFT JOIN HER_ESTADO_GRUPO EGRU ON EGRU.EGR_ID = GRUPO.EGR_ID 
LEFT JOIN HER_PERSONA LIDER ON LIDER.PER_ID = ING.INV_ID AND LIDER.TDO_ID = ING.TDO_ID 
LEFT JOIN HER_INVESTIGADOR_INTERNO II on ING.INV_ID = II.INV_ID and ING.TDO_ID = II.TDO_ID 
LEFT JOIN HER_DEPENDENCIA DEP on DEP.DPN_ID = II.DPN_ID 
LEFT JOIN HER_DEPENDENCIA FAC on FAC.DPN_ID = DEP.DPN_FACULTAD 
LEFT JOIN HER_SEDE SED on DEP.SED_ID = SED.SED_ID 
LEFT JOIN HER_DOMINIO_DETALLE SUB_AREA on GRUPO.DOM_ID_SUBAREA = SUB_AREA.DOM_ID and GRUPO.DOMDET_TIPO_SUBAREA = SUB_AREA.DOMDET_TIPO  
LEFT JOIN HER_DOMINIO_DETALLE AREA on SUB_AREA.DOMDET_ESTADO = AREA.DOMDET_TIPO 
WHERE LAP.LAB_ID = ?
AND GRUPO.EGR_ID = 'A' 
ORDER BY LAP.LAB_ID, GRUPO.GRU_NOMBRE</property>
        </oda-data-set>

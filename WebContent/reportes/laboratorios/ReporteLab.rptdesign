                    <property name="nativeName">ACTIVIDAD_MANEJO</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">12</property>
                    <property name="name">PROVEEDOR</property>
                    <property name="nativeName">PROVEEDOR</property>

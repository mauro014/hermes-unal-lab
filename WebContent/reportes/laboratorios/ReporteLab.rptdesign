                </structure>
            </list-property>
            <property name="queryText">SELECT ROWNUM as ITEM,
LDD_CODIGO_ASIGNATURA,  LDD_NOMBRE_ASIGNATURA,
LDD_NIVEL, LDD_INSCRITOS, DPN_NOMBRE, 
LDD_PRACTICAS_SEMANALES, LDD_HORAS_SEMANA, LDD_FECHA_REGISTRO,
LDD_GRUPO_ASIGNATURA, PERIODO
FROM (
select sia.COD_ASIGNATURA as LDD_CODIGO_ASIGNATURA, sia.NMBRE_ASIGNATURA as LDD_NOMBRE_ASIGNATURA,
sia.NIVEL as LDD_NIVEL, sia.INSCRITOS as LDD_INSCRITOS, DPN_NOMBRE,
LDD_PRACTICAS_SEMANALES, LDD_HORAS_SEMANA, LDD_FECHA_REGISTRO,
sia.GRUPO as LDD_GRUPO_ASIGNATURA, sia.AÑO||'-'||Sia.SEMESTRE as PERIODO
from HER_LABORATORIO_DET_DOCENCIA doc, HER_DEPENDENCIA dep, SIA_V_ASIGNATURAS_HERMES sia
where doc.ASI_ID = sia.ASI_ID
and sia.FAC = dep.DPN_id
and LAB_ID = ?
ORDER BY periodo desc, LDD_CODIGO_ASIGNATURA, LDD_GRUPO_ASIGNATURA)</property>
        </oda-data-set>

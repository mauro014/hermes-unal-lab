            <property name="queryText">SELECT r.ROL_NOMBRE as ROL, 
TRIM(REPLACE(p.PER_NOMBRE1||' '||p.PER_NOMBRE2||' '||p.PER_APELLIDO1||' '||p.PER_APELLIDO2, '  ', ' ' )) as NOMBRE,
p.PER_EMAIL as EMAIL, HPL_CARGO as CARGO, p.PER_ID as DOCUMENTO
FROM her_persona_laboratorio pl, her_persona p, her_rol r
WHERE pl.TDO_ID = p.TDO_ID AND pl.PER_ID = p.PER_ID
AND pl.ROL_ID = r.ROL_ID
AND pl.LAB_ID = ?
ORDER BY PL.LAB_ID, PL.ROL_ID, P.PER_APELLIDO1
</property>
        </oda-data-set>
        <oda-data-set extensionID="org.eclipse.birt.report.data.oda.jdbc.JdbcSelectDataSet" name="AreasSecundariasOCDE" id="10411">

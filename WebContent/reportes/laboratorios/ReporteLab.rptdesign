            <property name="queryText">SELECT 
LAB_ID,
LAB_ETAPA_REGISTRO,
LAB_FECHA_CREACION_REGISTRO,
LAB_ACTIVO,
LAB_NOMBRE,
LAB_NOMBRE || ' (' || LAB_ID || ')' as LABORATORIO,
SED_NOMBRE as SEDE ,
campus.CAMPUS_NOMBRE as CAMPUS,
campus.CAMPUS_TELEFONO AS CAMPUS_TELEFONO,
campus.CAMPUS_DIRECCION AS CAMPUS_DIRECCION,
case when edificio.edf_nombbre like '%'|| edificio.edf_codigo ||'%' then edificio.edf_nombbre
else edificio.edf_codigo || ' - ' || edificio.edf_nombbre end as EDIFICIO,
fac.DPN_NOMBRE as FACULTAD   ,
depto.DPN_NOMBRE as DEPARTMENTO   ,
CD.NOMBRE AS CIUDAD_MUNICIPIO ,
LAB_SALON,
tipo_lab.NOMBRE as TIPO_LAB,
LAB_EMAIL,
LAB_PAGINA_WEB,
LAB_PISO,
LAB_AREA_M2,
LAB_TELEFONO,
LAB_TELEFONO_2,
LAB_FAX,
LAB_DESCRIPCION,
LAB_DEDICACION_DOC,
LAB_DEDICACION_INV,
LAB_DEDICACION_EXT,
LAB_ACTO_CREACION_TIPO,
LAB_ACTO_CREACION_NUMERO,
LAB_ACTO_CREACION_EMANADA,
LAB_ACTO_CREACION_FECHA,
OBJ.NOMBRE OBJETIVO_SOCIOECONOMICO,
AREA_P.NOMBRE AREA_PRINCIPAL,
SUBAREA_P.NOMBRE SUBAREA_PRINCIPAL,
LAB_FUNCIONARIOS_PLANTA,
LAB_FUNCIONARIOS_PROV,
LAB_FUNCIONARIOS_ODS,
LAB_ESTUDIANTES_AUXILIARES,
LAB_ESTUDIANTES_BECARIOS,
LAB_ESTUDIANTES_MONITORES,
TIPO_ODS.NOMBRE AS ODS_PRINCIPAL,
(SELECT LISTAGG(PR.NOMBRE,' ; ')WITHIN GROUP (ORDER BY PR.NOMBRE) FROM HER_LABORATORIO_ODS_SEC LAS LEFT JOIN HER_TIPOS PR ON LAS.ODS_ID = PR.ID WHERE LAS.LAB_ID = LAB.LAB_ID GROUP BY LAS.LAB_ID) AS OBJETIVOS_DES_SOST_SECUNDARIOS,
TIPO_REG.NOMBRE AS TIPO_REGLAMENTO,
LAB_LINK_REGLAMENTO,
LAB_OBSERVACIONES,
acr.NOMBRE as ACREDITACION,
--case when LAB_GESTION_ACREDITACION_INTER = 1 then 'SI' else 'NO' end as LAB_GESTION_ACRED_INT,
cer.NOMBRE as CERTIFICACION,
--case when LAB_GESTION_CERTIFICACION_INTE = 1 then 'SI' else 'NO' end as LAB_GESTION_CERT_INTE,
LAB_GESTION_CERTIFICACION_CUAL,
LAB_GESTION_ACREDITACION_CUAL,
hab.NOMBRE as HABILITACION,
--case when LAB_GESTION_HABILITACION_REQ = 1 then 'SI' else 'NO' end as LAB_GESTION_HAB_REQ,
LAB_GESTION_HABILITACION_CUAL,
ica.NOMBRE as REGISTRO_ICA,
--case when LAB_GESTION_REGISTRO_ICA_REQ = 1 then 'SI' else 'NO' end as LAB_GESTION_ICA_REQ,
LAB_GESTION_REGISTRO_ICA_CUAL,
lic.NOMBRE as LICENCIAS,
--case when LAB_GESTION_LICENCIAS_REQ = 1 then 'SI' else 'NO' end as LAB_GESTION_LIC_REQ,
GESTION_INT.NOMBRE AS GESTION_INT,
lab.LAB_GESTION_INTERESADO_NORMA,
lab.LAB_GESTION_REQUIERE_NORMA,
GESTION_REQ.NOMBRE AS GESTION_REQ,
LAB_GESTION_LICENCIAS_CUAL,
LAB_PERSONAL_CALIFICADO,
LAB_PERSONAL_SUFICIENTE,
LAB_PORTAFOLIO_SERVICIOS,
LAB_SEG_ELEM_PROTEC_PERS,
LAB_SEG_ELEM_PROTEC_PERS_CUAL,
LAB_EQUIPOS_OBSERVACIONES,
LAB_HORARIO_ATENCION,
LAB_ENSAYOS_USUARIOS_ACTUALES,
LAB_ENSAYOS_USUARIOS_POTENCIAL,
LAB_AREA_GENERAL_INVESTIGACION,
LAB_EQUIPOS_CANTIDAD,
LAB_EQUIPOS_MANTTO_CANTIDAD,
LAB_EQUIPOS_CALIBR_CANTIDAD,
LAB_AREAS_APLICACION_INV,
persona_reg.per_nombre1||' '||persona_reg.per_nombre2||' '||persona_reg.per_apellido1||' '||persona_reg.per_apellido2 as NOMBRE_PERSONA_REG,
LAB_LINK_BROCHURE,
LAB_ACTO_TARIFAS_TIPO,
LAB_ACTO_TARIFAS_NUMERO,
LAB_ACTO_TARIFAS_EMITIDA,
LAB_ACTO_TARIFAS_FECHA,
LAB_CONDICIONES_SERVICIO,
TO_CHAR(SYSDATE, 'dd/MM/yyyy HH24:MI:SS') as FECHA_REPORTE
from HER_LABORATORIO lab
LEFT JOIN HER_SEDE sede ON lab.SED_ID = sede.SED_ID
LEFT JOIN HER_DEPENDENCIA fac ON lab.LAB_FACULTAD = fac.DPN_ID
LEFT JOIN HER_DEPENDENCIA depto ON nvl(lab.LAB_DEPTO, 0) = depto.DPN_ID
LEFT JOIN HER_CAMPUS campus ON lab.LAB_CAMPUS = campus.CAMPUS_ID
LEFT JOIN HER_EDIFICIO edificio ON lab.EDF_ID = edificio.EDF_ID
LEFT JOIN HER_TIPOS tipo_lab ON lab.LAB_TIPO = tipo_lab.ID
LEFT JOIN HER_PERSONA persona_reg ON lab.LAB_REGISTRO_PER_ID = persona_reg.PER_ID AND lab.LAB_REGISTRO_TDO_ID = persona_reg.TDO_ID
LEFT JOIN HER_TIPOS acr ON acr.ID = lab.LAB_GESTION_ACREDITACION
LEFT JOIN HER_TIPOS cer ON cer.ID = lab.LAB_GESTION_CERTIFICACION
LEFT JOIN HER_TIPOS hab ON hab.ID = lab.LAB_GESTION_HABILITACION
LEFT JOIN HER_TIPOS ica ON ica.ID = lab.LAB_GESTION_REGISTRO_ICA
LEFT JOIN HER_TIPOS lic ON lic.ID = lab.LAB_GESTION_LICENCIAS
LEFT JOIN HER_TIPOS instal ON instal.ID = lab.LAB_ESTADO_INSTAL_FISICAS
LEFT JOIN HER_TIPOS clima ON clima.ID = lab.LAB_ESTADO_CLIMATIZACION
LEFT JOIN HER_TIPOS vent ON vent.ID = lab.LAB_ESTADO_VENTILACION
LEFT JOIN HER_TIPOS ilum ON ilum.ID = lab.LAB_ESTADO_ILUMINACION
LEFT JOIN HER_TIPOS ruido ON ruido.ID = lab.LAB_ESTADO_RUIDO
LEFT JOIN HER_TIPOS OBJ ON OBJ.ID = lab.LAB_OBJETIVO_SOCIOECONOMICO
LEFT JOIN HER_TIPOS AREA_P ON AREA_P.ID = lab.LAB_AREA_PRINCIPAL
LEFT JOIN HER_TIPOS CD ON CD.ID = LAB.LAB_DEPTO_CIUDAD
LEFT JOIN HER_TIPOS SUBAREA_P ON SUBAREA_P.ID = lab.LAB_SUB_AREA_PRINCIPAL
LEFT JOIN HER_TIPOS GESTION_INT ON GESTION_INT.ID = lab.LAB_GESTION_INTERESADO
LEFT JOIN HER_TIPOS GESTION_REQ ON GESTION_REQ.ID = lab.LAB_GESTION_REQUIERE
LEFT JOIN HER_TIPOS TIPO_REG ON TIPO_REG.ID = lab.LAB_TIPO_REGLAMENTO
LEFT JOIN HER_TIPOS TIPO_ODS ON TIPO_ODS.ID = lab.LAB_ODS_PRINCIPAL 
where
lab.LAB_ID = ?</property>
        </oda-data-set>

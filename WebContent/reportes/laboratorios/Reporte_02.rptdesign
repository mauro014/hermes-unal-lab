            <method name="beforeOpen"><![CDATA[idSede = params["idSede"];
if (idSede != null &amp;&amp; idSede != "")
{
        this.queryText = this.queryText.replaceAll("group by","and lab.sed_id in ("+ params["idSede"]+ ") group by");
}

idFacultad = params["idFacultad"];
if (idFacultad != null &amp;&amp; idFacultad != "")
{
        this.queryText = this.queryText.replaceAll("group by","and lab.lab_facultad in (" + idFacultad + ") group by");
}

idDepartamento = params["idDepartamento"];
if (idDepartamento != null &amp;&amp; idDepartamento != "")
{
        this.queryText = this.queryText.replaceAll("group by","and lab.lab_depto in (" + idDepartamento + ") group by");
}

]]></method>

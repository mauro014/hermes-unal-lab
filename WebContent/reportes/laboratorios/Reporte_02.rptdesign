                </structure>
            </list-property>
            <property name="queryText">select sum(lab_area_m2) as area, count(*) as cantidad, sede.SED_NOMBRE as sede, facultad.dpn_nombre as facultad, depto.dpn_nombre as departamento
from her_laboratorio lab, her_sede sede,
her_dependencia facultad,
her_dependencia depto
where sede.sed_id = lab.sed_id
and facultad.dpn_id = lab.lab_facultad
and depto.dpn_id = lab.lab_depto
group by sede.SED_NOMBRE, facultad.dpn_nombre, depto.dpn_nombre
order by sede.SED_NOMBRE, facultad.dpn_nombre, depto.dpn_nombre
</property>

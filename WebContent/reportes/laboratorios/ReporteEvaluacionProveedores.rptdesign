            <property name="queryText">select HLEP_ID ,
per.PER_NOMBRE1 || ' ' || per.PER_NOMBRE2 || ' ' || per.PER_APELLIDO1 || ' ' || per.PER_APELLIDO2 as NOMBRE_PERSONA,
HLEP_FECHA_REGISTRO ,
HLEP_CARGO ,
sede.SED_NOMBRE as SEDE,
fac.DPN_NOMBRE as FACULTAD,
depto.DPN_NOMBRE as DEPTO,
mecadq.NOMBRE as MECANISMO_ADQUISICION,
tipadq.NOMBRE as TIPO_ADQUISICION,
HLEP_NUMERO_ORDEN ,
HLEP_ANNIO_ORDEN ,
HLEP_OBJETO,
prov.EMP_NOMBRE as PROVEEDOR,
HLEP_OTROS_PRODUCTOS,

HLEP_CALIDAD_TIPO_ID as CALIDAD,
nvl(HLEP_COMENTARIO_CALIDAD, 'Ninguno.') as CCALIDAD,
HLEP_OPORTUNIDAD_TIPO_ID as OPORTUNIDAD,
nvl(HLEP_COMENTARIO_OPORTUNIDAD, 'Ninguno.') as COPORTUNIDAD,
HLEP_DOCUMENTOS_TIPO_ID as DOCUMENTOS,
nvl(HLEP_COMENTARIO_DOCUMENTOS, 'Ninguno.') as CDOCUMENTOS,
HLEP_COMPORTAMIENTO_TIPO_ID as COMPORTAMIENTO,
nvl(HLEP_COMENTARIO_COMPORTAMIENTO, 'Ninguno.') as CCOMPORTAMIENTO,
HLEP_ASESORIA_TIPO_ID as ASESORIA,
nvl(HLEP_COMENTARIO_ASESORIA, 'Ninguno.') as CASESORIA,
recomendacion.NOMBRE as RECOMENDACION,
nvl(HLEP_COMENTARIO_RECOMENDACION, 'Ninguno.') as CRECOMENDACION
from HER_LAB_EVALUACION_PROVEEDORES eval, HER_PERSONA per, HER_SEDE sede, HER_DEPENDENCIA fac, HER_DEPENDENCIA depto,
HER_TIPOS mecadq, HER_TIPOS tipadq, HER_EMPRESA prov, HER_TIPOS recomendacion
where HLEP_PER_ID = per.PER_ID
and HLEP_TDO_ID = per.TDO_ID
and HLEP_SED_ID = sede.SED_ID
and HLEP_FACULTAD_ID = fac.DPN_ID
and nvl(HLEP_DEPARTAMENTO_ID, 0) = depto.DPN_ID
and HLEP_MECANISMO_ADQUISICION_ID = mecadq.ID
and HLEP_TIPO_ADQUISICION_ID = tipadq.ID
and HLEP_EMPRESA_ID = prov.EMP_ID
and HLEP_RECOMENDACION_TIPO_ID = recomendacion.ID
and HLEP_ID = ?</property>
        </oda-data-set>
    </data-sets>

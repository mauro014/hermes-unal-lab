                    <property name="isOutput">false</property>
                </structure>
            </list-property>
            <list-property name="resultSet">
                <structure>
                    <property name="position">1</property>
                    <property name="name">TIPO_PERSONA</property>
                    <property name="nativeName">TIPO_PERSONA</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">2</property>
                    <property name="name">AUTOR</property>
                    <property name="nativeName">AUTOR</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">3</property>
                    <property name="name">DOCUMENTO</property>
                    <property name="nativeName">DOCUMENTO</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">4</property>
                    <property name="name">PIP_CALIDAD</property>
                    <property name="nativeName">PIP_CALIDAD</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">5</property>
                    <property name="name">VINCULACION</property>
                    <property name="nativeName">VINCULACION</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">6</property>
                    <property name="name">DEPENDENCIA</property>
                    <property name="nativeName">DEPENDENCIA</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">7</property>
                    <property name="name">ENTIDAD</property>
                    <property name="nativeName">ENTIDAD</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">8</property>
                    <property name="name">ROL</property>
                    <property name="nativeName">ROL</property>
                    <property name="dataType">string</property>
                </structure>
            </list-property>
            <property name="queryText">SELECT tp.ptP_nombre as tipo_persona,
p.PER_NOMBRE1||' '||DECODE(p.PER_NOMBRE2,p.PER_NOMBRE2,p.PER_NOMBRE2,NULL,' ')||' '||p.PER_APELLIDO1||' '||DECODE(p.PER_APELLIDO2,p.PER_APELLIDO2,p.PER_APELLIDO2,NULL,' ') autor,
P.TDO_ID || P.PER_ID AS DOCUMENTO,
pip.pip_calidad,
decode(pip.pip_calidad,'1','Administrativo','2','Docente','3','Estudiante','4','Externo','')vinculacion,
d.dpn_nombre as dependencia,
ff.ffi_descripcion as entidad,
decode(pip.ptp_id,'9',' (Intérprete principal)','10',' (Autor(a) de obra fijada)','')rol
FROM
HER_PROPIEDAD_INT_PERSONA pip  
left join HER_PROPIEDAD_INT_TIPO_PER tp on pip.ptp_id = tp.ptp_id
left join HER_PERSONA p on pip.inv_id = p.per_id and pip.tdo_id = p.tdo_id
left join HER_INVESTIGADOR_INTERNO ii on ii.inv_id = p.per_id and ii.tdo_id = p.tdo_id 
left join HER_DEPENDENCIA d on d.dpn_id = ii.dpn_id
left join HER_FUENTE_FINANCIACION ff on ff.ffi_id = pip.ffi_id
WHERE pip.pof_id = ? order by pip.ptp_id,autor desc</property>
        </oda-data-set>
        <oda-data-set extensionID="org.eclipse.birt.report.data.oda.jdbc.JdbcSelectDataSet" name="historial" id="9624">
            <structure name="cachedMetaData">
                <list-property name="resultSet">
                    <structure>
                        <property name="position">1</property>
                        <property name="name">FECHA</property>
                        <property name="dataType">date-time</property>
                    </structure>
                    <structure>
                        <property name="position">2</property>
                        <property name="name">OBSERVACIONES</property>
                        <property name="dataType">string</property>
                    </structure>
                    <structure>
                        <property name="position">3</property>
                        <property name="name">ESTADO</property>
                        <property name="dataType">string</property>
                    </structure>
                    <structure>
                        <property name="position">4</property>
                        <property name="name">RESPONSABLE</property>
                        <property name="dataType">string</property>
                    </structure>
                </list-property>
            </structure>
            <property name="dataSource">Data Source</property>
            <list-property name="parameters">
                <structure>
                    <property name="name">param_1</property>
                    <property name="paramName">id</property>
                    <property name="dataType">string</property>
                    <property name="position">1</property>
                    <property name="isInput">true</property>
                    <property name="isOutput">false</property>
                </structure>
            </list-property>
            <list-property name="resultSet">
                <structure>
                    <property name="position">1</property>
                    <property name="name">FECHA</property>
                    <property name="nativeName">FECHA</property>
                    <property name="dataType">date-time</property>
                </structure>
                <structure>
                    <property name="position">2</property>
                    <property name="name">OBSERVACIONES</property>
                    <property name="nativeName">OBSERVACIONES</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">3</property>
                    <property name="name">ESTADO</property>
                    <property name="nativeName">ESTADO</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">4</property>
                    <property name="name">RESPONSABLE</property>
                    <property name="nativeName">RESPONSABLE</property>
                    <property name="dataType">string</property>
                </structure>
            </list-property>
            <property name="queryText">SELECT PIH.PIH_FECHA AS FECHA,
pih.PIH_OBSERVACION AS OBSERVACIONES,
PSE.PSE_NOMBRE AS ESTADO,
p.PER_NOMBRE1||' '||DECODE(p.PER_NOMBRE2,p.PER_NOMBRE2,p.PER_NOMBRE2,NULL,' ')||' '||p.PER_APELLIDO1||' '||DECODE(p.PER_APELLIDO2,p.PER_APELLIDO2,p.PER_APELLIDO2,NULL,' ') responsable
FROM
HER_PROPIEDAD_INT_HISTORICO piH 
LEFT JOIN HER_PERSONA P ON P.PER_ID = PIH.PER_ID AND P.TDO_ID = PIH.TDO_ID
LEFT JOIN HER_PROPIEDAD_INT_SUBESTADO PSE ON PSE.PSE_ID = PIH.PSE_ID
WHERE PIH.PRI_ID = ? order by fecha</property>
        </oda-data-set>
    </data-sets>

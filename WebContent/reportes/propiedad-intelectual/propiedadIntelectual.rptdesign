                    <property name="dataType">string</property>
                    <property name="position">1</property>
                    <property name="isInput">true</property>
                    <property name="isOutput">false</property>
                </structure>
            </list-property>
            <list-property name="resultSet">
                <structure>
                    <property name="position">1</property>
                    <property name="name">CLASE</property>
                    <property name="nativeName">CLASE</property>
                    <property name="dataType">string</property>
                </structure>
            </list-property>
            <property name="queryText">SELECT dd.DOMDET_DESCRIPCION || (decode(pic.pic_observacion,null,'',' - ')) || (decode(pic.pic_observacion,null,'',pic.pic_observacion)) AS clase
FROM
HER_PROPIEDAD_INT_CLASE piC 
left join HER_DOMINIO_DETALLE DD on DD.DOM_id = piC.DOM_id AND DD.DOMDET_TIPO = PIC.DOMDET_TIPO
WHERE piC.PRI_ID = ?</property>
        </oda-data-set>
        <oda-data-set extensionID="org.eclipse.birt.report.data.oda.jdbc.JdbcSelectDataSet" name="FormatoPropiedad" id="9133">

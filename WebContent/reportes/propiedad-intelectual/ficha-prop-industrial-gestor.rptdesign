            <property name="queryText">SELECT pi.pri_id as id,
pis.pis_nombre as subtipo,
pis.pis_id,
pit.pit_id,
pit.pit_nombre as tipo,
dpn.dpn_nombre as dependencia,
p.PER_NOMBRE1||' '||DECODE(p.PER_NOMBRE2,p.PER_NOMBRE2,p.PER_NOMBRE2,NULL,' ')||' '||p.PER_APELLIDO1||' '||DECODE(p.PER_APELLIDO2,p.PER_APELLIDO2,p.PER_APELLIDO2,NULL,' ') solicitante,
pi.pri_titulo as titulo,
P.TDO_ID ||' - '|| P.PER_ID AS DOCUMENTO,
psE.psE_nombre as estado_esp,
CE.PCE_NOMBRE || ' - ' || PIE.PIE_NOMBRE AS ESTADO,
pi.PRI_ANO_TERMINACION as terminacion,
decode(pi.PRI_ESTADO_OBRA,'IN','Inédita','ED','Editada','')estadoObra,
pi.PRI_ESTADO_OBRA,
pi.PRI_EDITOR as editor,
pi.PRI_IMPRESOR as impresor,
pi.PRI_FECHA_PUBLICACION as fechaPublicacion,
pa.pais_nombre as pais,
pi.PRI_DESCRIPCION as descripcion,
pi.PRI_VENTAJAS as ventajas,
pi.PRI_IMPACTO_SOLUCION as impacto,
pi.PRI_MERCADO_POBLACION as poblacion,
pi.PRI_ISBN as isbn,
pi.PRI_NRO_PAGINAS as numeroPaginas,
pi.PRI_NRO_EDICION as NroEdicion,
pi.PRI_TIRAJE as tiraje,
pi.PRI_INFO_EMAIL as infoEmail,
pi.pri_ritmo as ritmo,
gen.nombre as genero,
pi.pri_duracion as duracion,
pi.pri_otros_datos as otros_datos,
pi.pri_monitoreo as monitoreo,
pi.PRI_OBJETO_PROTECCION as objeto_proteccion,
pi.pri_difusion as difusion,
pi.PRI_FECHA_REGISTRO as fecha_registro,
clasificacion.nombre as clasificacion,
pi.dpn_id,
pi.dpn_id_apoyo,
dpn2.dpn_nombre as dependenciaApoyo,
pi.PRI_RADICADO as radicado,
pi.PRI_FECHA_RADICADO as fechaRadicado,
decode(pi.PRI_CONT_ARG,'N','No requiere','S','Si requiere','')reqContratoRG,
pi.PRI_FECHA_FIN_DERECHO as fechaFinDerecho,
decode(sector.nombre,'Otro',sector.nombre||'-'||pi.PRI_OTRO_SECTOR,sector.nombre) as sector,
ap.PER_NOMBRE1||' '||DECODE(ap.PER_NOMBRE2,ap.PER_NOMBRE2,ap.PER_NOMBRE2,NULL,' ')||' '||ap.PER_APELLIDO1||' '||DECODE(ap.PER_APELLIDO2,ap.PER_APELLIDO2,ap.PER_APELLIDO2,NULL,' ') apoderado,
ap.per_email as emailApoderado,
ap.per_direccion as direccion,
aP.TDO_ID ||' - '|| aP.PER_ID AS documentoApoderado,
estado.nombre as estadoDesarrollo,
pi.PRI_CLASIFICACION AS CLASIFICACION_REV,
tsol.NOMBRE AS TIPO_SOLICITUD
FROM
HER_PROPIEDAD_INTELECTUAL pi 
left join HER_PROPIEDAD_INT_SUBTIPO pis on pi.PIS_ID = pis.PIS_ID 
left join HER_PROPIEDAD_INT_TIPO pit on pis.pit_id = pit.pit_id
left join HER_DEPENDENCIA dpn on dpn.dpn_id = pi.dpn_id
left join HER_DEPENDENCIA dpn2 on dpn2.dpn_id = pi.dpn_id_apoyo
left join HER_PERSONA p on p.per_id = pi.inv_id and p.tdo_id = pi.tdo_id
left join HER_PROPIEDAD_INT_SUBESTADO psE on psE.psE_id = pi.psE_id
left join HER_PROPIEDAD_INT_ESTADO PIE ON PIE.PIE_ID = PSE.PIE_ID
left join HER_PROPIEDAD_INT_CLAS_ESTADO CE ON CE.PCE_ID = PIE.PCE_ID
left join HER_PAIS Pa on pa.pais_id = pi.pais_id
left join HER_TIPOS gen on gen.id = pi.gen_id
left join HER_TIPOS clasificacion on clasificacion.id = pi.cla_id
left join HER_TIPOS sector on sector.id = pi.sector_id
left join HER_TIPOS estado on estado.id = pi.ESTADO_DLLO_ID
left join HER_PERSONA ap on ap.per_id = pi.per_id_ap and ap.tdo_id = pi.tdo_id_ap
left join HER_TIPOS tsol on tsol.id = pi.PRI_TIPO_SOLICITUD
WHERE PRI_ID = ?</property>
        </oda-data-set>

            <property name="queryText">SELECT tp.ptP_nombre as tipo_persona,
tp.ptp_id,
p.PER_NOMBRE1||' '||DECODE(p.PER_NOMBRE2,p.PER_NOMBRE2,p.PER_NOMBRE2,NULL,' ')||' '||p.PER_APELLIDO1||' '||DECODE(p.PER_APELLIDO2,p.PER_APELLIDO2,p.PER_APELLIDO2,NULL,' ') persona,
'('||P.TDO_ID ||' '|| P.PER_ID||')' AS DOCUMENTO,
pip.pip_calidad,
decode(pip.pip_calidad,'1','Administrativo','2','Docente','3','Estudiante','4','Externo','')vinculacion,
d.dpn_nombre as dependencia,
ff.ffi_descripcion as entidad,
p.per_email as email,
PA.PAIS_NOMBRE || ' (' || pip.pip_ciudad || ')' AS pais_ciudad,
PI.PIS_ID,
decode(pip.pip_sitio_web,null,'','('||pip.pip_sitio_web||')')sitio_web,
p.per_direccion as direccion
FROM
HER_PROPIEDAD_INT_PERSONA pip  
left join HER_PROPIEDAD_INT_TIPO_PER tp on pip.ptp_id = tp.ptp_id
left join HER_PERSONA p on pip.inv_id = p.per_id and pip.tdo_id = p.tdo_id
left join HER_INVESTIGADOR_INTERNO ii on ii.inv_id = p.per_id and ii.tdo_id = p.tdo_id 
left join HER_DEPENDENCIA d on d.dpn_id = ii.dpn_id
left join HER_FUENTE_FINANCIACION ff on ff.ffi_id = pip.ffi_id
left join HER_PAIS PA ON PA.PAIS_ID = PIP.PAIS_ID 
left join HER_PROPIEDAD_INTELECTUAL PI ON PI.PRI_ID = PIP.PRI_ID
WHERE pip.PRI_ID =? and pip.ptp_id not in ('9','10')</property>
        </oda-data-set>
    </data-sets>

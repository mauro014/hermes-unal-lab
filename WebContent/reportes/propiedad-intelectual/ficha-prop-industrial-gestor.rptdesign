            <property name="queryText">SELECT ff.ffi_descripcion as entidad,
ff.ffe_nit_entidad as nit,
ff.ffe_dir_entidad as direccion,
ff.ffe_tel_entidad as telefono,
pic.pic_porcentaje as porcentaje
FROM
HER_PROPIEDAD_INT_COTITULAR pic 
left join HER_FUENTE_FINANCIACION FF on ff.ffi_id = pic.ffi_id
WHERE pic.PRI_ID = ?</property>

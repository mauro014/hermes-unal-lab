            <property name="queryText">select * from (

select distinct PI.PRI_ID AS CODIGO,
pis.pis_nombre as subtipo,
pit.pit_nombre as tipo,
psE.psE_nombre as estado_esp,
CE.PCE_NOMBRE AS ESTADO_GENERAL,
PIE.PIE_NOMBRE as estado_intermedio,
pi.PRI_FECHA_REGISTRO as fecha_registro,
pi.PRI_FECHA_REVISION as fecha_revision,
pi.pri_titulo as titulo,
pi.PRI_TITULO_ESPANOL as tituloEspanol,
d.dpn_nombre as dependencia_solicitante,
s.sed_nombre as sede,
p.PER_NOMBRE1||' '||DECODE(p.PER_NOMBRE2,p.PER_NOMBRE2,p.PER_NOMBRE2,NULL,' ')||' '||p.PER_APELLIDO1||' '||DECODE(p.PER_APELLIDO2,p.PER_APELLIDO2,p.PER_APELLIDO2,NULL,' ') solicitante,
P.TDO_ID ||' - '|| P.PER_ID AS DOCUMENTO,
pi.PRI_RADICADO as nro_radicado,
pi.PRI_FECHA_RADICADO as fecha_radicado,
sa.SED_NOMBRE AS SEDE_APOYO,
pi.PRI_OBJETO_PROTECCION as objetoProteccion,
pi.PRI_DESCRIPCION as descripcion,
pi.PRI_VENTAJAS as ventajas,
pi.PRI_IMPACTO_SOLUCION as impactoSolucion,
pi.PRI_MONITOREO as monitoreo,
pi.PRI_DIFUSION as difusion,
pi.PRI_MERCADO_POBLACION as mercadoPoblacion,
pi.PRI_ANO_TERMINACION as anoFijacionTerminacion,
decode(pi.PRI_ESTADO_OBRA,'IN','Inédita','ED','Editada / Publicada','')estadoObra,
pi.PRI_FECHA_PUBLICACION as fechaPublicacion,
pa.PAIS_NOMBRE as pais,
pi.PRI_DURACION as duracion,
pi.PRI_OTROS_DATOS as otrosDatos,
tipoGenero.nombre as genero,
pi.PRI_EDITOR as editor,
pi.PRI_IMPRESOR as impresor,
pi.PRI_NRO_EDICION as nro_edicion,
pi.PRI_TIRAJE as tiraje,
pi.PRI_NRO_PAGINAS as nro_pag,
pi.PRI_ISBN as isbn,
pi.PRI_RITMO as ritmo,
clasificacion.nombre as clasificacion
from HER_PROPIEDAD_INTELECTUAL PI
left join HER_PROPIEDAD_INT_SUBTIPO pis on pi.PIS_ID = pis.PIS_ID 
left join HER_PROPIEDAD_INT_TIPO pit on pis.pit_id = pit.pit_id
left join HER_PROPIEDAD_INT_SUBESTADO psE on psE.psE_id = pi.psE_id
left join HER_PROPIEDAD_INT_ESTADO PIE ON PIE.PIE_ID = PSE.PIE_ID
left join HER_PROPIEDAD_INT_CLAS_ESTADO CE ON CE.PCE_ID = PIE.PCE_ID
left join HER_SEDE sa ON SA.SED_ID = PI.DPN_ID_APOYO
left join HER_PERSONA p on p.per_id = pi.inv_id and p.tdo_id = pi.tdo_id
left join HER_PAIS pa on pa.PAIS_ID = pi.PAIS_ID
left join HER_TIPOS tipoGenero on tipoGenero.id = pi.gen_id
left join HER_TIPOS clasificacion on clasificacion.id = pi.cla_id, 
HER_DEPENDENCIA D, 
HER_SEDE S
WHERE (D.SED_ID IN (SELECT COLUMN_VALUE FROM TABLE(SPLIT(?)))
or (pi.DPN_ID_APOYO is not null and pi.DPN_ID_APOYO in (SELECT COLUMN_VALUE FROM TABLE(SPLIT(?)))))
AND PI.DPN_ID = D.DPN_ID
AND S.SED_ID = D.SED_ID
AND pi.pis_id in (SELECT COLUMN_VALUE FROM TABLE(SPLIT(?)))

union

select distinct PI.PRI_ID AS CODIGO,
pis.pis_nombre as subtipo,
pit.pit_nombre as tipo,
psE.psE_nombre as estado_esp,
CE.PCE_NOMBRE AS ESTADO_GENERAL,
PIE.PIE_NOMBRE as estado_intermedio,
pi.PRI_FECHA_REGISTRO as fecha_registro,
pi.PRI_FECHA_REVISION as fecha_revision,
pi.pri_titulo as titulo,
pi.PRI_TITULO_ESPANOL as tituloEspanol,
d.dpn_nombre as dependencia_solicitante,
s.sed_nombre as sede,
p.PER_NOMBRE1||' '||DECODE(p.PER_NOMBRE2,p.PER_NOMBRE2,p.PER_NOMBRE2,NULL,' ')||' '||p.PER_APELLIDO1||' '||DECODE(p.PER_APELLIDO2,p.PER_APELLIDO2,p.PER_APELLIDO2,NULL,' ') solicitante,
P.TDO_ID ||' - '|| P.PER_ID AS DOCUMENTO,
pi.PRI_RADICADO as nro_radicado,
pi.PRI_FECHA_RADICADO as fecha_radicado,
sa.SED_NOMBRE AS SEDE_APOYO,
pi.PRI_OBJETO_PROTECCION as objetoProteccion,
pi.PRI_DESCRIPCION as descripcion,
pi.PRI_VENTAJAS as ventajas,
pi.PRI_IMPACTO_SOLUCION as impactoSolucion,
pi.PRI_MONITOREO as monitoreo,
pi.PRI_DIFUSION as difusion,
pi.PRI_MERCADO_POBLACION as mercadoPoblacion,
pi.PRI_ANO_TERMINACION as anoFijacionTerminacion,
decode(pi.PRI_ESTADO_OBRA,'IN','Inédita','ED','Editada / Publicada','')estadoObra,
pi.PRI_FECHA_PUBLICACION as fechaPublicacion,
pa.PAIS_NOMBRE as pais,
pi.PRI_DURACION as duracion,
pi.PRI_OTROS_DATOS as otrosDatos,
tipoGenero.nombre as genero,
pi.PRI_EDITOR as editor,
pi.PRI_IMPRESOR as impresor,
pi.PRI_NRO_EDICION as nro_edicion,
pi.PRI_TIRAJE as tiraje,
pi.PRI_NRO_PAGINAS as nro_pag,
pi.PRI_ISBN as isbn,
pi.PRI_RITMO as ritmo,
clasificacion.nombre as clasificacion
from HER_PROPIEDAD_INTELECTUAL PI
left join HER_PROPIEDAD_INT_SUBTIPO pis on pi.PIS_ID = pis.PIS_ID 
left join HER_PROPIEDAD_INT_TIPO pit on pis.pit_id = pit.pit_id
left join HER_PROPIEDAD_INT_SUBESTADO psE on psE.psE_id = pi.psE_id
left join HER_PROPIEDAD_INT_ESTADO PIE ON PIE.PIE_ID = PSE.PIE_ID
left join HER_PROPIEDAD_INT_CLAS_ESTADO CE ON CE.PCE_ID = PIE.PCE_ID
left join HER_SEDE sa ON SA.SED_ID = PI.DPN_ID_APOYO
left join HER_PERSONA p on p.per_id = pi.inv_id and p.tdo_id = pi.tdo_id
left join HER_PAIS pa on pa.PAIS_ID = pi.PAIS_ID
left join HER_TIPOS tipoGenero on tipoGenero.id = pi.gen_id
left join HER_TIPOS clasificacion on clasificacion.id = pi.cla_id, 
HER_PROPIEDAD_INT_PERSONA piper,  
HER_DEPENDENCIA D, 
HER_SEDE S
WHERE (D.SED_ID IN (SELECT COLUMN_VALUE FROM TABLE(SPLIT(?)))
or (pi.DPN_ID_APOYO is not null and pi.DPN_ID_APOYO in (SELECT COLUMN_VALUE FROM TABLE(SPLIT(?)))))
AND PI.DPN_ID = D.DPN_ID
AND S.SED_ID = D.SED_ID
and piper.INV_ID = ? and piper.TDO_ID = ? and piper.PRI_ID = PI.PRI_ID

union

select distinct PI.PRI_ID AS CODIGO,
pis.pis_nombre as subtipo,
pit.pit_nombre as tipo,
psE.psE_nombre as estado_esp,
CE.PCE_NOMBRE AS ESTADO_GENERAL,
PIE.PIE_NOMBRE as estado_intermedio,
pi.PRI_FECHA_REGISTRO as fecha_registro,
pi.PRI_FECHA_REVISION as fecha_revision,
pi.pri_titulo as titulo,
pi.PRI_TITULO_ESPANOL as tituloEspanol,
d.dpn_nombre as dependencia_solicitante,
s.sed_nombre as sede,
p.PER_NOMBRE1||' '||DECODE(p.PER_NOMBRE2,p.PER_NOMBRE2,p.PER_NOMBRE2,NULL,' ')||' '||p.PER_APELLIDO1||' '||DECODE(p.PER_APELLIDO2,p.PER_APELLIDO2,p.PER_APELLIDO2,NULL,' ') solicitante,
P.TDO_ID ||' - '|| P.PER_ID AS DOCUMENTO,
pi.PRI_RADICADO as nro_radicado,
pi.PRI_FECHA_RADICADO as fecha_radicado,
sa.SED_NOMBRE AS SEDE_APOYO,
pi.PRI_OBJETO_PROTECCION as objetoProteccion,
pi.PRI_DESCRIPCION as descripcion,
pi.PRI_VENTAJAS as ventajas,
pi.PRI_IMPACTO_SOLUCION as impactoSolucion,
pi.PRI_MONITOREO as monitoreo,
pi.PRI_DIFUSION as difusion,
pi.PRI_MERCADO_POBLACION as mercadoPoblacion,
pi.PRI_ANO_TERMINACION as anoFijacionTerminacion,
decode(pi.PRI_ESTADO_OBRA,'IN','Inédita','ED','Editada / Publicada','')estadoObra,
pi.PRI_FECHA_PUBLICACION as fechaPublicacion,
pa.PAIS_NOMBRE as pais,
pi.PRI_DURACION as duracion,
pi.PRI_OTROS_DATOS as otrosDatos,
tipoGenero.nombre as genero,
pi.PRI_EDITOR as editor,
pi.PRI_IMPRESOR as impresor,
pi.PRI_NRO_EDICION as nro_edicion,
pi.PRI_TIRAJE as tiraje,
pi.PRI_NRO_PAGINAS as nro_pag,
pi.PRI_ISBN as isbn,
pi.PRI_RITMO as ritmo,
clasificacion.nombre as clasificacion
from HER_PROPIEDAD_INTELECTUAL PI
left join HER_PROPIEDAD_INT_SUBTIPO pis on pi.PIS_ID = pis.PIS_ID 
left join HER_PROPIEDAD_INT_TIPO pit on pis.pit_id = pit.pit_id
left join HER_PROPIEDAD_INT_SUBESTADO psE on psE.psE_id = pi.psE_id
left join HER_PROPIEDAD_INT_ESTADO PIE ON PIE.PIE_ID = PSE.PIE_ID
left join HER_PROPIEDAD_INT_CLAS_ESTADO CE ON CE.PCE_ID = PIE.PCE_ID
left join HER_SEDE sa ON SA.SED_ID = PI.DPN_ID_APOYO
left join HER_PERSONA p on p.per_id = pi.inv_id and p.tdo_id = pi.tdo_id
left join HER_PAIS pa on pa.PAIS_ID = pi.PAIS_ID
left join HER_TIPOS tipoGenero on tipoGenero.id = pi.gen_id
left join HER_TIPOS clasificacion on clasificacion.id = pi.cla_id, 
HER_PROPIEDAD_INT_COTITULAR picot,  
HER_DEPENDENCIA D, HER_SEDE S
WHERE (D.SED_ID IN (SELECT COLUMN_VALUE FROM TABLE(SPLIT(?)))
or (pi.DPN_ID_APOYO is not null and pi.DPN_ID_APOYO in (SELECT COLUMN_VALUE FROM TABLE(SPLIT(?)))))
AND PI.DPN_ID = D.DPN_ID
AND S.SED_ID = D.SED_ID
and picot.FFI_ID = ? and picot.PRI_ID = PI.PRI_ID

)</property>
        </oda-data-set>
        <oda-data-set extensionID="org.eclipse.birt.report.data.oda.jdbc.JdbcSelectDataSet" name="cotitulares" id="10047">
            <structure name="cachedMetaData">

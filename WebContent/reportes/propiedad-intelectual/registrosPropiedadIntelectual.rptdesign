            <property name="queryText">select distinct LISTAGG(p.PER_NOMBRE1||' '||DECODE(p.PER_NOMBRE2,p.PER_NOMBRE2,p.PER_NOMBRE2,NULL,' ')||' '||p.PER_APELLIDO1||' '||DECODE(p.PER_APELLIDO2,p.PER_APELLIDO2,p.PER_APELLIDO2,NULL,' '), '; ') WITHIN GROUP (ORDER BY p.PER_NOMBRE1, p.PER_NOMBRE2, p.PER_APELLIDO1, p.PER_APELLIDO2) as autores
from her_propiedad_int_persona pip, her_persona p
where pip.pri_id = ? and pip.inv_ID = p.per_ID and pip.tdo_id = p.tdo_id group by pip.PRI_ID</property>

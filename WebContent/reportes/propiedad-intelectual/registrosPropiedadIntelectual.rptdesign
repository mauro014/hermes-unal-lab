            </list-property>
            <property name="queryText">select distinct LISTAGG(ff.ffi_descripcion, '; ') WITHIN GROUP (ORDER BY ff.ffi_descripcion) as cotitulares
from her_propiedad_int_cotitular pic, her_fuente_financiacion ff
where pic.pri_id = ? and pic.FFI_ID = ff.FFI_ID group by pic.PRI_ID</property>

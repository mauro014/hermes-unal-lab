            <property name="queryText">SELECT PC.PCL_PALABRA as palabra_clave
FROM her_proyecto pry,  
HER_PALABRA_CLAVE PC, HER_PROYECTO_PALABRA_CLAVE PPC 
WHERE pry.pry_id = ?
AND Pry.PRY_ID = PPC.PRY_ID
AND PC.PCL_ID = PPC.PCL_ID</property>
        </oda-data-set>

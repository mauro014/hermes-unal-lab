            <property name="queryText">select distinct cp.cnp_titulo as convocatoria,
c.con_titulo as modalidad
from her_proyecto pry, her_convocatoria_padre cp, her_convocatoria c 
where pry.pry_id = ?
and pry.mod_id = c.con_id
and c.cnp_id = cp.cnp_id
</property>

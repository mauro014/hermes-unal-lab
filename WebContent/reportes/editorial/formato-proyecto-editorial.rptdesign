            <property name="queryText">SELECT
    '('
    || ip.tdo_id
    || ' - '
    || ip.inv_id
    || ')' AS documento,
    p.per_nombre1
    || ' '
    || decode(p.per_nombre2, p.per_nombre2, p.per_nombre2, NULL, ' ')
    || ' '
    || p.per_apellido1
    || ' '
    || decode(p.per_apellido2, p.per_apellido2, p.per_apellido2, NULL, ' ') persona,
    case when ti.tinv_tipo='E' then decode(ins.ins_nombre, NULL, 'No disponible', ins.ins_nombre)
    ELSE decode(dp.dpn_nombre, NULL, decode(d.dpn_nombre, NULL, 'No disponible', d.dpn_nombre
    ), dp.dpn_nombre) end AS unidad,
    ti.tinv_nombre                   AS vinculacion,
    ip.inp_valor_pagar               AS valor_dedicacion,
    ip.inp_dedicacion_horas_semana   AS horas_semana,
    ip.inp_total_horas_vinculacion   AS total_tiempo,
    'Grupo: ' || g.gru_nombre AS grupo,
    g.gru_id,
    decode(ip.inp_funcion, NULL, 'No disponible', ip.inp_funcion) AS funcion,
    '('
    || p.per_email
    || ')' AS email,
    p.per_telefono,
    p.per_celular,
    p.per_fnacimiento,
    p.per_profesion,
    p.per_nacionalidad
FROM HER_PROYECTO PRY
LEFT JOIN HER_INVESTIGADOR_PROYECTO IP ON PRY.PRY_ID = IP.PRY_ID
LEFT JOIN HER_INVESTIGADOR_INTERNO II ON II.TDO_ID = IP.TDO_ID AND II.INV_ID = IP.INV_ID
LEFT JOIN HER_PERSONA P ON P.PER_ID = IP.INV_ID AND P.TDO_ID = IP.TDO_ID
LEFT JOIN HER_DEPENDENCIA D ON II.DPN_ID = D.DPN_ID
LEFT JOIN HER_DEPENDENCIA DP ON DP.DPN_ID = IP.DPN_ID
LEFT JOIN HER_TIPO_INVESTIGADOR TI ON TI.TINV_ID = IP.INP_TIPO
LEFT JOIN HER_GRUPO G ON G.GRU_ID = IP.GRU_ID
LEFT JOIN HER_INSTITUCION INS ON IP.INS_ID = INS.INS_ID
WHERE PRY.PRY_ID = ?
AND IP.INP_TIPO &lt;> 'P'
AND IP.INV_ID NOT IN (SELECT TIN.TINV_DOCUMENTO FROM HER_TIPO_INVESTIGADOR TIN WHERE TIN.TINV_DOCUMENTO is not null)
</property>
        </oda-data-set>

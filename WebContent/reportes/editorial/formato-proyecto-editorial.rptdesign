            <property name="queryText">SELECT D.DPN_NOMBRE AS DEPENDENCIA,
PRY_DEP.PRD_AREA_RESPONSABILIDAD AS AREA_RESPONSABILIDAD, CONV.CON_RESTRICCION
FROM HER_PROYECTO_DEPENDENCIA PRY_DEP, HER_DEPENDENCIA D, HER_CONVOCATORIA CONV, HER_PROYECTO PRY
WHERE PRY_DEP.PRY_ID = ?
AND PRY.PRY_ID = PRY_DEP.PRY_ID
AND PRY_DEP.DPN_ID = D.DPN_ID
AND CONV.CON_ID = PRY.MOD_ID</property>
        </oda-data-set>

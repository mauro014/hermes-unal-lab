            <property name="queryText">select PRY.PRY_ID as ID,
PRY.PRY_NOMBRE as NOMBRE,
EP.EPR_NOMBRE AS ESTADO,
PRY.PRY_ISBN_SUB_TOBRA AS SUBTITULO, 
PRY.PRY_ISBN_NUM_PAGS AS EXTENSION,
PRY.PRY_ABSTRACT AS RESUMEN,
PRY.PRY_ISBN_TIENE_SELLO_EDITORIAL AS SELLO,
decode(PE.PRY_TIPO_PUBLICACION,'Inv','Resultado de investigación (MinCiencias)','Div','Resultado Divulgación') as tipo_publicacion,
decode(pe.PRY_COMITE_PUNTAJE,'0','NO','1','SI') as comite_puntaje,
decode(pe.PRY_INDICES_ANALITICOS,'0','NO','1','SI') as indices_analiticos,
decode(pe.PRY_TEXTO_OTRO_IDIOMA,'0','NO','1','SI') as otro_idioma,
decode(pe.PRY_MATERIAL_GRAFICO_BN,'0','NO','1','SI') as material_bn,
decode(pe.PRY_MATERIAL_GRAFICO_COLOR,'0','NO','1','SI') as material_color,
decode(pe.PRY_MATERIAL_GRAFICO_AJENO,'0','NO','1','SI') as material_ajeno,
decode(pe.PRY_LICENCIA_REPRODUCCION,'0','NO','1','SI') as licencia_reprod,
dd.DOMDET_DESCRIPCION as pub_obj,
pe.PRY_BREVE_DESCRIPCION_AUD as descripcion_pub_obj,
dd2.DOMDET_DESCRIPCION as dewey,
t.nombre as thema1,
t2.nombre as thema2,
t3.nombre as thema3
from HER_PROYECTO PRY
left join HER_ESTADO_PROYECTO EP ON EP.EPR_ID = PRY.EPR_ID
left join HER_PROYECTO_EDITORIAL PE ON PE.PRY_ID = PRY.PRY_ID
left join her_dominio d on d.dom_tipo = 'ISBN_AUDIENCIA_2018'
left join her_dominio_detalle dd on d.dom_id = dd.dom_id and pry.PRY_ISBN_AUDIENCIA = dd.DOMDET_TIPO
left join her_dominio d2 on d2.dom_tipo = 'ISBN_MATERIA'
left join her_dominio_detalle dd2 on d2.dom_id = dd2.dom_id and pry.PRY_ISBN_MATERIA = dd2.DOMDET_TIPO
left join her_tipos t on pry.PRY_ISBN_CLA_THEMA_N1 = t.id and t.tipo_id = 1217
left join her_tipos t2 on pry.PRY_ISBN_CLA_THEMA_N2 = t2.id and t2.tipo_id = t.id
left join her_tipos t3 on pry.PRY_ISBN_CLA_THEMA_N3 = t3.id and t3.tipo_id = t2.id
where PRY.PRY_ID = ?</property>
        </oda-data-set>

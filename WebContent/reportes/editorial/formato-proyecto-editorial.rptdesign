                    <property name="position">1</property>
                    <property name="name">TCM_NOMBRE</property>
                    <property name="nativeName">TCM_NOMBRE</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">2</property>
                    <property name="name">CMG_CANTIDAD_PROPIO</property>
                    <property name="nativeName">CMG_CANTIDAD_PROPIO</property>
                    <property name="dataType">decimal</property>
                </structure>
                <structure>
                    <property name="position">3</property>
                    <property name="name">CMG_CANTIDAD_AJENO</property>
                    <property name="nativeName">CMG_CANTIDAD_AJENO</property>
                    <property name="dataType">decimal</property>
                </structure>
            </list-property>
            <property name="queryText">select tmg.TCM_NOMBRE, mg.CMG_CANTIDAD_PROPIO, mg.CMG_CANTIDAD_AJENO
from HER_CANTIDAD_MATERIAL_GRAFICO mg left join HER_TIPO_MATERIAL_GRAFICO tmg on tmg.TCM_ID = mg.TCM_ID
where mg.pry_id = ?</property>
        </oda-data-set>

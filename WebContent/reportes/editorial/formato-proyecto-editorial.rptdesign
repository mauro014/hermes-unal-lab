            <property name="queryText">select 
pe.PRY_ORIGEN_PROYECTO,
dd.domdet_descripcion as origen,
pe.PRY_OTRO_ORIGEN_PROYECTO as otro_origen,
p.PRY_PRY_ASOCIADO as pry_asociado,
pe.PRY_CARACTER_PROYECTO,
dd2.domdet_descripcion as caracter_proyecto
from her_proyecto p 
left join HER_PROYECTO_EDITORIAL pe on pe.pry_id = p.pry_id
left join her_dominio_detalle dd on dd.domdet_tipo = pe.PRY_ORIGEN_PROYECTO and dd.dom_id = 280
left join her_dominio_detalle dd2 on dd2.domdet_tipo = pe.PRY_CARACTER_PROYECTO and dd2.dom_id = 281
where pe.pry_id = ?</property>
        </oda-data-set>

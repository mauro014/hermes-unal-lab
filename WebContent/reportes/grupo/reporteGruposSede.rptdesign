                    <property name="position">47</property>
                    <property name="name">PRIORIDAD</property>
                    <property name="nativeName">PRIORIDAD</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">48</property>
                    <property name="name">GRUPLAC</property>
                    <property name="nativeName">GRUPLAC</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">49</property>
                    <property name="name">ENLHERMES</property>
                    <property name="nativeName">ENLHERMES</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">50</property>
                    <property name="name">INTERFA</property>
                    <property name="nativeName">INTERFA</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">51</property>
                    <property name="name">INTERI</property>
                    <property name="nativeName">INTERI</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">52</property>
                    <property name="name">INTERS</property>
                    <property name="nativeName">INTERS</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">53</property>
                    <property name="name">OCDE</property>
                    <property name="nativeName">OCDE</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">54</property>
                    <property name="name">AGENDA</property>
                    <property name="nativeName">AGENDA</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">55</property>
                    <property name="name">AREAS_OCDE</property>
                    <property name="nativeName">AREAS_OCDE</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">56</property>
                    <property name="name">PROYECTO</property>
                    <property name="nativeName">PROYECTO</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">57</property>
                    <property name="name">PRODUCTO</property>
                    <property name="nativeName">PRODUCTO</property>
                    <property name="dataType">string</property>
                </structure>
            </list-property>
            <property name="queryText">select DISTINCT
	to_number(g.gru_id) idGrupo,
	case to_char(?)
  		when '1' then g.gru_nombre
	  	else null
	end nombreGrupo,
	case to_char(?)
  		when '1' then (select max(x.HEG_FECHA) from HER_HISTORICO_ESTADO_GRUPO x WHERE x.EGR_ID='A' and x.GRU_ID=g.GRU_ID)
	  	else null
	end FechaActivo,
	case to_char(?)
  		when '1' then (select max(HFG_FECHA) from HER_HISTORICO_FORMULARIO_GRUPO hfg where hfg.GRU_ID=g.GRU_ID)
	  	else null
	end fechaMod,
	case to_char(?)
  		when '1' then g.GRU_COLCIENCIAS
	  	else null
	end colciencias,
	case to_char(?)
  		when '1' then hgc.GRC_NOMBRE 
	  	else null
	end categoria,
	case to_char(?)
  		when '1' then eg.egr_nombre
	  	else null
	end estadoGrupo,
	case to_char(?)
  		when '1' then ec.egc_nombre
	  	else null
	end estadoCol,
	case to_char(?)
  		when '1' then s.sed_nombre
	  	else null
	end sede,
	case to_char(?)
  		when 'SFS' then sSec.SED_NOMBRE
	  	else null
	end sedeSec,
	case to_char(?)
  		when '1' then d.dpn_nombre
	  	else null
	end facultad,
	case to_char(?)
  		when 'SFS' then fSec.dpn_nombre
	  	else null
	end facSec,
	case to_char(?)
  		when 'OCD' then DD_PADRE.DOMdET_DESCRIPCION
	  	else null
	end areapadre,
	case to_char(?)
  		when 'OCD' then DD.DOMdET_DESCRIPCION
	  	else null
	end area,
	case to_char(?)
  		when 'OCD' then aoSec.AREA_PADRE
	  	else null
	end areaSecpadre,
	case to_char(?)
  		when 'OCD' then aoSec.AREA
	  	else null
	end areaSec,
	case to_char(?)
  		when '1' then g.gru_fcreacion
	  	else null
	end fechaCreacion,
	case to_char(?)
  		when '1' then td.TDO_NOMBRE||' - '||per.PER_ID
	  	else null
	end IDLider,
	case to_char(?)
  		when '1' then per.PER_NOMBRE1||decode(per.PER_NOMBRE2,null,' ',' '||per.PER_NOMBRE2||' ')||per.PER_APELLIDO1||decode(per.PER_APELLIDO2,null,'',' '||per.PER_APELLIDO2)
	  	else null
	end lider,
	case to_char(?)
  		when '1' then d2.dpn_nombre
	  	else null
	end departamento,
	case to_char(?)
  		when '1' then g.GRU_EMAIL
	  	else null
	end emailGrupo,
	case to_char(?)
  		when '1' then g.GRU_TELEFONO
	  	else null
	end telefonoGrupo,
	case to_char(?)
  		when '1' then hdd.DOMDET_DESCRIPCION
	  	else null
	end ods_PRINCIPAL,
	case to_char(?)
  		when '1' then hdd2.DOMDET_DESCRIPCION
	  	else null
	end ods_SECUNDARIO,
	case to_char(?)
  		when 'LIN' then li.LIN_NOMBRE
	  	else null
	end NOMBRELINEA,
	case to_char(?)
  		when 'ADC' then ag.TIPO
	  	else null
	end AG_TIPO,
	case to_char(?)
  		when 'ADC' then ag.AGG_NOMBRE
	  	else null
	end AG_NOMBRE,
	case to_char(?)
  		when 'PDE' then pe.PLE_NOMBRE
	  	else null
	end PLANEST,
	case to_char(?)
  		when 'INT' then int.IDINTEGRANTE
	  	else null
	end IDINTEGRANTE,
	case to_char(?)
  		when 'INT' then int.PERSONA
	  	else null
	end PERSONA,
	case to_char(?)
  		when 'INT' then int.TIPOVINCULACION
	  	else null
	end TIPOVINCULACION,
	case to_char(?)
  		when 'INT' then int.TIPO
	  	else null
	end TIPO,
	case to_char(?)
  		when 'INT' then int.DPN_NOMBRE
	  	else null
	end DPN_NOMBRE,
	case to_char(?)
  		when 'AVL' then a.AVI_ID
	  	else null
	end AVI_ID,
	case to_char(?)
  		when 'AVL' then a.fechaultimoenvio
	  	else null
	end fechaultimoenvio,
	case to_char(?)
  		when 'AVL' then a.fechaAprobacion
	  	else null
	end fechaAprobacion,
	case to_char(?)
  		when 'AVL' then a.estado
	  	else null
	end estado,
	case to_char(?)
  		when 'ENT' then ent.ENTIDAD
	  	else null
	end ENTIDAD,
	case to_char(?)
  		when 'LAB' then lab.LABORATORIO
	  	else null
	end LABORATORIO,
	case to_char(?)
  		when 'SEM' then SEMI.SEMILLERO
	  	else null
	end SEMILLERO,
	case to_char(?)
  		when '1' then DBMS_LOB.SUBSTR(g.gru_vision, 4000, 1)
	  	else null
	end enfoque,
	case to_char(?)
  		when '1' then g.GRU_NECESIDAD
	  	else null
	end necesidad,
	case to_char(?)
  		when '1' then g.GRU_PERTINENCIA
	  	else null
	end pertinencia,
	case to_char(?)
  		when '1' then decode(g.GRU_SIMILAR,'S','SI','NO')||' - '|| g.GRU_SIMILAR_EXP
	  	else null
	end grupoSimilar,
	case to_char(?)
  		when '1' then decode(g.GRU_AVAL,null,'NO','SI')
	  	else null
	end grupoAval,
	case to_char(?)
  		when '1' then DBMS_LOB.SUBSTR(g.GRU_PERSPECTIVA, 4000, 1)
	  	else null
	end perspectiva,
	case to_char(?)
  		when '1' then DBMS_LOB.SUBSTR(g.GRU_PRIORIDAD, 4000, 1)
	  	else null
	end prioridad,
	case to_char(?)
  		when '1' then g.GRU_ENLACE_GRUPLAC
	  	else null
	end gruplac,
	case to_char(?)
  		when '1' then 'http://www.hermes.unal.edu.co/pages/Consultas/Grupo.jsf?idGrupo='||g.gru_id
	  	else null
	end enlhermes,
	case to_char(?)
  		when '1' then decode(g.GRU_INTERFACULTADES,'S','SI','NO')
	  	else null
	end interfa,
	case to_char(?)
  		when '1' then decode(g.GRU_INTERINSTITUCION,'S','SI','NO')
	  	else null
	end interi,
	case to_char(?)
  		when '1' then decode(g.GRU_INTERSEDES,'S','SI','NO')
	  	else null
	end inters,
	case to_char(?)
  		when '1' then (SELECT DD_PADRE.DOMdET_DESCRIPCION ||' - '|| DD.DOMdET_DESCRIPCION AS AREA
FROM HER_DOMINIO_DETALLE DD, HER_GRUPO ga, HER_DOMINIO_DETALLE DD_PADRE
WHERE GA.GRU_ID = g.gru_id 
AND GA.DOMDET_TIPO_SUBAREA = DD.DOMDET_TIPO 
AND GA.DOM_ID_SUBAREA = DD.DOM_ID
AND DD.DOMDET_ESTADO = DD_PADRE.DOMDET_TIPO)
	  	else null
	end ocde,
	case to_char(?)
  		when '1' then (select pag.AGG_NOMBRE from HER_POSIBLE_AGENDA_GRUPO pag where pag.AGG_ID = g.AGG_ID)
	  	else null
	end agenda,
	case to_char(?)
  		when 'OCD' then (SELECT DD_PADRE.DOMdET_DESCRIPCION ||' - '|| DD.DOMdET_DESCRIPCION AS AREA
FROM HER_DOMINIO_DETALLE DD, HER_GRUPO_AREA_TEMATICA GAT, HER_DOMINIO_DETALLE DD_PADRE
WHERE GAT.GRU_ID = g.gru_id 
AND GAT.DOMDET_TIPO = DD.DOMDET_TIPO 
AND GAT.DOM_ID = DD.DOM_ID
AND DD.DOMDET_ESTADO = DD_PADRE.DOMDET_TIPO)
	  	else null
	end areas_ocde,
	case to_char(?)
  		when 'PRY' then (SELECT 
	P.PRY_ID ||' - '|| P.PRY_NOMBRE AS NOMBREPRY
FROM 
	HER_GRUPO_PROYECTO GP, HER_PROYECTO P
WHERE 
	GP.GRU_ID = G.GRU_ID
	AND P.PRY_ID = Gp.PRY_ID
	AND P.EPR_ID in ('A','AP','F'))
	  	else null
	end PROYECTO,
		case to_char(?)
  		when 'PRD' then (SELECT 
	GPS.GPS_TIPO ||' - '|| GPS.GPS_NOMBRE
FROM 
	HER_GRUPO_PRODUCTO_SARA gps
WHERE 
	GPS.GRU_ID = g.gru_id)
	  	else null
	end producto
	
from
	her_grupo g
    left join her_estado_grupo eg on eg.egr_id = g.egr_id
    left join her_estado_grupo_colciencias ec on ec.egc_id = g.egc_id
    LEFT JOIN HER_GRUPO_CATEGORIA hgc ON g.GRU_CATEGORIA_COLCIENCIAS =hgc.GRC_ID 
    left join her_dependencia d on d.dpn_id = g.dpn_id
    left join her_sede s on d.sed_id = s.sed_id
    left join (
  		SELECT GS.GRU_ID,S.SED_NOMBRE
    	FROM HER_GRUPO_INTERSEDE GS,
      HER_SEDE S
  		WHERE GS.SED_ID = S.SED_ID
    ) sSec on sSec.GRU_ID=g.GRU_ID
    left join(
  		SELECT GD.GRU_ID,D.DPN_NOMBRE
    	FROM HER_GRUPO_DEPENDENCIA GD,
      HER_DEPENDENCIA D
  		WHERE GD.DPN_ID = D.DPN_ID
    ) fSec on fSec.GRU_ID=g.GRU_ID
    left join HER_DOMINIO_DETALLE DD on g.DOM_ID_SUBAREA = DD.DOM_ID and g.DOMDET_TIPO_SUBAREA = DD.DOMDET_TIPO
    left join HER_DOMINIO_DETALLE DD_PADRE on DD.DOMDET_ESTADO = DD_PADRE.DOMDET_TIPO
    left join (
  		SELECT GAT.GRU_ID, DD_PADRE.DOMdET_DESCRIPCION AS AREA_PADRE, DD.DOMdET_DESCRIPCION AS AREA
    	FROM HER_DOMINIO_DETALLE DD,
      HER_GRUPO_AREA_TEMATICA GAT,
  		HER_DOMINIO_DETALLE DD_PADRE
    	WHERE GAT.DOMDET_TIPO = DD.DOMDET_TIPO 
      	AND GAT.DOM_ID = DD.DOM_ID
        AND DD.DOMDET_ESTADO = DD_PADRE.DOMDET_TIPO
  	) aoSec on aoSec.GRU_ID=g.GRU_ID
    left join her_investigador_grupo ig on g.gru_id = ig.GRU_ID and ig.ING_TIPO = 'L'
    left join her_investigador_interno ii on ii.inv_id = ig.inv_id and ii.tdo_id = ig.tdo_id
    left join her_persona per on per.per_id = ig.inv_id and per.tdo_id = ig.tdo_id
    left join HER_TIPO_DOCUMENTO td on per.TDO_ID=td.TDO_ID
    left join her_dependencia d2 on ii.dpn_id = d2.dpn_id 
    left join (
  		SELECT GL.GRU_ID, LI.LIN_NOMBRE
    	FROM HER_GRUPO_LINEA GL,
      HER_LINEA_INVESTIGACION LI
  		WHERE GL.LIN_ID = LI.LIN_ID
    ) li on li.GRU_ID=g.GRU_ID
    left join (
  		select g.GRU_ID,'Principal' tipo,pag.AGG_NOMBRE
    	from her_grupo g
      	inner join HER_POSIBLE_AGENDA_GRUPO pag on pag.AGG_ID = g.AGG_ID
  		union all
    	SELECT A.GRU_ID,'Secundaria' tipo,PA.AGG_NOMBRE AS AGENDA
      FROM HER_GRUPO_AGENDA A, HER_POSIBLE_AGENDA_GRUPO PA
  		WHERE A.AGG_ID = PA.AGG_ID
    ) ag on ag.GRU_ID=g.GRU_ID
  	left join (
    	SELECT GP.GRU_ID,PE.PLE_NOMBRE
      FROM HER_GRUPO_PLAN GP,
  		HER_PLAN_ESTUDIOS PE
    	WHERE GP.PLE_ID = PE.PLE_ID
  	) pe on pe.GRU_ID=g.GRU_ID
    left join (
  		SELECT ig.GRU_ID, p.PER_NOMBRE1||decode(p.PER_NOMBRE2,null,' ',' '||p.PER_NOMBRE2||' ')||p.PER_APELLIDO1||decode(p.PER_APELLIDO2,null,'',' '||p.PER_APELLIDO2) persona, igt.IGT_NOMBRE as tipo, d.dpn_nombre, decode(ig.ING_TIPO_VINCULACION,'I','Interno','E','Externo','No Registra') tipoVinculacion, td.TDO_NOMBRE||' - '||p.PER_ID IDIntegrante
    	FROM HER_INVESTIGADOR_GRUPO ig
      	left join HER_INVESTIGADOR_GRUPO_TIPO igt on ig.ING_TIPO=igt.IGT_ID,
  		her_persona p
    		left join her_investigador_interno ii on p.TDO_ID = ii.TDO_ID and p.PER_ID = ii.INV_ID 
      	left join her_dependencia d on d.dpn_id = ii.dpn_id
        left join HER_TIPO_DOCUMENTO td on p.TDO_ID=td.TDO_ID
  		WHERE ig.inv_id = p.per_id
    		and ig.tdo_id = p.tdo_id
      	and ig.ING_TIPO != 'L'
  	) int on int.GRU_ID=g.GRU_ID
    left join (
  		select distinct a.AVI_ID, a.AVI_ULTIMO_ENVIO_SOLICIT fechaultimoenvio, a.AVI_FECHA_AVAL_COOR fechaAprobacion,
    		case
      		when a.AVI_ESTADO='P' then 'Formulación'
        	when a.AVI_ESTADO='B' then 'Solicitud Anulada'
          else
            decode(a.AVI_ESTADO||a.AVI_AVALFACULTAD||a.AVI_AVALDIRECCION||a.AVI_AVALVICE,null,'Pendiente por revisión','C','Devuelto para correcciones','I','Enviado',
  						'FS','Aprobado en facultad','FN','No aprobado en facultad','DSS','Aprobado en dirección de investigación', 'DSN','No aprobado en dirección de investigación',
    					'VSSS','Aprobado en Vicerrectoría de Investigación','VSSN','No aprobado en Vicerrectoría de Investigación','')
      	end estado, a.AVI_NOMBRE_GRUPO_PINV gru_id
  		from HER_AVAL a
    	where a.AVI_TIPO='GR'
      	and a.AVI_AVALDIRECCION='S'
  	) a on a.GRU_ID=g.GRU_ID
  	LEFT JOIN HER_DOMINIO_DETALLE hdd ON
	hdd.DOMDET_TIPO = g.GRU_ODS_PRINCIPAL
	AND hdd.DOM_ID = 212
LEFT JOIN HER_DOMINIO_DETALLE hdd2 ON
	hdd2.DOMDET_TIPO = g.GRU_ODS_SECUNDARIO
	AND hdd2.DOM_ID = 212
left join (SELECT
	hgi.GRU_ID,
	hff.FFI_DESCRIPCION entidad
FROM
	HER_GRUPO_INSTITUCION hgi
INNER JOIN HER_FUENTE_FINANCIACION hff ON
	hgi.FFI_ID = hff.FFI_ID) ent on ent.gru_id=g.gru_id
	LEFT JOIN (SELECT
	hgl.GRU_ID,
	hl.LAB_NOMBRE LABORATORIO
FROM
	HER_GRUPO_LABORATORIO hgl 
INNER JOIN HER_LABORATORIO hl ON hgl.LAB_ID =hl.LAB_ID) lab ON lab.GRU_ID=g.GRU_ID
LEFT JOIN (SELECT
	sg.GRU_ID,
	sem.sem_NOMBRE semillero
FROM
	HER_SEMILLERO_GRUPO SG 
INNER JOIN HER_SEMILLERO SEM ON SG.SEM_ID =SEM.SEM_ID) SEMI ON SEMI.GRU_ID=g.GRU_ID

where
	g.egr_id in (SELECT COLUMN_VALUE FROM TABLE(SPLIT(?1))) AND d2.sed_id = ?
ORDER BY idGrupo, sedeSec, facSec, departamento, nombrelinea, AG_TIPO, AG_NOMBRE, PLANEST, IDINTEGRANTE, AVI_ID, ENTIDAD, LABORATORIO</property>
        </oda-data-set>
    </data-sets>
    <styles>

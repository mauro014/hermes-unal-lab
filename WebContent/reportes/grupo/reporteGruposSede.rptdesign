    <body>
        <label id="30">
            <property name="backgroundColor">#FF8000</property>
            <property name="fontFamily">"Ancizar Sans"</property>
            <property name="fontSize">12pt</property>
            <property name="fontWeight">bold</property>
            <property name="textAlign">center</property>
            <text-property name="text">Sistema de Información HERMES - Componente de Investigación y Laboratorios</text-property>
        </label>
        <label id="33">
            <property name="backgroundColor">silver</property>
            <property name="fontFamily">"Ancizar Sans"</property>
            <property name="fontSize">12pt</property>
            <property name="fontWeight">bold</property>
            <property name="textAlign">center</property>
            <text-property name="text">Reporte de Grupos de Investigación</text-property>
        </label>
        <label id="31">
            <text-property name="text"></text-property>
        </label>
        <table id="10565">
            <property name="width">100%</property>
            <property name="dataSet">0_Base</property>
            <list-property name="boundDataColumns">
                <structure>
                    <property name="name">IDGRUPO</property>
                    <expression name="expression">dataSetRow["IDGRUPO"]</expression>
                    <property name="dataType">decimal</property>
                </structure>
                <structure>
                    <property name="name">NOMBREGRUPO</property>
                    <expression name="expression">dataSetRow["NOMBREGRUPO"]</expression>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="name">FECHAACTIVO</property>
                    <expression name="expression">dataSetRow["FECHAACTIVO"]</expression>
                    <property name="dataType">date-time</property>
                </structure>
                <structure>
                    <property name="name">FECHAMOD</property>
                    <expression name="expression">dataSetRow["FECHAMOD"]</expression>
                    <property name="dataType">date-time</property>
                </structure>
                <structure>
                    <property name="name">COLCIENCIAS</property>
                    <expression name="expression">dataSetRow["COLCIENCIAS"]</expression>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="name">CATEGORIA</property>
                    <expression name="expression">dataSetRow["CATEGORIA"]</expression>
                    <property name="dataType">string</property>

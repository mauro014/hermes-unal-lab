            <property name="queryText">select DISTINCT
	g.gru_id idGrupo,
	case to_char(?)
  		when '1' then g.gru_nombre
	  	else null
	end nombreGrupo,
	case to_char(?)
  		when '1' then (select max(x.HEG_FECHA) from HER_HISTORICO_ESTADO_GRUPO x WHERE x.EGR_ID='A' and x.GRU_ID=g.GRU_ID)
	  	else null
	end FechaActivo,
	case to_char(?)
  		when '1' then (select max(HFG_FECHA) from HER_HISTORICO_FORMULARIO_GRUPO hfg where hfg.GRU_ID=g.GRU_ID)
	  	else null
	end fechaMod,
	case to_char(?)
  		when '1' then g.GRU_COLCIENCIAS
	  	else null
	end colciencias,
	case to_char(?)
  		when '1' then hgc.GRC_NOMBRE 
	  	else null
	end categoria,
	case to_char(?)
  		when '1' then eg.egr_nombre
	  	else null
	end estadoGrupo,
	case to_char(?)
  		when '1' then ec.egc_nombre
	  	else null
	end estadoCol,
	case to_char(?)
  		when '1' then s.sed_nombre
	  	else null
	end sede,
	case to_char(?)
  		when '1' then d.dpn_nombre
	  	else null
	end facultad,
	case to_char(?)
  		when '1' then g.gru_fcreacion
	  	else null
	end fechaCreacion,
	case to_char(?)
  		when '1' then td.TDO_NOMBRE||' - '||per.PER_ID
	  	else null
	end IDLider,
	case to_char(?)
  		when '1' then per.PER_NOMBRE1||decode(per.PER_NOMBRE2,null,' ',' '||per.PER_NOMBRE2||' ')||per.PER_APELLIDO1||decode(per.PER_APELLIDO2,null,'',' '||per.PER_APELLIDO2)
	  	else null
	end lider,
	case to_char(?)
  		when '1' then d2.dpn_nombre
	  	else null
	end departamento,
	case to_char(?)
  		when '1' then g.GRU_EMAIL
	  	else null
	end emailGrupo,
	case to_char(?)
  		when '1' then g.GRU_TELEFONO
	  	else null
	end telefonoGrupo,
	case to_char(?)
  		when '1' then hdd.DOMDET_DESCRIPCION
	  	else null
	end ods_PRINCIPAL,
	case to_char(?)
  		when '1' then hdd2.DOMDET_DESCRIPCION
	  	else null
	end ods_SECUNDARIO,
	case to_char(?)
  		when 'PRY' then pry.PRY_ID
	  	else null
	end CODPRY,
	case to_char(?)
  		when 'PRY' then pry.PRY_NOMBRE
	  	else null
	end NOMBREPRY,
	case to_char(?)
  		when 'PRY' then pry.EPR_NOMBRE
	  	else null
	end ESTADOPRY
from
	her_grupo g
    left join her_estado_grupo eg on eg.egr_id = g.egr_id
    left join her_estado_grupo_colciencias ec on ec.egc_id = g.egc_id
    LEFT JOIN HER_GRUPO_CATEGORIA hgc ON g.GRU_CATEGORIA_COLCIENCIAS =hgc.GRC_ID 
    left join her_dependencia d on d.dpn_id = g.dpn_id
    left join her_sede s on d.sed_id = s.sed_id
    left join her_investigador_grupo ig on g.gru_id = ig.GRU_ID and ig.ING_TIPO = 'L'
    left join her_investigador_interno ii on ii.inv_id = ig.inv_id and ii.tdo_id = ig.tdo_id
    left join her_persona per on per.per_id = ig.inv_id and per.tdo_id = ig.tdo_id
    left join HER_TIPO_DOCUMENTO td on per.TDO_ID=td.TDO_ID
    left join her_dependencia d2 on ii.dpn_id = d2.dpn_id
    left join (
  		SELECT GP.GRU_ID, P.PRY_ID, P.PRY_NOMBRE, EP.EPR_NOMBRE
    	FROM HER_GRUPO_PROYECTO GP,
      HER_PROYECTO P,
  		HER_ESTADO_PROYECTO EP
    	WHERE  P.PRY_ID = GP.PRY_ID
        AND EP.EPR_ID = P.EPR_ID
        AND P.EPR_ID in ('A','AP','F')
    ) pry on pry.GRU_ID=g.GRU_ID
    LEFT JOIN HER_DOMINIO_DETALLE hdd ON
	hdd.DOMDET_TIPO = g.GRU_ODS_PRINCIPAL
	AND hdd.DOM_ID = 212
LEFT JOIN HER_DOMINIO_DETALLE hdd2 ON
	hdd2.DOMDET_TIPO = g.GRU_ODS_SECUNDARIO
	AND hdd2.DOM_ID = 212
where
	g.egr_id in (SELECT COLUMN_VALUE FROM TABLE(SPLIT(?1)))
ORDER BY idGrupo, departamento</property>
        </oda-data-set>
    </data-sets>

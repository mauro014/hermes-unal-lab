                    </structure>
                    <structure>
                        <property name="position">2</property>
                        <property name="name">TIPO</property>
                        <property name="dataType">string</property>
                    </structure>
                </list-property>
            </structure>
            <property name="dataSource">OrigenHermes</property>
            <list-property name="parameters">
                <structure>
                    <property name="name">id</property>
                    <property name="paramName">id</property>
                    <property name="dataType">string</property>
                    <property name="position">1</property>
                    <property name="isInput">true</property>
                    <property name="isOutput">false</property>
                </structure>
            </list-property>
            <list-property name="resultSet">
                <structure>
                    <property name="position">1</property>
                    <property name="name">AAV_NOMBRE</property>
                    <property name="nativeName">AAV_NOMBRE</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">2</property>
                    <property name="name">TIPO</property>
                    <property name="nativeName">TIPO</property>
                    <property name="dataType">string</property>
                </structure>
            </list-property>
            <property name="queryText">SELECT
	haa.AAV_NOMBRE,
	nvl(hdd.DOMDET_DESCRIPCION, 'Sin tipo asociado') TIPO
FROM
	HER_ARCHIVO_AVAL haa
LEFT JOIN HER_DOMINIO_DETALLE hdd ON
	hdd.DOM_ID = 275
	AND hdd.DOMDET_TIPO = haa.AAV_TIPO
WHERE
	haa.AAV_FECHA_BORRADO IS NULL
	AND haa.AVI_ID = ?</property>
        </oda-data-set>
        <oda-data-set extensionID="org.eclipse.birt.report.data.oda.jdbc.JdbcSelectDataSet" name="HistoricoEstado" id="14633">
            <structure name="cachedMetaData">

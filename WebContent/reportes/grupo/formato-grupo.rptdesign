                    <property name="position">2</property>
                    <property name="name">PRODUCTO</property>
                    <property name="nativeName">PRODUCTO</property>
                    <property name="dataType">string</property>
                </structure>
            </list-property>
            <property name="queryText">SELECT 
	GPS.GPS_TIPO AS TIPO, GPS.GPS_NOMBRE AS PRODUCTO
FROM 
	HER_GRUPO_PRODUCTO_SARA gps
WHERE 
	GPS.GRU_ID = ?
	ORDER BY GPS.GPS_NOMBRE ASC</property>
        </oda-data-set>
        <oda-data-set extensionID="org.eclipse.birt.report.data.oda.jdbc.JdbcSelectDataSet" name="ProyectoGrupo" id="8465">
            <structure name="cachedMetaData">
                <list-property name="resultSet">
                    <structure>
                        <property name="position">1</property>
                        <property name="name">PRY_ID</property>
                        <property name="dataType">decimal</property>
                    </structure>
                    <structure>
                        <property name="position">2</property>
                        <property name="name">NOMBREPROYECTO</property>
                        <property name="dataType">string</property>
                    </structure>
                    <structure>
                        <property name="position">3</property>
                        <property name="name">ESTADO</property>
                        <property name="dataType">string</property>
                    </structure>
                </list-property>
            </structure>
            <property name="dataSource">OrigenHermes</property>
            <list-property name="parameters">
                <structure>
                    <property name="name">gru</property>
                    <property name="paramName">id</property>
                    <property name="dataType">string</property>
                    <property name="position">1</property>
                    <property name="isInput">true</property>
                    <property name="isOutput">false</property>
                </structure>
            </list-property>
            <list-property name="resultSet">
                <structure>
                    <property name="position">1</property>
                    <property name="name">PRY_ID</property>
                    <property name="nativeName">PRY_ID</property>
                    <property name="dataType">decimal</property>
                </structure>
                <structure>
                    <property name="position">2</property>
                    <property name="name">NOMBREPROYECTO</property>
                    <property name="nativeName">NOMBREPROYECTO</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">3</property>
                    <property name="name">ESTADO</property>
                    <property name="nativeName">ESTADO</property>
                    <property name="dataType">string</property>
                </structure>
            </list-property>
            <property name="queryText">select p.pry_id, p.PRY_NOMBRE as nombreProyecto, ep.epr_nombre as estado
from HER_GRUPO_PROYECTO pg , HER_PROYECTO P left join her_estado_proyecto ep on ep.epr_id = p.epr_id
where
pg.GRU_ID = ?1
and pg.PRY_ID = p.PRY_ID
order by p.PRY_NOMBRE</property>
        </oda-data-set>
        <oda-data-set extensionID="org.eclipse.birt.report.data.oda.jdbc.JdbcSelectDataSet" name="laboratorios" id="14787">
            <structure name="cachedMetaData">
                <list-property name="resultSet">
                    <structure>
                        <property name="position">1</property>
                        <property name="name">NOMBRE</property>
                        <property name="dataType">string</property>
                    </structure>
                    <structure>
                        <property name="position">2</property>
                        <property name="name">LAB_EMAIL</property>
                        <property name="dataType">string</property>
                    </structure>
                    <structure>
                        <property name="position">3</property>
                        <property name="name">GRL_FECHA_BORRADO</property>
                        <property name="dataType">date-time</property>
                    </structure>
                    <structure>
                        <property name="position">4</property>
                        <property name="name">GRL_FECHA_REGISTRO</property>
                        <property name="dataType">date-time</property>
                    </structure>
                </list-property>
            </structure>
            <property name="dataSource">OrigenHermes</property>
            <list-property name="parameters">
                <structure>
                    <property name="name">gru</property>
                    <property name="paramName">id</property>
                    <property name="dataType">string</property>
                    <property name="position">1</property>
                    <property name="isInput">true</property>
                    <property name="isOutput">false</property>
                </structure>
            </list-property>
            <list-property name="resultSet">
                <structure>
                    <property name="position">1</property>
                    <property name="name">NOMBRE</property>
                    <property name="nativeName">NOMBRE</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">2</property>
                    <property name="name">LAB_EMAIL</property>
                    <property name="nativeName">LAB_EMAIL</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">3</property>
                    <property name="name">GRL_FECHA_BORRADO</property>
                    <property name="nativeName">GRL_FECHA_BORRADO</property>
                    <property name="dataType">date-time</property>
                </structure>
                <structure>
                    <property name="position">4</property>
                    <property name="name">GRL_FECHA_REGISTRO</property>
                    <property name="nativeName">GRL_FECHA_REGISTRO</property>
                    <property name="dataType">date-time</property>
                </structure>
            </list-property>
            <property name="queryText">SELECT 
	L.LAB_NOMBRE AS NOMBRE,
	L.LAB_EMAIL,
	gl.GRL_FECHA_BORRADO,
gl.GRL_FECHA_REGISTRO
FROM 
	HER_GRUPO_LABORATORIO GL, HER_LABORATORIO L
WHERE 
	GL.GRU_ID = ?
	AND GL.LAB_ID = L.LAB_ID
	ORDER BY L.LAB_NOMBRE ASC</property>
        </oda-data-set>
    </data-sets>

            <property name="queryText">select p.PER_NOMBRE1 ||' '|| p.PER_NOMBRE2 ||' '|| p.PER_APELLIDO1 ||' '|| p.PER_APELLIDO2 as integrante,
itg.IGT_NOMBRE as nombreTipo,
IG.HCI_FECHA_INGRESO,
IG.HCI_FECHA_RETIRO,
P.TDO_ID || ' - '||P.PER_ID AS DOC
from HER_HISTORICO_INTEGRANTES ig , HER_PERSONA p, HER_INVESTIGADOR_GRUPO_TIPO itg
where
ig.GRU_ID = ?
and ig.HCI_PER_ID = p.PER_ID
and ig.hci_TDO_ID = p.TDO_ID
and itg.IGT_ID = ig.ING_TIPO
order by itg.IGT_NOMBRE</property>

                    <property name="isOutput">false</property>
                </structure>
            </list-property>
            <list-property name="resultSet">
                <structure>
                    <property name="position">1</property>
                    <property name="name">FECHA</property>
                    <property name="nativeName">FECHA</property>
                    <property name="dataType">date-time</property>
                </structure>
                <structure>
                    <property name="position">2</property>
                    <property name="name">JUSTIFICACION</property>
                    <property name="nativeName">JUSTIFICACION</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">3</property>
                    <property name="name">ESTADOUN</property>
                    <property name="nativeName">ESTADOUN</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">4</property>
                    <property name="name">ESTADOCOLCIENCIAS</property>
                    <property name="nativeName">ESTADOCOLCIENCIAS</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">5</property>
                    <property name="name">Responsable</property>
                    <property name="nativeName">Responsable</property>
                    <property name="dataType">string</property>
                </structure>
            </list-property>
            <property name="queryText">SELECT 
HEG.HEG_FECHA AS FECHA,
HEG.HEG_JUSTIFICACION AS JUSTIFICACION,
eg.EGR_NOMBRE as estadoUN,
ec.egc_nombre as estadoColciencias,
per.per_nombre1 || decode(per.per_nombre2, NULL, ' ', ' ' || per.per_nombre2 || ' ') || per.per_apellido1 || decode(per.per_apellido2, NULL, '', ' ' || per.per_apellido2) "Responsable"
FROM 
HER_HISTORICO_ESTADO_GRUPO HEG
LEFT JOIN her_estado_grupo eg on eg.egr_id = heg.egr_id
left join her_estado_grupo_colciencias ec on ec.egc_id = heg.egc_id
LEFT JOIN HER_PERSONA per on per.per_id = HEG.HEG_PER_ID 
where HEG.GRU_id = ?
ORDER BY HEG_FECHA 
</property>
        </oda-data-set>

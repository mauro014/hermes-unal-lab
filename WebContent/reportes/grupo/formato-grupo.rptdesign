            <list-property name="resultSet">
                <structure>
                    <property name="position">1</property>
                    <property name="name">FECHA</property>
                    <property name="nativeName">FECHA</property>
                    <property name="dataType">date-time</property>
                </structure>
                <structure>
                    <property name="position">2</property>
                    <property name="name">Responsable</property>
                    <property name="nativeName">Responsable</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">3</property>
                    <property name="name">FORMULARIO</property>
                    <property name="nativeName">FORMULARIO</property>
                    <property name="dataType">string</property>
                </structure>
            </list-property>
            <property name="queryText">SELECT 
HEG.HFG_FECHA AS FECHA,
per.per_nombre1 || decode(per.per_nombre2, NULL, ' ', ' ' || per.per_nombre2 || ' ') || per.per_apellido1 || decode(per.per_apellido2, NULL, '', ' ' || per.per_apellido2) "Responsable",
DECODE(HFG_NUMERO,'1','Información General','2','Integrantes','3','Áreas y Líneas de Investigación','4','Información específica','Desconocido')formulario
FROM 
HER_HISTORICO_FORMULARIO_GRUPO HEG
LEFT JOIN HER_PERSONA per on per.per_id = HEG.HfG_PER_ID 
where HEG.GRU_id = ?
ORDER BY HfG_FECHA desc
</property>
        </oda-data-set>

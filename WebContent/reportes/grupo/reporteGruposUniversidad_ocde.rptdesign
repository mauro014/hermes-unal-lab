                    <property name="nativeName">ENLHERMES</property>
                    <property name="dataType">string</property>
                </structure>
            </list-property>
            <property name="queryText">SELECT DISTINCT
    g.gru_id AS idGrupo,
    CASE TO_CHAR(?) WHEN '1' THEN g.gru_nombre ELSE NULL END AS nombreGrupo,
    CASE TO_CHAR(?) WHEN '1' THEN (SELECT MAX(x.HEG_FECHA) FROM HER_HISTORICO_ESTADO_GRUPO x WHERE x.EGR_ID = 'A' AND x.GRU_ID = g.GRU_ID) ELSE NULL END AS FechaActivo,
    CASE TO_CHAR(?) WHEN '1' THEN (SELECT MAX(HFG_FECHA) FROM HER_HISTORICO_FORMULARIO_GRUPO hfg WHERE hfg.GRU_ID = g.GRU_ID) ELSE NULL END AS fechaMod,
    CASE TO_CHAR(?) WHEN '1' THEN g.GRU_COLCIENCIAS ELSE NULL END AS colciencias,
    CASE TO_CHAR(?) WHEN '1' THEN hgc.GRC_NOMBRE ELSE NULL END AS categoria,
    CASE TO_CHAR(?) WHEN '1' THEN eg.egr_nombre ELSE NULL END AS estadoGrupo,
    CASE TO_CHAR(?) WHEN '1' THEN ec.egc_nombre ELSE NULL END AS estadoCol,
    CASE TO_CHAR(?) WHEN '1' THEN s.sed_nombre ELSE NULL END AS sede,
    CASE TO_CHAR(?) WHEN '1' THEN d.dpn_nombre ELSE NULL END AS facultad,
    CASE TO_CHAR(?) WHEN '1' THEN g.gru_fcreacion ELSE NULL END AS fechaCreacion,
    CASE TO_CHAR(?) WHEN '1' THEN td.TDO_NOMBRE || ' - ' || per.PER_ID ELSE NULL END AS IDLider,
    CASE TO_CHAR(?) WHEN '1' THEN per.PER_NOMBRE1 || DECODE(per.PER_NOMBRE2, NULL, ' ', ' ' || per.PER_NOMBRE2 || ' ') || per.PER_APELLIDO1 || DECODE(per.PER_APELLIDO2, NULL, '', ' ' || per.PER_APELLIDO2) ELSE NULL END AS lider,
    CASE TO_CHAR(?) WHEN '1' THEN d2.dpn_nombre ELSE NULL END AS departamento,
    CASE TO_CHAR(?) WHEN '1' THEN g.GRU_EMAIL ELSE NULL END AS emailGrupo,
    CASE TO_CHAR(?) WHEN '1' THEN g.GRU_TELEFONO ELSE NULL END AS telefonoGrupo,
    CASE TO_CHAR(?) WHEN '1' THEN hdd.DOMDET_DESCRIPCION ELSE NULL END AS ods_PRINCIPAL,
    CASE TO_CHAR(?) WHEN '1' THEN hdd2.DOMDET_DESCRIPCION ELSE NULL END AS ods_SECUNDARIO,

    (SELECT DD_PADRE.DOMDET_DESCRIPCION
     FROM HER_DOMINIO_DETALLE DD, HER_GRUPO GA, HER_DOMINIO_DETALLE DD_PADRE
     WHERE GA.GRU_ID = g.gru_id AND GA.DOMDET_TIPO_SUBAREA = DD.DOMDET_TIPO 
     AND GA.DOM_ID_SUBAREA = DD.DOM_ID AND DD.DOMDET_ESTADO = DD_PADRE.DOMDET_TIPO) AS ocde,

    (SELECT DD.DOMDET_DESCRIPCION
     FROM HER_DOMINIO_DETALLE DD, HER_GRUPO GA
     WHERE GA.GRU_ID = g.gru_id AND GA.DOMDET_TIPO_SUBAREA = DD.DOMDET_TIPO 
     AND GA.DOM_ID_SUBAREA = DD.DOM_ID) AS subocde,

    -- CAMPOS DE ÁREA Y SUBÁREA SECUNDARIA
    DD_PADRE.DOMDET_DESCRIPCION AS area_secundaria,
    DD.DOMDET_DESCRIPCION AS subarea_secundaria,
    
   case to_char(?)
  		when '1' then DBMS_LOB.SUBSTR(g.gru_vision, 4000, 1)
	  	else null
	end enfoque,
	case to_char(?)
  		when '1' then g.GRU_NECESIDAD
	  	else null
	end necesidad,
	case to_char(?)
  		when '1' then g.GRU_PERTINENCIA
	  	else null
	end pertinencia,
	case to_char(?)
  		when '1' then decode(g.GRU_SIMILAR,'S','SI','NO')||' - '|| g.GRU_SIMILAR_EXP
	  	else null
	end grupoSimilar,
	case to_char(?)
  		when '1' then decode(g.GRU_AVAL,null,'NO','SI')
	  	else null
	end grupoAval,
	case to_char(?)
  		when '1' then DBMS_LOB.SUBSTR(g.GRU_PERSPECTIVA, 4000, 1)
	  	else null
	end perspectiva,
	case to_char(?)
  		when '1' then DBMS_LOB.SUBSTR(g.GRU_PRIORIDAD, 4000, 1)
	  	else null
	end prioridad,
	case to_char(?)
  		when '1' then decode(g.GRU_INTERFACULTADES,'S','SI','NO')
	  	else null
	end interfa,
	case to_char(?)
  		when '1' then decode(g.GRU_INTERINSTITUCION,'S','SI','NO')
	  	else null
	end interi,
	case to_char(?)
  		when '1' then decode(g.GRU_INTERSEDES,'S','SI','NO')
	  	else null
	end inters,
	case to_char(?)
  		when '1' then g.GRU_ENLACE_GRUPLAC
	  	else null
	end gruplac,
	case to_char(?)
  		when '1' then 'http://www.hermes.unal.edu.co/pages/Consultas/Grupo.jsf?idGrupo='||g.gru_id
	  	else null
	end enlhermes

FROM HER_GRUPO g
LEFT JOIN HER_ESTADO_GRUPO eg ON eg.egr_id = g.egr_id
LEFT JOIN HER_ESTADO_GRUPO_COLCIENCIAS ec ON ec.egc_id = g.egc_id
LEFT JOIN HER_GRUPO_CATEGORIA hgc ON g.GRU_CATEGORIA_COLCIENCIAS = hgc.GRC_ID
LEFT JOIN HER_DEPENDENCIA d ON d.dpn_id = g.dpn_id
LEFT JOIN HER_SEDE s ON d.sed_id = s.sed_id
LEFT JOIN HER_INVESTIGADOR_GRUPO ig ON g.gru_id = ig.GRU_ID AND ig.ING_TIPO = 'L'
LEFT JOIN HER_INVESTIGADOR_INTERNO ii ON ii.inv_id = ig.inv_id AND ii.tdo_id = ig.tdo_id
LEFT JOIN HER_PERSONA per ON per.per_id = ig.inv_id AND per.tdo_id = ig.tdo_id
LEFT JOIN HER_TIPO_DOCUMENTO td ON per.TDO_ID = td.TDO_ID
LEFT JOIN HER_DEPENDENCIA d2 ON ii.dpn_id = d2.dpn_id
LEFT JOIN HER_DOMINIO_DETALLE hdd ON hdd.DOMDET_TIPO = g.GRU_ODS_PRINCIPAL AND hdd.DOM_ID = 212
LEFT JOIN HER_DOMINIO_DETALLE hdd2 ON hdd2.DOMDET_TIPO = g.GRU_ODS_SECUNDARIO AND hdd2.DOM_ID = 212
LEFT JOIN HER_GRUPO_AREA_TEMATICA GAT ON GAT.GRU_ID = g.GRU_ID
LEFT JOIN HER_DOMINIO_DETALLE DD ON GAT.DOMDET_TIPO = DD.DOMDET_TIPO AND GAT.DOM_ID = DD.DOM_ID
LEFT JOIN HER_DOMINIO_DETALLE DD_PADRE ON DD.DOMDET_ESTADO = DD_PADRE.DOMDET_TIPO

WHERE g.egr_id IN (SELECT COLUMN_VALUE FROM TABLE(SPLIT(?1)))

ORDER BY idGrupo asc</property>
        </oda-data-set>
    </data-sets>

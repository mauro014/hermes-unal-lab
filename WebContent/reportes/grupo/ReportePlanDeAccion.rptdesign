            </list-property>
            <property name="queryText">SELECT ROWNUM Num,gru_id,GRO_AÑO, GRO_DESCRIPCION Obj, GRR_DESCRIPCION Res, GRM_DESCRIPCION Meta, GRA_DESCRIPCION Act
FROM 
HER_PLAN_ACCION_GRUPO  pg, HER_GRUPO_OBJETIVO GO, HER_GRUPO_RESULTADO Gr ,
HER_GRUPO_META gm, HER_GRUPO_ACTIVIDAD ga
WHERE pg.PLG_ID= GO.PLG_ID
AND GO.GRO_ID=gr.GRO_ID
AND gr.GRR_ID = gm.GRR_ID
AND gm.GRM_ID = ga.GRM_ID
AND gru_id = ?
AND gro_año = 1</property>
        </oda-data-set>

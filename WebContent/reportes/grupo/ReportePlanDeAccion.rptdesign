                </structure>
            </list-property>
            <list-property name="resultSet">
                <structure>
                    <property name="position">1</property>
                    <property name="name">GRU_ID</property>
                    <property name="nativeName">GRU_ID</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">2</property>
                    <property name="name">ING_ID</property>
                    <property name="nativeName">ING_ID</property>
                    <property name="dataType">decimal</property>
                </structure>
                <structure>
                    <property name="position">3</property>
                    <property name="name">INTEGRANTE</property>
                    <property name="nativeName">INTEGRANTE</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">4</property>
                    <property name="name">DPN_NOMBRE</property>
                    <property name="nativeName">DPN_NOMBRE</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">5</property>
                    <property name="name">ING_FUNCION</property>
                    <property name="nativeName">ING_FUNCION</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">6</property>
                    <property name="name">SED_NOMBRE</property>
                    <property name="nativeName">SED_NOMBRE</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">7</property>
                    <property name="name">INI_URL_WEB_DOCENTE</property>
                    <property name="nativeName">INI_URL_WEB_DOCENTE</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">8</property>
                    <property name="name">IGT</property>
                    <property name="nativeName">IGT</property>
                    <property name="dataType">string</property>
                </structure>
            </list-property>
            <property name="queryText">SELECT     G.GRU_ID, ing_id, 
PER.PER_APELLIDO1||' '||DECODE(PER.PER_APELLIDO2, PER.PER_APELLIDO2,PER.PER_APELLIDO2,NULL,' ')||' '||PER.PER_NOMBRE1||' '||DECODE(PER.PER_NOMBRE2, PER.PER_NOMBRE2,PER.PER_NOMBRE2,NULL,' ')Integrante,
    DPN_NOMBRE,ING_FUNCION,s.SED_NOMBRE ,INI_URL_WEB_DOCENTE, ING_TIPO IGT
FROM HER_GRUPO G  ,  HER_INVESTIGADOR_GRUPO IG,HER_INVESTIGADOR_INTERNO II,
HER_PERSONA PER,   HER_DEPENDENCIA D, HER_SEDE S
WHERE   
  G.GRU_ID = ?
AND g.gru_id = ig.gru_id 
AND PER.PER_ID = IG.INV_ID 
AND PER.PER_ID = ii.INV_ID 
 AND g.DPN_ID = D.DPN_ID
 AND s.SED_ID = SUBSTR(D.DPN_ID,1,1)
 order by igt desc</property>
        </oda-data-set>

            <property name="queryText">SELECT TRU_NOMBRE,GSG_CANTIDAD Cant, gsg_vigencia Año , GSG_VALOR Valor,GSG_DESCRIPCION Descr
FROM HER_GASTO_GRUPO GG, HER_FINANCIACION_GRUPO fG ,
HER_PLAN_ACCION_GRUPO PAG, HER_TIPO_RUBRO TR
WHERE  
PAG.PLG_ID=FG.PLG_ID AND
FG.FIG_ID = GG.FIG_ID AND
GG.TRU_ID= TR.TRU_ID AND
GRU_ID = ? 
order by gsg_vigencia</property>

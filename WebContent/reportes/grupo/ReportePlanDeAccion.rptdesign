                        <property name="position">2</property>
                        <property name="name">GRP_AÑO</property>
                        <property name="dataType">decimal</property>
                    </structure>
                </list-property>
            </structure>
            <property name="dataSource">Data Source</property>
            <list-property name="parameters">
                <structure>
                    <property name="name">param_1</property>
                    <property name="paramName">id</property>
                    <property name="dataType">string</property>
                    <property name="position">1</property>
                    <property name="isInput">true</property>
                    <property name="isOutput">false</property>
                </structure>
            </list-property>
            <list-property name="resultSet">
                <structure>
                    <property name="position">1</property>
                    <property name="name">PRD_NOMBRE</property>
                    <property name="nativeName">PRD_NOMBRE</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">2</property>
                    <property name="name">GRP_AÑO</property>
                    <property name="nativeName">GRP_AÑO</property>
                    <property name="dataType">decimal</property>
                </structure>
            </list-property>
            <property name="queryText">SELECT PRD_NOMBRE, GRP_AÑO
FROM HER_GRUPO_PRODUCTO gp, HER_PRODUCTO_TIPO pt,
HER_PLAN_ACCION_GRUPO pag
WHERE pag.GRU_ID = ?
 AND pag.PLG_ID = gp.PLG_ID
 AND gp.pRD_ID = pt.PRD_ID
 order by  GRP_AÑO</property>
        </oda-data-set>

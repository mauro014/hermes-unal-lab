                        <property name="position">7</property>
                        <property name="name">IGT</property>
                        <property name="dataType">string</property>
                    </structure>
                </list-property>
            </structure>
            <property name="dataSource">Data Source</property>
            <list-property name="parameters">
                <structure>
                    <property name="name">param_1</property>
                    <property name="paramName">id</property>
                    <property name="dataType">string</property>
                    <property name="position">1</property>
                    <property name="isInput">true</property>
                    <property name="isOutput">false</property>
                </structure>
            </list-property>
            <list-property name="resultSet">
                <structure>
                    <property name="position">1</property>
                    <property name="name">GRU_ID</property>
                    <property name="nativeName">GRU_ID</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">2</property>
                    <property name="name">ING_ID</property>
                    <property name="nativeName">ING_ID</property>
                    <property name="dataType">decimal</property>
                </structure>
                <structure>
                    <property name="position">3</property>
                    <property name="name">PER_ID</property>
                    <property name="nativeName">PER_ID</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">4</property>
                    <property name="name">EXTERNO</property>
                    <property name="nativeName">EXTERNO</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">5</property>
                    <property name="name">ING_FUNCION</property>
                    <property name="nativeName">ING_FUNCION</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">6</property>
                    <property name="name">INS_NOMBRE</property>
                    <property name="nativeName">INS_NOMBRE</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">7</property>
                    <property name="name">IGT</property>
                    <property name="nativeName">IGT</property>
                    <property name="dataType">string</property>
                </structure>
            </list-property>
            <property name="queryText">SELECT     G.GRU_ID, ing_id,  PER.PER_ID, 
PER.PER_NOMBRE1||' '||DECODE(PER.PER_NOMBRE2, PER.PER_NOMBRE2,PER.PER_NOMBRE2,NULL,' ')||' '||PER.PER_APELLIDO1||' '||DECODE(PER.PER_APELLIDO2, PER.PER_APELLIDO2,PER.PER_APELLIDO2,NULL,' ')Externo,
     ING_FUNCION,INS_NOMBRE , ING_TIPO IGT
FROM HER_GRUPO G  ,  HER_INVESTIGADOR_GRUPO IG,HER_INVESTIGADOR_EXTERNO ie,
HER_PERSONA PER,   HER_INSTITUCION i
WHERE   
  G.GRU_ID = ?
AND g.gru_id = ig.gru_id 
AND PER.PER_ID = IG.INV_ID 
AND PER.PER_ID = ie.INV_ID 
 AND i.INS_ID= ie.INS_ID
  ORDER BY igt</property>
        </oda-data-set>

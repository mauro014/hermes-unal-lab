            <property name="queryText">SELECT GRU_ID, EGR_ID, d.DPN_ID, GRU_NOMBRE, GRU_PRESENTACION, 
GRU_EMAIL, GRU_FCREACION, GRU_DIRECCION, GRU_TELEFONO, 
GRU_TEXTENSION, GRU_FAX, GRU_URL, GRU_COLCIENCIAS, 
GRU_CATEGORIA_COLCIENCIAS, GRU_HISTORIA, GRU_EXPERIENCIA, 
GRU_ANO_CLASIFICACION_COL, GRU_INDICE_SCIENTICOL, dpn_nombre
FROM HER_GRUPO g,HER_DEPENDENCIA d
WHERE gru_id = ?
AND g.DPN_ID=d.DPN_ID</property>
        </oda-data-set>

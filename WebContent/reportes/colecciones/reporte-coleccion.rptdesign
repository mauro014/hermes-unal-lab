                    </structure>
                </list-property>
            </structure>
            <property name="dataSource">Oracle</property>
            <list-property name="parameters">
                <structure>
                    <property name="name">col_id</property>
                    <property name="paramName">id</property>
                    <property name="dataType">string</property>
                    <property name="position">1</property>
                    <expression name="defaultValue">1</expression>
                    <property name="isInput">true</property>
                    <property name="isOutput">false</property>
                </structure>
            </list-property>
            <list-property name="resultSet">
                <structure>
                    <property name="position">1</property>
                    <property name="name">TIPONOMENC</property>
                    <property name="nativeName">TIPONOMENC</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">2</property>
                    <property name="name">CANTIDAD</property>
                    <property name="nativeName">CANTIDAD</property>
                    <property name="dataType">decimal</property>
                </structure>
                <structure>
                    <property name="position">3</property>
                    <property name="name">GRUPOBIO</property>
                    <property name="nativeName">GRUPOBIO</property>
                    <property name="dataType">string</property>
                </structure>
            </list-property>
            <property name="queryText">SELECT 
	dd.DOMDET_DESCRIPCION as tipoNomenc, cn.CON_CANTIDAD as cantidad, dd2.DOMDET_DESCRIPCION as grupoBio
FROM 
	HER_COLECCION_NOMENCLATURA cn left join HER_DOMINIO_DETALLE dd on (dd.DOM_ID='101' and dd.DOMDET_TIPO = cn.DOMDET_TIPO)
	left join HER_DOMINIO_DETALLE dd2 on (dd2.DOM_ID='111' and dd2.DOMDET_TIPO = cn.DOMDET_TIPO2)
WHERE 
	cn.COL_ID = ?
	</property>
        </oda-data-set>
        <oda-data-set extensionID="org.eclipse.birt.report.data.oda.jdbc.JdbcSelectDataSet" name="PersonalCol" id="3689">
            <structure name="cachedMetaData">
                <list-property name="resultSet">
                    <structure>
                        <property name="position">1</property>
                        <property name="name">PERSONA</property>
                        <property name="dataType">string</property>
                    </structure>
                    <structure>
                        <property name="position">2</property>
                        <property name="name">TIPO</property>
                        <property name="dataType">string</property>
                    </structure>
                    <structure>
                        <property name="position">3</property>
                        <property name="name">COP_ESPECIALIDAD_CURADOR</property>
                        <property name="dataType">string</property>
                    </structure>
                    <structure>
                        <property name="position">4</property>
                        <property name="name">COP_PERFIL_LINEA</property>
                        <property name="dataType">string</property>
                    </structure>
                    <structure>
                        <property name="position">5</property>
                        <property name="name">GRUPO_SUBGRUPO</property>
                        <property name="dataType">string</property>
                    </structure>
                </list-property>
            </structure>
            <property name="dataSource">Oracle</property>
            <list-property name="parameters">
                <structure>
                    <property name="name">col_id</property>
                    <property name="paramName">id</property>
                    <property name="dataType">string</property>
                    <property name="position">1</property>
                    <expression name="defaultValue">1</expression>
                    <property name="isInput">true</property>
                    <property name="isOutput">false</property>
                </structure>
            </list-property>
            <list-property name="resultSet">
                <structure>
                    <property name="position">1</property>
                    <property name="name">PERSONA</property>
                    <property name="nativeName">PERSONA</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">2</property>
                    <property name="name">TIPO</property>
                    <property name="nativeName">TIPO</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">3</property>
                    <property name="name">COP_ESPECIALIDAD_CURADOR</property>
                    <property name="nativeName">COP_ESPECIALIDAD_CURADOR</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">4</property>
                    <property name="name">COP_PERFIL_LINEA</property>
                    <property name="nativeName">COP_PERFIL_LINEA</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">5</property>
                    <property name="name">GRUPO_SUBGRUPO</property>
                    <property name="nativeName">GRUPO_SUBGRUPO</property>
                    <property name="dataType">string</property>
                </structure>
            </list-property>
            <property name="queryText">SELECT p.PER_NOMBRE1||' '||DECODE(p.PER_NOMBRE2, p.PER_NOMBRE2,p.PER_NOMBRE2,NULL,' ')||' '||p.PER_APELLIDO1||' '||DECODE(p.PER_APELLIDO2, p.PER_APELLIDO2,p.PER_APELLIDO2,NULL,' ') persona,
 decode(cp.COP_TIPO, 'A', 'Administrativo(a)','EST','Estudiante','EXT','Externo','I','Investigador(a)','CU','Director(a)','CU1','Director(a) principal,''') as tipo,
 cp.COP_ESPECIALIDAD_CURADOR, cp.COP_PERFIL_LINEA, DD.DOMDET_DESCRIPCION ||' / '|| D2.DOMDET_DESCRIPCION AS GRUPO_SUBGRUPO
 
FROM 
	HER_COLECCION_PERSONA cp left join HER_PERSONA p on (cp.PER_ID = p.PER_ID and cp.TDO_ID = p.TDO_ID) left join HER_DOMINIO_DETALLE DD ON 
	DD.DOM_ID = CP.DOM_ID AND DD.DOMDET_TIPO = CP.DOMDET_TIPO left join HER_DOMINIO_DETALLE D2 ON D2.DOM_ID = DD.DOM_ID AND D2.DOMDET_TIPO = DD.DOMDET_ESTADO
WHERE 
	cp.COL_ID = ?
	order by cp.COP_TIPO desc</property>
        </oda-data-set>
        <oda-data-set extensionID="org.eclipse.birt.report.data.oda.jdbc.JdbcSelectDataSet" name="tipoObjetos" id="10265">
            <structure name="cachedMetaData">
                <list-property name="resultSet">
                    <structure>
                        <property name="position">1</property>
                        <property name="name">TIPO</property>

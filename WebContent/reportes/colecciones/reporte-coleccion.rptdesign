                    <property name="name">TIPOPRE</property>
                    <property name="nativeName">TIPOPRE</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">2</property>
                    <property name="name">DESCRIPCION</property>
                    <property name="nativeName">DESCRIPCION</property>
                    <property name="dataType">string</property>
                </structure>
            </list-property>
            <property name="queryText">SELECT 
	dd.DOMDET_DESCRIPCION as tipoPre, ctp.COP_COBERTURA as descripcion
FROM 
	HER_COLECCION_TIPO_PRE ctp left join HER_DOMINIO_DETALLE dd on (dd.DOM_ID='100' and dd.DOMDET_TIPO = ctp.DOMDET_TIPO)
WHERE 
	ctp.COL_ID = ?
	</property>
        </oda-data-set>
        <oda-data-set extensionID="org.eclipse.birt.report.data.oda.jdbc.JdbcSelectDataSet" name="EjemplaresTipo" id="3666">
            <structure name="cachedMetaData">
                <list-property name="resultSet">

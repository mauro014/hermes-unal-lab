            <property name="queryText">SELECT 
	distinct col.COL_ID, col.COL_ACRONIMO, col.COL_FECHA_FUNDACION, col.COL_NOMBRE, col.COL_DESCRIPCION, s.sed_nombre as sede, dd.DOMDET_DESCRIPCION as tipoColeccion,
	d.DPN_NOMBRE as dependencia, c.CIU_NOMBRE as nombreCiudad, col.COL_EMAIL, col.COL_TELEFONO, col.COL_DIR_CORRESPONDENCIA, col.COL_INFRAESTRUCTURA,
	p.PER_NOMBRE1||' '||DECODE(p.PER_NOMBRE2, p.PER_NOMBRE2,p.PER_NOMBRE2,NULL,' ')||' '||p.PER_APELLIDO1||' '||DECODE(p.PER_APELLIDO2, p.PER_APELLIDO2,p.PER_APELLIDO2,NULL,' ') curador,
	col.COL_BASE_DATOS, col.COL_COBERTURA_TAXONOMICA, col.COL_COBERTURA_GEOGRAFICA, col.COL_COBERTURA_TEMPORAL, col.COL_FECHA_ACTUALIZACION, d2.dpn_nombre as uab, col.COL_SISTEMATIZACION_PUB as sistematizacion,
	col.COL_EJEMPLARES_GEO || '%' as georref, col.COL_ACTO_ADM as web, col.COL_FEC_REGISTRO_HUMBOLDT as fechaRNC, col.COL_PROXIMO_REG_RNC as proximaAct,
	COL_EJEMPLARES_GEO_NO_BIO,
COL_SISTEMATIZACION_PUB_NO_BIO,
COL_TIPO_ACTO_CREACION || ' #'||COL_NUM_ACTO_CREACION||' de '||COL_FECHA_ACTO_CREACION as acto_creacion
FROM HER_COLECCION col left join HER_SEDE s on s.SED_ID = col.SED_ID left join HER_DOMINIO_DETALLE dd on (col.COL_TIPO = dd.DOMDET_TIPO and dd.DOM_ID = '99')
	left join HER_DEPENDENCIA d on d.DPN_ID = col.DPN_ID left join HER_CIUDAD c on col.CIU_ID = c.CIU_ID left join HER_DEPENDENCIA d2 on d2.dpn_id = col.COL_UAB,
	her_coleccion_persona cp, HER_PERSONA p
WHERE 
	col.COL_ESTADO not in ('B')
	and col.COL_ID = ?
	and cp.col_id = col.col_id
	and cp.PER_ID = p.PER_ID and cp.TDO_ID = p.TDO_ID and cp.cop_tipo = 'CU1' 
order by col.COL_ID asc</property>
        </oda-data-set>

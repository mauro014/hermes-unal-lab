            </list-property>
            <list-property name="resultSet">
                <structure>
                    <property name="position">1</property>
                    <property name="name">ESTADO</property>
                    <property name="nativeName">ESTADO</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">2</property>
                    <property name="name">COA_FECHA</property>
                    <property name="nativeName">COA_FECHA</property>
                    <property name="dataType">date-time</property>
                </structure>
                <structure>
                    <property name="position">3</property>
                    <property name="name">COA_NRO_REGISTRO</property>
                    <property name="nativeName">COA_NRO_REGISTRO</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">4</property>
                    <property name="name">FFI_DESCRIPCION</property>
                    <property name="nativeName">FFI_DESCRIPCION</property>
                    <property name="dataType">string</property>
                </structure>
            </list-property>
            <property name="queryText">SELECT DD.DOMDET_DESCRIPCION AS ESTADO,
COA_FECHA,
COA_NRO_REGISTRO,
ff.ffi_descripcion

FROM 
	HER_COLECCION_AUTORIDAD cA 
	LEFT JOIN HER_FUENTE_FINANCIACION FF ON FF.FFI_ID = CA.FFI_ID
	left join HER_DOMINIO_DETALLE DD ON 
	DD.DOM_ID = CA.DOM_ID AND DD.DOMDET_TIPO = CA.DOMDET_TIPO left join HER_DOMINIO_DETALLE D2 ON D2.DOM_ID = DD.DOM_ID AND D2.DOMDET_TIPO = DD.DOMDET_ESTADO
WHERE 
	cA.COL_ID = ?
	order by FF.ffi_DESCRIPCION desc</property>
        </oda-data-set>
        <oda-data-set extensionID="org.eclipse.birt.report.data.oda.jdbc.JdbcSelectDataSet" name="tipoObjetos" id="10283">
            <structure name="cachedMetaData">
                <list-property name="resultSet">
                    <structure>
                        <property name="position">1</property>
                        <property name="name">TIPO</property>

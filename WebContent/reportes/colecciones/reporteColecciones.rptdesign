                <structure>
                    <property name="position">1</property>
                    <property name="name">TIPO</property>
                    <property name="nativeName">TIPO</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">2</property>
                    <property name="name">SUBTIPO</property>
                    <property name="nativeName">SUBTIPO</property>
                    <property name="dataType">string</property>
                </structure>
            </list-property>
            <property name="queryText">SELECT  DD.DOMDET_DESCRIPCION AS TIPO,
D2.DOMDET_DESCRIPCION AS SUBTIPO
 
FROM 
	HER_COLECCION_TIPO_OBJETO tob left join HER_DOMINIO_DETALLE DD ON 
	DD.DOM_ID = TOB.DOM_ID AND DD.DOMDET_TIPO = TOB.DOMDET_TIPO left join HER_DOMINIO_DETALLE D2 ON D2.DOM_ID = TOB.DOM_ID_SUBTIPO AND D2.DOMDET_TIPO = TOB.DOMDET_TIPO_SUBTIPO
WHERE 
	TOB.COL_ID = ?
	order by DD.DOMDET_DESCRIPCION ASC</property>
        </oda-data-set>

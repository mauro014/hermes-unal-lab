                    </structure>
                    <structure>
                        <property name="position">3</property>
                        <property name="name">DOCUMENTO</property>
                        <property name="dataType">string</property>
                    </structure>
                </list-property>
            </structure>
            <property name="dataSource">Produccion</property>
            <list-property name="parameters">
                <structure>
                    <property name="name">col_id</property>
                    <property name="dataType">integer</property>
                    <property name="position">1</property>
                    <expression name="defaultValue">1</expression>
                    <property name="isInput">true</property>
                    <property name="isOutput">false</property>
                </structure>
            </list-property>
            <list-property name="resultSet">
                <structure>
                    <property name="position">1</property>
                    <property name="name">PERSONA</property>
                    <property name="nativeName">PERSONA</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">2</property>
                    <property name="name">TIPO</property>
                    <property name="nativeName">TIPO</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">3</property>
                    <property name="name">DOCUMENTO</property>
                    <property name="nativeName">DOCUMENTO</property>
                    <property name="dataType">string</property>
                </structure>
            </list-property>
            <property name="queryText">SELECT p.PER_NOMBRE1||' '||DECODE(p.PER_NOMBRE2, p.PER_NOMBRE2,p.PER_NOMBRE2,NULL,' ')||' '||p.PER_APELLIDO1||' '||DECODE(p.PER_APELLIDO2, p.PER_APELLIDO2,p.PER_APELLIDO2,NULL,' ') persona,
 decode(cp.COP_TIPO, 'A', 'Administrativo','EST','Estudiante','EXT','Externo','I','Investigador','CU','Curador','') as tipo,
 p.tdo_id ||'-'||p.per_id as documento
FROM 
	HER_COLECCION_PERSONA cp left join HER_PERSONA p on (cp.PER_ID = p.PER_ID and cp.TDO_ID = p.TDO_ID) 
WHERE 
	cp.COL_ID = ? and cp.cop_tipo != 'CU1'
	order by cp.COP_TIPO desc</property>
        </oda-data-set>
        <oda-data-set extensionID="org.eclipse.birt.report.data.oda.jdbc.JdbcSelectDataSet" name="autoridad" id="10266">

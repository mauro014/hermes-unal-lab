                </structure>
            </list-property>
            <property name="queryText">SELECT 
	dd.DOMDET_DESCRIPCION as tipoNomenc, cn.CON_CANTIDAD as cantidad, dd2.DOMDET_DESCRIPCION as grupoBio
FROM 
	HER_COLECCION_NOMENCLATURA cn left join HER_DOMINIO_DETALLE dd on (dd.DOM_ID='101' and dd.DOMDET_TIPO = cn.DOMDET_TIPO)
	left join HER_DOMINIO_DETALLE dd2 on (dd2.DOM_ID='111' and dd2.DOMDET_TIPO = cn.DOMDET_TIPO2)
WHERE 
	cn.COL_ID = ?
	</property>
        </oda-data-set>
        <oda-data-set extensionID="org.eclipse.birt.report.data.oda.jdbc.JdbcSelectDataSet" name="PersonalCol" id="3689">
            <structure name="cachedMetaData">
                <list-property name="resultSet">
                    <structure>
                        <property name="position">1</property>
                        <property name="name">PERSONA</property>
                        <property name="dataType">string</property>
                    </structure>
                    <structure>
                        <property name="position">2</property>
                        <property name="name">TIPO</property>

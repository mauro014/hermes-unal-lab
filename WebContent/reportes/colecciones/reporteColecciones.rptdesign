                </structure>
                <structure>
                    <property name="position">11</property>
                    <property name="name">UND_NOBIO</property>
                    <property name="nativeName">UND_NOBIO</property>
                    <property name="dataType">string</property>
                </structure>
            </list-property>
            <property name="queryText">SELECT 	
	decode(dd.DOMDET_DESCRIPCION,null,COC_SUBGRUPO_NO_BIO,dd.DOMDET_DESCRIPCION) as subgrupo, 
	decode(dd2.DOMDET_DESCRIPCION,null,COC_GRUPO_NO_BIOLOGICO,dd2.DOMDET_DESCRIPCION) as grupoBio, 
	decode(cc.COC_EJEMPLARES,0, COC_EJEMPLARES_NO_BIO,cc.COC_EJEMPLARES) ejemplares,
	cc.COC_EJEM_IDENTORDEN, 
	cc.COC_EJEM_CATALOG,
	cc.COC_EJEM_IDENTFAMILIA, 
	cc.COC_EJEM_IDENTGENERO, 
	cc.COC_EJEM_IDENTESPECIE, 
	cc.COC_EJEM_SIST, 
	cc.COC_EJEM_FILUM,
	decode(cc.COC_UNIDAD_MEDIDA_NO_BIO,null,'No aplica',COC_UNIDAD_MEDIDA_NO_BIO) as und_nobio
	
FROM 
	HER_COLECCION_CATALOGACION cc left join HER_DOMINIO_DETALLE dd on (dd.DOM_ID='111' and dd.DOMDET_TIPO = cc.DOMDET_TIPO_SUBG)
	left join HER_DOMINIO_DETALLE dd2 on (dd2.DOM_ID='111' and dd2.DOMDET_TIPO = cc.DOMDET_TIPO)
WHERE 
	cc.COL_ID = ?
	</property>
        </oda-data-set>
        <oda-data-set extensionID="org.eclipse.birt.report.data.oda.jdbc.JdbcSelectDataSet" name="EjemplaresTipo" id="3666">
            <structure name="cachedMetaData">

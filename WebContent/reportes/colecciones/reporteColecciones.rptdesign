                </structure>
            </list-property>
            <property name="queryText">SELECT 
	dd.DOMDET_DESCRIPCION as tipoPre, ctp.COP_COBERTURA as descripcion
FROM 
	HER_COLECCION_TIPO_PRE ctp left join HER_DOMINIO_DETALLE dd on (dd.DOM_ID='100' and dd.DOMDET_TIPO = ctp.DOMDET_TIPO)
WHERE 
	ctp.COL_ID = ?
	</property>
        </oda-data-set>

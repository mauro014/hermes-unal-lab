            <property name="queryText">SELECT
	DISTINCT
	CASE
		to_char(?)
  	WHEN '1' THEN p.PRY_ID
		ELSE NULL
	END PRY_ID,
	CASE
		to_char(?)
  	WHEN '1' THEN p.PRY_CODIGO_QUIPU
		ELSE NULL
	END PRY_CODIGO_QUIPU,
	CASE
		to_char(?)
  	WHEN '1' THEN decode(dd.DOMDET_DESCRIPCION, NULL, 'Proyecto - Convocatoria Interna', dd.DOMDET_DESCRIPCION)
		ELSE NULL
	END TIPO,
	CASE
		to_char(?)
  	WHEN '1' THEN p.pry_nombre
		ELSE NULL
	END pry_nombre,
	CASE
		to_char(?)
  	WHEN '1' THEN ep.EPR_NOMBRE
		ELSE NULL
	END estado,
	CASE
		to_char(?)
  	WHEN '1' THEN nvl(dle.DPN_NOMBRE, p.PRY_LUGAR)
		ELSE NULL
	END lugEjec,
	CASE
		to_char(?)
  	WHEN '1' THEN per.PER_NOMBRE1 || decode(per.PER_NOMBRE2, NULL, ' ', ' ' || per.PER_NOMBRE2 || ' ')|| per.PER_APELLIDO1 || decode(per.PER_APELLIDO2, NULL, '', ' ' || per.PER_APELLIDO2)
		ELSE NULL
	END invetigadorPpal,
	CASE
		to_char(?)
  	WHEN '1' THEN sed.sed_nombre
		ELSE NULL
	END sed_nombre,
	CASE
		to_char(?)
  	WHEN '1' THEN d2.dpn_nombre
		ELSE NULL
	END facultad,
	CASE
		to_char(?)
  	WHEN '1' THEN p.PRY_FECHA_TENTATIVA_INICIO
		ELSE NULL
	END PRY_FECHA_TENTATIVA_INICIO,
	CASE
		to_char(?)
  	WHEN '1' THEN decode(p.PRY_TIPO_FECHA_INICIO, '1', 'Desembolso de recursos', '2', 'Acta de inicio', '3', 'Legalización o suscripción del contrato', '4', 'Otro', '')
		ELSE NULL
	END PRY_TIPO_FECHA_INICIO,
	CASE
		to_char(?)
  	WHEN '1' THEN add_months(p.PRY_FECHA_TENTATIVA_INICIO, decode(p.PRY_DURACION_ACUMULADA, NULL, 0, p.PRY_DURACION_ACUMULADA)) + decode(p.PRY_DURACION_DIAS_ACUMULADA, NULL, 0, p.PRY_DURACION_DIAS_ACUMULADA)
		ELSE NULL
	END FFinal,
	CASE
		to_char(?)
  	WHEN '1' THEN p.PRY_ACTO_ADM_EXTERNO
		ELSE NULL
	END PRY_ACTO_ADM_EXTERNO,
	CASE
		to_char(?)
  	WHEN '1' THEN p.PRY_ACT_NOMBRE
		ELSE NULL
	END PRY_ACT_NOMBRE,
	CASE
		to_char(?)
  	WHEN '1' THEN DPN_EJEC.DPN_NOMBRE
		ELSE NULL
	END PRY_UNIDAD_EJECUTORA,
	CASE
		to_char(?)
  	WHEN '1' THEN p.PRY_EMPRESA_EJECUTORA
		ELSE NULL
	END PRY_EMPRESA_EJECUTORA,
	CASE
		to_char(?)
  	WHEN '1' THEN p.PRY_CONT_EFECT_FINAL_UN
		ELSE NULL
	END PRY_CONT_EFECT_FINAL_UN,
	CASE
		to_char(?)
  	WHEN '1' THEN p.PRY_CONT_ESPEC_FINAL_UN
		ELSE NULL
	END PRY_CONT_ESPEC_FINAL_UN,
	CASE
		to_char(?)
  	WHEN '1' THEN FF.FFI_DESCRIPCION
		ELSE NULL
	END S_CNV_SUPERVISOR_ENTIDAD,
	CASE
		to_char(?)
  	WHEN '1' THEN c.CNV_SUPERVISOR_EXT
		ELSE NULL
	END S_CNV_SUPERVISOR_EXT,
	CASE
		to_char(?)
  	WHEN '1' THEN c.CNV_SUPERVISOR_EXT_CARGO
		ELSE NULL
	END S_CNV_SUPERVISOR_EXT_CARGO,
	CASE
		to_char(?)
  	WHEN '1' THEN c.CNV_ASISTENTE_PRY
		ELSE NULL
	END ASIS_NOMBRE,
	CASE
		to_char(?)
  	WHEN '1' THEN c.CNV_CARGO_ASISTENTE
		ELSE NULL
	END ASIS_CARGO,
	CASE
		to_char(?)
  	WHEN '1' THEN decode(c.CNV_ASISTENTE_EXTENSION, NULL, '',('Ext. ' || c.CNV_ASISTENTE_EXTENSION))
		ELSE NULL
	END ASIS_CONTACTO,
	CASE
		to_char(?)
  	WHEN '1' THEN a.AVI_REGION
		ELSE NULL
	END AVI_REGION,
	CASE
		to_char(?)
  	WHEN '1' THEN a.AVI_FASE
		ELSE NULL
	END AVI_FASE,
	CASE
		to_char(?) WHEN '1' THEN ods.val_nombre_valor
		ELSE NULL
	END "ODS Principal",
	a.AVI_ENTIDAD AVI_ENTIDAD
FROM
	HER_PROYECTO p
LEFT JOIN HER_DOMINIO_DETALLE dd ON
	p.PRY_TIPO_ACTIVIDAD = dd.DOMDET_TIPO
	AND dd.DOM_ID = '59'
LEFT JOIN HER_ESTADO_PROYECTO ep ON
	p.EPR_ID = ep.EPR_ID
LEFT JOIN HER_DEPENDENCIA dle ON
	p.PRY_LUGAR = dle.DPN_ID
LEFT JOIN (
	SELECT
		HER_AVAL.PRY_ID,
		HER_AVAL.AVI_ID,
		FF.FFI_DESCRIPCION AS AVI_ENTIDAD,
		AVI_FASE,
		decode(CE.CEX_ID, NULL, HER_AVAL.AVI_CONVOCATORIA, CE.CEX_NOMBRE)convocatoria,
		decode(GRU_ID, NULL, AVI_NOMBRE_GRUPO_PINV, '0', 'Sin selección de grupo para el aval', GRU_NOMBRE) AS AVI_GRUPO_INVEST,
		DD.DOMDET_DESCRIPCION AS AVI_REGION
	FROM
		HER_AVAL
	LEFT JOIN HER_CONVOCATORIA_EXTERNA ce ON
		TO_CHAR(ce.CEX_ID) = HER_AVAL.AVI_CONVOCATORIA
	LEFT JOIN HER_GRUPO ON
		AVI_NOMBRE_GRUPO_PINV = GRU_ID
	LEFT JOIN HER_MONTO_AVAL MA ON
		MA.AVI_ID = HER_AVAL.AVI_ID
	LEFT JOIN HER_DOMINIO_DETALLE DD ON
		MA.MAV_REGION = DD.DOMDET_TIPO
	LEFT JOIN HER_FUENTE_FINANCIACION FF ON
		FF.FFI_ID = AVI_ENTIDAD
	WHERE
		HER_AVAL.AVI_AVALDIRECCION = 'S'
		AND her_aval.avi_estado &lt;> 'B'
		AND HER_AVAL.AVI_TIPO IN ('PINV', 'SR')) a ON
	a.PRY_ID = p.PRY_ID
LEFT JOIN HER_CONVENIO c ON
	c.PRY_ID = p.PRY_ID
LEFT JOIN HER_FUENTE_FINANCIACION ff ON
	c.CNV_SUPERVISOR_ENTIDAD = ff.FFI_ID
LEFT JOIN (
	SELECT
		HER_INVESTIGADOR_PROYECTO.*,
		ROW_NUMBER() OVER (PARTITION BY HER_INVESTIGADOR_PROYECTO.PRY_ID
	ORDER BY
		HER_INVESTIGADOR_PROYECTO.INP_ID DESC) x
	FROM
		HER_INVESTIGADOR_PROYECTO
	WHERE
		HER_INVESTIGADOR_PROYECTO.INP_TIPO = 'P') ip ON
	p.PRY_ID = ip.PRY_ID
	AND ip.X = 1
LEFT JOIN HER_PERSONA per ON
	per.TDO_ID = ip.TDO_ID
	AND ip.INV_ID = per.PER_ID
LEFT JOIN HER_INVESTIGADOR_INTERNO ii ON
	ip.inv_id = ii.inv_id
	AND ip.tdo_id = ii.tdo_id
LEFT JOIN HER_DEPENDENCIA d ON
	ii.dpn_id = d.dpn_id
LEFT JOIN HER_SEDE sed ON
	d.sed_id = sed.sed_id
LEFT JOIN HER_DEPENDENCIA d2 ON
	d.dpn_facultad = d2.dpn_id
LEFT JOIN HER_DEPENDENCIA DPN_EJEC ON
	P.PRY_UNIDAD_EJECUTORA = DPN_EJEC.DPN_ID
LEFT JOIN her_proyecto_listas_val ods ON
	p.pry_id = ods.pry_id
	AND ods.val_tipo = 'OBJETIVOS_DESARROLLO_SOSTENIBLE'
	AND ods.val_descripcion = 'OBJETIVO_DESARROLLO_SOSTENIBLE_PRINCIPAL'
WHERE 
	p.MOD_ID IN (10)
	AND ep.epr_id NOT IN ('BS', 'B', 'PB')
	AND per.PER_ID NOT IN ('52015719', '52585723', '52116940', '1023876575', '1032380386', '1053799116', '19380666', '52205496', '41654902', '1022389470')
	AND (p.PRY_FECHA_LEGALIZAC IS NOT NULL
		AND (p.PRY_FECHA_LEGALIZAC BETWEEN ? AND ?))
	AND d.sed_id IN (
	SELECT
		COLUMN_VALUE
	FROM
		TABLE(SPLIT(?)))
	AND (?= 'ALL'
		OR ii.dpn_id IN (
		SELECT
			COLUMN_VALUE
		FROM
			TABLE(SPLIT(?))))
ORDER BY
	PRY_ID,
	AVI_ENTIDAD</property>
        </oda-data-set>
        <oda-data-set extensionID="org.eclipse.birt.report.data.oda.jdbc.JdbcSelectDataSet" name="12_ReporteEST" id="13040">

            <property name="queryText">SELECT sum(valorEfectivoUN)+sum(valorEspecieUN) as valorExterno FROM (
	SELECT 
		decode(sum(f.FIN_VALOR), NULL, 0, sum(f.FIN_VALOR)) as valorEfectivoUN,
		decode(sum(f.FFE_VALOR_ESPECIE), NULL, 0, sum(f.FFE_VALOR_ESPECIE))  valorEspecieUN
	FROM 
		HER_FINANCIACION f, HER_FUENTE_FINANCIACION ff 
	WHERE 
		f.PRY_ID = ?
		and f.FFI_ID = ff.FFI_ID
		and ff.FFI_INTERNA_EXTERNA in ('E','O')
	) </property>
        </oda-data-set>

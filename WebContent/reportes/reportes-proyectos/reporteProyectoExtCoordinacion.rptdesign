            <property name="dataSource">Produccion</property>
            <list-property name="parameters">
                <structure>
                    <property name="name">pry_id</property>
                    <property name="dataType">integer</property>
                    <property name="position">1</property>
                    <expression name="defaultValue">37129</expression>
                    <property name="isInput">true</property>
                    <property name="isOutput">false</property>
                </structure>
            </list-property>
            <list-property name="resultSet">
                <structure>
                    <property name="position">1</property>
                    <property name="name">FIN_ID</property>
                    <property name="nativeName">FIN_ID</property>
                    <property name="dataType">decimal</property>
                </structure>
                <structure>
                    <property name="position">2</property>
                    <property name="name">ENTIDAD</property>
                    <property name="nativeName">ENTIDAD</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">3</property>
                    <property name="name">GST_VALOR</property>
                    <property name="nativeName">GST_VALOR</property>
                    <property name="dataType">decimal</property>
                </structure>
                <structure>
                    <property name="position">4</property>
                    <property name="name">GST_FECHA_DESEMBOLSO</property>
                    <property name="nativeName">GST_FECHA_DESEMBOLSO</property>
                    <property name="dataType">date-time</property>
                </structure>
                <structure>
                    <property name="position">5</property>
                    <property name="name">GST_FECHA_REAL_DESEMBOLSO</property>
                    <property name="nativeName">GST_FECHA_REAL_DESEMBOLSO</property>
                    <property name="dataType">date-time</property>
                </structure>
            </list-property>
            <property name="queryText">SELECT
	f.fin_id,
	ff.FFI_DESCRIPCION entidad,
	gst_VALOR,
	GST_FECHA_DESEMBOLSO,
	gst.GST_FECHA_REAL_DESEMBOLSO
FROM
	her_financiacion f,
	her_gasto gst,
	her_fuente_financiacion ff
WHERE
	f.PRY_ID = ?
	AND f.FFI_ID = ff.FFI_ID
	AND gst.fin_id = f.fin_id
	AND gst.tru_id = '170'</property>
        </oda-data-set>

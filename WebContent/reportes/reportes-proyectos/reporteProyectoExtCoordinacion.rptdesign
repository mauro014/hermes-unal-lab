            <property name="queryText">SELECT
	CNV_NOMBRE
	,CNV_NUM_CONTRATO
	,CNV_FECHA_INICIO
	,CNV_VIGENCIA_LEG AS CNV_VIGENCIA
	,CNV_FECHA_FIN
	,CNV_VALOR_TOTAL
	,CNV_VALOR_EFECTIVO
	,CNV_VALOR_ESPECIE
	,CNV_MONTO_EJECUTAR_UN
	,CNV_VALOR_EJECUCION_UN
	,CNV_COD_ENT_EXTERNA
	,FF.FFI_DESCRIPCION AS CNV_SUPERVISOR_ENTIDAD
	,CNV_SUPERVISOR_EXT
	,CNV_SUPERVISOR_EXT_CARGO
	,CNV_ASISTENTE_PRY
	,CNV_CARGO_ASISTENTE
	,('Ext. ' || CNV_ASISTENTE_EXTENSION)CNV_ASISTENTE_EXTENSION
FROM
	HER_CONVENIO
LEFT JOIN HER_FUENTE_FINANCIACION FF ON
	CNV_SUPERVISOR_ENTIDAD = FF.FFI_ID
WHERE
	PRY_ID = ?</property>
        </oda-data-set>
        <oda-data-set extensionID="org.eclipse.birt.report.data.oda.jdbc.JdbcSelectDataSet" name="Desembolso" id="10237">
            <structure name="cachedMetaData">
                <list-property name="resultSet">
                    <structure>

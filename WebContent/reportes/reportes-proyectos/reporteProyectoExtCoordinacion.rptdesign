            <property name="queryText">SELECT 
    DISTINCT p.pry_id, p.pry_nombre, p.PRY_CODIGO_QUIPU, d2.dpn_nombre as facultad, ep.EPR_NOMBRE as estado, d.dpn_nombre as unidad,
    sed.sed_nombre, c.CON_TITULO as modalidad, p.PRY_FECHA_TENTATIVA_INICIO,
    DPN_EJEC.DPN_NOMBRE AS PRY_UNIDAD_EJECUTORA, PRY_EMPRESA_EJECUTORA, DD_CYT.DOMDET_DESCRIPCION AS PRY_PROGRAMA_CYT, 
    PRY_ACTO_ADM_EXTERNO, PRY_ACT_NOMBRE, decode(PRY_TIPO_FECHA_INICIO,'1','Desembolso de recursos','2','Acta de inicio','3','Legalización o suscripción del contrato','4','Otro','')PRY_TIPO_FECHA_INICIO, 
    PRY_FECHA_FINAL, PRY_CONT_EFECT_FINAL_UN, PRY_CONT_ESPEC_FINAL_UN, 
    decode(dd.DOMDET_DESCRIPCION, NULL, 'Proyecto - Convocatoria Interna', dd.DOMDET_DESCRIPCION) as tipo,
    p.PER_NOMBRE1||' '||DECODE(p.PER_NOMBRE2, p.PER_NOMBRE2,p.PER_NOMBRE2,NULL,' ')||' '||p.PER_APELLIDO1||' '||DECODE(p.PER_APELLIDO2, 
  p.PER_APELLIDO2,p.PER_APELLIDO2,NULL,' ') invetigadorPpal,
    pseg.PER_NOMBRE1||' '||DECODE(pseg.PER_NOMBRE2, pseg.PER_NOMBRE2,pseg.PER_NOMBRE2,NULL,' ')||' '||pseg.PER_APELLIDO1||' '||
  DECODE(pseg.PER_APELLIDO2, pseg.PER_APELLIDO2,pseg.PER_APELLIDO2,NULL,' ') coordinador,
    p.TDO_ID || '-' || p.PER_ID as documento, P.PER_EMAIL AS CORREO,
    add_months(p.PRY_FECHA_TENTATIVA_INICIO,decode(p.PRY_DURACION_ACUMULADA,NULL,0,p.PRY_DURACION_ACUMULADA)) +
  decode(p.PRY_DURACION_DIAS_ACUMULADA,NULL,0,p.PRY_DURACION_DIAS_ACUMULADA) FFinal,
    add_months(p.PRY_FECHA_TENTATIVA_INICIO,decode(p.PRY_DURACION,NULL,0,p.PRY_DURACION)) FFinalPlan
FROM 
    HER_PROYECTO p 
    left join HER_DOMINIO_DETALLE dd on p.PRY_TIPO_ACTIVIDAD = dd.DOMDET_TIPO and dd.DOM_ID = '59' 
    left join HER_SEG_PROYECTO_PERSONA seg on p.PRY_ID = seg.PRY_ID 
    left join HER_PERSONA pseg on seg.PER_ID = pseg.PER_ID and seg.PER_ID &lt;> '41654907'
    left join HER_DEPENDENCIA DPN_EJEC ON P.PRY_UNIDAD_EJECUTORA = DPN_EJEC.DPN_ID
    left join HER_DOMINIO_DETALLE DD_CYT ON DD_CYT.DOMDET_TIPO = P.PRY_PROGRAMA_CYT, 
    HER_INVESTIGADOR_PROYECTO ip, HER_INVESTIGADOR_INTERNO ii, HER_DEPENDENCIA d, HER_DEPENDENCIA d2,
    HER_SEDE sed, HER_CONVOCATORIA c, HER_PERSONA p, HER_ESTADO_PROYECTO ep
WHERE 
    p.epr_id &lt;> 'B'
    and ip.pry_id = p.pry_id 
    and ip.inv_id = ii.inv_id 
    and ip.tdo_id = ii.tdo_id 
    and ip.inv_id = p.per_id
    and ip.tdo_id = p.tdo_id
    and ii.dpn_id = d.dpn_id
    and ip.inp_tipo = 'P' 
    and d.dpn_facultad = d2.dpn_id 
    and d.sed_id = sed.sed_id
    and p.MOD_ID in (10)
    and p.MOD_ID = c.CON_ID
    and p.EPR_ID = ep.EPR_ID
    AND (p.PRY_FECHA_LEGALIZAC IS NOT NULL AND  p.PRY_FECHA_LEGALIZAC >= ?1)
	AND (p.PRY_FECHA_LEGALIZAC IS NOT NULL AND  p.PRY_FECHA_LEGALIZAC &lt;= ?2)
	and d.sed_id in (SELECT COLUMN_VALUE FROM TABLE(SPLIT(?3)))
	and ii.dpn_id in (SELECT COLUMN_VALUE FROM TABLE(SPLIT(?4)))
order by p.pry_id desc</property>
        </oda-data-set>

            <property name="queryText">SELECT 
	DISTINCT DD.DOMDET_DESCRIPCION AS AVI_REGION
FROM 
	HER_AVAL 
	LEFT JOIN HER_MONTO_AVAL MA on MA.AVI_ID = HER_AVAL.AVI_ID
	left join HER_DOMINIO_DETALLE DD on MA.MAV_REGION = DD.DOMDET_TIPO 
WHERE 
	PRY_ID = ?
	AND HER_AVAL.AVI_AVALDIRECCION = 'S'
	and her_aval.avi_estado &lt;> 'B'
	AND AVI_TIPO IN ('SR','PSR')
	</property>
        </oda-data-set>

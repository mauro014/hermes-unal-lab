                    <property name="dataType">string</property>
                </structure>
            </list-property>
            <property name="queryText">select decode(fuentes1.fuente1,null,decode(fuentes2.fuente2,null,'Sin entidad',fuentes2.fuente2),fuentes1.fuente1)fuente
from her_proyecto p left join 
  (SELECT f.FFE_TIPO_ENTIDAD, ff.ffi_descripcion as fuente1, pry_id FROM  HER_FUENTE_FINANCIACION ff, 
        HER_FINANCIACION f WHERE ff.FFI_ID = f.FFI_ID AND  PRY_ID = ? AND  f.FFE_TIPO_ENTIDAD = 'F' ) fuentes1 on fuentes1.pry_id = p.pry_id left join
  (SELECT f.FFE_TIPO_ENTIDAD, ff.ffi_descripcion as fuente2, pry_id FROM  HER_FUENTE_FINANCIACION ff, 
        HER_FINANCIACION f WHERE ff.FFI_ID = f.FFI_ID AND  PRY_ID = ? AND  f.FFE_TIPO_ENTIDAD = 'FM' )fuentes2 on fuentes2.pry_id = p.pry_id
where p.pry_id = ?</property>
        </oda-data-set>

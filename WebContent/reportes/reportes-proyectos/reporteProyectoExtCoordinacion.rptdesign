                <structure>
                    <property name="position">1</property>
                    <property name="name">AVI_ENTIDAD</property>
                    <property name="nativeName">AVI_ENTIDAD</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">2</property>
                    <property name="name">AVI_FASE</property>
                    <property name="nativeName">AVI_FASE</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">3</property>
                    <property name="name">CONVOCATORIA</property>
                    <property name="nativeName">CONVOCATORIA</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">4</property>
                    <property name="name">AVI_GRUPO_INVEST</property>
                    <property name="nativeName">AVI_GRUPO_INVEST</property>
                    <property name="dataType">string</property>
                </structure>
            </list-property>
            <property name="queryText">SELECT 
	FF.FFI_DESCRIPCION AS AVI_ENTIDAD, AVI_FASE,
	decode(CE.CEX_ID,NULL,HER_AVAL.AVI_CONVOCATORIA,CE.CEX_NOMBRE)convocatoria,
	decode(GRU_ID,NULL,AVI_NOMBRE_GRUPO_PINV,'0','Sin selección de grupo para el aval',GRU_NOMBRE) as AVI_GRUPO_INVEST
	
FROM 
	HER_AVAL 
	LEFT JOIN HER_CONVOCATORIA_EXTERNA ce on TO_CHAR(ce.CEX_ID) = HER_AVAL.AVI_CONVOCATORIA
	left join HER_GRUPO on AVI_NOMBRE_GRUPO_PINV = GRU_ID 
	left join HER_FUENTE_FINANCIACION FF ON FF.FFI_ID = AVI_ENTIDAD
WHERE 
	PRY_ID = ?
	AND HER_AVAL.AVI_AVALDIRECCION = 'S'
	and her_aval.avi_estado &lt;> 'B'
	and HER_AVAL.AVI_TIPO IN ('PINV','SR')
	</property>
        </oda-data-set>
        <oda-data-set extensionID="org.eclipse.birt.report.data.oda.jdbc.JdbcSelectDataSet" name="RegionesRegalias" id="10269">

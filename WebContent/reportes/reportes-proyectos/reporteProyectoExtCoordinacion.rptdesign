            <property name="queryText">SELECT
	DISTINCT MAX(hei.hei_FECHA) AS fecha,
	MAX(ei.EIN_NOMBRE) AS estadoInforme,
	max(pi.PIN_PORC_EJEC) porc_ejec,
	max(pi.PIN_PORC_EJEC_PRE) porc_ejec_pre ,
	max(pi.PIN_FECHA_DESDE) fecha_desde ,
	max(pi.PIN_FECHA_HASTA) fecha_hasta
FROM
	HER_PROYECTO_INFORME PI
LEFT JOIN HER_HISTORICO_ESTADO_INFORME hei ON
	hei.pin_id = pi.pin_id
	AND hei.ein_id = 2,
	HER_TIPO_INFORME ti,
	HER_ESTADO_INFORME ei
WHERE
	pi.PRY_ID = ?
	AND pi.TIN_ID = ti.TIN_ID
	AND ti.TIN_ID = 2
	AND PI.EIN_ID &lt;> 0
	AND pi.EIN_ID = ei.EIN_ID
ORDER BY
	fecha ASC</property>
        </oda-data-set>
        <oda-data-set extensionID="org.eclipse.birt.report.data.oda.jdbc.JdbcSelectDataSet" name="Aval" id="9998">
            <structure name="cachedMetaData">

            <property name="queryText">SELECT
	pp.PRPR_DURACION,
	pp.PRPR_DIAS
FROM
	HER_PROYECTO_PRORROGA pp
WHERE
	pp.PRPR_ESTADO IS NULL
	AND pp.PRY_ID = ?
ORDER BY
	pp.PRPR_ID DESC</property>
        </oda-data-set>

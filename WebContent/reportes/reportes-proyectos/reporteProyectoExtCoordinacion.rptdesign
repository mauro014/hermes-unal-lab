            <property name="queryText">SELECT 
	decode(sum(f.FFE_VALOR_ESPECIE), NULL, 0, sum(f.FFE_VALOR_ESPECIE)) as valorEspecieUN
FROM 
	HER_FINANCIACION f, HER_FUENTE_FINANCIACION ff 
WHERE 
	f.PRY_ID = ?
	and f.FFI_ID = ff.FFI_ID
	and ff.FFI_INTERNA_EXTERNA in ('I','O')</property>

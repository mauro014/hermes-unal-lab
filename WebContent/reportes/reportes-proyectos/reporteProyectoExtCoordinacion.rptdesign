            <property name="queryText">SELECT 
	pi.PIN_FECHA as fecha
	,ei.EIN_NOMBRE
	,pi.PIN_PORC_EJEC
	,pi.PIN_PORC_EJEC_PRE
	,pi.PIN_FECHA_DESDE
	,pi.PIN_FECHA_HASTA
	,rownum as cantidad
FROM 
	HER_PROYECTO_INFORME pi INNER JOIN HER_ESTADO_INFORME ei ON pi.EIN_ID = ei.EIN_ID
	,HER_TIPO_INFORME ti
WHERE 
	pi.PRY_ID = ?
	and pi.TIN_ID = ti.TIN_ID
	and ti.TIN_ID = 1
	and PI.EIN_ID &lt;> 0
	order by fecha asc</property>

            </list-property>
            <property name="queryText">SELECT 
	sum(nvl(gst.GST_VALOR,0)+nvl(gst.GST_VALOR2,0)+nvl(gst.GST_VALOR3,0)+nvl(gst.GST_VALOR4,0)+nvl(gst.GST_VALOR5,0)+nvl(gst.GST_VALOR6,0)) as valorEspecieExterno
FROM 
	HER_FINANCIACION f, HER_GASTO GST, HER_FUENTE_FINANCIACION ff 
WHERE 
	f.PRY_ID = ?
	and f.fin_id = gst.fin_id
	and f.FFI_ID = ff.FFI_ID
	and ff.FFI_INTERNA_EXTERNA in ('E','OE')
	and f.ffe_tipo_entidad in ('E')
	</property>
        </oda-data-set>

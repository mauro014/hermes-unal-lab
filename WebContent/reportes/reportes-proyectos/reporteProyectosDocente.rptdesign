            <property name="queryText">select distinct *
from
(SELECT 
	decode(dd.domdet_descripcion,null,clc_nombre,dd.domdet_descripcion)area
FROM 
	HER_PROYECTO P LEFT JOIN HER_PROYECTO_AREA_TEMATICA pa ON P.PRY_ID = PA.PRY_ID 
	left join HER_DOMINIO_DETALLE dd on (pa.dom_id = dd.dom_id and dd.dom_id in ('27','68') and pa.domdet_tipo = dd.domdet_tipo)
	left join HER_PROYECTO_CLAS_CON pcc on p.pry_id = pcc.pry_id left join her_clasificacion_conocimiento cc on pcc.clc_id = cc.clc_id
WHERE 
	p.PRY_ID = ?
	order by pa.art_tipo)</property>
        </oda-data-set>
        <oda-data-set extensionID="org.eclipse.birt.report.data.oda.jdbc.JdbcSelectDataSet" name="EspecieExternaFinanciadoras" id="3571">

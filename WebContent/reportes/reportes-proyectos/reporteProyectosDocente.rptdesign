                </structure>
            </list-property>
            <property name="queryText">SELECT distinct
	max(hei.hei_FECHA) as fecha, max(ei.EIN_NOMBRE) as estadoInforme
FROM 
	HER_PROYECTO_INFORME pi left join HER_HISTORICO_ESTADO_INFORME hei on hei.pin_id = pi.pin_id and hei.ein_id = 2, HER_TIPO_INFORME ti, HER_ESTADO_INFORME ei
WHERE 
	pi.PRY_ID = ?
	and pi.TIN_ID = ti.TIN_ID
	and ti.TIN_ID = 2
	and PI.EIN_ID &lt;> 0
	and pi.EIN_ID = ei.EIN_ID
	order by fecha asc</property>
        </oda-data-set>
        <oda-data-set extensionID="org.eclipse.birt.report.data.oda.jdbc.JdbcSelectDataSet" name="AreasProyecto" id="9820">

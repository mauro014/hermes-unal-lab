            <property name="queryText">SELECT 
	DISTINCT p.pry_id, p.pry_nombre, p.PRY_CODIGO_QUIPU, d2.dpn_nombre, ep.EPR_NOMBRE as estado, d.dpn_nombre as unidad,
	sed.sed_nombre, c.CON_TITULO as modalidad, cp.CNP_TITULO as convocatoria, p.PRY_FECHA_TENTATIVA_INICIO,
	cp.CNP_ANO as anoConvoca, decode(Length(cp.DNP_ID), 1, decode(cp.DNP_ID, 1, 'NACIONAL', 'SEDE'), 4,'FACULTAD','') as tipoConvoca,
	decode(dd.DOMDET_DESCRIPCION, NULL, 'Proyecto - Convocatoria Interna', dd.DOMDET_DESCRIPCION) as tipo,
	p.PER_NOMBRE1||' '||DECODE(p.PER_NOMBRE2, p.PER_NOMBRE2,p.PER_NOMBRE2,NULL,' ')||' '||p.PER_APELLIDO1||' '||DECODE(p.PER_APELLIDO2, p.PER_APELLIDO2,p.PER_APELLIDO2,NULL,' ') invetigadorPpal,
	p.PER_EMAIL as correo,
	pseg.PER_NOMBRE1||' '||DECODE(pseg.PER_NOMBRE2, pseg.PER_NOMBRE2,pseg.PER_NOMBRE2,NULL,' ')||' '||pseg.PER_APELLIDO1||' '||DECODE(pseg.PER_APELLIDO2, pseg.PER_APELLIDO2,pseg.PER_APELLIDO2,NULL,' ') coordinador,
	p.TDO_ID || '-' || p.PER_ID as documento,
	add_months(p.PRY_FECHA_TENTATIVA_INICIO,decode(p.PRY_DURACION_ACUMULADA,NULL,0,p.PRY_DURACION_ACUMULADA)) + decode(p.PRY_DURACION_DIAS_ACUMULADA,NULL,0,p.PRY_DURACION_DIAS_ACUMULADA) FFinal,
	add_months(p.PRY_FECHA_TENTATIVA_INICIO,decode(p.PRY_DURACION,NULL,0,p.PRY_DURACION)) FFinalPlan, ip.INP_DEDICACION_HORAS_SEMANA as horasSemana,
	DBMS_LOB.substr(p.PRY_OBJETIVO_GENERAL, 4000) as objetivoGeneral, decode(p.PRY_TIENE_COMPROM_PEND,'S','SI','N','NO','E','ENVIADO: PENDIENTE POR REVISAR','--') AS COMPROMISOS
FROM 
	HER_PROYECTO p left join HER_DOMINIO_DETALLE dd on p.PRY_TIPO_ACTIVIDAD = dd.DOMDET_TIPO and dd.DOM_ID = '59' left join HER_SEG_PROYECTO_PERSONA seg on p.PRY_ID = seg.PRY_ID left join HER_PERSONA pseg on seg.PER_ID = pseg.PER_ID and seg.PER_ID &lt;> '41654907', 
	HER_INVESTIGADOR_PROYECTO ip, HER_INVESTIGADOR_INTERNO ii, HER_DEPENDENCIA d, HER_DEPENDENCIA d2,
	HER_SEDE sed, HER_CONVOCATORIA c, HER_CONVOCATORIA_PADRE cp, HER_PERSONA p, HER_ESTADO_PROYECTO ep
WHERE 
	p.pry_id in (SELECT COLUMN_VALUE FROM TABLE(SPLIT(?1))) 
	and ip.pry_id = p.pry_id 
	and ip.inv_id = ii.inv_id 
	and ip.tdo_id = ii.tdo_id 
	and ip.inv_id = p.per_id
	and ip.tdo_id = p.tdo_id 
	and ii.dpn_id = d.dpn_id 
	and ip.inp_tipo = 'P' 
	and	d.dpn_facultad = d2.dpn_id 
	and d.sed_id = sed.sed_id
	and p.MOD_ID = c.CON_ID
	and c.CNP_ID = cp.CNP_ID
	and p.EPR_ID = ep.EPR_ID
order by p.pry_id desc</property>
        </oda-data-set>

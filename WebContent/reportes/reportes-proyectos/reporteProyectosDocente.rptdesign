            <property name="queryText">SELECT 
	sum(nvl(g.GST_VALOR,0)+nvl(g.GST_VALOR2,0)+nvl(g.GST_VALOR3,0)+nvl(g.GST_VALOR4,0)+nvl(g.GST_VALOR5,0)+nvl(g.GST_VALOR6,0)) as gastosUN	
FROM 
	HER_FINANCIACION f, HER_GASTO g, her_fuente_financiacion ff 
WHERE 
	f.PRY_ID = ?
	and f.fin_id = g.fin_id
	and f.FFI_ID = ff.FFI_ID
	and ff.FFI_INTERNA_EXTERNA in ('I','O')
	--AND NOT (F.FIN_ES_LEGALIZACION IS NOT NULL AND F.FIN_ES_LEGALIZACION = 'SI')
	AND F.FIN_ES_LEGALIZACION IS NULL</property>
        </oda-data-set>
        <oda-data-set extensionID="org.eclipse.birt.report.data.oda.jdbc.JdbcSelectDataSet" name="TotalPry" id="3609">
            <structure name="cachedMetaData">
                <list-property name="resultSet">
                    <structure>
                        <property name="position">1</property>
                        <property name="name">VALORTOTAL</property>
                        <property name="dataType">decimal</property>
                    </structure>
                </list-property>
            </structure>
            <property name="dataSource">Produccion</property>
            <list-property name="parameters">
                <structure>
                    <property name="name">pry_id</property>
                    <property name="dataType">integer</property>
                    <property name="position">1</property>
                    <expression name="defaultValue">24076</expression>
                    <property name="isInput">true</property>
                    <property name="isOutput">false</property>
                </structure>
                <structure>
                    <property name="name">pry_2</property>
                    <property name="dataType">integer</property>
                    <property name="position">2</property>
                    <expression name="defaultValue">24076</expression>
                    <property name="isInput">true</property>
                    <property name="isOutput">false</property>
                </structure>
                <structure>
                    <property name="name">pry_3</property>
                    <property name="dataType">integer</property>
                    <property name="position">3</property>
                    <expression name="defaultValue">24076</expression>
                    <property name="isInput">true</property>
                    <property name="isOutput">false</property>
                </structure>
            </list-property>
            <list-property name="resultSet">
                <structure>
                    <property name="position">1</property>
                    <property name="name">VALORTOTAL</property>
                    <property name="nativeName">VALORTOTAL</property>
                    <property name="dataType">decimal</property>
                </structure>
            </list-property>
            <property name="queryText">select sum(total) AS VALORTOTAL from(
   SELECT sum(UN.valorEfectivoUN) + sum(UN.valorEspecieUN) as total, un.pry_id            
    FROM
      (SELECT
        decode(sum(f.FIN_VALOR), NULL, 0, sum(f.FIN_VALOR)) as valorEfectivoUN,
        decode(sum(f.FFE_VALOR_ESPECIE), NULL, 0, sum(f.FFE_VALOR_ESPECIE)) as valorEspecieUN, f.pry_id       
          FROM
          HER_FINANCIACION f, HER_FUENTE_FINANCIACION ff
          WHERE
          f.PRY_ID = ?
          and f.FFI_ID = ff.FFI_ID
          and ff.FFI_INTERNA_EXTERNA in ('I','O')
          group by f.PRY_ID
           ) UN group by un.pry_id
     union
           
           select decode(sum(ip.INP_VALOR_PAGAR), NULL, 0, sum(ip.INP_VALOR_PAGAR)) total, ip.PRY_ID
           from her_investigador_proyecto ip 
            WHERE ip.PRY_ID = ? group by ip.PRY_ID
    union 
       SELECT sum(UN.valorEfectivoUN) + sum(UN.valorEspecieUN) as total, un.pry_id            
        FROM
          (SELECT
            decode(sum(f.FIN_VALOR), NULL, 0, sum(f.FIN_VALOR)) as valorEfectivoUN,
            decode(sum(f.FFE_VALOR_ESPECIE), NULL, 0, sum(f.FFE_VALOR_ESPECIE)) as valorEspecieUN, f.pry_id       
              FROM
              HER_FINANCIACION f, HER_FUENTE_FINANCIACION ff
              WHERE
              f.PRY_ID = ?
              and f.FFI_ID = ff.FFI_ID
              and ff.FFI_INTERNA_EXTERNA in ('E','O')
              group by f.PRY_ID
               ) UN group by un.pry_id
    )</property>
        </oda-data-set>

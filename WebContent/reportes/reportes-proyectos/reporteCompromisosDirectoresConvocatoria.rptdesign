            <property name="queryText">select per.tdo_id tipo_documento,
per.per_id documento_docente,
per.PER_NOMBRE1||decode(per.PER_NOMBRE2,null,' ',' '||per.PER_NOMBRE2||' ')||per.PER_APELLIDO1||decode(per.PER_APELLIDO2,null,'',' '||per.PER_APELLIDO2) as nombre_docente,
fac.dpn_nombre facultad_docente,
sed.sed_nombre sede_docente,
p.pry_id codigo,
'Proyecto' tipo,
'-' tipo_movilidad,
cp.CNP_TITULO convocatoria,
c.CON_TITULO modalidad,
ep.epr_nombre estado,
decode(ei.ein_nombre,null,'Sin registrar o sin enviar',ei.ein_nombre) as estado_compromiso,
pc.com_id as id_compromiso,
ti.tin_nombre tipo_informe,
decode(pc.COM_FECHA_VENC_PRORROGA,null,pc.COM_FECHA_VENCIMIENTO,pc.COM_FECHA_VENC_PRORROGA)fecha_vencimiento,
pc.COM_NUMERO_NOTIFICACIONES as numero_notificaciones,
pc.COM_FECHA_NOTI_ACUMULADA as fecha_ult_notificacion,
cs.PER_NOMBRE1||decode(cs.PER_NOMBRE2,null,' ',' '||cs.PER_NOMBRE2||' ')||cs.PER_APELLIDO1||decode(cs.PER_APELLIDO2,null,'',' '||cs.PER_APELLIDO2) as nombre_coordinador
from 
her_proyecto p 
left join her_seg_proyecto_persona coor on coor.pry_id = p.pry_id 
left join her_persona cs on coor.per_id = cs.per_id and coor.tdo_id = cs.tdo_id,
her_proyecto_compromiso pc
left join her_tipo_informe ti on ti.tin_id = pc.tin_id
left join her_proyecto_informe pi on pi.com_id = pc.com_id
left join her_estado_informe ei on ei.ein_id = pi.ein_id,
her_investigador_proyecto ip
left join her_investigador_interno ii on ii.inv_id = ip.inv_id and ii.tdo_id = ip.tdo_id
left join her_dependencia d on ii.dpn_id = d.dpn_id
left join her_dependencia fac on d.dpn_facultad = fac.dpn_id
left join her_sede sed on fac.sed_id = sed.sed_id,
her_persona per,
her_convocatoria c,
her_convocatoria_padre cp,
her_estado_proyecto ep
where 
p.pry_id = pc.pry_id
and ip.pry_id = pc.pry_id
and p.epr_id in ('A')
and ip.inp_tipo = 'P'
and COALESCE(pc.COM_FECHA_VENC_PRORROGA, pc.COM_FECHA_VENCIMIENTO) &lt; TRUNC(SYSDATE)
--SE DEBE INDICAR LOS ID DE LAS MODALIDADES DE LA CONVOCATORIA QUE SE QUIERAN CONSULTAR.
and ip.inv_id in (select inp.inv_id from her_proyecto pry, her_investigador_proyecto inp where pry.pry_id = inp.pry_id and inp.inp_tipo = 'P' and pry.epr_id not in ('B','I') and pry.mod_id in (SELECT COLUMN_VALUE FROM TABLE(SPLIT(?))) and inp.inv_id not in (SELECT * FROM vu_usuariosprueba))
and ip.tdo_id = per.tdo_id
and ip.inv_id = per.per_id
and c.con_id = p.mod_id
and c.cnp_id = cp.cnp_id
and ep.epr_id = p.epr_id
and (pc.COM_CUMPLIDO not in ('S') or pi.ein_id in ('1','5'))

union

select per.tdo_id tipo_documento,
per.per_id documento_docente,
per.PER_NOMBRE1||decode(per.PER_NOMBRE2,null,' ',' '||per.PER_NOMBRE2||' ')||per.PER_APELLIDO1||decode(per.PER_APELLIDO2,null,'',' '||per.PER_APELLIDO2) as nombre_docente,
fac.dpn_nombre facultad_docente,
sed.sed_nombre sede_docente,
s.sem_id codigo,
'Semillero' tipo,
'-' tipo_movilidad,
'-' convocatoria,
'-' modalidad,
semEstadoActual.see_nombre estado,
 CASE 
        WHEN ei.ssr_nombre IS NULL THEN 'Sin registrar'
        WHEN ei.ssr_id = 1 and sin.SIN_PARCIAL is null THEN 'Sin registrar o ingresando'
        WHEN ei.ssr_id = 1 and sin.SIN_PARCIAL = 'S' THEN 'Sin registrar o ingresando'
        ELSE ei.ssr_nombre
END AS estado_compromiso,
sin.sin_id as id_compromiso,
'Informe de seguimiento semillero' tipo_informe,
sin.SIN_FECHA_COMPROMISO fecha_vencimiento,
sin.SIN_NUM_NOTIFICACIONES as numero_notificaciones,
sin.SIN_FECHA_NOTIFICACION as fecha_ult_notificacion,
cs.PER_NOMBRE1||decode(cs.PER_NOMBRE2,null,' ',' '||cs.PER_NOMBRE2||' ')||cs.PER_APELLIDO1||decode(cs.PER_APELLIDO2,null,'',' '||cs.PER_APELLIDO2) as nombre_coordinador
from 
her_semillero_informe sin 
left join her_semillero_sol_respuesta ei on sin.ssr_id = ei.ssr_id
LEFT JOIN (
	SELECT
		DISTINCT hshe.SEM_ID, HSE.*
	FROM
		HER_SEMILLERO_HISTORICO_ESTADO hshe
	INNER JOIN (
		SELECT
			sem_id, max(HSE_ID) id
		FROM
			HER_SEMILLERO_HISTORICO_ESTADO
		GROUP BY
			sem_id) ea ON
		ea.SEM_ID = hshe.SEM_ID
	INNER JOIN HER_SEMILLERO_HISTORICO_ESTADO hshe2 ON
		ea.ID = hshe2.HSE_ID
	INNER JOIN HER_SEMILLERO_ESTADO hse ON
		hshe2.SEE_ID = hse.SEE_ID) semEstadoActual ON
	semEstadoActual.SEM_ID = sin.SEM_ID,
her_semillero_integrante si 
left join her_investigador_interno ii on ii.inv_id = si.inv_id and ii.tdo_id = si.tdo_id
left join her_dependencia d on ii.dpn_id = d.dpn_id
left join her_dependencia fac on d.dpn_facultad = fac.dpn_id
left join her_sede sed on fac.sed_id = sed.sed_id,
her_persona per,
her_semillero s 
left join her_persona cs on s.INV_ID_COORDINADOR = cs.per_id and s.TDO_ID_COORDINADOR = cs.tdo_id
where 
sin.sem_id = si.sem_id
and si.sit_id = 'DD'
and sin.SIN_CUMPLE = '0'
and sin.SIN_FECHA_COMPROMISO &lt; TRUNC(SYSDATE)
--SE DEBE INDICAR LOS ID DE LAS MODALIDADES DE LA CONVOCATORIA QUE SE QUIERAN CONSULTAR.
and si.inv_id in (select inp.inv_id from her_proyecto pry, her_investigador_proyecto inp where pry.pry_id = inp.pry_id and inp.inp_tipo = 'P' and pry.epr_id not in ('B','I') and pry.mod_id in (SELECT COLUMN_VALUE FROM TABLE(SPLIT(?))) and inp.inv_id not in (SELECT * FROM vu_usuariosprueba))
and si.tdo_id = per.tdo_id
and si.inv_id = per.per_id
and s.sem_id = sin.sem_id
and semEstadoActual.see_id in ('5')

union

select per.tdo_id tipo_documento,
per.per_id documento_docente,
per.PER_NOMBRE1||decode(per.PER_NOMBRE2,null,' ',' '||per.PER_NOMBRE2||' ')||per.PER_APELLIDO1||decode(per.PER_APELLIDO2,null,'',' '||per.PER_APELLIDO2) as nombre_docente,
fac.dpn_nombre facultad_docente,
sed.sed_nombre sede_docente,
to_number(mov.mov_id) codigo,
'Movilidad' tipo,
'Visitantes' tipo_movilidad,
cp.CNP_TITULO convocatoria,
c.CON_TITULO modalidad,
decode ((decode(mov.mov_aprob, '', '','SI','A','NO','R','') || decode(mov.mov_acept, '', 'I','SI','AP','NO','N','')),'I','Ingresado','AP','Aprobado Facultad','N','No Aprobado Facultad','AAP','Aprobado Sede','R','No Aprobado Sede','RAP','No Aprobado Sede','') estado,
decode(mov.MOV_ESTADO_REVISION_SEG,null,'SIN REGISTRAR','L','Lectura Facultad','D','Devuelto','A','Aprobación Sede') as estado_compromiso,
to_number(mov.mov_id) id_compromiso,
'Informe de seguimiento movilidad' tipo_informe,
ADD_MONTHS(mov.MOV_FEC_FIN_EV,3) fecha_vencimiento,
mov.MOV_NUMERO_NOTIFICACIONES as numero_notificaciones,
mov.MOV_FECHA_NOTIFICACION as fecha_ult_notificacion,
'-' nombre_coordinador
from 
her_movilidad_visitantes_ext mov 
left join her_investigador_interno ii on ii.inv_id = mov.MOV_ID_PER and ii.tdo_id = mov.MOV_TDO_ID_PER
left join her_dependencia d on ii.dpn_id = d.dpn_id
left join her_dependencia fac on d.dpn_facultad = fac.dpn_id
left join her_sede sed on fac.sed_id = sed.sed_id
left join her_convocatoria c on c.con_id = mov.CON_ID
left join her_convocatoria_padre cp on cp.cnp_id = c.cnp_id,
her_persona per
where 
mov.MOV_ACEPT = 'SI' and
mov.MOV_APROB = 'SI' and
(mov.MOV_ESTADO_SEG is null or mov.MOV_ESTADO_SEG not in ('F')) and
ADD_MONTHS(mov.MOV_FEC_FIN_EV,3) &lt; TRUNC(SYSDATE)
--SE DEBE INDICAR LOS ID DE LAS MODALIDADES DE LA CONVOCATORIA QUE SE QUIERAN CONSULTAR.
AND mov.MOV_ID_PER IN (select inp.inv_id from her_proyecto pry, her_investigador_proyecto inp where pry.pry_id = inp.pry_id and inp.inp_tipo = 'P' and pry.epr_id not in ('B','I') and pry.mod_id in (SELECT COLUMN_VALUE FROM TABLE(SPLIT(?))) and inp.inv_id not in (SELECT * FROM vu_usuariosprueba))
and mov.MOV_TDO_ID_PER = per.tdo_id
and mov.MOV_ID_PER = per.per_id

union

select per.tdo_id tipo_documento,
per.per_id documento_docente,
per.PER_NOMBRE1||decode(per.PER_NOMBRE2,null,' ',' '||per.PER_NOMBRE2||' ')||per.PER_APELLIDO1||decode(per.PER_APELLIDO2,null,'',' '||per.PER_APELLIDO2) as nombre_docente,
fac.dpn_nombre facultad_docente,
sed.sed_nombre sede_docente,
to_number(mov.mov_id) codigo,
'Movilidad' tipo,
'Docentes' tipo_movilidad,
cp.CNP_TITULO convocatoria,
c.CON_TITULO modalidad,
decode ((decode(mov.mov_aprob, '', '','SI','A','NO','R','') || decode(mov.mov_acept, '', 'I','SI','AP','NO','N','')),'I','Ingresado','AP','Aprobado Facultad','N','No Aprobado Facultad','AAP','Aprobado Sede','R','No Aprobado Sede','RAP','No Aprobado Sede','') estado,
decode(mov.MOV_ESTADO_REVISION_SEG,null,'SIN REGISTRAR','L','Lectura Facultad','D','Devuelto','A','Aprobación Sede') as estado_compromiso,
to_number(mov.mov_id) id_compromiso,
'Informe de seguimiento movilidad' tipo_informe,
ADD_MONTHS(mov.MOV_FEC_FIN_EV,3) fecha_vencimiento,
mov.MOV_NUMERO_NOTIFICACIONES as numero_notificaciones,
mov.MOV_FECHA_NOTIFICACION as fecha_ult_notificacion,
'-' nombre_coordinador
from 
her_movilidad_docentes_eventos mov 
left join her_investigador_interno ii on ii.inv_id = mov.MOV_ID_PER and ii.tdo_id = mov.MOV_TDO_ID_PER
left join her_dependencia d on ii.dpn_id = d.dpn_id
left join her_dependencia fac on d.dpn_facultad = fac.dpn_id
left join her_sede sed on fac.sed_id = sed.sed_id
left join her_convocatoria c on c.con_id = mov.CON_ID
left join her_convocatoria_padre cp on cp.cnp_id = c.cnp_id,
her_persona per
where 
mov.MOV_ACEPT = 'SI' and
mov.MOV_APROB = 'SI' and
(mov.MOV_ESTADO_SEG is null or mov.MOV_ESTADO_SEG not in ('F')) and
ADD_MONTHS(mov.MOV_FEC_FIN_EV,3) &lt; TRUNC(SYSDATE)
--SE DEBE INDICAR LOS ID DE LAS MODALIDADES DE LA CONVOCATORIA QUE SE QUIERAN CONSULTAR.
AND mov.MOV_ID_PER IN (select inp.inv_id from her_proyecto pry, her_investigador_proyecto inp where pry.pry_id = inp.pry_id and inp.inp_tipo = 'P' and pry.epr_id not in ('B','I') and pry.mod_id in (SELECT COLUMN_VALUE FROM TABLE(SPLIT(?))) and inp.inv_id not in (SELECT * FROM vu_usuariosprueba))
and mov.MOV_TDO_ID_PER = per.tdo_id
and mov.MOV_ID_PER = per.per_id

union

select per.tdo_id tipo_documento,
per.per_id documento_docente,
per.PER_NOMBRE1||decode(per.PER_NOMBRE2,null,' ',' '||per.PER_NOMBRE2||' ')||per.PER_APELLIDO1||decode(per.PER_APELLIDO2,null,'',' '||per.PER_APELLIDO2) as nombre_docente,
fac.dpn_nombre facultad_docente,
sed.sed_nombre sede_docente,
to_number(mov.mov_id) codigo,
'Movilidad' tipo,
'Estudiantes' tipo_movilidad,
cp.CNP_TITULO convocatoria,
c.CON_TITULO modalidad,
decode ((decode(mov.mov_aprob, '', '','SI','A','NO','R','') || decode(mov.mov_acept, '', 'I','SI','AP','NO','N','')),'I','Ingresado','AP','Aprobado Facultad','N','No Aprobado Facultad','AAP','Aprobado Sede','R','No Aprobado Sede','RAP','No Aprobado Sede','') estado,
decode(mov.MOV_ESTADO_REVISION_SEG,null,'SIN REGISTRAR','L','Lectura Facultad','D','Devuelto','A','Aprobación Sede') as estado_compromiso,
to_number(mov.mov_id) id_compromiso,
'Informe de seguimiento movilidad' tipo_informe,
ADD_MONTHS(mov.MOV_FEC_FIN_EV,3) fecha_vencimiento,
mov.MOV_NUMERO_NOTIFICACIONES as numero_notificaciones,
mov.MOV_FECHA_NOTIFICACION as fecha_ult_notificacion,
'-' nombre_coordinador
from 
her_movilidad_estudiante_pos mov 
left join her_investigador_interno ii on ii.inv_id = mov.MOV_ID_PER and ii.tdo_id = mov.MOV_TDO_ID_PER
left join her_dependencia d on ii.dpn_id = d.dpn_id
left join her_dependencia fac on d.dpn_facultad = fac.dpn_id
left join her_sede sed on fac.sed_id = sed.sed_id
left join her_convocatoria c on c.con_id = mov.CON_ID
left join her_convocatoria_padre cp on cp.cnp_id = c.cnp_id,
her_persona per
where 
mov.MOV_ACEPT = 'SI' and
mov.MOV_APROB = 'SI' and
(mov.MOV_ESTADO_SEG is null or mov.MOV_ESTADO_SEG not in ('F')) and
ADD_MONTHS(mov.MOV_FEC_FIN_EV,3) &lt; TRUNC(SYSDATE)
--SE DEBE INDICAR LOS ID DE LAS MODALIDADES DE LA CONVOCATORIA QUE SE QUIERAN CONSULTAR.
AND mov.MOV_ID_PER IN (select inp.inv_id from her_proyecto pry, her_investigador_proyecto inp where pry.pry_id = inp.pry_id and inp.inp_tipo = 'P' and pry.epr_id not in ('B','I') and pry.mod_id in (SELECT COLUMN_VALUE FROM TABLE(SPLIT(?))) and inp.inv_id not in (SELECT * FROM vu_usuariosprueba))
and mov.MOV_TDO_ID_PER = per.tdo_id
and mov.MOV_ID_PER = per.per_id</property>
        </oda-data-set>
    </data-sets>

                    <property name="dataType">date-time</property>
                </structure>
                <structure>
                    <property name="position">57</property>
                    <property name="name">SINOPSIS_DIVULGATIVA</property>
                    <property name="nativeName">SINOPSIS_DIVULGATIVA</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">58</property>
                    <property name="name">RESUMEN_TECNICO</property>
                    <property name="nativeName">RESUMEN_TECNICO</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">59</property>
                    <property name="name">CONCLUSIONES</property>
                    <property name="nativeName">CONCLUSIONES</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">60</property>
                    <property name="name">FECHA_ENTREGA_INFORME_FINAL</property>
                    <property name="nativeName">FECHA_ENTREGA_INFORME_FINAL</property>
                    <property name="dataType">date-time</property>
                </structure>
                <structure>
                    <property name="position">61</property>
                    <property name="name">ADICIONP</property>
                    <property name="nativeName">ADICIONP</property>
                    <property name="dataType">decimal</property>
                </structure>
                <structure>
                    <property name="position">62</property>
                    <property name="name">IMP_ID_INFORME</property>
                    <property name="nativeName">IMP_ID_INFORME</property>
                    <property name="dataType">decimal</property>
                </structure>
                <structure>
                    <property name="position">63</property>
                    <property name="name">TIPO_IMPACTO</property>
                    <property name="nativeName">TIPO_IMPACTO</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">64</property>
                    <property name="name">OBJETIVO_IMPACTO</property>
                    <property name="nativeName">OBJETIVO_IMPACTO</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">65</property>
                    <property name="name">MEDICION_IMPACTO</property>
                    <property name="nativeName">MEDICION_IMPACTO</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">66</property>
                    <property name="name">DETALLE_IMPACTO</property>
                    <property name="nativeName">DETALLE_IMPACTO</property>
                    <property name="dataType">string</property>
                </structure>
            </list-property>
            <property name="queryText">WITH
IP_ULT AS (
  SELECT ip.*,
         ROW_NUMBER() OVER (PARTITION BY ip.PRY_ID ORDER BY ip.INP_ID DESC) AS rn
  FROM HER_INVESTIGADOR_PROYECTO ip
  WHERE ip.INP_TIPO = 'P'
),
HAP AS (
  SELECT PRY_ID, MAX(HEP_FECHA) FECHA
  FROM HER_HISTORICO_ESTADO_PROYECTO
  WHERE EPR_ID = 'AP'
  GROUP BY PRY_ID
),
HF AS (
  SELECT PRY_ID, MAX(HEP_FECHA) FECHA
  FROM HER_HISTORICO_ESTADO_PROYECTO
  WHERE EPR_ID = 'F'
  GROUP BY PRY_ID
),
HP AS (
  SELECT PRY_ID, MAX(HEP_FECHA) HEP_FECHA
  FROM HER_HISTORICO_ESTADO_PROYECTO
  WHERE EPR_ID = 'P'
  GROUP BY PRY_ID
),
VP AS (
  SELECT PRY_ID, SUM(NVL(INP_VALOR_PAGAR,0)) SUMA
  FROM HER_INVESTIGADOR_PROYECTO
  GROUP BY PRY_ID
),
GUN AS (
  SELECT f.PRY_ID,
         SUM(NVL(g.GST_VALOR,0)+NVL(g.GST_VALOR2,0)+NVL(g.GST_VALOR3,0)+NVL(g.GST_VALOR4,0)+NVL(g.GST_VALOR5,0)+NVL(g.GST_VALOR6,0)) SUMA
  FROM HER_FINANCIACION f
  JOIN HER_GASTO g ON f.FIN_ID = g.FIN_ID
  JOIN HER_TIPO_RUBRO tr ON tr.TRU_ID = g.TRU_ID AND tr.TRU_CONTRAPARTIDA &lt;> '1'
  JOIN HER_FUENTE_FINANCIACION ff ON ff.FFI_ID = f.FFI_ID AND ff.FFI_INTERNA_EXTERNA IN ('I','O')
  WHERE NVL(f.FIN_ES_LEGALIZACION,'NO') = 'NO'
  GROUP BY f.PRY_ID
),
VE AS (
  SELECT f.PRY_ID,
         SUM(NVL(gst.GST_VALOR,0)+NVL(gst.GST_VALOR2,0)+NVL(gst.GST_VALOR3,0)+NVL(gst.GST_VALOR4,0)+NVL(gst.GST_VALOR5,0)+NVL(gst.GST_VALOR6,0)) SUMA
  FROM HER_FINANCIACION f
  JOIN HER_GASTO gst ON f.FIN_ID = gst.FIN_ID
  JOIN HER_FUENTE_FINANCIACION ff ON f.FFI_ID = ff.FFI_ID
  WHERE ff.FFI_INTERNA_EXTERNA IN ('E','OE')
    AND f.FFE_TIPO_ENTIDAD IS NULL
    AND NVL(f.FIN_ES_LEGALIZACION,'NO') = 'NO'
  GROUP BY f.PRY_ID
),
VEE AS (
  SELECT f.PRY_ID,
         SUM(NVL(gst.GST_VALOR,0)+NVL(gst.GST_VALOR2,0)+NVL(gst.GST_VALOR3,0)+NVL(gst.GST_VALOR4,0)+NVL(gst.GST_VALOR5,0)+NVL(gst.GST_VALOR6,0)) SUMA
  FROM HER_FINANCIACION f
  JOIN HER_GASTO gst ON f.FIN_ID = gst.FIN_ID
  JOIN HER_FUENTE_FINANCIACION ff ON f.FFI_ID = ff.FFI_ID
  WHERE ff.FFI_INTERNA_EXTERNA IN ('E','OE')
    AND f.FFE_TIPO_ENTIDAD IN ('E')
    AND NVL(f.FIN_ES_LEGALIZACION,'NO') = 'NO'
  GROUP BY f.PRY_ID
),
TP AS (
  SELECT f.PRY_ID,
         SUM(NVL(f.FIN_VALOR,0)+NVL(f.FFE_VALOR_ESPECIE,0)) SUMA
  FROM HER_FINANCIACION f
  JOIN HER_FUENTE_FINANCIACION ff ON f.FFI_ID = ff.FFI_ID
  WHERE ff.FFI_INTERNA_EXTERNA IN ('E','OE')
    AND f.FFE_TIPO_ENTIDAD IN ('P')
  GROUP BY f.PRY_ID
),
SEDES_PROY AS (
  SELECT hpd.PRY_ID,
         LISTAGG(hs.SED_NOMBRE,'; ') WITHIN GROUP (ORDER BY hs.SED_ID) AS SEDES_PROYECTO
  FROM HER_PROYECTO_DEPENDENCIA hpd
  JOIN HER_DEPENDENCIA hd ON hpd.DPN_ID = hd.DPN_ID
  JOIN HER_SEDE hs ON hs.SED_ID = hd.SED_ID
  GROUP BY hpd.PRY_ID
),
HIST_REV AS (
  SELECT PIN_ID,
         CASE WHEN EIN_ID IN (4,7) THEN 47 ELSE EIN_ID END AS EIN_GRP,
         MAX(HEI_FECHA) AS FECHA_REVISION
  FROM HER_HISTORICO_ESTADO_INFORME
  WHERE EIN_ID IN (3,4,7)
  GROUP BY PIN_ID, CASE WHEN EIN_ID IN (4,7) THEN 47 ELSE EIN_ID END
),
INF AS (
  SELECT
    pi.PRY_ID,
    pi.PIN_ID,
    pi.TIN_ID            AS INF_TIN_ID,
    ti.TIN_NOMBRE        AS TIPO_INFORME,
    pi.PIN_FECHA         AS FECHA_INGRESO,
    ei.EIN_NOMBRE        AS ESTADO_INFORME,
    pi.PIN_PORC_EJEC,
    pi.PIN_PORC_EJEC_PRE,
    pi.PIN_FECHA_DESDE,
    pi.PIN_FECHA_HASTA,
    pi.PIN_SIPNOSIS AS Sinopsis_divulgativa,
	pi.PIN_RESUMEN_TECNICO AS Resumen_tecnico,
	PI.PIN_CONCLUSIONES AS Conclusiones,
    TRIM(fac.PER_NOMBRE1||' '||NVL(fac.PER_NOMBRE2,'')||' '||fac.PER_APELLIDO1||' '||NVL(fac.PER_APELLIDO2,'')) AS REV_FAC_NOMBRE,
    TRIM(coo.PER_NOMBRE1||' '||NVL(coo.PER_NOMBRE2,'')||' '||coo.PER_APELLIDO1||' '||NVL(coo.PER_APELLIDO2,'')) AS REV_COO_NOMBRE,
    hr_fac.FECHA_REVISION AS FECHA_REV_FAC,
    hr_coo.FECHA_REVISION AS FECHA_REV_COO,
    pc.COM_FECHA_NOTIFICACION,
    DECODE(pc.COM_CUMPLIDO,'S','SI','N','NO')               AS CUMPLIDO,
    NVL(pc.COM_FECHA_VENC_PRORROGA, pc.COM_FECHA_VENCIMIENTO) AS FECHA_VENC_DESP_PRORROGA
  FROM HER_PROYECTO_INFORME pi
  JOIN HER_TIPO_INFORME   ti ON ti.TIN_ID = pi.TIN_ID
  JOIN HER_ESTADO_INFORME ei ON ei.EIN_ID = pi.EIN_ID
  LEFT JOIN HER_PROYECTO_COMPROMISO pc ON pc.COM_ID = pi.COM_ID
  LEFT JOIN HER_PERSONA fac ON fac.PER_ID = pi.PER_ID_REVISION_FACULTAD AND fac.TDO_ID = pi.TDO_ID_REVISION_FACULTAD
  LEFT JOIN HER_PERSONA coo ON coo.PER_ID = pi.PER_ID_REVISION_COORDINADOR AND coo.TDO_ID = pi.TDO_ID_REVISION_COORDINADOR
  LEFT JOIN HIST_REV hr_fac ON hr_fac.PIN_ID = pi.PIN_ID AND hr_fac.EIN_GRP = 47
  LEFT JOIN HIST_REV hr_coo ON hr_coo.PIN_ID = pi.PIN_ID AND hr_coo.EIN_GRP = 3
  WHERE pi.TIN_ID IN (1,2)
    AND pi.EIN_ID &lt;> 0
),

IMPACTO AS (
  SELECT
    i.PRY_ID                 AS id_proyecto,
    i.PIN_ID                 AS id_informe,
    h.PII_TIPO               AS tipo_impacto,
    dd.DOMDET_DESCRIPCION    AS objetivo,
    h.PII_MEDICION           AS medicion_impacto,
    h.PII_DETALLE            AS detalle_impacto
  FROM INF i
  JOIN HER_PROYECTO_INFORME_IMPACTO h
    ON h.PIN_ID = i.PIN_ID
  LEFT JOIN HER_DOMINIO_DETALLE dd
    ON dd.DOMDET_TIPO = h.PII_ODS
   AND dd.DOM_ID = '195'
  WHERE i.INF_TIN_ID = 2
)
SELECT

  CASE TO_CHAR(?) WHEN '1' THEN p.PRY_ID ELSE NULL END PRY_ID,
  CASE TO_CHAR(?) WHEN '1' THEN p.PRY_NOMBRE ELSE NULL END PRY_NOMBRE,
  CASE TO_CHAR(?) WHEN '1' THEN p.PRY_CODIGO_QUIPU ELSE NULL END PRY_CODIGO_QUIPU,
  CASE TO_CHAR(?) WHEN '1' THEN d2.DPN_NOMBRE ELSE NULL END DPN_NOMBRE,
  CASE TO_CHAR(?) WHEN '1' THEN ep.EPR_NOMBRE ELSE NULL END estadoActual,
  CASE TO_CHAR(?) WHEN '1' THEN NVL(dle.DPN_NOMBRE, p.PRY_LUGAR) ELSE NULL END lugEjec,
  CASE TO_CHAR(?) WHEN '1' THEN d.DPN_NOMBRE ELSE NULL END unidad,
  CASE TO_CHAR(?) WHEN '1' THEN sed.SED_NOMBRE ELSE NULL END sed_nombre,
  CASE TO_CHAR(?) WHEN '1' THEN c.CON_TITULO ELSE NULL END modalidad,
  CASE TO_CHAR(?) WHEN '1' THEN cp.CNP_TITULO ELSE NULL END convocatoria,
  CASE TO_CHAR(?) WHEN '1' THEN p.PRY_FECHA_TENTATIVA_INICIO ELSE NULL END PRY_FECHA_TENTATIVA_INICIO,
  CASE TO_CHAR(?) WHEN '1' THEN cp.CNP_ANO ELSE NULL END anoConvoca,
  CASE TO_CHAR(?) WHEN '1' THEN DECODE(LENGTH(cp.DNP_ID),1,DECODE(TO_CHAR(cp.DNP_ID),'1','NACIONAL','SEDE'),4,'FACULTAD','') ELSE NULL END tipoConvoca,
  CASE TO_CHAR(?) WHEN '1' THEN DECODE(dd.DOMDET_DESCRIPCION,NULL,'Proyecto - Convocatoria Interna',dd.DOMDET_DESCRIPCION) ELSE NULL END tipo,
  CASE TO_CHAR(?) WHEN '1' THEN (SELECT d.DOMDET_DESCRIPCION FROM HER_DOMINIO_DETALLE d WHERE d.DOM_ID=117 AND d.DOMDET_TIPO=P.PRY_TIPO_ACTIVIDAD) ELSE NULL END TIPO_PROYECTO,
  CASE TO_CHAR(?) WHEN '1' THEN (SELECT DBMS_LOB.SUBSTR(pr.PRY_ABSTRACT,3999,1) FROM HER_PROYECTO pr WHERE pr.PRY_ID=p.PRY_ID) ELSE NULL END RESUMEN,
  CASE TO_CHAR(?) WHEN '1' THEN (
        SELECT MAX(d.DOMDET_DESCRIPCION)
        FROM HER_DOMINIO_DETALLE d, her_dominio dom
        WHERE dom.dom_tipo = 'OBJETIVO_SOCIO_ECONOMICO'
          AND d.DOMDET_TIPO = P.PRY_OBJETIVO_SOCIO_ECONOMICO
      ) ELSE NULL END OBJSOCIOEC,
  CASE TO_CHAR(?) WHEN '1' THEN (
        SELECT MAX(d.DOMDET_DESCRIPCION)
        FROM HER_DOMINIO_DETALLE d, her_proyecto_area_tematica pa
        WHERE pa.dom_id = d.dom_id
          AND pa.DOMDET_TIPO = D.DOMDET_TIPO
          AND pa.art_tipo = 1
      ) ELSE NULL END OCDEPPL,
  CASE TO_CHAR(?) WHEN '1' THEN per.PER_NOMBRE1||DECODE(per.PER_NOMBRE2,NULL,' ',' '||per.PER_NOMBRE2||' ')||per.PER_APELLIDO1||DECODE(per.PER_APELLIDO2,NULL,'',' '||per.PER_APELLIDO2) ELSE NULL END invetigadorPpal,
  CASE TO_CHAR(?) WHEN '1' THEN pseg.PER_NOMBRE1||DECODE(pseg.PER_NOMBRE2,NULL,' ',' '||pseg.PER_NOMBRE2||' ')||pseg.PER_APELLIDO1||DECODE(pseg.PER_APELLIDO2,NULL,'',' '||pseg.PER_APELLIDO2) ELSE NULL END coordinador,
  CASE TO_CHAR(?) WHEN '1' THEN per.TDO_ID||'-'||per.PER_ID ELSE NULL END documento,
  CASE TO_CHAR(?) WHEN '1' THEN per.PER_EMAIL ELSE NULL END correo,
  CASE TO_CHAR(?) WHEN '1' THEN ADD_MONTHS(p.PRY_FECHA_TENTATIVA_INICIO, NVL(p.PRY_DURACION,0)) ELSE NULL END FFinalPlan,
  CASE TO_CHAR(?) WHEN '1' THEN ADD_MONTHS(p.PRY_FECHA_TENTATIVA_INICIO, NVL(p.PRY_DURACION_ACUMULADA,0)) + NVL(p.PRY_DURACION_DIAS_ACUMULADA,0) ELSE NULL END FFinal,
  CASE TO_CHAR(?) WHEN '1' THEN ip.INP_DEDICACION_HORAS_SEMANA ELSE NULL END horasSemana,
  CASE TO_CHAR(?) WHEN '1' THEN DBMS_LOB.SUBSTR(p.PRY_OBJETIVO_GENERAL,4000) ELSE NULL END objetivoGeneral,
  CASE TO_CHAR(?) WHEN '1' THEN p.PRY_DURACION ELSE NULL END duracion,
  CASE TO_CHAR(?) WHEN '1' THEN hap.FECHA ELSE NULL END "Fecha Aprobación",
  CASE WHEN p.EPR_ID IN ('F') AND TO_CHAR(?)='1' THEN psf.PSF_VALOR ELSE NULL END "Valor Ejecutado",
  CASE TO_CHAR(?) WHEN '1' THEN NVL(p.PRY_CONTRAP_EFECTIVO,0)+NVL(p.PRY_CONTRAP_ESPECIE,0) ELSE NULL END "Valor Contrapartida UN",
  CASE WHEN p.EPR_ID IN ('F') AND TO_CHAR(?)='1' THEN hf.FECHA ELSE NULL END "Cambio Finalizado",
  CASE TO_CHAR(?) WHEN '1' THEN hp.HEP_FECHA ELSE NULL END HEP_FECHA,
  CASE TO_CHAR(?) WHEN '1' THEN vp.SUMA ELSE NULL END valorPersonal,
  CASE TO_CHAR(?) WHEN '1' THEN (
     SELECT NVL(SUM(NVL(inp.SPI_VALOR_PAGAR,0)),0)
     FROM HER_SOLICITUD_PRORROGA_INV inp
     JOIN HER_SOLICITUD s ON s.SOL_ID=inp.SOL_ID AND s.SOL_RESPUESTA='A'
     WHERE s.PRY_ID=p.PRY_ID AND inp.SPI_ESTADO NOT IN ('B','N')
  ) ELSE NULL END AS PRORROGASPERSONAL,
  CASE TO_CHAR(?) WHEN '1' THEN gUN.SUMA ELSE NULL END gastosUN,
  CASE TO_CHAR(?) WHEN '1' THEN ve.SUMA ELSE NULL END valorExterno,
  CASE TO_CHAR(?) WHEN '1' THEN vee.SUMA ELSE NULL END valorEspecieExterno,
  CASE TO_CHAR(?) WHEN '1' THEN tp.SUMA ELSE NULL END totalParticpantes,
  CASE WHEN TO_CHAR(?)!='1' THEN eph.EPR_NOMBRE ELSE NULL END estado,
  CASE WHEN TO_CHAR(?)!='1' THEN hep.HEP_FECHA END fechaEstado,
  CASE TO_CHAR(?) WHEN '1' THEN sed2.SED_NOMBRE ELSE NULL END sede_act,
  CASE TO_CHAR(?) WHEN '1' THEN sedes.SEDES_PROYECTO ELSE NULL END sedes_proyecto,
  CASE TO_CHAR(?) WHEN '1' THEN ods.VAL_NOMBRE_VALOR ELSE NULL END "ODS Principal",

  inf.PIN_ID                       AS INF_PIN_ID,
  inf.TIPO_INFORME                 AS INF_TIPO_INFORME,
  inf.FECHA_INGRESO                AS INF_FECHA_INGRESO,
  inf.ESTADO_INFORME               AS INF_ESTADO,

  CASE WHEN ei2.EIN_ID IN (4,7) THEN inf.REV_FAC_NOMBRE
       WHEN ei2.EIN_ID = 3        THEN inf.REV_COO_NOMBRE
  END                              AS INF_RESPONSABLE_REVISION,
  CASE WHEN ei2.EIN_ID IN (4,7) THEN inf.FECHA_REV_FAC
       WHEN ei2.EIN_ID = 3        THEN inf.FECHA_REV_COO
  END                              AS INF_FECHA_REVISION,
  inf.PIN_PORC_EJEC                AS INF_PORC_EJEC_TECNICA,
  inf.PIN_PORC_EJEC_PRE            AS INF_PORC_EJEC_PRESUPUESTO,
  inf.PIN_FECHA_DESDE              AS INF_FECHA_DESDE,
  inf.PIN_FECHA_HASTA              AS INF_FECHA_HASTA,
  inf.CUMPLIDO                     AS INF_CUMPLIDO,
  inf.FECHA_VENC_DESP_PRORROGA     AS INF_FECHA_VENC_DESP_PRORROGA,
  inf.COM_FECHA_NOTIFICACION       AS INF_COM_FECHA_NOTIFICACION,
  inf.Sinopsis_divulgativa,
inf.Resumen_tecnico,
inf.Conclusiones,

  CASE TO_CHAR(?) WHEN '1' THEN (
    SELECT MAX(NVL(pc.COM_FECHA_VENC_PRORROGA, pc.COM_FECHA_VENCIMIENTO))
    FROM HER_PROYECTO_COMPROMISO pc
    WHERE pc.PRY_ID = p.PRY_ID AND pc.TIN_ID = 2
  ) ELSE NULL END AS FECHA_ENTREGA_INFORME_FINAL,
  CASE TO_CHAR(?) WHEN '1' THEN (
    SELECT SUM(ad.SAP_VALOR)
    FROM HER_SOLICITUD_ADICION ad
    JOIN HER_SOLICITUD sol ON sol.SOL_ID=ad.SOL_ID
    WHERE sol.SOL_RESPUESTA='A' AND sol.PRY_ID=p.PRY_ID
  ) ELSE NULL END AS ADICIONP,

  CASE WHEN UPPER(TO_CHAR(?)) = 'IIF' THEN imp.id_informe       ELSE NULL END AS IMP_ID_INFORME,
  CASE WHEN UPPER(TO_CHAR(?)) = 'IIF' THEN imp.tipo_impacto     ELSE NULL END AS TIPO_IMPACTO,
  CASE WHEN UPPER(TO_CHAR(?)) = 'IIF' THEN imp.objetivo         ELSE NULL END AS OBJETIVO_IMPACTO,
  CASE WHEN UPPER(TO_CHAR(?)) = 'IIF' THEN imp.medicion_impacto ELSE NULL END AS MEDICION_IMPACTO,
  CASE WHEN UPPER(TO_CHAR(?)) = 'IIF' THEN imp.detalle_impacto  ELSE NULL END AS DETALLE_IMPACTO

FROM HER_PROYECTO p
LEFT JOIN IP_ULT ip ON ip.PRY_ID = p.PRY_ID AND ip.rn = 1
LEFT JOIN HER_INVESTIGADOR_INTERNO ii ON ip.INV_ID = ii.INV_ID AND ip.TDO_ID = ii.TDO_ID
LEFT JOIN HER_DEPENDENCIA d  ON ii.DPN_ID = d.DPN_ID
LEFT JOIN HER_DEPENDENCIA d2 ON d.DPN_FACULTAD = d2.DPN_ID
LEFT JOIN HER_ESTADO_PROYECTO ep ON p.EPR_ID = ep.EPR_ID
LEFT JOIN HER_DEPENDENCIA dle ON p.PRY_LUGAR = dle.DPN_ID
LEFT JOIN HER_SEDE sed ON d.SED_ID = sed.SED_ID
LEFT JOIN HER_CONVOCATORIA c ON p.MOD_ID = c.CON_ID
LEFT JOIN HER_CONVOCATORIA_PADRE cp ON c.CNP_ID = cp.CNP_ID
LEFT JOIN HER_DOMINIO_DETALLE dd ON p.PRY_TIPO_ACTIVIDAD = dd.DOMDET_TIPO AND dd.DOM_ID = '59'
LEFT JOIN HER_PERSONA per ON ip.INV_ID = per.PER_ID AND ip.TDO_ID = per.TDO_ID
LEFT JOIN HER_SEG_PROYECTO_PERSONA seg ON p.PRY_ID = seg.PRY_ID
LEFT JOIN HER_PERSONA pseg ON seg.PER_ID = pseg.PER_ID AND seg.TDO_ID = pseg.TDO_ID AND seg.PER_ID &lt;> '41654907'
LEFT JOIN HAP ON HAP.PRY_ID = p.PRY_ID
LEFT JOIN (
  SELECT psf.*, ROW_NUMBER() OVER (PARTITION BY psf.PRY_ID ORDER BY psf.PSF_ID DESC) rn
  FROM HER_PROYECTO_SAL_FINANCIACION psf
) psf ON psf.PRY_ID = p.PRY_ID AND psf.rn = 1
LEFT JOIN HF ON HF.PRY_ID = p.PRY_ID
LEFT JOIN HP ON HP.PRY_ID = p.PRY_ID
LEFT JOIN HER_HISTORICO_ESTADO_PROYECTO hep ON hep.PRY_ID = p.PRY_ID
LEFT JOIN VP  ON VP.PRY_ID  = p.PRY_ID
LEFT JOIN GUN ON GUN.PRY_ID = p.PRY_ID
LEFT JOIN VE  ON VE.PRY_ID  = p.PRY_ID
LEFT JOIN VEE ON VEE.PRY_ID = p.PRY_ID
LEFT JOIN TP  ON TP.PRY_ID  = p.PRY_ID
LEFT JOIN HER_ESTADO_PROYECTO eph ON hep.EPR_ID = eph.EPR_ID
LEFT JOIN HER_HISTORICO_INTEGRANTES hhi ON hhi.PRY_ID = p.PRY_ID AND ii.INV_ID = hhi.HCI_PER_ID AND ii.TDO_ID = hhi.HCI_TDO_ID AND hhi.HCI_FECHA_RETIRO IS NULL
LEFT JOIN HER_DEPENDENCIA d3 ON hhi.DPN_ID = d3.DPN_ID
LEFT JOIN HER_DEPENDENCIA d4 ON d4.DPN_ID = d3.DPN_FACULTAD
LEFT JOIN HER_SEDE sed2 ON d4.SED_ID = sed2.SED_ID
LEFT JOIN HER_PROYECTO_LISTAS_VAL ods ON p.PRY_ID = ods.PRY_ID
  AND ods.VAL_TIPO = 'OBJETIVOS_DESARROLLO_SOSTENIBLE'
  AND ods.VAL_DESCRIPCION = 'OBJETIVO_DESARROLLO_SOSTENIBLE_PRINCIPAL'
LEFT JOIN SEDES_PROY sedes ON sedes.PRY_ID = p.PRY_ID
LEFT JOIN INF inf ON inf.PRY_ID = p.PRY_ID
LEFT JOIN HER_ESTADO_INFORME ei2 ON ei2.EIN_NOMBRE = inf.ESTADO_INFORME
LEFT JOIN IMPACTO imp
       ON imp.id_proyecto = p.PRY_ID
      AND imp.id_informe  = inf.PIN_ID
      AND UPPER(TO_CHAR(?)) = 'IIF'   -- parámetro para activar el JOIN sólo en modo IIF

WHERE
  p.EPR_ID NOT IN ('BS','B','PB')
  AND ip.INV_ID NOT IN ('52015719','52585723','52116940','1023876575','1032380386','1053799116','19380666','52205496','41654902','1022389470')
  AND ( ((TO_CHAR(?)!='ALL') AND (TO_CHAR(ii.DPN_ID) IN (SELECT COLUMN_VALUE FROM TABLE(SPLIT(?))))) OR (TO_CHAR(?)='ALL') )
  AND d.SED_ID IN (SELECT COLUMN_VALUE FROM TABLE(SPLIT(?)))
  AND ( ((TO_CHAR(?)!='ALL') AND (TO_CHAR(cp.CNP_ID) IN (SELECT COLUMN_VALUE FROM TABLE(SPLIT(?))))) OR (TO_CHAR(?)='ALL') )
  AND NVL(p.PRY_ES_JORN_DOCENTE,'N') IN (?)
  AND (
    (TO_CHAR(?)='1' AND ( (((TO_CHAR(?)!='ALL') AND (TO_CHAR(p.EPR_ID) IN (SELECT COLUMN_VALUE FROM TABLE(SPLIT(?))))) OR (TO_CHAR(?)='ALL')) ))
    OR
    (TO_CHAR(?)!='1' AND ( (((TO_CHAR(?)!='ALL') AND (TO_CHAR(hep.EPR_ID) IN (SELECT COLUMN_VALUE FROM TABLE(SPLIT(?))))) OR (TO_CHAR(?)='ALL')) ))
  )
  AND ( ((TO_CHAR(?)!='1') AND hep.HEP_FECHA BETWEEN TO_DATE(?, 'YYYY-MM-DD') AND TO_DATE(?, 'YYYY-MM-DD')) OR (TO_CHAR(?)='1') )
  AND ( ((TO_CHAR(?)!='1') AND d.DPN_FACULTAD = ?) OR (TO_CHAR(?)='1') )

ORDER BY
  PRY_ID,
  DECODE(TO_CHAR(?),'1',fechaEstado,SYSDATE),
  NVL(inf.FECHA_INGRESO, DATE '1900-01-01'),
  inf.TIPO_INFORME</property>
        </oda-data-set>

                </structure>
                <structure>
                    <property name="position">42</property>
                    <property name="name">SEDES_PROYECTO</property>
                    <property name="nativeName">SEDES_PROYECTO</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">43</property>
                    <property name="name">ODS Principal</property>
                    <property name="nativeName">ODS Principal</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">44</property>
                    <property name="name">INF_PIN_ID</property>
                    <property name="nativeName">INF_PIN_ID</property>
                    <property name="dataType">decimal</property>
                </structure>
                <structure>
                    <property name="position">45</property>
                    <property name="name">INF_TIPO_INFORME</property>
                    <property name="nativeName">INF_TIPO_INFORME</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">46</property>
                    <property name="name">INF_FECHA_INGRESO</property>
                    <property name="nativeName">INF_FECHA_INGRESO</property>
                    <property name="dataType">date-time</property>
                </structure>
                <structure>
                    <property name="position">47</property>
                    <property name="name">INF_ESTADO</property>
                    <property name="nativeName">INF_ESTADO</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">48</property>
                    <property name="name">INF_RESPONSABLE_REVISION</property>
                    <property name="nativeName">INF_RESPONSABLE_REVISION</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">49</property>
                    <property name="name">INF_FECHA_REVISION</property>
                    <property name="nativeName">INF_FECHA_REVISION</property>
                    <property name="dataType">date-time</property>
                </structure>
                <structure>
                    <property name="position">50</property>
                    <property name="name">INF_PORC_EJEC_TECNICA</property>
                    <property name="nativeName">INF_PORC_EJEC_TECNICA</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">51</property>
                    <property name="name">INF_PORC_EJEC_PRESUPUESTO</property>
                    <property name="nativeName">INF_PORC_EJEC_PRESUPUESTO</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">52</property>
                    <property name="name">INF_FECHA_DESDE</property>
                    <property name="nativeName">INF_FECHA_DESDE</property>
                    <property name="dataType">date-time</property>
                </structure>
                <structure>
                    <property name="position">53</property>
                    <property name="name">INF_FECHA_HASTA</property>
                    <property name="nativeName">INF_FECHA_HASTA</property>

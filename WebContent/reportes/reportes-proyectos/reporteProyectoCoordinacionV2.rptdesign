                </structure>
                <structure>
                    <property name="position">54</property>
                    <property name="name">INF_CUMPLIDO</property>
                    <property name="nativeName">INF_CUMPLIDO</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">55</property>
                    <property name="name">INF_FECHA_VENC_DESP_PRORROGA</property>
                    <property name="nativeName">INF_FECHA_VENC_DESP_PRORROGA</property>

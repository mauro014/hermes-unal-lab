                    <property name="dataType">date-time</property>
                </structure>
                <structure>
                    <property name="position">41</property>
                    <property name="name">SEDE_ACT</property>
                    <property name="nativeName">SEDE_ACT</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">42</property>
                    <property name="name">SEDES_PROYECTO</property>
                    <property name="nativeName">SEDES_PROYECTO</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">43</property>
                    <property name="name">ODS Principal</property>
                    <property name="nativeName">ODS Principal</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">44</property>
                    <property name="name">FECHA_ENTREGA_INFORME_FINAL</property>
                    <property name="nativeName">FECHA_ENTREGA_INFORME_FINAL</property>
                    <property name="dataType">date-time</property>
                </structure>
                <structure>
                    <property name="position">45</property>
                    <property name="name">ADICIONP</property>
                    <property name="nativeName">ADICIONP</property>
                    <property name="dataType">decimal</property>
                </structure>
                <structure>
                    <property name="position">46</property>
                    <property name="name">FUENTE_FIN</property>
                    <property name="nativeName">FUENTE_FIN</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">47</property>
                    <property name="name">CLASIFICACION_FIN</property>
                    <property name="nativeName">CLASIFICACION_FIN</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">48</property>
                    <property name="name">TIPO_FUENTE_FIN</property>
                    <property name="nativeName">TIPO_FUENTE_FIN</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">49</property>
                    <property name="name">TOTAL_EFECTIVO_FIN</property>
                    <property name="nativeName">TOTAL_EFECTIVO_FIN</property>
                    <property name="dataType">decimal</property>
                </structure>
                <structure>
                    <property name="position">50</property>
                    <property name="name">TOTAL_ESPECIE_FIN</property>
                    <property name="nativeName">TOTAL_ESPECIE_FIN</property>
                    <property name="dataType">decimal</property>
                </structure>
            </list-property>
            <property name="queryText">SELECT
	DISTINCT
	CASE
		to_char(?)
  	WHEN '1' THEN p.PRY_ID
		ELSE NULL
	END PRY_ID,
	CASE
		to_char(?)
  	WHEN '1' THEN p.PRY_NOMBRE
		ELSE NULL
	END PRY_NOMBRE,
	CASE
		to_char(?)
  	WHEN '1' THEN p.PRY_CODIGO_QUIPU
		ELSE NULL
	END PRY_CODIGO_QUIPU,
	CASE
		to_char(?)
  	WHEN '1' THEN d2.DPN_NOMBRE
		ELSE NULL
	END DPN_NOMBRE,
	CASE
		to_char(?)
  	WHEN '1' THEN ep.EPR_NOMBRE
		ELSE NULL
	END estadoActual,
	CASE
		to_char(?)
  	WHEN '1' THEN nvl(dle.DPN_NOMBRE, p.PRY_LUGAR)
		ELSE NULL
	END lugEjec,
	CASE
		to_char(?)
  	WHEN '1' THEN d.DPN_NOMBRE
		ELSE NULL
	END unidad,
	CASE
		to_char(?)
  	WHEN '1' THEN sed.sed_nombre
		ELSE NULL
	END sed_nombre,
	CASE
		to_char(?)
  	WHEN '1' THEN c.CON_TITULO
		ELSE NULL
	END modalidad,
	CASE
		to_char(?)
  	WHEN '1' THEN cp.CNP_TITULO
		ELSE NULL
	END convocatoria,
	CASE
		to_char(?)
  	WHEN '1' THEN p.PRY_FECHA_TENTATIVA_INICIO
		ELSE NULL
	END PRY_FECHA_TENTATIVA_INICIO,
	CASE
		to_char(?)
  	WHEN '1' THEN cp.CNP_ANO
		ELSE NULL
	END anoConvoca,
	CASE
		to_char(?)
  	WHEN '1' THEN decode(LENGTH(cp.DNP_ID), 1, decode(to_char(cp.DNP_ID), '1', 'NACIONAL', 'SEDE'), 4, 'FACULTAD', '')
		ELSE NULL
	END tipoConvoca,
	CASE
		to_char(?)
  	WHEN '1' THEN decode(dd.DOMDET_DESCRIPCION, NULL, 'Proyecto - Convocatoria Interna', dd.DOMDET_DESCRIPCION)
		ELSE NULL
	END tipo,
	CASE
		to_char(?)
	WHEN '1' THEN ( 
				SELECT d.DOMDET_DESCRIPCION
     			FROM HER_DOMINIO_DETALLE d
    			WHERE d.DOM_ID = 117 AND d.DOMDET_TIPO = P.PRY_TIPO_ACTIVIDAD
    			) 
   	 	ELSE NULL
    END TIPO_PROYECTO,
    CASE
    	to_char(?)
    WHEN '1' THEN ( 
    	SELECT DBMS_LOB.SUBSTR(p.PRY_ABSTRACT, 4000, 1) AS RESUMEN_3999
			FROM HER_PROYECTO pr
		WHERE pr.PRY_ID = p.pry_id)
		ELSE NULL
	END RESUMEN,
        CASE
        to_char(?)
    WHEN '1' THEN (
        SELECT MAX(d.DOMDET_DESCRIPCION)
     			FROM HER_DOMINIO_DETALLE d, her_dominio dom
    			WHERE dom.dom_tipo = 'OBJETIVO_SOCIO_ECONOMICO' AND d.DOMDET_TIPO = P.PRY_OBJETIVO_SOCIO_ECONOMICO
    			) 
        ELSE NULL
    END OBJSOCIOEC,
     CASE
        to_char(?)
    WHEN '1' THEN (
        SELECT MAX(d.DOMDET_DESCRIPCION)
     			FROM HER_DOMINIO_DETALLE d, her_proyecto_area_tematica pa
    			WHERE pa.dom_id = d.dom_id AND pa.DOMDET_TIPO = D.DOMDET_TIPO and pa.art_tipo = 1
    			) 
        ELSE NULL
    END OCDEPPL,
	CASE
		to_char(?)
  	WHEN '1' THEN per.PER_NOMBRE1 || decode(per.PER_NOMBRE2, NULL, ' ', ' ' || per.PER_NOMBRE2 || ' ')|| per.PER_APELLIDO1 || decode(per.PER_APELLIDO2, NULL, '', ' ' || per.PER_APELLIDO2)
		ELSE NULL
	END invetigadorPpal,
	CASE
		to_char(?)
  	WHEN '1' THEN pseg.PER_NOMBRE1 || decode(pseg.PER_NOMBRE2, NULL, ' ', ' ' || pseg.PER_NOMBRE2 || ' ')|| pseg.PER_APELLIDO1 || decode(pseg.PER_APELLIDO2, NULL, '', ' ' || pseg.PER_APELLIDO2)
		ELSE NULL
	END coordinador,
	CASE
		to_char(?)
  	WHEN '1' THEN per.TDO_ID || '-' || per.PER_ID
		ELSE NULL
	END documento,
	CASE
		to_char(?)
  	WHEN '1' THEN per.PER_EMAIL
		ELSE NULL
	END correo,
	CASE
		to_char(?)
  	WHEN '1' THEN add_months(p.PRY_FECHA_TENTATIVA_INICIO, decode(p.PRY_DURACION, NULL, 0, p.PRY_DURACION))
		ELSE NULL
	END FFinalPlan,
	CASE
		to_char(?)
  	WHEN '1' THEN add_months(p.PRY_FECHA_TENTATIVA_INICIO, decode(p.PRY_DURACION_ACUMULADA, NULL, 0, p.PRY_DURACION_ACUMULADA)) + decode(p.PRY_DURACION_DIAS_ACUMULADA, NULL, 0, p.PRY_DURACION_DIAS_ACUMULADA)
		ELSE NULL
	END FFinal,
	CASE
		to_char(?)
  	WHEN '1' THEN ip.INP_DEDICACION_HORAS_SEMANA
		ELSE NULL
	END horasSemana,
	CASE
		to_char(?)
  	WHEN '1' THEN DBMS_LOB.substr(p.PRY_OBJETIVO_GENERAL,
		4000)
		ELSE NULL
	END objetivoGeneral,
	CASE
		to_char(?)
  	WHEN '1' THEN p.pry_duracion
		ELSE NULL
	END duracion,
	CASE
		to_char(?)
  	WHEN '1' THEN hap.FECHA
		ELSE NULL
	END "Fecha Aprobación",
	CASE
		WHEN p.EPR_ID IN ('F')
		AND to_char(?)= '1' THEN psf.PSF_VALOR
		ELSE NULL
	END "Valor Ejecutado",
	CASE
		to_char(?)
  	WHEN '1' THEN nvl(p.PRY_CONTRAP_EFECTIVO, 0)+ nvl(p.PRY_CONTRAP_ESPECIE, 0)
		ELSE NULL
	END "Valor Contrapartida UN",
	CASE
		WHEN p.EPR_ID IN ('F')
		AND to_char(?)= '1' THEN hf.FECHA
		ELSE NULL
	END "Cambio Finalizado",
	CASE
		to_char(?)
  	WHEN '1' THEN hp.HEP_FECHA
		ELSE NULL
	END HEP_FECHA,
	CASE
		to_char(?)
  	WHEN '1' THEN vp.SUMA
		ELSE NULL
	END valorPersonal,
	CASE
	to_char(?)
         WHEN '1' THEN (
           SELECT NVL(SUM(NVL(inp.spi_valor_pagar, 0)), 0)
           FROM her_solicitud_prorroga_inv inp
           JOIN her_solicitud s ON s.sol_id = inp.sol_id and s.sol_respuesta = 'A'
           WHERE s.pry_id = p.pry_id
             AND inp.spi_estado NOT IN ('B','N')
         )
         ELSE NULL
       END AS prorrogaspersonal,
	CASE
		to_char(?)
  	WHEN '1' THEN gUN.SUMA
		ELSE NULL
	END gastosUN,
	CASE
		to_char(?)
  	WHEN '1' THEN ve.SUMA
		ELSE NULL
	END valorExterno,
	CASE
		to_char(?)
  	WHEN '1' THEN vee.SUMA
		ELSE NULL
	END valorEspecieExterno,
	CASE
		to_char(?)
  	WHEN '1' THEN tp.SUMA
		ELSE NULL
	END totalParticpantes,
	CASE
		WHEN to_char(?)!= '1' THEN eph.EPR_NOMBRE
		ELSE NULL
	END estado,
	CASE
		WHEN to_char(?)!= '1' THEN hep.hep_fecha
	END fechaEstado,
	CASE
		to_char(?)
  	WHEN '1' THEN sed2.sed_nombre
		ELSE NULL
	END sede_act,
	CASE
		to_char(?)
  	WHEN '1' THEN (
		SELECT
			listagg(hs.SED_NOMBRE , '; ') WITHIN GROUP (
		ORDER BY
			hs.SED_ID)
		FROM
			HER_PROYECTO_DEPENDENCIA hpd
		INNER JOIN HER_DEPENDENCIA hd ON
			hpd.DPN_ID = hd.DPN_ID
		INNER JOIN HER_SEDE hs ON
			hs.SED_ID = hd.sed_ID
		WHERE
			hpd.PRY_ID = p.PRY_ID
		GROUP BY
			hpd.PRY_ID)
		ELSE NULL
	END sedes_proyecto,
	CASE
		to_char(?) WHEN '1' THEN ods.val_nombre_valor
		ELSE NULL
	END "ODS Principal",
	CASE TO_CHAR(?) 
  WHEN '1' THEN (
    SELECT MAX(NVL(pc.COM_FECHA_VENC_PRORROGA, pc.COM_FECHA_VENCIMIENTO))
    FROM HER_PROYECTO_COMPROMISO pc
    WHERE pc.PRY_ID = p.PRY_ID
      AND pc.TIN_ID = 2
  )
  ELSE NULL
END AS FECHA_ENTREGA_INFORME_FINAL,
CASE TO_CHAR(?)
WHEN '1' THEN (select SUM(ad.sap_valor) from her_solicitud_adicion ad, her_solicitud sol where sol.sol_id = ad.sol_id and sol.SOL_RESPUESTA = 'A' and sol.pry_id = p.pry_id) ELSE NULL END AS ADICIONP,

  fin.fuente         AS fuente_fin,
  fin.clasificacion  AS clasificacion_fin,
  fin.tipo           AS tipo_fuente_fin,
  fin.total_efectivo AS total_efectivo_fin,
  fin.total_especie  AS total_especie_fin
	
FROM
	HER_PROYECTO p
LEFT JOIN (
	SELECT
		HER_INVESTIGADOR_PROYECTO.*,
		ROW_NUMBER() OVER (PARTITION BY HER_INVESTIGADOR_PROYECTO.PRY_ID
	ORDER BY
		HER_INVESTIGADOR_PROYECTO.INP_ID DESC) AS x
	FROM
		HER_INVESTIGADOR_PROYECTO
	WHERE
		HER_INVESTIGADOR_PROYECTO.INP_TIPO = 'P') ip ON
	ip.PRY_ID = p.PRY_ID
	AND ip.X = 1
LEFT JOIN HER_INVESTIGADOR_INTERNO ii ON
	ip.INV_ID = ii.INV_ID
	AND ip.TDO_ID = ii.TDO_ID
LEFT JOIN HER_DEPENDENCIA d ON
	ii.DPN_ID = d.DPN_ID
LEFT JOIN HER_DEPENDENCIA d2 ON
	d.DPN_FACULTAD = d2.DPN_ID
LEFT JOIN HER_ESTADO_PROYECTO ep ON
	p.EPR_ID = ep.EPR_ID
LEFT JOIN HER_DEPENDENCIA dle ON
	p.PRY_LUGAR = dle.DPN_ID
LEFT JOIN HER_SEDE sed ON
	d.SED_ID = sed.SED_ID
LEFT JOIN HER_CONVOCATORIA c ON
	p.MOD_ID = c.CON_ID
LEFT JOIN HER_CONVOCATORIA_PADRE cp ON
	c.CNP_ID = cp.CNP_ID
LEFT JOIN HER_DOMINIO_DETALLE dd ON
	p.PRY_TIPO_ACTIVIDAD = dd.DOMDET_TIPO
	AND dd.DOM_ID = '59'
LEFT JOIN HER_PERSONA per ON
	ip.INV_ID = per.PER_ID
	AND ip.TDO_ID = per.TDO_ID
LEFT JOIN HER_SEG_PROYECTO_PERSONA seg ON
	p.PRY_ID = seg.PRY_ID
LEFT JOIN HER_PERSONA pseg ON
	seg.PER_ID = pseg.PER_ID
	AND seg.TDO_ID = pseg.TDO_ID
	AND seg.PER_ID &lt;> '41654907'
LEFT JOIN (
	SELECT
		PRY_ID,
		max(HEP_FECHA) fecha
	FROM
		HER_HISTORICO_ESTADO_PROYECTO
	WHERE
		EPR_ID = 'AP'
	GROUP BY
		PRY_ID) hap ON
	hap.PRY_ID = p.PRY_ID
LEFT JOIN (
	SELECT
		HER_PROYECTO_SAL_FINANCIACION.*,
		ROW_NUMBER() OVER (PARTITION BY HER_PROYECTO_SAL_FINANCIACION.PRY_ID
	ORDER BY
		HER_PROYECTO_SAL_FINANCIACION.PSF_ID DESC) x
	FROM
		HER_PROYECTO_SAL_FINANCIACION) psf ON
	psf.PRY_ID = p.PRY_ID
	AND psf.X = 1
LEFT JOIN (
	SELECT
		PRY_ID,
		max(HEP_FECHA) fecha
	FROM
		HER_HISTORICO_ESTADO_PROYECTO
	WHERE
		EPR_ID = 'F'
	GROUP BY
		PRY_ID) hf ON
	hf.PRY_ID = p.PRY_ID
LEFT JOIN (
	SELECT
		PRY_ID,
		max(HEP_FECHA) HEP_FECHA
	FROM
		HER_HISTORICO_ESTADO_PROYECTO
	WHERE
		EPR_ID = 'P'
	GROUP BY
		PRY_ID) hp ON
	hp.PRY_ID = p.PRY_ID
LEFT JOIN HER_HISTORICO_ESTADO_PROYECTO hep ON
	hep.PRY_ID = p.PRY_ID
LEFT JOIN (
	SELECT
		PRY_ID,
		sum(nvl(ipVP.INP_VALOR_PAGAR, 0)) suma
	FROM
		HER_INVESTIGADOR_PROYECTO ipVP
	GROUP BY
		pry_id) vp ON
	vp.PRY_ID = p.PRY_ID
LEFT JOIN (
	SELECT
		f.PRY_ID,
		sum(nvl(g.GST_VALOR, 0)+ nvl(g.GST_VALOR2, 0)+ nvl(g.GST_VALOR3, 0)+ nvl(g.GST_VALOR4, 0)+ nvl(g.GST_VALOR5, 0)+ nvl(g.GST_VALOR6, 0)) suma
	FROM
		HER_FINANCIACION f,
		HER_GASTO g,
		her_fuente_financiacion ff,
	her_tipo_rubro tp
	WHERE
		f.fin_id = g.fin_id
		and tp.tru_id = g.tru_id
		and tp.TRU_CONTRAPARTIDA &lt;>'1'
		AND f.FFI_ID = ff.FFI_ID
		AND ff.FFI_INTERNA_EXTERNA IN ('I', 'O')
			AND (f.FIN_ES_LEGALIZACION IS NULL
				OR f.FIN_ES_LEGALIZACION = 'NO')
		GROUP BY
			f.PRY_ID) gUN ON
	gUN.PRY_ID = p.PRY_ID
LEFT JOIN (
	SELECT
		f.PRY_ID,
		sum(nvl(gst.GST_VALOR, 0)+ nvl(gst.GST_VALOR2, 0)+ nvl(gst.GST_VALOR3, 0)+ nvl(gst.GST_VALOR4, 0)+ nvl(gst.GST_VALOR5, 0)+ nvl(gst.GST_VALOR6, 0)) suma
	FROM
		HER_FINANCIACION f,
		HER_GASTO GST,
		HER_FUENTE_FINANCIACION ff
	WHERE
		f.fin_id = gst.fin_id
		AND f.FFI_ID = ff.FFI_ID
		AND ff.FFI_INTERNA_EXTERNA IN ('E', 'OE')
			AND f.ffe_tipo_entidad IS NULL
			AND (FIN_ES_LEGALIZACION IS NULL
				OR FIN_ES_LEGALIZACION = 'NO')
		GROUP BY
			f.PRY_ID) ve ON
	ve.PRY_ID = p.PRY_ID
LEFT JOIN (
	SELECT
		f.PRY_ID,
		sum(nvl(gst.GST_VALOR, 0)+ nvl(gst.GST_VALOR2, 0)+ nvl(gst.GST_VALOR3, 0)+ nvl(gst.GST_VALOR4, 0)+ nvl(gst.GST_VALOR5, 0)+ nvl(gst.GST_VALOR6, 0)) suma
	FROM
		HER_FINANCIACION f,
		HER_GASTO GST,
		HER_FUENTE_FINANCIACION ff
	WHERE
		f.fin_id = gst.fin_id
		AND f.FFI_ID = ff.FFI_ID
		AND ff.FFI_INTERNA_EXTERNA IN ('E', 'OE')
			AND f.ffe_tipo_entidad IN ('E')
				AND (FIN_ES_LEGALIZACION IS NULL
					OR FIN_ES_LEGALIZACION = 'NO')
			GROUP BY
				f.PRY_ID) vee ON
	vee.PRY_ID = p.PRY_ID
LEFT JOIN (
	SELECT
		f.PRY_ID,
		sum(nvl(f.fin_VALOR, 0)+ nvl(f.ffe_valor_especie, 0)) suma
	FROM
		HER_FINANCIACION f,
		HER_FUENTE_FINANCIACION ff
	WHERE
		f.FFI_ID = ff.FFI_ID
		AND ff.FFI_INTERNA_EXTERNA IN ('E', 'OE')
			AND f.ffe_tipo_entidad IN ('P')
		GROUP BY
			f.PRY_ID) tp ON
	tp.PRY_ID = p.PRY_ID
LEFT JOIN HER_ESTADO_PROYECTO eph ON
	hep.EPR_ID = eph.EPR_ID
LEFT JOIN HER_HISTORICO_INTEGRANTES hhi ON
	hhi.PRY_ID = p.pry_id
	AND ii.INV_ID = hhi.HCI_PER_ID
	AND ii.TDO_ID = hhi.HCI_TDO_ID
	and hhi.hci_fecha_retiro is null
LEFT JOIN HER_DEPENDENCIA d3 ON
	hhi.DPN_ID = d3.DPN_ID
LEFT JOIN HER_DEPENDENCIA d4 ON
	d4.DPN_ID = d3.DPN_FACULTAD
LEFT JOIN HER_SEDE sed2 ON
	d4.SED_ID = sed2.SED_ID
LEFT JOIN her_proyecto_listas_val ods ON
	p.pry_id = ods.pry_id
	AND ods.val_tipo = 'OBJETIVOS_DESARROLLO_SOSTENIBLE'
	AND ods.val_descripcion = 'OBJETIVO_DESARROLLO_SOSTENIBLE_PRINCIPAL'

LEFT JOIN (
  SELECT 
         f.pry_id AS codigo,
         ff.ffi_descripcion AS fuente,
         DECODE(ff.ffi_interna_externa,
                'I','Interna','E','Externa',
                'O','Interna','OE','Externa','') AS clasificacion,
         DECODE(f.ffe_tipo_entidad,'P','Participante','Financiadora') AS tipo,
         NVL(SUM(
           CASE WHEN tp.tru_contrapartida &lt;> '1'
                THEN NVL(g.gst_valor,0)+NVL(g.gst_valor2,0)+NVL(g.gst_valor3,0)
                     +NVL(g.gst_valor4,0)+NVL(g.gst_valor5,0)+NVL(g.gst_valor6,0)
                ELSE 0 END
         ),0) AS total_efectivo,
         NVL(SUM(
           CASE WHEN tp.tru_contrapartida = '1'
                THEN NVL(g.gst_valor,0)+NVL(g.gst_valor2,0)+NVL(g.gst_valor3,0)
                     +NVL(g.gst_valor4,0)+NVL(g.gst_valor5,0)+NVL(g.gst_valor6,0)
                ELSE 0 END
         ),0) AS total_especie
  FROM her_financiacion f
  LEFT JOIN her_fuente_financiacion ff
         ON ff.ffi_id = f.ffi_id
  LEFT JOIN her_gasto g
         ON g.fin_id = f.fin_id
  LEFT JOIN her_tipo_rubro tp
         ON tp.tru_id = g.tru_id
  WHERE (f.fin_es_legalizacion IS NULL OR f.fin_es_legalizacion = 'NO')
  GROUP BY
         f.pry_id,
         ff.ffi_descripcion,
         DECODE(ff.ffi_interna_externa,
                'I','Interna','E','Externa',
                'O','Interna','OE','Externa',''),
         DECODE(f.ffe_tipo_entidad,'P','Participante','Financiadora')
) fin
  ON fin.codigo = p.PRY_ID


WHERE
	p.EPR_ID NOT IN ('BS', 'B', 'PB')
	AND ip.INV_ID NOT IN ('52015719', '52585723', '52116940', '1023876575', '1032380386', '1053799116', '19380666', '52205496', '41654902', '1022389470')
	AND (((to_char(?)!= 'ALL')
		AND (to_char(ii.DPN_ID) IN (
		SELECT
			COLUMN_VALUE
		FROM
			TABLE(SPLIT(?)))))
		OR (to_char(?)= 'ALL'))
	AND d.SED_ID IN (
	SELECT
		COLUMN_VALUE
	FROM
		TABLE(SPLIT(?)))
	AND (((to_char(?)!= 'ALL')
		AND (to_char(cp.CNP_ID) IN (
		SELECT
			COLUMN_VALUE
		FROM
			TABLE(SPLIT(?)))))
		OR (to_char(?)= 'ALL'))
	AND nvl(p.PRY_ES_JORN_DOCENTE, 'N') IN (?)
	AND (to_char(?)= '1'
		AND ((((to_char(?)!= 'ALL')
			AND (to_char(p.epr_id) IN (
			SELECT
				COLUMN_VALUE
			FROM
				TABLE(SPLIT(?)))))
			OR (to_char(?)= 'ALL')))
			OR (to_char(?)!= '1'
				AND ((((to_char(?)!= 'ALL')
					AND (to_char(hep.epr_id) IN (
					SELECT
						COLUMN_VALUE
					FROM
						TABLE(SPLIT(?)))))
					OR (to_char(?)= 'ALL')))
	))
	AND (
    ((to_char(?)!= '1')
		AND hep.hep_fecha BETWEEN TO_DATE(?, 'YYYY-MM-DD') AND TO_DATE(?, 'YYYY-MM-DD'))
		OR (to_char(?)= '1')
  )
	AND (
    ((to_char(?)!= '1')
		AND d.dpn_facultad = ?)
	OR (to_char(?)= '1')
  )
ORDER BY
	PRY_ID,
	decode(to_char(?), '1', fechaEstado, sysdate)</property>
        </oda-data-set>

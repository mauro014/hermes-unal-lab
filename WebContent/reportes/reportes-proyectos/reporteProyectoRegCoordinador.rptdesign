            <property name="queryText">SELECT
	DISTINCT
	p.PRY_ID,
	p.pry_nombre,
	ep.EPR_NOMBRE estado,
    p.pry_duracion as duracion,
	per.PER_NOMBRE1 || decode(per.PER_NOMBRE2, NULL, ' ', ' ' || per.PER_NOMBRE2 || ' ')|| per.PER_APELLIDO1 || decode(per.PER_APELLIDO2, NULL, '', ' ' || per.PER_APELLIDO2) invetigadorPpal,
	sed.sed_nombre,
	d2.dpn_nombre facultad,
    decode(loc.PLO_ROL_UNIVERSIDAD,'EJ','Ejecutora','OP','Operadora','' )rol_universidad, 
    loc.PLO_COD_SIGP Código_SIGP_ACTeI,
    loc.PLO_NUM_APROB_OCAD acuerdo_OCAD,
    loc.PLO_COD_BPIN bpin,
    loc.PLO_OCAD_APRUEBA ocad_aprueba,
    loc.PLO_FECHA_APRUEBA fecha_aprobacion,
    loc.PLO_TIENE_PRY_EXTENSION tiene_pry_extension,
    loc.PLO_VALOR_APROB_SGR valor_regalias,
    loc.PLO_VALOR_APROB_OTRA_FIN valor_otra_financacion,
    loc.PLO_VALOR_PARTICIPANTES valor_participantes,
    ff.ffi_descripcion entidad_ejecutora,
    loc.PLO_NOMBRE_SUPERVISOR supervisor,
    a.AVI_ID as aval,
    a.convocatoria as convocatoriaExterna,
    a.avi_entidad as entidadExterna,
    decode(a.AVI_ESTADO || a.AVI_AVALFACULTAD || a.AVI_AVALDIRECCION || a.AVI_AVALVICE || a.AVI_AVALDRE, NULL, 'Pendiente por revisión', 'C', 'Devuelto para correcciones', 'I', 'Enviado',
    'FS', 'Aprobado en facultad', 'FN', 'No aprobado en facultad', 'DSS', 'Aprobado en dirección de investigación', 'DSN', 'No aprobado en dirección de investigación',
    'VSSS', 'Aprobado en Vicerrectoría de Investigación', 'VSSN', 'No aprobado en Vicerrectoría de Investigación', 'P', 'Formulación', 'B', 'Solicitud anulada', 'IF', 'Enviado a la facultad', 'ISS', 'Enviado a la sede', 'RDSSS', 'Aprobado en Dirección de Relaciones Exteriores', 'RDSSN', 'No Aprobado en Dirección de Relaciones Exteriores',
    'EP','Enviado CEPI',
    'SP','Aprobado CEPI',
    'NP','No Aprobado CEPI',
    'CP','Devuelto CEPI',
    'ES','Enviado CESI',
    'SS','Aprobado CESI',
    'NS','No Aprobado CESI', '') estado_aval,
    A.TIPO_AVAL
FROM 
	HER_PROYECTO p 
left join HER_PROYECTO_LEG_OCAD loc on loc.pry_id = p.pry_id
left join her_fuente_financiacion ff on ff.ffi_id = loc.FFI_ID_EJECUTORA
LEFT JOIN HER_ESTADO_PROYECTO ep ON
	p.EPR_ID = ep.EPR_ID
JOIN (
	SELECT
		HER_AVAL.PRY_ID,
		HER_AVAL.AVI_ID,
		FF.FFI_DESCRIPCION AS AVI_ENTIDAD,
		decode(CE.CEX_ID, NULL, HER_AVAL.AVI_CONVOCATORIA, CE.CEX_NOMBRE)convocatoria,
		HER_AVAL.AVI_ESTADO, HER_AVAL.AVI_AVALFACULTAD, HER_AVAL.AVI_AVALDIRECCION, HER_AVAL.AVI_AVALVICE, HER_AVAL.AVI_AVALDRE,
		DD.DOMDET_DESCRIPCION AS TIPO_AVAL
		FROM
		HER_AVAL
		left join her_dominio_detalle dd on dd.dom_id = '81' and dd.domdet_tipo = HER_AVAL.avi_tipo
	LEFT JOIN HER_FUENTE_FINANCIACION FF ON
		FF.FFI_ID = AVI_ENTIDAD
	left join her_convocatoria_externa ce on ce.Cex_ID = her_aval.avi_convocatoria
	WHERE
		HER_AVAL.AVI_AVALDIRECCION = 'S'
		AND her_aval.avi_estado &lt;> 'B'
		AND HER_AVAL.AVI_TIPO IN ('PSR','SR','PCR','VRSR')) a ON a.PRY_ID = p.PRY_ID
LEFT JOIN (
	SELECT
		HER_INVESTIGADOR_PROYECTO.*,
		ROW_NUMBER() OVER (PARTITION BY HER_INVESTIGADOR_PROYECTO.PRY_ID
	ORDER BY
		HER_INVESTIGADOR_PROYECTO.INP_ID DESC) x
	FROM
		HER_INVESTIGADOR_PROYECTO
	WHERE
		HER_INVESTIGADOR_PROYECTO.INP_TIPO = 'P') ip ON
	p.PRY_ID = ip.PRY_ID
	AND ip.X = 1
LEFT JOIN HER_PERSONA per ON
	per.TDO_ID = ip.TDO_ID
	AND ip.INV_ID = per.PER_ID
LEFT JOIN HER_INVESTIGADOR_INTERNO ii ON
	ip.inv_id = ii.inv_id
	AND ip.tdo_id = ii.tdo_id
LEFT JOIN HER_DEPENDENCIA d ON
	ii.dpn_id = d.dpn_id
LEFT JOIN HER_SEDE sed ON
	d.sed_id = sed.sed_id
LEFT JOIN HER_DEPENDENCIA d2 ON
	d.dpn_facultad = d2.dpn_id
WHERE 
	p.MOD_ID IN (10)
	AND ep.epr_id NOT IN ('BS', 'B', 'PB')
	AND per.PER_ID NOT IN ('52015719', '52585723', '52116940', '1023876575', '1032380386', '1053799116', '19380666', '52205496', '41654902', '1022389470')
	AND (p.PRY_FECHA_LEGALIZAC IS NOT NULL)
	AND d.sed_id IN (
	SELECT
		COLUMN_VALUE
	FROM
		TABLE(SPLIT(?)))
	AND (? = 'ALL'
		OR ii.dpn_id IN (
		SELECT
			COLUMN_VALUE
		FROM
			TABLE(SPLIT(?))))
ORDER BY
	p.PRY_ID</property>
        </oda-data-set>
    </data-sets>

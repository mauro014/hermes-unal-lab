                    <property name="position">15</property>
                    <property name="name">CALIFICACION</property>
                    <property name="nativeName">CALIFICACION</property>
                    <property name="dataType">decimal</property>
                </structure>
                <structure>
                    <property name="position">16</property>
                    <property name="name">RECOMENDACION_EVALUADOR</property>
                    <property name="nativeName">RECOMENDACION_EVALUADOR</property>
                    <property name="dataType">string</property>
                </structure>
            </list-property>
            <property name="queryText">SELECT 
	DISTINCT pry.pry_id, pry.pry_nombre, d2.dpn_nombre, ep.EPR_NOMBRE as estado, d.dpn_nombre as unidad,
	sed.sed_nombre, c.CON_TITULO as modalidad, cp.CNP_TITULO as convocatoria,
	p.PER_NOMBRE1||' '||DECODE(p.PER_NOMBRE2, p.PER_NOMBRE2,p.PER_NOMBRE2,NULL,' ')||' '||p.PER_APELLIDO1||' '||DECODE(p.PER_APELLIDO2, p.PER_APELLIDO2,p.PER_APELLIDO2,NULL,' ') invetigadorPpal,
	p.PER_EMAIL as correo, p.TDO_ID || '-' || p.PER_ID as documento,
	per.PER_NOMBRE1||' '||DECODE(per.PER_NOMBRE2,per.PER_NOMBRE2,per.PER_NOMBRE2,NULL,' ')||' '||per.PER_APELLIDO1||' '||DECODE(per.PER_APELLIDO2,per.PER_APELLIDO2,per.PER_APELLIDO2,NULL,' ') evaluador,
	 per.TDO_ID || '-' || per.PER_ID as documentoEvaluador,
decode(pev.PRE_ESTADO_EVALUACION,null,'Pendiente','P','En proceso','S','Finalizada','Pendiente')estado_evaluacion,
pev.PRE_CALIFICACION_FINAL as calificacion,
decode(pev.PRE_CONCEPTO,null,'Pendiente','A','Aprobar','E','Aprobar con recomendaciones','N','No aprobar','Pendiente')recomendacion_evaluador
FROM 
	HER_PROYECTO pry left join HER_PROYECTO_EVALUADOR pev on pry.pry_id = pev.PRY_ID left join her_persona per on pev.INV_ID = per.per_id and pev.TDO_ID = per.TDO_ID, 
	HER_INVESTIGADOR_PROYECTO ip, HER_INVESTIGADOR_INTERNO ii, HER_DEPENDENCIA d, HER_DEPENDENCIA d2,
	HER_SEDE sed, HER_CONVOCATORIA c, HER_CONVOCATORIA_PADRE cp, HER_PERSONA p, HER_ESTADO_PROYECTO ep
WHERE 
	pry.pry_id in (SELECT COLUMN_VALUE FROM TABLE(SPLIT(?1))) 
	and ip.pry_id = pry.pry_id 
	and ip.inv_id = ii.inv_id 
	and ip.tdo_id = ii.tdo_id 
	and ip.inv_id = p.per_id
	and ip.tdo_id = p.tdo_id 
	and ii.dpn_id = d.dpn_id 
	and ip.inp_tipo = 'P' 
	and	d.dpn_facultad = d2.dpn_id 
	and d.sed_id = sed.sed_id
	and pry.MOD_ID = c.CON_ID
	and c.CNP_ID = cp.CNP_ID
	and pry.EPR_ID = ep.EPR_ID
	AND pry.epr_id not in ('B')
order by pry.pry_id asc</property>
        </oda-data-set>
    </data-sets>

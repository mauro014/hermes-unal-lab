            <property name="queryText">SELECT 
	decode(GP.GRU_ID,NULL,'SIN GRUPO RELACIONADO',GRU_NOMBRE) as NOMBRE_GRUPO
FROM 
	HER_GRUPO_PROYECTO gp left join HER_GRUPO g on g.GRU_ID = gp.GRU_ID
WHERE 
	gp.PRY_ID = ?
	order by g.GRU_NOMBRE asc</property>
        </oda-data-set>

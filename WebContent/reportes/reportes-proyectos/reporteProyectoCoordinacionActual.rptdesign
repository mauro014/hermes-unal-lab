            <property name="dataSource">Produccion</property>
            <list-property name="parameters">
                <structure>
                    <property name="name">pry_id</property>
                    <property name="dataType">integer</property>
                    <property name="position">1</property>
                    <expression name="defaultValue">21342</expression>
                    <property name="isInput">true</property>
                    <property name="isOutput">false</property>
                </structure>
            </list-property>
            <list-property name="resultSet">
                <structure>
                    <property name="position">1</property>
                    <property name="name">DOCUMENTO</property>
                    <property name="nativeName">DOCUMENTO</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">2</property>
                    <property name="name">UNIDAD</property>
                    <property name="nativeName">UNIDAD</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">3</property>
                    <property name="name">DOCENTE</property>
                    <property name="nativeName">DOCENTE</property>
                    <property name="dataType">string</property>
                </structure>
            </list-property>
            <property name="queryText">select (ip.tdo_id||'-'||ip.inv_id)documento, d.dpn_nombre as unidad,
p.PER_NOMBRE1||' '||DECODE(p.PER_NOMBRE2, p.PER_NOMBRE2,p.PER_NOMBRE2,NULL,' ')||' '||p.PER_APELLIDO1||' '||DECODE(p.PER_APELLIDO2, p.PER_APELLIDO2,p.PER_APELLIDO2,NULL,' ') docente
from her_investigador_proyecto ip left join her_persona p on p.per_id = ip.inv_id and p.tdo_id = ip.tdo_id
left join her_investigador_interno ii on ip.inv_id = ii.inv_id and ip.tdo_id = ii.tdo_id
left join her_dependencia d on d.dpn_id = ii.dpn_id
where ip.INP_TIPO IN ('P','PCD','PSCD') 
AND IP.INV_ID NOT IN ('PCD0000','PSCD0000') 
AND IP.PRY_ID = ?</property>
        </oda-data-set>
    </data-sets>

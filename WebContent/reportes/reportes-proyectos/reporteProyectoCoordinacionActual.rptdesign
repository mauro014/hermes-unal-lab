            <property name="queryText">SELECT 
	sum(nvl(f.fin_VALOR,0)+nvl(f.ffe_valor_especie,0)) as totalParticpantes
FROM 
	HER_FINANCIACION f, HER_FUENTE_FINANCIACION ff 
WHERE 
	f.PRY_ID = ?
	and f.FFI_ID = ff.FFI_ID
	and ff.FFI_INTERNA_EXTERNA in ('E','OE')
	and f.ffe_tipo_entidad in ('P')</property>
        </oda-data-set>

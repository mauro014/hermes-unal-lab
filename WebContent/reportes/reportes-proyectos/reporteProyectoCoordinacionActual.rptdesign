            <property name="queryText">select p.TDO_ID || '-' || ip.inv_id as documentoEstudiante, p.per_nombre1 || ' ' ||  p.per_nombre2 || ' ' ||  p.per_apellido1 
|| ' ' ||  p.per_apellido2  as nombre,P.PER_EMAIL AS CORREO, ti.tinv_nombre , pe.ple_nombre, tne.TNE_NOMBRE
from her_investigador_proyecto ip, her_persona p, her_tmp_estudiante e, her_plan_estudios pe, her_tipo_nivel_estudios tne, her_tipo_investigador ti
 where ip.pry_id = ? and
 p.per_id = ip.inv_id and p.tdo_id = ip.tdo_id and e.EST_ID = p.per_id and e.TDO_ID = p.tdo_id
 and e.EST_PLAN = pe.ple_id and tne.TNE_ID = pe.TNE_ID and ti.TINV_ID = ip.INP_TIPO and ti.tinv_tipo = 'A'</property>
        </oda-data-set>

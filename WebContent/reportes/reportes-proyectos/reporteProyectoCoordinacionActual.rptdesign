            <property name="queryText">SELECT 
	decode(sum(ip.INP_VALOR_PAGAR), NULL, 0, sum(ip.INP_VALOR_PAGAR)) as valorPersonal
FROM 
	HER_INVESTIGADOR_PROYECTO ip 
WHERE 
	ip.PRY_ID = ?
	and ip.PRY_ID not in (select distinct PRY_ID from HER_PROYECTO where MOD_ID in (787,788))</property>

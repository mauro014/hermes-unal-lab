            <list-property name="resultSet">
                <structure>
                    <property name="position">1</property>
                    <property name="name">FECHA</property>
                    <property name="nativeName">FECHA</property>
                    <property name="dataType">date-time</property>
                </structure>
                <structure>
                    <property name="position">2</property>
                    <property name="name">ESTADOINFORME</property>
                    <property name="nativeName">ESTADOINFORME</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">3</property>
                    <property name="name">PORC_EJEC</property>
                    <property name="nativeName">PORC_EJEC</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">4</property>
                    <property name="name">PORC_EJEC_PRE</property>
                    <property name="nativeName">PORC_EJEC_PRE</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">5</property>
                    <property name="name">FECHA_DESDE</property>
                    <property name="nativeName">FECHA_DESDE</property>
                    <property name="dataType">date-time</property>
                </structure>
                <structure>
                    <property name="position">6</property>
                    <property name="name">FECHA_HASTA</property>
                    <property name="nativeName">FECHA_HASTA</property>
                    <property name="dataType">date-time</property>
                </structure>
                <structure>
                    <property name="position">7</property>
                    <property name="name">ENCREV</property>
                    <property name="nativeName">ENCREV</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">8</property>
                    <property name="name">COM_FECHA_NOTIFICACION</property>
                    <property name="nativeName">COM_FECHA_NOTIFICACION</property>
                    <property name="dataType">date-time</property>
                </structure>
                <structure>
                    <property name="position">9</property>
                    <property name="name">COMPCUMPLIDO</property>
                    <property name="nativeName">COMPCUMPLIDO</property>
                    <property name="dataType">string</property>
                </structure>
            </list-property>
            <property name="queryText">SELECT distinct
	hei.hei_FECHA as fecha,
	ei.EIN_NOMBRE as estadoInforme,
	pi.PIN_PORC_EJEC porc_ejec,
	pi.PIN_PORC_EJEC_PRE porc_ejec_pre ,
	pi.PIN_FECHA_DESDE fecha_desde ,
	pi.PIN_FECHA_HASTA fecha_hasta
	,case
		when pi.EIN_ID in (4,7) then
			(select per.PER_NOMBRE1||decode(per.PER_NOMBRE2,null,' ',' '||per.PER_NOMBRE2||' ')||per.PER_APELLIDO1||decode(per.PER_APELLIDO2,null,'',' '||per.PER_APELLIDO2)
				from HER_PERSONA per
				where per.PER_ID=pi.PER_ID_REVISION_FACULTAD
					and per.TDO_ID=pi.TDO_ID_REVISION_FACULTAD)
		when pi.EIN_ID in (3) then
			(select per.PER_NOMBRE1||decode(per.PER_NOMBRE2,null,' ',' '||per.PER_NOMBRE2||' ')||per.PER_APELLIDO1||decode(per.PER_APELLIDO2,null,'',' '||per.PER_APELLIDO2)
				from HER_PERSONA per
				where per.PER_ID=pi.PER_ID_REVISION_COORDINADOR
					and per.TDO_ID=pi.TDO_ID_REVISION_COORDINADOR)
	end encRev
	, pc.COM_FECHA_NOTIFICACION
	, decode(pc.COM_CUMPLIDO,'S','SI','N','NO') CompCumplido
FROM 
	HER_PROYECTO_INFORME pi
	left join (select PIN_ID,EIN_ID, MAX(HEI_FECHA) HEI_FECHA from HER_HISTORICO_ESTADO_INFORME group by PIN_ID,EIN_ID) hei on hei.pin_id = pi.pin_id and hei.ein_id = 2
	left join HER_PROYECTO_COMPROMISO pc on pi.COM_ID = pc.COM_ID, HER_TIPO_INFORME ti, HER_ESTADO_INFORME ei
WHERE 
	pi.PRY_ID = ?
	and pi.TIN_ID = ti.TIN_ID
	and ti.TIN_ID = 2
	and PI.EIN_ID &lt;> 0
	and pi.EIN_ID = ei.EIN_ID
	order by fecha asc</property>
        </oda-data-set>
        <oda-data-set extensionID="org.eclipse.birt.report.data.oda.jdbc.JdbcSelectDataSet" name="AreasProyecto" id="9829">
            <structure name="cachedMetaData">
                <list-property name="resultSet">
                    <structure>
                        <property name="position">1</property>
                        <property name="name">TIPO</property>
                        <property name="dataType">string</property>
                    </structure>
                    <structure>
                        <property name="position">2</property>
                        <property name="name">AREA</property>
                        <property name="dataType">string</property>
                    </structure>
                </list-property>
            </structure>
            <property name="dataSource">Produccion</property>
            <list-property name="parameters">
                <structure>
                    <property name="name">pry_id</property>
                    <property name="dataType">integer</property>
                    <property name="position">1</property>
                    <expression name="defaultValue">21342</expression>
                    <property name="isInput">true</property>
                    <property name="isOutput">false</property>
                </structure>
            </list-property>
            <list-property name="resultSet">
                <structure>
                    <property name="position">1</property>
                    <property name="name">TIPO</property>
                    <property name="nativeName">TIPO</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">2</property>
                    <property name="name">AREA</property>
                    <property name="nativeName">AREA</property>
                    <property name="dataType">string</property>
                </structure>
            </list-property>
            <property name="queryText">select distinct *
from 
(SELECT
  decode(pa.ART_TIPO,1,'Principal',2,'Secundaria') Tipo,
  decode(dd2.DOMDET_DESCRIPCION,null,cc.CLC_NOMBRE,dd2.DOMDET_DESCRIPCION||'('||dd.DOMDET_DESCRIPCION||')') area
FROM 
	HER_PROYECTO P LEFT JOIN HER_PROYECTO_AREA_TEMATICA pa ON P.PRY_ID = PA.PRY_ID 
	left join HER_DOMINIO_DETALLE dd on (pa.dom_id = dd.dom_id and dd.dom_id in ('27','68') and pa.domdet_tipo = dd.domdet_tipo)
	left join HER_DOMINIO_DETALLE dd2 on dd2.DOMDET_TIPO=dd.DOMDET_ESTADO
	left join HER_PROYECTO_CLAS_CON pcc on p.pry_id = pcc.pry_id
	left join her_clasificacion_conocimiento cc on pcc.clc_id = cc.clc_id 
where P.PRY_ID=?
	and nvl(pa.ART_TIPO,2) in (1,2)
	and decode(dd2.DOMDET_DESCRIPCION,null,cc.CLC_NOMBRE,dd2.DOMDET_DESCRIPCION||'('||dd.DOMDET_DESCRIPCION||')') is not null
	)
order by tipo,area asc</property>
        </oda-data-set>
        <oda-data-set extensionID="org.eclipse.birt.report.data.oda.jdbc.JdbcSelectDataSet" name="docentes" id="10104">
            <structure name="cachedMetaData">
                <list-property name="resultSet">
                    <structure>
                        <property name="position">1</property>
                        <property name="name">DOCUMENTO</property>

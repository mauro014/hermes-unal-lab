            <property name="queryText">SELECT
  --SUM(nvl(g.GST_VALOR2,0) + nvl(g.GST_VALOR3,0) + nvl(g.GST_VALOR4,0) + nvl(g.GST_VALOR5,0) + nvl(g.GST_VALOR6,0)) as valorEspecieExterno,
  sum(nvl(g.GST_VALOR,0)) as valorExterno
FROM HER_GASTO g, 
  HER_TIPO_RUBRO tr,
  HER_FUENTE_FINANCIACION ff,
  HER_FINANCIACION f
WHERE g.fin_ID = f.fin_ID 
  AND ff.FFI_ID = f.FFI_ID 
  AND g.tru_id =tr.TRU_ID
  and f.PRY_ID = ?
  AND tr.TRU_ID NOT IN (93, 149, 150)
  and ff.FFI_INTERNA_EXTERNA in ('E')
  AND  (F.FFE_TIPO_ENTIDAD = 'F' OR F.FFE_TIPO_ENTIDAD is null)
  AND (FIN_ES_LEGALIZACION IS NULL OR  FIN_ES_LEGALIZACION = 'NO')
</property>

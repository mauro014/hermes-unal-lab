                <structure>
                    <property name="position">1</property>
                    <property name="name">VALORTOTAL</property>
                    <property name="nativeName">VALORTOTAL</property>
                    <property name="dataType">decimal</property>
                </structure>
            </list-property>
            <property name="queryText">select sum(total) AS VALORTOTAL from(
   SELECT sum(UN.valorEfectivoUN) + sum(UN.valorEspecieUN) as total, un.pry_id            
    FROM
      (SELECT
        decode(sum(f.FIN_VALOR), NULL, 0, sum(f.FIN_VALOR)) as valorEfectivoUN,
        decode(sum(f.FFE_VALOR_ESPECIE), NULL, 0, sum(f.FFE_VALOR_ESPECIE)) as valorEspecieUN, f.pry_id       
          FROM
          HER_FINANCIACION f, HER_FUENTE_FINANCIACION ff
          WHERE
          f.PRY_ID = ?
          and f.FFI_ID = ff.FFI_ID
          and ff.FFI_INTERNA_EXTERNA in ('I','O')
          group by f.PRY_ID
           ) UN group by un.pry_id
     union
           
           select decode(sum(ip.INP_VALOR_PAGAR), NULL, 0, sum(ip.INP_VALOR_PAGAR)) total, ip.PRY_ID
           from her_investigador_proyecto ip 
            WHERE ip.PRY_ID = ? group by ip.PRY_ID
    union 
       SELECT sum(UN.valorEfectivoUN) + sum(UN.valorEspecieUN) as total, un.pry_id            
        FROM
          (SELECT
            decode(sum(f.FIN_VALOR), NULL, 0, sum(f.FIN_VALOR)) as valorEfectivoUN,
            decode(sum(f.FFE_VALOR_ESPECIE), NULL, 0, sum(f.FFE_VALOR_ESPECIE)) as valorEspecieUN, f.pry_id       
              FROM
              HER_FINANCIACION f, HER_FUENTE_FINANCIACION ff
              WHERE
              f.PRY_ID = ?
              and f.FFI_ID = ff.FFI_ID
              and ff.FFI_INTERNA_EXTERNA in ('E','O')
              group by f.PRY_ID
               ) UN group by un.pry_id
    )</property>
        </oda-data-set>

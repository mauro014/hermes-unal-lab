                </structure>
            </list-property>
            <property name="queryText">SELECT DISTINCT
    pia.PIA_CODIGO_INFORME_ANLA AS CODIGO_INFORME_ANLA,
    pia.PIA_NUMERO_INFORME_ANLA AS NUMERO_INFORME_ANLA,
    pia.PIA_FECHA_ENVIO_INFORME_ANLA AS FECHA_ENVIO,
    pia.PIA_NUMERO_OFICIO_VRI AS OFICIO_CONSECUTIVO_VRI,
    CASE 
        WHEN aia.AIA_ID IS NOT NULL THEN 'SI'
        ELSE 'NO'
    END AS CUENTA_CON_ADJUNTOS,

    pry.PRY_ID AS ID_PROYECTO,
    pry.PRY_NOMBRE AS NOMBRE_PROYECTO,
    prof.PER_NOMBRE1 || ' ' || NVL(prof.PER_NOMBRE2, '') || ' ' || prof.PER_APELLIDO1 || ' ' || NVL(prof.PER_APELLIDO2, '') AS PROFESOR,
    dep.DPN_NOMBRE AS FACULTAD,
    sede.SED_NOMBRE AS SEDE

FROM HER_PERMISO_INFORME_ANLA pia
LEFT JOIN HER_ARCHIVO_INFORME_ANLA aia ON aia.PIA_ID = pia.PIA_ID

LEFT JOIN HER_PROYECTO_INFORME pin ON pin.PIN_NRO_INFORME_ANLA = pia.PIA_NUMERO_INFORME_ANLA

LEFT JOIN HER_PROYECTO pry ON pry.PRY_ID = pin.PRY_ID

LEFT JOIN HER_INVESTIGADOR_PROYECTO ip ON ip.PRY_ID = pry.PRY_ID AND ip.INP_TIPO = 'P'
LEFT JOIN HER_PERSONA prof ON prof.PER_ID = ip.INV_ID AND prof.TDO_ID = ip.TDO_ID

LEFT JOIN HER_INVESTIGADOR_INTERNO ii ON ii.INV_ID = ip.INV_ID AND ii.TDO_ID = ip.TDO_ID
LEFT JOIN HER_DEPENDENCIA dep ON dep.DPN_ID = ii.DPN_ID
LEFT JOIN HER_SEDE sede ON sede.SED_ID = dep.SED_ID

WHERE pia.PIA_ELIMINADO IS NULL
ORDER BY pia.PIA_NUMERO_INFORME_ANLA</property>
        </oda-data-set>
    </data-sets>

                    <property name="name">CODCOLCIENCIAS</property>
                    <property name="nativeName">CODCOLCIENCIAS</property>
                    <property name="dataType">string</property>
                    <property name="nativeDataType">12</property>
                </structure>
                <structure>
                    <property name="position">4</property>
                    <property name="name">FACULTAD</property>
                    <property name="nativeName">FACULTAD</property>
                    <property name="dataType">string</property>
                    <property name="nativeDataType">12</property>
                </structure>
                <structure>
                    <property name="position">5</property>
                    <property name="name">SEDE</property>
                    <property name="nativeName">SEDE</property>
                    <property name="dataType">string</property>
                    <property name="nativeDataType">12</property>
                </structure>
                <structure>
                    <property name="position">6</property>
                    <property name="name">PERMISO</property>
                    <property name="nativeName">PERMISO</property>
                    <property name="dataType">string</property>
                    <property name="nativeDataType">12</property>
                </structure>
            </list-property>
            <property name="queryText">select distinct 
max(g.GRU_ID) as id,
max(g.GRU_NOMBRE) as grupo,  
max(g.GRU_COLCIENCIAS) as codColciencias,
max(d.dpn_nombre) as facultad,
max(s.sed_nombre) as sede,
max(pb.peb_nombre) as permiso
 
from HER_AVAL a left join HER_PERMISO_BIODIVERSIDAD pb on a.avi_convocatoria = pb.peb_id, HER_GRUPO g, HER_INVESTIGADOR_INTERNO ii,
HER_DEPENDENCIA d, her_sede s

where ii.INI_PERMISO_MARCO = 'S' 
and g.GRU_ID = a.AVI_GRUPO and a.AVI_MODALIDAD_DOC = 'I' 
and a.INV_ID = ii.INV_ID and a.TDO_ID = ii.TDO_ID 
and g.dpn_id = d.dpn_id
and s.sed_id = g.sed_id
and a.AVI_ESTADO = 'F' and a.AVI_AVALFACULTAD = 'S' and a.AVI_TIPO = 'BI' 
group by g.GRU_ID order by id
</property>
        </oda-data-set>
    </data-sets>

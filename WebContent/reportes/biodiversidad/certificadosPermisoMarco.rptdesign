            <property name="queryText">select pry.PRY_ID AS IDPRY,
ep.EPR_NOMBRE AS ESTADO,
pry.PRY_NOMBRE AS NOMBRE,
decode(pry.PRY_TIENE_COMPROM_PEND,'S','SI','N','NO','E','ENVIADO: PENDIENTE POR REVISAR','--') AS COMPROMISOS,
sol.SOL_ID AS ID_SOLICITUD,
sol.SOL_FECHA AS fechaSolicitud,
decode(sol.SOL_RESPUESTA,null,'Sin respuesta','A','Aprobada','R','Rechazada','T','En estudio/trámite','C','Devuelta para correcciones')estadoSolicitud,
sol.SOL_FECHA_REVISION as fechaTramite,
p.PER_NOMBRE1||' '||DECODE(p.PER_NOMBRE2, p.PER_NOMBRE2,p.PER_NOMBRE2,NULL,' ')||' '||p.PER_APELLIDO1||' '||DECODE(p.PER_APELLIDO2, p.PER_APELLIDO2,p.PER_APELLIDO2,NULL,' ') investigador,
p.PER_ID AS documento,
p.TDO_ID AS tipoDocumento,
DECODE(pry.mod_id,'150','Permiso de proyecto 2014','652','Permiso de asignatura 2014','1344','Permiso de proyecto 2024','1345','Permiso de asignatura 2024')tipo,
PC.PCA_ID AS IDCARTA,
PC.PCA_SEQ as secuencia

from HER_SOLICITUD sol 
left join HER_PROYECTO_CARTA PC ON PC.SOL_ID = SOL.SOL_ID and pc.etc_id not in ('B')
left join HER_PROYECTO pry on sol.PRY_ID = PRY.PRY_ID left join HER_INVESTIGADOR_PROYECTO ip
on ip.pry_id = pry.pry_id and ip.INP_TIPO = 'P' left join her_persona p on ip.inv_id = p.per_id and ip.tdo_id = p.tdo_id, HER_ESTADO_PROYECTO ep

where pry.MOD_ID in ('150','652','1344','1345') AND pry.EPR_ID not in ('B')
and pry.EPR_ID = ep.EPR_ID AND sol.TSO_ID = '29' and (sol.SOL_RESPUESTA not in ('G') or sol.SOL_RESPUESTA is null )
order by IDPRY,fechaSolicitud

</property>
        </oda-data-set>
    </data-sets>

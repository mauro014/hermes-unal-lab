            <property name="queryText">select av.avi_ID as idSolicitud, 
p.PER_NOMBRE1||' '||DECODE(p.PER_NOMBRE2, p.PER_NOMBRE2,p.PER_NOMBRE2,NULL,' ')||' '||p.PER_APELLIDO1||' '||DECODE(p.PER_APELLIDO2, p.PER_APELLIDO2,p.PER_APELLIDO2,NULL,' ') investigador,
p.PER_ID AS documento,
p.TDO_ID AS tipoDocumento,
av.avi_FECHAregistro as fecha,
d.dpn_nombre as escuela,
d2.dpn_nombre as facultad,
s.sed_nombre as sede,
G.GRU_NOMBRE AS GRUPO,
g.gru_colciencias as codCol


from HER_AVAL av left join HER_INVESTIGADOR_INTERNO ii on ii.INV_ID = AV.INV_ID AND II.TDO_ID = AV.TDO_ID 
left join her_persona p on ii.inv_id = p.per_id and ii.tdo_id = p.tdo_id left join HER_GRUPO G ON G.GRU_ID = AV.AVI_GRUPO,
her_dependencia d left join her_dependencia d2 on d.dpn_facultad = d2.dpn_id left join her_sede s on d2.sed_id = s.sed_id
where av.avi_tipo in ('AR') and ii.dpn_id = d.dpn_id

</property>
        </oda-data-set>
    </data-sets>

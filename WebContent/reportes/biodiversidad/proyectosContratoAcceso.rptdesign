                    <property name="nativeDataType">12</property>
                </structure>
                <structure>
                    <property name="position">4</property>
                    <property name="name">COMPROMISOS</property>
                    <property name="nativeName">COMPROMISOS</property>
                    <property name="dataType">string</property>
                    <property name="nativeDataType">12</property>
                </structure>
                <structure>
                    <property name="position">5</property>
                    <property name="name">INVESTIGADOR</property>
                    <property name="nativeName">INVESTIGADOR</property>
                    <property name="dataType">string</property>
                    <property name="nativeDataType">12</property>
                </structure>
                <structure>
                    <property name="position">6</property>
                    <property name="name">DOCUMENTO</property>
                    <property name="nativeName">DOCUMENTO</property>
                    <property name="dataType">string</property>
                    <property name="nativeDataType">12</property>
                </structure>
                <structure>
                    <property name="position">7</property>
                    <property name="name">TIPODOCUMENTO</property>
                    <property name="nativeName">TIPODOCUMENTO</property>
                    <property name="dataType">string</property>
                    <property name="nativeDataType">12</property>
                </structure>
                <structure>
                    <property name="position">8</property>
                    <property name="name">MODALIDAD</property>
                    <property name="nativeName">MODALIDAD</property>
                    <property name="dataType">string</property>
                    <property name="nativeDataType">12</property>
                </structure>
            </list-property>
            <property name="queryText">select pry.PRY_ID AS IDPRY,
ep.EPR_NOMBRE AS ESTADO,
pry.PRY_NOMBRE AS NOMBRE,
decode(pry.PRY_TIENE_COMPROM_PEND,'S','SI','N','NO','E','ENVIADO: PENDIENTE POR REVISAR','--') AS COMPROMISOS,
p.PER_NOMBRE1||' '||DECODE(p.PER_NOMBRE2, p.PER_NOMBRE2,p.PER_NOMBRE2,NULL,' ')||' '||p.PER_APELLIDO1||' '||DECODE(p.PER_APELLIDO2, p.PER_APELLIDO2,p.PER_APELLIDO2,NULL,' ') investigador,
p.PER_ID AS documento,
p.TDO_ID AS tipoDocumento,
C.CON_TITULO AS MODALIDAD

from HER_PROYECTO pry left join HER_CONVOCATORIA C ON C.CON_ID = PRY.MOD_ID left join HER_INVESTIGADOR_PROYECTO ip
on ip.pry_id = pry.pry_id and ip.INP_TIPO = 'P' left join her_persona p on ip.inv_id = p.per_id and ip.tdo_id = p.tdo_id, 
HER_ESTADO_PROYECTO ep

where pry.MOD_ID in ('21','22') AND pry.EPR_ID not in ('B','I')
and pry.EPR_ID = ep.EPR_ID
order by IDPRY

</property>
        </oda-data-set>
    </data-sets>

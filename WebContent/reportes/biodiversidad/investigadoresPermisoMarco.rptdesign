            <property name="queryText">select distinct max(ii.TDO_ID) as tipoDoc, max(ii.INV_ID) as documento, 
 max(g.GRU_NOMBRE) as grupo,  
 max(g.GRU_COLCIENCIAS) as codColciencias,
 max(a.AVI_ID) as solicitud, 
 max(a.AVI_FECHAREGISTRO) as fechaSolicitud,
 max(p.PER_NOMBRE1)||' '||DECODE(max(p.PER_NOMBRE2), max(p.PER_NOMBRE2),max(p.PER_NOMBRE2),NULL,' ')||' '||max(p.PER_APELLIDO1)||' '||DECODE(max(p.PER_APELLIDO2), max(p.PER_APELLIDO2),max(p.PER_APELLIDO2),NULL,' ') investigador,
 max(d.dpn_nombre) as escuela,
 max(d2.dpn_nombre) as facultad,
 max(s.sed_nombre) as sede,
 max(pb.peb_nombre) as permiso
 
from HER_AVAL a left join her_permiso_biodiversidad pb on pb.peb_id = a.avi_convocatoria, HER_GRUPO g, HER_INVESTIGADOR_INTERNO ii, HER_PERSONA p, 
HER_DEPENDENCIA d left join HER_DEPENDENCIA d2 on d.dpn_facultad = d2.dpn_id, her_sede s

where ii.INI_PERMISO_MARCO = 'S' 
and g.GRU_ID = a.AVI_GRUPO and a.AVI_MODALIDAD_DOC = 'I' 
and a.INV_ID = ii.INV_ID and a.TDO_ID = ii.TDO_ID 
and ii.TDO_ID = p.TDO_ID and ii.INV_ID = p.PER_ID
and ii.dpn_id = d.dpn_id
and s.sed_id = d.sed_id
and a.AVI_ESTADO = 'F' and a.AVI_AVALFACULTAD = 'S' and a.AVI_TIPO = 'BI' 
group by ii.INV_ID order by solicitud
</property>
        </oda-data-set>
    </data-sets>

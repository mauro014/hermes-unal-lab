            <property name="queryText">SELECT DISTINCT
    pry.PRY_ID AS ID_PROYECTO,
    pry.PRY_NOMBRE AS NOMBRE_PROYECTO,
    ep.EPR_NOMBRE AS ESTADO_PROYECTO,
    s.SED_NOMBRE AS SEDE,
    d.DPN_NOMBRE AS FACULTAD,
    p.PER_NOMBRE1 || ' ' || NVL(p.PER_NOMBRE2, '') || ' ' || p.PER_APELLIDO1 || ' ' || NVL(p.PER_APELLIDO2, '') AS DOCENTE_RESPONSABLE,
    p.tdo_id||' - '||p.PER_ID AS DOCUMENTO_DOCENTE,
    pa.PRY_ID AS CODIGO_PROYECTO_ASOCIADO,
    pa.pry_nombre as nombre_pry_asoc,
    epa.EPR_NOMBRE AS ESTADO_PROYECTO_ASOCIADO,
    DECODE(com.COM_CUMPLIDO, 'S', 'SI', 'N', 'NO', '--') AS COMPROMISO_CUMPLIDO,
    pb.CON_TITULO AS CONVOCATORIA,
    'Pendiente' AS ESTADO_COMPROMISO,
    com.COM_ID AS ID_COMPROMISO,
    tin.TIN_NOMBRE AS TIPO_INFORME,
    com.COM_FECHA_VENCIMIENTO AS FECHA_VENCIMIENTO_COMPROMISO,
    com.COM_NUMERO_NOTIFICACIONES AS NUMERO_NOTIFICACIONES,
    com.COM_FECHA_NOTIFICACION AS FECHA_ULTIMA_NOTIFICACION,
    coord.PER_NOMBRE1 || ' ' || DECODE(coord.PER_NOMBRE2, NULL, '', coord.PER_NOMBRE2) || ' ' ||
    coord.PER_APELLIDO1 || ' ' || DECODE(coord.PER_APELLIDO2, NULL, '', coord.PER_APELLIDO2) AS COORDINADOR_SEGUIMIENTO

FROM HER_PROYECTO pry
LEFT JOIN HER_ESTADO_PROYECTO ep ON pry.EPR_ID = ep.EPR_ID
LEFT JOIN HER_PROYECTO pa ON pa.PRY_ID = pry.PRY_CODIGO_DIB
LEFT JOIN HER_ESTADO_PROYECTO epa ON pa.EPR_ID = epa.EPR_ID
LEFT JOIN HER_INVESTIGADOR_PROYECTO ip ON ip.PRY_ID = pry.PRY_ID AND ip.INP_TIPO = 'P'
LEFT JOIN HER_INVESTIGADOR_INTERNO ii ON ii.INV_ID = ip.INV_ID AND ii.TDO_ID = ip.TDO_ID
LEFT JOIN HER_PERSONA p ON p.PER_ID = ip.INV_ID AND p.TDO_ID = ip.TDO_ID
LEFT JOIN HER_DEPENDENCIA d ON d.DPN_ID = ii.DPN_ID
LEFT JOIN HER_SEDE s ON s.SED_ID = d.SED_ID
LEFT JOIN HER_PROYECTO_COMPROMISO com ON com.PRY_ID = pry.PRY_ID
LEFT JOIN HER_TIPO_INFORME tin ON tin.TIN_ID = com.TIN_ID
LEFT JOIN HER_CONVOCATORIA pb ON pb.CON_ID = pry.MOD_ID
LEFT JOIN HER_SEG_PROYECTO_PERSONA seg ON seg.PRY_ID = pry.PRY_ID
LEFT JOIN HER_PERSONA coord ON coord.PER_ID = seg.PER_ID AND coord.TDO_ID = seg.TDO_ID

WHERE pry.MOD_ID IN ('150','652','1344','1345','21','22')
  AND pry.EPR_ID NOT IN ('B','I')
  AND com.COM_CUMPLIDO = 'N'

ORDER BY pry.PRY_ID</property>
        </oda-data-set>
    </data-sets>

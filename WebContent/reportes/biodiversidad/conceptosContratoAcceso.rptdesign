                </structure>
            </list-property>
            <property name="queryText">select cc.CCB_ID as idSolicitud, cc.PRY_ID AS idProyecto, PRY.PRY_NOMBRE AS NOMBREPRY, ep.epr_nombre as estado,
p.PER_NOMBRE1||' '||DECODE(p.PER_NOMBRE2, p.PER_NOMBRE2,p.PER_NOMBRE2,NULL,' ')||' '||p.PER_APELLIDO1||' '||DECODE(p.PER_APELLIDO2, p.PER_APELLIDO2,p.PER_APELLIDO2,NULL,' ') investigador,
p.PER_ID AS documento,
p.TDO_ID AS tipoDocumento,
decode(cc.CCB_ESTADO,'T','En trámite','E','Pendiente por revisión','A','SI Requiere contrato/otrosí','N','NO requiere contrato/otrosí','C','Devuelta para correcciones','R','Solicitud rechazada','')estadoSolicitud,
C.CON_TITULO AS MODALIDAD,
cc.CCB_FECHA_SOLICITUD as fecha,
cc.CCB_FECHA_TRAMITE AS FECHATRAMITE,
cc.CCB_RADICADO AS RADICADO

from HER_CONCEPTO_CONTRATO_BIO cc left join HER_CONVOCATORIA c on cC.CON_ID = C.CON_ID left join HER_PROYECTO pry on pry.PRY_ID = CC.PRY_ID left join
HER_ESTADO_PROYECTO ep on ep.epr_id = pry.epr_id left join HER_INVESTIGADOR_PROYECTO ip
on ip.pry_id = pry.pry_id and ip.INP_TIPO = 'P' left join her_persona p on ip.inv_id = p.per_id and ip.tdo_id = p.tdo_id

where cc.CCB_ESTADO in ('E','A','R','T','C','N')

</property>
        </oda-data-set>
    </data-sets>

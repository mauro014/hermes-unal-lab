            <property name="queryText">SELECT DISTINCT
	case to_char(?)
  		when '1' then avl.AVI_ID
  		else null
  	end AVI_ID,
  	case to_char(?)
  		when '1' then avl.AVI_ULTIMO_ENVIO_SOLICIT
  		else null
  	end AVI_ULTIMO_ENVIO_SOLICIT,
  	case to_char(?)
  		when '1' then decode(avl.AVI_TIPO, 'PINV', 'Proyecto de Investigación','ME','Movilidad - Evento','SR','Proyecto - Fondo de CT+I REGALIAS','PINVC','Proyecto de Investigación - Contrapartida','GR','Grupo de Investigación','INI','Investigador independiente o Becas doctorales','CIN','Laboratorios, centros o Institutos de Investigación','PSR','Proyecto - PAED CTeI - Regalías','JD','Proyecto de Jornada Docente','ETICO','Aval Ético','VRSR','Aval etapa verificación de requisitos SGR - Regalías','PCR','Aval etapa presentación proyectos Convocatorias SGR- Regalías','')
  		else null
  	end tipo_aval,
	case to_char(?)
  		when '1' then decode(avl.AVI_ESTADO||avl.AVI_AVALFACULTAD||avl.AVI_AVALDIRECCION||avl.AVI_AVALVICE||avl.AVI_AVALDRE||avl.avi_avalrectoria,null,'Pendiente por revisión','C','Devuelto para correcciones','I','Enviado','FS','Aprobado en facultad','FN','No aprobado en facultad','DSS','Aprobado en dirección de investigación', 'DSN','No aprobado en dirección de investigación','VSSS','Aprobado en Vicerrectoría de Investigación','VSSN','No aprobado en Vicerrectoría de Investigación','IF','Enviado a la facultad','ISS','Enviado a la sede','RDSSS','Aprobado en Dirección de Relaciones Exteriores','RDSSN','No Aprobado en Dirección de Relaciones Exteriores','RRSSSS','Aprobado en Rectoría','RRC','Devuelto Rectoría','P','Formulación','B','Solicitud anulada','U','Revisado UAB','US','Revisado UAB/Vicedecanatura','EP','Enviado a CEPI','SP','Aprobado CEPI','NP','No aprobado CEPI','CP','Devuelto para correcciones CEPI','ES','Enviado a CESI','SS','Aprobado CESI','NS','No aprobado CESI','')
  		else null
  	end estado,
  	case to_char(?)
  		when '1' then avl.AVI_FECHA_AVAL_FAC
  		else null
  	end AVI_FECHA_AVAL_FAC,
 	case to_char(?)
  		when '1' then avl.AVI_FECHA_AVAL_COOR
  		else null
  	end AVI_FECHA_AVAL_COOR,
	case to_char(?)
  		when '1' then avl.AVI_FECHA_AVAL_VICE
  		else null
  	end AVI_FECHA_AVAL_VICE,
 	case to_char(?)
  		when '1' then decode(CE.CEX_ID,NULL,avl.AVI_CONVOCATORIA,CE.CEX_NOMBRE)
  		else null
  	end AVI_CONVOCATORIA,
  	case to_char(?)
  		when '1' then ht.nombre
  		else null
  	end AVI_NAT_CONVOCATORIA,
	case to_char(?)
  		when '1' then decode(CE.CEX_NUMERO,NULL,AVL.AVI_NUM_CONV,CE.CEX_NUMERO)
  		else null
  	end AVI_NUM_CONV,
	case to_char(?)
  		when '1' then avl.AVI_FECHA_CIERRE_CONV
  		else null
  	end fechaCierre,
	case to_char(?)
  		when '1' then decode(ff.FFE_COD_NATURALEZA,null,'Por definir','NAT_PRIVAD','Privada','NAT_PUBLIC','Pública','NAT_INTERNACIONAL','Internacional','NAT_MIXTA','Mixta','Por definir')
  		else null
  	end tipo_entidad,
	case to_char(?)
  		when '1' then decode(ff.FFI_ID,NULL,avl.AVI_ENTIDAD,ff.FFI_DESCRIPCION)
  		else null
  	end AVI_ENTIDAD,
	case to_char(?)
  		when '1' then td.TDO_NOMBRE||' - '||PER.PER_ID
  		else null
  	end documento,
	case to_char(?)
  		when '1' then per.PER_NOMBRE1||decode(per.PER_NOMBRE2,null,' ',' '||per.PER_NOMBRE2||' ')||per.PER_APELLIDO1||decode(per.PER_APELLIDO2,null,'',' '||per.PER_APELLIDO2)
  		else null
  	end INV,
	case to_char(?)
  		when '1' then DEP.DPN_NOMBRE
  		else null
  	end DEPARTAMENTO,
	case to_char(?)
  		when '1' then DPn1.DPN_NOMBRE
  		else null
  	end FACULTAD,
	case to_char(?)
  		when '1' then sed.SED_NOMBRE
  		else null
  	end SEDE,
	case to_char(?)
  		when '1' then AVL.PRY_ID
  		else null
  	end PRY_ID,
	case to_char(?)
  		when '1' then ep.epr_nombre
  		else null
  	end estado_pry,
	case to_char(?)
  		when '1' then avl.AVI_TITULO
  		else null
  	end AVI_TITULO,
	case to_char(?)
  		when '1' then avl.AVI_MONTO_FINAL
  		else null
  	end AVI_MONTO_FINAL,
	case to_char(?)
  		when '1' then g.GRU_ID
  		else null
  	end GRU_ID,
	case to_char(?)
  		when '1' then g.GRU_NOMBRE
  		else null
  	end GRU_NOMBRE,
	case to_char(?)
  		when '1' then g.GRU_COLCIENCIAS
  		else null
  	end GRU_COLCIENCIAS,
	case to_char(?)
  		when '1' then avl.AVI_MONTO_ENT_CONV
  		else null
  	end AVI_MONTO_ENT_CONV,
	case to_char(?)
  		when '1' then avl.AVI_PERSONAL_UN
  		else null
  	end AVI_PERSONAL_UN,
	case to_char(?)
  		when '1' then avl.AVI_ESPECIEUNAL
  		else null
  	end AVI_ESPECIEUNAL,
	case to_char(?)
  		when '1' then avl.AVI_FRESCOSUNAL
  		else null
  	end AVI_FRESCOSUNAL,
	case to_char(?)
  		when '1' then ep.fuente
  		else null
  	end FUENTE,
  	case to_char(?)
  		when '1' then CE.ACE_NOMBRE
  		else null
  	end AVI_CEPI,
  	case to_char(?)
  		when '1' then decode(avl.AVI_AVALCEPI,'S','Si','N','No','')
  		else null
  	end AVI_AVALCEPI,
  	case to_char(?)
  		when '1' then avl.AVI_FECHA_AVAL_CEPI
  		else null
  	end AVI_FECHA_AVAL_CEPI,
  	case to_char(?)
  		when '1' then decode(avl.AVI_TIENE_RECURSO,'S','Si','N','No','')
  		else null
  	end AVI_TIENE_RECURSO,
  	case to_char(?)
  		when '1' then avl.AVI_FECHA_RECURSO
  		else null
  	end AVI_FECHA_RECURSO,
  	case to_char(?)
  		when '1' then avl.AVI_FECHA_AVAL_CEPI_RECURSO
  		else null
  	end AVI_FECHA_AVAL_CEPI_RECURSO,
  	case to_char(?)
  		when '1' then avl.AVI_CONSID_ETICAS
  		else null
  	end AVI_CONSID_ETICAS,
  	lab.lab_nombre,
  	AVI_CODIGO_MINCIENCIAS,
  	DDTIPO.DOMDET_DESCRIPCION AS TIPOESPE
FROM HER_AVAL avl
LEFT JOIN HER_AVAL_COMITE_ETICA CE ON CE.ACE_ID = avl.AVI_CEPI
left join HER_CONVOCATORIA_EXTERNA ce on TO_CHAR(ce.CEX_ID) = avl.AVI_CONVOCATORIA
LEFT JOIN HER_TIPOS ht ON ht.ID =ce.NAT_ID AND ht.TIPO_ID =375
left join HER_FUENTE_FINANCIACION ff on avl.AVI_ENTIDAD = ff.FFI_ID
left join HER_PROYECTO p on avl.pry_id = p.pry_id
left join her_aval_laboratorio al on al.AVI_ID=avl.AVI_ID
left join her_laboratorio lab on al.lab_id=lab.lab_id
left join HER_AVAL_SUBTIPOS SUBT on aVL.AVI_id=SUBT.AVI_id
LEFT JOIN HER_DOMINIO_DETALLE DDTIPO ON DDTIPO.DOM_ID = SUBT.DOM_ID AND DDTIPO.DOMDET_TIPO = SUBT.DOMDET_TIPO
left join (select f.PRY_ID,ff.FFI_DESCRIPCION fuente from her_financiacion f, her_fuente_financiacion ff where f.FFE_TIPO_ENTIDAD = 'P' and f.FFI_ID = ff.FFI_ID) ep on ep.PRY_ID=p.PRY_ID
left join HER_ESTADO_PROYECTO ep on ep.epr_id = p.epr_id
left join HER_GRUPO g on TO_CHAR(g.GRU_ID)=TO_CHAR(avl.AVI_NOMBRE_GRUPO_PINV),
HER_PERSONA PER
left join HER_TIPO_DOCUMENTO td on PER.TDO_ID=td.TDO_ID,
HER_DEPENDENCIA dep
left join HER_DEPENDENCIA dpn1 on dep.DPN_FACULTAD = dpn1.DPN_ID
left join HER_SEDE sed on sed.SED_ID=dpn1.SED_ID
WHERE 
	avl.DPN_ID = dep.DPN_ID 
	and avl.TDO_ID = per.TDO_ID and avl.INV_ID = per.PER_ID
	and avl.INV_ID not in ('52015719', '52585723', '52116940', '1023876575', '1032380386', '1053799116', '19380666', '52205496', '41654902', '1022389470')
	and	avl.AVI_ULTIMO_ENVIO_SOLICIT >= ?  AND avl.AVI_ULTIMO_ENVIO_SOLICIT &lt;= ?  
	AND avl.AVI_ESTADO in (SELECT COLUMN_VALUE FROM TABLE(SPLIT(?)))
	and (dep.dpn_facultad = ? or dep.SED_ID in (SELECT COLUMN_VALUE FROM TABLE(SPLIT(?))))
	AND (avl.AVI_TIPO IN (SELECT COLUMN_VALUE FROM TABLE(SPLIT(?))))
order by AVI_ID, GRU_ID, FUENTE</property>
        </oda-data-set>
    </data-sets>

            <property name="queryText">SELECT
	hp.DESCRIPCION cargo,
	hp.INFORMACION_ADICIONAL institucion,
	hp2.per_nombre1 || decode(hp2.per_nombre2, NULL, ' ', ' ' || hp2.per_nombre2 || ' ') || hp2.per_apellido1 || decode(hp2.per_apellido2, NULL, '', ' ' || hp2.per_apellido2) nombre
FROM
	HER_PARAMETRO hp
INNER JOIN HER_PERSONA hp2 ON
	hp2.PER_ID = hp.VALOR
WHERE
	NOMBRE = 'RECTOR'</property>

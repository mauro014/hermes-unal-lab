        <oda-data-set extensionID="org.eclipse.birt.report.data.oda.jdbc.JdbcSelectDataSet" name="1_Docentes" id="14663">
            <structure name="cachedMetaData">
                <list-property name="resultSet">
                    <structure>
                        <property name="position">1</property>
                        <property name="name">DOCENTE</property>
                        <property name="dataType">string</property>
                    </structure>
                </list-property>
            </structure>
            <property name="dataSource">OrigenHermes</property>
            <list-property name="parameters">
                <structure>
                    <property name="name">param_1</property>
                    <property name="paramName">codigo</property>
                    <property name="dataType">string</property>
                    <property name="position">1</property>
                    <property name="isInput">true</property>
                    <property name="isOutput">false</property>
                </structure>
            </list-property>
            <list-property name="resultSet">
                <structure>
                    <property name="position">1</property>
                    <property name="name">DOCENTE</property>
                    <property name="nativeName">DOCENTE</property>
                    <property name="dataType">string</property>
                </structure>
            </list-property>
            <property name="queryText">SELECT
	per.per_nombre1 || decode(per.per_nombre2, NULL, ' ', ' ' || per.per_nombre2 || ' ') || per.per_apellido1 || decode(per.per_apellido2, NULL, '', ' ' || per.per_apellido2) docente
FROM
		her_investigador_proyecto ip
INNER JOIN her_persona per ON
		per.tdo_id = ip.tdo_id
	AND ip.inv_id = per.per_id
INNER JOIN HER_AVAL ha ON
	ha.PRY_ID = ip.PRY_ID
WHERE
		ip.inp_tipo != 'P'
	AND nvl(INP_VALOR_PAGAR, 0) != 0
	AND ha.AVI_ID = ?</property>
        </oda-data-set>

                    <property name="dataType">string</property>
                </structure>
            </list-property>
            <property name="queryText">SELECT
	decode(?,'N', hp.DESCRIPCION, ?)cargo,
	hp.INFORMACION_ADICIONAL institucion,
	decode(?,'N', hp.VALOR, (select valor from her_parametro where nombre = 'TEMPORAL_CARTAS_AVAL'))nombre
FROM
	HER_PARAMETRO hp
WHERE
	NOMBRE = 'DIRECTOR_DRE'</property>

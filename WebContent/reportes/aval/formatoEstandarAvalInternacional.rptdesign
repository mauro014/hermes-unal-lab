                                <property name="displayName">Parrafo1</property>
                                <expression name="expression">params["formatoIngles"].value?"In my capacity as legal representative of the Universidad Nacional de Colombia, I hereby endorse the submittal of the project entitled \""+
params["proyecto"].value+
"\" to the call in reference, presented by professor "+
dataSetRow["DOCENTE"]+
" of the Faculty "+
dataSetRow["FACULTAD"]+
" from Campus "+
dataSetRow["SEDE"]+
".":"En mi calidad de representante legal de la Universidad Nacional de Colombia, me permito avalar la presentación del proyecto titulado \""+
dataSetRow["NOMBREPROYECTO"]+
"\" a la convocatoria del asunto; la cual es presentada por el docente "+
dataSetRow["DOCENTE"]+
" de la facultad "+
dataSetRow["FACULTAD"]+
" de la Sede "+
dataSetRow["SEDE"]+
"."</expression>
                                <property name="dataType">string</property>
                            </structure>
                        </list-property>

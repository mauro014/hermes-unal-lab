            <property name="queryText">SELECT
	decode(?,'N',hp.DESCRIPCION,?)cargo,
	hp.INFORMACION_ADICIONAL institucion,
	decode (?, 'N',hp2.per_nombre1 || decode(hp2.per_nombre2, NULL, ' ', ' ' || hp2.per_nombre2 || ' ') || hp2.per_apellido1 || decode(hp2.per_apellido2, NULL, '', ' ' || hp2.per_apellido2),(select valor from her_parametro where nombre = 'TEMPORAL_CARTAS_AVAL')) nombre
FROM
	HER_PARAMETRO hp
INNER JOIN HER_PERSONA hp2 ON
	hp2.PER_ID = hp.VALOR
WHERE
	NOMBRE = 'RECTOR'</property>

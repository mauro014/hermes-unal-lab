            <property name="queryText">SELECT
	DISTINCT 
	case to_char(?) when '1' then to_char(SYSDATE, 'Month DD', 'NLS_DATE_LANGUAGE = english')|| ' of ' || to_char(SYSDATE, 'YYYY')
	else to_char(SYSDATE, 'Month DD', 'NLS_DATE_LANGUAGE = spanish') || ' de ' || to_char(SYSDATE, 'YYYY') end fecha,
	hff.FFI_DESCRIPCION entidad,
	hce.CEX_NOMBRE convocatoria,
	ha.PRY_ID idProyecto,
	ha.AVI_ID idAval,
	hp.PRY_NOMBRE nombreProyecto,
	per.per_nombre1 || decode(per.per_nombre2, NULL, ' ', ' ' || per.per_nombre2 || ' ') || per.per_apellido1 || decode(per.per_apellido2, NULL, '', ' ' || per.per_apellido2) docente,
	d2.dpn_nombre facultad,
	s.sed_nombre sede,
	dd.DOMDET_DESCRIPCION rolUniversidad,
	ip.inp_dedicacion_horas_semana horasSemana,
	CASE
		WHEN c.con_tipo_financiacion = 'MINIMA' THEN 
			nvl(cesp.valor, 0)
		ELSE
            0
	END valorespecie,
	nvl(hp.PRY_VALOR_PERSONAL, 0) - ip.INP_VALOR_PAGAR valorDocente,
	CASE
		WHEN c.con_tipo_financiacion = 'MINIMA' THEN 
			nvl(cefe.valor, 0)
		ELSE
           	nvl(cesp.valor, 0)
	END valorefectivo,
	CASE
		WHEN c.con_tipo_financiacion = 'MINIMA' THEN 
			nvl(cesp.valor, 0)+ nvl(cefe.valor, 0) + nvl(hp.PRY_VALOR_PERSONAL, 0) - ip.INP_VALOR_PAGAR
		ELSE
            nvl(cesp.valor, 0) + nvl(hp.PRY_VALOR_PERSONAL, 0) - ip.INP_VALOR_PAGAR
	END total
FROM
	HER_AVAL ha
LEFT JOIN HER_FUENTE_FINANCIACION hff ON
	ha.AVI_ENTIDAD = hff.FFI_ID
LEFT JOIN HER_CONVOCATORIA_EXTERNA hce ON
	to_char(ha.AVI_CONVOCATORIA) = to_char(hce.CEX_ID)
INNER JOIN HER_PROYECTO hp ON
	ha.PRY_ID = hp.PRY_ID
LEFT JOIN (
	SELECT
		her_investigador_proyecto.*,
		ROW_NUMBER() OVER( PARTITION BY her_investigador_proyecto.pry_id ORDER BY her_investigador_proyecto.inp_id DESC ) AS x
	FROM
		her_investigador_proyecto
	WHERE
		her_investigador_proyecto.inp_tipo = 'P' ) ip ON
	hp.pry_id = ip.pry_id
LEFT JOIN her_persona per ON
	per.tdo_id = ip.tdo_id
	AND ip.inv_id = per.per_id
LEFT JOIN her_investigador_interno ii ON
	ip.tdo_id = ii.tdo_id
	AND ip.inv_id = ii.inv_id
LEFT JOIN her_dependencia d ON
	d.dpn_id = ii.dpn_id
LEFT JOIN her_dependencia d2 ON
	d2.dpn_id = d.dpn_facultad
LEFT JOIN her_sede s ON
	s.sed_id = d.sed_id
LEFT JOIN her_dominio_detalle dd ON
	hp.PRY_ROL_UNIVERSIDAD = dd.domdet_tipo
	AND dd.dom_id = 55
LEFT JOIN her_convocatoria c ON
	hp.mod_id = c.con_id
LEFT JOIN
(
	SELECT
			f.pry_id,
		nvl(SUM(nvl(g.gst_valor, 0)), 0) valor
	FROM
			her_financiacion f
	LEFT JOIN her_fuente_financiacion ff ON
			ff.ffi_id = f.ffi_id
		AND ff.FFI_INTERNA_EXTERNA IN ('O', 'I')
	INNER JOIN her_gasto g ON
			g.fin_id = f.fin_id
			AND g.tru_id NOT IN (
        93,
        149,
        150
    )
		WHERE
			( ( f.ffe_tipo_entidad = 'F'
				OR f.ffe_tipo_entidad IS NULL )
			AND ( f.fin_es_legalizacion IS NULL
				OR f.fin_es_legalizacion = 'NO' ))
		GROUP BY
			f.pry_id) cesp ON
	cesp.pry_id = hp.pry_id
LEFT JOIN (
	SELECT
			f.pry_id,
			nvl(SUM(nvl(g.gst_valor2, 0) + nvl(g.gst_valor3, 0) + nvl(g.gst_valor4, 0) + nvl(g.gst_valor5, 0) + nvl(g.gst_valor6, 0)), 0)valor
	FROM
			her_financiacion f
	LEFT JOIN her_fuente_financiacion ff ON
			ff.ffi_id = f.ffi_id
		AND ff.FFI_INTERNA_EXTERNA IN ('O', 'I')
	INNER JOIN her_gasto g ON
			g.fin_id = f.fin_id
			AND g.tru_id NOT IN (
        93,
        149,
        150
    )
		WHERE
			( ( f.ffe_tipo_entidad = 'F'
				OR f.ffe_tipo_entidad IS NULL )
			AND ( f.fin_es_legalizacion IS NULL
				OR f.fin_es_legalizacion = 'NO' ))
		GROUP BY
			f.pry_id) cefe ON
	cefe.pry_id = hp.pry_id
WHERE
	AVI_ID = ?</property>

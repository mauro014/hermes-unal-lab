                </structure>
            </list-property>
            <property name="queryText">SELECT
	 (hp2.per_nombre1 || decode(hp2.per_nombre2, NULL, ' ', ' ' || hp2.per_nombre2 || ' ') || hp2.per_apellido1 || decode(hp2.per_apellido2, NULL, '', ' ' || hp2.per_apellido2))ELABORO
FROM
	 HER_PERSONA hp2 
WHERE
	PER_ID = ?</property>

            <property name="queryText">select HER_FINANCIACION.FIN_VALOR, HER_FINANCIACION.FFE_VALOR_ESPECIE, HER_FUENTE_FINANCIACION.FFI_DESCRIPCION
from HER_FINANCIACION, HER_FUENTE_FINANCIACION, HER_AVAL
where HER_AVAL.AVI_ID = ? and HER_FINANCIACION.FFE_TIPO_ENTIDAD = 'P' and HER_AVAL.PRY_ID = HER_FINANCIACION.PRY_ID and HER_FINANCIACION.FFI_ID = HER_FUENTE_FINANCIACION.FFI_ID</property>

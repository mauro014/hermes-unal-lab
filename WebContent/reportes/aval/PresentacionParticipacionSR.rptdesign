        <oda-data-set extensionID="org.eclipse.birt.report.data.oda.jdbc.JdbcSelectDataSet" name="DirectorDI" id="7462">
            <structure name="cachedMetaData">
                <list-property name="resultSet">
                    <structure>
                        <property name="position">1</property>
                        <property name="name">DIRECTOR</property>
                        <property name="dataType">string</property>
                    </structure>
                    <structure>
                        <property name="position">2</property>
                        <property name="name">CARGO</property>
                        <property name="dataType">string</property>
                    </structure>
                    <structure>
                        <property name="position">3</property>
                        <property name="name">FIRMA</property>
                        <property name="dataType">blob</property>
                    </structure>
                    <structure>
                        <property name="position">4</property>
                        <property name="name">IDENTIFICACION</property>
                        <property name="dataType">string</property>
                    </structure>
                </list-property>
            </structure>
            <property name="dataSource">Produccion</property>
            <list-property name="parameters">
                <structure>
                    <property name="name">param_1</property>
                    <property name="dataType">string</property>
                    <property name="position">1</property>
                    <expression name="defaultValue">params["Id"].value</expression>
                    <property name="isInput">true</property>
                    <property name="isOutput">false</property>
                </structure>
            </list-property>
            <list-property name="resultSet">
                <structure>
                    <property name="position">1</property>
                    <property name="name">DIRECTOR</property>
                    <property name="nativeName">DIRECTOR</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">2</property>
                    <property name="name">CARGO</property>
                    <property name="nativeName">CARGO</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">3</property>
                    <property name="name">FIRMA</property>
                    <property name="nativeName">FIRMA</property>
                    <property name="dataType">blob</property>
                </structure>
                <structure>
                    <property name="position">4</property>
                    <property name="name">IDENTIFICACION</property>
                    <property name="nativeName">IDENTIFICACION</property>
                    <property name="dataType">string</property>
                </structure>
            </list-property>
            <property name="queryText">SELECT PAR.VALOR Director, PAR.DESCRIPCION Cargo, PAR.ADJUNTO Firma, 'C.'||INI.TDO_ID||'. '||INI.INV_ID identificacion 
FROM 
HER_PARAMETRO PAR
LEFT JOIN HER_INVESTIGADOR_INTERNO INI ON INI.INV_ID = PAR.PROFESION
RIGHT JOIN 
(
SELECT DEP.dpn_id, DEP.sed_id FROM HER_DEPENDENCIA DEP 
LEFT JOIN HER_DEPENDENCIA DPN ON DPN.SED_ID = DEP.SED_ID
LEFT JOIN HER_AVAL AVI ON AVI.DPN_ID = DPN.DPN_ID
WHERE AVI.AVI_ID = ?
)DPN ON DPN.DPN_ID = INI.DPN_ID
WHERE PAR.NOMBRE LIKE 'SEG_DIRECTOR_DIB%' </property>

            <property name="queryText">SELECT avl.AVI_ID, AVL.AVI_TIPOEVENTO, AVI_TEXTO_COMP_COOR, AVI_ESTADO, AVI_AVALFACULTAD,  AVI_AVALDIRECCION,
AVI_TITULO,  AVI_ENTIDAD,  AVI_MONTOSOLICITADO , substr(AVI_CONVOCATORIA,1,80) Conv,  AVI_CONVOCATORIA, 
AVI_ENTIDADEJECUTORA, AVI_ENTIDADCOEJECUTORA ,  AVI_HORASPRINCIPAL,
AVI_HORASCOINVESTIGADOR ,AVI_ESPECIEUNAL,  AVI_ESPECIEOTROS, AVI_FRESCOSUNAL,AVI_FRESCOS_UNAL_APORTA,
AVI_FRESCOSOTROS , INV_ID, PER.TDO_ID ,  EST.EST_ID, AVL.AVI_NOMBRE_GRUPO_PINV, AVL.AVI_TEXTO_COMP_COOR, AVL.AVI_APORTA_REC_PROP, FFI_DESCRIPCION,
TDO_ID_EST, AVI_EVENTO , AVI_FECHAREGISTRO, AVL.AVI_FECHAINICIO, AVL.AVI_FECHAFIN, AVL.AVI_TIPOEVENTO, AVL.AVI_EVENTO, AVL.AVI_INSTITUCION_MOVILIDAD,
decode(AVI_TIPO,
       'PP',  'Presentación del profesor',
       'PE',  'Presentación del estudiante',
       'IE',  'Aval institucional de evento',
       'IP',  'Aval institucional de proyecto') TipoAval,       
PER.PER_NOMBRE1||' '||DECODE(PER.PER_NOMBRE2, PER.PER_NOMBRE2,PER.PER_NOMBRE2,NULL,' ')
||' '||PER.PER_APELLIDO1||' '||DECODE(PER.PER_APELLIDO2, PER.PER_APELLIDO2,PER.PER_APELLIDO2,NULL,' ')InvP,
DPN1.DPN_NOMBRE FAC, DPN.DPN_NOMBRE DPTO,
EST.EST_NOMBRE1||' '||DECODE(EST.EST_NOMBRE2, EST.EST_NOMBRE2,EST.EST_NOMBRE2,NULL,' ') ||' '||
(EST.EST_APELLIDO1||' '||DECODE(EST.EST_APELLIDO2, EST.EST_APELLIDO2,EST.EST_APELLIDO2,NULL,' '))Est, 
'La Universidad Nacional de Colombia, avala y presenta oficialmente a '|| EST.EST_NOMBRE1||' '||
DECODE(EST.EST_NOMBRE2, EST.EST_NOMBRE2,EST.EST_NOMBRE2,NULL,' ') ||' '||
(EST.EST_APELLIDO1||' '||DECODE(EST.EST_APELLIDO2, EST.EST_APELLIDO2,EST.EST_APELLIDO2,NULL,' ')) || 
', identificado con cédula de ciudadanía ' || COA.PER_ID || ', estudiante de '|| EST.EST_NOMBRE_CARRERA || ', bajo la tutoría del profesor(a) '
|| PER.PER_NOMBRE1||' '||DECODE(PER.PER_NOMBRE2, PER.PER_NOMBRE2,PER.PER_NOMBRE2,NULL,' ')
||' '||PER.PER_APELLIDO1||' '||DECODE(PER.PER_APELLIDO2, PER.PER_APELLIDO2,PER.PER_APELLIDO2,NULL,' ') || ' docente del '|| DPN.DPN_NOMBRE || 
', de la ' || DPN1.DPN_NOMBRE || '.' textoEstudiante,  
EST.EST_APELLIDO1 ApeEst, AVI_CIUDAD, PAIS.PAIS_NOMBRE,  AVL.AVI_DESCRIPCIONFACULTAD,
'El '|| DECODE(EST.EST_NOMBRE2, EST.EST_NOMBRE2,EST.EST_NOMBRE2,NULL,' ') ||' '||
(EST.EST_APELLIDO1||' '||DECODE(EST.EST_APELLIDO2, EST.EST_APELLIDO2,EST.EST_APELLIDO2,NULL,' '))||' presentará una ponencia en el ' 
|| AVL.AVI_EVENTO || ' en el país ' || PAIS.PAIS_NOMBRE || ' durante el '|| AVL.AVI_FECHAINICIO || ' y el '|| AVL.AVI_FECHAFIN || '.' texto2,
'El '|| DECODE(EST.EST_NOMBRE2, EST.EST_NOMBRE2,EST.EST_NOMBRE2,NULL,' ') ||' '||
(EST.EST_APELLIDO1||' '||DECODE(EST.EST_APELLIDO2, EST.EST_APELLIDO2,EST.EST_APELLIDO2,NULL,' '))||' realizará una pasantía en la ' 
|| AVL.AVI_INSTITUCION_MOVILIDAD || ' en el país ' || PAIS.PAIS_NOMBRE || ' desde '|| AVL.AVI_FECHAINICIO || ' hasta '|| AVL.AVI_FECHAFIN || '.' texto3,
'Finalmente, se informa que para efectos contractuales, que por la cuantía de este proyecto, según Artículo 43 de la Resolución 872 de 2013 de Rectoría: "Por medio de la cual se modifica y adiciona parcialmente el Manual de convenios y contratos de la Universidad Nacional de Colombia”. Se delega la competencia para la presentación de propuestas, para adelantar los trámites del proceso contractual y para la suscripción de las pólizas que se requieran tanto la presentación de las propuestas como la legalización de los contratos o convenios respectivos, en los Decanos de Facultad y Directores de Centro e Instituto, que para el caso de este proyecto será el Profesor(a):' texto4,
', Decano(a) de la '|| DPN1.DPN_NOMBRE ||'.' texto5,
(SELECT PLE.PLE_NOMBRE FROM HER_PLAN_ESTUDIOS  PLE, her_tmp_estudiante est1  WHERE EST1.EST_PLAN = PLE.PLE_ID  AND EST1.EST_ID = COA.PER_ID) ESTPLE,
decode(dpn.sed_id,'2','Bogotá D.C.','3','Medellín','4','Manizales','5','Palmira','6','Leticia','7','Arauca','8','San Andrés','9','Tumaco','Bogotá D.C.')ciu
FROM
HER_PERSONA PER, HER_AVAL AVL,  HER_DEPENDENCIA DPN,  HER_DEPENDENCIA DPN1, HER_TMP_ESTUDIANTE EST, HER_PAIS PAIS,
HER_COINVESTIGADOR_AVAL COA, HER_FUENTE_FINANCIACION
WHERE
    PER.PER_ID = AVL.INV_ID
AND PER.TDO_ID = AVL.TDO_ID
and AVL.AVI_AVALFACULTAD  = 'S'
AND AVL.AVI_ID = ?
AND  DPN.DPN_ID = AVL.DPN_ID
AND  DPN.DPN_ID_2 = DPN1.DPN_ID
AND AVL.PAIS_ID = PAIS.PAIS_ID
AND AVL.AVI_ID = COA.AVI_ID
AND COA.PER_ID = EST.EST_ID
AND COA.TDO_ID = EST.TDO_ID
AND COA.COA_TIPO_VINCULACION = 'Estudiante'
AND HER_FUENTE_FINANCIACION.FFI_ID = AVL.AVI_ENTIDAD</property>

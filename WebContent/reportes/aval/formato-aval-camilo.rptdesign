            <property name="queryText">select 
avl.avi_id, 
dd.domdet_descripcion as tipo, avl.avi_tipo,
avl.avi_titulo,
decode(avl.AVI_ESTADO||avl.AVI_AVALFACULTAD||avl.AVI_AVALDIRECCION||avl.AVI_AVALVICE||avl.AVI_AVALDRE,null,'Pendiente por revisión','C',
'Devuelto para correcciones',
'I','Enviado',
    'FS','Aprobado en facultad'
    ,'FN','No aprobado en facultad',
    'DSS','Aprobado en dirección de investigación', 
    'DSN','No aprobado en dirección de investigación',
    'VSSS','Aprobado en Vicerrectoría de Investigación',
    'VSSN','No aprobado en Vicerrectoría de Investigación',
    'P','Formulación','B','Solicitud anulada',
    'IF','Enviado a la facultad',
    'ISS','Enviado a la sede',
    'RDSSS','Aprobado en Dirección de Relaciones Exteriores',
   'RDSSN','No Aprobado en Dirección de Relaciones Exteriores',
    'EP','Enviado CEPI',
    'SP','Aprobado CEPI',
    'NP','No Aprobado CEPI',
    'CP','Devuelto CEPI',
    'ES','Enviado CESI',
    'SS','Aprobado CESI',
    'NS','No Aprobado CESI') estado,
avl.AVI_ULTIMO_ENVIO_SOLICIT,
(avl.tdo_id || ' - ' || avl.inv_id)documento,
p.PER_NOMBRE1||' '||DECODE(p.PER_NOMBRE2, p.PER_NOMBRE2,p.PER_NOMBRE2,NULL,' ')||' '||p.PER_APELLIDO1||' '||DECODE(p.PER_APELLIDO2, p.PER_APELLIDO2,p.PER_APELLIDO2,NULL,' ') solicitante,
p.per_email,
d.dpn_nombre as uab,
d2.dpn_nombre as facultad,
sed.sed_nombre as sede,
(pry.pry_id || ' - ' ||pry.pry_nombre)proyecto,
decode(GR.GRU_ID,NULL,AVL.AVI_NOMBRE_GRUPO_PINV,'0','Sin selección de grupo para el aval',GR.GRU_NOMBRE)grupo,
avl.AVI_AVAL_RELACIONADO,
conv.cnv_nombre as convenio,
decode(ff.FFI_ID,NULL,d2.DEP_NOMBRE,'0',' ',ff.FFI_DESCRIPCION) entidadExterna,
ce.cex_nombre as convocatoria,
ce.cex_numero as numero,
ce.CEX_FECHA_FINALIZACION,
avl.AVI_MONTO_ENT_CONV as montoSolicitado,
avl.AVI_ENTIDADEJECUTORA,
pry.pry_duracion,
avl.AVI_CONSID_ETICAS,
avl.AVI_FASE,
dep.dep_nombre as depto_ejecucion_reg,
ciu.CIU_NOMBRE AS ciudad_ejecucion_reg,
avl.avi_personal_un as personalUN,
avl.avi_especieunal as especie_unal,
avl.avi_frescosunal as frescos_unal,
avl.avi_especieotros as especie_externa,
avl.avi_monto_final as total,
avl.avi_objetivo_principal as objetivo,
PAI.PAIS_NOMBRE AS nombre_pais,
avl.avi_institucion_movilidad,
avl.avi_evento,
avl.avi_titulo_trabajo,
avl.avi_linea_tematica,
d3.dpn_nombre as dependencia_ejecucion_me,
avl.avi_fechainicio,
avl.avi_fechafin,
decode(avl.AVI_AVALUAB,null,'Pendiente por revisión', 'N', 'No aprobado','S','Aprobado') estado_aval_uab,
decode(avl.AVI_AVALFACULTAD,null,'Pendiente por revisión', 'N', 'No aprobado','S','Aprobado') estado_aval_facultad,
decode(avl.AVI_AVALDIRECCION,null,'Pendiente por revisión', 'N', 'No aprobado','S','Aprobado', 'B', 'Solicitud anulada') estado_aval_direccion,
decode(avl.AVI_AVALVICE,null,decode(avl.avi_intersedes,'S','Pendiente por revisión'),decode(avl.avi_es_para_dre,'S','Pendiente por revisión'), 'N', 'No aprobado','S','Aprobado') estado_aval_vice,
decode(avl.AVI_AVALDRE,null,'Pendiente por revisión', 'N', 'No aprobado','S','Aprobado') estado_aval_DRE,
avl.AVI_FECHA_AVAL_UAB,
avl.AVI_FECHA_AVAL_FAC,
avl.AVI_FECHA_AVAL_VICE,
avl.AVI_FECHA_AVAL_DRE,
avl.AVI_FECHA_AVAL_COOR,
avl.AVI_ES_CON_CONV,
d2.DEP_NOMBRE,
nvl(avl.AVI_TIPO_AVAL_CIN,'CI')AVI_TIPO_AVAL_CIN,
ce.nat_id naturaleza_cex,
avl.avi_intersedes intersedes,
nvl(avl.avi_es_para_vice,'N') esParaVRI,
nvl(avl.avi_es_para_dre,'N') esParaDre
from her_aval avl 
left join her_dependencia d on d.dpn_id = avl.dpn_id 
left join her_dependencia d2 on d2.dpn_id = d.dpn_facultad
left join her_sede sed on sed.sed_id = d2.sed_id
left join her_proyecto pry on avl.pry_id = pry.pry_id
left join her_grupo gr on gr.gru_id = avl.avi_nombre_grupo_pinv
left join her_convenio conv on conv.CNV_ID = avl.AVI_MOD
left join her_fuente_financiacion ff on ff.ffi_id = avl.avi_entidad
left join her_convocatoria_externa ce on ce.cex_id = avl.avi_convocatoria
left join HER_DEPARTAMENTO d2 on d2.DEP_ID = avl.AVI_ENTIDAD_TERRITORIAL_REG
left join HER_DEPARTAMENTO entTerr on d2.DEP_ID = AVl.avi_entidad 
left join HER_DEPARTAMENTO dep on dep.DEP_ID = AVL.AVI_DEPARTAMENTO 
left join HER_CIUDAD ciu on ciu.CIU_ID = AVL.AVI_LUGAR_EJEC
left join HER_PAIS pai on pai.PAIS_ID = AVL.PAIS_ID
left join her_dependencia d3 on d3.dpn_id = AVL.AVI_LUGAR_EJEC, 
her_dominio_detalle dd, her_persona p
where avl.avi_id = ?
and (dd.domdet_tipo = avl.avi_tipo and dd.dom_id = '81')
and p.tdo_id = avl.tdo_id
and p.per_id = avl.inv_id</property>
        </oda-data-set>

            <list-property name="parameters">
                <structure>
                    <property name="name">aviId</property>
                    <property name="paramName">id</property>
                    <property name="dataType">string</property>
                    <property name="position">1</property>
                    <property name="isInput">true</property>
                    <property name="isOutput">false</property>
                </structure>
            </list-property>
            <list-property name="resultSet">
                <structure>
                    <property name="position">1</property>
                    <property name="name">AVI_TIPO</property>
                    <property name="nativeName">AVI_TIPO</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">2</property>
                    <property name="name">AVI_TIPO_AVAL_CIN</property>
                    <property name="nativeName">AVI_TIPO_AVAL_CIN</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">3</property>
                    <property name="name">ID</property>
                    <property name="nativeName">ID</property>
                    <property name="dataType">decimal</property>
                </structure>
                <structure>
                    <property name="position">4</property>
                    <property name="name">Nombre</property>
                    <property name="nativeName">Nombre</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">5</property>
                    <property name="name">Correo</property>
                    <property name="nativeName">Correo</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">6</property>
                    <property name="name">Coordinador</property>
                    <property name="nativeName">Coordinador</property>
                    <property name="dataType">string</property>
                </structure>
            </list-property>
            <property name="queryText">SELECT
    a.avi_tipo,
    a.avi_tipo_aval_cin,
    l.lab_id       "ID",
    l.lab_nombre   "Nombre",
    l.lab_email    "Correo",
    p.per_nombre1
    || decode(p.per_nombre2, NULL, ' ', ' '
                                        || p.per_nombre2
                                        || ' ')
    || p.per_apellido1
    || decode(p.per_apellido2, NULL, '', ' ' || p.per_apellido2) "Coordinador"
FROM
    her_aval                  a
    INNER JOIN her_aval_laboratorio      al ON al.avi_id = a.avi_id
    INNER JOIN her_laboratorio           l ON al.lab_id = l.lab_id
    INNER JOIN her_persona_laboratorio   pl ON pl.lab_id = l.lab_id
                                             AND pl.rol_id = 'CO'
    INNER JOIN her_persona               p ON pl.per_id = p.per_id
                                AND pl.tdo_id = p.tdo_id
WHERE
    a.avi_id = ?</property>
        </oda-data-set>
    </data-sets>

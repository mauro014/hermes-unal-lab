        </label>
        <table id="1930">
            <property name="verticalAlign">middle</property>
            <property name="width">100%</property>
            <property name="dataSet">aval</property>
            <list-property name="boundDataColumns">
                <structure>
                    <property name="name">AVI_ID</property>
                    <expression name="expression">dataSetRow["AVI_ID"]</expression>
                    <property name="dataType">decimal</property>
                </structure>
                <structure>
                    <property name="name">TIPO</property>
                    <expression name="expression">dataSetRow["TIPO"]</expression>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="name">AVI_TIPO</property>
                    <expression name="expression">dataSetRow["AVI_TIPO"]</expression>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="name">AVI_TITULO</property>
                    <expression name="expression">dataSetRow["AVI_TITULO"]</expression>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="name">ESTADO</property>
                    <expression name="expression">dataSetRow["ESTADO"]</expression>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="name">AVI_ULTIMO_ENVIO_SOLICIT</property>
                    <expression name="expression">dataSetRow["AVI_ULTIMO_ENVIO_SOLICIT"]</expression>
                    <property name="dataType">date-time</property>
                </structure>
                <structure>
                    <property name="name">DOCUMENTO</property>
                    <expression name="expression">dataSetRow["DOCUMENTO"]</expression>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="name">SOLICITANTE</property>
                    <expression name="expression">dataSetRow["SOLICITANTE"]</expression>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="name">PER_EMAIL</property>
                    <expression name="expression">dataSetRow["PER_EMAIL"]</expression>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="name">UAB</property>
                    <expression name="expression">dataSetRow["UAB"]</expression>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="name">FACULTAD</property>
                    <expression name="expression">dataSetRow["FACULTAD"]</expression>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="name">SEDE</property>
                    <expression name="expression">dataSetRow["SEDE"]</expression>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="name">PROYECTO</property>
                    <expression name="expression">dataSetRow["PROYECTO"]</expression>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="name">GRUPO</property>
                    <expression name="expression">dataSetRow["GRUPO"]</expression>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="name">AVI_AVAL_RELACIONADO</property>
                    <expression name="expression">dataSetRow["AVI_AVAL_RELACIONADO"]</expression>
                    <property name="dataType">decimal</property>
                </structure>

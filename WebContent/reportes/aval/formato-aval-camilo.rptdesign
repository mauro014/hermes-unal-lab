            <property name="queryText">SELECT 
CEPI.ACE_NOMBRE AS CEPI,
ha.AVI_AVALCEPI as AVAL_CEPI_C, 
DECODE(ha.AVI_AVALCEPI, 'S','APROBADO','N','NO APROBADO') AS CONCEPTO,
ha.AVI_TEXTO_CEPI AS OBSERVACIONES,
ha.AVI_FECHA_AVAL_CEPI, 
ha.avi_tipo as TIPO,
ha.AVI_TIENE_RECURSO AS DOCENTE_RECURSO,
ht.NOMBRE AS TIPO_RECURSO,
ha.AVI_FECHA_RECURSO AS FECHA_RECURSO,
ha.AVI_TEXTO_RECURSO AS JUSTIFICACION,
DECODE(ha.AVI_TIPO_RECURSO, 7687, DECODE(ha.AVI_AVALCEPI_RECURSO, 'S','Procedente','N','No procedente'), 7685, DECODE(ha.AVI_AVALCEPI_RECURSO, 'S','Aprobado','N','No aprobado'), 7686, DECODE(ha.AVI_AVALCEPI_RECURSO, 'S','APROBADO','N','NO APROBADO')  ) AS  concep_cepi, 
ha. AVI_FECHA_AVAL_CEPI_RECURSO AS FECHA_REVISON,
ha.AVI_TEXTO_CEPI AS OBSERVACIONESCEPI,
CESI.ACE_NOMBRE AS CESI,
DECODE(ha.AVI_AVALCESI, 'S','APROBADO','N','NO APROBADO') "CONCEPCESI",
ha. AVI_FECHA_AVAL_CESI AS FECHACESI,
ha.AVI_TEXTO_CESI AS TEXTO_CESI,
ha.AVI_TEXTO_QUEJA AS DETALLE_QUEJA,
ha.AVI_FECHA_QUEJA AS FECHA_QUEJA,
ha.AVI_TEXTO_CESI_QUEJA AS RESPUESTA,
ha.AVI_FECHA_AVAL_CESI_QUEJA AS FECHA_RESPUESTA_CESI,
ha.AVI_TIENE_QUEJA AS AVI_TIENE_QUEJA,
'Yo '|| p.PER_NOMBRE1||' '||DECODE(p.PER_NOMBRE2, p.PER_NOMBRE2,p.PER_NOMBRE2,NULL,' ')||' '||p.PER_APELLIDO1||' '||DECODE(p.PER_APELLIDO2, p.PER_APELLIDO2,p.PER_APELLIDO2,NULL,' ') ||' ACEPTO expresa e irrevocablemente que conozco detalladamente las características, requisitos y condiciones para la solicitud de aval ético de manera que me someto a lo establecido en el procedimiento y a la normatividad vigente establecida para solicitar este tipo de aval. Declaro que la información suministrada es veraz y corresponde a la realidad.' AS TERMINOS
FROM HER_AVAL ha
INNER JOIN HER_AVAL_COMITE_ETICA CEPI ON ha.AVI_CEPI = CEPI.ACE_ID
LEFT JOIN HER_AVAL_COMITE_ETICA CESI ON CEPI.ACE_ID_PADRE = CESI.ACE_ID
LEFT JOIN HER_TIPOS ht ON ha.AVI_TIPO_RECURSO = ht.ID 
LEFT JOIN HER_PERSONA p ON p.PER_ID = ha.INV_ID AND p.TDO_ID = ha.TDO_ID
WHERE ha.AVI_ID = ?</property>
        </oda-data-set>
        <oda-data-set extensionID="org.eclipse.birt.report.data.oda.jdbc.JdbcSelectDataSet" name="HistoricoAval" id="11291">

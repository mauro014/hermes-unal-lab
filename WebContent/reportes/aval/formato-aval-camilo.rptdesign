            <property name="queryText">select TRU_NOMBRE,
decode(ea.ffi_id,null,ea.ENA_NOMBRE,FFI_DESCRIPCION)entidad,
ea.*
from HER_ENTIDAD_AVAL EA LEFT JOIN HER_FUENTE_FINANCIACION FF ON FF.FFI_ID = EA.FFI_ID, HER_TIPO_RUBRO
where AVI_ID = ? and ea.TRU_ID = HER_TIPO_RUBRO.TRU_ID and (ea.ENA_FUENTE='FinanciacionExterna')</property>
        </oda-data-set>

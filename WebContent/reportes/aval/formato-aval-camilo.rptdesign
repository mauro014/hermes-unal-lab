                </structure>
            </list-property>
            <list-property name="resultSet">
                <structure>
                    <property name="position">1</property>
                    <property name="name">FECHA</property>
                    <property name="nativeName">FECHA</property>
                    <property name="dataType">date-time</property>
                </structure>
                <structure>
                    <property name="position">2</property>
                    <property name="name">ESTADO</property>
                    <property name="nativeName">ESTADO</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">3</property>
                    <property name="name">Responsable</property>
                    <property name="nativeName">Responsable</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">4</property>
                    <property name="name">JUSTIFICACION</property>
                    <property name="nativeName">JUSTIFICACION</property>
                    <property name="dataType">string</property>
                </structure>
            </list-property>
            <property name="queryText">SELECT 
haev.HEA_FECHA AS FECHA,
decode(haev.AVI_ESTADO, null,'Pendiente por revisión','C',
'Devuelto para correcciones',
'I','Enviado',
    'FS','Aprobado en facultad'
    ,'FN','No aprobado en facultad',
    'DSS','Aprobado en dirección de investigación', 
    'DSN','No aprobado en dirección de investigación',
    'VSSS','Aprobado en Vicerrectoría de Investigación',
    'VSSN','No aprobado en Vicerrectoría de Investigación',
    'P','Formulación','B','Solicitud anulada',
    'IF','Enviado a la facultad',
    'ISS','Enviado a la sede',
    'RDSSS','Aprobado en Dirección de Relaciones Exteriores',
   'RDSSN','No Aprobado en Dirección de Relaciones Exteriores',
    'EP','Enviado CEPI',
    'SP','Aprobado CEPI',
    'NP','No Aprobado CEPI',
    'CP','Devuelto CEPI',
    'ES','Enviado CESI',
    'SS','Aprobado CESI',
    'NS','No Aprobado CESI') estado,
per.per_nombre1 || decode(per.per_nombre2, NULL, ' ', ' ' || per.per_nombre2 || ' ') || per.per_apellido1 || decode(per.per_apellido2, NULL, '', ' ' || per.per_apellido2) "Responsable",
haev.HEA_JUSTIFICACION as JUSTIFICACION
FROM 
HER_HISTORICO_ESTADO_AVAL haev
LEFT JOIN HER_PERSONA per on per.per_id = haev.PER_ID 
where haev.avi_id = ?
ORDER BY HEA_FECHA 
</property>
        </oda-data-set>

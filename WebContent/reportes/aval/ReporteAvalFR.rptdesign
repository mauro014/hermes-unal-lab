            <property name="queryText">SELECT AVI_ID, AVI_TEXTO_COMP_COOR, AVI_ESTADO, AVI_AVALFACULTAD,  AVI_AVALDIRECCION,
AVI_TITULO,  AVI_ENTIDAD,  AVI_MONTOSOLICITADO , AVI_CONVOCATORIA ,
AVI_ENTIDADEJECUTORA, AVI_ENTIDADCOEJECUTORA ,  AVI_HORASPRINCIPAL, AVI_APORTA_REC_PROP,
AVI_HORASCOINVESTIGADOR ,AVI_ESPECIEUNAL,  AVI_ESPECIEOTROS, AVI_FRESCOSUNAL, f.FFI_DESCRIPCION, 
AVI_FRESCOSOTROS , INV_ID, PER.TDO_ID ,    EST_ID, HER_PAIS.PAIS_NOMBRE, AVI_FECHAINICIO, AVI_FECHAFIN, DPN.DPN_NOMBRE, AVI_NOMBRE_GRUPO_PINV,
TDO_ID_EST, AVI_EVENTO , AVI_FECHAREGISTRO,
decode(AVI_TIPO,
       'PP',  'Presentación del profesor',
       'PE',  'Presentación del estudiante',
       'IE',  'Aval institucional del evento',
       'IP',  'Aval institucional del proyecto') TipoAval,       
PER.PER_NOMBRE1||' '||DECODE(PER.PER_NOMBRE2, PER.PER_NOMBRE2,PER.PER_NOMBRE2,NULL,' ')||' '||PER.PER_APELLIDO1||' '||DECODE(PER.PER_APELLIDO2, PER.PER_APELLIDO2,PER.PER_APELLIDO2,NULL,' ') InvP,
DPN1.DPN_NOMBRE FAC, DPN.DPN_NOMBRE DPTO,
'La Universidad Nacional de Colombia, avala y presenta a "' || PER.PER_NOMBRE1||' '||DECODE(PER.PER_NOMBRE2, PER.PER_NOMBRE2,PER.PER_NOMBRE2,NULL,' ')||' '||PER.PER_APELLIDO1||' '||DECODE(PER.PER_APELLIDO2, PER.PER_APELLIDO2,PER.PER_APELLIDO2,NULL,' ') || '", docente del '|| DPN.DPN_NOMBRE || ', de la ' || DPN1.DPN_NOMBRE ||', para la participación en la convocatoria "'|| decode(CE.CEX_ID,NULL,avl.AVI_CONVOCATORIA,CE.CEX_NOMBRE) || '".' texto1,
'Finalmente, se informa que para efectos contractuales, que por la cuantía de este proyecto, según Artículo 43 de la Resolución 872 de 2013 de Rectoría: "Por medio de la cual se modifica y adiciona parcialmente el Manual de convenios y contratos de la Universidad Nacional de Colombia”. Se delega la competencia para la presentación de propuestas, para adelantar los trámites del proceso contractual y para la suscripción de las pólizas que se requieran tanto la presentación de las propuestas como la legalización de los contratos o convenios respectivos, en los Decanos de Facultad y Directores de Centro e Instituto, que para el caso de este proyecto será el Profesor(a):' texto2,
', Decano(a) de la '|| DPN1.DPN_NOMBRE ||'.' texto3,
decode(dpn.sed_id,'2','Bogotá D.C.','3','Medellín','4','Manizales','5','Palmira','6','Leticia','7','Arauca','8','San Andrés','9','Tumaco','Bogotá D.C.')ciu
FROM
HER_PERSONA PER, HER_AVAL AVL LEFT JOIN HER_CONVOCATORIA_EXTERNA ce on TO_CHAR(ce.CEX_ID) = avl.AVI_CONVOCATORIA,HER_DEPENDENCIA DPN,  HER_DEPENDENCIA DPN1, HER_PAIS, HER_FUENTE_FINANCIACION f
WHERE
    PER.PER_ID = AVL.INV_ID
AND PER.TDO_ID = AVL.TDO_ID
AND AVL.AVI_ID = ?
AND  DPN.DPN_ID = AVL.DPN_ID
AND  DPN.DPN_ID_2 = DPN1.DPN_ID
AND HER_PAIS.PAIS_ID = AVL.PAIS_ID
AND f.FFI_ID = AVI_ENTIDAD</property>

	<parameter name="ID_CURSO" isForPrompting="true" class="java.lang.String">
		<defaultValueExpression ><![CDATA["1"]]></defaultValueExpression>
	</parameter>
	<queryString><![CDATA[SELECT herf_nombre_dpn(dep.dpn_facultad)    FACULTAD,
          CASE dep.sed_id 
          WHEN '2' THEN 'http://www.hermes.unal.edu.co/imgplantilla/escudoun_bogota.jpg'
          WHEN '3' THEN 'http://www.hermes.unal.edu.co/imgplantilla/escudoun_med.jpg'
          WHEN '4' THEN 'http://www.hermes.unal.edu.co/imgplantilla/escudoun_man.jpg'
          WHEN '5' THEN 'http://www.hermes.unal.edu.co/imgplantilla/escudoun_pal.jpg'
          WHEN '6' THEN 'http://www.hermes.unal.edu.co/imgplantilla/escudoun_amz.jpg'
          WHEN '7' THEN 'http://www.hermes.unal.edu.co/imgplantilla/escudoun_orq.jpg'
          WHEN '8' THEN 'http://www.hermes.unal.edu.co/imgplantilla/escudoun_car.jpg'
          WHEN '9' THEN 'http://www.hermes.unal.edu.co/imgplantilla/escudoun.jpg'
          ELSE 'http://www.hermes.unal.edu.co/imgplantilla/escudoun.jpg'
          END URL_LOGO_SEDE,
      herf_nom_persona(per_id) NOMBRE,
      per.per_id                NUMERO_DOCUMENTO,
      per.per_telefono          TELEFONO,
      per.per_celular           TELEFONO_MOVIL,
      per.per_direccion         DIRECCION,
      per.per_email            	E_MAIL,
      per.per_resumen_hdv           RESUMEN_HDV,
      tc.tca_nombre             CATEGORIA_DOCENTE,
      td.tde_nombre             DEDICACION_DOCENTE,
      ip.inp_dedicacion_horas_semana HORAS
FROM  her_persona per,
      her_dependencia dep,
      her_investigador_proyecto ip,
      her_proyecto pry,
      her_tipo_investigador ti,
      her_investigador_interno ii,
      her_tipo_cargo tc,
      her_tipo_dedicacion td,
      her_aval av
WHERE per.per_id = ip.inv_id
AND   dep.dpn_id = av.dpn_id
AND   ip.pry_id = pry.pry_id
AND   ip.inv_id = ii.inv_id
AND   ip.inp_tipo = ti.tinv_id
AND   ii.tca_id = tc.tca_id
AND   ii.tde_id = td.tde_id
AND   pry.pry_id = av.pry_id
AND   pry.pry_id = $P{ID_CURSO}]]></queryString>


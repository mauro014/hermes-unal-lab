	<parameter name="AVI_ID" isForPrompting="true" class="java.lang.String">
		<defaultValueExpression ><![CDATA["1"]]></defaultValueExpression>
	</parameter>
	<queryString><![CDATA[SELECT herf_nombre_dpn(dep.dpn_facultad)    facultad,
CASE (SELECT  d.sed_id FROM her_proyecto p, her_dependencia d WHERE p.pry_id = pry.pry_id and p.pry_lugar = d.dpn_id) 
          WHEN '2' THEN 'http://www.hermes.unal.edu.co/imgplantilla/escudoun_bogota.jpg'
          WHEN '3' THEN 'http://www.hermes.unal.edu.co/imgplantilla/escudoun_med.jpg'
          WHEN '4' THEN 'http://www.hermes.unal.edu.co/imgplantilla/escudoun_man.jpg'
          WHEN '5' THEN 'http://www.hermes.unal.edu.co/imgplantilla/escudoun_pal.jpg'
          WHEN '6' THEN 'http://www.hermes.unal.edu.co/imgplantilla/escudoun_amz.jpg'
          WHEN '7' THEN 'http://www.hermes.unal.edu.co/imgplantilla/escudoun_orq.jpg'
          WHEN '8' THEN 'http://www.hermes.unal.edu.co/imgplantilla/escudoun_car.jpg'
          WHEN '9' THEN 'http://www.hermes.unal.edu.co/imgplantilla/escudoun.jpg'
          ELSE 'http://www.hermes.unal.edu.co/imgplantilla/escudoun.jpg'
          END url_logo_sede,
aval.avi_fecharegistro                      fecha_recepcion,
aval.avi_fecharegistro                      fecha_entrega,
pry.pry_nombre                              nombre_propuesta,
herf_nombre_dpn(pry.dpn_id)                 uab_proponente,
decode(dir_uab.valor,null,' ',herf_nom_persona(dir_uab.valor))             director_uab,
herf_nom_persona(dir_pry.inv_id)            director_proyecto,
aval.avi_duracionh                          duracion_programa,
''                                          estudio_propuesta,
nvl(aval.avi_descripcionfacultad,' ')       pertinencia
FROM  her_aval aval,
      her_proyecto pry,
      her_dependencia dep,
      her_investigador_proyecto dir_pry,
      her_parametro dir_uab
WHERE aval.avi_id = $P{AVI_ID}
AND   pry.pry_id = aval.pry_id
AND   dep.dpn_id = aval.dpn_id
AND   dir_pry.pry_id = pry.pry_id
AND   dir_pry.inp_tipo = 'P' --Director
AND   dir_uab.nombre(+) = aval.dpn_id]]></queryString>


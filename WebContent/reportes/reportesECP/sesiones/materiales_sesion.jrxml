	<parameter name="ID_SESION" isForPrompting="true" class="java.lang.String">
		<defaultValueExpression ><![CDATA["1"]]></defaultValueExpression>
	</parameter>
	<queryString><![CDATA[SELECT ms.mat_descripcion descripcion,
       ms.mat_cantidad cantidad,
       ms.mat_valor valor_aproximado
FROM   her_material_sesion ms
WHERE  ms.ses_id = $P{ID_SESION}]]></queryString>

	<field name="DESCRIPCION" class="java.lang.String"/>
	<field name="CANTIDAD" class="java.math.BigDecimal"/>

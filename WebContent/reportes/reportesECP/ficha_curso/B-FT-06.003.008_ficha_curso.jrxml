	</parameter>
	<queryString><![CDATA[SELECT herf_nombre_dpn(dep.dpn_facultad)    facultad,
          CASE pry.sed_id 
          WHEN '2' THEN 'http://www.hermes.unal.edu.co/imgplantilla/escudoun_bogota.jpg'
          WHEN '3' THEN 'http://www.hermes.unal.edu.co/imgplantilla/escudoun_med.jpg'
          WHEN '4' THEN 'http://www.hermes.unal.edu.co/imgplantilla/escudoun_man.jpg'
          WHEN '5' THEN 'http://www.hermes.unal.edu.co/imgplantilla/escudoun_pal.jpg'
          WHEN '6' THEN 'http://www.hermes.unal.edu.co/imgplantilla/escudoun_amz.jpg'
          WHEN '7' THEN 'http://www.hermes.unal.edu.co/imgplantilla/escudoun_orq.jpg'
          WHEN '8' THEN 'http://www.hermes.unal.edu.co/imgplantilla/escudoun_car.jpg'
          WHEN '9' THEN 'http://www.hermes.unal.edu.co/imgplantilla/escudoun.jpg'
          ELSE 'http://www.hermes.unal.edu.co/imgplantilla/escudoun.jpg'
          END url_logo_sede,
pry.pry_nombre                              nombre_evento,
herf_nom_persona(dir_pry.inv_id)            docente_encargado,
pry.pry_abstract                            abstract,
herf_descr_dom_det(pry.pry_clase_evento,26) clase_evento,
--pry.pry_clase_evento_ext                    clase_evento_ext,
DECODE (pry.pry_subtipo_activ_ecp,'83_01','X',' ') evento_ext_conferencia,
DECODE (pry.pry_subtipo_activ_ecp,'83_03','X',' ') evento_ext_seminario,
DECODE (pry.pry_subtipo_activ_ecp,'83_04','X',' ') evento_ext_congreso,
DECODE (pry.pry_subtipo_activ_ecp,'83_05',' ',' ') evento_ext_feria_esp,
DECODE (pry.pry_subtipo_activ_ecp,'83_06','X',' ') evento_ext_taller,
DECODE (pry.pry_subtipo_activ_ecp,'83_02','X',' ') evento_ext_even_tematico,
pry.pry_otro_clase_evento                   otro_clase_evento,
herf_nombre_dpn(dep.dpn_id)                 uab,
herf_descr_dom_det(pry.eje_tematico,61)     area_tematica,
pry.pry_objetivo_general                    objetivo_general,
PRY_PUBLICO_OBJETIVO_ECP		    publico_objetivo,
pry.pry_metodologia                         metodologia,
pry.pry_sesiones                            num_sesiones,
pry.pry_horas_sesiones                      horas_sesiones,
--pry.pry_dia_sesion                          horario,
DECODE((SELECT count(*) FROM her_ext_ecp_oferta_horarios WHERE her_ext_ecp_oferta_horarios.pry_id = pry.pry_id AND her_ext_ecp_oferta_horarios.dia = 'Lunes'),1,'X',' ') lunes,
DECODE((SELECT count(*) FROM her_ext_ecp_oferta_horarios WHERE her_ext_ecp_oferta_horarios.pry_id = pry.pry_id AND her_ext_ecp_oferta_horarios.dia = 'Martes'),1,'X',' ') martes,
DECODE((SELECT count(*) FROM her_ext_ecp_oferta_horarios WHERE her_ext_ecp_oferta_horarios.pry_id = pry.pry_id AND her_ext_ecp_oferta_horarios.dia = 'Miercoles'),1,'X',' ') miercoles,
DECODE((SELECT count(*) FROM her_ext_ecp_oferta_horarios where her_ext_ecp_oferta_horarios.pry_id = pry.pry_id and her_ext_ecp_oferta_horarios.dia = 'Jueves'),1,'X',' ') jueves,
DECODE((SELECT count(*) FROM her_ext_ecp_oferta_horarios WHERE her_ext_ecp_oferta_horarios.pry_id = pry.pry_id AND her_ext_ecp_oferta_horarios.dia = 'Viernes'),1,'X',' ') viernes,
DECODE((SELECT count(*) FROM her_ext_ecp_oferta_horarios WHERE her_ext_ecp_oferta_horarios.pry_id = pry.pry_id AND her_ext_ecp_oferta_horarios.dia = 'Sabado'),1,'X',' ') sabado,
DECODE((SELECT count(*) FROM her_ext_ecp_oferta_horarios where her_ext_ecp_oferta_horarios.pry_id = pry.pry_id and her_ext_ecp_oferta_horarios.dia = 'Domingo'),1,'X',' ') domingo,
(select HORA_INICIO || ' - ' || HORA_FIN from HER_EXT_ECP_OFERTA_HORARIOS where pry_id = pry.pry_id and rownum = 1)                        hora_sesion,
pry.pry_fecha_tentativa_inicio              fecha_inicio_sug,
pry.pry_fecha_final                         fecha_final,
pry.pry_tipo_espacio                        tipo_espacio,
--pry.pry_logistica                           equipos,
DECODE (nvl(instr(pry.pry_logistica,'1;'),0),0,' ','X') video_beam,
DECODE (nvl(instr(pry.pry_logistica,'2;'),0),0,' ','X') televisor,
DECODE (nvl(instr(pry.pry_logistica,'3;'),0),0,' ','X') reproductor_dvd,
DECODE (nvl(instr(pry.pry_logistica,'4;'),0),0,' ','X') traduccion_simul,
DECODE (nvl(instr(pry.pry_logistica,'5;'),0),0,' ','X') computador,
DECODE (nvl(instr(pry.pry_logistica,'6;'),0),0,' ','X') equipo_otro,
pry.pry_otra_logistica                      otros_equipos,
DECODE(pry.pry_monitores,'1','X',' ')       no_monitores,
DECODE(pry.pry_monitores,'2','X',' ')       si_monitores,
pry.pry_nro_monitores                       num_monitores,
--pry.pry_servicios                           servicios,
DECODE (nvl(instr(pry.pry_servicios,'1;'),0),0,' ','X') refrigerio,
DECODE (nvl(instr(pry.pry_servicios,'2;'),0),0,' ','X') almuerzo,
DECODE (nvl(instr(pry.pry_servicios,'3;'),0),0,' ','X') estacion_cafe,
DECODE (nvl(instr(pry.pry_servicios,'4;'),0),0,' ','X') transporte,
DECODE (nvl(instr(pry.pry_servicios,'5;'),0),0,' ','X') servicio_otro,
pry.pry_otro_servicio                       otro_servicio,
pry.pry_descripcion_logistica               evento_logistica
FROM  her_proyecto pry,
      her_dependencia dep,
      her_investigador_proyecto dir_pry,
      her_aval av
WHERE pry.pry_id = $P{ID_CURSO}
AND   pry.pry_id = av.pry_id
AND   dep.dpn_id = av.dpn_id
AND   dir_pry.inp_tipo = 'P'
AND   dir_pry.pry_id = pry.pry_id]]></queryString>


            <property name="queryText">select rownum,ce.PRE_ID,cre.CRI_ID,CRI_NOMBRE, CAE_CUANTITATIVA, CAE_CUALITATIVA from
her_calificacion_evaluacion ce, HER_PROYECTO_EVALUADOR pe, her_proyecto pry,
her_criterio_evaluacion cre, her_modalidad_criterio  mcr
where
ce.PRE_ID = pe.PRE_ID and
pe.PRY_ID = pry.PRY_ID and
pry.MOD_ID = mcr.MOD_ID and
cre.CRI_ID = ce.CRI_ID and
cre.CRI_ID = mcr.CRI_ID and
cre.CRI_FACTOR_PESO &lt;> 0 and 
pe.PRE_ID = ?
order by mcr.MCR_ORDEN</property>

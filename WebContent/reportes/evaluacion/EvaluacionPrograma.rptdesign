                    <property name="dataType">string</property>
                </structure>
            </list-property>
            <property name="queryText">select DPN_NOMBRE from her_dependencia
where DPN_ID in
(select d.DPN_ID_2
from 
her_proyecto p, her_investigador_proyecto ip, her_persona per,
her_investigador_interno ii, her_dependencia d,HER_PROYECTO_EVALUADOR pe
where 
p.PRY_ID = ip.PRY_ID and
ip.INV_ID = per.PER_ID and
per.PER_ID = ii.INV_ID and
ii.INV_ID = ip.INV_ID  and 
ii.DPN_ID = d.DPN_ID and
ip.INP_TIPO = 'P' and
p.pry_id = pe.pry_id and
pre_id = ?)</property>

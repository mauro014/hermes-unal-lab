                    <property name="name">DPN_NOMBRE</property>
                    <property name="nativeName">DPN_NOMBRE</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">2</property>
                    <property name="name">INVESTIGADOR</property>
                    <property name="nativeName">INVESTIGADOR</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">3</property>
                    <property name="name">DPN_ID_2</property>
                    <property name="nativeName">DPN_ID_2</property>

                    <property name="nativeName">SUBSTR(C.CON_TITULO,1,11)</property>
                    <property name="dataType">string</property>
                </structure>
            </list-property>
            <property name="queryText">select cp.CNP_TITULO, substr(c.CON_TITULO,1,11) 
from HER_CONVOCATORIA_PADRE cp, HER_PROYECTO_EVALUADOR pe, 
her_proyecto p, her_convocatoria c
where 
cp.CNP_ID = c.CNP_ID and 
c.CON_ID = p.mod_id and 
pe.PRY_ID = p.pry_id and 
pre_id = ?</property>

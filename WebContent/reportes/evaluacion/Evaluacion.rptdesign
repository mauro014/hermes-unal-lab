                    <property name="nativeName">FACULTAD</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">4</property>
                    <property name="name">PRE_FECHA</property>
                    <property name="nativeName">PRE_FECHA</property>
                    <property name="dataType">date-time</property>
                </structure>
                <structure>
                    <property name="position">5</property>
                    <property name="name">PRE_ID</property>
                    <property name="nativeName">PRE_ID</property>
                    <property name="dataType">decimal</property>
                </structure>
            </list-property>
            <property name="queryText">select per.per_nombre1 || ' ' ||  per.per_nombre2 || ' ' ||  per.per_apellido1 || ' ' ||  per.per_apellido2 nombre,
d.dpn_nombre dependencia, facultad.dpn_nombre facultad, pe.PRE_FECHA, pre_id
from 
her_proyecto p, her_investigador_proyecto ip, her_persona per,
her_investigador_interno ii, HER_PROYECTO_EVALUADOR pe, HER_DEPENDENCIA D, HER_DEPENDENCIA facultad
where 
p.PRY_ID = ip.PRY_ID and
ip.INV_ID = per.PER_ID and
ip.TDO_ID = per.TDO_ID and
per.PER_ID = ii.INV_ID and
per.TDO_ID = ii.TDO_ID and
ii.INV_ID = ip.INV_ID  and 
ii.INV_ID = ip.INV_ID  and 
ip.INP_TIPO = 'P' and
ii.dpn_id = d.dpn_id and
d.dpn_facultad = facultad.dpn_id and
p.pry_id = pe.pry_id and
pre_id = ?</property>
        </oda-data-set>

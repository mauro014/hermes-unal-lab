            <property name="queryText">select PRE_OBSERVACIONES, TCO_NOMBRE, PRE_CALIFICACION_FINAL CAF
from HER_PROYECTO_EVALUADOR pe left join HER_TIPO_CONCEPTO tc on pe.PRE_CONCEPTO = tc.TCO_ID
where pe.pre_ID = ?</property>

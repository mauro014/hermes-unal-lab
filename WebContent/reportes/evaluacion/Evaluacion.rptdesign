                </structure>
                <structure>
                    <property name="position">4</property>
                    <property name="name">CUA</property>
                    <property name="nativeName">CUA</property>
                    <property name="dataType">decimal</property>
                </structure>
                <structure>
                    <property name="position">5</property>
                    <property name="name">CAE_CUALITATIVA</property>
                    <property name="nativeName">CAE_CUALITATIVA</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">6</property>
                    <property name="name">PAGINA</property>
                    <property name="nativeName">PAGINA</property>

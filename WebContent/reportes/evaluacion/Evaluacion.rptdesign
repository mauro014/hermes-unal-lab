            <list-property name="parameters">
                <structure>
                    <property name="name">param_1</property>
                    <property name="paramName">id</property>
                    <property name="dataType">string</property>
                    <property name="position">1</property>
                    <property name="isInput">true</property>
                    <property name="isOutput">false</property>
                </structure>
            </list-property>
            <list-property name="resultSet">
                <structure>
                    <property name="position">1</property>
                    <property name="name">CNP_TITULO</property>
                    <property name="nativeName">CNP_TITULO</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">2</property>
                    <property name="name">CON_TITULO</property>
                    <property name="nativeName">CON_TITULO</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">3</property>
                    <property name="name">PRY_NOMBRE</property>
                    <property name="nativeName">PRY_NOMBRE</property>
                    <property name="dataType">string</property>
                </structure>
            </list-property>
            <property name="queryText">select cp.CNP_TITULO, c.CON_TITULO, p.pry_nombre
from HER_CONVOCATORIA_PADRE cp, HER_PROYECTO_EVALUADOR pe, 
her_proyecto p, her_convocatoria c
where 
cp.CNP_ID = c.CNP_ID and 
c.CON_ID = p.mod_id and 
pe.PRY_ID = p.pry_id and 
pre_id = ?</property>
        </oda-data-set>

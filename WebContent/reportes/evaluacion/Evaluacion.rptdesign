                </structure>
                <structure>
                    <property name="position">7</property>
                    <property name="name">SE_TIENE_PARA_PROMEDIO</property>
                    <property name="nativeName">SE_TIENE_PARA_PROMEDIO</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">8</property>
                    <property name="name">NOMBRE</property>
                    <property name="nativeName">NOMBRE</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">9</property>
                    <property name="name">VALOR</property>
                    <property name="nativeName">VALOR</property>
                    <property name="dataType">decimal</property>
                </structure>
                <structure>
                    <property name="position">10</property>
                    <property name="name">CRI_DESCRIPCION</property>
                    <property name="nativeName">CRI_DESCRIPCION</property>
                    <property name="dataType">string</property>
                </structure>
            </list-property>
            <property name="queryText">select ce.pre_id, cre.cri_id, cre.cri_nombre, 
decode(om.valor,'',ce.cae_cuantitativa,om.valor) CUA, 
decode(LENGTHB(TO_CHAR(SUBSTR(ce.cae_cualitativa,1,4000))),0,'No se ingreso calificación cualitativa.',substr(ce.cae_cualitativa,1,4000)) cae_cualitativa,
tp.pagina, tp.se_tiene_para_promedio,
om.nombre,
om.valor,
cre.cri_descripcion
from
her_proyecto_evaluador pe left join 
her_calificacion_evaluacion ce on ce.pre_id = pe.pre_id left join
her_criterio_evaluacion cre on cre.cri_id = ce.cri_id left join
her_proyecto pry on pe.pry_id = pry.pry_id left join 
her_modalidad_criterio mc on mc.cri_id = cre.cri_id and mc.mod_id = pry.mod_id left join
her_tipo_pregunta tp on tp.id = mc.tpp_id left join
her_opc_mul_tipo_pregunta omtp on omtp.tpp_id = tp.id and omtp.opc_id = ce.cae_cuantitativa left join
her_opcion_multiple om on om.id = omtp.opc_id
where
pe.pre_ID = ?
order by cre.CRI_ID</property>
        </oda-data-set>

            <property name="queryText">SELECT
	DISTINCT
	per.PER_NOMBRE1 || decode(per.PER_NOMBRE2, NULL, ' ', ' ' || per.PER_NOMBRE2 || ' ')|| per.PER_APELLIDO1 || decode(per.PER_APELLIDO2, NULL, '', ' ' || per.PER_APELLIDO2) evaluador,
	sed.sed_nombre sed_nombre,
	d2.dpn_nombre facultad,
	d.dpn_nombre departamento,
	per.per_telefono,
	per.per_email,
	per.tdo_id ||'-'||per.per_id as documento,
	per.per_id per_id,
	ev.EVA_AREA_EXPERTICIA,
	ev.EVA_AREA_CIENCIA,
	ev.EVA_SUBAREA_CIENCIA,
	ev.EVA_CVLAC,
	ev.EVA_MINCIENCIAS,
	ev.EVA_TIPO,
	ii.ini_perfil,
	i.INV_URL_COLCIENCIAS,
	i.INV_AREA_OCDE,
	i.INV_SUB_AREA_OCDE,
    cp.cnp_titulo,
    dd.domdet_descripcion
FROM
	HER_EVALUADOR ev left join her_proyecto_evaluador pe on ev.inv_id = pe.inv_id left join 
    her_proyecto p on pe.pry_id = p.pry_id left join her_convocatoria c on p.mod_id = c.con_id left join her_convocatoria_padre cp on
    c.cnp_id = cp.cnp_id  left join her_dominio_detalle dd on cp.CNP_TIPO_CONVOCATORIA = dd.domdet_tipo 
    left join her_dominio d on dd.dom_id = d.dom_id, 
    HER_PERSONA per, HER_INVESTIGADOR i, her_tipo_vinculacion tv,
 HER_INVESTIGADOR_INTERNO ii
LEFT JOIN HER_DEPENDENCIA d ON
	ii.dpn_id = d.dpn_id
LEFT JOIN HER_SEDE sed ON
	d.sed_id = sed.sed_id
LEFT JOIN HER_DEPENDENCIA d2 ON
	d.dpn_facultad = d2.dpn_id

WHERE 
	per.PER_ID NOT IN ('52015719', '52585723', '52116940', '1023876575', '1032380386', '1053799116', '19380666', '52205496', '41654902', '1022389470')
	and per.TDO_ID = ev.TDO_ID AND ev.INV_ID = per.PER_ID and ev.inv_id = ii.inv_id
	AND ev.tdo_id = ii.tdo_id and ev.inv_id = i.inv_id AND ev.tdo_id = i.tdo_id and (tv.tvi_id = ii.tvi_id and (tv.TVI_ES_DOCENTE = 1 or tv.TVI_ES_ADMINISTRATIVO=1))
    and d.dom_tipo = 'TIPO_CONVOCATORIAS'</property>
        </oda-data-set>
    </data-sets>

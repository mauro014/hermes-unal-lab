                    </structure>
                </list-property>
            </structure>
            <property name="dataSource">Oracle</property>
            <list-property name="parameters">
                <structure>
                    <property name="name">param_1</property>
                    <property name="paramName">id</property>
                    <property name="dataType">string</property>
                    <property name="position">1</property>
                    <property name="isInput">true</property>
                    <property name="isOutput">false</property>
                </structure>
            </list-property>
            <list-property name="resultSet">
                <structure>
                    <property name="position">1</property>
                    <property name="name">DPN_NOMBRE</property>
                    <property name="nativeName">DPN_NOMBRE</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">2</property>
                    <property name="name">PRINCIPAL</property>
                    <property name="nativeName">PRINCIPAL</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">3</property>
                    <property name="name">DPN_ID_2</property>
                    <property name="nativeName">DPN_ID_2</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">4</property>
                    <property name="name">DPN_ID</property>
                    <property name="nativeName">DPN_ID</property>
                    <property name="dataType">string</property>
                </structure>
            </list-property>
            <property name="queryText">select distinct(d.DPN_NOMBRE),
PER.PER_APELLIDO1||' '||DECODE(PER.PER_APELLIDO2, PER.PER_APELLIDO2,PER.PER_APELLIDO2,NULL,' ')||' '||PER.PER_NOMBRE1||' '||DECODE(PER.PER_NOMBRE2, PER.PER_NOMBRE2,PER.PER_NOMBRE2,NULL,' ')PRINCIPAL,
d.DPN_ID_2,d.DPN_ID
from 
her_proyecto p, her_investigador_proyecto ip, her_persona per,
her_investigador_interno ii, her_dependencia d, HER_PROYECTO_EVALUADOR pe
where 
p.PRY_ID = ip.PRY_ID and
ip.INV_ID = per.PER_ID and
per.PER_ID = ii.INV_ID and
ii.INV_ID = ip.INV_ID  and 
ii.DPN_ID = d.DPN_ID and
ip.INP_TIPO = 'P' and
p.pry_id = pe.pry_id and
pre_id = ?</property>
        </oda-data-set>

            <property name="queryText">select PE.INV_ID, per.PER_APELLIDO1,PER_APELLIDO2,PER_NOMBRE1,PER_NOMBRE2 
from HER_PROYECTO_EVALUADOR pe, HER_PERSONA PER
where
PE.INV_ID = per.PER_ID and
pe.pre_ID = ?</property>

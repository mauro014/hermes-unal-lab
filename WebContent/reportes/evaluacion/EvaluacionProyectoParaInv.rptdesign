            <property name="queryText">select rownum,ce.PRE_ID,cre.CRI_ID,CRI_NOMBRE, CAE_CUANTITATIVA, CAE_CUALITATIVA from
her_calificacion_evaluacion ce, HER_PROYECTO_EVALUADOR pe,
her_criterio_evaluacion cre
where
ce.PRE_ID = pe.PRE_ID and
cre.CRI_ID = ce.CRI_ID and
pe.pre_ID = ? 
order by cre.CRI_ID</property>

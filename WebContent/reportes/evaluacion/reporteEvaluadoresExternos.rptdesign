            <property name="queryText">SELECT
	DISTINCT
	per.PER_NOMBRE1 || decode(per.PER_NOMBRE2, NULL, ' ', ' ' || per.PER_NOMBRE2 || ' ')|| per.PER_APELLIDO1 || decode(per.PER_APELLIDO2, NULL, '', ' ' || per.PER_APELLIDO2) evaluador,
	per.per_telefono,
	per.per_email,
	per.tdo_id ||'-'||per.per_id as documento,
	per.per_id per_id,
	ev.EVA_AREA_EXPERTICIA,
    ddciencia.domdet_descripcion as area_ciencia,
	ddsciencia.domdet_descripcion as subarea_ciencia,
	ev.EVA_CVLAC,
	ev.EVA_MINCIENCIAS,
	ev.EVA_TIPO,
    decode(ev.EVA_CVLAC,null,i.INV_URL_COLCIENCIAS,ev.EVA_CVLAC) cvlac,
    cp.cnp_titulo,
    dd.domdet_descripcion,
    ff.FFI_DESCRIPCION as estudio,
    labora.ffi_descripcion as labora,
    per.PER_GENERO
    
FROM
	her_proyecto_evaluador pe 
	left join HER_EVALUADOR ev on ev.inv_id = pe.inv_id 
	left join her_proyecto p on pe.pry_id = p.pry_id 
	left join her_convocatoria c on p.mod_id = c.con_id 
	left join her_convocatoria_padre cp on c.cnp_id = cp.cnp_id  
    left join her_dominio_detalle dd on cp.CNP_TIPO_CONVOCATORIA = dd.domdet_tipo 
    left join her_dominio d on dd.dom_id = d.dom_id
    left join her_fuente_financiacion ff on ff.ffi_id = ev.FFI_ID_ESTUDIO
    left join her_fuente_financiacion labora on labora.ffi_id = ev.FFI_ID_LABORA 
    left join her_dominio dciencia on dciencia.dom_tipo = 'AREA_CIENCIA'
    left join her_dominio_detalle ddciencia on ddciencia.dom_id = dciencia.dom_id and ev.EVA_AREA_CIENCIA = ddciencia.domdet_tipo
    left join her_dominio dsciencia on dsciencia.dom_tipo = 'SUB_AREA_CIENCIA_FM'
    left join her_dominio_detalle ddsciencia on ddsciencia.dom_id = dsciencia.dom_id and ev.EVA_SUBAREA_CIENCIA = ddsciencia.domdet_tipo,
    HER_PERSONA per, HER_INVESTIGADOR i

WHERE 
	per.PER_ID NOT IN ('52015719', '52585723', '52116940', '1023876575', '1032380386', '1053799116', '19380666', '52205496', '41654902', '1022389470')
	and per.TDO_ID = i.TDO_ID AND i.INV_ID = per.PER_ID and pe.inv_id = i.inv_id and pe.tdo_id = i.tdo_id and i.inv_interno not in ('S')
    and d.dom_tipo = 'TIPO_CONVOCATORIAS'</property>
        </oda-data-set>
    </data-sets>

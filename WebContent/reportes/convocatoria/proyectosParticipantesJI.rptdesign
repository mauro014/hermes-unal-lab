                    <property name="name">NOMBRE_TUTOR</property>
                    <property name="nativeName">NOMBRE_TUTOR</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">2</property>
                    <property name="name">DOCUMENTO_TUTOR</property>
                    <property name="nativeName">DOCUMENTO_TUTOR</property>

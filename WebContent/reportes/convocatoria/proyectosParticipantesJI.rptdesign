            <property name="queryText">select 
nvl(pe.PER_APELLIDO1 || ' ' || nvl(pe.PER_APELLIDO2,'') || ' ' || pe.PER_NOMBRE1 || ' ' || nvl(pe.PER_NOMBRE2, ''),'-')  NOMBRE_DIRECTOR,
nvl(pe.PER_ID, '*') DOCUMENTO_DIRECTOR,
nvl(d.DPN_NOMBRE,'') DEPENDENCIA_DIRECTOR ,
nvl(d2.DPN_NOMBRE,'') SEDE_DIRECTOR,
g.GRU_NOMBRE
from her_investigador_grupo ig, her_grupo_proyecto gp, her_proyecto p,her_grupo g, her_persona pe, her_dependencia d, her_dependencia d2, her_investigador_interno ii
where ig.INV_ID =  ii.INV_ID
and ig.INV_ID = pe.PER_ID
and gp.GRU_ID = ig.GRU_ID
and ig.ING_TIPO = 'L' 
and ii.DPN_ID = d.DPN_ID
and d.SED_ID = d2.dpn_id
and gp.PRY_ID = p.pry_id
and gp.GRU_ID = g.GRU_ID
and p.pry_id = ?</property>
        </oda-data-set>

            <property name="queryText">select 
p.PRY_ID ID_PROYECTO, ep.EPR_NOMBRE ESTADO_PROYECTO, p.PRY_NOMBRE NOMBRE_PROYECTO,
decode(p.PRY_AVAL_ASOC,null,'', p.PRY_AVAL_ASOC) AVAL_ASOCIADO,
G.GRU_NOMBRE NOMBRE_GRUPO, G.GRU_COLCIENCIAS CODIGO_COLCIENCIAS,
G.GRU_CATEGORIA_COLCIENCIAS CATEGORIA_COLCIENCIAS_GRUPO,
pe.PER_APELLIDO1 || ' ' || nvl(pe.PER_APELLIDO2,'') || ' ' || pe.PER_NOMBRE1 || ' ' || 
nvl(pe.PER_NOMBRE2, '') NOMBRE_DOCENTE,
pe.PER_ID DOCUMENTO,d.DPN_NOMBRE DEPENDENCIA ,
d2.DPN_NOMBRE SEDE, 
per.PER_APELLIDO1 || ' ' || nvl(per.PER_APELLIDO2,'') || ' ' || per.PER_NOMBRE1 || ' ' || 
nvl(per.PER_NOMBRE2, '') NOMBRE_JOVEN, per.per_id documento_joven, PER.PER_EMAIL CORREO,
per.PER_EDAD EDAD_JOVEN, 
to_char(per.PER_FNACIMIENTO,'yyyy-MM-dd') FECHA_NACIMIENTO, cc.ciu_nombre CIUDAD_NACIMIENTO, 
to_char(PER.PER_FECH_TITU_PREGRADO,'yyyy-MM-dd')  FECHA_GRADO , 
PER.PER_PROFESION TITULO_PREGRADO ,
PER.PER_RESUMEN_HDV UNIVERSIDAD,
PER.PER_FACULTAD_PREGRADO FACULTAD_PREGRADO ,
PER.PER_PROMEDIO_PREGRADO PROMEDIO_PREGRADO,
PER.PER_TELEFONO AS TELEFONO, PER.PER_CELULAR AS CELULAR 
from
her_proyecto p, her_investigador_proyecto ip,her_grupo g,her_persona pe,her_grupo_proyecto gp, 
her_dependencia d, her_dependencia d2, her_investigador_interno ii,her_ciudad cc,
her_investigador_proyecto pi,her_persona per, her_estado_proyecto ep
where
p.MOD_ID = ?
and p.pry_id = ip.PRY_ID
and ip.INV_ID =  ii.INV_ID
and ip.INV_ID = pe.PER_ID
and ii.DPN_ID = d.DPN_ID
and ip.INP_TIPO = 'P' 
and ip.INV_ID = pe.PER_ID
and gp.pry_id (+)= p.pry_id
and g.GRU_ID (+)= gp.gru_id 
and d.SED_ID = d2.dpn_id
and p.pry_id = pi.PRY_ID
and pi.INP_TIPO not in ('P')
and pi.INP_tipo not in ('JITU')
and pi.inv_id = per.per_id
and cc.ciu_id (+)= PER.CIU_NACIMIENTO_ID
and ep.epr_id = p.epr_id
and ep.epr_id not in ('B')
and ep.epr_id = ?
ORDER BY P.PRY_ID</property>
        </oda-data-set>

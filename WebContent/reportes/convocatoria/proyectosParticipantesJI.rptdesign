            <property name="queryText">select P.PRY_CREADOR_ID DOCUMENTO_CREADOR

from  her_proyecto p

where

p.pry_id = ?</property>
        </oda-data-set>
        <oda-data-set extensionID="org.eclipse.birt.report.data.oda.jdbc.JdbcSelectDataSet" name="principal" id="7505">
            <structure name="cachedMetaData">
                <list-property name="resultSet">
                    <structure>
                        <property name="position">1</property>
                        <property name="name">NOMBRE_DIRECTOR</property>
                        <property name="dataType">string</property>
                    </structure>
                    <structure>
                        <property name="position">2</property>
                        <property name="name">DOCUMENTO_DIRECTOR</property>
                        <property name="dataType">string</property>
                    </structure>
                    <structure>
                        <property name="position">3</property>
                        <property name="name">DEPENDENCIA_DIRECTOR</property>
                        <property name="dataType">string</property>
                    </structure>
                    <structure>
                        <property name="position">4</property>
                        <property name="name">SEDE_DIRECTOR</property>
                        <property name="dataType">string</property>
                    </structure>
                </list-property>
            </structure>
            <property name="dataSource">Oracle</property>
            <list-property name="parameters">
                <structure>
                    <property name="name">IdProyecto</property>
                    <property name="dataType">decimal</property>
                    <property name="position">1</property>
                    <expression name="defaultValue">0</expression>
                    <property name="isInput">true</property>
                    <property name="isOutput">false</property>
                </structure>
            </list-property>
            <list-property name="resultSet">
                <structure>
                    <property name="position">1</property>
                    <property name="name">NOMBRE_DIRECTOR</property>
                    <property name="nativeName">NOMBRE_DIRECTOR</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">2</property>
                    <property name="name">DOCUMENTO_DIRECTOR</property>
                    <property name="nativeName">DOCUMENTO_DIRECTOR</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">3</property>
                    <property name="name">DEPENDENCIA_DIRECTOR</property>
                    <property name="nativeName">DEPENDENCIA_DIRECTOR</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">4</property>
                    <property name="name">SEDE_DIRECTOR</property>
                    <property name="nativeName">SEDE_DIRECTOR</property>
                    <property name="dataType">string</property>
                </structure>
            </list-property>
            <property name="queryText">select 
nvl(pe.PER_APELLIDO1 || ' ' || nvl(pe.PER_APELLIDO2,'') || ' ' || pe.PER_NOMBRE1 || ' ' || nvl(pe.PER_NOMBRE2, ''),'-')  NOMBRE_DIRECTOR,
nvl(pe.PER_ID, '*') DOCUMENTO_DIRECTOR,
nvl(d.DPN_NOMBRE,'') DEPENDENCIA_DIRECTOR ,
nvl(d2.DPN_NOMBRE,'') SEDE_DIRECTOR
from her_investigador_proyecto ip, her_proyecto p, her_persona pe, her_dependencia d, her_dependencia d2, her_investigador_interno ii
where p.pry_id = ip.PRY_ID
and ip.INV_ID =  ii.INV_ID
and ip.INV_ID = pe.PER_ID
and ip.INP_TIPO = 'P' 
and ii.DPN_ID = d.DPN_ID
and d.SED_ID = d2.dpn_id
and p.pry_id = ?</property>
        </oda-data-set>
    </data-sets>

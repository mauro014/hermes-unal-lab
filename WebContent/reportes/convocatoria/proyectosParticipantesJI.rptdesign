                </structure>
                <structure>
                    <property name="position">4</property>
                    <property name="name">FACULTAD_TUTOR</property>
                    <property name="nativeName">FACULTAD_TUTOR</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">5</property>
                    <property name="name">SEDE_TUTOR</property>
                    <property name="nativeName">SEDE_TUTOR</property>
                    <property name="dataType">string</property>
                </structure>
            </list-property>
            <property name="queryText">select 
nvl(pe.PER_APELLIDO1 || ' ' || nvl(pe.PER_APELLIDO2,'') || ' ' || pe.PER_NOMBRE1 || ' ' || nvl(pe.PER_NOMBRE2, ''),'El tutor del proyecto es el director del grupo de investigación')  NOMBRE_TUTOR,
nvl(pe.PER_ID, '*') DOCUMENTO_TUTOR,
nvl(d.DPN_NOMBRE,'') DEPENDENCIA_TUTOR ,
NVL(nvl(d3.DPN_NOMBRE,''),'') FACULTAD_TUTOR ,
nvl(d2.DPN_NOMBRE,'') SEDE_TUTOR
from her_investigador_proyecto ip, her_proyecto p, her_persona pe, her_dependencia d, her_dependencia d2, her_dependencia d3,her_investigador_interno ii
where p.pry_id = ip.PRY_ID
and ip.INV_ID =  ii.INV_ID
and ip.INV_ID = pe.PER_ID
and ip.INP_TIPO = 'JITU' 
and ii.DPN_ID = d.DPN_ID
and d.dpn_facultad = d3.dpn_id
and d.SED_ID = d2.dpn_id
and p.pry_id =?
</property>
        </oda-data-set>

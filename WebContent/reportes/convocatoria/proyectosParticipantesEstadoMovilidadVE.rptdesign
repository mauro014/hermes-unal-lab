                </structure>
                <structure>
                    <property name="position">3</property>
                    <property name="name">SED_NOMBRE</property>
                    <property name="nativeName">SED_NOMBRE</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">4</property>
                    <property name="name">DPN_NOMBRE</property>
                    <property name="nativeName">DPN_NOMBRE</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">5</property>
                    <property name="name">VALOR</property>
                    <property name="nativeName">VALOR</property>
                    <property name="dataType">decimal</property>
                </structure>
                <structure>
                    <property name="position">6</property>
                    <property name="name">CANT</property>
                    <property name="nativeName">CANT</property>
                    <property name="dataType">decimal</property>
                </structure>
            </list-property>
            <property name="queryText">select c.CON_ID,c.CON_TITULO, SED.SED_NOMBRE,  dpn.DPN_NOMBRE, sum(FIN_VALOR) VALOR,count(p.pry_id) CANT
from 
her_proyecto p,her_financiacion f, her_convocatoria c , her_convocatoria_padre cp,
her_sede sed ,her_dependencia dpn
where 
p.PRY_ID = f.PRY_ID and
p.MOD_ID = c.CON_ID and 
p.EPR_ID ='P' and
c.CNP_ID = cp.CNP_ID and
c.SED_ID = sed.sed_id and
c.dpn_RESTRICCION = dpn.DPN_ID 
AND cp.CNP_ID = ?
and  c.CON_ID in(select con_id from her_convocatoria where CNP_ID = ? )
group by c.CON_ID,c.CON_TITULO,dpn.DPN_NOMBRE, SED.SED_NOMBRE
order by c.con_id</property>

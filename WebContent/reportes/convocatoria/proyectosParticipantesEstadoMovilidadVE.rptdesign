            </list-property>
            <property name="queryText">SELECT * FROM 
(
SELECT MOV.MOV_ID ID, MOV.MOV_EVENTO QUIPU, MOV.MOV_PLAN NOMBRE, MOV_NUM_DIAS DURA,MOV.MOV_VALOR_APORTE_FAC as aporteFac, 
MOV.MOV_VALOR_APORTE_SEDE AS aporteSede,MOV.MOV_FECHA_ACEPTACION as fechaRevFac, MOV.MOV_FECHA_APROBACION AS fechaRevSede,
DPN1.DPN_NOMBRE FACULTAD, DPN.DPN_NOMBRE DEPARTAMENTO,INI.INV_ID DOCUMENTO, HER_SEDE.SED_NOMBRE, MOV.MOV_FEC_SOL,
PER.PER_NOMBRE1||' '||DECODE(PER.PER_NOMBRE2, PER.PER_NOMBRE2,PER.PER_NOMBRE2,NULL,' ')||' '||PER.PER_APELLIDO1||' '||
DECODE(PER.PER_APELLIDO2, PER.PER_APELLIDO2,PER.PER_APELLIDO2,NULL,' ')PRINCIPAL,PER.PER_EMAIL EMAIL,
decode(mov.mov_aprob, '', '','SI','A','NO','R','') || decode(mov.mov_acept, '', 'I','SI','AP','NO','N','') as ESTADO_ID, 
MOV.MOV_FEC_INI_EV, MOV.MOV_FEC_FIN_EV,
to_number(nvl(MOV.MOV_COSTO_TIQ,'0'))MOV_COSTO_TIQ, MOV.MOV_MONTO,
to_number(nvl(MOV.MOV_ESTIM_VIRTUAL,'0'))MOV_ESTIM_VIRTUAL,
MOV_NOMBRE_DOCENTE, DECODE(MOV_ESTADO_SEG,'F','Registrado','Sin registrar') SEG,
MOV_EMAIL_VISITANTE,
pfac.PER_NOMBRE1||' '||DECODE(pfac.PER_NOMBRE2, pfac.PER_NOMBRE2,pfac.PER_NOMBRE2,NULL,' ')||' '||pfac.PER_APELLIDO1||' '||DECODE(pfac.PER_APELLIDO2, pfac.PER_APELLIDO2,pfac.PER_APELLIDO2,NULL,' ')RevisorFac,
pSed.PER_NOMBRE1||' '||DECODE(pSed.PER_NOMBRE2, pSed.PER_NOMBRE2,pSed.PER_NOMBRE2,NULL,' ')||' '||pSed.PER_APELLIDO1||' '||DECODE(pSed.PER_APELLIDO2, pSed.PER_APELLIDO2,pSed.PER_APELLIDO2,NULL,' ')RevisorSed,
MOV_TOTAL_APOYO, MOV_TOTAL_TIQUETES, MOV_TOTAL_VIATICOS, MOV_REALIZACION_MOVILIDAD, prog.PLE_NOMBRE as programaAcad, g.GRU_NOMBRE AS NOMBREGRUPO,
MOV.MOV_NACIONALIDAD AS NACIONALIDAD, p.pais_nombre as pais, (select nvl(INS_NOMBRE,MOV_UNIVERSIDAD) from HER_INSTITUCION WHERE INS_ID=MOV_UNIVERSIDAD) AS UNIVERSIDAD, MOV.MOV_EXPERIENCIAS_VISITANTE AS EXPERIENCIA,
MOV.MOV_CALIFICACION_A AS CALA, MOV.MOV_CALIFICACION_B AS CALB, MOV.MOV_CALIFICACION_C AS CALC

FROM HER_MOVILIDAD_VISITANTES_EXT MOV left join her_persona pfac on mov.MOV_ID_PER_APROB = pfac.per_id 
and mov.MOV_TDO_ID_PER_APROB = pfac.tdo_id left join her_persona pSed on mov.MOV_TDO_ID_PER_APROB_SED = 
pSed.TDO_ID and mov.MOV_ID_PER_APROB_SED = pSed.per_id left join HER_PLAN_ESTUDIOS prog on mov.MOV_ID_PROG = prog.PLE_ID 
left join HER_GRUPO g on g.gru_id = mov.MOV_ID_GRUPO left join HER_PAIS p on p.pais_id = mov.MOV_PAIS, 
HER_INVESTIGADOR_INTERNO INI, HER_PERSONA PER, HER_SEDE, HER_DEPENDENCIA DPN, HER_DEPENDENCIA DPN1, HER_PAIS PA

WHERE
INI.INV_ID = MOV.MOV_ID_PER
AND INI.TDO_ID = MOV.MOV_TDO_ID_PER
AND  PER.PER_ID = INI.INV_ID
AND PER.TDO_ID = INI.TDO_ID
AND  DPN.DPN_ID = INI.DPN_ID
AND  DPN.DPN_ID_2 = DPN1.DPN_ID
AND MOV.CON_ID = ?
AND DPN.SED_ID = HER_SEDE.SED_ID
AND MOV.MOV_PAIS = PA.PAIS_ID
ORDER BY MOV.MOV_ID
) MOV

WHERE 
ESTADO_ID = ?
</property>
        </oda-data-set>

                    <property name="position">1</property>
                    <property name="name">CALA</property>
                    <property name="nativeName">CALA</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">2</property>
                    <property name="name">CALB</property>
                    <property name="nativeName">CALB</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">3</property>
                    <property name="name">CALC</property>
                    <property name="nativeName">CALC</property>
                    <property name="dataType">string</property>
                </structure>
            </list-property>
            <property name="queryText">SELECT 
DD.DOMDET_DESCRIPCION AS CALA, DD2.DOMDET_DESCRIPCION AS CALB, DD3.DOMDET_DESCRIPCION AS CALC
FROM HER_MOVILIDAD_VISITANTES_EXT MOV LEFT JOIN HER_DOMINIO_DETALLE DD ON MOV.MOV_CALIFICACION_A = DD.DOMDET_TIPO AND DD.DOM_ID = '4'
LEFT JOIN HER_DOMINIO_DETALLE DD2 ON MOV.MOV_CALIFICACION_B = DD2.DOMDET_TIPO AND DD2.DOM_ID = '4'
LEFT JOIN HER_DOMINIO_DETALLE DD3 ON MOV.MOV_CALIFICACION_C = DD3.DOMDET_TIPO AND DD3.DOM_ID = '4'
where MOV.MOV_ID = ? </property>
        </oda-data-set>

            <property name="queryText">select FFI.FFI_DESCRIPCION, FIN.FIN_VALOR from HER_PROYECTO PRY, HER_FINANCIACION FIN, HER_FUENTE_FINANCIACION FFI 
where FIN.PRY_ID = PRY.PRY_ID
AND FIN.FFI_ID = FFI.FFI_ID  
AND PRY.PRY_ID = ?</property>

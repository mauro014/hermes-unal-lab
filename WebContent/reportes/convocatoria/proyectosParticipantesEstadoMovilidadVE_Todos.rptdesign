            <property name="queryText">select distinct MOV.ACT_MOV_DESCRIPCION AS DESCRIPCION, MOV.ACT_MOV_DURACION AS DIAS, MOV.ACT_MOV_ASISTENTES AS ASISTENTES, planes.ple_nombre as planestudio
from HER_ACTIVIDAD_MOVILIDAD_VE MOV left join HER_PLAN_ESTUDIOS planes on mov.pps_id = planes.ple_id
where MOV.MOV_ID = ? </property>
        </oda-data-set>

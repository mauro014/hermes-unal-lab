                <structure>
                    <property name="position">1</property>
                    <property name="name">VALOR</property>
                    <property name="nativeName">VALOR</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">2</property>
                    <property name="name">CANTIDAD</property>
                    <property name="nativeName">CANTIDAD</property>
                    <property name="dataType">decimal</property>
                </structure>
            </list-property>
            <property name="queryText">SELECT DD.DOMDET_DESCRIPCION AS VALOR, COUNT (*) AS CANTIDAD FROM 
(
SELECT decode(mov.mov_aprob, '', '','SI','A','NO','R','') || decode(mov.mov_acept, '', 'I','SI','AP','NO','N','') as ESTADO_ID
FROM HER_MOVILIDAD_VISITANTES_EXT MOV
WHERE MOV.CON_ID = ?
) MOV LEFT JOIN HER_DOMINIO_DETALLE DD ON DD.DOM_ID = '58' AND ESTADO_ID = DD.DOMDET_TIPO
GROUP BY DD.DOMDET_DESCRIPCION</property>
            <xml-property name="designerValues"><![CDATA[<?xml version="1.0" encoding="UTF-8"?>

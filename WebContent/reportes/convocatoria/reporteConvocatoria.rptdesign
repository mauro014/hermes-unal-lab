            </list-property>
            <property name="queryText">select  REQ.TPR_NOMBRE, REQ.TPR_DESCRIPCION  
from HER_CONVOCATORIA con,  HER_CONVOCATORIA_REQUISITO COR, HER_TIPO_REQUISITO REQ
WHERE 
     CON.CON_ID = COR.CON_ID
AND  REQ.TPR_ID_PADRE = COR.TPR_ID
and  cON.CON_ID = ?</property>

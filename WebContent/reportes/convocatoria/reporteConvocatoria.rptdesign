            </list-property>
            <list-property name="resultSet">
                <structure>
                    <property name="position">1</property>
                    <property name="name">CRI_NOMBRE</property>
                    <property name="nativeName">CRI_NOMBRE</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">2</property>
                    <property name="name">NOMBRE</property>
                    <property name="nativeName">NOMBRE</property>
                    <property name="dataType">string</property>
                </structure>
            </list-property>
            <property name="queryText">SELECT  CRI.CRI_NOMBRE, TPP.NOMBRE
FROM HER_CONVOCATORIA CON,  HER_MODALIDAD_CRITERIO MCR, HER_CRITERIO_EVALUACION CRI,
     HER_TIPO_PREGUNTA TPP
WHERE 
     CON.CON_ID = MCR.MOD_ID
AND  MCR.CRI_ID   = CRI.CRI_ID
AND  MCR.TPP_ID = TPP.ID
AND  CON.CON_ID = ?</property>
        </oda-data-set>
        <oda-data-set extensionID="org.eclipse.birt.report.data.oda.jdbc.JdbcSelectDataSet" name="Recursos" id="7354">
            <structure name="cachedMetaData">
                <list-property name="resultSet">
                    <structure>
                        <property name="position">1</property>
                        <property name="name">SED_NOMBRE</property>
                        <property name="dataType">string</property>
                    </structure>
                    <structure>
                        <property name="position">2</property>
                        <property name="name">VALOR</property>
                        <property name="dataType">decimal</property>
                    </structure>
                    <structure>
                        <property name="position">3</property>
                        <property name="name">APOYO</property>
                        <property name="dataType">decimal</property>
                    </structure>
                </list-property>
            </structure>
            <property name="dataSource">Oracle</property>
            <list-property name="parameters">
                <structure>
                    <property name="name">param_1</property>
                    <property name="paramName">con_id</property>
                    <property name="dataType">string</property>
                    <property name="position">1</property>
                    <property name="isInput">true</property>
                    <property name="isOutput">false</property>
                </structure>
            </list-property>
            <list-property name="resultSet">
                <structure>
                    <property name="position">1</property>
                    <property name="name">SED_NOMBRE</property>
                    <property name="nativeName">SED_NOMBRE</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">2</property>
                    <property name="name">VALOR</property>
                    <property name="nativeName">VALOR</property>
                    <property name="dataType">decimal</property>
                </structure>
                <structure>
                    <property name="position">3</property>
                    <property name="name">APOYO</property>
                    <property name="nativeName">APOYO</property>
                    <property name="dataType">decimal</property>
                </structure>
            </list-property>
            <property name="queryText">SELECT  SED.SED_NOMBRE, DRE.VALOR, DRE.APOYO
FROM HER_CONVOCATORIA_PADRE  CNP , HER_CONVOCATORIA CON,  HER_DISTRIBUCION_RECURSOS  DRE, HER_SEDE SED
WHERE 
     CNP.CNP_ID = CON.CNP_ID  
AND  CNP.CNP_ID = DRE.CNP_ID
AND  CON.CON_ID = DRE.CON_ID
AND  DRE.SED_ID = SED.SED_ID
AND  CON.CON_ID = ?</property>
        </oda-data-set>
    </data-sets>

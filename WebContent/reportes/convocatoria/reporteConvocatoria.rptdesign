            <property name="queryText">SELECT CON.CON_ID Con, CON.CON_TITULO Tit, DPN.DPN_NOMBRE DpnCrea,  
ECO.ECO_NOMBRE Estado,CON.CON_OFERENTE Oferente, CON.CON_OBJETIVO Objetivo, CON.CON_DIRIGIDO_A Dirigido,

DECODE(CON.CON_GRUPOS_CATEGORIA_A,'Y','SI',
                                  'N','NO') GrupoA,
DECODE(CON.CON_GRUPOS_CATEGORIA_B,'Y','SI',
                                  'N','NO') GrupoB,
DECODE(CON.CON_GRUPOS_CATEGORIA_C,'Y','SI',
                                  'N','NO') GrupoC,
DECODE(CON.CON_GRUPOS_CATEGORIA_D,'Y','SI',
                                  'N','NO') GrupoD,   
DECODE(CON.CON_GRUPOS_RECONOCIDOS,'Y','SI',
                                  'N','NO') GrupoR,
DECODE(CON.CON_GRUPOS_REGISTRADOS,'Y','SI',
                                  'N','NO') GrupoG,
DPN1.DPN_NOMBRE DpnRes,                                                                                                 
CON.CON_FINICIO FIniC, CON.CON_FFINAL FFinC, CON.CON_FPUBLICACION_RESULTADOS FPubR, CON.CON_FINICIO_EVAL FIniE, CON.CON_FFINAL_EVAL FFinE,
DECODE (FFI.FFI_INTERNA_EXTERNA, 'I', 'INTERNA',
                                 'E', 'EXTERNA') TipoFte,
FFI.FFI_DESCRIPCION FteDesc, MFF.PORCENTAJE/100 Porc,
CON.CON_RECURSOS_FINANCIEROS RecFin, CON.CON_NUMERO_APOYOS Apoyos, CON.CON_MONTO_APOYO_GANADORES MontoGan, CON.CON_TIEMPO_PROYECTOS DuraPry,
CON.CON_INFORMACION_ADICIONAL InfAd
FROM HER_CONVOCATORIA con, HER_DEPENDENCIA DPN, HER_ESTADO_CONVOCATORIA ECO,
HER_DEPENDENCIA DPN1 ,   HER_MODALIDAD_FUENTE_FCION MFF , HER_FUENTE_FINANCIACION FFI
WHERE 
CON.DPN_ID = DPN.DPN_ID               AND
CON.ECO_ID = ECO.ECO_ID               AND
CON.DPN_RESTRICCION = DPN1.DPN_ID(+)  AND
CON.CON_ID = MFF.MOD_ID               AND
MFF.FFI_ID = FFI.FFI_ID               AND
CON_ID = ?</property>
        </oda-data-set>

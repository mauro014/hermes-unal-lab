                </structure>
            </list-property>
            <property name="queryText">SELECT  TRU.TRU_NOMBRE, RFN.RFN_PORCENTAJE_MAXIMO PORC
FROM
HER_CONVOCATORIA CON , HER_RUBRO_FINANCIABLE RFN, HER_TIPO_RUBRO TRU  
WHERE
     CON.CON_ID = RFN.MOD_ID
AND  RFN.TRU_ID = TRU.TRU_ID
AND CON.CON_ID = ?</property>
        </oda-data-set>

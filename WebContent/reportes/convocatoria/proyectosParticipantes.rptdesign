                </structure>
            </list-property>
            <property name="queryText">SELECT 
 PRY.PRY_ID ID, PRY.PRY_NOMBRE NOMBRE,PRY.PRY_DURACION DURA,
 DPN1.DPN_NOMBRE, DPN.DPN_NOMBRE ,
PER.PER_NOMBRE1||' '||DECODE(PER.PER_NOMBRE2, PER.PER_NOMBRE2,PER.PER_NOMBRE2,NULL,' ')||' '||PER.PER_APELLIDO1||' '||DECODE(PER.PER_APELLIDO2, PER.PER_APELLIDO2,PER.PER_APELLIDO2,NULL,' ')PRINCIPAL,
FIN.FIN_VALOR MONTO --, FFI.FFI_DESCRIPCION FUENTE
FROM HER_PERSONA PER, HER_INVESTIGADOR_PROYECTO IP, HER_INVESTIGADOR_INTERNO INI, HER_PROYECTO PRY, 
HER_FINANCIACION FIN, HER_FUENTE_FINANCIACION FFI, HER_DEPENDENCIA DPN, HER_DEPENDENCIA DPN1
WHERE 
    PER.PER_ID = IP.INV_ID 
AND  PER.PER_ID = INI.INV_ID
AND  INI.INV_ID = PER.PER_ID
AND PRY.PRY_ID = IP.PRY_ID
AND FIN.PRY_ID = PRY.PRY_ID
AND FIN.FFI_ID = FFI.FFI_ID
AND PRY.EPR_ID = 'P'
AND MOD_ID = ?  
AND INP_TIPO = 'P' 
AND  DPN.DPN_ID = INI.DPN_ID
AND  DPN.DPN_ID_2 = DPN1.DPN_ID
ORDER BY PRY.PRY_ID</property>
        </oda-data-set>
    </data-sets>

            </list-property>
            <list-property name="resultSet">
                <structure>
                    <property name="position">1</property>
                    <property name="name">SED_NOMBRE</property>
                    <property name="nativeName">SED_NOMBRE</property>
                    <property name="dataType">string</property>
                </structure>
            </list-property>
            <property name="queryText">select  DISTINCT(SED.SED_NOMBRE)  
from 
  her_convocatoria c , her_sede sed ,her_dependencia dpn
where 
    c.SED_ID = sed.sed_id
AND C.SED_ID = DPN.SED_ID 
AND SED.SED_ID = DPN.SED_ID
AND C.CON_ID = ?</property>
        </oda-data-set>

            <property name="queryText">SELECT
  CNP.CNP_TITULO, CON.CON_TITULO, CON.CON_OFERENTE 
     FROM HER_CONVOCATORIA_PADRE CNP, HER_CONVOCATORIA CON
WHERE 
    CON.CNP_ID = CNP.CNP_ID
AND CNP.CNP_ID = ?
AND CON.CON_ID = ?</property>

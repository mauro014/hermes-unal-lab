                    <property name="name">SAC_DESCRIPCION</property>
                    <property name="nativeName">SAC_DESCRIPCION</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">3</property>
                    <property name="name">SAC_FECHA_INICIO</property>
                    <property name="nativeName">SAC_FECHA_INICIO</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">4</property>
                    <property name="name">SAC_DURACION</property>
                    <property name="nativeName">SAC_DURACION</property>
                    <property name="dataType">decimal</property>
                </structure>
                <structure>
                    <property name="position">5</property>
                    <property name="name">FECHA_FIN</property>
                    <property name="nativeName">FECHA_FIN</property>
                    <property name="dataType">string</property>
                </structure>
            </list-property>
            <property name="queryText">SELECT
	hp.per_nombre1 || decode(hp.per_nombre2, NULL, ' ', ' ' || hp.per_nombre2 || ' ') || hp.per_apellido1 || decode(hp.per_apellido2, NULL, '', ' ' || hp.per_apellido2) AS Nombre,
	hsa.SAC_DESCRIPCION,
	TO_CHAR(hsa.SAC_FECHA_INICIO,'DD/MM/YYYY')SAC_FECHA_INICIO,
	hsa.SAC_DURACION,
	TO_CHAR(add_months(hsa.SAC_FECHA_INICIO,hsa.SAC_DURACION),'DD/MM/YYYY')FECHA_FIN
FROM
	HER_SEMILLERO_INTEGRANTE hsi
INNER JOIN HER_SEMILLERO_ACTIVIDAD hsa ON
	hsi.SEI_ID = hsa.SEI_ID
INNER JOIN HER_PERSONA hp ON
	hsi.INV_ID = hp.per_id
	AND hsi.TDO_ID = hp.TDO_ID
WHERE
	hsi.SEM_ID = ?</property>

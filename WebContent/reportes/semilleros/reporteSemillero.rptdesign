                    <property name="name">NOMBRE</property>
                    <property name="nativeName">NOMBRE</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">4</property>
                    <property name="name">SIT_NOMBRE</property>
                    <property name="nativeName">SIT_NOMBRE</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">5</property>
                    <property name="name">SEI_ACTIVIDADES</property>
                    <property name="nativeName">SEI_ACTIVIDADES</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">6</property>
                    <property name="name">SEI_HORAS_DEDICACION</property>
                    <property name="nativeName">SEI_HORAS_DEDICACION</property>
                    <property name="dataType">decimal</property>
                </structure>
            </list-property>
            <property name="queryText">SELECT
    td.tdo_nombre,
	hsi.INV_ID,
	hp.per_nombre1 || decode(hp.per_nombre2, NULL, ' ', ' ' || hp.per_nombre2 || ' ') || hp.per_apellido1 || decode(hp.per_apellido2, NULL, '', ' ' || hp.per_apellido2) AS Nombre,
	hsit.SIT_NOMBRE,
	hsi.SEI_ACTIVIDADES,
	hsi.SEI_HORAS_DEDICACION
FROM
	HER_SEMILLERO_INTEGRANTE hsi
INNER JOIN HER_SEMILLERO_INTEGRANTE_TIPO hsit ON
	hsi.SIT_ID = hsit.SIT_ID
	AND SIT_TIPO in ('I','DD')
INNER JOIN HER_PERSONA hp ON
	hsi.INV_ID = hp.per_id
	AND hsi.TDO_ID = hp.TDO_ID
LEFT JOIN her_tipo_documento td ON
        td.tdo_id = hp.tdo_id
WHERE
	hsi.sem_id = ? and hsi.SEI_ESTADO IN ('A')
ORDER BY
	hsi.SEI_ID</property>

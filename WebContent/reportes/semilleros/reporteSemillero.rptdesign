            <property name="queryText">SELECT
	hshe.SEE_ID,
	hs.SEM_FASE
FROM
	HER_SEMILLERO hs
INNER JOIN HER_SEMILLERO_HISTORICO_ESTADO hshe ON
	hshe.SEM_ID = hs.SEM_ID
WHERE
	hs.sem_id = ?
	AND rownum &lt;= 1
ORDER BY
	hshe.hse_id DESC</property>

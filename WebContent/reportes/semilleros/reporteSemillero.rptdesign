            </list-property>
            <property name="queryText">SELECT
	hdd.DOMDET_DESCRIPCION AREA_OCDE_PRINCIPAL,
	hdd2.DOMDET_DESCRIPCION SUBAREA_OCDE_PRINCIPAL,
	hpag.AGG_NOMBRE,
	hdd3.DOMDET_DESCRIPCION ODS_PRINCIPAL,
	hdd4.DOMDET_DESCRIPCION ODS_SECUNDARIO,
	hs.SEM_FASE
FROM
	HER_SEMILLERO hs
	INNER JOIN HER_DOMINIO_DETALLE hdd ON hdd.DOMDET_TIPO =hs.SEM_AREA_OCDE_PRINCIPAL
	INNER JOIN HER_DOMINIO_DETALLE hdd2 ON hdd2.DOMDET_TIPO =hs.SEM_SUBAREA_OCDE_PRINCIPAL
	INNER JOIN HER_POSIBLE_AGENDA_GRUPO hpag ON hpag.AGG_ID =hs.AGG_ID
	INNER JOIN HER_DOMINIO_DETALLE hdd3 ON hs.SEM_ODS_PRINCIPAL =hdd3.DOMDET_TIPO AND hdd3.DOM_ID =212
	INNER JOIN HER_DOMINIO_DETALLE hdd4 ON hs.SEM_ODS_SECUNDARIO =hdd4.DOMDET_TIPO AND hdd4.DOM_ID =212
WHERE
	hs.sem_id = ?</property>

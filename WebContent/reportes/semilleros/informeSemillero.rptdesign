            <property name="queryText">SELECT
	hs.SEM_ID,
	hd2.DPN_NOMBRE,
	hs2.SED_NOMBRE,
	hs.SEM_FECHAREGISTRO,
	hs.SEM_NOMBRE,
	hs.SEM_PRESENTACION,
	hs.SEM_FECHACREACION,
	hs.SEM_EMAIL,
	decode(hs.SEM_INTERFACULTADES,0,'NO','SI') SEM_INTERFACULTADES,
	decode(hs.SEM_INTERSEDES,0,'NO','SI') SEM_INTERSEDES,
	hs.SEM_PERTINENCIA,
	hs.SEM_OBJETIVO,
	hs.SEM_JUSTIFICACION,
	hs.SEM_ENFOQUE,
	hs.SEM_FASE,
    nvl(trim(per.per_nombre1
    || decode(per.per_nombre2, NULL, ' ', ' '
                                          || per.per_nombre2
                                          || ' ')
    || per.per_apellido1
    || decode(per.per_apellido2, NULL, '', ' ' || per.per_apellido2)),'Sin Coordinador Asignado') coordinador,
    si.sin_fecha_desde || ' hasta ' || si.sin_fecha_hasta periodo_informe
FROM
	HER_SEMILLERO_INFORME SI,HER_SEMILLERO hs
	INNER JOIN HER_SEMILLERO_INTEGRANTE hsi ON
	hsi.SEM_ID = hs.SEM_ID
	AND hsi.SIT_ID = 'DD'
INNER JOIN HER_INVESTIGADOR_INTERNO hii ON
	hsi.INV_ID = hii.INV_ID
	AND hsi.TDO_ID = hii.TDO_ID
INNER JOIN HER_DEPENDENCIA hd ON
	hii.DPN_ID = hd.DPN_ID
INNER JOIN HER_DEPENDENCIA hd2 ON
	hd.DPN_FACULTAD = hd2.DPN_ID
INNER JOIN HER_SEDE hs2 ON
	hs2.SED_ID = hd2.SED_ID
	LEFT JOIN her_persona                  per ON per.tdo_id = hs.tdo_id_coordinador
                                 AND hs.inv_id_coordinador = per.per_id
WHERE
	SI.SIN_ID=? AND hs.sem_id = SI.SEM_ID</property>

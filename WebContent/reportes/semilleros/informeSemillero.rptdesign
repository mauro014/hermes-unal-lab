                        <property name="name">SIN_FECHA_ENTREGA</property>
                        <property name="dataType">string</property>
                    </structure>
                </list-property>
            </structure>
            <property name="dataSource">Data Source</property>
            <list-property name="parameters">
                <structure>
                    <property name="name">param_1</property>
                    <property name="paramName">idInforme</property>
                    <property name="dataType">integer</property>
                    <property name="position">1</property>
                    <property name="isInput">true</property>
                    <property name="isOutput">false</property>
                </structure>
            </list-property>
            <list-property name="resultSet">
                <structure>
                    <property name="position">1</property>
                    <property name="name">SIN_ID</property>
                    <property name="nativeName">SIN_ID</property>
                    <property name="dataType">decimal</property>
                </structure>
                <structure>
                    <property name="position">2</property>
                    <property name="name">SIN_FECHA_COMPROMISO</property>
                    <property name="nativeName">SIN_FECHA_COMPROMISO</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">3</property>
                    <property name="name">SIN_NUM_NOTIFICACIONES</property>
                    <property name="nativeName">SIN_NUM_NOTIFICACIONES</property>
                    <property name="dataType">decimal</property>
                </structure>
                <structure>
                    <property name="position">4</property>
                    <property name="name">SIN_FECHA_NOTIFICACION</property>
                    <property name="nativeName">SIN_FECHA_NOTIFICACION</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">5</property>
                    <property name="name">SIN_CUMPLE</property>
                    <property name="nativeName">SIN_CUMPLE</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">6</property>
                    <property name="name">SIN_FECHA_ENTREGA</property>
                    <property name="nativeName">SIN_FECHA_ENTREGA</property>
                    <property name="dataType">string</property>
                </structure>
            </list-property>
            <property name="queryText">SELECT
	SIN_ID,
	TO_CHAR(SIN_FECHA_COMPROMISO, 'dd-MM-yyyy') SIN_FECHA_COMPROMISO,
	SIN_NUM_NOTIFICACIONES,
	NVL(TO_CHAR(SIN_FECHA_NOTIFICACION , 'dd-MM-yyyy'), 'No Aplica') SIN_FECHA_NOTIFICACION,
	decode(SIN_CUMPLE, '1', 'Si', '0', 'No') SIN_CUMPLE,
	NVL(TO_CHAR(SIN_FECHA_ENTREGA , 'dd-MM-yyyy'), 'No Aplica') SIN_FECHA_ENTREGA
FROM
	HER_SEMILLERO_INFORME hsi
WHERE
	SIN_ID =?
ORDER BY
	SIN_ID</property>
        </oda-data-set>
        <oda-data-set extensionID="org.eclipse.birt.report.data.oda.jdbc.JdbcSelectDataSet" name="7_Proyectos" id="15836">
            <structure name="cachedMetaData">
                <list-property name="resultSet">
                    <structure>
                        <property name="position">1</property>
                        <property name="name">PRY_ID</property>
                        <property name="dataType">decimal</property>
                    </structure>
                    <structure>
                        <property name="position">2</property>
                        <property name="name">PRY_NOMBRE</property>
                        <property name="dataType">string</property>
                    </structure>
                    <structure>
                        <property name="position">3</property>
                        <property name="name">CNP_TITULO</property>
                        <property name="dataType">string</property>
                    </structure>
                    <structure>
                        <property name="position">4</property>
                        <property name="name">EPR_NOMBRE</property>
                        <property name="dataType">string</property>
                    </structure>
                </list-property>
            </structure>
            <property name="dataSource">Data Source</property>
            <list-property name="parameters">
                <structure>
                    <property name="name">param_1</property>
                    <property name="paramName">idInforme</property>
                    <property name="dataType">integer</property>
                    <property name="position">1</property>
                    <property name="isInput">true</property>
                    <property name="isOutput">false</property>
                </structure>
            </list-property>
            <list-property name="resultSet">
                <structure>
                    <property name="position">1</property>
                    <property name="name">PRY_ID</property>
                    <property name="nativeName">PRY_ID</property>
                    <property name="dataType">decimal</property>
                </structure>
                <structure>
                    <property name="position">2</property>
                    <property name="name">PRY_NOMBRE</property>
                    <property name="nativeName">PRY_NOMBRE</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">3</property>
                    <property name="name">CNP_TITULO</property>
                    <property name="nativeName">CNP_TITULO</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">4</property>
                    <property name="name">EPR_NOMBRE</property>
                    <property name="nativeName">EPR_NOMBRE</property>
                    <property name="dataType">string</property>
                </structure>
            </list-property>
            <property name="queryText">SELECT
	hp.PRY_ID,
	hp.PRY_NOMBRE,
	cp.CNP_TITULO,
	ep.EPR_NOMBRE 
FROM
	HER_SEMILLERO_INFORME SI,HER_SEMILLERO_PROYECTO hsp
INNER JOIN HER_PROYECTO hp ON
	hp.PRY_ID = hsp.PRY_ID
INNER JOIN her_convocatoria c ON
	hp.mod_id = c.con_id
INNER JOIN her_convocatoria_padre cp ON
	cp.cnp_id = c.cnp_id
INNER JOIN her_estado_proyecto ep ON
	hp.epr_id = ep.epr_id
WHERE
	SI.SIN_ID = ? AND hsp.SEM_ID = SI.SEM_ID
	AND ep.epr_id NOT IN ( 'BS',
	'B' )
ORDER BY
	hp.PRY_ID</property>
        </oda-data-set>

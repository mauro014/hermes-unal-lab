            <property name="queryText">SELECT
	'RESULTADO: '||SRE_RESULTADO RESULTADO,
'AVANCE: '||SRE_AVANCE AVANCE,
'NOMBRE PRODUCTO: '||SRE_NOMBRE_PRODUCTO SRE_NOMBRE_PRODUCTO,
rs.PRD_ID,
'TIPO PRODUCTO: '||pt.prd_nombre TIPOP,
SRE_LUGAR_DEPOSITO,
SRE_FECHA_ENTREGA,
SRE_PROTECCION
FROM
	HER_SEMILLERO_INF_RESULTADO rs left join her_producto_tipo pt on pt.prd_id = rs.prd_id
WHERE
	sin_ID = ?</property>

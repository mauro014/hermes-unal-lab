            <property name="queryText">SELECT
	DISTINCT
hs.SEM_ID SEM_ID,
hs.SEM_NOMBRE SEM_NOMBRE,
semEstadoActual.see_nombre see_nombre,
hp.per_nombre1 || decode(hp.per_nombre2, NULL, ' ', ' ' || hp.per_nombre2 || ' ') || hp.per_apellido1 || decode(hp.per_apellido2, NULL, '', ' ' || hp.per_apellido2)
 lider,
hs.SEM_EMAIL SEM_EMAIL,
hd.DPN_NOMBRE UAB_DEPENDENCIA,
hd2.DPN_NOMBRE DPN_PRINCIPAL,
hs2.SED_NOMBRE SED_PRINCIPAL,
hs.SEM_FECHACREACION SEM_FECHACREACION,
hs.SEM_PRESENTACION SEM_PRESENTACION,
hs.SEM_OBJETIVO SEM_OBJETIVO,
hs.SEM_JUSTIFICACION SEM_JUSTIFICACION,
hs.SEM_ENFOQUE SEM_ENFOQUE,
hs.SEM_FECHAREGISTRO SEM_FECHAREGISTRO,
hdd.DOMDET_DESCRIPCION AREA_OCDE_PRINCIPAL,
hdd3.DOMDET_DESCRIPCION ODS_PRINCIPAL,
hpag.AGG_NOMBRE AGG_NOMBRE,
hs.SEM_PERTINENCIA SEM_PERTINENCIA,
hs.SEM_METODOLOGIA SEM_METODOLOGIA,
hg.GRU_NOMBRE GRU_ASOCIADO
FROM
	HER_SEMILLERO hs
LEFT JOIN HER_SEMILLERO_INTEGRANTE hsi ON
	hsi.SEM_ID = hs.SEM_ID
	AND hsi.SIT_ID = 'DD'
LEFT JOIN HER_PERSONA hp ON
	hsi.INV_ID = hp.per_id
	AND hsi.TDO_ID = hp.TDO_ID
LEFT JOIN HER_INVESTIGADOR_INTERNO hii ON
	hsi.INV_ID = hii.INV_ID
	AND hsi.TDO_ID = hii.TDO_ID
LEFT JOIN HER_DEPENDENCIA hd ON
	hii.DPN_ID = hd.DPN_ID
LEFT JOIN HER_DEPENDENCIA hd2 ON
	hd.DPN_FACULTAD = hd2.DPN_ID
LEFT JOIN HER_SEDE hs2 ON
	hs2.SED_ID = hd2.SED_ID
LEFT JOIN HER_DOMINIO_DETALLE hdd ON
	hdd.DOMDET_TIPO = hs.SEM_AREA_OCDE_PRINCIPAL
LEFT JOIN HER_DOMINIO_DETALLE hdd2 ON
	hdd2.DOMDET_TIPO = hdd.DOMDET_ESTADO
LEFT JOIN HER_DOMINIO_DETALLE hdd3 ON
	hs.SEM_ODS_PRINCIPAL = hdd3.DOMDET_TIPO
	AND hdd3.DOM_ID = 212
LEFT JOIN HER_POSIBLE_AGENDA_GRUPO hpag ON
	hpag.AGG_ID = hs.AGG_ID
LEFT JOIN HER_SEMILLERO_GRUPO hsg ON
	hsg.SEM_ID = hs.SEM_ID
LEFT JOIN HER_GRUPO hg ON
	hg.GRU_ID = hsg.GRU_ID
LEFT JOIN (
	SELECT
		DISTINCT hshe.SEM_ID, HSE.*
	FROM
		HER_SEMILLERO_HISTORICO_ESTADO hshe
	INNER JOIN (
		SELECT
			sem_id, max(HSE_ID) id
		FROM
			HER_SEMILLERO_HISTORICO_ESTADO
		GROUP BY
			sem_id) ea ON
		ea.SEM_ID = hshe.SEM_ID
	INNER JOIN HER_SEMILLERO_HISTORICO_ESTADO hshe2 ON
		ea.ID = hshe2.HSE_ID
	INNER JOIN HER_SEMILLERO_ESTADO hse ON
		hshe2.SEE_ID = hse.SEE_ID) semEstadoActual ON
	semEstadoActual.SEM_ID = hs.SEM_ID
WHERE
	hs2.SED_ID in (SELECT COLUMN_VALUE FROM TABLE(SPLIT(?)))
	AND (?='ALL' or hd2.DPN_ID in (SELECT COLUMN_VALUE FROM TABLE(SPLIT(?))))
	AND to_char(semEstadoActual.SEE_ID) IN (SELECT COLUMN_VALUE FROM TABLE(SPLIT(?)))
ORDER BY
	SEM_ID</property>
        </oda-data-set>
    </data-sets>

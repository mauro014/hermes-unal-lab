            <property name="queryText">SELECT
	*
FROM
	HER_SEMILLERO_SOLICITUD SS 
    LEFT JOIN HER_SEMILLERO_SOLICITUD_TIPO ST ON SS.SST_ID = ST.SST_ID 
    LEFT JOIN HER_PERSONA P ON P.PER_ID = DBMS_LOB.SUBSTR(SS.SSO_DETALLE,11,3)
    LEFT JOIN HER_SEMILLERO_ESTADO SE ON TO_CHAR(SE.SEE_ID) = DBMS_LOB.SUBSTR(SS.SSO_DETALLE,1,1)
WHERE
	SS.SSO_ID = ?</property>

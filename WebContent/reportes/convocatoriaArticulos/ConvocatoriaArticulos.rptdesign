                    <property name="name">CNA_COMENTARIO_EVALUACION</property>
                    <property name="nativeName">CNA_COMENTARIO_EVALUACION</property>
                    <property name="dataType">string</property>
                </structure>
            </list-property>
            <property name="queryText">SELECT HCA.CNA_ID, HCA.CNA_FECHA_SOLICITUD, HCA.PER_ID, HCA.TDO_ID, HCA.CNA_DEPENDENCIA_MOD_DOS,
HCA.CNA_TITULO, HCA.CNA_NUMERO_PALABRAS as "Num_Pal", HCA.CNA_COAUTORES, HCA.CNA_RESUMEN, HCA.CNA_ISSN, 
decode(HCA.CNA_ESTADO,'P', 'La solicitud no ha sido evaluada en el momento','AP', 'Aprobada', 'NAP', 'No Aprobada' ) ESTADO,
HCA.CNA_MODALIDAD as "Modalidad", HCA.CNA_IDIOMA as "Idioma", 
HCA.CNA_TELEFONO_DOCENTE, HCA.CNA_EMAIL_DOCENTE, HCA.CNA_CELULAR_DOCENTE, HCA.CNA_AREA as "Area",
PER.PER_NOMBRE1 || ' ' || PER.PER_NOMBRE2 || ' ' || PER.PER_APELLIDO1 || ' ' || PER.PER_APELLIDO2 as NOMBRE,
PER.PER_EMAIL, DEP.DPN_NOMBRE as "Departamento", DEP2.DPN_NOMBRE as "Facultad", SEDE.SED_NOMBRE as "Sede",
HCA.CNA_REQUERIMIENTO1, HCA.CNA_REQUERIMIENTO2, 
HCA.CNA_COMENTARIO_EVALUACION
FROM HER_CONVOCATORIA_ARTICULO HCA, HER_PERSONA PER, HER_INVESTIGADOR_INTERNO II, HER_DEPENDENCIA DEP,  HER_SEDE SEDE, HER_DEPENDENCIA DEP2
WHERE HCA.CNA_ID = ?
AND HCA.PER_ID = PER.PER_ID
AND HCA.PER_ID = II.INV_ID 
AND II.DPN_ID = DEP.DPN_ID 
AND DEP.SED_ID = SEDE.SED_ID
AND DEP2.DPN_ID = DEP.DPN_FACULTAD</property>
        </oda-data-set>
    </data-sets>

            <property name="queryText">select 
decode(ocad.plo_rol_universidad,'EJ', 'Ejecutora', 'OP', 'Operadora','')rol_un,
PLO_COD_SIGP,
PLO_COD_BPIN,
PLO_OCAD_APRUEBA,
PLO_NUM_APROB_OCAD,
PLO_FECHA_APRUEBA,
PLO_NOMBRE_SUPERVISOR,
PLO_TIENE_PRY_EXTENSION,
PLO_COD_PRT_EXTENSION,
PLO_VALOR_APROB_SGR,
PLO_VALOR_APROB_OTRA_FIN,
PLO_VALOR_PARTICIPANTES,
ff.ffi_descripcion as entidad,
PER_ID_DIRECTOR,
TDO_ID_DIRECTOR,
 ( per.per_apellido1
      || ' '
      || decode(per.per_apellido2, per.per_apellido2, per.per_apellido2, NULL, ' ')
      || ' '
      || per.per_nombre1
      || ' '
      || decode(per.per_nombre2, per.per_nombre2, per.per_nombre2, NULL, ' ') ) director
from her_proyecto_leg_ocad ocad 
left join her_persona per on ocad.per_id_director = per.per_id and ocad.tdo_id_director = per.tdo_id
left join her_fuente_financiacion ff on ff.ffi_id = ocad.ffi_id_ejecutora
where ocad.pry_id = ?</property>
        </oda-data-set>

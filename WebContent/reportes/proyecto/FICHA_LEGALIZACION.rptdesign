            <property name="queryText">SELECT
    (
        SELECT
            dd.domdet_descripcion
        FROM
            her_dominio_detalle dd
        WHERE
            dd.domdet_tipo = pry.pry_programa_cyt
            AND dd.dom_id = 120
    ) pry_programa,
    pry.pry_acto_adm_externo,
    pry_fecha_ati         fechaexterno,
    pry_cupos_descuento   numexterno,
    pry_nro_monitores     numinterno,
    dd2.domdet_descripcion        actointerno,
    pry_act_fecha         fechainterno,
    pry.pry_act_nombre,
    pry_fecha_tentativa_inicio,
    pry_fecha_final,
    add_months(pry.pry_fecha_tentativa_inicio, decode(pry.pry_duracion_acumulada, NULL, nvl(pry.pry_duracion, 0), pry.pry_duracion_acumulada
    )) + decode(pry.pry_duracion_dias_acumulada, NULL, 0, pry.pry_duracion_dias_acumulada) pry_fecha_final_act,
    pry_exo_ind,
    decode(pry.pry_tipo_fecha_inicio, '1', 'Desembolso de recursos', '2', 'Acta de inicio',
           '3', 'Legalización o suscripción del contrato', '4', 'Otro') pry_tipo_fecha_inicio,
    pry_vincula_sedes,
    pry_vincula_fac,
    pry_otro_clase_evento,
    pry_otro_servicio,
    pry_conferencistas,
    pry_fecha_acta_externa,
    pry_compromiso_ejecuc,
    pry.pry_cont_efect_final_un,
    pry.pry_cont_espec_final_un
FROM
    her_proyecto pry
    left join her_dominio_detalle dd2 on dd2.DOMDET_TIPO = pry.pry_act_nombre AND DD2.DOM_ID = '139'
WHERE
    pry.pry_id = ?</property>
        </oda-data-set>

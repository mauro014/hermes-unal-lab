                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">2</property>
                    <property name="name">INT_EXT</property>
                    <property name="nativeName">INT_EXT</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">3</property>
                    <property name="name">NATURA</property>
                    <property name="nativeName">NATURA</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">4</property>
                    <property name="name">TIPO</property>
                    <property name="nativeName">TIPO</property>

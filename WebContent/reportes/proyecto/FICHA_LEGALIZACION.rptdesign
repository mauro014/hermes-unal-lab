            <list-property name="parameters">
                <structure>
                    <property name="name">param_1</property>
                    <property name="paramName">id</property>
                    <property name="dataType">string</property>
                    <property name="position">1</property>
                    <property name="isInput">true</property>
                    <property name="isOutput">false</property>
                </structure>
            </list-property>
            <list-property name="resultSet">
                <structure>
                    <property name="position">1</property>
                    <property name="name">RUBRO</property>
                    <property name="nativeName">RUBRO</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">2</property>
                    <property name="name">GST_DESCRIPCION</property>
                    <property name="nativeName">GST_DESCRIPCION</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">3</property>
                    <property name="name">ANO1</property>
                    <property name="nativeName">ANO1</property>
                    <property name="dataType">decimal</property>
                </structure>
                <structure>
                    <property name="position">4</property>
                    <property name="name">ANO2</property>
                    <property name="nativeName">ANO2</property>
                    <property name="dataType">decimal</property>
                </structure>
                <structure>
                    <property name="position">5</property>
                    <property name="name">ANO3</property>
                    <property name="nativeName">ANO3</property>
                    <property name="dataType">decimal</property>
                </structure>
                <structure>
                    <property name="position">6</property>
                    <property name="name">FFI_DESCRIPCION</property>
                    <property name="nativeName">FFI_DESCRIPCION</property>
                    <property name="dataType">string</property>
                </structure>
            </list-property>
            <property name="queryText">SELECT
	TRU_NOMBRE Rubro,
	nvl(g.GST_DESCRIPCION, TRU_NOMBRE) GST_DESCRIPCION,
	g.gst_valor ano1,
	g.gst_valor2 ano2,
    g.gst_valor3 ano3,
	ff.ffi_descripcion
FROM
	HER_GASTO g,
	HER_TIPO_RUBRO tr,
	HER_FINANCIACION f ,
	her_fuente_financiacion ff
WHERE
	ff.FFI_INTERNA_EXTERNA IN ('OE','E', 'A')
	AND g.fin_ID = f.fin_ID
	AND ff.FFI_ID = f.FFI_ID
	AND g.tru_id = tr.TRU_ID
	AND (tr.TRU_ID = 171
		OR tr.TRU_DESCRIPCION like 'INGRESO%')
	AND (F.FIN_ES_LEGALIZACION IS NOT NULL
		AND F.FIN_ES_LEGALIZACION = 'SI')
	AND PRY_ID = ?
ORDER BY
	g.GST_DESCRIPCION</property>
        </oda-data-set>

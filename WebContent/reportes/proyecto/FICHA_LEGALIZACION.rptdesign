            <property name="queryText">select dep.DPN_NOMBRE, 
       prd.PRD_AREA_RESPONSABILIDAD,
       sede.sed_nombre
  from HER_PROYECTO_DEPENDENCIA prd, 
       HER_DEPENDENCIA dep,
       HER_SEDE sede
 WHERE prd.PRY_ID = ?  
 and   prd.PRD_AREA_RESPONSABILIDAD = 'F'  
   AND prd.DPN_ID = dep.DPN_ID
   AND sede.sed_id = dep.sed_id</property>
        </oda-data-set>

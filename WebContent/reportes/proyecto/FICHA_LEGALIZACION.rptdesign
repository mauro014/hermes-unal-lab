                    <property name="nativeName">TIPOEJECUCION</property>
                    <property name="dataType">string</property>
                </structure>
            </list-property>
            <property name="queryText">SELECT
    c.cnv_fecha_inicio,
    cnv_vigencia_leg,
    cnv_vigencia_leg + nvl(pp.meses,0) cnv_vigencia_leg_act,
    c.cnv_fecha_fin,
    add_months(c.cnv_fecha_fin, nvl(pp.meses,0)) cnv_fecha_fin_act,
    c.cnv_num_contrato,
    c.cnv_supervisor_ext,
    c.cnv_supervisor_ext_cargo,
    (
        SELECT
            f.ffi_descripcion
        FROM
            her_fuente_financiacion f
        WHERE
            f.ffi_id = c.cnv_supervisor_entidad
    ) entidadconvenio,
    c.cnv_supervisor_interno,
    c.cnv_supervisor_int_cargo,
    cnv_asistente_pry,
    cnv_asistente_extension,
    cnv_valor_total,
    cnv_valor_efectivo,
    cnv_valor_especie,
    c.cnv_monto_ejecutar_un,
    pry.pry_cont_efect_final_un,
    pry.pry_cont_espec_final_un,
    cnv_nombre,
    (
        SELECT
            d.dpn_nombre
        FROM
            her_dependencia d
        WHERE
            d.dpn_id = c.cnv_dependencia_firma
    ) dpn_firma,
    cnv_designado_cargo,
    cnv_designado_firma,
    (
        SELECT
            d.domdet_descripcion
        FROM
            her_dominio_detalle d
        WHERE
            d.domdet_tipo = c.cnv_modalidad_contrat
            AND d.dom_id = '134'
    ) modalidad_contrat,
    c.cnv_propiedad_intelect,
    c.cnv_confidencialidad,
    c.cnv_clausula_penal,
    c.cnv_clausula_multas,
    c.cnv_propiedad_bienes,
    decode(cnv_autorizacion_cc, 1, 'Si', 0, 'No') AS cnv_autorizacion_cc,
    decode(cnv_autorizacion_ci, 1, 'Si', 0, 'No') AS cnv_autorizacion_ci,
    decode(cnv_autorizacion_cr, 1, 'Si', 0, 'No') AS cnv_autorizacion_cr,
    cnv_valor_ejecucion_un,
    cnv_cargo_asistente,
    cnv_cod_ent_externa,
    decode(pry.pry_tipologia, 'E', 'Ejecución técnica', 'ETF', 'Ejecución técnica y financiera',
           '--') tipoejecucion
FROM
    her_proyecto   pry
    LEFT JOIN (
        SELECT
            pry_id,
            SUM(nvl(prpr_meses_vista_aux, 0)) meses
        FROM
            her_proyecto_prorroga
        WHERE
    		nvl(prpr_estado,'A') != 'B'
        GROUP BY
            pry_id
    ) pp ON pp.pry_id = pry.pry_id,
    her_convenio   c
WHERE
    pry.pry_id = ?
    AND c.pry_id = pry.pry_id</property>
        </oda-data-set>

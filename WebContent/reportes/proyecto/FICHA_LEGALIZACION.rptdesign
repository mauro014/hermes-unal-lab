                <structure>
                    <property name="position">2</property>
                    <property name="name">COB_FECHA</property>
                    <property name="nativeName">COB_FECHA</property>
                    <property name="dataType">date-time</property>
                </structure>
            </list-property>
            <property name="queryText">select co.COB_OBLIGACION, co.COB_FECHA 
  from HER_CONVENIO_OBLIGACION co, HER_CONVENIO c    
 WHERE c.PRY_ID = ?
   AND c.CNV_ID = co.CNV_ID</property>

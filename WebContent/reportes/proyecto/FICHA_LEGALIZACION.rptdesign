            <property name="queryText">SELECT
    upper(dep.dpn_nombre),
    upper(sede.sed_nombre),
    pry_empresa_ejecutora,
    decode(pry.pry_tipo_actividad, 'PI', 'Proyecto de investigación', '--') tipoactividad,
    pry.pry_nombre,
    pry.pry_duracion                  cantidad_meses,
    pry.pry_duracion + nvl(pp.meses, 0) cantidad_meses_act,
    ( per.per_apellido1
      || ' '
      || decode(per.per_apellido2, per.per_apellido2, per.per_apellido2, NULL, ' ')
      || ' '
      || per.per_nombre1
      || ' '
      || decode(per.per_nombre2, per.per_nombre2, per.per_nombre2, NULL, ' ') ) principal,
    per.per_id,
    (
        SELECT
            upper(fac.dpn_nombre)
        FROM
            her_dependencia fac
        WHERE
            fac.dpn_id = dep.dpn_facultad
            AND fac.dpn_es_facultad = 'Y'
    ) unidad,
    inp.inp_dedicacion_horas_semana   hora_semana,
    inp.inp_valor_pagar               valor_dedicacion,
    (
        SELECT
            ( ep.epr_nombre )
        FROM
            her_estado_proyecto ep
        WHERE
            ep.epr_id = pry.epr_id
    ) estado,
    decode(pry.pry_tipologia, 'ET', 'Ejecución técnica', 'ETF', 'Ejecución técnica y financiera',
           '--') tipoejecucion,
    pry_tipologia_sec,
    decode(pry_tipologia_sec, '1', 'Universidad Nacional Ejecutora - única entidad', '2', 'Universidad Nacional Ejecutora - única entidad designada por el OCAD'
    ,
           '3', 'Universidad Nacional Ejecutora - aportes adicionales de entidades participantes', '4', 'Universidad Nacional Ejecutora - administradora de recursos con entidades participantes'
           , '5',
           'Universidad Nacional como entidad co-ejecutora o ejecutora técnica (en Regalías)') AS pry_tipologia_sec_nombre,
    pry.pry_tipo_actividad            tipo_actividad_id,
    pry.pry_valor_solicitado          valor_solicitado,
    pry.pry_id,
    pry.pry_valor_total               valor_total_proyecto
FROM
    her_proyecto                pry
    LEFT JOIN (
        SELECT
            pry_id,
            SUM(nvl(prpr_meses_vista_aux, 0)) meses
        FROM
            her_proyecto_prorroga
        WHERE
    		nvl(prpr_estado,'A') != 'B'
        GROUP BY
            pry_id
    ) pp ON pp.pry_id = pry.pry_id,
    her_persona                 per,
    her_investigador_proyecto   inp,
    her_investigador_interno    ini,
    her_dependencia             dep,
    her_sede                    sede
WHERE
    pry.pry_id = ?
    AND per.per_id = inp.inv_id
    AND per.tdo_id = inp.tdo_id
    AND inp.inp_tipo = 'P'
    AND inp.pry_id = pry.pry_id
    AND per.per_id = ini.inv_id
    AND per.tdo_id = ini.tdo_id
    AND dep.dpn_id = pry.pry_unidad_ejecutora
    AND sede.sed_id = pry.pry_sede_ejecutora</property>
        </oda-data-set>

            <property name="queryText">SELECT p.PRY_ID,p.pry_descripcion,p.pry_abstract,p.PRY_JUSTIFICACION , p.PRY_MARCO_TEORICO, P.PRY_ANTECEDENTES,
 p.PRY_OBJETIVO_GENERAL, P.PRY_METODOLOGIA, P.PRY_IMPACTO_ESPERADO, P.PRY_CONSIDERACIONES_ETICAS, P.PRY_PROPIEDAD_INTELECTUAL, 
 P.LINEA_BASE_PROYECTO, P.PRY_TIENE_PRY, P.PRY_PRY_ASOCIADO, P.PRY_EXT_SOL_TRANSFERENCIA, INFOES.FIE_CAMPO_1, INFOES.FIE_CAMPO_1_TEXTO, INFOES.FIE_CAMPO_2, INFOES.FIE_CAMPO_2_TEXTO,
 INFOES.FIE_CAMPO_3, INFOES.FIE_CAMPO_3_TEXTO, INFOES.FIE_CAMPO_4, INFOES.FIE_CAMPO_4_TEXTO, INFOES.FIE_CAMPO_5, INFOES.FIE_CAMPO_5_TEXTO, INFOES.FIE_CAMPO_6, INFOES.FIE_CAMPO_6_TEXTO, INFOES.FIE_CAMPO_7, INFOES.FIE_CAMPO_7_TEXTO, PRY_EXT_SOL_APROPIACION, CONV.CON_PRY_ASOCIADO, CONV.CON_MOSTRAR_DESCR_PROBLEMA, CONV.CON_MOSTRAR_BIODIVERSIDAD

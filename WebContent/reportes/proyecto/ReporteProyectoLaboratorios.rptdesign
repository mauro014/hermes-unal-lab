                    <property name="name">PRY_LAB_NOMBRE</property>
                    <property name="nativeName">PRY_LAB_NOMBRE</property>
                    <property name="dataType">string</property>
                </structure>
            </list-property>
            <property name="queryText">select pry.PRY_LAB_NOMBRE
  from HER_PROYECTO pry  
 WHERE pry.PRY_ID = ?</property>

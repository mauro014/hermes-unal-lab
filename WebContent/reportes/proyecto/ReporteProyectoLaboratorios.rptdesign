            <property name="queryText">SELECT LAB.LAB_ID AS ID, LAB.LAB_NOMBRE AS NOMBRE, LAB.LAB_EMAIL, PER.PER_NOMBRE1||' '||DECODE(PER.PER_NOMBRE2, PER.PER_NOMBRE2,PER.PER_NOMBRE2,NULL,' ')||' '||PER.PER_APELLIDO1||' '||DECODE(PER.PER_APELLIDO2, PER.PER_APELLIDO2,PER.PER_APELLIDO2,NULL,' ') AS COORDINADOR
FROM HER_LABORATORIO_DET_PROYECTO LDP, HER_LABORATORIO LAB, HER_PERSONA_LABORATORIO PERLAB, HER_PERSONA PER

            <property name="queryText">select pry.PRY_CONTRAP_EFECTIVO, PRY_CONTRAP_ESPECIE, 
PRY_VALOR_PERSONAL, pry.PRY_ADM_TOTAL VALOR_PERSONAL_ADMINISTRATIVO,
(select SUM (f.FIN_VALOR)
  FROM     HER_FUENTE_FINANCIACION ff, 
        HER_FINANCIACION f
  WHERE     ff.FFI_ID = f.FFI_ID 
   AND  (F.FFE_TIPO_ENTIDAD = 'F' OR F.FFE_TIPO_ENTIDAD is null)
   AND FF.FFI_INTERNA_EXTERNA = 'E'
   AND    f.PRY_ID = ?  
   AND (FIN_ES_LEGALIZACION IS NULL OR  FIN_ES_LEGALIZACION = 'NO')) AS VALOR_FUENTE,
   (select SUM (F.FFE_VALOR_ESPECIE)
  FROM     HER_FUENTE_FINANCIACION ff, 
        HER_FINANCIACION f
  WHERE     ff.FFI_ID = f.FFI_ID 
   AND  (F.FFE_TIPO_ENTIDAD = 'E')
   AND    f.PRY_ID = ?  
   AND (FIN_ES_LEGALIZACION IS NULL OR  FIN_ES_LEGALIZACION = 'NO')) AS VALOR_ESPECIE_EXT,
(SELECT 	SUM(F.FFE_VALOR_ESPECIE)
  FROM 	HER_FUENTE_FINANCIACION ff, 
        HER_FINANCIACION f
 WHERE 	ff.FFI_ID = f.FFI_ID 
   AND  (F.FFE_TIPO_ENTIDAD = 'P')
   AND	PRY_ID = ?
   AND (FIN_ES_LEGALIZACION IS NULL OR  FIN_ES_LEGALIZACION = 'NO')) AS valor_particp_espec,
   (SELECT 	SUM (f.FIN_VALOR)
  FROM 	HER_FUENTE_FINANCIACION ff, 
        HER_FINANCIACION f
 WHERE 	ff.FFI_ID = f.FFI_ID 
   AND  (F.FFE_TIPO_ENTIDAD = 'P')
   AND	PRY_ID = ?
   AND (FIN_ES_LEGALIZACION IS NULL OR  FIN_ES_LEGALIZACION = 'NO')) AS valor_particp_efec
 from HER_PROYECTO pry       
 WHERE pry.PRY_ID = ?</property>
        </oda-data-set>

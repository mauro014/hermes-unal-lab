                    <property name="name">EFECTIVO5</property>
                    <property name="nativeName">EFECTIVO5</property>
                    <property name="dataType">decimal</property>
                </structure>
                <structure>
                    <property name="position">13</property>
                    <property name="name">EFECTIVO6</property>
                    <property name="nativeName">EFECTIVO6</property>
                    <property name="dataType">decimal</property>
                </structure>
            </list-property>
            <property name="queryText">SELECT F.fIN_id, ff.FFI_DESCRIPCION, nvl(p.pry_vigencia,'0') v,
 DECODE (ff.ffi_interna_externa, 'I', 'Interna',
                                        'E', 'Externa',
                                        'A', 'Inscripciones',
                                        'O', 'Interna') INT_EXT,
 (select dd.domdet_descripcion
           from her_dominio_detalle dd
          where dd.domdet_tipo = ff.ffe_cod_naturaleza) NATURA,
  f.FIN_VALOR, f.FFE_VALOR_ESPECIE,
  (SELECT  SUM(g.gst_valor)
  FROM HER_GASTO g, HER_TIPO_RUBRO tr
WHERE g.fin_ID = f.fin_ID 
  AND ff.FFI_ID = f.FFI_ID 
  AND g.tru_id =tr.TRU_ID
  AND tr.TRU_ID NOT IN (93, 149, 150)
  AND  (F.FFE_TIPO_ENTIDAD = 'F' OR F.FFE_TIPO_ENTIDAD is null)
  AND (FIN_ES_LEGALIZACION IS NULL OR  FIN_ES_LEGALIZACION = 'NO')
) especie2,
(SELECT  SUM(g.gst_valor2)
  FROM HER_GASTO g, HER_TIPO_RUBRO tr
WHERE g.fin_ID = f.fin_ID 
  AND ff.FFI_ID = f.FFI_ID 
  AND g.tru_id =tr.TRU_ID
  AND tr.TRU_ID NOT IN (93, 149, 150)
  AND  (F.FFE_TIPO_ENTIDAD = 'F' OR F.FFE_TIPO_ENTIDAD is null)
  AND (FIN_ES_LEGALIZACION IS NULL OR  FIN_ES_LEGALIZACION = 'NO')
) efectivo2,
(SELECT  SUM(g.gst_valor3)
  FROM HER_GASTO g, HER_TIPO_RUBRO tr
WHERE g.fin_ID = f.fin_ID 
  AND ff.FFI_ID = f.FFI_ID 
  AND g.tru_id =tr.TRU_ID
  AND tr.TRU_ID NOT IN (93, 149, 150)
  AND  (F.FFE_TIPO_ENTIDAD = 'F' OR F.FFE_TIPO_ENTIDAD is null)
  AND (FIN_ES_LEGALIZACION IS NULL OR  FIN_ES_LEGALIZACION = 'NO')
) efectivo3,
(SELECT  SUM(g.gst_valor4)
  FROM HER_GASTO g, HER_TIPO_RUBRO tr
WHERE g.fin_ID = f.fin_ID 
  AND ff.FFI_ID = f.FFI_ID 
  AND g.tru_id =tr.TRU_ID
  AND tr.TRU_ID NOT IN (93, 149, 150)
  AND  (F.FFE_TIPO_ENTIDAD = 'F' OR F.FFE_TIPO_ENTIDAD is null)
  AND (FIN_ES_LEGALIZACION IS NULL OR  FIN_ES_LEGALIZACION = 'NO')
) efectivo4,
(SELECT  SUM(g.gst_valor5)
  FROM HER_GASTO g, HER_TIPO_RUBRO tr
WHERE g.fin_ID = f.fin_ID 
  AND ff.FFI_ID = f.FFI_ID 
  AND g.tru_id =tr.TRU_ID
  AND tr.TRU_ID NOT IN (93, 149, 150)
  AND  (F.FFE_TIPO_ENTIDAD = 'F' OR F.FFE_TIPO_ENTIDAD is null)
  AND (FIN_ES_LEGALIZACION IS NULL OR  FIN_ES_LEGALIZACION = 'NO')
) efectivo5,
(SELECT  SUM(g.gst_valor6)
  FROM HER_GASTO g, HER_TIPO_RUBRO tr
WHERE g.fin_ID = f.fin_ID 
  AND ff.FFI_ID = f.FFI_ID 
  AND g.tru_id =tr.TRU_ID
  AND tr.TRU_ID NOT IN (93, 149, 150)
  AND  (F.FFE_TIPO_ENTIDAD = 'F' OR F.FFE_TIPO_ENTIDAD is null)
  AND (FIN_ES_LEGALIZACION IS NULL OR  FIN_ES_LEGALIZACION = 'NO')
) efectivo6
 FROM  HER_FUENTE_FINANCIACION ff, HER_FINANCIACION f, her_proyecto p
 WHERE ff.FFI_ID = f.FFI_ID 
 AND (F.FFE_TIPO_ENTIDAD = 'F' OR F.FFE_TIPO_ENTIDAD is null)
 AND p.PRY_ID = ?
 AND P.PRY_ID = F.pry_id
 AND (FIN_ES_LEGALIZACION IS NULL OR  FIN_ES_LEGALIZACION = 'NO')
 ORDER BY FFI_DESCRIPCION
 </property>
        </oda-data-set>

            <property name="queryText">SELECT TRU_NOMBRE  Rubro, 
       g.gst_valor especie,
       g.gst_valor2 efectivo,
       g.gst_valor3 v3,
       g.gst_valor4 v4,
       g.gst_valor5 v5,
       g.gst_valor6 v6,
       g.gst_valor + g.gst_valor2 + g.gst_valor3 + g.gst_valor4 + g.gst_valor5 + g.gst_valor6 total,
       ff.ffi_descripcion,
       p.MOD_ID
  FROM HER_GASTO g, 
       HER_TIPO_RUBRO tr, 
       HER_FINANCIACION f , 
       her_fuente_financiacion ff,
       HER_PROYECTO p
WHERE ff.FFI_INTERNA_EXTERNA in ('I','O')
  AND g.fin_ID = f.fin_ID 
  AND ff.FFI_ID = f.FFI_ID 
  AND g.tru_id =tr.TRU_ID
  AND tr.TRU_ID NOT IN (93, 149, 150)
  AND (F.FFE_TIPO_ENTIDAD = 'F' OR F.FFE_TIPO_ENTIDAD is null)
  AND F.PRY_ID = ?
  AND P.PRY_ID = F.PRY_ID
   AND (FIN_ES_LEGALIZACION IS NULL OR  FIN_ES_LEGALIZACION = 'NO')
ORDER BY ff.ffi_descripcion, tr.tru_nombre</property>

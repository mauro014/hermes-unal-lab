                </structure>
            </list-property>
            <list-property name="resultSet">
                <structure>
                    <property name="position">1</property>
                    <property name="name">GRU_ID</property>
                    <property name="nativeName">GRU_ID</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">2</property>
                    <property name="name">INV_ID</property>
                    <property name="nativeName">INV_ID</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">3</property>
                    <property name="name">INTEGRANTES</property>
                    <property name="nativeName">INTEGRANTES</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">4</property>
                    <property name="name">INS_NOMBRE</property>
                    <property name="nativeName">INS_NOMBRE</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">5</property>
                    <property name="name">ING_FUNCION</property>
                    <property name="nativeName">ING_FUNCION</property>
                    <property name="dataType">string</property>
                </structure>
            </list-property>
            <property name="queryText">SELECT     GRU.GRU_ID,   INE.INV_ID,
PER.PER_APELLIDO1||' '||DECODE(PER.PER_APELLIDO2, PER.PER_APELLIDO2,PER.PER_APELLIDO2,NULL,' ')||' '||PER.PER_NOMBRE1||' '||DECODE(PER.PER_NOMBRE2, PER.PER_NOMBRE2,PER.PER_NOMBRE2,NULL,' ')INTEGRANTES,
   INS.INS_NOMBRE,ING_FUNCION 
FROM HER_GRUPO GRU  , HER_GRUPO_PROYECTO GRP, HER_PROYECTO PRY, HER_INVESTIGADOR_GRUPO ING,
HER_PERSONA PER, HER_INVESTIGADOR_EXTERNO INE, HER_INSTITUCION INS
WHERE PRY.PRY_ID = ?
AND GRP.PRY_ID = PRY.PRY_ID
AND GRU.GRU_ID = GRP.GRU_ID
AND GRU.GRU_ID = ING.GRU_ID
AND ING.INV_ID = INE.INV_ID
AND ING.TDO_ID = INE.TDO_ID
AND PER.PER_ID = ING.INV_ID
AND PER.TDO_ID = ING.TDO_ID
 AND PER.PER_ID = INE.INV_ID
 AND PER.TDO_ID = INE.TDO_ID
 AND INS.INS_ID = INE.INS_ID</property>
        </oda-data-set>

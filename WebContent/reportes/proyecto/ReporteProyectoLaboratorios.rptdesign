            <property name="queryText">SELECT PRY_ID, PEV.PEV_ID,
PEV.PEV_NOMBRE,PEV.PEV_APELLIDO1,DECODE(PEV.PEV_APELLIDO2,NULL,' ',PEV.PEV_APELLIDO2,PEV.PEV_APELLIDO2)EVALUADOR,

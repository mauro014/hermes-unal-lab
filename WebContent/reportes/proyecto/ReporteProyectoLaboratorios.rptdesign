WHERE PRY.PRY_ID = ?
AND PRY.PRY_ID = ACT.PRY_ID
AND RES.RST_ID = ACT.RST_ID
AND META.MET_ID = ACT.MET_ID
AND OBJ.OBJ_ID = META.OBJ_ID
ORDER BY O,M,A</property>

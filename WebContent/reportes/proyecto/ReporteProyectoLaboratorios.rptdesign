                        <property name="position">2</property>
                        <property name="name">INV_ID</property>
                        <property name="dataType">string</property>
                    </structure>
                    <structure>
                        <property name="position">3</property>
                        <property name="name">INTEGRANTES</property>
                        <property name="dataType">string</property>
                    </structure>
                    <structure>
                        <property name="position">4</property>
                        <property name="name">INS_NOMBRE</property>
                        <property name="dataType">string</property>
                    </structure>
                    <structure>

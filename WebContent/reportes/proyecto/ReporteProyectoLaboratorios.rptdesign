                    <property name="dataType">string</property>
                </structure>
            </list-property>
            <property name="queryText">SELECT ROWNUM,OBJ.OBJ_ORDEN||'.'||META.MET_ORDEN NM, META.MET_ORDEN M,META.MET_NOMBRE META,OBJ.OBJ_ORDEN O,OBJ.OBJ_DESCRIPCION OBJ
FROM HER_OBJETIVO_ESPECIFICO OBJ, HER_META_PROYECTO META
WHERE OBJ.PRY_ID = ?
AND OBJ.OBJ_ID = META.OBJ_ID
ORDER BY O,M</property>
        </oda-data-set>

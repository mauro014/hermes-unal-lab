            <property name="queryText">SELECT ROWNUM,OBJ.OBJ_ORDEN||'.'||META.MET_ORDEN||'.'||ACT.ACT_ORDEN NUM,OBJ.OBJ_ORDEN||'.'||META.MET_ORDEN NM, ACT.ACT_ORDEN A,ACT.ACT_DESCRIPCION ACTIVIDAD,META.MET_ORDEN M,META.MET_NOMBRE META,OBJ.OBJ_ORDEN O,OBJ.OBJ_DESCRIPCION OBJ,RES.RST_ORDEN R,RES.RST_DESCRIPCION RES,ACT.ACT_SEMANA_INICIAL SEMI,ACT.ACT_DURACION_SEMANAS DURS

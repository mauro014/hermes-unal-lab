AND LDP.PRY_ID = ?
AND PERLAB.LAB_ID = LAB.LAB_ID
AND PERLAB.PER_ID = PER.PER_ID
AND PERLAB.TDO_ID = PER.TDO_ID
AND PERLAB.ROL_ID = 'CO'

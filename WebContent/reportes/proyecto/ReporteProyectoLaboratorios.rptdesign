            <property name="queryText">select PRY_LUGAR,
       PRY_EXO_IND,
       PRY_PORCENTAJE_COSTIND,
       PRY_EXO_TRA,       
       PRY_PORCENTAJE_TRANSFERENC,
       PRY_SERVICIOS_ACADEM,
       PRY_EXO_IND PRY_EXONERA_INDIRECTOS,
       PRY_EXO_TRA PRY_EXONERA_TRANSFERENCIAS,
       dpn.DPN_NOMBRE       
  from HER_PROYECTO pry,
  	   HER_DEPENDENCIA dpn
 where pry.PRY_ID = ?
 AND dpn.DPN_ID = PRY.PRY_LUGAR</property>
        </oda-data-set>

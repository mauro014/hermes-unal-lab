                </structure>
                <structure>
                    <property name="position">32</property>
                    <property name="name">VALOR_PERSONAL_ADMINISTRATIVO</property>
                    <property name="nativeName">VALOR_PERSONAL_ADMINISTRATIVO</property>
                    <property name="dataType">decimal</property>
                </structure>
                <structure>
                    <property name="position">33</property>
                    <property name="name">VALOR_TOTAL_PROYECTO</property>
                    <property name="nativeName">VALOR_TOTAL_PROYECTO</property>
                    <property name="dataType">decimal</property>
                </structure>
                <structure>
                    <property name="position">34</property>
                    <property name="name">VIG</property>
                    <property name="nativeName">VIG</property>
                    <property name="dataType">decimal</property>
                </structure>
                <structure>
                    <property name="position">35</property>
                    <property name="name">CON_MOSTRAR_NOMBRE_LAB</property>
                    <property name="nativeName">CON_MOSTRAR_NOMBRE_LAB</property>
                    <property name="dataType">decimal</property>
                </structure>
                <structure>
                    <property name="position">36</property>
                    <property name="name">PRY_LAB_NOMBRE</property>
                    <property name="nativeName">PRY_LAB_NOMBRE</property>
                    <property name="dataType">string</property>
                </structure>
            </list-property>
            <property name="queryText">select upper(dep.DPN_NOMBRE),
       upper(sede.sed_nombre),
       
       DECODE(pry.PRY_TIPO_ACTIVIDAD, 'PI', 'Proyecto de investigación', '--') TIPOACTIVIDAD,
       pry.PRY_NOMBRE,
       decode(pry.PRY_DURACION_TIPO, 'A', 'Años',
							  'M', 'Meses', 
							  'S', 'Semanas',
							  'D', 'Días', 
							  'H', 'Horas',
							  'NA', 'No aplica') PRY_DURACION_TIPO, 
       pry.PRY_DURACION || ' Meses' CANTIDAD_MESES,
       pry.PRY_HORAS_SEMANA_FORM HORA_SEM_FOR,
       pry.PRY_SEMANAS_FORMULACION SEM_FOR,
       pry.PRY_NA_DURACIONF NO_APLICA,
       (PER.PER_APELLIDO1||' '||DECODE(PER.PER_APELLIDO2, PER.PER_APELLIDO2,PER.PER_APELLIDO2,NULL,' ')||' '||PER.PER_NOMBRE1||' '||DECODE(PER.PER_NOMBRE2, PER.PER_NOMBRE2,PER.PER_NOMBRE2,NULL,' '))PRINCIPAL,
       per.PER_ID,
       (select upper(fac.DPN_NOMBRE)
         from her_dependencia FAC
        where fac.dpn_id = dep.DPN_FACULTAD
          and fac.DPN_ES_FACULTAD = 'Y' ) UNIDAD,
       inp.inp_dedicacion_horas_semana HORA_SEMANA,
       inp.inp_valor_pagar VALOR_DEDICACION,
       pry.PRY_TIPO_ACTIVIDAD TIPO_ACTIVIDAD_ID,
       pry.PRY_CLASE_ACTIV_ECP CLASE_ACTIVIDAD_ECP,
       pry.PRY_TOT_COST_INDIRECTO TOTAL_INDIRECTOS,
       pry.PRY_TOT_TRANFERENCIA TOTAL_TRANSFERENCIAS,
       --to_number(pry.PRY_PORCENTAJE_TRANSFERENC,'9999.99') PORCENTAJE_TRANSFERENC,
       pry.PRY_PORCENTAJE_TRANSFERENC PORCENTAJE_TRANSFERENC,
       (SELECT valor from HER_PARAMETRO WHERE descripcion = 'Fondo ExtSol') PORC_FOND_EXT_SOL,
       (SELECT valor from HER_PARAMETRO WHERE descripcion = 'Fondo EspFac') PORC_FOND_ESP_FAC,
       (SELECT valor from HER_PARAMETRO WHERE descripcion = 'Fondo EspDireccAcadem') PORC_FOND_ESP_DAC,
       (SELECT valor from HER_PARAMETRO WHERE descripcion = 'dirExtSede') PORC_FOND_DEX_SED,
       (SELECT valor from HER_PARAMETRO WHERE descripcion = 'dirNalExt') PORC_FOND_DEX_NAL,
       (SELECT valor from HER_PARAMETRO WHERE descripcion = 'Fondo Investigacion') PORC_FOND_INV,
       (SELECT valor from HER_PARAMETRO WHERE descripcion = 'Fondo Riesgos') PORC_FOND_RIESGOS,
       --to_number(pry.PRY_PORCENTAJE_FAC,'9999.99') PORC_FACULTAD_PRY,
       pry.PRY_PORCENTAJE_FAC PORC_FACULTAD_PRY,
       pry.PRY_VALOR_SOLICITADO VALOR_SOLICITADO,
       pry.PRY_TIPO_ACTIV_ECP MODALIDAD,
       pry.PRY_ID,
       pry.PRY_VALOR_PERSONAL VALOR_PERSONAL_DOCENTE,
       pry.PRY_ADM_TOTAL VALOR_PERSONAL_ADMINISTRATIVO,
       pry.PRY_VALOR_TOTAL VALOR_TOTAL_PROYECTO,
	   NVL(PRY.PRY_VIGENCIA,1)-1 AS VIG,
	   CONV.CON_MOSTRAR_NOMBRE_LAB,
	   pry.PRY_LAB_NOMBRE
  from HER_PROYECTO pry, 
       HER_PERSONA per, 
       HER_INVESTIGADOR_PROYECTO inp, 
       HER_INVESTIGADOR_INTERNO ini, 
       HER_DEPENDENCIA dep,
       HER_SEDE  sede,
       HER_CONVOCATORIA CONV     
 WHERE pry.PRY_ID = ?
   AND per.PER_ID = inp.INV_ID 
   AND per.TDO_ID = inp.TDO_ID 
   AND inp.INP_TIPO = 'P' 
   AND inp.PRY_ID = pry.PRY_ID
   AND per.PER_ID = ini.INV_ID 
   AND per.TDO_ID = ini.TDO_ID 
   AND dep.DPN_ID = ini.DPN_ID
   AND dep.sed_id = sede.sed_id
   AND CONV.CON_ID = pry.MOD_ID</property>
        </oda-data-set>
        <oda-data-set extensionID="org.eclipse.birt.report.data.oda.jdbc.JdbcSelectDataSet" name="NombreLaboratorio" id="11826">
            <structure name="cachedMetaData">
                <list-property name="resultSet">
                    <structure>

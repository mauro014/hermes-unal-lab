            <property name="queryText">select pry.PRY_ID, pry.EJE_TEMATICO, det.DOMDET_DESCRIPCION, ESP.FIE_LISTA_SELECCION, ESP.FIE_TEXTO_LISTA_SELECCION
from her_proyecto pry, her_dominio dom, her_dominio_detalle det, HER_FORMULARIO_INFO_ESPECIFICA ESP
where pry.PRY_ID = ?
and dom.DOM_TIPO = (SELECT INFOES.FIE_DOM_LISTA_SELECCION FROM HER_FORMULARIO_INFO_ESPECIFICA INFOES WHERE INFOES.MOD_ID = PRY.MOD_ID)
and det.DOM_ID = dom.DOM_ID
and det.DOMDET_TIPO = pry.EJE_TEMATICO
AND PRY.MOD_ID = ESP.MOD_ID</property>

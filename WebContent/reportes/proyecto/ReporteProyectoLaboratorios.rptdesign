            <property name="queryText">SELECT   ROWNUM,ACT_DESCRIPCION,substr(ACT_DESCRIPCION,1,200) , ACT_SEMANA_INICIAL Mesi, ACT_DURACION_SEMANAS Dura/*, A.ACT_META AS META, OBJ.OBJ_DESCRIPCION, CONV.CON_ACTI_OBJ_METAS*/
FROM HER_PROYECTO p  ,HER_ACTIVIDAD A/*, HER_OBJETIVO_ESPECIFICO OBJ, HER_CONVOCATORIA CONV*/
WHERE p.pry_id = ?
AND p.PRY_ID=A.PRY_ID
--AND OBJ.OBJ_ID = A.ACT_OBJETIVO_ESP 
--AND CONV.CON_ID = P.MOD_ID
ORDER BY act_id</property>

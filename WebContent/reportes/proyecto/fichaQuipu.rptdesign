        <table id="16">
            <property name="style">tabla3border_upleftright</property>
            <property name="width">100%</property>
            <property name="dataSet">1 ProyectoResponsable</property>
            <list-property name="paramBindings">
                <structure>
                    <property name="paramName">paramId</property>
                    <expression name="expression">params["proyectoId"]</expression>
                </structure>

    <data-sets>
        <oda-data-set extensionID="org.eclipse.birt.report.data.oda.jdbc.JdbcSelectDataSet" name="1 ProyectoResponsable" id="5">
            <property name="dataSource">Fuente de datos</property>
            <list-property name="parameters">
                <structure>
                    <property name="name">paramId</property>
                    <property name="dataType">any</property>
                    <property name="position">1</property>
                    <expression name="defaultValue">5555</expression>
                    <property name="isInput">true</property>
                    <property name="isOutput">false</property>
                </structure>
            </list-property>
            <property name="queryText">select pry.PRY_CODIGO_QUIPU, pry.PRY_NOMBRE,
dep.DPN_NOMBRE, per.PER_NOMBRE1, per.PER_NOMBRE2, per.PER_APELLIDO1, per.PER_APELLIDO2, per.PER_ID,
pry.PRY_DESCRIPCION, pry.PRY_OBJETIVO_GENERAL, to_char (pry.PRY_FECHA_TENTATIVA_INICIO, 'dd mm yyyY') as FECHA_INICIO_PROYECTO, pry.PRY_DURACION, to_char ( Add_months(PRY_FECHA_TENTATIVA_INICIO, pry.PRY_DURACION), 'dd mm yyyy' ) as FECHA_FINAL
from HER_PROYECTO pry, HER_PERSONA per, HER_INVESTIGADOR_PROYECTO inp, HER_INVESTIGADOR_INTERNO ini, HER_DEPENDENCIA dep 
WHERE pry.PRY_ID = ? 
AND per.PER_ID = inp.INV_ID AND per.TDO_ID = inp.TDO_ID AND inp.INP_TIPO = 'P' AND inp.PRY_ID = pry.PRY_ID
AND per.PER_ID = ini.INV_ID AND per.TDO_ID = ini.TDO_ID AND dep.DPN_ID = ini.DPN_ID 
</property>
        </oda-data-set>
        <oda-data-set extensionID="org.eclipse.birt.report.data.oda.jdbc.JdbcSelectDataSet" name="1 Dependencias" id="73">
            <property name="dataSource">Fuente de datos</property>
            <list-property name="parameters">
                <structure>
                    <property name="name">paramId</property>
                    <property name="position">1</property>
                    <expression name="defaultValue">5555</expression>
                    <property name="isInput">true</property>
                </structure>
            </list-property>
            <property name="queryText">select dep.DPN_NOMBRE, prd.PRD_AREA_RESPONSABILIDAD
from HER_PROYECTO_DEPENDENCIA prd, HER_DEPENDENCIA dep
WHERE prd.PRY_ID = ?
AND prd.DPN_ID = dep.DPN_ID  
</property>
        </oda-data-set>
        <oda-data-set extensionID="org.eclipse.birt.report.data.oda.jdbc.JdbcSelectDataSet" name="1 Objetivos" id="93">
            <property name="dataSource">Fuente de datos</property>
            <list-property name="parameters">
                <structure>
                    <property name="name">paramId</property>
                    <property name="position">1</property>
                    <expression name="defaultValue">5555</expression>
                    <property name="isInput">true</property>
                    <property name="isOutput">false</property>
                </structure>
            </list-property>
            <property name="queryText">select HERMES.HER_OBJETIVO_ESPECIFICO.OBJ_DESCRIPCION
from HERMES.HER_OBJETIVO_ESPECIFICO
where HERMES.HER_OBJETIVO_ESPECIFICO.PRY_ID = ?
order by HERMES.HER_OBJETIVO_ESPECIFICO.OBJ_DESCRIPCION</property>
        </oda-data-set>
        <oda-data-set extensionID="org.eclipse.birt.report.data.oda.jdbc.JdbcSelectDataSet" name="1 Resultados" id="136">
            <property name="dataSource">Fuente de datos</property>
            <list-property name="parameters">
                <structure>
                    <property name="name">paramId</property>
                    <property name="position">1</property>
                    <expression name="defaultValue">5555</expression>
                    <property name="isInput">true</property>
                </structure>
            </list-property>
            <property name="queryText">select HERMES.HER_RESULTADO_PROYECTO.RST_DESCRIPCION
from HERMES.HER_RESULTADO_PROYECTO
where HERMES.HER_RESULTADO_PROYECTO.PRY_ID = ?
order by HERMES.HER_RESULTADO_PROYECTO.RST_DESCRIPCION</property>
        </oda-data-set>
        <oda-data-set extensionID="org.eclipse.birt.report.data.oda.jdbc.JdbcSelectDataSet" name="2 AreaTematica" id="153">
            <property name="dataSource">Fuente de datos</property>
            <list-property name="parameters">
                <structure>
                    <property name="name">paramId</property>
                    <property name="position">1</property>
                    <expression name="defaultValue">5555</expression>
                    <property name="isInput">true</property>
                </structure>
            </list-property>
            <property name="queryText">select clc.CLC_ID, clc.CLC_NOMBRE
from HER_CLASIFICACION_CONOCIMIENTO clc, HER_PROYECTO_CLAS_CON pcc
where clc.CLC_ID = pcc.CLC_ID AND pcc.PRY_ID = ?
order by clc.CLC_ID</property>
        </oda-data-set>
        <oda-data-set extensionID="org.eclipse.birt.report.data.oda.jdbc.JdbcSelectDataSet" name="2 PlanGlobalDesarrollo" id="170">
            <property name="dataSource">Fuente de datos</property>
            <list-property name="parameters">
                <structure>
                    <property name="name">paramId</property>
                    <property name="position">1</property>
                    <expression name="defaultValue">5555</expression>
                    <property name="isInput">true</property>
                </structure>
            </list-property>
            <property name="queryText">select HERMES.HER_PLAN_GLOBAL_DESARROLLO.PGD_ID, HERMES.HER_PLAN_GLOBAL_DESARROLLO.PGD_DESCRIPCION
from HERMES.HER_PLAN_GLOBAL_DESARROLLO, HERMES.HER_PROYECTO
where HERMES.HER_PROYECTO.PGD_ID = HERMES.HER_PLAN_GLOBAL_DESARROLLO.PGD_ID and HERMES.HER_PROYECTO.PRY_ID = ?</property>
        </oda-data-set>
        <oda-data-set extensionID="org.eclipse.birt.report.data.oda.jdbc.JdbcSelectDataSet" name="3 ActoAdministrativo" id="189">
            <property name="dataSource">Fuente de datos</property>
            <list-property name="parameters">
                <structure>
                    <property name="name">paramId</property>
                    <property name="position">1</property>
                    <expression name="defaultValue">5555</expression>
                    <property name="isInput">true</property>
                </structure>
            </list-property>
            <property name="queryText">select HERMES.HER_CONVOCATORIA.CON_ACT_NOMBRE, HERMES.HER_CONVOCATORIA.CON_ACT_NUMERO, to_char (HERMES.HER_CONVOCATORIA.CON_ACT_FECHA, 'dd mm yyyY') as FECHA_ACTO, HERMES.HER_CONVOCATORIA.CON_ACT_NOMBRE_FUNCIONARIO
from HERMES.HER_CONVOCATORIA, HERMES.HER_PROYECTO
where HERMES.HER_PROYECTO.MOD_ID = HERMES.HER_CONVOCATORIA.CON_ID and HERMES.HER_PROYECTO.PRY_ID = ?</property>
        </oda-data-set>
        <oda-data-set extensionID="org.eclipse.birt.report.data.oda.jdbc.JdbcSelectDataSet" name="5 Investigadores" id="220">
            <property name="dataSource">Fuente de datos</property>
            <list-property name="parameters">
                <structure>
                    <property name="name">paramId</property>
                    <property name="position">1</property>
                    <expression name="defaultValue">5555</expression>
                    <property name="isInput">true</property>
                </structure>
            </list-property>
            <property name="queryText">select HERMES.HER_PERSONA.PER_ID, HERMES.HER_PERSONA.PER_NOMBRE1, HERMES.HER_PERSONA.PER_NOMBRE2, HERMES.HER_PERSONA.PER_APELLIDO1, 
(HERMES.HER_INVESTIGADOR_PROYECTO.INP_DEDICACION_HORAS_SEMANA * 16) as HORAS_PRIMER_SEMESTRE, (HERMES.HER_INVESTIGADOR_PROYECTO.INP_DEDICACION_HORAS_SEMANA * 16) as HORAS_SEGUNDO_SEMESTRE
from HERMES.HER_PERSONA, HERMES.HER_INVESTIGADOR_PROYECTO, HERMES.HER_INVESTIGADOR
where HERMES.HER_INVESTIGADOR_PROYECTO.PRY_ID = ?
and HERMES.HER_INVESTIGADOR_PROYECTO.TDO_ID = HERMES.HER_PERSONA.TDO_ID
and HERMES.HER_INVESTIGADOR_PROYECTO.INV_ID = HERMES.HER_PERSONA.PER_ID
and HERMES.HER_INVESTIGADOR_PROYECTO.INV_ID = HERMES.HER_INVESTIGADOR.INV_ID
and HERMES.HER_INVESTIGADOR_PROYECTO.TDO_ID = HERMES.HER_INVESTIGADOR.TDO_ID
and HERMES.HER_INVESTIGADOR.CAT_ID = '2'
</property>
        </oda-data-set>
        <oda-data-set extensionID="org.eclipse.birt.report.data.oda.jdbc.JdbcSelectDataSet" name="financiera 1 financiacionInterna" id="290">
            <property name="dataSource">Fuente de datos</property>
            <list-property name="parameters">
                <structure>
                    <property name="name">paramId</property>
                    <property name="position">1</property>
                    <expression name="defaultValue">5555</expression>
                    <property name="isInput">true</property>
                </structure>
            </list-property>
            <property name="queryText">select HERMES.HER_FUENTE_FINANCIACION.FFI_DESCRIPCION as FUENTE_INTERNA, HERMES.HER_FINANCIACION.FIN_VALOR
from HERMES.HER_FUENTE_FINANCIACION, HERMES.HER_FINANCIACION
where HERMES.HER_FINANCIACION.FFI_ID = HERMES.HER_FUENTE_FINANCIACION.FFI_ID 
and HERMES.HER_FUENTE_FINANCIACION.FFI_INTERNA_EXTERNA = 'I'
and HERMES.HER_FINANCIACION.PRY_ID = ?</property>
        </oda-data-set>
        <oda-data-set extensionID="org.eclipse.birt.report.data.oda.jdbc.JdbcSelectDataSet" name="financiera 1 financiacionExterna" id="291">
            <property name="dataSource">Fuente de datos</property>
            <list-property name="parameters">
                <structure>
                    <property name="name">paramId</property>
                    <property name="position">1</property>
                    <expression name="defaultValue">5555</expression>
                    <property name="isInput">true</property>
                </structure>
            </list-property>
            <property name="queryText">select HERMES.HER_FUENTE_FINANCIACION.FFI_DESCRIPCION, HERMES.HER_FINANCIACION.FIN_VALOR, HERMES.HER_FINANCIACION.FIN_IDENTIFICACION_NIT, HERMES.HER_FINANCIACION.FIN_CONTRATO, to_char (HERMES.HER_FINANCIACION.FIN_FECHA_CONTRATO, 'dd mm yyyy') as FECHA_CONTRATO, HERMES.HER_FINANCIACION.FIN_CONVENIO
from HERMES.HER_FINANCIACION, HERMES.HER_FUENTE_FINANCIACION
where HERMES.HER_FINANCIACION.PRY_ID = ?
and HERMES.HER_FINANCIACION.FFI_ID = HERMES.HER_FUENTE_FINANCIACION.FFI_ID
and HERMES.HER_FUENTE_FINANCIACION.FFI_INTERNA_EXTERNA = 'E'</property>
        </oda-data-set>
        <oda-data-set extensionID="org.eclipse.birt.report.data.oda.jdbc.JdbcSelectDataSet" name="financiera 1 financiacionTotal" id="353">
            <property name="dataSource">Fuente de datos</property>
            <list-property name="parameters">
                <structure>
                    <property name="name">paramId</property>
                    <property name="position">1</property>
                    <expression name="defaultValue">5555</expression>
                    <property name="isInput">true</property>
                    <property name="isOutput">false</property>
                </structure>
            </list-property>
            <property name="queryText">select sum(HERMES.HER_FINANCIACION.FIN_VALOR) as TOTAL_FINANCIACION
from HERMES.HER_FINANCIACION
where HERMES.HER_FINANCIACION.PRY_ID = ?</property>
        </oda-data-set>
        <oda-data-set extensionID="org.eclipse.birt.report.data.oda.jdbc.JdbcSelectDataSet" name="financiera 2 gastos" id="370">
            <property name="dataSource">Fuente de datos</property>
            <list-property name="parameters">
                <structure>
                    <property name="name">paramId</property>
                    <property name="position">1</property>
                    <expression name="defaultValue">5555</expression>
                    <property name="isInput">true</property>
                </structure>
            </list-property>
            <property name="queryText">select HERMES.HER_TIPO_RUBRO.TRU_NOMBRE, HERMES.HER_RUBRO.RUB_VALOR_1 as AÃ‘O_1, HERMES.HER_RUBRO.RUB_VALOR_2 as AÃ‘O_2, (HERMES.HER_RUBRO.RUB_VALOR_1 + HERMES.HER_RUBRO.RUB_VALOR_2) as TOTAL
from HERMES.HER_RUBRO, HERMES.HER_TIPO_RUBRO
where HERMES.HER_RUBRO.PRY_ID = ?
and HERMES.HER_RUBRO.TRU_ID = HERMES.HER_TIPO_RUBRO.TRU_ID
order by HERMES.HER_RUBRO.TRU_ID
</property>
        </oda-data-set>
        <oda-data-set extensionID="org.eclipse.birt.report.data.oda.jdbc.JdbcSelectDataSet" name="financiera 2 totalGastos" id="401">
            <property name="dataSource">Fuente de datos</property>
            <list-property name="parameters">
                <structure>
                    <property name="name">paramId</property>
                    <property name="position">1</property>
                    <expression name="defaultValue">5555</expression>
                    <property name="isInput">true</property>
                </structure>
            </list-property>
            <property name="queryText">select sum (HERMES.HER_RUBRO.RUB_VALOR_1) as TOTAL_AÃ‘O_1, sum (HERMES.HER_RUBRO.RUB_VALOR_2) as TOTAL_AÃ‘O_2, sum (HERMES.HER_RUBRO.RUB_VALOR_1 + HERMES.HER_RUBRO.RUB_VALOR_2) as TOTAL_GASTOS
from HERMES.HER_RUBRO
where HERMES.HER_RUBRO.PRY_ID = ?
</property>
        </oda-data-set>
        <oda-data-set extensionID="org.eclipse.birt.report.data.oda.jdbc.JdbcSelectDataSet" name="4 VigenciaActual" id="507">
            <property name="dataSource">Fuente de datos</property>
            <list-property name="parameters">
                <structure>
                    <property name="name">paramId</property>
                    <property name="position">1</property>
                    <expression name="defaultValue">5555</expression>
                    <property name="isInput">true</property>
                </structure>
            </list-property>
            <property name="queryText">select HERMES.HER_VIGENCIA.VIG_VALOR as VIGENCIA_ACTUAL
from HERMES.HER_VIGENCIA
where HERMES.HER_VIGENCIA.VIG_VIGENCIA = '1'
and HERMES.HER_VIGENCIA.PRY_ID = ?</property>
        </oda-data-set>
        <oda-data-set extensionID="org.eclipse.birt.report.data.oda.jdbc.JdbcSelectDataSet" name="4 total proyecto" id="508">
            <property name="dataSource">Fuente de datos</property>
            <list-property name="parameters">
                <structure>
                    <property name="name">paramId</property>
                    <property name="position">1</property>
                    <expression name="defaultValue">5555</expression>

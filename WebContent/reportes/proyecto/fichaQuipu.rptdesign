        <text id="551">
            <property name="style">EncabezadoEstilo</property>
            <property name="contentType">plain</property>
            <text-property name="content"><![CDATA[INFORMACIÃ“N ACADÃ‰MICO - ADMINISTRATIVA DEL PROYECTO]]></text-property>

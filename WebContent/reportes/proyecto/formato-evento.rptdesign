            <property name="queryText">SELECT PRY.PRY_CLASE_EVENTO, DOM.DOMDET_DESCRIPCION
FROM HER_PROYECTO PRY, HER_DOMINIO_DETALLE DOM
WHERE PRY.PRY_ID = ?
AND DOM.DOMDET_TIPO LIKE PRY_CLASE_EVENTO</property>

                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">6</property>
                    <property name="name">DOS_COLAB</property>
                    <property name="nativeName">DOS_COLAB</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">7</property>
                    <property name="name">CON_RESTRICCION</property>
                    <property name="nativeName">CON_RESTRICCION</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">8</property>
                    <property name="name">CON_ID</property>
                    <property name="nativeName">CON_ID</property>
                    <property name="dataType">decimal</property>
                </structure>
            </list-property>
            <property name="queryText"> SELECT DECODE (P.PRY_CNE_APORTE_ECONOMICO, 'a' , 'No tiene financiación de una instancia interna, ni externa y no habrá búsqueda de recursos externos', 'b', 'Tiene financiación de alguna instancia interna','c','Tiene financiación de alguna instancia externa') as uno,
       CASE
          WHEN p.mod_id NOT IN (
              904,
              903
          ) THEN
              decode(p.pry_cne_asistentes, 'a', 'Entre 30 y 100 participantes', 'b', 'Más de 100 participantes')
          ELSE
              decode(p.pry_cne_asistentes, 'a', 'De 30 a 100 participantes en Sedes Andinas', 'b', 'Más de 100 participantes en Sedes Andinas'
              ,
                     'c', 'De 30 a 50 participantes en Sedes de Presencia Nacional', 'd', 'Más de 50 participantes en Sedes de Presencia Nacional'
                     )
      END AS dos,
       DECODE (P.PRY_CNE_CONFERENCISTAS_NAC_EXT, 'a', 'Entre 2 y 3 conferencistas de al menos dos instituciones o sedes diferentes', 'b' , 'Más de 4 conferencistas de al menos dos instituciones o sedes diferentes') as tres_a,
       DECODE (P.PRY_CNE_CONFERENCISTAS_NAC_VIN , 'a', 'Entre 3 y 4 conferencistas internacionales', 'b', 'Más de 4 conferencistas internacionales') as tres_b,
       DECODE (P.PRY_CNE_TIPO_PARTICIPACION, 'a' , 'Las inscripciones a estudiantes se cobran', 'b', 'Las inscripciones a estudiantes tienen descuento o se otorgan cupos', 'c', 'Las inscripciones a estudiantes no se cobran') as cuatro,
       DECODE (P.PRY_CNE_TRABAJO_COLABORATIVO, 'a', 'Participación de una sola facultad, centro o instituto', 'b', 'Participación de varias instancias de una misma sede (entre facultades, centros, o institutos)', 'c', 'Participación intersedes (entre facultades, centros e institutos de las sedes andinas)', 'd', 'Participación intersedes en las que se encuentre al menos una de las sedes de presencia nacional') as dos_colab,
       c.con_restriccion,
       c.con_id    
  FROM HER_PROYECTO p left join her_convocatoria c on c.con_id = p.mod_id
 WHERE p.PRY_ID = ?</property>
        </oda-data-set>

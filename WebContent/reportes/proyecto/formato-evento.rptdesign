                </structure>
            </list-property>
            <property name="queryText">SELECT det.domdet_tipo, det.domdet_descripcion, p.mod_id
FROM HER_PROYECTO p, HER_PRY_AREA_GESTION_CONO oe, HER_DOMINIO DOM, HER_DOMINIO_DETALLE DET
WHERE p.pry_id = ?
AND p.PRY_ID= oe.PRY_ID
AND oe.dom_id = 287
and oe.domdet_tipo = det.domdet_tipo
and det.dom_id = dom.dom_id
and dom.dom_id = oe.dom_id
order by det.domdet_tipo asc</property>
        </oda-data-set>

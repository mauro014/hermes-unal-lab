                </structure>
            </list-property>
            <list-property name="resultSet">
                <structure>
                    <property name="position">1</property>
                    <property name="name">RUBRO</property>
                    <property name="nativeName">RUBRO</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">2</property>
                    <property name="name">VALOR</property>
                    <property name="nativeName">VALOR</property>
                    <property name="dataType">decimal</property>
                </structure>
                <structure>
                    <property name="position">3</property>
                    <property name="name">VIGENCIA</property>
                    <property name="nativeName">VIGENCIA</property>
                    <property name="dataType">decimal</property>
                </structure>
                <structure>
                    <property name="position">4</property>
                    <property name="name">FFI_DESCRIPCION</property>
                    <property name="nativeName">FFI_DESCRIPCION</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">5</property>
                    <property name="name">GST_DESCRIPCION</property>
                    <property name="nativeName">GST_DESCRIPCION</property>
                    <property name="dataType">string</property>
                </structure>
            </list-property>
            <property name="queryText"> SELECT TRU_NOMBRE  Rubro, SUM(GST_VALOR) Valor, GST_VIGENCIA VIGENCIA, ff.FFI_DESCRIPCION, GST_DESCRIPCION
  FROM  HER_GASTO g, 
HER_TIPO_RUBRO tr, HER_FINANCIACION f , her_fuente_financiacion ff
WHERE 
(FIN_ES_LEGALIZACION IS NULL OR  FIN_ES_LEGALIZACION = 'NO')
AND  (F.FFE_TIPO_ENTIDAD = 'F' OR F.FFE_TIPO_ENTIDAD is null)
AND g.fin_ID = f.fin_ID 
AND ff.FFI_ID = f.FFI_ID 
AND g.tru_id =tr.TRU_ID
AND PRY_ID = ?
GROUP BY TRU_NOMBRE, GST_VIGENCIA, ff.FFI_DESCRIPCION,GST_DESCRIPCION
ORDER BY ff.FFI_DESCRIPCION</property>
        </oda-data-set>

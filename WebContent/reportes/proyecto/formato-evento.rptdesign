                    <property name="nativeName">EFEC_EXTERNA</property>
                    <property name="dataType">decimal</property>
                </structure>
            </list-property>
            <property name="queryText">SELECT * FROM 
 (SELECT SUM(NVL(FIN_VALOR,0)) EFEC, SUM(NVL(FFE_VALOR_ESPECIE,0)) ESP 
 FROM HER_FINANCIACION 
 WHERE FFE_TIPO_ENTIDAD = 'P' AND PRY_ID = ?),
 (SELECT SUM(NVL(GST_VALOR,0)) EFEC_UNAL 
 FROM HER_FINANCIACION F, HER_FUENTE_FINANCIACION FF, HER_GASTO G, HER_TIPO_RUBRO TR
 WHERE (FFE_TIPO_ENTIDAD IS NULL OR FFE_TIPO_ENTIDAD ='F') 
 AND FF.FFI_ID = F.FFI_ID 
 AND FF.FFI_INTERNA_EXTERNA IN ('I','O')
 AND G.FIN_ID = F.FIN_ID
 AND G.TRU_ID = TR.TRU_ID
 AND TR.TRU_CONTRAPARTIDA = 0
 AND PRY_ID = ?),
  (SELECT DECODE(SUM(NVL(GST_VALOR,0)),null,0,SUM(NVL(GST_VALOR,0))) ESPEC_UNAL 
 FROM HER_FINANCIACION F, HER_FUENTE_FINANCIACION FF, HER_GASTO G, HER_TIPO_RUBRO TR
 WHERE (FFE_TIPO_ENTIDAD IS NULL OR FFE_TIPO_ENTIDAD ='F') 
 AND FF.FFI_ID = F.FFI_ID 
 AND FF.FFI_INTERNA_EXTERNA IN ('I','O')
 AND G.FIN_ID = F.FIN_ID
 AND G.TRU_ID = TR.TRU_ID
 AND TR.TRU_CONTRAPARTIDA = 1
 AND PRY_ID = ?),
 (SELECT DECODE(SUM(NVL(GST_VALOR,0)),null,0,SUM(NVL(GST_VALOR,0))) EFEC_EXTERNA 
 FROM HER_FINANCIACION F, HER_FUENTE_FINANCIACION FF, HER_GASTO G, HER_TIPO_RUBRO TR
 WHERE (FFE_TIPO_ENTIDAD IS NULL OR FFE_TIPO_ENTIDAD ='F') 
 AND FF.FFI_ID = F.FFI_ID 
 AND FF.FFI_INTERNA_EXTERNA IN ('E','OE')
 AND G.FIN_ID = F.FIN_ID
 AND G.TRU_ID = TR.TRU_ID
 AND TR.TRU_CONTRAPARTIDA = 0
 AND PRY_ID = ?)</property>
        </oda-data-set>

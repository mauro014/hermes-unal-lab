            <property name="queryText">SELECT DECODE (P.PRY_CNE_APORTE_ECONOMICO, 'a' , 'No tiene financiación de una instacia interna ni externa, y no habrá busqueda de recursos externos', 'b', 'Tiene finanaciación de alguna instancia interna y/o externa') as uno,
       DECODE (P.PRY_CNE_ASISTENTES, 'a' , 'Entre 1 y 50 participantes', 'b', 'Entre 50 y 200 participantes', 'c', 'Más de 200 participantes', 'd' , 'Entre 1 y 30 participantes', 'e', 'Entre 30 y 100 participantes', 'f', 'Más de 100 participantes') as dos,
       DECODE (P.PRY_CNE_CONFERENCISTAS_NAC_EXT, 'a', 'De 0 hasta 2 conferencistas', 'b' , 'Más de 2 conferencistas') as tres_a,
       DECODE (P.PRY_CNE_CONFERENCISTAS_NAC_VIN, 'c', 'Conferencistas de la misma sede', 'a', 'Hasta 2 conferencistas de diferentes sedes de la UN', 'b', 'Más de 2 conferencistas de diferentes sedes de la UN') as tres_b,
       DECODE (P.PRY_CNE_CONFERENCISTAS_INTERNA, 'a', '1 conferencista', 'b' , '2 conferencistas', 'c', 'Más de 2 conferencistas', 'No tiene') as tres_c,
       DECODE (P.PRY_CNE_TIPO_PARTICIPACION, 'a' , 'Si las inscripciones a estudiantes se cobran', 'b', 'Si las inscripciones a estudiantes tienen descuento o se otorgan cupos', 'c', 'Si las inscripciones a estudiantes no se cobran') as cuatro,
       c.con_restriccion      
  FROM HER_PROYECTO p left join her_convocatoria c on c.con_id = p.mod_id
 WHERE p.PRY_ID = ?</property>
        </oda-data-set>

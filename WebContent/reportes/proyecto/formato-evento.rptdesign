            </list-property>
            <property name="queryText"> SELECT DECODE (P.PRY_CNE_APORTE_ECONOMICO, 'a' , 'No tiene financiación de una instancia externa', 'b', 'Tiene financiación de alguna instancia y/o externa') as uno,
       DECODE (P.PRY_CNE_ASISTENTES, 'a' , 'Entre 30 y 100 participantes', 'b', 'Más de 100 participantes') as dos,
       DECODE (P.PRY_CNE_CONFERENCISTAS_NAC_EXT, 'a', 'Entre 0 y 2 conferencistas de al menos dos instituciones o sedes diferentes', 'b' , 'Entre 2 y 3 conferencistas de al menos dos instituciones o sedes diferentes', 'c','Más de 3 conferencistas de al menos dos instituciones o sedes diferentes') as tres_a,
       DECODE (P.PRY_CNE_CONFERENCISTAS_NAC_VIN , 'a', 'Entre 3 y 4 conferencistas de al menos tres países además de Colombia', 'b', 'Más de 4 conferencistas de al menos tres países además de Colombia') as tres_b,
       DECODE (P.PRY_CNE_TIPO_PARTICIPACION, 'a' , 'Si las inscripciones a estudiantes se cobran', 'b', 'Si las inscripciones a estudiantes tienen descuento o se otorgan cupos', 'c', 'Si las inscripciones a estudiantes no se cobran') as cuatro,
       c.con_restriccion      
  FROM HER_PROYECTO p left join her_convocatoria c on c.con_id = p.mod_id
 WHERE p.PRY_ID = ?</property>
        </oda-data-set>

                    <property name="name">POBLACION_AL_DIRIGE</property>
                    <property name="nativeName">POBLACION_AL_DIRIGE</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">37</property>
                    <property name="name">ARTICULA_LIN_GRU</property>
                    <property name="nativeName">ARTICULA_LIN_GRU</property>
                    <property name="dataType">string</property>
                </structure>
            </list-property>
            <property name="queryText">SELECT p.PRY_ID,
P.PRY_NOMBRE,
p.pry_descripcion,
p.pry_abstract,
p.PRY_JUSTIFICACION, 
p.PRY_MARCO_TEORICO,
p.PRY_OBJETIVO_GENERAL, 
PRY_METODOLOGIA,
PRY_IMPACTO_ESPERADO,
PRY_CONSIDERACIONES_ETICAS,
PRY_PROPIEDAD_INTELECTUAL, 
CON_RESTRICCION,
p.PRY_SOS_POR_QUE_NIVEL as isbn, 
p.PRY_OBSERVACIONES as area, 
p.PRY_VALOR_TOTAL_FINAL as costoFinalPubl, 
p.PRY_VALOR_SOLICITADO as valorSolicitado,
P.PRY_MAX_ASISTENTES,
P.PRY_FECHA_TENTATIVA_INICIO,
P.PRY_FECHA_FINAL,
P.PRY_LUGAR,
p.PRY_CLASE_EVENTO, 
NVL(p.PRY_OTRO_CLASE_EVENTO,'-')otro, 
dd.DOMDET_DESCRIPCION as tipo_ev,
p.PRY_CUPOS_DESCUENTO as cupos,
MET.DOMDET_DESCRIPCION as metodologia,
p.PRY_HORA_SESION as intensidadHora,
p.PRY_TIPO_CERTIFICACION as tieneCert,
p.PRY_SIST_CALIFICACION as sistCal,
CIU.CIU_NOMBRE, DEPT.DEP_NOMBRE,
P.PRY_CAMPO_GEN_8 as divulgacion, 
--p.PRY_OBJETIVO_GENERAL, 
p.PRY_DESCRIPCION as relacionODS,
PAIS.PAIS_NOMBRE,
(select listagg(DD.DOMDET_DESCRIPCION,' ; ') WITHIN GROUP (ORDER BY DD.DOMDET_DESCRIPCION) FROM HER_PROYECTO_POBLACION_OBJ PPO INNER JOIN HER_DOMINIO_DETALLE DD ON PPO.DOMDET_TIPO = DD.DOMDET_TIPO AND PPO.DOM_ID = DD.DOM_ID WHERE PPO.PRY_ID = p.pry_id group by PPO.pry_id) as POBLACION_OBJETIVO,
GRU.DOMDET_DESCRIPCION AS GRUPO_AL_DIRIGE,
POB.DOMDET_DESCRIPCION AS POBLACION_AL_DIRIGE,
P.PRY_ARTICULA_LINEAS_GRUPOS AS ARTICULA_LIN_GRU
FROM HER_PROYECTO p
LEFT JOIN HER_CONVOCATORIA C ON C.CON_ID = P.MOD_ID
LEFT JOIN HER_PROYECTO_CIUDAD PC ON PC.PRY_ID = P.PRY_ID
LEFT JOIN HER_CIUDAD CIU ON PC.CIU_ID = CIU.CIU_ID
LEFT JOIN HER_DEPARTAMENTO DEPT ON CIU.DEP_ID = DEPT.DEP_ID
LEFT JOIN HER_PAIS PAIS ON P.PRY_PAIS_EVENTO = PAIS.PAIS_ID
LEFT JOIN HER_DOMINIO_DETALLE dd ON dd.DOMDET_TIPO = p.PRY_CLASE_EVENTO AND (dd.DOM_ID IN (2,234,235))
LEFT JOIN HER_DOMINIO_DETALLE MET ON MET.DOMDET_TIPO = p.PRY_LOGISTICA AND MET.DOM_ID = 227
LEFT JOIN HER_DOMINIO_DETALLE GRU ON GRU.DOMDET_TIPO = p.PRY_GRUPO_DIRIGE AND GRU.DOM_ID = 230
LEFT JOIN HER_DOMINIO_DETALLE POB ON POB.DOMDET_TIPO = p.PRY_POBLACION_DIRIGE AND POB.DOM_ID = 231
WHERE p.pry_id = ?</property>
        </oda-data-set>

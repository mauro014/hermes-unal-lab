            <property name="queryText">SELECT FF.FFI_DESCRIPCION, fin.fin_valor, fin.ffe_valor_especie
FROM HER_PROYECTO PRY, HER_FINANCIACION FIN, HER_FUENTE_FINANCIACION FF
WHERE PRY.PRY_ID = ?
AND PRY.PRY_ID = FIN.PRY_ID
AND FIN.FFI_ID = FF.FFI_ID
AND FIN.FFE_TIPO_ENTIDAD = 'P'</property>

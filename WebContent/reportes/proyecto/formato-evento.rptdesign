            <property name="queryText">SELECT PRY.PRY_MAX_ASISTENTES,
PRY.PRY_NOMBRE,PRY.PRY_ID, PRY.PRY_ABSTRACT,
PRY_FECHA_TENTATIVA_INICIO as fechaInicio, PRY_FECHA_FINAL as fechaFin,
PER.PER_NOMBRE1||' '||DECODE(PER.PER_NOMBRE2, PER.PER_NOMBRE2,PER.PER_NOMBRE2,NULL,' ')||' '||PER.PER_APELLIDO1||' '||DECODE(PER.PER_APELLIDO2, PER.PER_APELLIDO2,PER.PER_APELLIDO2,NULL,' ')PRINCIPAL,
PER.PER_ID, TD.TDO_NOMBRE, PER.PER_EMAIL, PER.PER_TELEFONO, 
PER.PER_DIRECCION, C.CON_ID,  CON_RESTRICCION, PRY_LUGAR as "lugar",
d.dpn_nombre as unidad, fac.dpn_nombre as facultad, s.sed_nombre as sede
FROM HER_PROYECTO PRY, HER_INVESTIGADOR_PROYECTO INP, 
HER_PERSONA PER left join her_investigador_interno ii on ii.inv_id = per.per_id and ii.tdo_id = per.tdo_id left join her_dependencia d on d.dpn_id = ii.dpn_id
left join her_dependencia fac on fac.dpn_id = d.dpn_facultad left join her_sede s on s.sed_id = fac.sed_id, HER_TIPO_DOCUMENTO TD, HER_CONVOCATORIA C
WHERE PRY.PRY_ID = ?
AND PER.PER_ID = INP.INV_ID
AND PRY.PRY_ID=INP.PRY_ID
AND INP.INP_TIPO ='P'
AND INP.TDO_ID = TD.TDO_ID
 AND C.CON_ID = Pry.MOD_ID
 </property>
        </oda-data-set>

            <list-property name="resultSet">
                <structure>
                    <property name="position">1</property>
                    <property name="name">CODIGO_SOL</property>
                    <property name="nativeName">CODIGO_SOL</property>
                    <property name="dataType">decimal</property>
                </structure>
                <structure>
                    <property name="position">2</property>
                    <property name="name">DOCUMENTO</property>
                    <property name="nativeName">DOCUMENTO</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">3</property>
                    <property name="name">PERSONA</property>
                    <property name="nativeName">PERSONA</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">4</property>
                    <property name="name">TIPO_INVESTIGADOR</property>
                    <property name="nativeName">TIPO_INVESTIGADOR</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">5</property>
                    <property name="name">TIPO_SOLICITUD</property>
                    <property name="nativeName">TIPO_SOLICITUD</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">6</property>
                    <property name="name">DEDICACION</property>
                    <property name="nativeName">DEDICACION</property>
                    <property name="dataType">decimal</property>
                </structure>
                <structure>
                    <property name="position">7</property>
                    <property name="name">FUNCION</property>
                    <property name="nativeName">FUNCION</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">8</property>
                    <property name="name">FECHA_CAMBIO</property>
                    <property name="nativeName">FECHA_CAMBIO</property>
                    <property name="dataType">date-time</property>
                </structure>
            </list-property>
            <property name="queryText">SELECT solin.SIN_ID AS CODIGO_SOL ,'('||PER.TDO_ID ||' - '||PER.PER_ID||')' AS DOCUMENTO,
PER.PER_NOMBRE1||' '||DECODE(PER.PER_NOMBRE2,PER.PER_NOMBRE2,PER.PER_NOMBRE2,NULL,' ')||' '||PER.PER_APELLIDO1||' '||DECODE(PER.PER_APELLIDO2,PER.PER_APELLIDO2,PER.PER_APELLIDO2,NULL,' ') persona,
TI.TINV_NOMBRE AS TIPO_INVESTIGADOR, DECODE(SOLIN.SIN_TIPO_SOLICITUD,'A','VINCULACIÓN AL EQUIPO DE TRABAJO','R','RETIRAR','E','DESVINCULACIÓN COMO INVESTIGADOR PRINCIPAL','C','VINCULACIÓN INVESTIGADOR PRINCIPAL','I','DESVINCULACIÓN DEL EQUIPO DE TRABAJO') AS TIPO_SOLICITUD,
SOLIN.SIN_DEDICACION_HORAS_SEMANA AS DEDICACION, SOLIN.SIN_FUNCION AS FUNCION, SOLIN.SIN_FECHA_PROCESAMIENTO AS FECHA_CAMBIO
FROM HER_SOLICITUD_INVESTIGADOR SOLIN, HER_SOLICITUD SOL, HER_PROYECTO PRY, HER_PERSONA PER, HER_TIPO_INVESTIGADOR TI
WHERE PRY.PRY_ID = ?
AND PRY.PRY_ID = SOL.PRY_ID
AND SOL.TSO_ID IN (5,24)
AND SOLIN.SOL_ID = SOL.SOL_ID
AND SOLIN.SIN_TIPO_SOLICITUD NOT IN ('R')
AND SOLIN.SIN_TIPO = TI.TINV_ID
AND PER.PER_ID = SOLIN.INV_ID
AND PER.TDO_ID = SOLIN.TDO_ID
order by per.PER_ID, solin.SIN_ID asc</property>
        </oda-data-set>

            <property name="queryText">SELECT   ROWNUM,ACT_DESCRIPCION,substr(ACT_DESCRIPCION,1,40) , ACT_SEMANA_INICIAL Mesi, ACT_DURACION_SEMANAS Dura 
FROM HER_PROYECTO p  ,HER_ACTIVIDAD A

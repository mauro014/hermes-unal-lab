            <property name="queryText"> SELECT  DPN_nombre
  FROM HER_DEPENDENCIA WHERE dpn_id IN  
(SELECT  
    d1.DPN_FACULTAD
FROM HER_PROYECTO p, HER_INVESTIGADOR_INTERNO   II, HER_SEDE S, 
HER_DEPENDENCIA D  , HER_DEPENDENCIA D1  , HER_INVESTIGADOR_PROYECTO IP
WHERE p.pry_id =  ?
AND IP.PRY_ID = P.PRY_ID
AND II.INV_ID = IP.INV_ID
AND IP.INP_TIPO = 'P'
AND II.DPN_ID = D.DPN_ID  
AND D.SED_ID = S.SED_ID 
AND ii.DPN_ID = d1.DPN_ID )</property>
        </oda-data-set>

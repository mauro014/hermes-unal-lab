            <property name="queryText">SELECT TDC1.TDC_VALOR, tr.TRU_ID ,TR.TRU_NOMBRE  Rubro, gST.GST_VIGENCIA Vigencia, 
GST.gst_descripcion Descripción,GST.gst_cantidad Cantidad ,
GST.GST_VALOR/TDC1.TDC_VALOR  Valor ,0 cero1 ,GST.GST_VALOR/TDC_VALOR gv2, 0 cero2,0 cero3, 0 cero4,GST_VALOR/TDC_VALOR gv3 
  FROM  HER_GASTO gst, HER_TIPO_RUBRO tr, HER_FINANCIACION f ,
  her_fuente_financiacion ff , HER_TIPO_CAMBIO TDC1
WHERE
gst.tru_id =tr.TRU_ID AND 
gst.fin_ID = f.fin_ID AND 
ff.FFI_ID = f.FFI_ID and
ff.FFI_INTERNA_EXTERNA = 'I' AND
GST.GST_VIGENCIA = 1 
and f.PRY_ID = ?
and TDC1.TDC_id = (select tdc.TDC_ID CAMBIO from HER_TIPO_CAMBIO TDC
where tdc.TDC_ID = (SELECT max(TDC1.TDC_ID ) FROM HER_TIPO_CAMBIO TDC1))
</property>
        </oda-data-set>

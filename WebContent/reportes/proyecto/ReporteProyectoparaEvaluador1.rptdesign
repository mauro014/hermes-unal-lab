            <property name="queryText">SELECT  
   D.DPN_ID,  PRD_AREA_RESPONSABILIDAD
FROM HER_PROYECTO p, HER_DEPENDENCIA D  , HER_PROYECTO_DEPENDENCIA pd
WHERE p.pry_id =  ?
and pd.DPN_ID = d.DPN_ID
and p.pry_id = pd.pry_id </property>
        </oda-data-set>

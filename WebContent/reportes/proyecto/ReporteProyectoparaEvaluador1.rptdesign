        <oda-data-set extensionID="org.eclipse.birt.report.data.oda.jdbc.JdbcSelectDataSet" name="GPServicios" id="797">
            <structure name="cachedMetaData"/>
            <property name="dataSource">Data Source</property>
            <list-property name="parameters">
                <structure>
                    <property name="name">param1</property>
                    <property name="paramName">id</property>
                    <property name="dataType">any</property>
                    <property name="position">1</property>
                    <property name="isInput">true</property>
                    <property name="isOutput">false</property>
                </structure>
            </list-property>
            <property name="queryText">SELECT TRU_NOMBRE  Rubro, g.GST_VIGENCIA Vigencia, 
gst_descripcion Descripción,gst_cantidad Cantidad,GST_VALOR Valor,
0 cero1 ,GST_VALOR gv2, 0 cero2,0 cero3, 0 cero4,GST_VALOR gv3 
  FROM  HER_GASTO g, 
HER_TIPO_RUBRO tr, HER_FINANCIACION f , her_fuente_financiacion ff
WHERE 
g.fin_ID = f.fin_ID AND 
ff.FFI_ID = f.FFI_ID and
g.tru_id =tr.TRU_ID AND 
tr.tru_id IN (2) AND
g.GST_VIGENCIA = 1 AND
PRY_ID = ?
and ffi_interna_externa = 'I'
</property>

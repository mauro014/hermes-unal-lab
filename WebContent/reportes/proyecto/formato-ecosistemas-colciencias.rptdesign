            <property name="queryText">select p.PRY_ID, 
p.pry_lugar, 
ci.CIU_NOMBRE, 
d.DEP_NOMBRE, 
dd.domdet_descripcion as zona
from her_proyecto p,  HER_CIUDAD ci,  HER_PROYECTO_CIUDAD pryc, HER_DEPARTAMENTO D, her_dominio_detalle dd
where p.pry_id = ?
and pryc.CIU_ID = ci.ciu_id
and pryc.PRY_ID = p.pry_id
and ci.DEP_ID = d.DEP_ID
and dd.domdet_tipo = p.pry_ext_sol_zona</property>
        </oda-data-set>

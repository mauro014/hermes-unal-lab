            <property name="queryText">SELECT PAG_ORDEN ord, 
p.pry_id,
AC.AGD_NOMBRE as subarea, 
AC1.AGD_NOMBRE as area
FROM HER_PROYECTO p, HER_PROYECTO_AGENDA PA, HER_AGENDA_CONOCIMIENTO AC, HER_AGENDA_CONOCIMIENTO   AC1
WHERE p.pry_id = ?
AND PA.PRY_ID = p.pry_id 
AND PA.AGD_ID = AC.AGD_ID
AND AC.AGD_INCLUIDA_EN = AC1.AGD_ID
ORDER BY PA.PAG_ORDEN</property>

                    <property name="name">PER_TELEFONO</property>
                    <property name="nativeName">PER_TELEFONO</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">13</property>
                    <property name="name">PER_CELULAR</property>
                    <property name="nativeName">PER_CELULAR</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">14</property>
                    <property name="name">PER_FNACIMIENTO</property>
                    <property name="nativeName">PER_FNACIMIENTO</property>
                    <property name="dataType">date-time</property>
                </structure>
                <structure>
                    <property name="position">15</property>
                    <property name="name">PER_PROFESION</property>
                    <property name="nativeName">PER_PROFESION</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">16</property>
                    <property name="name">PER_NACIONALIDAD</property>
                    <property name="nativeName">PER_NACIONALIDAD</property>
                    <property name="dataType">string</property>
                </structure>
            </list-property>
            <property name="queryText">SELECT '('||IP.TDO_ID ||' - '||IP.INV_ID||')' AS DOCUMENTO,
p.PER_NOMBRE1||' '||DECODE(p.PER_NOMBRE2,p.PER_NOMBRE2,p.PER_NOMBRE2,NULL,' ')||' '||p.PER_APELLIDO1||' '||DECODE(p.PER_APELLIDO2,p.PER_APELLIDO2,p.PER_APELLIDO2,NULL,' ') persona,
decode(DP.DPN_NOMBRE,null,decode(D.DPN_NOMBRE,null,decode(ins.ins_nombre,null,'No disponible',ins.ins_nombre),d.DPN_NOMBRE),DP.DPN_NOMBRE) AS UNIDAD,
TI.TINV_NOMBRE AS VINCULACION,
IP.INP_VALOR_PAGAR AS VALOR_DEDICACION,
IP.INP_DEDICACION_HORAS_SEMANA AS HORAS_SEMANA,
IP.INP_TOTAL_HORAS_VINCULACION AS TOTAL_TIEMPO,
'Grupo: '||G.GRU_NOMBRE AS GRUPO,
G.GRU_ID,
decode(IP.INP_FUNCION,null,'No disponible',IP.INP_FUNCION) as FUNCION,
'('||P.PER_EMAIL||')' AS EMAIL,
P.PER_TELEFONO,
P.PER_CELULAR,
P.PER_FNACIMIENTO,
P.PER_PROFESION,
P.PER_NACIONALIDAD
FROM HER_PROYECTO PRY
LEFT JOIN HER_INVESTIGADOR_PROYECTO IP ON PRY.PRY_ID = IP.PRY_ID
LEFT JOIN HER_INVESTIGADOR_INTERNO II ON II.TDO_ID = IP.TDO_ID AND II.INV_ID = IP.INV_ID
LEFT JOIN HER_PERSONA P ON P.PER_ID = IP.INV_ID AND P.TDO_ID = IP.TDO_ID
LEFT JOIN HER_DEPENDENCIA D ON II.DPN_ID = D.DPN_ID
LEFT JOIN HER_DEPENDENCIA DP ON DP.DPN_ID = IP.DPN_ID
LEFT JOIN HER_TIPO_INVESTIGADOR TI ON TI.TINV_ID = IP.INP_TIPO
LEFT JOIN HER_GRUPO G ON G.GRU_ID = IP.GRU_ID
LEFT JOIN HER_INSTITUCION INS ON IP.INS_ID = INS.INS_ID
WHERE PRY.PRY_ID = ?
AND IP.INP_TIPO &lt;> 'P'
AND IP.INV_ID NOT IN (SELECT TIN.TINV_DOCUMENTO FROM HER_TIPO_INVESTIGADOR TIN WHERE TIN.TINV_DOCUMENTO is not null)
</property>
        </oda-data-set>

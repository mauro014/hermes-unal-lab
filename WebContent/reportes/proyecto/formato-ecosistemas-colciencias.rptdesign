            <property name="queryText">SELECT CIU.CIU_NOMBRE as ciudad
FROM HER_PROYECTO_CIUDAD CIU_PRY, HER_CIUDAD CIU, HER_PROYECTO PRY
WHERE PRY.PRY_ID = CIU_PRY.PRY_ID
AND CIU_PRY.CIU_ID = CIU.CIU_ID
AND PRY.PRY_ID =  ? 
</property>
        </oda-data-set>

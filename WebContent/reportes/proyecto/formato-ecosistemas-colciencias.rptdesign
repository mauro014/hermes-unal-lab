            <property name="queryText">select PRY.PRY_ID as ID,
PRY.PRY_NOMBRE as NOMBRE,
DET.DOMDET_DESCRIPCION AS TIPOLOGIA,
EP.EPR_NOMBRE AS ESTADO,
PRY.EPR_ID AS ID_ESTADO,
PRY.PRY_DURACION AS DURACION, 
PRY.PRY_DURACION_TIPO AS TIPO_DURACION,
PRY.PRY_PRY_ASOCIADO AS PRY_ASOCIADO,
PRY.PRY_CODIGO_DIB AS PRY_ASOCIADO2,
pry.PRY_HORAS_SEMANA_FORM as HORA_FORMULA,
pry.PRY_SEMANAS_FORMULACION  AS SEM_FORMULA,
PRY.PRY_PADRE PRY_PADRE,
replace (replace(pry.PRY_IMPACTO_ESPERADO, '&lt;infoGrupo>','. Entidad: '), '&lt;grupo>','. ') as "grupos",PRY_ABSTRACT,PRY_OBJETIVO_GENERAL,
PRY_ENTIDADES_PARTICIPANTES, TI.TIN_NOMBRE
from HER_PROYECTO PRY
left join HER_DOMINIO_DETALLE DET ON DET.DOMDET_TIPO = PRY.PRY_TIPO_ACTIV_ECP AND DET.DOM_ID = 118
left join HER_ESTADO_PROYECTO EP ON EP.EPR_ID = PRY.EPR_ID
left join HER_TIPO_INVESTIGACION TI ON TI.TIN_ID = PRY.TIN_ID
where PRY.PRY_ID = ?</property>

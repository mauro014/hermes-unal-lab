            </list-property>
            <property name="queryText">SELECT   ROWNUM,
substr(ACT_DESCRIPCION,1,100), 
ACT_SEMANA_INICIAL, 
ACT_DURACION_SEMANAS, act_id
FROM HER_PROYECTO p, HER_ACTIVIDAD A
WHERE p.pry_id = ?
AND p.PRY_ID=A.PRY_ID 
order by  act_id
</property>
        </oda-data-set>

                    <property name="nativeName">CAT_COL</property>
                    <property name="dataType">string</property>
                </structure>
            </list-property>
            <property name="queryText">SELECT G.GRU_COLCIENCIAS, G.GRU_NOMBRE, G.GRU_ENLACE_GRUPLAC AS GRUPLAC, PRN.GRU_ID AS GPRN,
d.dpn_nombre as dpn, gc.grc_nombre as cat_col
FROM HER_PROYECTO p 
left join HER_GRUPO_PROYECTO GP on gp.PRY_ID = p.pry_id
left join HER_GRUPO G on G.GRU_ID = GP.GRU_ID
left join HER_PROGRAMA_NACIONAL_PRN PRN on G.GRU_ID = PRN.GRU_ID AND PRN.PRY_ID = P.PRY_ID
left join her_dependencia d on g.dpn_id = d.dpn_id
left join HER_GRUPO_CATEGORIA GC on gc.GRC_ID = G.GRU_CATEGORIA_COLCIENCIAS
WHERE p.pry_id = ?
ORDER BY GPRN,G.GRU_NOMBRE ASC

</property>
        </oda-data-set>

            <property name="queryText">SELECT TRU_NOMBRE as rubro, 
SUM(GST_VALOR) as valor, 
GST_VIGENCIA as VIGENCIA, 
MAX(GST_DESCRIPCION) as DESCRIPCION, 
ff.FFI_DESCRIPCION as fuente
FROM  HER_GASTO g, 
HER_TIPO_RUBRO tr, HER_FINANCIACION f, her_fuente_financiacion ff
WHERE 
g.fin_ID = f.fin_ID 
AND ff.FFI_ID = f.FFI_ID 
AND g.tru_id =tr.TRU_ID
AND PRY_ID = ?
AND (FIN_ES_LEGALIZACION IS NULL OR  FIN_ES_LEGALIZACION = 'NO')
AND  (F.FFE_TIPO_ENTIDAD = 'F' OR F.FFE_TIPO_ENTIDAD is null)
GROUP BY TRU_NOMBRE, GST_VIGENCIA, ff.FFI_DESCRIPCION
ORDER BY ff.FFI_DESCRIPCION asc</property>
        </oda-data-set>

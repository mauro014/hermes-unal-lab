            <property name="queryText">SELECT '('||IP.TDO_ID ||' - '||IP.INV_ID||')' AS DOCUMENTO,
p.PER_NOMBRE1||' '||DECODE(p.PER_NOMBRE2,p.PER_NOMBRE2,p.PER_NOMBRE2,NULL,' ')||' '||p.PER_APELLIDO1||' '||DECODE(p.PER_APELLIDO2,p.PER_APELLIDO2,p.PER_APELLIDO2,NULL,' ') persona,
TI.TINV_NOMBRE AS VINCULACION,
'('||P.PER_EMAIL||')' AS EMAIL,
'Teléfono: '||P.PER_TELEFONO as telefono,
'Celular: '||P.PER_CELULAR as celular,
P.PER_FNACIMIENTO,
P.PER_PROFESION,
P.PER_NACIONALIDAD,
p.per_edad,
p.per_fech_titu_pregrado,
'Fecha título: '||p.per_fech_titu_pregrado as fecha_tit_preg,
p.per_promedio_pregrado,
'Promedio: '||p.per_promedio_pregrado as promedio,
ciu.ciu_nombre as ciudad,
p.per_resumen_hdv,
p.PER_FACULTAD_PREGRADO
FROM HER_PROYECTO PRY
LEFT JOIN HER_INVESTIGADOR_PROYECTO IP ON PRY.PRY_ID = IP.PRY_ID
LEFT JOIN HER_PERSONA P ON P.PER_ID = IP.INV_ID AND P.TDO_ID = IP.TDO_ID
LEFT JOIN HER_CIUDAD CIU ON CIU.CIU_ID = P.CIU_NACIMIENTO_ID
LEFT JOIN HER_TIPO_INVESTIGADOR TI ON TI.TINV_ID = IP.INP_TIPO
WHERE PRY.PRY_ID = ?
AND IP.INP_TIPO IN ('SEMC','JIPO','JIEU','EPRS')
AND IP.INV_ID NOT IN (SELECT TIN.TINV_DOCUMENTO FROM HER_TIPO_INVESTIGADOR TIN WHERE TIN.TINV_DOCUMENTO is not null)</property>
        </oda-data-set>
        <oda-data-set extensionID="org.eclipse.birt.report.data.oda.jdbc.JdbcSelectDataSet" name="4-integrantes-desconocidos" id="10760">

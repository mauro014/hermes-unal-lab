            <property name="queryText">select conv.con_restriccion, concat(concat( to_char(PRY_ASIGNATURA_NOMBRE), ' - '),( select dd.NOMBRE_PROBLEMA
from HER_EXT_PREINSCRIPCION_ECP dd
where to_char(dd.ID_PRE) = to_char(PRY_ASIGNATURA_NOMBRE))) PRY_PROB_INNV_SOC,
replace(replace(replace (replace (PRY_EXT_SOL_VIABILIDAD, '~', '   ,   '), '&amp;', chr(10)),'>&lt;','  ,  '),'&lt;>', chr(10)) as viabilidad ,
PRY_SOS_NIVEL, 
PRY_SOS_POR_QUE_NIVEL,  
PRY_DESCRIPCION,
PRY_SOS_OBSERVACIONES,
replace(replace(replace (replace (PRY_SOS_ARTI_INICIATIVAS, '~','  ,  '), '&amp;', chr(10)),'>&lt;','  ,  '),'&lt;>', chr(10)) as artIniciativas ,
PRY_EXT_SOL_TRANSFERENCIA,
PRY_CONSIDERACIONES_ETICAS,
pry_metodologia,
PRY_MARCO_CONCEPTUAL_EXT_SOL,
PRY_CONDICION_ENTORNO_EXT_SOL,
PRY_PROC_TRANS_EXT_SOL,
PRY_PLANT_ROLES_EXT_SOL,
PRY_PARTI_COMUNIDAD_EXT_SOL,
pry_justificacion,
PRY_ATRIBUTOS_SOL_INNO_EXT_SOL,        
(select det.DOMDET_DESCRIPCION
from her_dominio dom, her_dominio_detalle det,HER_PROYECTO PRY
where dom.DOM_TIPO = 'CENTROS_PENSAMIENTO_EXT_SOL_2017'
and det.DOM_ID = dom.DOM_ID
and det.DOMDET_TIPO = pry.EJE_TEMATICO
AND PRY.PRY_ID = ?)CENTRO_PENSAMIENTO
from her_proyecto, her_convocatoria conv
where pry_id =?
and conv.con_id = mod_id
</property>
        </oda-data-set>
    </data-sets>

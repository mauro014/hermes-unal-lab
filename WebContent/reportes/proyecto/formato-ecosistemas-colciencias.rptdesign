            <property name="queryText">SELECT 	ff.FFI_DESCRIPCION as entidad,
        DECODE (ff.ffi_interna_externa, 'I', 'Interna',
                                        'E', 'Externa',
                                        'A', 'Inscripciones',
                                        'O', 'Interna',
                                        'OE','Externa','') tipo,
		    f.FIN_VALOR as efectivo,  F.FFE_VALOR_ESPECIE as especie
  FROM 	HER_FUENTE_FINANCIACION ff, 
        HER_FINANCIACION f
 WHERE 	ff.FFI_ID = f.FFI_ID 
   AND  (F.FFE_TIPO_ENTIDAD = 'P')
   AND	PRY_ID = ?
   AND (FIN_ES_LEGALIZACION IS NULL OR  FIN_ES_LEGALIZACION = 'NO')</property>

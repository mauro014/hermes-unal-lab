            <property name="queryText">SELECT AVAL.AVI_ID, 
PRY_AVAL.PRY_ID, 
PRY_AVAL.PRY_NOMBRE
FROM HER_PROYECTO PRY, HER_AVAL AVAL, HER_PROYECTO PRY_AVAL
WHERE PRY.PRY_AVAL_ASOC = AVAL.AVI_ID
AND AVAL.PRY_ID = PRY_AVAL.PRY_ID

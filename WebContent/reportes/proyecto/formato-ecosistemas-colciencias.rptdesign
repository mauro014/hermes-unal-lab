            <property name="queryText">select evaluador, email from (
SELECT 
PEV.PEV_NOMBRE||' '||PEV.PEV_APELLIDO1||' '||DECODE(PEV.PEV_APELLIDO2,PEV.PEV_APELLIDO2,PEV.PEV_APELLIDO2,NULL,' ')EVALUADOR,
PEV_EMAIL as email
FROM HER_POSIBLE_EVALUADOR PEV
WHERE PRY_ID = ?
union
SELECT 
p.PER_NOMBRE1||' '||DECODE(p.PER_NOMBRE2,p.PER_NOMBRE2,p.PER_NOMBRE2,NULL,' ')||' '||p.PER_APELLIDO1||' '||DECODE(p.PER_APELLIDO2,p.PER_APELLIDO2,p.PER_APELLIDO2,NULL,' ') EVALUADOR,
PER_EMAIL as email
FROM
HER_POSIBLE_EVALUADOR_INTERNO PEI, HER_PERSONA P, HER_PROYECTO PRY
WHERE
PEI.PRY_ID = PRY.PRY_ID  
AND PRY.PRY_ID = ?
AND PEI.INV_ID = P.PER_ID)
order by evaluador</property>
        </oda-data-set>

            <property name="queryText">SELECT 	ff.FFI_DESCRIPCION as entidad, 
DECODE (ff.ffi_interna_externa, 'I','Interna','E','Externa','A','Inscripciones','O','Interna','OE','Externa','') tipo,
(select dd.domdet_descripcion from her_dominio_detalle dd where dd.domdet_tipo = ff.ffe_cod_naturaleza) naturaleza, 
f.FIN_VALOR as valor, 
f.FFE_VALOR_ESPECIE as especie,    
(SELECT  SUM(g.gst_valor) 
FROM HER_GASTO g, HER_TIPO_RUBRO tr
WHERE g.fin_ID = f.fin_ID 
  AND ff.FFI_ID = f.FFI_ID 
  AND g.tru_id =tr.TRU_ID
  AND tr.TRU_ID NOT IN (93, 149, 150)
  AND  (F.FFE_TIPO_ENTIDAD = 'F' OR F.FFE_TIPO_ENTIDAD is null)
  AND (FIN_ES_LEGALIZACION IS NULL OR  FIN_ES_LEGALIZACION = 'NO')
) total_rubros_especie,
(SELECT  SUM(g.gst_valor2)
  FROM HER_GASTO g, 
       HER_TIPO_RUBRO tr
WHERE g.fin_ID = f.fin_ID 
  AND ff.FFI_ID = f.FFI_ID 
  AND g.tru_id =tr.TRU_ID
  AND tr.TRU_ID NOT IN (93, 149, 150)
  AND  (F.FFE_TIPO_ENTIDAD = 'F' OR F.FFE_TIPO_ENTIDAD is null)
  AND (FIN_ES_LEGALIZACION IS NULL OR  FIN_ES_LEGALIZACION = 'NO')
) total_rubros_efectivo,
(SELECT  SUM(g.gst_valor) 
FROM HER_GASTO g, HER_TIPO_RUBRO tr
WHERE g.fin_ID = f.fin_ID 
  AND ff.FFI_ID = f.FFI_ID 
  AND g.tru_id =tr.TRU_ID
  AND tr.TRU_ID NOT IN (93, 149, 150)
  AND  (F.FFE_TIPO_ENTIDAD = 'F' OR F.FFE_TIPO_ENTIDAD is null)
  AND (FIN_ES_LEGALIZACION IS NULL OR  FIN_ES_LEGALIZACION = 'NO')
) total_un_fin_basica
  FROM 	HER_FUENTE_FINANCIACION ff, 
        HER_FINANCIACION f
 WHERE 	ff.FFI_ID = f.FFI_ID 
   AND  (F.FFE_TIPO_ENTIDAD = 'F' OR F.FFE_TIPO_ENTIDAD is null)
   AND	PRY_ID = ?
   AND (FIN_ES_LEGALIZACION IS NULL OR  FIN_ES_LEGALIZACION = 'NO')
  ORDER BY ff.FFI_DESCRIPCION</property>
        </oda-data-set>

            </list-property>
            <property name="queryText">select pry.PRY_ID, 
PRY.PRY_TIENE_ACTIVO_PI, 
pry.PRY_ACTIVO_PI, 
det.DOMDET_DESCRIPCION AS ACTIVO
from her_proyecto pry, her_dominio dom, her_dominio_detalle det
where pry.PRY_ID = ?
and dom.DOM_TIPO = 'ACTIVO_PI'
and det.DOM_ID = dom.DOM_ID
and det.DOMDET_TIPO = pry.PRY_ACTIVO_PI
</property>
        </oda-data-set>

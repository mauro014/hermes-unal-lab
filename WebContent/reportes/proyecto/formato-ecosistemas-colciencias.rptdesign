            <list-property name="resultSet">
                <structure>
                    <property name="position">1</property>
                    <property name="name">VALOR_CONV</property>
                    <property name="nativeName">VALOR_CONV</property>
                    <property name="dataType">decimal</property>
                </structure>
                <structure>
                    <property name="position">2</property>
                    <property name="name">VALOR_ENTIDADES_PARTICIPANTES</property>
                    <property name="nativeName">VALOR_ENTIDADES_PARTICIPANTES</property>
                    <property name="dataType">decimal</property>
                </structure>
            </list-property>
            <property name="queryText">SELECT 
PRY.PRY_VALOR_SOLICITADO AS VALOR_CONV, 
(SELECT nvl(SUM(F.FFE_VALOR_ESPECIE),0) + nvl(SUM(F.FIN_VALOR),0)
FROM HER_FUENTE_FINANCIACION ff, HER_FINANCIACION f, HER_DOMINIO_DETALLE DD
WHERE ff.FFI_ID = f.FFI_ID 
AND F.FFE_TIPO_ENTIDAD &lt;> 'F'
AND DD.DOM_ID = 129
AND DD.DOMDET_TIPO = F.FFE_TIPO_ENTIDAD
AND f.PRY_ID = pry.pry_id)valor_entidades_participantes
FROM HER_PROYECTO PRY
WHERE PRY.PRY_ID = ?</property>
        </oda-data-set>

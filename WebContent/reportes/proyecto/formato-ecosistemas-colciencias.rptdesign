            <property name="queryText">SELECT CONV.CON_RESTRICCION, LISV.VAL_TIPO, LISV.VAL_VALOR, LISV.VAL_DESCRIPCION 
FROM HER_PROYECTO PRY, HER_CONVOCATORIA CONV, HER_PROYECTO_LISTAS_VAL LISV
WHERE PRY.PRY_ID = ?
AND PRY.MOD_ID = CONV.CON_ID
AND LISV.PRY_ID = PRY.PRY_ID
AND LISV.VAL_TIPO = 'INDICADORES_APROPIACION_EXT_SOL'</property>
        </oda-data-set>

            <property name="queryText">select distinct cp.cnp_titulo as convocatoria,
c.con_titulo as modalidad,
c.CON_MOSTRAR_ACT_INVESTIGADOR as mostrar_funciones,
C.CON_MOSTRAR_DESCR_PROBLEMA as mostrar_problema, 
C.CON_MOSTRAR_BIODIVERSIDAD as mostrar_biodiversidad,
CP.CNP_MOSTRAR_PI as mostrar_pi,
fie.mod_id as tieneFormularioEsp,
c.con_restriccion as restriccion,
c.con_tipo_financiacion as tipoFinanciacion,
c.con_id as mod_convocatoria,
C.CON_ACTI_OBJ_METAS as mostrar_act_obj_meta,
C.CON_MOSTRAR_PRODUCTOS AS mostrar_productos,
fie.FIE_OBJ_RESUL_RESPON AS mostrar_obj_resp,
fie.FIE_ASIGNATURA as mostrar_asignatura,
fie.FIE_LUGAR_EJECUCION as mostrarLugarEje,
pry.PRY_DIRECTOR_EXTERNO,
c.CON_MOSTRAR_RESULTADOS AS mostrar_resultados,
tin_id,
mo.tmo_id
from her_proyecto pry, her_convocatoria_padre cp, her_convocatoria c 
left join her_formulario_info_especifica fie on fie.mod_id = c.con_id
left join her_modalidad mo on mo.mod_id = c.con_id
where pry.pry_id = ?
and pry.mod_id = c.con_id
and c.cnp_id = cp.cnp_id

</property>
        </oda-data-set>

            <property name="queryText">SELECT
(SELECT nvl(SUM (nvl(f.FIN_VALOR,0)),0) + nvl(SUM(nvl(F.FFE_VALOR_ESPECIE,0)),0)
  FROM 	HER_FUENTE_FINANCIACION ff, 
        HER_FINANCIACION f
 WHERE 	ff.FFI_ID = f.FFI_ID 
   AND  (F.FFE_TIPO_ENTIDAD = 'F' OR F.FFE_TIPO_ENTIDAD is null)
    AND FF.FFI_INTERNA_EXTERNA = 'E'
    AND (FIN_ES_LEGALIZACION IS NULL OR  FIN_ES_LEGALIZACION = 'NO')
    AND F.PRY_ID = PRY.PRY_ID)total_externo,
(SELECT nvl(SUM (f.FIN_VALOR),0)+nvl(SUM(F.FFE_VALOR_ESPECIE),0)
  FROM 	HER_FUENTE_FINANCIACION ff, 
        HER_FINANCIACION f
 WHERE 	ff.FFI_ID = f.FFI_ID 
   AND  (F.FFE_TIPO_ENTIDAD = 'P')
   AND (FIN_ES_LEGALIZACION IS NULL OR  FIN_ES_LEGALIZACION = 'NO')
   AND F.PRY_ID = PRY.PRY_ID)total_participantes,
(SELECT SUM (nvl(F.FFE_VALOR_ESPECIE,0))
  FROM  HER_FUENTE_FINANCIACION ff, 
        HER_FINANCIACION f
  WHERE ff.FFI_ID = f.FFI_ID 
   AND  (F.FFE_TIPO_ENTIDAD = 'E')
   AND (FIN_ES_LEGALIZACION IS NULL OR  FIN_ES_LEGALIZACION = 'NO')
   AND F.PRY_ID = PRY.PRY_ID) AS total_especie_ext,
pry.PRY_VALOR_PERSONAL VALOR_PERSONAL_DOCENTE,
pry.PRY_CONTRAP_EFECTIVO, PRY_CONTRAP_ESPECIE, 
pry.PRY_ADM_TOTAL VALOR_PERSONAL_ADMINISTRATIVO
FROM HER_PROYECTO pry
WHERE pry.PRY_ID = ?</property>
        </oda-data-set>
        <oda-data-set extensionID="org.eclipse.birt.report.data.oda.jdbc.JdbcSelectDataSet" name="8-totales-financiacion-corredor" id="14148">

                <structure>
                    <property name="position">1</property>
                    <property name="name">VINCULACION</property>
                    <property name="nativeName">VINCULACION</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">2</property>
                    <property name="name">CANTIDAD</property>
                    <property name="nativeName">CANTIDAD</property>
                    <property name="dataType">decimal</property>
                </structure>
                <structure>
                    <property name="position">3</property>
                    <property name="name">FUNCION</property>
                    <property name="nativeName">FUNCION</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">4</property>
                    <property name="name">MOSTRAR_ACT</property>
                    <property name="nativeName">MOSTRAR_ACT</property>
                    <property name="dataType">decimal</property>
                </structure>
            </list-property>
            <property name="queryText">SELECT TI.TINV_NOMBRE AS VINCULACION,
IP.INP_DEDICACION_HORAS_SEMANA AS CANTIDAD, decode(IP.INP_FUNCION,null,'No disponible',IP.INP_FUNCION) as FUNCION, CONV.CON_MOSTRAR_ACT_INVESTIGADOR_N AS MOSTRAR_ACT
FROM HER_PROYECTO PRY
LEFT JOIN HER_INVESTIGADOR_PROYECTO IP ON PRY.PRY_ID = IP.PRY_ID
LEFT JOIN HER_TIPO_INVESTIGADOR TI ON TI.TINV_ID = IP.INP_TIPO
LEFT JOIN HER_CONVOCATORIA CONV ON PRY.MOD_ID = CONV.CON_ID
WHERE PRY.PRY_ID = ?
AND IP.INP_TIPO &lt;> 'P'
AND IP.INV_ID IN (SELECT TIN.TINV_DOCUMENTO FROM HER_TIPO_INVESTIGADOR TIN WHERE TIN.TINV_DOCUMENTO is not null)
</property>
        </oda-data-set>

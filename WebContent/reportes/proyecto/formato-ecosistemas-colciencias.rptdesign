            <property name="queryText">SELECT pry.pry_abstract as resumen,
pry.PRY_OBJETIVO_GENERAL as objetivo_general,
pry.PRY_METODOLOGIA as metodologia,
pry.PRY_JUSTIFICACION as justificacion,
pry.pry_descripcion,
pry.PRY_MARCO_TEORICO as marco_teorico, 
pry.PRY_ANTECEDENTES as antecedentes,
pry.PRY_IMPACTO_ESPERADO as impacto_esperado,
pry.PRY_CONSIDERACIONES_ETICAS as consideraciones_eticas,
pry.LINEA_BASE_PROYECTO as linea_base_pry,
decode(pry.PRY_TIENE_PRY, '0','No','1','Si') as tiene_proyecto_asociado,
pry.PRY_PRY_ASOCIADO as proyectoAsociado,
(select dd.DOMDET_DESCRIPCION from HER_DOMINIO_DETALLE dd where dd.domdet_tipo = pry.PRY_ROL_UNIVERSIDAD and dd.dom_id = 55 ) ROL_UNIV,
(select dd2.DOMDET_DESCRIPCION from HER_DOMINIO_DETALLE dd2 where dd2.domdet_tipo = pry.PRY_MECANISMO_PARTI and dd2.dom_id = 56 ) MECAN_PART,
pry.PRY_OBSERVACIONES, pry.PRY_SOS_OBSERVACIONES
FROM HER_PROYECTO PRY
WHERE PRY.PRY_ID = ?</property>
        </oda-data-set>

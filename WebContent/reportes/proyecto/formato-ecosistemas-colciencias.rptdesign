            <property name="queryText"> select conv.con_restriccion,(select dd.NOMBRE_PROBLEMA
           from HER_EXT_PREINSCRIPCION_ECP dd
          where to_char(dd.ID_PRE) = to_char(PRY_ASIGNATURA_NOMBRE)) PRY_PROB_INNV_SOC,
 		PRY_SOS_NIVEL, 
        PRY_SOS_POR_QUE_NIVEL,  
        PRY_SOS_POR_QUE_CONTINUIDAD,
        replace(replace(replace (replace (PRY_SOS_ARTI_INICIATIVAS, '~','  ,  '), '&amp;', chr(10)),'>&lt;','  ,  '),'&lt;>', chr(10)) as artIniciativas ,
        PRY_SOS_ALIADOS, 
        PRY_SOS_OBSERVACIONES,
        replace(replace(replace (replace (PRY_EXT_SOL_VIABILIDAD, '~', '   ,   '), '&amp;', chr(10)),'>&lt;','  ,  '),'&lt;>', chr(10)) as viabilidad ,
        replace(replace(replace (replace (PRY_EXT_SOL_APROPIACION, '~', '   ,   '), '&amp;', chr(10)),'>&lt;', '  ,  '),'&lt;>', chr(10)) as apropiacion ,
        PRY_EXT_SOL_TRANSFERENCIA,
        pry_metodologia,
        pry_justificacion,
        pry_consideraciones_eticas,
        pry_impacto_esperado,
        pry_descripcion,
        (select det.DOMDET_DESCRIPCION from 
her_dominio dom, her_dominio_detalle det, her_proyecto pry where dom.DOM_ID = det.DOM_ID and dom.DOM_TIPO = 'ENFO_CONV_EXT_SOL_2016' and det.DOMDET_TIPO = to_char(pry.PRY_CLASE_EVENTO) and pry.PRY_ID = ?)enfoque,
(select det.DOMDET_DESCRIPCION from 
her_dominio dom, her_dominio_detalle det, her_proyecto pry where dom.DOM_ID = det.DOM_ID and dom.DOM_TIPO = 'PROY_CONVS_EXT_SOL_2016' and det.DOMDET_TIPO = to_char(pry.PRY_CODIGO_DIB) and pry.PRY_ID = ?)pry_continua
  from her_proyecto, her_convocatoria conv
 where pry_id =?
 and conv.con_id = mod_id</property>
        </oda-data-set>
        <oda-data-set extensionID="org.eclipse.birt.report.data.oda.jdbc.JdbcSelectDataSet" name="9-info-especifica-colecciones" id="13922">

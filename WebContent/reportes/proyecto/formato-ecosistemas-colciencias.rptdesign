            <property name="queryText">SELECT 
DECODE(COL.TCOL_TRAYECTORIA, 'A','Como referente internacional','B','Como referente nacional','C','Como referente en la Universidad Nacional de Colombia','D','Cuenta con ejemplares tipo o de valor histórico','') AS TRAYECTORIA, 
COL.TCOL_DESCRIPCION AS DESCRIPCION
FROM HER_COLECCION_TRAYECTORIA_PRY COL, HER_PROYECTO PRY
WHERE PRY.PRY_ID = ?
AND PRY.PRY_ID = COL.PRY_ID
order by COL.TCOL_TRAYECTORIA</property>
        </oda-data-set>

                    <property name="dataType">string</property>
                </structure>
            </list-property>
            <property name="queryText">SELECT GRU.GRU_ID, per.tdo_id || ' - ' ||per.per_ID as identificacion, 
PER.PER_APELLIDO1||' '||DECODE(PER.PER_APELLIDO2, PER.PER_APELLIDO2,PER.PER_APELLIDO2,NULL,' ')||' '||PER.PER_NOMBRE1||' '||DECODE(PER.PER_NOMBRE2, PER.PER_NOMBRE2,PER.PER_NOMBRE2,NULL,' ')INTEGRANTE,
decode(DPN.DPN_NOMBRE,null,INS.INS_NOMBRE,DPN.DPN_NOMBRE) as unidad
FROM HER_GRUPO GRU, HER_GRUPO_PROYECTO GRP, 
HER_PROYECTO PRY, 
HER_INVESTIGADOR_GRUPO ING
left join HER_INVESTIGADOR_INTERNO INI on ING.INV_ID = INI.INV_ID
left join HER_DEPENDENCIA DPN on INI.DPN_ID = DPN.DPN_ID
left join HER_PERSONA PER on PER.PER_ID = ING.INV_ID
left join HER_INVESTIGADOR_EXTERNO INE on PER.PER_ID = INE.INV_ID
left join HER_INSTITUCION INS on INS.INS_ID = INE.INS_ID
WHERE PRY.PRY_ID = ?
AND GRP.PRY_ID = PRY.PRY_ID
AND GRU.GRU_ID = GRP.GRU_ID
AND GRU.GRU_ID = ING.GRU_ID</property>
        </oda-data-set>

            <property name="queryText">SELECT AREA.DOMDET_DESCRIPCION as AreaPrincipal, DET.DOMDET_DESCRIPCION as AreaSecundaria
FROM HER_PROYECTO PRY
left join HER_PROYECTO_AREA_TEMATICA TEM on PRY.PRY_ID = TEM.PRY_ID
left join HER_DOMINIO_DETALLE DET ON DET.DOMDET_TIPO = TEM.DOMDET_TIPO AND DET.DOM_ID = TEM.DOM_ID
left join HER_DOMINIO_DETALLE AREA on AREA.DOMDET_TIPO = DET.DOMDET_ESTADO
WHERE PRY.PRY_ID = ?
AND TEM.ART_TIPO = '1'</property>
        </oda-data-set>

                    <property name="nativeName">RESPONSABLE</property>
                    <property name="dataType">string</property>
                </structure>
            </list-property>
            <property name="queryText">SELECT ESP.OBJ_DESCRIPCION AS OBJETIVO, 
OBJ.ACT_DESCRIPCION AS META, 
PER.PER_NOMBRE1||' '||DECODE(PER.PER_NOMBRE2, PER.PER_NOMBRE2,PER.PER_NOMBRE2,NULL,' ')||' '||PER.PER_APELLIDO1||' '||DECODE(PER.PER_APELLIDO2, PER.PER_APELLIDO2,PER.PER_APELLIDO2,NULL,' ') RESPONSABLE
FROM HER_OBJ_ESP_ACTIVIDAD OBJ, HER_OBJETIVO_ESPECIFICO ESP, HER_PROYECTO PRY, HER_PERSONA PER
WHERE PRY.PRY_ID = OBJ.PRY_ID
AND OBJ.OBJ_ID = ESP.OBJ_ID
AND PER.PER_ID = OBJ.INV_ID
AND PER.TDO_ID = OBJ.TDO_ID
AND PRY.PRY_ID = ?
order by ESP.OBJ_DESCRIPCION asc</property>
        </oda-data-set>

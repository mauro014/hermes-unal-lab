            <property name="queryText">select PER.TDO_ID|| ' - '||PER.PER_ID AS DOCUMENTO, 
PER.PER_NOMBRE1||' '||DECODE(PER.PER_NOMBRE2, PER.PER_NOMBRE2,PER.PER_NOMBRE2,NULL,' ')||' '||PER.PER_APELLIDO1||' '||DECODE(PER.PER_APELLIDO2, PER.PER_APELLIDO2,PER.PER_APELLIDO2,NULL,' ')DIRECTOR,
INP.INP_DEDICACION_HORAS_SEMANA AS DEDICACION_SEMANAL,
PER.PER_EMAIL AS EMAIL, 
PER.PER_TELEFONO AS TELEFONO,
PER.PER_DIRECCION AS DIRECCION,
D.DPN_NOMBRE AS DEPARTAMENTO,
FAC.DPN_NOMBRE AS FACULTAD,
S.SED_NOMBRE AS SEDE,
INP.INP_FUNCION AS FUNCION,
INP.INP_VALOR_PAGAR AS VALOR_DEDICACION,
pry.pry_nombre,
CP.CNP_TITULO,
'Yo '||PER.PER_NOMBRE1||' '||DECODE(PER.PER_NOMBRE2, PER.PER_NOMBRE2,PER.PER_NOMBRE2,NULL,' ')||' '||PER.PER_APELLIDO1||' '||DECODE(PER.PER_APELLIDO2, PER.PER_APELLIDO2,PER.PER_APELLIDO2,NULL,' ')||
', investigador(a) principal del proyecto "'||pry.pry_nombre||'" declaro: ' as declaracion,
'- Conozco los términos de referencia de la convocatoria "'||CP.CNP_TITULO||'".' as clausula_convocatoria,
'- Que junto con todos los participantes de este proyecto aceptamos y cumplimos todos los requisitos estipulados en los términos de referencia y 
renunciamos a cualquier reclamación por ignorancia o errónea interpretación de estos documentos' as clausula_adicional
from HER_PROYECTO PRY
left join HER_INVESTIGADOR_PROYECTO INP ON PRY.PRY_ID=INP.PRY_ID and INP.INP_TIPO ='P'
left join HER_PERSONA PER ON PER.PER_ID = INP.INV_ID AND PER.TDO_ID = INP.TDO_ID
left join HER_INVESTIGADOR_INTERNO II ON II.INV_ID = PER.PER_ID AND II.TDO_ID = PER.TDO_ID
left join HER_DEPENDENCIA D ON D.DPN_ID = II.DPN_ID
left join HER_DEPENDENCIA FAC ON FAC.DPN_ID = D.DPN_FACULTAD
left join HER_SEDE S ON S.SED_ID = FAC.SED_ID
left join HER_CONVOCATORIA C ON PRY.MOD_ID = C.CON_ID
left join HER_CONVOCATORIA_PADRE CP ON C.CNP_ID = CP.CNP_ID
where PRY.PRY_ID = ?
</property>
        </oda-data-set>

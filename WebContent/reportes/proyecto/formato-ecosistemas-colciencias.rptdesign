            <property name="queryText">SELECT AREA.DOMDET_DESCRIPCION as AreaPrincipal, DET.DOMDET_DESCRIPCION as AreaSecundaria
FROM HER_PROYECTO_AREA_TEMATICA TEM, HER_PROYECTO PRY, HER_DOMINIO_DETALLE DET, HER_DOMINIO_DETALLE AREA
WHERE PRY.PRY_ID = ?
AND PRY.PRY_ID = TEM.PRY_ID
AND TEM.ART_TIPO = '3'
AND DET.DOM_ID = TEM.DOM_ID
AND DET.DOMDET_TIPO = TEM.DOMDET_TIPO
AND AREA.DOMDET_TIPO = DET.DOMDET_ESTADO</property>
        </oda-data-set>

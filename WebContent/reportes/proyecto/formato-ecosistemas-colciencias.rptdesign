            <property name="queryText">select det.DOMDET_DESCRIPCION as linea, 
pg.pgd_descripcion as nombre_plan, 
(select det.DOMDET_DESCRIPCION from her_dominio_detalle det, her_proyecto pry where det.DOM_ID = 67 and det.DOMDET_TIPO = pry.PRY_PROGRAMA and pry.PRY_ID = ?)programa
from her_dominio_detalle det, her_proyecto pry, her_plan_global_desarrollo pg 
where det.DOM_ID = 71 
and det.DOMDET_TIPO = pry.PRY_LINEA_ACCION 
and det.domdet_observacion = pg.pgd_periodo
and pry.PRY_ID = ?</property>
        </oda-data-set>

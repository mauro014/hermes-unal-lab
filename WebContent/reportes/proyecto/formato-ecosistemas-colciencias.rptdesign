            <property name="queryText">SELECT 
pry.PRY_METODOLOGIA as metodologia,
pry.PRY_JUSTIFICACION as justificacion,
INFOES.FIE_CAMPO_1, INFOES.FIE_CAMPO_1_TEXTO, 
INFOES.FIE_CAMPO_2, INFOES.FIE_CAMPO_2_TEXTO,
INFOES.FIE_CAMPO_3, INFOES.FIE_CAMPO_3_TEXTO, 
INFOES.FIE_CAMPO_4, INFOES.FIE_CAMPO_4_TEXTO, 
INFOES.FIE_CAMPO_5, INFOES.FIE_CAMPO_5_TEXTO, 
INFOES.FIE_CAMPO_6, INFOES.FIE_CAMPO_6_TEXTO,
INFOES.FIE_CAMPO_7, INFOES.FIE_CAMPO_7_TEXTO,
INFOES.FIE_LISTA_SELECCION, INFOES.FIE_TEXTO_LISTA_SELECCION,
INFOES.FIE_LISTA_SELECCION_2, INFOES.FIE_TEXTO_LISTA_SELECCION_2,
pry.pry_descripcion,
pry.PRY_MARCO_TEORICO as marco_teorico, 
pry.PRY_ANTECEDENTES as antecedentes,
pry.PRY_IMPACTO_ESPERADO as impacto_esperado,
pry.PRY_CONSIDERACIONES_ETICAS as consideraciones_eticas,
pry.LINEA_BASE_PROYECTO as linea_base_pry,
pry.PRY_EXT_SOL_TRANSFERENCIA as campo6,
pry.PRY_EXT_SOL_APROPIACION as apropiacion_campo7,
pry.PRY_SOS_OBSERVACIONES,
asig.COD_ASIGNATURA ||' - '||asig.nmbre_ASIGNATURA AS CODIGO_Y_ASIGNATURA,
asig.nmbre_ASIGNATURA AS ASIGNATURA,
(select det.DOMDET_DESCRIPCION
from her_dominio dom, her_dominio_detalle det,HER_FORMULARIO_INFO_ESPECIFICA esp
where dom.DOM_TIPO = (SELECT INFOES.FIE_DOM_LISTA_SELECCION FROM HER_FORMULARIO_INFO_ESPECIFICA INFOES WHERE INFOES.MOD_ID = PRY.MOD_ID)
and det.DOM_ID = dom.DOM_ID
and det.DOMDET_TIPO = pry.EJE_TEMATICO
AND PRY.MOD_ID = ESP.MOD_ID)lista_sel_1,
(select det.DOMDET_DESCRIPCION
from her_dominio dom, her_dominio_detalle det,HER_FORMULARIO_INFO_ESPECIFICA esp
where dom.DOM_TIPO = (SELECT INFOES.FIE_DOM_LISTA_SELECCION_2 FROM HER_FORMULARIO_INFO_ESPECIFICA INFOES WHERE INFOES.MOD_ID = PRY.MOD_ID)
and det.DOM_ID = dom.DOM_ID
and det.DOMDET_TIPO = pry.PRY_SERVICIOS
AND PRY.MOD_ID = ESP.MOD_ID)lista_sel_2,
col.COL_NOMBRE AS COLECCION,
Lab.LAB_NOMBRE  AS LABORATORIO,
PRY.pry_asignatura_nombre,
PRY.pry_observaciones,
pry.pry_entidades_participantes,
pry.PRY_PRESENTACION_PROGRAMA,
pry.pry_propiedad_intelectual,
PRN.PRN_ANTECEDENTES
FROM HER_PROYECTO PRY left join sia_v_asignaturas_hermes asig on asig.ASI_ID = PRY.PRY_ASIGNATURA
LEFT JOIN HER_FORMULARIO_INFO_ESPECIFICA INFOES ON PRY.MOD_ID = INFOES.MOD_ID
LEFT JOIN HER_COLECCION COL ON to_char(COL.COL_ID) = pry.EJE_TEMATICO
LEFT JOIN HER_LABORATORIO LAB ON pry.PRY_SOS_ALIADOS = TO_CHAR(lab.LAB_ID)
LEFT JOIN HER_PROGRAMA_NACIONAL_PRN PRN ON PRN.PRY_ID = PRY.PRY_ID
WHERE PRY.PRY_ID = ?

</property>
        </oda-data-set>
        <oda-data-set extensionID="org.eclipse.birt.report.data.oda.jdbc.JdbcSelectDataSet" name="9-info-especifica-ciudades" id="14062">

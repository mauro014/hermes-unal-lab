                    <property name="name">MES_INICIAL</property>
                    <property name="nativeName">MES_INICIAL</property>
                    <property name="dataType">decimal</property>
                </structure>
                <structure>
                    <property name="position">5</property>
                    <property name="name">DURACION</property>
                    <property name="nativeName">DURACION</property>
                    <property name="dataType">decimal</property>
                </structure>
                <structure>
                    <property name="position">6</property>
                    <property name="name">META</property>
                    <property name="nativeName">META</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">7</property>
                    <property name="name">OBJETIVO</property>
                    <property name="nativeName">OBJETIVO</property>
                    <property name="dataType">string</property>
                </structure>
            </list-property>
            <property name="queryText">SELECT ROWNUM,
ACT_DESCRIPCION as actividad,
substr(ACT_DESCRIPCION,1,200),
(ACT_SEMANA_INICIAL+3)/4 as mes_inicial, 
(ACT_DURACION_SEMANAS)/4 as duracion,
A.ACT_META AS META, 
OBJ.OBJ_DESCRIPCION as objetivo
FROM HER_PROYECTO pry, 
HER_ACTIVIDAD A left join HER_OBJETIVO_ESPECIFICO OBJ 
on OBJ.OBJ_ID = A.ACT_OBJETIVO_ESP
WHERE pry.pry_id = ?
AND pry.PRY_ID=A.PRY_ID
ORDER BY mes_inicial
</property>
        </oda-data-set>

                        <property name="name">VAL_DESCRIPCION</property>
                        <property name="dataType">string</property>
                    </structure>
                    <structure>
                        <property name="position">5</property>
                        <property name="name">VAL_DESCRIPCION2</property>
                        <property name="dataType">string</property>
                    </structure>
                    <structure>
                        <property name="position">6</property>
                        <property name="name">VAL_DESCRIPCION3</property>
                        <property name="dataType">string</property>
                    </structure>
                </list-property>
            </structure>
            <property name="dataSource">Data Source</property>
            <list-property name="parameters">
                <structure>
                    <property name="name">id</property>
                    <property name="paramName">id</property>
                    <property name="dataType">string</property>
                    <property name="position">1</property>
                    <property name="isInput">true</property>
                    <property name="isOutput">false</property>
                </structure>
            </list-property>
            <list-property name="resultSet">
                <structure>
                    <property name="position">1</property>
                    <property name="name">CON_RESTRICCION</property>
                    <property name="nativeName">CON_RESTRICCION</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">2</property>
                    <property name="name">VAL_TIPO</property>
                    <property name="nativeName">VAL_TIPO</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">3</property>
                    <property name="name">VAL_VALOR</property>
                    <property name="nativeName">VAL_VALOR</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">4</property>
                    <property name="name">VAL_DESCRIPCION</property>
                    <property name="nativeName">VAL_DESCRIPCION</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">5</property>
                    <property name="name">VAL_DESCRIPCION2</property>
                    <property name="nativeName">VAL_DESCRIPCION2</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">6</property>
                    <property name="name">VAL_DESCRIPCION3</property>
                    <property name="nativeName">VAL_DESCRIPCION3</property>
                    <property name="dataType">string</property>
                </structure>
            </list-property>
            <property name="queryText">SELECT CONV.CON_RESTRICCION, LISV.VAL_TIPO, LISV.VAL_VALOR, LISV.VAL_DESCRIPCION, LISV.VAL_DESCRIPCION2, LISV.VAL_DESCRIPCION3 
FROM HER_PROYECTO PRY, HER_CONVOCATORIA CONV, HER_PROYECTO_LISTAS_VAL LISV
WHERE PRY.PRY_ID = ?
AND PRY.MOD_ID = CONV.CON_ID
AND LISV.PRY_ID = PRY.PRY_ID
AND LISV.VAL_TIPO = 'COMUNIDAD_ETNICA_EXT_SOL'</property>
        </oda-data-set>

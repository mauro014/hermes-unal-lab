                </structure>
            </list-property>
            <property name="queryText">SELECT G.GRU_COLCIENCIAS, G.GRU_NOMBRE, G.GRU_ENLACE_GRUPLAC AS GRUPLAC, PRN.GRU_ID AS GPRN,
d.dpn_nombre as dpn, gc.grc_nombre as cat_col, sed.sed_nombre, IG.ING_TIPO, PER.PER_NOMBRE1||' '||DECODE(PER.PER_NOMBRE2, PER.PER_NOMBRE2,PER.PER_NOMBRE2,NULL,' ')||' '||PER.PER_APELLIDO1||' '||DECODE(PER.PER_APELLIDO2, PER.PER_APELLIDO2,PER.PER_APELLIDO2,NULL,' ')PRINCIPAL
FROM HER_PROYECTO p
left join HER_GRUPO_PROYECTO GP on gp.PRY_ID = p.pry_id
left join HER_GRUPO G on G.GRU_ID = GP.GRU_ID
left join HER_PROGRAMA_NACIONAL_PRN PRN on G.GRU_ID = PRN.GRU_ID AND PRN.PRY_ID = P.PRY_ID
left join her_dependencia d on g.dpn_id = d.dpn_id
left join HER_GRUPO_CATEGORIA GC on gc.GRC_ID = G.GRU_CATEGORIA_COLCIENCIAS
left join HER_SEDE sed on sed.sed_id = d.SED_ID
left join HER_INVESTIGADOR_GRUPO IG ON IG.GRU_ID = G.GRU_ID AND IG.ING_TIPO = 'L'
left join HER_PERSONA PER ON PER.PER_ID = IG.INV_ID AND PER.TDO_ID = IG.TDO_ID
WHERE p.pry_id = ?
ORDER BY GPRN,G.GRU_NOMBRE ASC</property>

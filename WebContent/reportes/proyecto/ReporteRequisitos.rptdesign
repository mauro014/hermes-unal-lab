                    <property name="nativeName">NOMBRE_DIRECTOR</property>
                    <property name="dataType">string</property>
                </structure>
            </list-property>
            <property name="queryText">SELECT  TDO.TDO_NOMBRE , PER.PER_ID,  PER.PER_NOMBRE1 ||' '||PER.PER_NOMBRE2||' '||PER.PER_APELLIDO1||' '||PER.PER_APELLIDO2 nombre_director
FROM HER_PROYECTO PRY, HER_INVESTIGADOR_PROYECTO INP , HER_PERSONA PER, HER_TIPO_DOCUMENTO TDO 
WHERE PRY.PRY_ID = ?
AND PER.PER_ID  = INP.INV_ID
AND PER.PER_ID  = INP.TDO_ID
AND PRY.PRY_ID = INP.PRY_ID
AND PER.TDO_ID = TDO.TDO_ID
AND INP.INP_TIPO = 'P'</property>

                </list-property>
            </structure>
            <property name="dataSource">HermesPruebas</property>
            <list-property name="parameters">
                <structure>
                    <property name="name">param_1</property>
                    <property name="paramName">id</property>
                    <property name="dataType">string</property>
                    <property name="position">1</property>
                    <property name="isInput">true</property>
                    <property name="isOutput">false</property>
                </structure>
            </list-property>
            <list-property name="resultSet">
                <structure>
                    <property name="position">1</property>
                    <property name="name">RESPONSABLE_NOMBRE</property>
                    <property name="nativeName">RESPONSABLE_NOMBRE</property>
                    <property name="dataType">string</property>
                </structure>
            </list-property>
            <property name="queryText">SELECT DISTINCT P.PER_NOMBRE1 || ' ' || P.PER_NOMBRE2 || ' ' || P.PER_APELLIDO1 || ' ' ||  PER_APELLIDO2 RESPONSABLE_NOMBRE FROM
HER_PROYECTO_REQUISITO PR, HER_PERSONA P
WHERE PR.PRY_ID = ?
AND PR.REQ_RESPONSABLE_ID = P.PER_ID
AND PR.REQ_RESPONSABLE_TDO_ID = P.TDO_ID</property>

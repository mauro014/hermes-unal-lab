            <property name="queryText">SELECT CNP_TITULO, CON_TITULO
 FROM HER_CONVOCATORIA_PADRE CP, HER_CONVOCATORIA C, HER_PROYECTO P
 WHERE CP.CNP_ID = C.CNP_ID
 AND C.CON_ID= P.MOD_ID
 AND P.PRY_ID = ?</property>

            <property name="queryText">SELECT  PRY.PRY_ID, sed_nombre, DPN1.DPN_NOMBRE, DPN.DPN_NOMBRE,
PRY.PRY_NOMBRE, PER_APELLIDO1||' '|| PER_APELLIDO2||' '|| PER_NOMBRE1||' '||  PER_NOMBRE2 Principal
FROM HER_PROYECTO PRY,
HER_INVESTIGADOR_INTERNO INI, HER_PERSONA PER, HER_DEPENDENCIA DPN, 
HER_INVESTIGADOR_PROYECTO INP, HER_DEPENDENCIA DPN1, HER_SEDE SED
WHERE  PRY.PRY_ID = INP.PRY_ID
AND INP.INV_ID = INI.INV_ID
AND INP.TDO_ID = INI.TDO_ID
AND INP.INV_ID = PER.PER_ID
AND INP.TDO_ID = PER.TDO_ID
AND  SUBSTR(INI.DPN_ID,1,1)= SED.SED_ID 
AND  DPN.DPN_ID = INI.DPN_ID
AND  DPN.DPN_ID_2 = DPN1.DPN_ID
AND INP.INP_TIPO = 'P'
AND PRY.pry_ID = ?
and epr_id &lt;> 'B'</property>

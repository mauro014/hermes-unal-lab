            <list-property name="resultSet">
                <structure>
                    <property name="position">1</property>
                    <property name="name">TDO_NOMBRE</property>
                    <property name="nativeName">TDO_NOMBRE</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">2</property>
                    <property name="name">PER_ID</property>
                    <property name="nativeName">PER_ID</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">3</property>

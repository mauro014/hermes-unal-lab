            <property name="queryText">select PRY2.PRY_NOMBRE, pry.PRY_CODIGO_DIB, pry.MOD_ID
  from HER_PROYECTO PRY, her_proyecto pry2
 where pry.PRY_CODIGO_DIB = pry2.pry_id
   and PRY.PRY_ID = ?</property>

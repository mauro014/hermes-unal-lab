            <property name="queryText">SELECT DECODE( p.PRY_PMAR_AG, 1, 'Investigación científica',2,'Recolección de especímenes para fines docentes.','') AMBITO,
 decode (col.col_nombre,null,DD.DOMDET_DESCRIPCION,col.col_nombre)COLECCION, PRY_PMAR_CT FAMILIA,
 PRY_PMAR_NCB noColeccion, 
 DECODE (SUBSTR( P.PRY_PMAR_OP, 1, 1 ),'S', 'SI','N','NO','') OPCION1, 
 DECODE (SUBSTR( P.PRY_PMAR_OP, 2, 1 ),'S', 'SI','N','NO','') OPCION2, 
 DECODE (SUBSTR( P.PRY_PMAR_OP, 3, 1 ),'S', 'SI','N','NO','') OPCION3, 
 DECODE (SUBSTR( P.PRY_PMAR_OP, 4, 1 ),'S', 'SI','N','NO','') OPCION4, 
 DECODE (SUBSTR( P.PRY_PMAR_OP, 5, 1 ),'S', 'SI','N','NO','') OPCION5,
 DECODE (SUBSTR( P.PRY_PMAR_OP, 6, 1 ),'S', 'SI','N','NO','') OPCION6,
 ple.ple_nombre as programa,
 decode(ah.asi_id,0,PRY_ASIGNATURA_NOMBRE,ah.NMBRE_ASIGNATURA)asignatura,
 con.con_titulo as modalidad,
 p.mod_id
FROM HER_PROYECTO P left join HER_DOMINIO_DETALLE DD on dd.dom_id = '66' and DD.DOMDET_TIPO = P.PRY_PMAR_CB 
left join HER_COLECCION COL ON COL.COL_ID = P.PRY_PMAR_CB left join HER_PLAN_ESTUDIOS ple on ple.ple_id = p.PRY_PRO_ACA
left join sia_v_asignaturas_hermes ah on ah.ASI_ID = p.PRY_ASIGNATURA left join her_convocatoria con on con.con_id = p.mod_id WHERE P.PRY_ID = ?</property>
        </oda-data-set>

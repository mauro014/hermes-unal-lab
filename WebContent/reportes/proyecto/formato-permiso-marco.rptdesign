            <property name="queryText">SELECT p.PRY_ID,p.pry_descripcion,p.pry_abstract,p.PRY_JUSTIFICACION , p.PRY_MARCO_TEORICO,
p.PRY_OBJETIVO_GENERAL, PRY_METODOLOGIA,PRY_IMPACTO_ESPERADO,PRY_CONSIDERACIONES_ETICAS,PRY_PROPIEDAD_INTELECTUAL 
FROM HER_PROYECTO p  
WHERE p.pry_id = ?</property>

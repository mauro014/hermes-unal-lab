            <property name="queryText">SELECT HPP.PRY_PRG_NOMBRE, FF.FFI_DESCRIPCION, DEP.DPN_NOMBRE, PRY.PRY_CARACTERISTICA_PRY_PGR
FROM HER_PROYECTO_PROGRAMA HPP 
left join HER_DEPENDENCIA DEP ON DEP.DPN_ID = HPP.DPN_ID
left join HER_PROYECTO PRY ON  HPP.PRY_ID = PRY.PRY_ID
left join HER_FUENTE_FINANCIACION FF ON FF.FFI_ID = HPP.FFI_ID
WHERE HPP.PRY_ID = ?</property>

                    <property name="nativeName">ACTIVO</property>
                    <property name="dataType">string</property>
                </structure>
            </list-property>
            <property name="queryText">select pry.PRY_ID, 
nvl(PRY.PRY_TIENE_ACTIVO_PI,'No') PRY_TIENE_ACTIVO_PI, 
pry.PRY_ACTIVO_PI, 
det.DOMDET_DESCRIPCION AS ACTIVO
from her_proyecto pry
  left join her_dominio_detalle det on det.DOMDET_TIPO = pry.PRY_ACTIVO_PI
  left join her_dominio dom on det.DOM_ID = dom.DOM_ID and dom.DOM_TIPO = 'ACTIVO_PI'
where pry.PRY_ID = ?1</property>
        </oda-data-set>

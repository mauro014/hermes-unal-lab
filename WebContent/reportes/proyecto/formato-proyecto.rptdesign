                <structure>
                    <property name="position">1</property>
                    <property name="name">ENTIDAD</property>
                    <property name="nativeName">ENTIDAD</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">2</property>
                    <property name="name">FFE_VALOR_ESPECIE</property>
                    <property name="nativeName">FFE_VALOR_ESPECIE</property>
                    <property name="dataType">decimal</property>
                </structure>
            </list-property>
            <property name="queryText">SELECT 	ff.FFI_DESCRIPCION as entidad, F.FFE_VALOR_ESPECIE
  FROM 	HER_FUENTE_FINANCIACION ff, 
        HER_FINANCIACION f
 WHERE 	ff.FFI_ID = f.FFI_ID 
   AND  (F.FFE_TIPO_ENTIDAD = 'E')
   AND	PRY_ID = ?
   AND (FIN_ES_LEGALIZACION IS NULL OR  FIN_ES_LEGALIZACION = 'NO')</property>
        </oda-data-set>

                    <property name="name">GRU_ID</property>
                    <property name="nativeName">GRU_ID</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">2</property>
                    <property name="name">GRU_COLCIENCIAS</property>
                    <property name="nativeName">GRU_COLCIENCIAS</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">3</property>
                    <property name="name">GRU_NOMBRE</property>
                    <property name="nativeName">GRU_NOMBRE</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">4</property>
                    <property name="name">GRUPLAC</property>
                    <property name="nativeName">GRUPLAC</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">5</property>
                    <property name="name">GPRN</property>
                    <property name="nativeName">GPRN</property>
                    <property name="dataType">decimal</property>
                </structure>
                <structure>
                    <property name="position">6</property>
                    <property name="name">DPN</property>
                    <property name="nativeName">DPN</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">7</property>
                    <property name="name">CAT_COL</property>
                    <property name="nativeName">CAT_COL</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">8</property>
                    <property name="name">ENLACE_HERMES</property>
                    <property name="nativeName">ENLACE_HERMES</property>
                    <property name="dataType">string</property>
                </structure>
            </list-property>
            <property name="queryText">SELECT g.gru_id,G.GRU_COLCIENCIAS, G.GRU_NOMBRE,  'GRUPLAC: '||G.GRU_ENLACE_GRUPLAC AS GRUPLAC, PRN.GRU_ID AS GPRN,
d.dpn_nombre as dpn, gc.grc_nombre as cat_col, 'HERMES: http://www.hermes.unal.edu.co/pages/Consultas/Grupo.jsf?idGrupo='||g.gru_id AS ENLACE_HERMES
FROM HER_PROYECTO p 
left join HER_GRUPO_PROYECTO GP on gp.PRY_ID = p.pry_id
left join HER_GRUPO G on G.GRU_ID = GP.GRU_ID
left join HER_PROGRAMA_NACIONAL_PRN PRN on G.GRU_ID = PRN.GRU_ID AND PRN.PRY_ID = P.PRY_ID
left join her_dependencia d on g.dpn_id = d.dpn_id
left join HER_GRUPO_CATEGORIA GC on gc.GRC_ID = G.GRU_CATEGORIA_COLCIENCIAS
WHERE p.pry_id = ?
ORDER BY GPRN,G.GRU_NOMBRE ASC

</property>
        </oda-data-set>

                    <property name="dataType">string</property>
                    <property name="position">1</property>
                    <property name="isInput">true</property>
                    <property name="isOutput">false</property>
                </structure>
            </list-property>
            <list-property name="resultSet">
                <structure>
                    <property name="position">1</property>
                    <property name="name">DOCUMENTO</property>
                    <property name="nativeName">DOCUMENTO</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">2</property>
                    <property name="name">PERSONA</property>
                    <property name="nativeName">PERSONA</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">3</property>
                    <property name="name">SEMANAS</property>
                    <property name="nativeName">SEMANAS</property>
                    <property name="dataType">decimal</property>
                </structure>
                <structure>
                    <property name="position">4</property>
                    <property name="name">VALOR</property>
                    <property name="nativeName">VALOR</property>
                    <property name="dataType">decimal</property>
                </structure>
                <structure>
                    <property name="position">5</property>
                    <property name="name">TIPO_INVESTIGADOR</property>
                    <property name="nativeName">TIPO_INVESTIGADOR</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">6</property>
                    <property name="name">FECHA_CAMBIO</property>
                    <property name="nativeName">FECHA_CAMBIO</property>
                    <property name="dataType">date-time</property>
                </structure>
            </list-property>
            <property name="queryText">select 
per.tdo_id ||' - '||per.per_id documento,
PER.PER_NOMBRE1||' '||DECODE(PER.PER_NOMBRE2, PER.PER_NOMBRE2,PER.PER_NOMBRE2,NULL,' ')||' '||PER.PER_APELLIDO1||' '||DECODE(PER.PER_APELLIDO2, PER.PER_APELLIDO2,PER.PER_APELLIDO2,NULL,' ')persona,
inp.SPI_NUMERO_SEMANAS semanas,
inp.spi_valor_pagar valor,
ti.tinv_nombre tipo_investigador,
SPI_FECHA_PROCESAMIENTO as fecha_cambio
from
HER_SOLICITUD S, her_solicitud_prorroga_inv inp, HER_PERSONA PER, her_tipo_investigador ti
where
S.PRY_ID = ? AND
inp.SOL_ID = S.SOl_id
AND  INP.INV_ID = PER.PER_ID
AND  INP.TDO_ID = PER.TDO_ID
and ti.tinv_id = inp.SPI_TIPO
and inp.spi_estado not in ('B','N')</property>

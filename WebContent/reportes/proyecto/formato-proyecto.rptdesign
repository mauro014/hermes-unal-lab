            <property name="queryText">SELECT solin.SIN_ID AS CODIGO_SOL ,'('||PER.TDO_ID ||' - '||PER.PER_ID||')' AS DOCUMENTO,
PER.PER_NOMBRE1||' '||DECODE(PER.PER_NOMBRE2,PER.PER_NOMBRE2,PER.PER_NOMBRE2,NULL,' ')||' '||PER.PER_APELLIDO1||' '||DECODE(PER.PER_APELLIDO2,PER.PER_APELLIDO2,PER.PER_APELLIDO2,NULL,' ') persona,
TI.TINV_NOMBRE AS TIPO_INVESTIGADOR, DECODE(SOLIN.SIN_TIPO_SOLICITUD,'A','VINCULACIÓN AL EQUIPO DE TRABAJO','R','DESVINCULACIÓN DEL EQUIPO DE TRABAJO','E','DESVINCULACIÓN COMO INVESTIGADOR PRINCIPAL','C','VINCULACIÓN INVESTIGADOR PRINCIPAL','I','DESVINCULACIÓN DEL EQUIPO DE TRABAJO') AS TIPO_SOLICITUD,
SOLIN.SIN_DEDICACION_HORAS_SEMANA AS DEDICACION, SOLIN.SIN_FUNCION AS FUNCION, SOLIN.SIN_FECHA_PROCESAMIENTO AS FECHA_CAMBIO,
solin.SIN_VALOR_PAGAR valor
FROM HER_SOLICITUD_INVESTIGADOR SOLIN, HER_SOLICITUD SOL, HER_PROYECTO PRY, HER_PERSONA PER, HER_TIPO_INVESTIGADOR TI
WHERE PRY.PRY_ID = ?
AND PRY.PRY_ID = SOL.PRY_ID
AND SOL.TSO_ID IN (5,24)
AND SOLIN.SOL_ID = SOL.SOL_ID
and sol.sol_respuesta in ('A')
--AND SOLIN.SIN_TIPO_SOLICITUD NOT IN ('R')
AND SOLIN.SIN_TIPO = TI.TINV_ID
AND PER.PER_ID = SOLIN.INV_ID
AND PER.TDO_ID = SOLIN.TDO_ID
order by per.PER_ID, solin.SIN_ID asc</property>
        </oda-data-set>

            <property name="queryText">SELECT CONV.CON_RESTRICCION, LISV.VAL_TIPO, LISV.VAL_VALOR, LISV.VAL_DESCRIPCION, LISV.VAL_DESCRIPCION2, LISV.VAL_DESCRIPCION3, LISV.VAL_DESCRIPCION4, LISV.VAL_NOMBRE_VALOR

                </structure>
                <structure>
                    <property name="position">3</property>
                    <property name="name">NOMBRE_PLAN</property>
                    <property name="nativeName">NOMBRE_PLAN</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">4</property>
                    <property name="name">PRY_COMPONENTE_PLAN_DLLO</property>
                    <property name="nativeName">PRY_COMPONENTE_PLAN_DLLO</property>
                    <property name="dataType">decimal</property>
                </structure>
                <structure>
                    <property name="position">5</property>
                    <property name="name">COMPONENTE_PLAN_DESCRIPCION</property>
                    <property name="nativeName">COMPONENTE_PLAN_DESCRIPCION</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">6</property>
                    <property name="name">COMPONENTE_PLAN_ETIQUETA</property>
                    <property name="nativeName">COMPONENTE_PLAN_ETIQUETA</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">7</property>
                    <property name="name">PROGRAMA</property>
                    <property name="nativeName">PROGRAMA</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">8</property>
                    <property name="name">ETIQUETA_PROGRAMA</property>
                    <property name="nativeName">ETIQUETA_PROGRAMA</property>
                    <property name="dataType">string</property>
                </structure>
            </list-property>
            <property name="queryText">SELECT 
    det_linea.DOMDET_DESCRIPCION AS linea, 
    det_linea.DOMDET_ETIQUETA    AS etiqueta_linea,
    pg_plan.pgd_descripcion      AS nombre_plan, 
    pry.PRY_COMPONENTE_PLAN_DLLO,
    pg_comp.pgd_descripcion      AS componente_plan_descripcion,
    pg_comp.pgd_etiqueta_formulario AS componente_plan_etiqueta,
    det_prog.DOMDET_DESCRIPCION  AS programa,
    det_prog.DOMDET_ETIQUETA     AS etiqueta_programa
FROM her_dominio_detalle det_linea
JOIN her_proyecto pry 
    ON det_linea.DOMDET_TIPO = pry.PRY_LINEA_ACCION
JOIN her_plan_global_desarrollo pg_plan
    ON det_linea.domdet_observacion = pg_plan.pgd_periodo
LEFT JOIN her_plan_global_desarrollo pg_comp
    ON pry.pry_componente_plan_dllo = pg_comp.pgd_id
LEFT JOIN her_dominio_detalle det_prog
    ON det_prog.DOM_ID = 67
    AND det_prog.DOMDET_TIPO = pry.PRY_PROGRAMA
WHERE det_linea.DOM_ID = 71 
  AND pry.PRY_ID = ?
</property>
        </oda-data-set>

            <property name="queryText">select gru.GRU_NOMBRE
  from HER_PROYECTO pry, HER_GRUPO gru
 WHERE pry.PRY_ID = ?
 AND pry.PRY_SOS_ALIADOS = gru.GRU_ID
</property>

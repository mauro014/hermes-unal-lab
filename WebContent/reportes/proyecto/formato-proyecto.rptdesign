            <property name="queryText">SELECT
	CASE
		WHEN tr.TRU_ID IN (142, 145, 144, 143, 82, 141, 135, 7, 120, 130, 1) THEN 'Cuenta: Contrapartidas'
		WHEN tr.TRU_DESCRIPCION = 'GASTOS_CP_2022' THEN 'Cuenta: '||tr3.TRU_NOMBRE
		ELSE NULL
	END Cuenta,
	CASE
		WHEN tr.TRU_ID IN (142, 145, 144, 143, 82, 141, 135, 7, 120, 130, 1) THEN 'Objeto: Contrapartidas'
		WHEN tr.TRU_DESCRIPCION = 'GASTOS_CP_2022' THEN 'Objeto: '||tr2.TRU_NOMBRE
		ELSE NULL
	END Objeto,
	tr.TRU_NOMBRE Rubro,
	g.gst_valor especie,
	g.gst_valor2 efectivo,
	g.gst_valor3 ano2,
	g.gst_valor4 ano3,
	g.gst_valor5 ano4,
	g.gst_valor6 ano5,
	ff.ffi_descripcion AS entidad,
	p.mod_id,
	g.GST_DESCRIPCION as descrip
FROM
	HER_GASTO g
LEFT JOIN HER_TIPO_RUBRO tr ON
	g.tru_id = tr.TRU_ID
	AND tr.TRU_ID NOT IN (93, 149, 150)
LEFT JOIN HER_TIPO_RUBRO tr2 ON
	tr.TRU_ID_PADRE = tr2.TRU_ID
LEFT JOIN HER_TIPO_RUBRO tr3 ON
	tr2.TRU_ID_PADRE = tr3.TRU_ID
LEFT JOIN HER_FINANCIACION f ON
	g.fin_ID = f.fin_ID
	AND (F.FFE_TIPO_ENTIDAD = 'F'
		OR F.FFE_TIPO_ENTIDAD IS NULL)
	AND (f.FIN_ES_LEGALIZACION IS NULL
		OR f.FIN_ES_LEGALIZACION = 'NO')
LEFT JOIN her_fuente_financiacion ff ON
	ff.FFI_ID = f.FFI_ID
LEFT JOIN HER_PROYECTO p ON
	f.PRY_ID = p.PRY_ID
WHERE
	P.PRY_ID = ?
ORDER BY
	ff.ffi_descripcion,
	g.GST_DESCRIPCION</property>
        </oda-data-set>

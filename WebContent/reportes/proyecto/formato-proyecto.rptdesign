            <property name="queryText">select
	fie.FIE_LISTA_SEL_MUL,
	fie.FIE_TEXTO_LISTA_SELECCION_MUL,
	plv.VAL_DESCRIPCION
from HER_FORMULARIO_INFO_ESPECIFICA fie
    left join HER_CONVOCATORIA c on fie.MOD_ID=c.CON_ID
    left join HER_PROYECTO p on p.MOD_ID=c.CON_ID
    left join HER_PROYECTO_LISTAS_VAL plv on p.PRY_ID=plv.PRY_ID
where p.pry_id = ?
and fie.FIE_LISTA_SEL_MUL='Y'
AND plv.VAL_TIPO = fie.FIE_DOM_LISTA_SELECCION_MUL</property>
        </oda-data-set>

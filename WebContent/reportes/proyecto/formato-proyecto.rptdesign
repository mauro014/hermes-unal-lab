            <property name="queryText">SELECT 
HLP.LAB_ID ||' - '|| HL.LAB_NOMBRE AS LAB,
hs.SED_NOMBRE  "SEDE",
D2.DPN_NOMBRE  "FACULTAD"
from 
HER_LABORATORIO_PROYECTO HLP 
LEFT JOIN HER_LABORATORIO HL ON HL.LAB_ID = HLP.LAB_ID 
LEFT JOIN HER_SEDE HS ON HS.SED_ID = HL.SED_ID
LEFT JOIN HER_DEPENDENCIA hd  ON HD.DPN_ID = HL.LAB_FACULTAD
LEFT JOIN her_dependencia d2 ON d2.dpn_id = hd.dpn_facultad
WHERE PRY_ID = ?</property>

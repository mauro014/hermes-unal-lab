                    </structure>
                    <structure>
                        <property name="position">3</property>
                        <property name="name">LIDER</property>
                        <property name="dataType">string</property>
                    </structure>
                    <structure>
                        <property name="position">4</property>
                        <property name="name">LINK</property>
                        <property name="dataType">string</property>
                    </structure>
                    <structure>
                        <property name="position">5</property>
                        <property name="name">SEM_ID</property>
                        <property name="dataType">decimal</property>
                    </structure>
                </list-property>
            </structure>
            <property name="dataSource">OrigenHermes</property>
            <list-property name="parameters">
                <structure>
                    <property name="name">param_1</property>
                    <property name="paramName">id</property>
                    <property name="dataType">string</property>
                    <property name="position">1</property>
                    <property name="isInput">true</property>
                    <property name="isOutput">false</property>
                </structure>
            </list-property>
            <list-property name="resultSet">
                <structure>
                    <property name="position">1</property>
                    <property name="name">SEM_NOMBRE</property>
                    <property name="nativeName">SEM_NOMBRE</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">2</property>
                    <property name="name">SEE_NOMBRE</property>
                    <property name="nativeName">SEE_NOMBRE</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">3</property>
                    <property name="name">LIDER</property>
                    <property name="nativeName">LIDER</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">4</property>
                    <property name="name">LINK</property>
                    <property name="nativeName">LINK</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">5</property>
                    <property name="name">SEM_ID</property>
                    <property name="nativeName">SEM_ID</property>
                    <property name="dataType">decimal</property>
                </structure>
            </list-property>
            <property name="queryText">SELECT
	hs.SEM_NOMBRE,
	hse.SEE_NOMBRE,
	per.per_nombre1 || decode(per.per_nombre2, NULL, ' ', ' ' || per.per_nombre2 || ' ') || per.per_apellido1 || decode(per.per_apellido2, NULL, '', ' ' || per.per_apellido2) lider,
	'http://www.hermes.unal.edu.co/pages/Consultas/Semillero.xhtml?id='||HS.SEM_ID AS LINK,
	HS.SEM_ID
FROM
	HER_SEMILLERO_PROYECTO hsp
INNER JOIN HER_SEMILLERO hs ON
	hs.SEM_ID = hsp.SEM_ID
INNER JOIN (
	SELECT
		sem_id, max(hse_id) idHist
	FROM
		HER_SEMILLERO_HISTORICO_ESTADO
	GROUP BY
		SEM_ID ) idEst ON
	idEst.SEM_ID = hs.SEM_ID
INNER JOIN HER_SEMILLERO_HISTORICO_ESTADO hshe ON
	hshe.HSE_ID = idEst.IDHIST
INNER JOIN HER_SEMILLERO_ESTADO hse ON
	hshe.SEE_ID = hse.SEE_ID
INNER JOIN HER_SEMILLERO_INTEGRANTE hsi ON
	hsi.SEM_ID = hs.SEM_ID
	AND hsi.SIT_ID = 'DD'
INNER JOIN her_investigador_interno ii ON
	hsi.tdo_id = ii.tdo_id
	AND hsi.inv_id = ii.inv_id
INNER JOIN her_persona per ON
	per.tdo_id = ii.tdo_id
	AND ii.inv_id = per.per_id
WHERE
	hsp.PRY_ID = ?
ORDER BY
	hs.SEM_ID
</property>
        </oda-data-set>

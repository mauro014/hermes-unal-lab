                    <property name="dataType">date-time</property>
                </structure>
            </list-property>
            <property name="queryText">SELECT  '- '|| re.RST_DESCRIPCION as resultado_esp, RST_ENTREGABLE,
RST_FECHA_ENTREGABLE
FROM HER_PROYECTO pry, HER_RESULTADO_PROYECTO re
WHERE pry.pry_id = ?
AND pry.PRY_ID=re.PRY_ID
order by RST_DESCRIPCION</property>
        </oda-data-set>

            </list-property>
            <property name="queryText">select dpn.DPN_NOMBRE as dpn_ejecucion_fn,
(select ej.dpn_id from her_proyecto_ejecucion ej where ej.dpn_id = PRY.PRY_LUGAR and ej.pry_id = pry.PRY_ID)dpn_lista 
from HER_PROYECTO pry,
  	   HER_DEPENDENCIA dpn
where pry.PRY_ID = ?
AND dpn.DPN_ID = PRY.PRY_LUGAR</property>
        </oda-data-set>

            <property name="queryText">SELECT 
D.DPN_NOMBRE AS DEPENDAPORTA,
PDA_VALOR_APORTE AS APORTE,
PDA_VALOR_APORTE_especie AS APORTE_especie
from 
HER_PROYECTO_DPN_APORTA PE 
LEFT JOIN her_dependencia d ON d.dpn_id = PE.dpn_ID
WHERE PRY_ID = ?</property>

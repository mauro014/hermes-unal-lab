            <property name="queryText">select financiera.entidad as entidad, 
financiera.tipo as tipo, 
financiera.naturaleza as naturaleza, 
sum(financiera.valor) as valor,
sum(financiera.especie) as especie,
sum(financiera.total_rubros_especie) as total_rubros_especie,
sum(financiera.total_rubros_efectivo) as total_rubros_efectivo,
sum(financiera.total_un_fin_basica) as total_un_fin_basica

from (
SELECT 	ff.FFI_DESCRIPCION as entidad, 
DECODE (ff.ffi_interna_externa, 'I','Interna','E','Externa','A','Inscripciones','O','Interna','OE','Externa','') tipo,
(select dd.domdet_descripcion from her_dominio_detalle dd where dd.domdet_tipo = ff.ffe_cod_naturaleza) naturaleza, 
f.FIN_VALOR as valor, 
nvl(f.FFE_VALOR_ESPECIE,0) as especie,    
(SELECT  SUM(nvl(g.gst_valor,0)) 
FROM HER_GASTO g, HER_TIPO_RUBRO tr
WHERE g.fin_ID = f.fin_ID 
  AND ff.FFI_ID = f.FFI_ID 
  AND g.tru_id =tr.TRU_ID
  AND tr.TRU_ID NOT IN (93, 149, 150)
  AND  (F.FFE_TIPO_ENTIDAD = 'F' OR F.FFE_TIPO_ENTIDAD is null)
  AND (FIN_ES_LEGALIZACION IS NULL OR  FIN_ES_LEGALIZACION = 'NO')
) total_rubros_especie,
(SELECT  SUM(g.GST_VALOR2 + g.GST_VALOR3 + g.GST_VALOR4 + g.GST_VALOR5 + g.GST_VALOR6)
  FROM HER_GASTO g, 
       HER_TIPO_RUBRO tr
WHERE g.fin_ID = f.fin_ID 
  AND ff.FFI_ID = f.FFI_ID 
  AND g.tru_id =tr.TRU_ID
  AND tr.TRU_ID NOT IN (93, 149, 150)
  AND  (F.FFE_TIPO_ENTIDAD = 'F' OR F.FFE_TIPO_ENTIDAD is null)
  AND (FIN_ES_LEGALIZACION IS NULL OR  FIN_ES_LEGALIZACION = 'NO')
) total_rubros_efectivo,
(SELECT  SUM(g.gst_valor) 
FROM HER_GASTO g, HER_TIPO_RUBRO tr
WHERE g.fin_ID = f.fin_ID 
  AND ff.FFI_ID = f.FFI_ID 
  AND g.tru_id =tr.TRU_ID
  AND tr.TRU_ID NOT IN (93, 149, 150)
  AND  (F.FFE_TIPO_ENTIDAD = 'F' OR F.FFE_TIPO_ENTIDAD is null)
  AND (FIN_ES_LEGALIZACION IS NULL OR  FIN_ES_LEGALIZACION = 'NO')
) total_un_fin_basica
  FROM 	HER_FUENTE_FINANCIACION ff, 
        HER_FINANCIACION f
 WHERE 	ff.FFI_ID = f.FFI_ID 
   AND  (F.FFE_TIPO_ENTIDAD = 'F' OR F.FFE_TIPO_ENTIDAD is null)
   AND	PRY_ID = ?
   AND (FIN_ES_LEGALIZACION IS NULL OR  FIN_ES_LEGALIZACION = 'NO')
  
union 
  
SELECT ff.FFI_DESCRIPCION as entidad, 
DECODE (ff.ffi_interna_externa, 'I','Interna','E','Externa','A','Inscripciones','O','Interna','OE','Externa','') tipo,
(select dd.domdet_descripcion from her_dominio_detalle dd where dd.domdet_tipo = ff.ffe_cod_naturaleza) naturaleza, 
f.FIN_VALOR as valor, 
f.FFE_VALOR_ESPECIE as especie,     
(
select SUM(g.gst_valor)
FROM HER_GASTO g, HER_TIPO_RUBRO tr
WHERE g.fin_ID = f.fin_ID 
  AND ff.FFI_ID = f.FFI_ID 
  AND g.tru_id =tr.TRU_ID
  AND tr.TRU_ID NOT IN (93, 149, 150)
  AND  (F.FFE_TIPO_ENTIDAD = 'E')
  AND (FIN_ES_LEGALIZACION IS NULL OR  FIN_ES_LEGALIZACION = 'NO')
  )total_rubros_especie,
0 total_rubros_efectivo,
0 total_un_fin_basica
 FROM 	HER_FUENTE_FINANCIACION ff, 
        HER_FINANCIACION f
 WHERE 	ff.FFI_ID = f.FFI_ID 
   AND  (F.FFE_TIPO_ENTIDAD = 'E')
   AND	PRY_ID = ?
   AND (FIN_ES_LEGALIZACION IS NULL OR  FIN_ES_LEGALIZACION = 'NO')
   )financiera group by financiera.entidad, financiera.tipo, financiera.naturaleza
  </property>
        </oda-data-set>

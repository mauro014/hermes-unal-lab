            <property name="queryText">SELECT
	(
	SELECT
		nvl(SUM (nvl(G.GST_VALOR2, 0)), 0) + nvl(SUM (nvl(G.GST_VALOR3, 0)), 0) + nvl(SUM (nvl(G.GST_VALOR4, 0)), 0) + nvl(SUM (nvl(G.GST_VALOR5, 0)), 0)+ nvl(SUM (nvl(G.GST_VALOR6, 0)), 0)
	FROM
		HER_FUENTE_FINANCIACION ff,
		HER_FINANCIACION f,
		HER_GASTO G
	WHERE
		ff.FFI_ID = f.FFI_ID
		AND (F.FFE_TIPO_ENTIDAD IN ('F', 'E')
			OR F.FFE_TIPO_ENTIDAD IS NULL)
		AND (FF.FFI_INTERNA_EXTERNA = 'E'
			OR FF.FFI_INTERNA_EXTERNA = 'OE')
		AND (FIN_ES_LEGALIZACION IS NULL
			OR FIN_ES_LEGALIZACION = 'NO')
            AND F.FIN_ID = G.FIN_ID
		AND F.PRY_ID = PRY.PRY_ID
		AND ff.FFI_ID != 3273)total_externo,
	(
	SELECT
		nvl(SUM (f.FIN_VALOR), 0)+ nvl(SUM(F.FFE_VALOR_ESPECIE), 0)
	FROM
		HER_FUENTE_FINANCIACION ff,
		HER_FINANCIACION f
	WHERE
		ff.FFI_ID = f.FFI_ID
		AND (F.FFE_TIPO_ENTIDAD = 'P')
			AND (FIN_ES_LEGALIZACION IS NULL
				OR FIN_ES_LEGALIZACION = 'NO')
			AND F.PRY_ID = PRY.PRY_ID)total_participantes,
	(
	SELECT
		decode(nvl(SUM (nvl(G.GST_VALOR, 0)),0),0,nvl(SUM (nvl(F.FFE_VALOR_ESPECIE, 0)),0),nvl(SUM (nvl(G.GST_VALOR, 0)),0))
	FROM
		HER_FUENTE_FINANCIACION ff,
		HER_FINANCIACION f,
        HER_GASTO G
	WHERE
		ff.FFI_ID = f.FFI_ID
        AND (F.FFE_TIPO_ENTIDAD IN ('F', 'E')
			OR F.FFE_TIPO_ENTIDAD IS NULL)
		AND (FF.FFI_INTERNA_EXTERNA = 'E'
			OR FF.FFI_INTERNA_EXTERNA = 'OE')
		AND (FIN_ES_LEGALIZACION IS NULL
			OR FIN_ES_LEGALIZACION = 'NO')
            AND F.FIN_ID = G.FIN_ID
		AND F.PRY_ID = PRY.PRY_ID) AS total_especie_ext,
	pry.PRY_VALOR_PERSONAL VALOR_PERSONAL_DOCENTE,
	(SELECT
		(nvl(SUM (nvl(G.GST_VALOR, 0)), 0 ) +  nvl(SUM (nvl(G.GST_VALOR2, 0)), 0) + nvl(SUM (nvl(G.GST_VALOR3, 0)), 0) 
        + nvl(SUM (nvl(G.GST_VALOR4, 0)), 0) + nvl(SUM (nvl(G.GST_VALOR5, 0)), 0)+ nvl(SUM (nvl(G.GST_VALOR6, 0)), 0)) efectivo
	FROM
		HER_FUENTE_FINANCIACION ff,
		HER_FINANCIACION f,
		HER_GASTO G,
        her_tipo_rubro tr
	WHERE
		ff.FFI_ID = f.FFI_ID
		AND (F.FFE_TIPO_ENTIDAD IN ('F', 'I')
			OR F.FFE_TIPO_ENTIDAD IS NULL)
		AND (FF.FFI_INTERNA_EXTERNA = 'I'
			OR FF.FFI_INTERNA_EXTERNA = 'O')
		AND (FIN_ES_LEGALIZACION IS NULL
			OR FIN_ES_LEGALIZACION = 'NO')
            AND F.FIN_ID = G.FIN_ID
		AND F.PRY_ID = PRY.PRY_ID
		AND g.tru_id = tr.tru_id
        and tr.tru_contrapartida != 1)PRY_CONTRAP_EFECTIVO,
	PRY_CONTRAP_ESPECIE,
	pry.PRY_ADM_TOTAL VALOR_PERSONAL_ADMINISTRATIVO,
	pry.PRY_TOT_COST_INDIRECTO,
	(
	SELECT
		nvl(SUM(nvl(g.GST_VALOR2, 0))+ SUM(nvl(g.GST_VALOR3, 0))+ SUM(nvl(g.GST_VALOR4, 0))+ sUM(nvl(g.GST_VALOR5, 0))+ SUM(nvl(g.GST_VALOR6, 0)), 0)
	FROM
		HER_FUENTE_FINANCIACION ff,
		HER_FINANCIACION f,
		HER_GASTO g
	WHERE
		ff.FFI_ID = f.FFI_ID
		AND g.FIN_ID = f.FIN_ID
		AND (F.FFE_TIPO_ENTIDAD = 'F'
			OR F.FFE_TIPO_ENTIDAD IS NULL)
		AND (FIN_ES_LEGALIZACION IS NULL
			OR FIN_ES_LEGALIZACION = 'NO')
		AND ff.FFI_ID = '4805'
		AND F.PRY_ID = PRY.PRY_ID) vf_urosario,
	(
	SELECT
		nvl(SUM(nvl(g.GST_VALOR2, 0))+ SUM(nvl(g.GST_VALOR3, 0))+ SUM(nvl(g.GST_VALOR4, 0))+ sUM(nvl(g.GST_VALOR5, 0))+ SUM(nvl(g.GST_VALOR6, 0)), 0)
	FROM
		HER_FUENTE_FINANCIACION ff,
		HER_FINANCIACION f,
		HER_GASTO g
	WHERE
		ff.FFI_ID = f.FFI_ID
		AND g.FIN_ID = f.FIN_ID
		AND (F.FFE_TIPO_ENTIDAD = 'F'
			OR F.FFE_TIPO_ENTIDAD IS NULL)
		AND (FIN_ES_LEGALIZACION IS NULL
			OR FIN_ES_LEGALIZACION = 'NO')
		AND ff.FFI_ID = '1'
		AND F.PRY_ID = PRY.PRY_ID) efectUN_urosario,
	(
	SELECT
		nvl(SUM(nvl(g.GST_VALOR2, 0))+ SUM(nvl(g.GST_VALOR3, 0))+ SUM(nvl(g.GST_VALOR4, 0))+ sUM(nvl(g.GST_VALOR5, 0))+ SUM(nvl(g.GST_VALOR6, 0)), 0)
	FROM
		HER_FUENTE_FINANCIACION ff,
		HER_FINANCIACION f,
		HER_GASTO g
	WHERE
		ff.FFI_ID = f.FFI_ID
		AND g.FIN_ID = f.FIN_ID
		AND (F.FFE_TIPO_ENTIDAD = 'F'
			OR F.FFE_TIPO_ENTIDAD IS NULL)
		AND (FIN_ES_LEGALIZACION IS NULL
			OR FIN_ES_LEGALIZACION = 'NO')
		AND FF.FFI_INTERNA_EXTERNA = 'E'
		AND F.PRY_ID = PRY.PRY_ID) efectUR_urosario ,
	(
	SELECT
		decode(nvl(SUM(nvl(g.GST_VALOR, 0)),0),0,SUM(nvl(f.FFE_VALOR_ESPECIE,0)),nvl(SUM(nvl(g.GST_VALOR, 0)),0))
	FROM
		HER_FUENTE_FINANCIACION ff,
		HER_FINANCIACION f,
		HER_GASTO g
	WHERE
		ff.FFI_ID = f.FFI_ID
		AND g.FIN_ID = f.FIN_ID
		AND (F.FFE_TIPO_ENTIDAD in ('F','E')
			OR F.FFE_TIPO_ENTIDAD IS NULL)
		AND (FIN_ES_LEGALIZACION IS NULL
			OR FIN_ES_LEGALIZACION = 'NO')
		AND FF.FFI_INTERNA_EXTERNA = 'E'
		AND F.PRY_ID = PRY.PRY_ID) especiUR_urosario,
	(
	SELECT
		nvl(SUM(nvl(g.GST_VALOR2, 0))+ SUM(nvl(g.GST_VALOR3, 0))+ SUM(nvl(g.GST_VALOR4, 0))+ sUM(nvl(g.GST_VALOR5, 0))+ SUM(nvl(g.GST_VALOR6, 0)), 0)
	FROM
		HER_FUENTE_FINANCIACION ff,
		HER_FINANCIACION f,
		HER_GASTO g
	WHERE
		ff.FFI_ID = f.FFI_ID
		AND g.FIN_ID = f.FIN_ID
		AND (F.FFE_TIPO_ENTIDAD = 'P')
			AND (FIN_ES_LEGALIZACION IS NULL
				OR FIN_ES_LEGALIZACION = 'NO')
			AND F.PRY_ID = PRY.PRY_ID) efectiPart_urosario,
	(
	SELECT
		nvl(SUM(nvl(g.GST_VALOR, 0)), 0)
	FROM
		HER_FUENTE_FINANCIACION ff,
		HER_FINANCIACION f,
		HER_GASTO g
	WHERE
		ff.FFI_ID = f.FFI_ID
		AND g.FIN_ID = f.FIN_ID
		AND (F.FFE_TIPO_ENTIDAD = 'P')
			AND (FIN_ES_LEGALIZACION IS NULL
				OR FIN_ES_LEGALIZACION = 'NO')
			AND F.PRY_ID = PRY.PRY_ID) especiPart_urosario
FROM
	HER_PROYECTO pry
WHERE
	pry.PRY_ID = ?</property>
        </oda-data-set>
        <oda-data-set extensionID="org.eclipse.birt.report.data.oda.jdbc.JdbcSelectDataSet" name="8-totales-financiacion-corredor" id="14148">

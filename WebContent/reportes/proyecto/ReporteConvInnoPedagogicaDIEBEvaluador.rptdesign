                    <property name="isOutput">false</property>
                </structure>
            </list-property>
            <list-property name="resultSet">
                <structure>
                    <property name="position">1</property>
                    <property name="name">DOMDET_DESCRIPCION</property>
                    <property name="nativeName">DOMDET_DESCRIPCION</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">2</property>
                    <property name="name">PGD_DESCRIPCION</property>
                    <property name="nativeName">PGD_DESCRIPCION</property>
                    <property name="dataType">string</property>
                </structure>
            </list-property>
            <property name="queryText">select det.DOMDET_DESCRIPCION, pg.pgd_descripcion 
from her_dominio_detalle det, her_proyecto pry, her_plan_global_desarrollo pg 
where det.DOM_ID = 71 
and det.DOMDET_TIPO = pry.PRY_LINEA_ACCION 
and det.domdet_observacion = pg.pgd_periodo
and pry.PRY_ID = ?</property>
        </oda-data-set>
        <oda-data-set extensionID="org.eclipse.birt.report.data.oda.jdbc.JdbcSelectDataSet" name="Programa" id="10535">
            <structure name="cachedMetaData">

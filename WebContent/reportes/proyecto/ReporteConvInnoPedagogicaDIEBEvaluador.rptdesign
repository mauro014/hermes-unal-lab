            <property name="queryText">SELECT PRY.PRY_ID,
PER.PER_APELLIDO1||' '||DECODE(PER.PER_APELLIDO2,NULL,' ',PER.PER_APELLIDO2,PER.PER_APELLIDO2)||' '||PER.PER_NOMBRE1||' '||DECODE(PER.PER_NOMBRE2,PER.PER_NOMBRE2,PER.PER_NOMBRE2,NULL,' ')EVALUADORES,
PER_EMAIL
FROM
HER_POSIBLE_EVALUADOR_INTERNO PEI, HER_PERSONA PER, HER_PROYECTO PRY
WHERE
PEI.PRY_ID = PRY.PRY_ID  
AND PRY.PRY_ID = ?
AND PEI.INV_ID = PER.PER_ID</property>
        </oda-data-set>

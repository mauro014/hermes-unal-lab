            <property name="queryText"> SELECT TRU_NOMBRE  Rubro, SUM(GST_VALOR) Valor, GST_VIGENCIA VIGENCIA, MAX(GST_DESCRIPCION) DESCRIPCION, ff.FFI_DESCRIPCION
  FROM  HER_GASTO g, 
HER_TIPO_RUBRO tr, HER_FINANCIACION f , her_fuente_financiacion ff
WHERE 

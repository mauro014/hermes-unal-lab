            <property name="queryText">SELECT SUM(GST_VALOR)  gv11,0,SUM(GST_VALOR) gv21,
0,0, 0,SUM(GST_VALOR) gv31
  FROM  HER_GASTO g, 
HER_TIPO_RUBRO tr, HER_FINANCIACION f, her_fuente_financiacion ff 
WHERE 
g.fin_ID = f.fin_ID  
and ffi_interna_externa = 'E'
and ff.FFI_ID = f.FFI_ID 
and g.tru_id =tr.TRU_ID AND 
tr.tru_id IN (1, 3,6, 36,37,38,7,9,10,33,34,35,11,39,40,41,13,14,15,16,17,43,45,46,47,55 ) AND
 g.GST_VIGENCIA = 1 AND
PRY_ID =   ?</property>

                    <property name="name">GRU_NOMBRE</property>
                    <property name="nativeName">GRU_NOMBRE</property>
                    <property name="dataType">string</property>
                </structure>
            </list-property>
            <property name="queryText">SELECT GR.GRU_NOMBRE FROM HER_GRUPO_PROYECTO GRUPR, HER_PROYECTO PRY, HER_GRUPO GR
WHERE GRUPR.PRY_ID = PRY.PRY_ID
AND GR.GRU_ID = GRUPR.GRU_ID
AND PRY.PRY_ID = ?</property>
        </oda-data-set>
        <oda-data-set extensionID="org.eclipse.birt.report.data.oda.jdbc.JdbcSelectDataSet" name="5 Participantes" id="9665">
            <structure name="cachedMetaData">
                <list-property name="resultSet">
                    <structure>
                        <property name="position">1</property>
                        <property name="name">PER_ID</property>
                        <property name="dataType">string</property>
                    </structure>
                    <structure>
                        <property name="position">2</property>
                        <property name="name">COINVESTIGA</property>
                        <property name="dataType">string</property>
                    </structure>
                    <structure>
                        <property name="position">3</property>
                        <property name="name">CANTIDAD</property>
                        <property name="dataType">decimal</property>
                    </structure>
                    <structure>
                        <property name="position">4</property>
                        <property name="name">BONIFICACION</property>
                        <property name="dataType">decimal</property>
                    </structure>
                </list-property>
            </structure>
            <property name="dataSource">Data Source</property>
            <list-property name="parameters">
                <structure>
                    <property name="name">param_1</property>
                    <property name="paramName">id</property>
                    <property name="dataType">string</property>
                    <property name="position">1</property>
                    <property name="isInput">true</property>
                    <property name="isOutput">false</property>
                </structure>
            </list-property>
            <list-property name="resultSet">
                <structure>
                    <property name="position">1</property>
                    <property name="name">PER_ID</property>
                    <property name="nativeName">PER_ID</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">2</property>
                    <property name="name">COINVESTIGA</property>
                    <property name="nativeName">COINVESTIGA</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">3</property>
                    <property name="name">CANTIDAD</property>
                    <property name="nativeName">CANTIDAD</property>
                    <property name="dataType">decimal</property>
                </structure>
                <structure>
                    <property name="position">4</property>
                    <property name="name">BONIFICACION</property>
                    <property name="nativeName">BONIFICACION</property>
                    <property name="dataType">decimal</property>
                </structure>
            </list-property>
            <property name="queryText">SELECT
       PER.PER_ID,
       PER.PER_NOMBRE1||' '||DECODE(PER.PER_NOMBRE2, PER.PER_NOMBRE2,PER.PER_NOMBRE2,NULL,' ')||' '||PER.PER_APELLIDO1||' '||DECODE(PER.PER_APELLIDO2, PER.PER_APELLIDO2,PER.PER_APELLIDO2,NULL,' ')COINVESTIGA,
       INP.INP_DEDICACION_HORAS_SEMANA CANTIDAD,
       INP.INP_VALOR_PAGAR BONIFICACION
  FROM HER_PROYECTO PRY, 
       HER_INVESTIGADOR_PROYECTO INP, 
       HER_PERSONA PER, 
       HER_INVESTIGADOR INV,
       HER_INVESTIGADOR_INTERNO II
 WHERE PRY.PRY_ID = ?
   AND PER.PER_ID = INP.INV_ID
   AND PER.TDO_ID = INP.TDO_ID
   AND PER.PER_ID = INV.INV_ID
   AND PER.TDO_ID = INV.TDO_ID
   AND INV.INV_ID = INP.INV_ID
   AND INV.TDO_ID = INP.TDO_ID
   AND PRY.PRY_ID=INP.PRY_ID
   AND INP.INP_TIPO &lt;> 'P'
   AND INP.INV_ID = II.INV_ID
    AND INP.INV_ID IN ('PEX0000', 'AD0000', 'AL0000', 'CT0000',
                        'CNE0000', 'PCD0000', 'PSCD0000', 'ESPR0000','ESPR0001')
ORDER BY INP_ID</property>
        </oda-data-set>
    </data-sets>

            <list-property name="resultSet">
                <structure>
                    <property name="position">1</property>
                    <property name="name">PROGRAMA</property>
                    <property name="nativeName">PROGRAMA</property>
                    <property name="dataType">string</property>
                </structure>
            </list-property>
            <property name="queryText">select det.DOMDET_DESCRIPCION as programa from her_dominio_detalle det, her_proyecto pry where det.DOM_ID = 67 and det.DOMDET_TIPO = pry.PRY_PROGRAMA and pry.PRY_ID = ?</property>
        </oda-data-set>
        <oda-data-set extensionID="org.eclipse.birt.report.data.oda.jdbc.JdbcSelectDataSet" name="ObjetivosMetas" id="10571">
            <structure name="cachedMetaData">
                <list-property name="resultSet">
                    <structure>
                        <property name="position">1</property>
                        <property name="name">OBJETIVO</property>
                        <property name="dataType">string</property>
                    </structure>
                    <structure>
                        <property name="position">2</property>
                        <property name="name">META</property>
                        <property name="dataType">string</property>
                    </structure>
                    <structure>
                        <property name="position">3</property>
                        <property name="name">RESPONSABLE</property>
                        <property name="dataType">string</property>
                    </structure>
                </list-property>
            </structure>
            <property name="dataSource">Data Source</property>
            <list-property name="parameters">
                <structure>
                    <property name="name">param_1</property>
                    <property name="paramName">id</property>
                    <property name="dataType">string</property>
                    <property name="position">1</property>
                    <property name="isInput">true</property>
                    <property name="isOutput">false</property>
                </structure>
            </list-property>
            <list-property name="resultSet">
                <structure>
                    <property name="position">1</property>
                    <property name="name">OBJETIVO</property>
                    <property name="nativeName">OBJETIVO</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">2</property>
                    <property name="name">META</property>
                    <property name="nativeName">META</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">3</property>
                    <property name="name">RESPONSABLE</property>
                    <property name="nativeName">RESPONSABLE</property>
                    <property name="dataType">string</property>
                </structure>
            </list-property>
            <property name="queryText">SELECT ESP.OBJ_DESCRIPCION AS OBJETIVO, OBJ.ACT_DESCRIPCION AS META, PER.PER_NOMBRE1||' '||DECODE(PER.PER_NOMBRE2, PER.PER_NOMBRE2,PER.PER_NOMBRE2,NULL,' ')||' '||PER.PER_APELLIDO1||' '||DECODE(PER.PER_APELLIDO2, PER.PER_APELLIDO2,PER.PER_APELLIDO2,NULL,' ') RESPONSABLE
FROM HER_OBJ_ESP_ACTIVIDAD OBJ, HER_OBJETIVO_ESPECIFICO ESP, HER_PROYECTO PRY, HER_PERSONA PER
WHERE PRY.PRY_ID = OBJ.PRY_ID
AND OBJ.OBJ_ID = ESP.OBJ_ID
AND PER.PER_ID = OBJ.INV_ID
AND PER.TDO_ID = OBJ.TDO_ID
AND PRY.PRY_ID = ?</property>
        </oda-data-set>
        <oda-data-set extensionID="org.eclipse.birt.report.data.oda.jdbc.JdbcSelectDataSet" name="GrupoInvestigacion" id="10597">
            <structure name="cachedMetaData">

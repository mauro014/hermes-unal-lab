                <structure>
                    <property name="position">1</property>
                    <property name="name">GRU_ID</property>
                    <property name="nativeName">GRU_ID</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">2</property>
                    <property name="name">INV_ID</property>
                    <property name="nativeName">INV_ID</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">3</property>
                    <property name="name">INTEGRANTES</property>
                    <property name="nativeName">INTEGRANTES</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">4</property>
                    <property name="name">INI_URL_WEB_DOCENTE</property>
                    <property name="nativeName">INI_URL_WEB_DOCENTE</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">5</property>
                    <property name="name">DPN_NOMBRE</property>
                    <property name="nativeName">DPN_NOMBRE</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">6</property>
                    <property name="name">ING_FUNCION</property>
                    <property name="nativeName">ING_FUNCION</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">7</property>
                    <property name="name">SED_NOMBRE</property>
                    <property name="nativeName">SED_NOMBRE</property>
                    <property name="dataType">string</property>
                </structure>
            </list-property>
            <property name="queryText">SELECT     GRU.GRU_ID,   INI.INV_ID, 
PER.PER_APELLIDO1||' '||DECODE(PER.PER_APELLIDO2, PER.PER_APELLIDO2,PER.PER_APELLIDO2,NULL,' ')||' '||PER.PER_NOMBRE1||' '||DECODE(PER.PER_NOMBRE2, PER.PER_NOMBRE2,PER.PER_NOMBRE2,NULL,' ')INTEGRANTES,
INI.INI_URL_WEB_DOCENTE,DPN.DPN_NOMBRE,ING.ING_FUNCION,SED.SED_NOMBRE
FROM HER_GRUPO GRU  , HER_GRUPO_PROYECTO GRP, HER_PROYECTO PRY, HER_INVESTIGADOR_GRUPO ING,
HER_PERSONA PER, HER_INVESTIGADOR_INTERNO INI, HER_DEPENDENCIA DPN, HER_SEDE SED
WHERE PRY.PRY_ID = ?
AND GRP.PRY_ID = PRY.PRY_ID
AND GRU.GRU_ID = GRP.GRU_ID
AND GRU.GRU_ID = ING.GRU_ID
AND ING.INV_ID = INI.INV_ID
AND PER.PER_ID = ING.INV_ID
 AND PER.PER_ID = INI.INV_ID
 AND INI.DPN_ID = DPN.DPN_ID
 AND SED.SED_ID = SUBSTR(DPN.DPN_ID,1,1)</property>
        </oda-data-set>

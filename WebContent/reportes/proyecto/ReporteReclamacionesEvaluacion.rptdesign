                    <property name="name">CNP_TITULO</property>
                    <property name="nativeName">CNP_TITULO</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">2</property>
                    <property name="name">CON_TITULO</property>
                    <property name="nativeName">CON_TITULO</property>
                    <property name="dataType">string</property>
                </structure>
            </list-property>
            <property name="queryText">SELECT CNP_TITULO, CON_TITULO
 FROM HER_CONVOCATORIA_PADRE CP, HER_CONVOCATORIA C, HER_PROYECTO P
 WHERE CP.CNP_ID = C.CNP_ID
 AND C.CON_ID= P.MOD_ID
 AND P.PRY_ID = ?</property>
        </oda-data-set>

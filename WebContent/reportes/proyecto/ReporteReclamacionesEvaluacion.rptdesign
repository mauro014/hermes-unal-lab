                    <property name="position">11</property>
                    <property name="name">PRY_RECLAMACION_EVAL</property>
                    <property name="nativeName">PRY_RECLAMACION_EVAL</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">12</property>
                    <property name="name">ESTADO_RECLAMACION</property>
                    <property name="nativeName">ESTADO_RECLAMACION</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">13</property>
                    <property name="name">RESPUESTA_RECLAMACION</property>
                    <property name="nativeName">RESPUESTA_RECLAMACION</property>
                    <property name="dataType">string</property>
                </structure>
            </list-property>
            <property name="queryText">SELECT PRY.PRY_NOMBRE,PRY.PRY_ID, PRY.PRY_DURACION, PRY.PRY_DURACION_TIPO, INP.INP_DEDICACION_HORAS_SEMANA,
PER.PER_NOMBRE1||' '||DECODE(PER.PER_NOMBRE2, PER.PER_NOMBRE2,PER.PER_NOMBRE2,NULL,' ')||' '||PER.PER_APELLIDO1||' '||DECODE(PER.PER_APELLIDO2, PER.PER_APELLIDO2,PER.PER_APELLIDO2,NULL,' ')PRINCIPAL,
PER.PER_ID, PER.PER_EMAIL, PER.PER_TELEFONO , PER.PER_DIRECCION, PRY.PRY_RECLAMACION_EVAL, DECODE (PRY.PRY_ESTADO_RECLAMACION_EVAL, 'E', 'Enviador por el profesor', 'A', 'Aceptada', 'R', 'Rechazada') as "ESTADO_RECLAMACION", PRY.PRY_RESPUESTA_RECLAMACION_EVAL AS "RESPUESTA_RECLAMACION"
FROM HER_PROYECTO PRY, HER_INVESTIGADOR_PROYECTO INP, HER_PERSONA PER
WHERE PRY.PRY_ID = ?
AND PER.PER_ID = INP.INV_ID
AND PRY.PRY_ID=INP.PRY_ID
AND INP.INP_TIPO ='P'</property>
        </oda-data-set>

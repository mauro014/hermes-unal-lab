                    <property name="position">1</property>
                    <property name="isInput">true</property>
                    <property name="isOutput">false</property>
                </structure>
            </list-property>
            <list-property name="resultSet">
                <structure>
                    <property name="position">1</property>
                    <property name="name">COORDINADOR</property>
                    <property name="nativeName">COORDINADOR</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">2</property>
                    <property name="name">CORREC_COORDINADOR</property>
                    <property name="nativeName">CORREC_COORDINADOR</property>
                    <property name="dataType">string</property>
                </structure>
            </list-property>
            <property name="queryText">SELECT PER.PER_NOMBRE1||' '||DECODE(PER.PER_NOMBRE2, PER.PER_NOMBRE2,PER.PER_NOMBRE2,NULL,' ')||' '||PER.PER_APELLIDO1||' '||DECODE(PER.PER_APELLIDO2, PER.PER_APELLIDO2,PER.PER_APELLIDO2,NULL,' ') COORDINADOR, PER.PER_EMAIL AS CORREC_COORDINADOR
FROM HER_PROYECTO PRY, HER_SEG_PROYECTO_PERSONA SEG, HER_PERSONA PER
WHERE PRY.PRY_ID = ?
AND PRY.PRY_ID = SEG.PRY_ID
AND SEG.PER_EVALUACION = PER.PER_ID
AND SEG.TDO_ID3 = PER.TDO_ID</property>
        </oda-data-set>

                </structure>
            </list-property>
            <property name="queryText">SELECT TRU_NOMBRE  Rubro, g.GST_VIGENCIA Vigencia, 
gst_descripcion Descripción,gst_cantidad Cantidad,GST_VALOR Valor,
0 cero1 ,GST_VALOR gv2, 0 cero2,0 cero3, 0 cero4,GST_VALOR gv3 
  FROM  HER_GASTO g, 
HER_TIPO_RUBRO tr, HER_FINANCIACION f 
WHERE 
g.fin_ID = f.fin_ID AND 
g.tru_id =tr.TRU_ID AND 
tr.tru_id IN (14) AND
g.GST_VIGENCIA = 1 AND
PRY_ID = ?</property>
        </oda-data-set>

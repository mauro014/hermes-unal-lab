            <property name="queryText">SELECT  pe.PER_NOMBRE1,pe.PER_NOMBRE2,pe.PER_APELLIDO1,pe.PER_APELLIDO2,
pe.per_id, pe.PER_EMAIL,  INP_DEDICACION_HORAS_SEMANA,INP_FUNCION
FROM HER_PROYECTO p, HER_INVESTIGADOR_PROYECTO ip, HER_PERSONA pe
WHERE p.pry_id = ?
AND pe.PER_ID = ip.INV_ID
AND p.pry_id=ip.PRY_ID
--AND ip.INP_TIPO &lt;> 'P'</property>
        </oda-data-set>

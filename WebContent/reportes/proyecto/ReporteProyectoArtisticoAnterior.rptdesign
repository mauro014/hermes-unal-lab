                    <expression name="defaultValue">6029</expression>
                    <property name="isInput">true</property>
                    <property name="isOutput">false</property>
                </structure>
            </list-property>
            <list-property name="resultSet">
                <structure>
                    <property name="position">1</property>
                    <property name="name">ROWNUM</property>
                    <property name="nativeName">ROWNUM</property>
                    <property name="dataType">decimal</property>
                </structure>
                <structure>
                    <property name="position">2</property>
                    <property name="name">SUBSTR(ACT_DESCRIPCION,1,100)</property>
                    <property name="nativeName">SUBSTR(ACT_DESCRIPCION,1,100)</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">3</property>
                    <property name="name">ACT_SEMANA_INICIAL</property>
                    <property name="nativeName">ACT_SEMANA_INICIAL</property>
                    <property name="dataType">decimal</property>
                </structure>
                <structure>
                    <property name="position">4</property>
                    <property name="name">ACT_DURACION_SEMANAS</property>
                    <property name="nativeName">ACT_DURACION_SEMANAS</property>
                    <property name="dataType">decimal</property>
                </structure>
            </list-property>
            <property name="queryText">SELECT   ROWNUM,substr(ACT_DESCRIPCION,1,100) , ACT_SEMANA_INICIAL, ACT_DURACION_SEMANAS 
FROM HER_PROYECTO p  ,HER_ACTIVIDAD A
WHERE p.pry_id = ?
AND p.PRY_ID=A.PRY_ID 
order by rownum desc
</property>
        </oda-data-set>

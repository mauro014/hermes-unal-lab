                    <expression name="defaultValue">5555</expression>
                    <property name="isInput">true</property>
                </structure>
            </list-property>
            <list-property name="resultSet">
                <structure>
                    <property name="position">1</property>
                    <property name="name">DPN_ID</property>
                    <property name="nativeName">DPN_ID</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">2</property>
                    <property name="name">DPN_ID_2</property>
                    <property name="nativeName">DPN_ID_2</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">3</property>
                    <property name="name">DPN_NOMBRE</property>
                    <property name="nativeName">DPN_NOMBRE</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">4</property>
                    <property name="name">SED_NOMBRE</property>
                    <property name="nativeName">SED_NOMBRE</property>
                    <property name="dataType">string</property>
                </structure>
            </list-property>
            <property name="queryText">SELECT  
   D.DPN_ID  , d1.dpn_id_2 , d.DPN_NOMBRE, SED_NOMBRE
FROM HER_PROYECTO p, HER_INVESTIGADOR_INTERNO   II, HER_SEDE S, 
HER_DEPENDENCIA D  , HER_DEPENDENCIA D1  , HER_INVESTIGADOR_PROYECTO IP
WHERE p.pry_id =  ?
AND IP.PRY_ID = P.PRY_ID
AND II.INV_ID = IP.INV_ID
AND IP.INP_TIPO = 'P'
AND II.DPN_ID = D.DPN_ID  
AND D.SED_ID = S.SED_ID 
AND ii.DPN_ID = d1.DPN_ID </property>
        </oda-data-set>

            <property name="queryText">SELECT p.pry_nombre,p.pry_id, pe.PER_NOMBRE1,pe.PER_NOMBRE2,pe.PER_APELLIDO1,pe.PER_APELLIDO2,
pe.per_id, pe.PER_EMAIL, pe.PER_TELEFONO , pe.per_direccion
FROM HER_PROYECTO p, HER_INVESTIGADOR_PROYECTO ip, HER_PERSONA pe
WHERE p.pry_id = ?
AND pe.PER_ID = ip.INV_ID
AND p.pry_id=ip.PRY_ID
AND ip.INP_TIPO ='P'</property>
        </oda-data-set>

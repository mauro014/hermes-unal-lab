            <property name="queryText">select p.PRY_ID, p.pry_lugar, ci.CIU_NOMBRE, d.DEP_NOMBRE 
from her_proyecto p,  HER_CIUDAD ci,  HER_PROYECTO_CIUDAD pryc, HER_DEPARTAMENTO D

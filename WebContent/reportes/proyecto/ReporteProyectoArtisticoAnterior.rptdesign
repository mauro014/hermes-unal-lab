                    <property name="name">DPN_NOMBRE</property>
                    <property name="nativeName">DPN_NOMBRE</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">9</property>
                    <property name="name">ING_FUNCION</property>
                    <property name="nativeName">ING_FUNCION</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">10</property>
                    <property name="name">SED_NOMBRE</property>
                    <property name="nativeName">SED_NOMBRE</property>
                    <property name="dataType">string</property>
                </structure>
            </list-property>
            <property name="queryText">SELECT     G.GRU_ID,   II.INV_ID, PER_NOMBRE1,PER_NOMBRE2, PER_APELLIDO1,PER_APELLIDO2,
   INI_URL_WEB_DOCENTE,DPN_NOMBRE,ING_FUNCION,s.SED_NOMBRE
FROM HER_GRUPO G  , HER_GRUPO_PROYECTO GP, HER_PROYECTO P, HER_INVESTIGADOR_GRUPO IG,
HER_PERSONA PER, HER_INVESTIGADOR_INTERNO II, HER_DEPENDENCIA D, her_sede s
WHERE p.pry_id = ?
AND GP.PRY_ID = P.PRY_ID
AND G.GRU_ID = GP.GRU_ID
AND G.GRU_ID = IG.GRU_ID
AND IG.INV_ID = II.INV_ID
AND PER.PER_ID = IG.INV_ID
 AND PER.PER_ID = II.INV_ID
 AND II.DPN_ID = D.DPN_ID
 AND s.SED_ID = SUBSTR(D.DPN_ID,1,1)</property>
        </oda-data-set>

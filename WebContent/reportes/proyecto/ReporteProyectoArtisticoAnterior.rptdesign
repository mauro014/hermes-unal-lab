            <property name="queryText">SELECT    p.pry_id,  G.GRU_NOMBRE, G.GRU_CATEGORIA_COLCIENCIAS,
GRC_NOMBRE,GRU_HISTORIA, GRU_EXPERIENCIA  
FROM HER_PROYECTO p , HER_GRUPO_PROYECTO GP,HER_GRUPO_CATEGORIA GC,
HER_GRUPO G
WHERE p.pry_id = ?
  AND   gp.PRY_ID = p.pry_id 
 AND G.GRU_ID = GP.GRU_ID
AND G.GRU_CATEGORIA_COLCIENCIAS= GRC_ID</property>
        </oda-data-set>

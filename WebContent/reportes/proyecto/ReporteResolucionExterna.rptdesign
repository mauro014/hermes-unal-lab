            <property name="queryText">select p.PRY_ACTO_ADM_EXTERNO, p.PRY_ACT_NOMBRE, p.PRY_ACT_NUMERO,
c.CNV_NOMBRE, c.CNV_NUM_CONTRATO, c.CNV_VALOR_TOTAL, c.CNV_FECHA_INICIO, 
c.CNV_FECHA_FIN, c.CNV_VIGENCIA_LEG, c.CNV_OBJETO,
CNV_MONTO_EJECUTAR_UN 
from her_proyecto p, her_convenio c
where p.PRY_ID = ?
and p.PRY_ID = c.PRY_ID</property>

                    <property name="nativeName">SED_NOMBRE</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">2</property>
                    <property name="name">DPN_NOMBRE</property>
                    <property name="nativeName">DPN_NOMBRE</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">3</property>
                    <property name="name">DPN_ID</property>
                    <property name="nativeName">DPN_ID</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">4</property>
                    <property name="name">SED_CIUDAD</property>
                    <property name="nativeName">SED_CIUDAD</property>
                    <property name="dataType">string</property>
                </structure>
            </list-property>
            <property name="queryText">select s.SED_NOMBRE, d2.DPN_NOMBRE, d.DPN_ID, s.SED_CIUDAD
from her_proyecto p, her_investigador_proyecto ip, her_investigador_interno i, 
her_dependencia d, her_sede s, her_dependencia d2
where p.PRY_ID = ?
and p.PRY_ID = ip.PRY_ID
and ip.INV_ID = i.INV_ID
and ip.TDO_ID = i.TDO_ID
and i.DPN_ID = d.DPN_ID
and ip.INP_TIPO = 'P'
and d.SED_ID = s.SED_ID
and d.DPN_FACULTAD = d2.DPN_ID

</property>

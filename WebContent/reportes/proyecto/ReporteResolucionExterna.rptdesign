                <structure>
                    <property name="position">2</property>
                    <property name="name">GST_DESCRIPCION</property>
                    <property name="nativeName">GST_DESCRIPCION</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">3</property>
                    <property name="name">ESPECIE</property>
                    <property name="nativeName">ESPECIE</property>
                    <property name="dataType">decimal</property>
                </structure>
                <structure>
                    <property name="position">4</property>
                    <property name="name">EFECTIVO</property>
                    <property name="nativeName">EFECTIVO</property>
                    <property name="dataType">decimal</property>
                </structure>
                <structure>
                    <property name="position">5</property>
                    <property name="name">FFI_DESCRIPCION</property>
                    <property name="nativeName">FFI_DESCRIPCION</property>
                    <property name="dataType">string</property>
                </structure>
            </list-property>
            <property name="queryText">SELECT TRU_NOMBRE  Rubro, 
		g.GST_DESCRIPCION,
       g.gst_valor especie,
       g.gst_valor2 efectivo,
       ff.ffi_descripcion
  FROM HER_GASTO g, 
       HER_TIPO_RUBRO tr, 
       HER_FINANCIACION f , 
       her_fuente_financiacion ff
WHERE ff.FFI_INTERNA_EXTERNA in ('E', 'A') 
  AND g.fin_ID = f.fin_ID 
  AND ff.FFI_ID = f.FFI_ID 
  AND g.tru_id =tr.TRU_ID
  AND tr.TRU_ID = 170
  AND (F.FIN_ES_LEGALIZACION IS NOT NULL AND F.FIN_ES_LEGALIZACION = 'SI')
  AND PRY_ID = ?
ORDER BY g.GST_DESCRIPCION</property>

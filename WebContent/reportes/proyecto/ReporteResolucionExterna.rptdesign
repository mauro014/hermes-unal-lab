                </structure>
                <structure>
                    <property name="position">8</property>
                    <property name="name">FFI_DESCRIPCION</property>
                    <property name="nativeName">FFI_DESCRIPCION</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">9</property>
                    <property name="name">PRY_DURACION</property>
                    <property name="nativeName">PRY_DURACION</property>

            </list-property>
            <property name="queryText">select PER_GENERO, per.per_nombre1, per.per_nombre2, per.per_apellido1, per.per_apellido2,
td.TDO_NOMBRE, per.per_id, ip.INP_DEDICACION_HORAS_SEMANA
from her_proyecto p, her_investigador_proyecto ip, her_persona per, her_tipo_documento td
where p.pry_id = ?
and p.pry_id = ip.pry_id
and ip.inv_id = per.per_id
and ip.tdo_id = per.tdo_id
and ip.INP_TIPO = 'P'
and per.tdo_id = td.tdo_id</property>

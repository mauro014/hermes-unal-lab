            <property name="queryText">select PAR.VALOR Director, PAR.DESCRIPCION Cargo, PAR.ADJUNTO Firma
from her_parametro par, her_proyecto p, her_convocatoria c, her_convocatoria_padre cp
where p.PRY_ID = ?
and p.MOD_ID = c.CON_ID
and c.CNP_ID = cp.CNP_ID
and cp.DNP_ID = par.PROFESION
and par.NOMBRE = 'SEG_FIRMA' </property>

            <property name="queryText">SELECT PRY.PRY_NOMBRE, PRY.PRY_ID,
PRY_TIPOLOGIA_SEC, PRY_EMPRESA_EJECUTORA,
PRY_FECHA_TENTATIVA_INICIO, PRY_FECHA_FINAL,
PRY_CONT_EFECT_FINAL_UN, PRY_CONT_ESPEC_FINAL_UN,
PRY_VALOR_TOTAL, PRY_DURACION, 
(select dd.DOMDET_DESCRIPCION
          from HER_DOMINIO_DETALLE dd
         where dd.domdet_tipo = pry.PRY_TIPO_ACTIV_ECP
           and dd.dom_id = 118 )  PRY_TIPOLOGIA_QP, 
PER.PER_NOMBRE1||' '||DECODE(PER.PER_NOMBRE2, PER.PER_NOMBRE2,PER.PER_NOMBRE2,NULL,' ')||' '||PER.PER_APELLIDO1||' '||DECODE(PER.PER_APELLIDO2, PER.PER_APELLIDO2,PER.PER_APELLIDO2,NULL,' ')PRINCIPAL,
DPN1.DPN_NOMBRE, DPN.DPN_NOMBRE, CNP.CNP_TITULO
FROM HER_CONVOCATORIA_PADRE CNP, HER_CONVOCATORIA CON, 
HER_PROYECTO PRY, HER_INVESTIGADOR_PROYECTO INP, HER_PERSONA PER,
HER_DEPENDENCIA DPN,  HER_DEPENDENCIA DPN1, HER_INVESTIGADOR_INTERNO INI
WHERE
     PRY.MOD_ID = CON.CON_ID
AND  CON.CNP_ID = CNP.CNP_ID
AND  PRY.PRY_ID = ?
AND  PER.PER_ID = INI.INV_ID
AND  PER.TDO_ID = INI.TDO_ID
AND  INP.INV_ID = PER.PER_ID
AND  PRY.PRY_ID = INP.PRY_ID
AND INP.INP_TIPO ='P'
AND  DPN.DPN_ID   = INI.DPN_ID
AND  DPN.DPN_ID_2 = DPN1.DPN_ID</property>

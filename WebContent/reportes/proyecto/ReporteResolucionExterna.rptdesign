            </list-property>
            <property name="queryText">SELECT TRU_NOMBRE  Rubro, 
       g.gst_valor especie,
       g.gst_valor2 efectivo,
       g.gst_valor3,
       g.gst_valor4,
       g.gst_valor5,
       g.gst_valor6,
       ff.ffi_descripcion,
       p.PRY_DURACION,
       p.MOD_ID
  FROM HER_GASTO g, 
       HER_TIPO_RUBRO tr, 
       HER_FINANCIACION f , 
       her_fuente_financiacion ff,
       HER_PROYECTO p
WHERE g.fin_ID = f.fin_ID 
  AND ff.FFI_ID = f.FFI_ID 
  AND g.tru_id =tr.TRU_ID
  AND tr.TRU_ID NOT IN (93, 149, 150)
  AND  (F.FFE_TIPO_ENTIDAD = 'F' OR F.FFE_TIPO_ENTIDAD is null)
  AND P.PRY_ID = ?
  AND f.PRY_ID =  p.PRY_ID
  AND (FIN_ES_LEGALIZACION IS NULL OR  FIN_ES_LEGALIZACION = 'NO')
ORDER BY g.GST_DESCRIPCION</property>

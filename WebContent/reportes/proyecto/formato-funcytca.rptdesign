                <structure>
                    <property name="position">3</property>
                    <property name="name">ACT_MOV_DESCRIPCION</property>
                    <property name="nativeName">ACT_MOV_DESCRIPCION</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">4</property>
                    <property name="name">ACT_MOV_DURACION</property>
                    <property name="nativeName">ACT_MOV_DURACION</property>

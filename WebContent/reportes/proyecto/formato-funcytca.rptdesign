p.PRY_OBJETIVO_GENERAL, PRY_METODOLOGIA,PRY_IMPACTO_ESPERADO,PRY_CONSIDERACIONES_ETICAS,PRY_PROPIEDAD_INTELECTUAL, LINEA_BASE_PROYECTO, PRY_TIENE_PRY, PRY_PRY_ASOCIADO 
FROM HER_PROYECTO p  
WHERE p.pry_id = ?</property>

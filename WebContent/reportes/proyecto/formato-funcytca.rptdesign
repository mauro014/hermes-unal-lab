            <property name="queryText">SELECT PRY.PRY_ID AS CODI, PRY.PRY_NOMBRE AS NOMBREPROYECTO, PRY.PRY_DURACION AS DURACION, PRY.PRY_FECHA_TENTATIVA_INICIO AS FECHAINICIO, PRY.PRY_DIRECTOR_EXTERNO AS DIRECTOR, TDOC.TDO_NOMBRE AS TDOCDIR, PRY.PRY_DOC_EXTERNO AS DOCDIR,
AREA.DOMDET_DESCRIPCION AS AREATRABAJO, COMP.DOMDET_DESCRIPCION AS COMPONENTE, PRY.PRY_ABSTRACT AS RESUMEN, PRY.PRY_MARCO_TEORICO AS DESCOPORTUNIDAD, PRY.PRY_OBJETIVO_GENERAL AS OBJGENERAL, PRY.PRY_IMPACTO_ESPERADO AS IMPACTOESP,
PRY.PRY_DESCRIPCION AS POBLACIONBENE
FROM HER_PROYECTO PRY, HER_TIPO_DOCUMENTO TDOC, HER_DOMINIO_DETALLE AREA, HER_DOMINIO_DETALLE COMP
WHERE PRY.PRY_ID = ?
AND  TDOC.TDO_ID = PRY.PRY_TIPO_DOC_EXTERNO
AND AREA.DOM_ID = 126
AND PRY.PRY_OBJETIVO_SOCIO_ECONOMICO =  AREA.DOMDET_TIPO
AND COMP.DOM_ID = 127
AND PRY.PRY_ROL_UNIVERSIDAD =  COMP.DOMDET_TIPO</property>
        </oda-data-set>

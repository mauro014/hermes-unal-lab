            <property name="queryText">SELECT OBJ_ID,p.PRY_ID, OBJ_DESCRIPCION
FROM HER_PROYECTO p  ,HER_OBJETIVO_ESPECIFICO oe
WHERE p.pry_id = ?
AND p.PRY_ID=oe.PRY_ID
order by OBJ_ID</property>

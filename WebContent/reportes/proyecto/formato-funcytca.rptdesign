                </structure>
                <structure>
                    <property name="position">3</property>
                    <property name="name">SUBSTR(ACT_DESCRIPCION,1,1000)</property>
                    <property name="nativeName">SUBSTR(ACT_DESCRIPCION,1,1000)</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">4</property>
                    <property name="name">MESI</property>

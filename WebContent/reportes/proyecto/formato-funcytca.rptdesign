                </structure>
                <structure>
                    <property name="position">5</property>
                    <property name="name">ACT_MOV_FECHA</property>
                    <property name="nativeName">ACT_MOV_FECHA</property>
                    <property name="dataType">date-time</property>
                </structure>
            </list-property>
            <property name="queryText">SELECT TIPACT.TAMVE_NOMBRE, ACT.ACT_MOV_NOMCURSO, ACT.ACT_MOV_DESCRIPCION, ACT.ACT_MOV_DURACION, ACT.ACT_MOV_FECHA 
FROM HER_ACTIVIDAD_MOVILIDAD_VE ACT, HER_PROYECTO PRY, HER_MOVILIDAD_VISITANTES_EXT EXT, HER_TIPO_ACTIVIDAD_MOV_VE TIPACT
WHERE EXT.MOV_ID = ACT.MOV_ID
AND EXT.PRY_ID = PRY.PRY_ID
AND PRY.PRY_ID = ?
AND TIPACT.TAMVE_ID = ACT.TAMVE_ID</property>
        </oda-data-set>

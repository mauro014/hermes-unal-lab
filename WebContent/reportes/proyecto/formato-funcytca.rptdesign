                    <property name="position">1</property>
                    <property name="name">TIPOENT</property>
                    <property name="nativeName">TIPOENT</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">2</property>
                    <property name="name">NOMBREENT</property>
                    <property name="nativeName">NOMBREENT</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">3</property>
                    <property name="name">ESPECIE</property>
                    <property name="nativeName">ESPECIE</property>
                    <property name="dataType">decimal</property>
                </structure>
                <structure>
                    <property name="position">4</property>
                    <property name="name">EFECTIVO</property>
                    <property name="nativeName">EFECTIVO</property>
                    <property name="dataType">decimal</property>
                </structure>
            </list-property>
            <property name="queryText">SELECT DD.DOMDET_DESCRIPCION AS TIPOENT,  FF.FFI_DESCRIPCION AS NOMBREENT , F.FFE_VALOR_ESPECIE AS ESPECIE, F.FIN_VALOR AS EFECTIVO 
FROM HER_FUENTE_FINANCIACION ff, HER_FINANCIACION f, HER_DOMINIO_DETALLE DD
WHERE ff.FFI_ID = f.FFI_ID 
AND DD.DOM_ID = 129
AND DD.DOMDET_TIPO = F.FFE_TIPO_ENTIDAD
AND PRY_ID = ?</property>
        </oda-data-set>

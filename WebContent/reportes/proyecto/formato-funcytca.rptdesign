            <property name="queryText">SELECT TDOC.TDO_NOMBRE AS TIPODOC, 
PER.PER_ID AS DOC, 
PER.PER_NOMBRE1||' '||DECODE(PER.PER_NOMBRE2, PER.PER_NOMBRE2,PER.PER_NOMBRE2,NULL,' ')||' '||PER.PER_APELLIDO1||' '||DECODE(PER.PER_APELLIDO2, PER.PER_APELLIDO2,PER.PER_APELLIDO2,NULL,' ')PRINCIPAL,
replace(PER.PER_DIRECCION,'N°','No. ') AS DIRECCION, 
PER.PER_TELEFONO AS TELEFONO, 
PER.PER_EMAIL AS EMAIL, 
PER.PER_CELULAR AS CELULAR, 
PER.PER_FNACIMIENTO AS FNACIMIENTO, 
PER.PER_EDAD AS EDAD, PER.PER_FACULTAD_PREGRADO AS FACPREGRADO,  
PER.PER_PROFESION AS INSPREGRADO,
EXT.EMPRESA AS  INSTITUCION, EXT.CARGO AS ROL, 
PER.PER_RESUMEN_HDV AS IDIOMAS, EXT.NOMBRE_PROBLEMA AS REDES, 
EXT.MEDIO_PUBLICIDAD AS MEDIOPUBLI, EXT.SECTOR_EMPRESA AS ENTCONOFUNDA,
PRY.PRY_TIPO_ACTIVIDAD,
EXT.DESCRIPCION AS CLASIFICACION, 
EXT.NOMBRES_REP_LEGAL AS NOMBREDIRGRUPO, 
EXT.TIPO_DOC_REP_LEGAL AS TDOCDIRGRUPO, 
EXT.NUM_DOC_REP_LEGAL AS DOCDIRGRU
FROM HER_PERSONA PER, HER_PROYECTO PRY, HER_TIPO_DOCUMENTO TDOC, HER_EXT_PREINSCRIPCION_ECP EXT
WHERE PER.PER_ID = PRY.PRY_CREADOR_ID
AND PER.TDO_ID = PRY.PRY_CREADOR_TDO_ID
AND TDOC.TDO_ID = PER.TDO_ID
AND EXT.PRY_ID = PRY.PRY_ID
AND PRY.PRY_ID = ?
</property>
        </oda-data-set>

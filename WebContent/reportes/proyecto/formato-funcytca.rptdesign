                </structure>
            </list-property>
            <property name="queryText">SELECT   ROWNUM,ACT_DESCRIPCION,substr(ACT_DESCRIPCION,1,1000), 
(ACT_SEMANA_INICIAL+3)/4 Mesi, (ACT_DURACION_SEMANAS/4) Dura 
FROM HER_PROYECTO p  ,HER_ACTIVIDAD A
WHERE p.pry_id = ?
AND p.PRY_ID=A.PRY_ID 
ORDER BY Mesi</property>
        </oda-data-set>

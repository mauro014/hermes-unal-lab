            </list-property>
            <property name="queryText">SELECT A.ACN_NOMBRE AS NOMBRE_ARCHIVO,
DET.DOMDET_DESCRIPCION AS TIPO_ARCHIVO
FROM HER_ARCHIVO_CONVOCATORIA A,
HER_CONVOCATORIA_ALIANZAS COA,
her_dominio_detalle DET
WHERE COA.COA_ID = A.ACN_CONVOCATORIA
AND DET.DOMDET_TIPO = A.ACN_TIPO
AND COA.COA_ID = ?
</property>
        </oda-data-set>
    </data-sets>

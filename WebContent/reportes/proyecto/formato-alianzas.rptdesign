            <property name="queryText">SELECT 
PER.PER_NOMBRE1 || ' ' || PER.PER_NOMBRE2 || ' ' || PER.PER_APELLIDO1 || ' ' || PER.PER_APELLIDO2 as NOMBRE,
DEP.DPN_NOMBRE as DEPARTAMENTO, SEDE.SED_NOMBRE as SEDE, DEP2.DPN_NOMBRE as FACULTAD,
COA.COA_MOD_ID as MODALIDAD, COA.INV_ID AS CEDULA, COA.TDO_ID, COA.COA_ID,
COA.COA_GRUPO_RESPONSABLE, 
GRUPO.GRU_NOMBRE AS GRUPO,
COA.COA_TRAYECTORIA_GRUPO, 
'* ' || replace(substr(replace(replace(replace(replace(COA.COA_GRUPOS_UN_ALIANZA,CHR(10), CHR(10) || '* '),CHR(38),CHR(10)),CHR(37),CHR(10)),CHR(126) ,CHR(10) || CHR(10)  ),1,length(replace(replace(replace(replace(COA.COA_GRUPOS_UN_ALIANZA,CHR(10),CHR(10) || '* '),CHR(38),CHR(10)),CHR(37),CHR(10)),CHR(126) ,CHR(10) || CHR(10) ))-2),'~',' - ') as GRUPOS_UN_ALIANZA, 
'* ' || replace(substr(replace(replace(COA.COA_ENTIDAD_ALIADA,CHR(10),CHR(10) || '* '),CHR(126),CHR(10) || CHR(10)),1,length(replace(replace(COA.COA_ENTIDAD_ALIADA,CHR(10),CHR(10) || '* '),CHR(126),CHR(10) || CHR(10)))-2),'~',' - ') as ENTIDAD_ALIADA, 
COA.COA_NOMBRE_PROYECTO,
COA.COA_OBJETIVO, COA.COA_CONTRIBUCION,
COA.COA_LINEAS_INVESTIGACION, COA.COA_CONVOCATORIA_EXTERNA,
'* ' || replace(substr(replace(replace(COA.COA_ACTIVIDADES,'  ', ' '),CHR(10),CHR(10) || '* '),1,length(replace(replace(COA.COA_ACTIVIDADES,'  ', ' '),CHR(10),CHR(10) || '* '))-2),'~',' - ') as ACTIVIDADES, 
'* ' || replace(substr(replace(replace(COA.COA_PROPUESTA_PRESUPUESTAL,'  ', ' '),CHR(10),CHR(10) || '* '),1,length(replace(replace(COA.COA_PROPUESTA_PRESUPUESTAL,'  ', ' '),CHR(10),CHR(10) || '* '))-2),'~',' - ') as PROPUESTA_PRESUPUESTAL, 
COA.COA_FECHA_CONV_EXTERNA, COA.COA_FECHA_SOLICITUD,
COA.COA_CONTRAPARTIDA, COA.COA_PLAN_FORMACION,
COA.COA_ETAPA, COA.COA_ESTADO,
'* ' || replace(substr(replace(replace(COA.COA_FORMACION_EST,'  ', ' '),CHR(10),CHR(10) || '* '),1,length(replace(replace(COA.COA_FORMACION_EST,'  ', ' '),CHR(10),CHR(10) || '* '))-2),'~',' - ') as FORMACION_EST, 
'* ' || replace(substr(replace(replace(COA.COA_PRODUCCION_ACADEMICA,'        ', ' '),CHR(10),CHR(10) || '* '),1,length(replace(replace(COA.COA_PRODUCCION_ACADEMICA,'        ', ' '),CHR(10),CHR(10) || '* '))-2),'~',' - ') as PRODUCCION_ACADEMICA, 
COA.COA_AGENDAS_CONOCIMIENTO,
'* ' || replace(substr(replace (replace(COA.COA_DOCENTES_PARTICIPANTES,'  ', ' '),CHR(10),CHR(10) || '* '),1,length(replace (replace(COA.COA_DOCENTES_PARTICIPANTES,'  ', ' '),CHR(10),CHR(10) || '* '))-2),'~',' - ') as DOCENTES_PARTICIPANTES,
'* ' || replace(substr(replace (replace(COA.COA_PARTICIPACION_EVENTOS,'  ', ' '),CHR(10),CHR(10) || '* '),1,length(replace (replace(COA.COA_PARTICIPACION_EVENTOS,'  ', ' '),CHR(10),CHR(10) || '* '))-2),'~',' - ') as PARTICIPACION_EVENTOS,
AGD.AGD_NOMBRE AS AGENDA, AGD2.AGD_NOMBRE AS SUBTEMATICA,
COA.COA_RESULTADOS, COA.COA_PRODUCTOS_ESPERADOS, COA.COA_DURACION_PROPUESTA
FROM HER_CONVOCATORIA_ALIANZAS COA, HER_PERSONA PER,
HER_INVESTIGADOR_INTERNO II, HER_DEPENDENCIA DEP, HER_DEPENDENCIA DEP2,
HER_SEDE SEDE, HER_GRUPO GRUPO,
HER_AGENDA_CONOCIMIENTO AGD, HER_AGENDA_CONOCIMIENTO AGD2 
WHERE COA.INV_ID = PER.PER_ID 
and COA.TDO_ID = PER.TDO_ID 
AND COA.INV_ID = II.INV_ID 
and COA.TDO_ID = II.TDO_ID 
AND II.DPN_ID = DEP.DPN_ID 
AND DEP.SED_ID = SEDE.SED_ID 
AND DEP2.DPN_ID = DEP.DPN_FACULTAD
AND COA.COA_GRUPO_RESPONSABLE = GRUPO.GRU_ID
AND AGD.AGD_ID = TO_NUMBER(SUBSTR(COA.COA_AGENDAS_CONOCIMIENTO, 1, INSTR(COA.COA_AGENDAS_CONOCIMIENTO,'~')-1))
AND AGD2.AGD_ID = TO_NUMBER(SUBSTR(COA.COA_AGENDAS_CONOCIMIENTO, INSTR(COA.COA_AGENDAS_CONOCIMIENTO,'~')+1))
AND COA.COA_ID = ?</property>
        </oda-data-set>
        <oda-data-set extensionID="org.eclipse.birt.report.data.oda.jdbc.JdbcSelectDataSet" name="ArchivosAdjuntos" id="8877">

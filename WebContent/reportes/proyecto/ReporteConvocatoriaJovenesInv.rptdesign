                    <property name="dataType">string</property>
                </structure>
            </list-property>
            <property name="queryText">select gr.GRU_NOMBRE GRU_NOMBRE ,
nvl(pe.PER_APELLIDO1 || ' ' || nvl(pe.PER_APELLIDO2,'') || ' ' || pe.PER_NOMBRE1 || ' ' || nvl(pe.PER_NOMBRE2, ''),'-')  
NOMBRE_DIRECTOR_G,
c.CON_RESTRICCION
  from HER_GRUPO gr,
         HER_GRUPO_PROYECTO gpry,
         her_investigador_grupo ig,
         her_persona pe,
         her_proyecto p,
         her_convocatoria c
 WHERE gpry.PRY_ID = ?
   AND gpry.GRU_ID = gr.GRU_ID
   and gr.gru_id = ig.GRU_ID
   and ig.ING_TIPO = 'L'
   and ig.INV_ID = pe.PER_ID
   and gpry.PRY_ID = p.PRY_ID
   and p.MOD_ID = c.CON_ID</property>
        </oda-data-set>

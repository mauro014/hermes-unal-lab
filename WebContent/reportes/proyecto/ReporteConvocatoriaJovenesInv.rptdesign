                    <property name="nativeName">TINV_NOMBRE</property>
                    <property name="dataType">string</property>
                </structure>
            </list-property>
            <property name="queryText">SELECT PER.PER_ID,
       PER.PER_APELLIDO1||' '||DECODE(PER.PER_APELLIDO2, PER.PER_APELLIDO2,PER.PER_APELLIDO2,NULL,' ')||' '||PER.PER_NOMBRE1||' '||DECODE(PER.PER_NOMBRE2, PER.PER_NOMBRE2,PER.PER_NOMBRE2,NULL,' ')COINVESTIGA,
       ii.tvi_id,
       TPI.TINV_NOMBRE       
  FROM HER_INVESTIGADOR_PROYECTO INP, 
       HER_PERSONA PER, 
       HER_INVESTIGADOR_INTERNO II,
       HER_TIPO_INVESTIGADOR TPI
 WHERE PER.PER_ID = INP.INV_ID
   AND PER.TDO_ID = INP.TDO_ID
   AND INP.PRY_ID = ?
   AND INP.INP_TIPO IN ('JITU','JIPO','JIEU')
   AND INP.INV_ID = II.INV_ID
   AND INP.INP_TIPO = TPI.TINV_ID
ORDER BY INP_ID</property>
        </oda-data-set>

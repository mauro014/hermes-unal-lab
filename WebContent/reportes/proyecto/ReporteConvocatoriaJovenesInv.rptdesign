                    <property name="position">11</property>
                    <property name="name">PER_ID</property>
                    <property name="nativeName">PER_ID</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">12</property>
                    <property name="name">UNIDAD</property>
                    <property name="nativeName">UNIDAD</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">13</property>
                    <property name="name">HORA_SEMANA</property>
                    <property name="nativeName">HORA_SEMANA</property>

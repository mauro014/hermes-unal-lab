            <property name="dataSource">Fuente de datos</property>
            <list-property name="parameters">
                <structure>
                    <property name="name">param_1</property>
                    <property name="paramName">id</property>
                    <property name="dataType">string</property>
                    <property name="position">1</property>
                    <property name="isInput">true</property>
                    <property name="isOutput">false</property>
                </structure>
            </list-property>
            <list-property name="resultSet">
                <structure>
                    <property name="position">1</property>
                    <property name="name">PER_ID</property>
                    <property name="nativeName">PER_ID</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">2</property>
                    <property name="name">COINVESTIGA</property>
                    <property name="nativeName">COINVESTIGA</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">3</property>
                    <property name="name">PER_EMAIL</property>
                    <property name="nativeName">PER_EMAIL</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">4</property>
                    <property name="name">PER_TELEFONO</property>
                    <property name="nativeName">PER_TELEFONO</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">5</property>
                    <property name="name">PER_CELULAR</property>
                    <property name="nativeName">PER_CELULAR</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">6</property>
                    <property name="name">PER_FNACIMIENTO</property>
                    <property name="nativeName">PER_FNACIMIENTO</property>
                    <property name="dataType">date-time</property>
                </structure>
                <structure>
                    <property name="position">7</property>
                    <property name="name">PER_PROFESION</property>
                    <property name="nativeName">PER_PROFESION</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">8</property>
                    <property name="name">PER_NACIONALIDAD</property>
                    <property name="nativeName">PER_NACIONALIDAD</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">9</property>
                    <property name="name">CON_RESTRICCION</property>
                    <property name="nativeName">CON_RESTRICCION</property>
                    <property name="dataType">string</property>
                </structure>
            </list-property>
            <property name="queryText">SELECT
       PER.PER_ID,
       PER.PER_APELLIDO1||' '||DECODE(PER.PER_APELLIDO2, PER.PER_APELLIDO2,PER.PER_APELLIDO2,NULL,' ')||' '||PER.PER_NOMBRE1||' '||DECODE(PER.PER_NOMBRE2, PER.PER_NOMBRE2,PER.PER_NOMBRE2,NULL,' ')COINVESTIGA,
       PER.PER_EMAIL,
       PER.PER_TELEFONO,
       PER.PER_CELULAR,
       PER.PER_FNACIMIENTO,
       PER.PER_PROFESION,
       PER.PER_NACIONALIDAD,
       c.CON_RESTRICCION
  FROM HER_PERSONA PER, 
       HER_INVESTIGADOR_PROYECTO INP,
       HER_PROYECTO pry, HER_CONVOCATORIA C
 WHERE INP.PRY_ID = ?
   AND PER.PER_ID = INP.INV_ID
   AND PER.TDO_ID = INP.TDO_ID
   AND INP.INP_TIPO IN ('SEMC')
   AND pry.MOD_ID = c.CON_ID
   AND pry.PRY_ID = INP.PRY_ID
ORDER BY INP_ID
</property>
        </oda-data-set>
    </data-sets>

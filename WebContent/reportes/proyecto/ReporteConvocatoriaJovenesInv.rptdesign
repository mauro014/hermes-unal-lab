                </structure>
            </list-property>
            <property name="queryText">select upper(dd.domdet_descripcion) area,
       decode(pa.art_tipo, 1, 'Principal',
                           2, 'Secundario') ppal_sec,
                           c.CON_RESTRICCION
  from her_proyecto_area_tematica pa,
       her_dominio_detalle dd,
       HER_PROYECTO pry, HER_CONVOCATORIA C
 where pa.pry_id = ?
   and dd.domdet_tipo = pa.domdet_tipo
   and pa.pry_id = pry.pry_id
   AND pry.MOD_ID = c.CON_ID 
order by ppal_sec

 </property>
        </oda-data-set>

            <property name="queryText">SELECT SUM(GST_VALOR)  gv11,0,SUM(GST_VALOR) gv21,
0,0, 0,SUM(GST_VALOR) gv31
  FROM  HER_GASTO g, 
HER_TIPO_RUBRO tr, HER_FINANCIACION f ,
her_fuente_financiacion ff
WHERE 
g.fin_ID = f.fin_ID  
and ffi_interna_externa = 'I'
and ff.FFI_ID = f.FFI_ID 
and g.tru_id =tr.TRU_ID
and tr.tru_id IN (1,6,12,10, 3, 36,37,38,7,9,33,34,35,11,39,40,41,13,14,15,16,17,43,45,46,47,53 ) 
AND g.GST_VIGENCIA = 1 AND
PRY_ID = ?</property>
        </oda-data-set>

                </structure>
            </list-property>
            <property name="queryText">SELECT
PER.PER_APELLIDO1||' '||DECODE(PER.PER_APELLIDO2, PER.PER_APELLIDO2,PER.PER_APELLIDO2,NULL,' ')||' '||PER.PER_NOMBRE1||' '||DECODE(PER.PER_NOMBRE2, PER.PER_NOMBRE2,PER.PER_NOMBRE2,NULL,' ')COINVESTIGA,
PER.PER_ID, PER.PER_EMAIL,  INP_DEDICACION_HORAS_SEMANA DED,
DECODE ( INV.INV_INTERNO, 'S', 'I',
                          'N', 'E') IE
 ,INP_FUNCION
FROM HER_PROYECTO PRY, HER_INVESTIGADOR_PROYECTO INP, HER_PERSONA PER, HER_INVESTIGADOR INV
WHERE PRY.PRY_ID = ?
AND PER.PER_ID = INP.INV_ID
AND PER.TDO_ID = INP.TDO_ID
AND PER.PER_ID = INV.INV_ID
AND PER.TDO_ID = INV.TDO_ID
AND INV.INV_ID = INP.INV_ID
AND INV.TDO_ID = INP.TDO_ID
AND PRY.PRY_ID=INP.PRY_ID
ORDER BY INP_ID</property>
        </oda-data-set>

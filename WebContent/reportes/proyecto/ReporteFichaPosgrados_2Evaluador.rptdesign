            <property name="queryText"> SELECT TRU_NOMBRE  Rubro, SUM(GST_VALOR) Valor, GST_VIGENCIA VIGENCIA, g.GST_DESCRIPCION Desc_Gasto
  FROM  HER_GASTO g, 
HER_TIPO_RUBRO tr, HER_FINANCIACION f , her_fuente_financiacion ff
WHERE 
ff.FFI_INTERNA_EXTERNA in ('I', 'O')
AND g.fin_ID = f.fin_ID 
AND ff.FFI_ID = f.FFI_ID 
AND g.tru_id =tr.TRU_ID
AND PRY_ID = ?
GROUP BY TRU_NOMBRE, GST_VIGENCIA, g.GST_DESCRIPCION 
ORDER BY g.GST_DESCRIPCION </property>
        </oda-data-set>

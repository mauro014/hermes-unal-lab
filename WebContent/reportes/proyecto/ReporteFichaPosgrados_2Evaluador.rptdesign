            <property name="queryText">SELECT distinct (dd.DOMDET_DESCRIPCION)
  FROM HER_PROYECTO p, HER_PROYECTO_area_tematica at , HER_dominio_detalle   dd
 WHERE p.pry_id = ?
   AND at.PRY_ID = p.pry_id 
   AND at.DOM_ID = dd.DOM_ID
   and at.DOMDET_TIPO = dd.DOMDET_TIPO
   and at.ART_TIPO = 1</property>
        </oda-data-set>

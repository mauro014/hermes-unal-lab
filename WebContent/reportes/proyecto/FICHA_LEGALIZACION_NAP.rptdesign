                    <property name="nativeName">TIPOEJECUCION</property>
                    <property name="dataType">string</property>
                </structure>
            </list-property>
            <property name="queryText">select c.CNV_FECHA_INICIO, CNV_VIGENCIA_LEG, c.CNV_FECHA_FIN, c.CNV_NUM_CONTRATO, C.CNV_SUPERVISOR_EXT, 
	C.CNV_SUPERVISOR_EXT_CARGO, 
	(select f.FFI_DESCRIPCION from her_fuente_financiacion f
	where f.ffi_id = C.CNV_SUPERVISOR_ENTIDAD) entidadConvenio,
	C.CNV_SUPERVISOR_INTERNO, C.CNV_SUPERVISOR_INT_CARGO,
	CNV_ASISTENTE_PRY, CNV_ASISTENTE_EXTENSION, CNV_VALOR_TOTAL, CNV_VALOR_EFECTIVO, CNV_VALOR_ESPECIE,
	c.CNV_MONTO_EJECUTAR_UN, pry.PRY_CONT_EFECT_FINAL_UN, pry.PRY_CONT_ESPEC_FINAL_UN, CNV_NOMBRE, 
	(select d.dpn_nombre from her_dependencia d 
	where d.dpn_id = c.CNV_DEPENDENCIA_FIRMA) dpn_firma,
	CNV_DESIGNADO_CARGO, CNV_DESIGNADO_FIRMA, 
	(select d.DOMDET_DESCRIPCION from her_dominio_detalle d
	where d.DOMDET_TIPO = c.CNV_MODALIDAD_CONTRAT
	and d.DOM_ID = '134') modalidad_contrat,
	c.CNV_PROPIEDAD_INTELECT, c.CNV_CONFIDENCIALIDAD,
	c.CNV_CLAUSULA_PENAL, c.CNV_CLAUSULA_MULTAS,
	c.CNV_PROPIEDAD_BIENES, CNV_AUTORIZACION_CC,
	CNV_AUTORIZACION_CI, CNV_AUTORIZACION_CR, CNV_CARGO_ASISTENTE,
	DECODE(pry.PRY_TIPOLOGIA, 'E', 'Ejecución técnica', 'ETF', 'Ejecución técnica y financiera',
        '--') TIPOEJECUCION
  from HER_PROYECTO pry,
         HER_CONVENIO c    
 WHERE pry.PRY_ID = ?
   AND c.PRY_ID = pry.PRY_ID</property>
        </oda-data-set>
        <oda-data-set extensionID="org.eclipse.birt.report.data.oda.jdbc.JdbcSelectDataSet" name="Participantes" id="11239">

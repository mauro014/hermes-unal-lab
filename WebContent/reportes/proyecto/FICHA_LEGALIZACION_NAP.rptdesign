            <property name="queryText">select EPL_ID, epr_nombre estado, hel_fecha, hel_justificacion
from HER_HISTORICO_ESTADO_LEGALI hl
inner join her_estado_proyecto ep on hl.epl_id = ep.epr_id
where pry_id = ?
order by hel_fecha asc</property>
        </oda-data-set>

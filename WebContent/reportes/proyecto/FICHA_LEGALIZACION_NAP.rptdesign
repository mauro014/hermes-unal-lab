            <property name="queryText">SELECT P.PRY_JUSTIFICAC_EXONERAC_CI JUSTIFICACION, 
PRY_JUSTIFICAC_EXONERAC_TRANSF MOTIVO,
PRY_MOTIVO_NOAP_OTRO OTRO_MOTIVO,

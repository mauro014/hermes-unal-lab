                </structure>
                <structure>
                    <property name="position">2</property>
                    <property name="name">TDO_NOMBRE</property>
                    <property name="nativeName">TDO_NOMBRE</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">3</property>
                    <property name="name">NOMBRE</property>
                    <property name="nativeName">NOMBRE</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">4</property>
                    <property name="name">TINV_NOMBRE</property>
                    <property name="nativeName">TINV_NOMBRE</property>
                    <property name="dataType">string</property>
                </structure>
            </list-property>
            <property name="queryText">select ip.INV_ID,  td.TDO_NOMBRE, per.PER_NOMBRE1 || ' ' || per.PER_NOMBRE2 || ' ' || per.PER_APELLIDO1 || ' ' || per.PER_APELLIDO2 AS NOMBRE, TI.TINV_NOMBRE
from her_proyecto p, HER_TIPO_INVESTIGADOR ti, her_investigador_proyecto ip, her_persona per, her_tipo_documento td
where p.PRY_ID = ip.PRY_ID
and ip.INV_ID = per.PER_ID
and ip.TDO_ID = per.TDO_ID
and ip.INP_TIPO = ti.TINV_ID
and td.TDO_ID = ip.TDO_ID
and ip.INP_TIPO in ('ESEX', 'PEES', 'ESPR', 'ESPO', 'PEX', 'AL', 'PCD', 'PSCD', 'A') 
and p.PRY_ID = ?</property>
        </oda-data-set>
        <oda-data-set extensionID="org.eclipse.birt.report.data.oda.jdbc.JdbcSelectDataSet" name="7 Ingreso_FinanciacionExterna" id="11268">

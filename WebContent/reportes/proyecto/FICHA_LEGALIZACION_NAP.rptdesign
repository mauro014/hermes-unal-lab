            <property name="queryText">select (select dd.DOMDET_DESCRIPCION
          from HER_DOMINIO_DETALLE dd
         where dd.domdet_tipo = pry.PRY_PROGRAMA_CYT
           and dd.dom_id = 120 )  PRY_PROGRAMA,       
       pry.PRY_ACTO_ADM_EXTERNO, PRY_FECHA_ATI fechaExterno,
       PRY_CUPOS_DESCUENTO numExterno, PRY_NRO_MONITORES numInterno,
       PRY_ACT_NOMBRE actoInterno, PRY_ACT_FECHA fechaInterno,
       pry.PRY_ACT_NOMBRE, PRY_FECHA_TENTATIVA_INICIO,
       PRY_FECHA_FINAL, PRY_EXO_IND, 
       decode (pry.PRY_TIPO_FECHA_INICIO, '1', 'Desembolso de recursos',
			'2', 'Acta de inicio', 
			'3', 'Legalización o suscripción del contrato',
			'4', 'Otro') PRY_TIPO_FECHA_INICIO,
		PRY_CONFERENCISTAS, PRY_FECHA_ACTA_EXTERNA, PRY_COMPROMISO_EJECUC,
		pry.PRY_CONT_EFECT_FINAL_UN, pry.PRY_CONT_ESPEC_FINAL_UN
  from HER_PROYECTO pry
 WHERE pry.PRY_ID = ?
 
</property>

                </structure>
            </list-property>
            <property name="queryText">SELECT 	ff.FFI_DESCRIPCION,
        DECODE (ff.ffi_interna_externa, 'I', 'Interna',
                                        'E', 'Externa',
                                        'A', 'Inscripciones',
                                        'O', 'Interna') INT_EXT,
        (select dd.domdet_descripcion
           from her_dominio_detalle dd
          where dd.domdet_tipo = ff.ffe_cod_naturaleza) NATURA,
          (select dd.domdet_descripcion
           from her_dominio_detalle dd
          where dd.domdet_tipo = f.FFE_TIPO_ENTIDAD AND dd.dom_id=129) TIPO,
		    f.FIN_VALOR, f.FFE_VALOR_ESPECIE 
  FROM 	HER_FUENTE_FINANCIACION ff, 
        HER_FINANCIACION f
 WHERE 	ff.FFI_ID = f.FFI_ID 
   AND	PRY_ID = ?
   AND (F.FIN_ES_LEGALIZACION IS NOT NULL AND F.FIN_ES_LEGALIZACION = 'SI')</property>
        </oda-data-set>

                </structure>
            </list-property>
            <property name="queryText">SELECT HE.HEP_FECHA, P.PRY_JUSTIFICAC_EXONERAC_CI, HE.EPR_ID as estadoHistorico, P.EPR_ID
FROM HER_HISTORICO_ESTADO_PROYECTO HE, HER_PROYECTO P

            <property name="queryText">select upper(dep.DPN_NOMBRE),
       upper(sede.sed_nombre),
       PRY_EMPRESA_EJECUTORA,
       DECODE(pry.PRY_TIPO_ACTIVIDAD, 'PI', 'Proyecto de investigación', '--') TIPOACTIVIDAD,
       pry.PRY_NOMBRE,
       pry.PRY_DURACION CANTIDAD_MESES,
       (PER.PER_APELLIDO1||' '||DECODE(PER.PER_APELLIDO2, PER.PER_APELLIDO2,PER.PER_APELLIDO2,NULL,' ')||' '||PER.PER_NOMBRE1||' '||DECODE(PER.PER_NOMBRE2, PER.PER_NOMBRE2,PER.PER_NOMBRE2,NULL,' '))PRINCIPAL,
       per.PER_ID,
       (select upper(fac.DPN_NOMBRE)
         from her_dependencia FAC
        where fac.dpn_id = dep.DPN_FACULTAD
          and fac.DPN_ES_FACULTAD = 'Y' ) UNIDAD,
       inp.inp_dedicacion_horas_semana HORA_SEMANA,
       inp.inp_valor_pagar VALOR_DEDICACION,
       (select (ep.epr_NOMBRE)
         from her_estado_proyecto ep
        where ep.epr_id = pry.epr_id ) ESTADO,
       DECODE(pry.PRY_TIPOLOGIA, 'E', 'Ejecución técnica', 'ETF', 'Ejecución técnica y financiera',
        '--') TIPOEJECUCION, PRY_TIPOLOGIA_SEC,
       pry.PRY_TIPO_ACTIVIDAD TIPO_ACTIVIDAD_ID,      
       pry.PRY_VALOR_SOLICITADO VALOR_SOLICITADO,
       pry.PRY_ID,
       pry.PRY_VALOR_TOTAL VALOR_TOTAL_PROYECTO
  from HER_PROYECTO pry, 
       HER_PERSONA per, 
       HER_INVESTIGADOR_PROYECTO inp, 
       HER_INVESTIGADOR_INTERNO ini, 
       HER_DEPENDENCIA dep,
       HER_SEDE  sede       
 WHERE pry.PRY_ID = ?
   AND per.PER_ID = inp.INV_ID 
   AND per.TDO_ID = inp.TDO_ID 
   AND inp.INP_TIPO = 'P' 
   AND inp.PRY_ID = pry.PRY_ID
   AND per.PER_ID = ini.INV_ID 
   AND per.TDO_ID = ini.TDO_ID 
   AND dep.DPN_ID = ini.DPN_ID
   AND dep.sed_id = sede.sed_id</property>
        </oda-data-set>

                </structure>
            </list-property>
            <property name="queryText">select oe.obj_descripcion, a.act_descripcion, PIA_PORCENTAJE_AVANCE,
PIA_JUSTIFICACION_AVANCE, PIA_COMENTARIOS_COORDINADOR from 
her_proyecto_informe_actividad pia left join her_actividad a on pia.ACT_ID = A.ACT_id LEFT JOIN her_objetivo_especifico OE ON PIA.OBJ_ID  = OE.OBJ_ID
where PIA.PIN_ID = ?</property>

            <property name="queryText">select oe.obj_descripcion, oe.obj_medio_verificacion, PIO_PORCENTAJE_AVANCE, PIO_JUSTIFICACION_AVANCE, PIO_COMENTARIOS_COORDINADOR AS COORD

                    <property name="nativeName">ENT</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">4</property>
                    <property name="name">SENT</property>
                    <property name="nativeName">SENT</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">5</property>
                    <property name="name">JUST</property>
                    <property name="nativeName">JUST</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">6</property>
                    <property name="name">FECHAR</property>
                    <property name="nativeName">FECHAR</property>
                    <property name="dataType">date-time</property>
                </structure>
                <structure>
                    <property name="position">7</property>
                    <property name="name">COORD</property>
                    <property name="nativeName">COORD</property>
                    <property name="dataType">string</property>
                </structure>
            </list-property>
            <property name="queryText">select rp.rst_descripcion descrip, 
rp.rst_fecha_entregable fechai, 
rp.rst_entregable ent, 
PIR_ENTREGADO sent,
PIR_JUSTIFICACION just, 
PIR_FECHA_ENTREGA fechar,
PIR_COMENTARIOS_COORDINADOR coord
from 
her_proyecto_informe_resultado pir left join her_resultado_proyecto rp on pir.rst_ID = rp.rst_id 
where PIr.PIN_ID = ?</property>
        </oda-data-set>
        <oda-data-set extensionID="org.eclipse.birt.report.data.oda.jdbc.JdbcSelectDataSet" name="ActividadInforme" id="10234">
            <structure name="cachedMetaData">
                <list-property name="resultSet">

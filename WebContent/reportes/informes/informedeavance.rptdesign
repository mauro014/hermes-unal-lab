                </structure>
            </list-property>
            <property name="queryText">select p.per_id id, p.tdo_id , 
 p.per_nombre1 || ' ' ||  p.per_nombre2 || ' ' ||  p.per_apellido1 || ' ' ||  p.per_apellido2  nombre from her_persona p, her_proyecto_informe pi 
where pi.pin_est_id = p.per_id and pi.pin_est_tdo_id = p.tdo_id and pi.pin_id = ?</property>
        </oda-data-set>

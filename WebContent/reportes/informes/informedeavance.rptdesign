                <structure>
                    <property name="position">1</property>
                    <property name="name">AIN_NOMBRE</property>
                    <property name="nativeName">AIN_NOMBRE</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">2</property>
                    <property name="name">AIN_ARCHIVO</property>
                    <property name="nativeName">AIN_ARCHIVO</property>
                    <property name="dataType">blob</property>
                </structure>
                <structure>
                    <property name="position">3</property>
                    <property name="name">AIN_FECHA</property>
                    <property name="nativeName">AIN_FECHA</property>
                    <property name="dataType">date-time</property>
                </structure>
                <structure>
                    <property name="position">4</property>
                    <property name="name">TIA_NOMBRE</property>
                    <property name="nativeName">TIA_NOMBRE</property>
                    <property name="dataType">string</property>
                </structure>
            </list-property>
            <property name="queryText">SELECT AIN.AIN_NOMBRE, AIN.AIN_ARCHIVO, AIN.AIN_FECHA, TA.TIA_NOMBRE
FROM
HER_PROYECTO_INFORME PIN, HER_ARCHIVO_INFORME  AIN LEFT JOIN HER_TIPO_ARCHIVO TA ON TA.TIA_ID = AIN.TIA_ID
WHERE  (AIN_ESTADO is null or AIN_ESTADO &lt;> 'B') AND
    PIN.PIN_ID = AIN.PIN_ID
AND PIN.PIN_ID = ?</property>
        </oda-data-set>

                    <property name="nativeName">OBJ_DESCRIPCION</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">2</property>
                    <property name="name">ACT_DESCRIPCION</property>
                    <property name="nativeName">ACT_DESCRIPCION</property>
                    <property name="dataType">string</property>

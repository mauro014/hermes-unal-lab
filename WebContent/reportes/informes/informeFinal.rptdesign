                    </structure>
                </list-property>
            </structure>
            <property name="dataSource">Data Source</property>
            <list-property name="parameters">
                <structure>
                    <property name="name">param_1</property>
                    <property name="paramName">id</property>
                    <property name="dataType">string</property>
                    <property name="position">1</property>
                    <property name="isInput">true</property>
                    <property name="isOutput">false</property>
                </structure>
            </list-property>
            <list-property name="resultSet">
                <structure>
                    <property name="position">1</property>
                    <property name="name">NOMBRE</property>
                    <property name="nativeName">NOMBRE</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">2</property>
                    <property name="name">CARRERA</property>
                    <property name="nativeName">CARRERA</property>
                    <property name="dataType">string</property>
                </structure>
            </list-property>
            <property name="queryText">SELECT * FROM (
select SUBSTR(column_value,INSTRB(column_value,'~',1,2)+1,
INSTRB(column_value,'~',1,3)-(INSTRB(column_value,'~',1,2)+1)) as nombre,
SUBSTR(column_value,INSTRB(column_value,'~',1,3)+1) as carrera 
from table(SELECT 
split(PIN_FORMACION_EST,CHR(13)) columna
FROM
HER_PROYECTO_INFORME
WHERE PIN_ID = ?)) TABLA WHERE TABLA.NOMBRE IS NOT NULL</property>
        </oda-data-set>

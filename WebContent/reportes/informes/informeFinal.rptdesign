            <property name="queryText">SELECT AIN.AIN_NOMBRE, AIN.AIN_ARCHIVO, AIN.AIN_FECHA
FROM
HER_PROYECTO_INFORME PIN, HER_ARCHIVO_INFORME  AIN
WHERE  (AIN_ESTADO is null or AIN_ESTADO &lt;> 'B') AND
    PIN.PIN_ID = AIN.PIN_ID AND PIN.PIN_ID = ?</property>
        </oda-data-set>

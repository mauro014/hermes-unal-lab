                <structure>
                    <property name="position">5</property>
                    <property name="name">CUMPLIO</property>
                    <property name="nativeName">CUMPLIO</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">6</property>
                    <property name="name">LINK</property>
                    <property name="nativeName">LINK</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">7</property>
                    <property name="name">DEPOSITO</property>
                    <property name="nativeName">DEPOSITO</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">8</property>
                    <property name="name">PROTECCION</property>
                    <property name="nativeName">PROTECCION</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">9</property>
                    <property name="name">ODS</property>
                    <property name="nativeName">ODS</property>
                    <property name="dataType">string</property>
                </structure>
            </list-property>
            <property name="queryText">SELECT 
	OBJ_OBJETIVO AS objetivo, 
	PRD_RESULTADO_ESP as resultadoEsperado, 
	DECODE(PRD_COMPLETADO,'NO','Razones de no entrega: "' || PRD_MOTIVO || '"','/ NOMBRE DE PRODUCTO: '||NOMBREPRODUCTO) as nombreProducto, 
	'TIPO DE PRODUCTO: '|| TIPOPRODUCCION as tipoProduccion,
	DECODE(PRD_COMPLETADO,'NO','/ ENTREGADO: NO','/ ENTREGADO: SI') AS CUMPLIO,
	PRD_LINK as link,
	PRD_LUGAR_DEPOSITO as deposito,
	'/PROTECCIÓN: '||PRD_PROTECCION AS proteccion,
	oe.domdet_descripcion as ods
FROM
	HER_PRODUCTO_SARA
	left join her_dominio_detalle oe on PRD_OBJSOST = oe.domdet_tipo and oe.dom_id = '212'
WHERE 
	PIN_ID = ? and HER_PRODUCTO_SARA.PRD_COMPLETADO = 'NO'</property>
        </oda-data-set>

            <property name="queryText">SELECT HER_PROYECTO_INFORME.*, 
decode(PIN_CALIFICACION,'3','Aceptable','4','Bueno','5','Excelente','Sin calificación') as calificacion
FROM
HER_PROYECTO_INFORME
WHERE PIN_ID = ?</property>
        </oda-data-set>

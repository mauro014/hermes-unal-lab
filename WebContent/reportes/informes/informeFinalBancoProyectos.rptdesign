                    <property name="dataType">string</property>
                </structure>
            </list-property>
            <property name="queryText">SELECT HER_PROYECTO_INFORME.*, FFI_DESCRIPCION, DOMDET_DESCRIPCION
FROM
HER_PROYECTO_INFORME, HER_FUENTE_FINANCIACION, HER_DOMINIO_DETALLE
WHERE PIN_ID = ?
and dbms_lob.substr( PIN_compromisos, 4000, 1 ) = FFI_ID 
and DOMDET_TIPO = PIN_CALIFICACION AND DOM_ID = 116</property>
        </oda-data-set>
        <oda-data-set extensionID="org.eclipse.birt.report.data.oda.jdbc.JdbcSelectDataSet" name="Adjuntos" id="3049">
            <structure name="cachedMetaData">
                <list-property name="resultSet">
                    <structure>
                        <property name="position">1</property>

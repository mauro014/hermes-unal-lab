                </structure>
            </list-property>
            <property name="queryText">SELECT PRY.PRY_NOMBRE,PRY.PRY_ID,
PER.PER_NOMBRE1||' '||DECODE(PER.PER_NOMBRE2, PER.PER_NOMBRE2,PER.PER_NOMBRE2,NULL,' ')||' '||PER.PER_APELLIDO1||' '||DECODE(PER.PER_APELLIDO2, PER.PER_APELLIDO2,PER.PER_APELLIDO2,NULL,' ')PRINCIPAL,
  SED_NOMBRE, DPN1.DPN_NOMBRE, DPN.DPN_NOMBRE, PIN.PIN_FECHA
FROM HER_PROYECTO PRY, HER_INVESTIGADOR_PROYECTO INP, HER_PERSONA PER, HER_PROYECTO_INFORME PIN,
HER_INVESTIGADOR_INTERNO   INI, HER_SEDE SED, HER_DEPENDENCIA DPN  , HER_DEPENDENCIA DPN1
WHERE PRY.PRY_ID = PIN.PRY_ID
AND PER.PER_ID = INP.INV_ID
AND PER.PER_ID = INI.INV_ID
AND INI.INV_ID = INP.INV_ID
AND PRY.PRY_ID=INP.PRY_ID
AND INP.INP_TIPO ='P'
AND DPN.DPN_ID = INI.DPN_ID
AND  DPN.DPN_ID_2 = DPN1.DPN_ID    
AND DPN.SED_ID = SED.SED_ID
AND PIN.PIN_ID = ?</property>
        </oda-data-set>

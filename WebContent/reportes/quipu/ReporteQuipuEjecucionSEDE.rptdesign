                </structure>
            </list-property>
            <property name="queryText">SELECT * FROM
(select distinct
EMPRESA || ' - ' || NOMBRE_EMPRESA as EMPRESA,
PROYECTO,
NOMBRE_PROYECTO,
NOMBRE_AREA_RESP,
NOMBRE_DIRECTOR||' ('||IDENT_DIRECTOR||'), '||NOMBRE_AREA as DIRECTOR
FROM ppto_proy_invext_prod@HERMES_INTEGRA
WHERE proyecto = ?
and IDENT_DIRECTOR = ?
AND vr_aprop_vigencia > 0
union all
select distinct
EMPRESA || ' - ' || NOMBRE_EMPRESA as EMPRESA,
PROYECTO,
NOMBRE_PROYECTO,
NOMBRE_AREA_RESP,
NOMBRE_DIRECTOR||' ('||IDENT_DIRECTOR||'), '||NOMBRE_AREA as DIRECTOR
FROM ppto_proy_invext_hist@HERMES_INTEGRA
WHERE proyecto = ?
and IDENT_DIRECTOR = ?
AND vr_aprop_vigencia > 0) X
WHERE ROWNUM = 1</property>

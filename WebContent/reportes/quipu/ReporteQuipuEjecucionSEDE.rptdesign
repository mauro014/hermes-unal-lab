                    <property name="nativeName">SALDO_POR_COMPROMETER</property>
                    <property name="dataType">string</property>
                </structure>
            </list-property>
            <property name="queryText">SELECT
	IMPUTACION,
	NOMBRE_IMPUTACION,
	VIGENCIA_mov,
	TO_CHAR(sum(APROPIACION), '999,999,999,990.99') APROPIACION,
	TO_CHAR(sum(DISPONIBILIDAD), '999,999,999,990.99') DISPONIBILIDAD,
	TO_CHAR(sum(REGISTRO), '999,999,999,990.99') REGISTRO,
	TO_CHAR(sum(OBLIGACIONES), '999,999,999,990.99') OBLIGACIONES,
	TO_CHAR(sum(PAGO), '999,999,999,990.99') PAGO,
	TO_CHAR(sum(PAGO_VIGENCIAS), '999,999,999,990.99') PAGO_VIGENCIAS,
	TO_CHAR(sum(SALDO_POR_COMPROMETER), '999,999,999,990.99') SALDO_POR_COMPROMETER
FROM
	(
	SELECT
		IMPUTACION,
		NOMBRE_IMPUTACION,
		VIGENCIA_mov,
		sum(nvl(VR_APROP_VIGENCIA, 0)) AS APROPIACION,
		sum(nvl(VR_DISPONIBILIDAD, 0))DISPONIBILIDAD,
		sum(nvl(VR_COMPROMISOS, 0))REGISTRO,
		sum(nvl(VR_OBLIGA_VIG_ACT, 0))OBLIGACIONES,
		sum(nvl(VR_PAGOS_VIG_ACT, 0))PAGO,
		sum(nvl(VR_OBLIGA_RESERVAS, 0))PAGO_VIGENCIAS,
		sum(nvl(VR_APROP_VIGENCIA, 0)) - sum(nvl(VR_DISPONIBILIDAD, 0))SALDO_POR_COMPROMETER
	FROM
		ppto_proy_ACUM_invext_HIST@HERMES_INTEGRA
	WHERE
		proyecto = ?
		AND IDENT_DIRECTOR = ?
		AND (vr_aprop_vigencia > 0 OR VR_OBLIGA_RESERVAS >0)
	GROUP BY
		IMPUTACION,
		NOMBRE_IMPUTACION,
		VIGENCIA_mov
UNION ALL
	SELECT
		IMPUTACION,
		NOMBRE_IMPUTACION,
		VIGENCIA_mov,
		sum(nvl(VR_APROP_VIGENCIA, 0)) AS APROPIACION,
		sum(nvl(VR_DISPONIBILIDAD, 0))DISPONIBILIDAD,
		sum(nvl(VR_COMPROMISOS, 0))REGISTRO,
		sum(nvl(VR_OBLIGA_VIG_ACT, 0))OBLIGACIONES,
		sum(nvl(VR_PAGOS_VIG_ACT, 0))PAGO,
		sum(nvl(VR_OBLIGA_RESERVAS, 0))PAGO_VIGENCIAS,
		sum(nvl(VR_APROP_VIGENCIA, 0)) - sum(nvl(VR_DISPONIBILIDAD, 0))SALDO_POR_COMPROMETER
	FROM
		ppto_proy_ACUM_invext_prod@HERMES_INTEGRA
	WHERE
		proyecto = ?
		AND IDENT_DIRECTOR = ?
		AND (vr_aprop_vigencia > 0 OR VR_OBLIGA_RESERVAS >0)
	GROUP BY
		IMPUTACION,
		NOMBRE_IMPUTACION,
		VIGENCIA_mov) X
GROUP BY
	IMPUTACION,
	NOMBRE_IMPUTACION,
	VIGENCIA_mov
ORDER BY
	IMPUTACION,
	VIGENCIA_mov</property>
            <xml-property name="designerValues"><![CDATA[<?xml version="1.0" encoding="UTF-8"?>

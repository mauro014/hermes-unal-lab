            <property name="queryText">SELECT     GRU.GRU_ID,   INI.INV_ID, 
PER.PER_APELLIDO1||' '||DECODE(PER.PER_APELLIDO2, PER.PER_APELLIDO2,PER.PER_APELLIDO2,NULL,' ')||' '||PER.PER_NOMBRE1||' '||DECODE(PER.PER_NOMBRE2, PER.PER_NOMBRE2,PER.PER_NOMBRE2,NULL,' ')INTEGRANTES,
INI.INI_URL_WEB_DOCENTE,DPN.DPN_NOMBRE,ING.ING_FUNCION,SED.SED_NOMBRE
FROM HER_GRUPO GRU  , HER_GRUPO_PROYECTO GRP, HER_PROYECTO PRY, HER_INVESTIGADOR_GRUPO ING,
HER_PERSONA PER, HER_INVESTIGADOR_INTERNO INI, HER_DEPENDENCIA DPN, HER_SEDE SED
WHERE PRY.PRY_ID = ?
AND GRP.PRY_ID = PRY.PRY_ID
AND GRU.GRU_ID = GRP.GRU_ID
AND GRU.GRU_ID = ING.GRU_ID
AND ING.INV_ID = INI.INV_ID
AND PER.PER_ID = ING.INV_ID
 AND PER.PER_ID = INI.INV_ID
 AND INI.DPN_ID = DPN.DPN_ID
 AND SED.SED_ID = SUBSTR(DPN.DPN_ID,1,1)</property>
        </oda-data-set>

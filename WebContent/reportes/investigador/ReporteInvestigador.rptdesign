            <property name="queryText">SELECT PRY.PRY_NOMBRE,PRY.PRY_ID,
PER.PER_APELLIDO1||' '||DECODE(PER.PER_APELLIDO2, PER.PER_APELLIDO2,PER.PER_APELLIDO2,NULL,' ')||' '||PER.PER_NOMBRE1||' '||DECODE(PER.PER_NOMBRE2, PER.PER_NOMBRE2,PER.PER_NOMBRE2,NULL,' ')PRINCIPAL,
PER.PER_ID, PER.PER_EMAIL, PER.PER_TELEFONO , PER.PER_DIRECCION
FROM HER_PROYECTO PRY, HER_INVESTIGADOR_PROYECTO INP, HER_PERSONA PER
WHERE PRY.PRY_ID = ?
AND PER.PER_ID = INP.INV_ID
AND PRY.PRY_ID=INP.PRY_ID
AND INP.INP_TIPO ='P'</property>
        </oda-data-set>

            <property name="queryText">SELECT    GRU.GRU_NOMBRE, GRC_NOMBRE,  INGT.IGT_NOMBRE
FROM HER_INVESTIGADOR_GRUPO ING , HER_GRUPO_CATEGORIA GRC,
HER_GRUPO GRU, HER_INVESTIGADOR_GRUPO_TIPO INGT
WHERE  GRU.GRU_ID = ING.GRU_ID
AND GRU.GRU_CATEGORIA_COLCIENCIAS= GRC_ID
AND ING.ING_TIPO = INGT.IGT_ID
AND ING.INV_ID =  '19051148'</property>
        </oda-data-set>

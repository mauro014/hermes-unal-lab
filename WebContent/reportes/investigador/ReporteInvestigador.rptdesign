            <property name="queryText"> SELECT  DPN.DPN_NOMBRE
  FROM HER_DEPENDENCIA DPN WHERE DPN.DPN_ID IN  
(SELECT  
    DPN1.DPN_FACULTAD
FROM  HER_INVESTIGADOR_INTERNO   INI,  
HER_DEPENDENCIA DPN  , HER_DEPENDENCIA DPN1 
WHERE INI.INV_ID =  '19051148'
AND INI.DPN_ID = DPN.DPN_ID  
AND INI.DPN_ID = DPN1.DPN_ID )</property>
        </oda-data-set>

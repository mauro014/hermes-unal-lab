<?xml version='1.0' encoding='ISO-8859-1' ?>
<ui:composition xmlns="http://www.w3.org/1999/xhtml"
	xmlns:h="http://java.sun.com/jsf/html"
	xmlns:f="http://java.sun.com/jsf/core"
	xmlns:ui="http://java.sun.com/jsf/facelets"
	xmlns:p="http://primefaces.org/ui"
	xmlns:t="http://myfaces.apache.org/tomahawk">
	<h:form>
		<style type="text/css">
			.menu li a {
				
			}
		</style>
		<t:div styleClass="menu-superior"
			style="padding-bottom: 0px; margin-bottom: 0px; margin-left: 6px;">
			<t:div styleClass="logo-hermes" rendered="#{manejadorAutenticacion.esAmbienteProduccion}">
				<h:commandLink action="#{manejadorAutenticacion.inicio}">
					<h:graphicImage url="/images/her-general/logo_hermes.png" style="border:0px" />
				</h:commandLink>
			</t:div>
			
			<t:div styleClass="logo-hermes" rendered="#{!manejadorAutenticacion.esAmbienteProduccion}">
				<h:commandLink action="#{manejadorAutenticacion.inicio}">
					<h:graphicImage url="/images/her-general/logo_hermes_pruebas.png" style="border:0px" />
				</h:commandLink>
			</t:div>
			
			<div class="botones-login">
				<div class="login-inicio">
					<h:commandButton styleClass="boton_inicio"
						action="#{manejadorAutenticacion.inicio}" value="" />
				</div>
				<div class="login-salir">
					<h:commandButton
						onclick="if(!confirm('¿Esta seguro de cerrar sesión?'))return false"
						styleClass="boton_salir"
						actionListener="#{manejadorAutenticacion.consultarPaginaSalida}"
						value="" alt="Salir" />
				</div>
			</div>
			<div class="cabeza-login">
				<div class="login-bienvenido">Bienvenido (a)</div>
			</div>
			<div class="usuario-registrado">
				<h:outputText value="#{manejadorAutenticacion.nombrePersona} " />
			</div>
		</t:div>
		<t:div styleClass="cabezote-derecho-menu-especifico" rendered="#{!manejadorAutenticacion.esAmbienteProduccion}">
			<h:outputText value="Ambiente de PRUEBAS" />
		</t:div>
		<t:div styleClass="contenido-menu-adicional"
			style="padding-bottom: 0px; margin-bottom: 0px; padding-top: 10px;"
			rendered="#{manejadorAutenticacion.mostrarGrupos}">
			<t:div styleClass="menu-superior"
				style="padding-bottom: 0px; margin-bottom: 0px;">
				<t:div styleClass="cabezote-derecho-menu-especifico">
					<h:outputText value="Grupos de investigación" />
				</t:div>
				<t:div styleClass="menu">
					<ul style="margin-left: 6px;">
						<li><p:commandLink
								rendered="#{manejadorAutenticacion.tienePermisosCrearGrupo}"
								action="#{manejadorGruposInvestigador.agregarNuevoGrupo}"
								ajax="false">
								<h:outputText value="Agregar nuevo grupo" />
							</p:commandLink></li>
						<li><p:commandLink
								action="#{ManejadorAvalMenu.solicitarAval}" ajax="false">
								<h:outputText value="Solicitar aval institucional grupo" />
							</p:commandLink></li>
					</ul>
				</t:div>
			</t:div>
		</t:div>
		<t:div styleClass="contenido-menu-adicional"
			style="padding-bottom: 0px; margin-bottom: 0px; padding-top: 10px;"
			rendered="#{manejadorAutenticacion.mostrarLaboratorios and !manejadorAutenticacion.esDiagnosticoSoftware and not manejadorAutenticacion.esInventariosLaboratorios}">
			<t:div styleClass="menu-superior"
				style="padding-bottom: 0px; margin-bottom: 0px;">
				<t:div styleClass="cabezote-derecho-menu-especifico">
					<h:outputText value="Laboratorios" />
				</t:div>
				<t:div styleClass="menu">
					<ul style="margin-left: 6px;">
						<li><p:commandLink
								action="#{manejadorAutenticacion.irAdministrarEquipos}"
								ajax="false"
								rendered="#{manejadorAutenticacion.esLaboratorios or manejadorAutenticacion.esLaboratoriosSede or manejadorAutenticacion.esCoordinadorLaboratorio or manejadorAutenticacion.esLaboratoriosFacultad}">
								<h:outputText value="Búsqueda de Equipos" />
							</p:commandLink></li>
						<li><p:commandLink action="administrarInsumos" ajax="false"
								rendered="#{manejadorAutenticacion.esLaboratorios}">
								<h:outputText value="Administrar Insumos" />
							</p:commandLink></li>
						<li><p:commandLink action="AdministrarLaboratorios"
								ajax="false">
								<h:outputText value="Administrar Laboratorios" />
							</p:commandLink></li>
						<li><p:commandLink
								action="consultarConvocatoriasLaboratorios" ajax="false"
								rendered="#{manejadorAutenticacion.esLaboratorios}">
								<h:outputText value="Programa proy. laboratorios" />
							</p:commandLink></li>
                        <li><p:commandLink
                                action="irVerTodasSolicitudesLaboratorios" ajax="false"
                                rendered="#{manejadorAutenticacion.esLaboratorios}">
                                <h:outputText value="Consulta proyectos laboratorios" />
                            </p:commandLink></li>
						<li><p:commandLink action="#{manejadorAutenticacion.irCrearLaboratorio}" ajax="false"
								rendered="#{manejadorAutenticacion.esLaboratorios or manejadorAutenticacion.esLaboratoriosSede}">
								<h:outputText value="Crear Laboratorio" />
							</p:commandLink></li>
						<li><p:commandLink action="buscarCostosServiciosLaboratorio"
								ajax="false"
								rendered="#{manejadorAutenticacion.esLaboratorios or manejadorAutenticacion.esCoordinadorLaboratorio or manejadorAutenticacion.esLaboratoriosSede}">
								<h:outputText value="Costos Servicios" />
							</p:commandLink></li>
						<li><p:commandLink action="encuestaDiagnosticoSoftware"
								ajax="false" rendered="#{manejadorAutenticacion.esLaboratorios}">
								<h:outputText value="Diagnóstico Software" />
							</p:commandLink></li>
						<li><p:commandLink action="evaluacionProveedores"
								ajax="false"
								rendered="#{manejadorAutenticacion.esLaboratorios or manejadorAutenticacion.esLaboratoriosSede or manejadorAutenticacion.esCoordinadorLaboratorio}">
								<h:outputText value="Evaluación Proveedores" />
							</p:commandLink></li>
						<li><p:commandLink action="#{manejadorAutenticacion.irReportesDNL}" ajax="false"
								rendered="#{manejadorAutenticacion.esLaboratorios 
									or manejadorAutenticacion.esLaboratoriosSede 
									or manejadorAutenticacion.esLaboratoriosFacultad 
									or manejadorAutenticacion.esLaboratoriosDepto 
									or manejadorAutenticacion.esConsultaLaboratorios
									or manejadorAutenticacion.esCoordinadorLaboratorio
									or manejadorAutenticacion.esPersonalLaboratorio
									}">
								<h:outputText value="Reportes" />
							</p:commandLink></li>
						<li><p:commandLink action="solicitudLaboratorio" ajax="false"
								rendered="false"
								title="Solicitar al SNL crear, formalizar, modificar o eliminar un Laboratorio">
								<h:outputText value="Solicitud Laboratorio" />
							</p:commandLink></li>
						<li><p:commandLink action="listadoSolicitudesSNL"
								ajax="false"
								rendered="false"
								title="Consulta de las solicitudes al SNL registradas">
								<h:outputText value="Solicitudes SNL" />
							</p:commandLink></li>
					</ul>
				</t:div>
			</t:div>
		</t:div>

		<t:div styleClass="contenido-menu-adicional"
			style="padding-bottom: 0px; margin-bottom: 0px; padding-top: 10px;"
			rendered="#{manejadorAutenticacion.mostrarOpcionesInnovacion}">
			<t:div styleClass="menu-superior"

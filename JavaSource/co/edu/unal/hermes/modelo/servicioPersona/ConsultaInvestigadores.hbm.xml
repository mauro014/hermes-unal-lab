<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="co.edu.unal.hermes.modelo.servicioPersona">
 <class name="ConsultaInvestigadores" table="HER_PERSONA" lazy="true">
  
  <composite-id class="co.edu.unal.hermes.modelo.IdPersona" name="id" unsaved-value="none">
   <key-property name="documento" column="PER_ID"/>
   <key-property name="tipoDocumento" column="TDO_ID"/>
  </composite-id>
  
  <property name="nombre1" column="PER_NOMBRE1"/>
  <property name="nombre2" column="PER_NOMBRE2"/>
  <property name="apellido2" column="PER_APELLIDO2"/>
  <property name="apellido1" column="PER_APELLIDO1"/>
 </class>
</hibernate-mapping>

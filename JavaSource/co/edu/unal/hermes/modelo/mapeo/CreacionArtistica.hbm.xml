<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="co.edu.unal.hermes.modelo">
 <class name="CreacionArtistica" table="HER_PRY_CREACION_ARTISTICA">
  <id name="id" column="PCA_ID" type="long">
   <generator class="sequence">
    <param name="sequence">SEQ_PRY_CREACION_ARTISTICA</param>
   </generator>
  </id>
  
  <property name="areaTematica" column="PCA_AREA_TEMATICA"/>
  <property name="tecnicasEmplear" type="text" column="PCA_TECNICAS_A_EMPLEAR"/>
  <property name="trabajosAnteriores" type="text" column="PCA_TRABAJOS_ANTERIORES"/>
  <property name="aporteExperiencia" type="text" column="PCA_APORTE_EXPERIENCIA"/>
  
  <many-to-one name="proyecto" class="Proyecto" column="PRY_ID" not-null="true"/>
 </class>
</hibernate-mapping>

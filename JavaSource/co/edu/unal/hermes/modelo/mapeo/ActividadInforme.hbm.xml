<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="co.edu.unal.hermes.modelo">
 <class name="ActividadInforme" table="HER_ACTIVIDAD_INFORME">
  <id name="id" column="AIN_ID" type="long">
   <generator class="sequence">
    <param name="sequence">SEQ_ACTIVIDAD_INFORME</param>
   </generator>
  </id>
  <property name="desarrollada" column="AIN_DESARROLLADA"/>
  <property name="observaciones" column="AIN_OBSERVACIONES"/>
  <many-to-one name="proyectoInforme" class="ProyectoInforme" column="PIN_ID" not-null="true"/>
  <many-to-one name="actividad" class="Actividad" column="ACT_ID" not-null="true" lazy="false"/>
 </class>
</hibernate-mapping>

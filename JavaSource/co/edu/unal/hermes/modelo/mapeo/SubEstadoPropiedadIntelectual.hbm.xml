<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 2.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="co.edu.unal.hermes.modelo">
	<class name="SubEstadoPropiedadIntelectual" table="HER_PROPIEDAD_INT_SUBESTADO">
		<id name="id" column="PSE_ID" type="long">
		</id>
		
		<property name="nombre" column="PSE_NOMBRE" type="string"/>
		<property name="descripcion" column="PSE_DESCRIPCION" type="string"/>
		<property name="tramite" column="PSE_TRAMITE" type="string"/>
		<many-to-one name="estado" class="EstadoPropiedadIntelectual" column="PIE_ID" lazy="false"/>
		<property name="orden" column="PSE_ORDEN"/>
		
	</class>
</hibernate-mapping>
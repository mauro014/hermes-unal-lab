<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="co.edu.unal.hermes.modelo">
 <class name="VBien" table="V_BIENES">
  <id name="placa" column="PLACA" type="string" length="20">
   <generator class="assigned">
   </generator>
  </id>
  
  <property name="serial" column="SERIAL" type="string" length="20"/>
  <property name="descripcion" column="FICHA_TECNICA" type="string" length="4000"/>
  <property name="valor" column="VALOR" type="integer" />
  <property name="idUbicacion" column="UBICACION" type="string" length="16" />
  <property name="ubicacion" column="NOMBRE_UBICACION" type="string" length="100" />
  <property name="idResponsable" column="RESPONSABLE" type="integer" length="14"/>
  <property name="responsable" column="NOMBRE_RESPONSABLE" type="string" length="150"/>
  <property name="idEstado" column="ESTADO" type="integer" length="4"/>
  <property name="estado" column="NOMBRE_ESTADO" type="string" length="100"/>
 </class>
</hibernate-mapping>

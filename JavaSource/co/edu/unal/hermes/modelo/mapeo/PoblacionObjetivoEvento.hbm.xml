<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="co.edu.unal.hermes.modelo">
	<class name="PoblacionObjetivoEvento" table="HER_PROYECTO_POBLACION_OBJ">
		<id name="id" column="PPO_ID" type="long">
			<generator class="sequence">
				<param name="sequence">SEQ_EVENTO_POB_OBJ</param>
			</generator>
		</id>
		<many-to-one name="proyecto" class="Proyecto"
			column="PRY_ID" not-null="true" lazy="false" />
		
		<many-to-one name="poblacionObjetivo" class="DominioDetalle" lazy="false">
			<column name="DOM_ID" />
			<column name="DOMDET_TIPO" />
		</many-to-one>

		<property name="observaciones" column="PPO_OBSERVACIONES" />	
	</class>
</hibernate-mapping>

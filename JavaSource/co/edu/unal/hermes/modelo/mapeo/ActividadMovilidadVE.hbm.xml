<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="co.edu.unal.hermes.modelo">
 <class name="ActividadMovilidadVE" table="HER_ACTIVIDAD_MOVILIDAD_VE">
 
  <id name="id" column="ACT_MOV_ID" type="long" unsaved-value="-1">
   <generator class="sequence">
    <param name="sequence">SEQ_ACTIVIDAD_MOVILIDAD_VE</param>
   </generator>
  </id>
  
  <property name="descripcion" column="ACT_MOV_DESCRIPCION"/>
  <property name="fecha" column="ACT_MOV_FECHA"/>
  <property name="duracion" column="ACT_MOV_DURACION"/>
  <many-to-one name="movilidad" class="MovilidadVisitanteExterior" column="MOV_ID"/>  
  
  <property name="nomTesista" column="ACT_MOV_NOMTESISTA"/>
  <property name="codEstudiante" column="ACT_MOV_CODESTUD"/>
   <property name="programa" column="PPS_ID"/>	
  <property name="nomTesis" column="ACT_MOV_NOMTESIS"/>
  <property name="nomCursoEvento" column="ACT_MOV_NOMCURSO"/>
  <property name="nomArea" column="ACT_MOV_NOMAREA"/>
  <property name="asistentes" column="ACT_MOV_ASISTENTES"/>
  
  <many-to-one name="tipoActividad" class="TipoActividadMovilidadVE" not-null="false" lazy="false">
	<column name="TAMVE_ID"/>
   </many-to-one>	
   
  <set name="asistentesn" table="HER_MOV_SEG_ACTV_ASISTENTE" cascade="all-delete-orphan" fetch="join">
	    <key column="ACT_MOV_ID"/>
	    <one-to-many class="MovilidadSeguimientoActEvento"/>
  </set>
 </class>
</hibernate-mapping>
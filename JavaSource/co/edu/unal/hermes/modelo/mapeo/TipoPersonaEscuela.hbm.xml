<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="co.edu.unal.hermes.modelo">
 <class name="TipoPersonaEscuela" table="HER_TIPO_PERSONA_ESC_INT">
  <id name="id" column="TPE_ID" type="long">
   <generator class="sequence">
   	<param name="sequence">SEQ_TIPO_PERSONA_ESC_INT</param>
   </generator>
  </id>
  <property name="nombre" column="TPE_NOMBRE"/>
 
 </class>	  
</hibernate-mapping>

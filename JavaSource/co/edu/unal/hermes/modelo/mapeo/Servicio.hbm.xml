<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="co.edu.unal.hermes.modelo">
 <class name="Servicio" table="HER_SERVICIO">
  <id name="id" column="SER_ID" type="string">
   <generator class="assigned"/>
  </id>
  <property name="nombre" column="SER_NOMBRE"/>
  <property name="zona" column="SER_ZONA"/>
  <property name="url" column="SER_URL"/>
  <many-to-one name="padre" class="Servicio" column="SER_ID_PADRE" />
 
 </class>
</hibernate-mapping>

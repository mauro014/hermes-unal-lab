<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="co.edu.unal.hermes.modelo">
	<class name="Ciudad" table="HER_CIUDAD">
		<id name="id" column="CIU_ID" type="string">
			<generator class="assigned" />
		</id>
		<many-to-one name="departamento" class="Departamento"
			column="DEP_ID" not-null="true" lazy="false" />
		<property name="nombre" column="CIU_NOMBRE" />
		<property name="sigla" column="ciu_SIGLA" />
	</class>
</hibernate-mapping>

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="co.edu.unal.hermes.modelo.laboratorios">

	<class name="LaboratorioEquipoReporteDanio" table="HER_LAB_EQUIPO_REP_DANIO">

		<id name="id" column="LERD_ID" type="long">
			<generator class="sequence">
				<param name="sequence">SEQ_LAB_EQUIPO_REP_DANIO</param>
			</generator>
		</id>
		
		<many-to-one name="equipo"
			class="co.edu.unal.hermes.modelo.laboratorios.LaboratorioDetalleEquipos"
			column="LDE_ID" lazy="false" />

		<property name="fechaReporte" column="LERD_FECHA_REPORTE" />

		<property name="descripcion" column="LERD_DESCRIPCIÓN" />

		<property name="fechaRegistro" column="LERD_FECHA_REGISTRO" />

		<property name="fechaActualizacion" column="LERD_FECHA_ACTUALIZACIÓN" />
		
		<property name="fechaSolucion" column="LERD_FECHA_SOLUCION" />
		<property name="descripcionSolucion" column="LERD_DESCRIPCION_SOLUCION" />

	</class>

</hibernate-mapping>
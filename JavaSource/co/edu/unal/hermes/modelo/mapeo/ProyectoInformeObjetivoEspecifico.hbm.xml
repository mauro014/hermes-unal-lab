<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="co.edu.unal.hermes.modelo">
	<class name="ProyectoInformeObjetivoEspecifico" table="HER_PROYECTO_INFORME_OBJ_ESP">
		<id name="id" column="PIO_ID" type="long">
			<generator class="sequence">
				<param name="sequence">SEQ_PROYECTO_INFORME_OBJ_ESP</param>
			</generator>
		</id>

		<many-to-one name="informe" class="ProyectoInforme" column="PIN_ID"
			not-null="true" />
		<many-to-one name="objetivo" class="ObjetivoEspecifico" column="OBJ_ID"
			not-null="true" />
		
		<property name="justificacionAvance" column="PIO_JUSTIFICACION_AVANCE" />
		<property name="porcentajeAvance" column="PIO_PORCENTAJE_AVANCE" />
		<property name="comentariosCoordinador" column="PIO_COMENTARIOS_COORDINADOR" />
		
	</class>
</hibernate-mapping>

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="co.edu.unal.hermes.modelo">

	<class name="RubroFinanciable" table="HER_RUBRO_FINANCIABLE">

		<id column="RFN_ID" name="id" type="long">
			<generator class="sequence">
				<param name="sequence">SEQ_RUBRO_FINANCIABLE</param>
			</generator>
		</id>

		<property name="porcentajeMaximo" column="RFN_PORCENTAJE_MAXIMO" />
		<property name="cantidadParametro" column="CANTIDAD_PARAMETRO" />
		<many-to-one name="modalidad" column="MOD_ID" class="Modalidad"
			not-null="true" lazy="false" />
		<many-to-one name="tipoRubro" column="TRU_ID" class="TipoRubro"
			not-null="true" lazy="false" />
		<many-to-one name="parametro" column="PAR_ID" class="Parametro"
			not-null="false" lazy="false" />
	</class>
</hibernate-mapping>
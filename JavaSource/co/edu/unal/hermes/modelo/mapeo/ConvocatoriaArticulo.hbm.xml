<?xml version="1.0" encoding="UTF-8"?>


<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="co.edu.unal.hermes.modelo">
 <class name="ConvocatoriaArticulo" table="HER_CONVOCATORIA_ARTICULO">
    
  <id name="id" column="CNA_ID" type="long" unsaved-value="-1">
   <generator class="sequence">
    <param name="sequence">SEQ_PROYECTO</param>
   </generator> 
  </id>	
  
    <property name="modalidad" column="CNA_MODALIDAD"/>  
  	<property name="convocatoria" column="CON_ID"/>
    <property name="fechaRegistro" column="CNA_FECHA_SOLICITUD"/>	
    
  <property name="idioma" column="CNA_IDIOMA"/> 
  <property name="dependencia" column="CNA_DEPENDENCIA_MOD_DOS"/>    	
  <property name="numeroApoyos" column="CNA_NUMERO_APOYOS"/>  
  <property name="telefonoDocente" column="CNA_TELEFONO_DOCENTE"/>  
  <property name="emailDocente" column="CNA_EMAIL_DOCENTE"/>  
  <property name="celularDocente" column="CNA_CELULAR_DOCENTE"/>  
  <property name="titulo" column="CNA_TITULO"/>
  <property name="palabras" column="CNA_NUMERO_PALABRAS"/>
  <property name="coautores" column="CNA_COAUTORES"/>
  <property name="resumen" column="CNA_RESUMEN"/>
  <property name="issn" column="CNA_ISSN"/>
  <property name="estado" column="CNA_ESTADO"/>
  <property name="area" column="CNA_AREA"/>
    
  <property name="requerimiento1" column="CNA_REQUERIMIENTO1"/>  
  <property name="requerimiento2" column="CNA_REQUERIMIENTO2"/>  
  <property name="requerimiento3" column="CNA_REQUERIMIENTO3"/>  
  <property name="comentarioEvaluacion" column="CNA_COMENTARIO_EVALUACION"/>  
   
  
  <property name="fechaEstimadaVri" column="CNA_FECHA_ESTIMADA_VRI"/>
  <property name="comentarioVri" column="CNA_COMENTARIO_VRI"/>    	
  
  <property name="fechaEnvio" column="CNA_FECHA_ENVIO_VRI"/>
  
    
  <many-to-one name="personaInv" class="Persona" not-null="false" lazy="false">
	<column name="PER_ID"/>
    <column name="TDO_ID"/>
  </many-to-one>        
  
  <set name="archivos" table="HER_ARCHIVO_CONVOCATORIA" cascade="all-delete-orphan" fetch="join">
	    <key column="ACN_CONVOCATORIA"/>
	    <one-to-many class="ArchivoConvocatoria"/>
  </set>  
     
 </class>
</hibernate-mapping>

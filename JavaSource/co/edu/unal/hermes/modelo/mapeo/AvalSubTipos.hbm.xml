<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="co.edu.unal.hermes.modelo">
	<class name="AvalSubTipos" table="HER_AVAL_SUBTIPOS">
		<id name="id" column="AVS_ID" type="long">
			<generator class="sequence">
				<param name="sequence">SEQ_AVAL_SUBTIPOS</param>
			</generator>
		</id>
		<many-to-one name="aval" class="Aval"
			column="AVI_ID" not-null="true" lazy="false" />
			
		<many-to-one name="subTipo" class="DominioDetalle" lazy="false">
			<column name="DOM_ID" />
			<column name="DOMDET_TIPO" />
		</many-to-one>

		<property name="fechaAgregado" column="AVS_FECHA" />	
		 
	</class>
</hibernate-mapping>

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="co.edu.unal.hermes.modelo">
	<class name="materialSesion" table="HER_MATERIAL_SESION">


		<id name="id" column="MAT_ID" type="long">
			<generator class="sequence">
				<param name="sequence">SEC_HER_MATERIAL_SESION</param>
			</generator>
		</id>
		
		<many-to-one name="sesion" column="SES_ID" class="SesionCurso" lazy="false" not-null="true"/>
		
		<property name="descripcion" column="MAT_DESCRIPCION" />
		<property name="cantidad" column="MAT_CANTIDAD" />
		<property name="valor" column="MAT_VALOR" />

	</class>
</hibernate-mapping>
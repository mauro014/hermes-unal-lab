<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 2.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="co.edu.unal.hermes.modelo">
	<class name="TipoPropiedadIntelectual" table="HER_PROPIEDAD_INT_TIPO">
		<id name="id" column="PIT_ID" type="long">
		</id>
		
		<property name="nombre" column="PIT_NOMBRE" type="string"/>
		<property name="descripcion" column="PIT_DESCRIPCION" type="string"/>
		<property name="estado" column="PIT_ESTADO" type="string"/>
		
	</class>
</hibernate-mapping>
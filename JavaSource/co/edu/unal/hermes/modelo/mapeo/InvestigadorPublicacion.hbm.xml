<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="co.edu.unal.hermes.modelo">
 <class name="InvestigadorPublicacion" table="HER_INVESTIGADOR_PUBLICACION">
  <id name="id" column="IPU_ID" type="long">
   <generator class="sequence">
    <param name="sequence">SEQ_INVESTIGADOR_PUBLICACION</param>
   </generator>
  </id>
  
  <many-to-one name="investigador" class="InvestigadorInterno" not-null="true" lazy="false">
  	<column name="INV_ID"/>
    <column name="TDO_ID"/>
  </many-to-one>
  
  <property name="tipo" column="IPU_TIPO"/>
  <property name="autores" column="IPU_AUTORES"/>  
  <property name="publicacion" column="IPU_PUBLICACION"/>  

 </class>
</hibernate-mapping>


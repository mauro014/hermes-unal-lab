<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="co.edu.unal.hermes.modelo">
	<class name="ProyectoInformePermisosBio" table="HER_PROYECTO_INF_PERMISOS_BIO">
		<id name="id" column="PIP_ID" type="long">
			<generator class="sequence">
				<param name="sequence">SEQ_PROYECTO_INF_PERMISOS_BIO</param>
			</generator>
		</id>

		<many-to-one name="informe" class="ProyectoInforme" column="PIN_ID"
			not-null="true" />

		<property name="areaProtegida" column="PIP_AREA_PROTEGIDA" />
		<property name="nroPermiso" column="PIP_NRO_PERMISO" />
		<property name="fechaDesde" column="PIP_FECHA_DESDE" />
		<property name="fechaHasta" column="PIP_FECHA_HASTA" />
		
	</class>
</hibernate-mapping>

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="co.edu.unal.hermes.modelo.editorial">
	<class name="CantidadMaterialGrafico" table="HER_CANTIDAD_MATERIAL_GRAFICO">
		<id name="id" column="CMG_ID" type="long">
			<generator class="sequence">
				<param name="sequence">SEQ_CANTIDAD_MATERIAL_GRAFICO</param>
			</generator>
		</id>

		<many-to-one name="proyecto" class="co.edu.unal.hermes.modelo.Proyecto" column="PRY_ID" not-null="true" />
		<many-to-one name="tipoMaterialGrafico" class="TipoMaterialGrafico" column="TCM_ID" not-null="true" lazy="false"/>
		<property name="cantidadPropio" column="CMG_CANTIDAD_PROPIO" />
		<property name="cantidadAjeno" column="CMG_CANTIDAD_AJENO" />		
	</class>
</hibernate-mapping>

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="co.edu.unal.hermes.modelo.laboratorios">

	<class name="LaboratorioDetalleDocencia" table="HER_LABORATORIO_DET_DOCENCIA">

		<id name="id" column="LDD_ID" type="long">
			<generator class="sequence">
				<param name="sequence">SEQ_DETALLE</param>
			</generator>
		</id>

		<many-to-one name="laboratorio"
			class="co.edu.unal.hermes.modelo.laboratorios.Laboratorio" lazy="false">
			<column name="LAB_ID" />
		</many-to-one>

		<property name="practicasSemanales" column="LDD_PRACTICAS_SEMANALES" />

		<property name="horasSemana" column="LDD_HORAS_SEMANA" />

		<property name="fechaRegistro" column="LDD_FECHA_REGISTRO" />

		<many-to-one name="asignatura"
			class="co.edu.unal.hermes.modelo.VAsignaturasSIA" lazy="false">
			<column name="ASI_ID" />
		</many-to-one>
		
		<property name="modalidadVirtual" column="LDD_MOD_VIRTUAL" />
		
		<property name="modalidadPresencial" column="LDD_MOD_PRESENCIAL" />

	</class>

</hibernate-mapping>
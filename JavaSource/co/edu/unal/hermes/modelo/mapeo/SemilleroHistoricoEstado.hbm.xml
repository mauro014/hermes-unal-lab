<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="co.edu.unal.hermes.modelo">
	<class name="SemilleroHistoricoEstado"
		table="HER_SEMILLERO_HISTORICO_ESTADO">
		<id name="id" column="HSE_ID" type="integer">
			<generator class="sequence">
				<param name="sequence">SEQ_SEMILLERO_HISTORICO_ESTADO</param>
			</generator>
		</id>
		<many-to-one name="semillero" class="Semillero"
			column="SEM_ID" not-null="true" lazy="false" />
		<many-to-one name="estado" class="SemilleroEstado"
			column="SEE_ID" not-null="true" lazy="false" />
		<property name="motivo" column="HSE_MOTIVO" />
		<property name="fecha" column="HSE_FECHA" type="date" />
		<many-to-one name="responsable" class="Investigador"
			not-null="true" lazy="false">
			<column name="INV_ID" />
			<column name="TDO_ID" />
		</many-to-one>
	</class>
</hibernate-mapping>
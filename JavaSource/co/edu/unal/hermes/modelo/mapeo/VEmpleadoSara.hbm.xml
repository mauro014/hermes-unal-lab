<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="co.edu.unal.hermes.modelo">

	<class name="VEmpleadoSara" table="vu_empleados_sara">

		<!-- <id name="llave" column="LLAVE"> -->
		<!-- <generator class="assigned"> -->
		<!-- </generator> -->
		<!-- </id> -->

		<composite-id class="IdPersona" name="id" unsaved-value="none">
			<key-property name="tipoDocumento" column="TIPODOCUMENTO" />
			<key-property name="documento" column="DOCUMENTO" />
		</composite-id>

		<!-- <property name="tipoDocumento" column="TIPODOCUMENTO" /> -->
		<!-- <property name="documento" column="DOCUMENTO" /> -->

		<property name="direccion" column="DIRECCION" />

		<property name="estudios" column="ESTUDIOS" />
		<property name="estado" column="ESTADO" />
		<property name="descripcionEstado" column="DESCRIPCIONESTADO" />

		<!-- <many-to-one name="vinculacionObj" class="TipoVinculacion" column="VINCULACION" 
			lazy="false" /> -->

		<property name="vinculacion" column="VINCULACION" />
		<property name="nombreVinculacion" column="NOMBREVINCULACION" />

		<property name="nombreUnidad" column="NOMBRE_UNIDAD" />
		<property name="zonaEconomica" column="CEML_ZONAECONOMICA" />
		<property name="nombreZona" column="NOMBRE_ZONA" />
		<property name="centroCosto" column="CEML_CENTROCOSTO" />
		<property name="nombreCentro" column="NOMBRE_CENTRO" />
		<property name="email" column="EMAIL" />
		<property name="genero" column="GENERO" />
		<property name="fechaNacimiento" column="DHOV_NACIMIENTO" />
		<property name="telefono" column="CHOV_TELEFONO" />


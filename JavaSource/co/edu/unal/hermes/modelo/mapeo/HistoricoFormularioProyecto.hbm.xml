<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="co.edu.unal.hermes.modelo">
	<class name="HistoricoFormularioProyecto" table="HER_HISTORICO_FORM_PROYECTO">
		<id name="id" column="HFO_ID" type="long">
			<generator class="sequence">
				<param name="sequence">SEQ_ESTUDIANTE_PROYECTO</param>
			</generator>
		</id>

		<many-to-one name="proyecto" class="Proyecto" column="PRY_ID"
			not-null="true" lazy="false" />
		<many-to-one name="formulario" class="Formulario" column="FRM_ID"
			not-null="true" lazy="false" />

		<property name="docPersona" column="PER_ID" />
		<property name="tipoDocumentoPersona" column="TDO_ID" />
		<property name="fechaCambio" column="HFO_FECHA" type="timestamp" />
		<property name="esParcial" column="HFO_PARCIAL" />
	</class>
</hibernate-mapping>
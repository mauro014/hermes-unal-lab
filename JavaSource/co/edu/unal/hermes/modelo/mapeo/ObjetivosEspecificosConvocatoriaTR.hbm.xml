<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="co.edu.unal.hermes.modelo">
	<class name="ObjetivosEspecificosConvocatoriaTR" table="HER_CONVOCATORIA_TR_OBJS">
		<id name="id" column="CON_TR_OJBS_ID" type="long">
			<generator class="sequence">
				<param name="sequence">SEQ_OBJ_ESP_CONV_TR</param>
			</generator>
		</id>
		<property name="descripcion" column="CON_TR_OJBS_DESCRIPCION" />
		<property name="orden" column="CON_TR_OJBS_ORDEN" />
		<many-to-one name="convocatoriaTR" class="ConvocatoriaTerminosReferencia" column="CON_TR_ID" not-null="true" lazy="false" />
		
	</class>
</hibernate-mapping>

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="co.edu.unal.hermes.modelo.laboratorios">
 <class name="LaboratorioMetroEnsayoFisico" table="HER_LAB_ENSAYOS_FISICOS">
  
  <id name="id" column="LEF_ID" type="long">
   <generator class="sequence">
    <param name="sequence">SEQ_LAB_ENSAYOS_FISICOS</param>
   </generator>
  </id>
  
  <many-to-one name="laboratorio" class="co.edu.unal.hermes.modelo.laboratorios.Laboratorio" column="LAB_ID" not-null="true" lazy="false"/>  

  <property name="nombreEnsayo" column="LEF_NOMBRE_ENSAYO" />
  <property name="productosMaterialAEnsayar" column="LEF_PRODUCTO_MATERIAL" />
  <property name="propiedadesMedibles" column="LEF_PROPIEDADES_MEDIBLES" />
  <property name="minimo" column="LEF_MINIMO" />
  <property name="maximo" column="LEF_MAXIMO" />
  <property name="unidades" column="LEF_UNIDADES" />
  <property name="descripcion" column="LEF_DESCRIPCION" />
  <property name="normaTecnicaProcedimiento" column="LEF_NORMA_TEC_PROCED" />
  
  <property name="fechaRegistro" column="LEF_FECHA_REGISTRO" />

 </class>
</hibernate-mapping>

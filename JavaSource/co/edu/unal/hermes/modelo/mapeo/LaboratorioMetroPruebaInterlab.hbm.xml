<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="co.edu.unal.hermes.modelo.laboratorios">
 <class name="LaboratorioMetroPruebaInterlab" table="HER_LAB_PRUEBAS_INTERLAB">
  
  <id name="id" column="LPI_ID" type="long">
   <generator class="sequence">
    <param name="sequence">SEQ_LAB_PRUEBAS_INTERLAB</param>
   </generator>
  </id>
  
  <property name="participa" column="LPI_PARTICIPA" />
  <property name="cual" column="LPI_CUAL" />
  <property name="nombreProveedor" column="LPI_NOMBRE_PROVEEDOR" />
  <property name="tipoDocumento" column="LPI_TIPO_DOC" />
  <property name="identificacion" column="LPI_NUM_DOC" />
  
  <many-to-one name="laboratorio" class="co.edu.unal.hermes.modelo.laboratorios.Laboratorio" column="LAB_ID" not-null="true" lazy="false"/>  
  <many-to-one name="desempenoObtenido" class="co.edu.unal.hermes.modelo.Tipos" column="LPI_DESEMPEÑO" not-null="true" lazy="false"/>
  <many-to-one name="proveedor" class="co.edu.unal.hermes.modelo.Tipos" column="LPI_PROVEEDOR" not-null="true" lazy="false"/>
  
  <property name="fechaRegistro" column="LPI_FECHA_REGISTRO" />

 </class>
</hibernate-mapping>

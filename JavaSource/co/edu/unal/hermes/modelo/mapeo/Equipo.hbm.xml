<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="co.edu.unal.hermes.modelo">
 <class name="Equipo" table="HER_EQUIPO">
  
  
    <id name="id" column="EQU_PLACA_INVENTARIO_ID" type="string" >
 
  </id> 
 
  <property name="genero" column="EQU_GENERO_EQUIPO" not-null="true"/>
  <property name="marca" column="EQU_MARCA"/>
  <property name="modelo" column="EQU_MODELO"/>
  
  <property name="numSerieFabrica" column="EQU_NUMERO_DE_SERIE"/>
  <property name="nombreProveedor" column="EQU_PROVEEDOR"/>
  <property name="nombreGeneradorLicencia" column="EQU_GENERADOR_LICENCIA"/>
  <property name="numSalon" column="EQU_NUMERO_SALON"/>
  
   <property name="mantenimientoAmbito" column="EQU_MANTENIMIENTO_AMBITO" />
  <property name="mantenimientoTipo" column="EQU_MANTENIMIENTO_TIPO" />
  <property name="mantenimientoFrecuencia" column="EQU_MANTENIMIENTO_FRECUENCIA" />
  <property name="duracionGarantia" column="EQU_DURACION_GARANTIA" type="long"/>
  <property name="valorCompra" column="EQU_VALOR_COMPRA" type="double"/>
  <property name="valorTRM" column="EQU_TRM" type="double"/>
  <property name="fechaCompra" column="EQU_FECHA_COMPRA" />
  <property name="observaciones" column="EQU_OBSERVACIONES" />
  
   <property name="nombreFuncionarioResponsable" column="EQU_NOMBRE_FUN_RESPONSABLE" />
   <property name="idFuncionarioResponsable" column="EQU_ID_FUN_RESPONSABLE" />
   <property name="telefonoFuncionarioResponsable" column="EQU_TEL_FUN_RESPONSABLE" />
   <property name="emailFuncionarioResponsable" column="EQU_EMAIL_FUN_RESPONSABLE" />
   <property name="cargoFuncionarioResponsable" column="EQU_CARGO_FUN_RESPONSABLE" />
   <property name="dependenciaFuncionarioResponsable" column="EQU_DEPENDEN_FUN_RESPONSABLE" />
  <property name="tipoDocumentoFuncionarioResponsable" column="EQU_TIPO_DOCUMENTO_FUN_RESPONS" />
   <property name="extencionFuncionarioResponsable" column="EQU_EXTENCION_FUN_RESPONSABLE" />
   <property name="faxFuncionarioResponsable" column="EQU_FAX_FUN_RESPONSABLE" />
   
   <property name="numDocumentoDocenteResponsable" column="EQU_PER_ID" />
   <property name="tipoDocumentoDocenteResponsable" column="EQU_TDO_ID" />
   <property name="nombreDocenteResponsable" column="EQU_NOMBRE_PER" />
  <property name="fechaVencimientoGarantia" column="EQU_FECHA_VENCIMINETO_GARANTIA" />
  
  <many-to-one name="equipoTipo" class="EquipoTipo" column="EQT_ID" />
  <many-to-one name="moneda" class="Moneda" column="MON_ID" />
  <many-to-one name="sede" class="Sede" column="SED_ID" lazy="false" />
  <many-to-one name="edificio" class="Edificio" column="EDF_ID" />
  <many-to-one name="proyecto" class="Proyecto" column="PRY_ID" lazy="false"/>
  <many-to-one name="equipoCondicion" class="EquipoCondicion" column="EQC_ID" />
  <many-to-one name="requiereMantenimientoEspecializado" class="Tipos" column="REQUIERE_MANTENIMIENTO_TIPOS" />
  <many-to-one name="tipoMantenimientoEspecializado" class="Tipos" column="TIPO_MANTENIMIENTO_ESPECIA" />
  
  
 <set name="documentacion" table="HER_EQUIPO_DOCUMENT">
   <key column="EQU_PLACA_INVENTARIO_ID"/>
   <many-to-many class="DocumentDeEquipo" column="DEQ_ID"/>
  </set>
 
  <set name="equipoUsuarios" table="HER_EQUIPO_USUARIOS"
   inverse="true" cascade="all-delete-orphan" lazy="false">
   <key column="EQU_PLACA_INVENTARIO_ID"/>
   <one-to-many class="EquipoUsuarios"/>
  </set>  

  <set name="tipos" table="HER_EQUIPO_EQUIPO_TIPO"
   inverse="true" cascade="all-delete-orphan" lazy="true">
   <key column="EQU_ID"/>
   <many-to-many class="Tipos" column="EQT_TIPOS_ID"/>
  </set>  


 </class>
</hibernate-mapping>

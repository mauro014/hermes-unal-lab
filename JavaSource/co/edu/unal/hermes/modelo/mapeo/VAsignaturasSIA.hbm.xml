<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="co.edu.unal.hermes.modelo">
	<class name="VAsignaturasSIA" table="SIA_V_ASIGNATURAS_HERMES">

		<id name="id" column="ASI_ID" type="long">
			<generator class="sequence">
				<param name="sequence">SEQ_ASIGNATURA</param>
			</generator>
		</id>

		<property name="annio" column="AÑO" type="string" length="4" />
		<property name="semestre" column="SEMESTRE" type="string"
			length="2" />

		<many-to-one name="sede" class="co.edu.unal.hermes.modelo.Sede"
			lazy="false">
			<column name="COD_SEDE" />
		</many-to-one>

		<many-to-one name="facultad" class="co.edu.unal.hermes.modelo.Dependencia"
			lazy="false">
			<column name="FAC" />
		</many-to-one>

		<many-to-one name="uab" class="co.edu.unal.hermes.modelo.Dependencia"
			lazy="false">
			<column name="UAB" />
		</many-to-one>

		<property name="codAsignatura" column="COD_ASIGNATURA" type="string"
			length="15" />
		<property name="grupo" column="GRUPO" type="string" length="40" />
		<property name="nombreAsignatura" column="NMBRE_ASIGNATURA"
			type="string" length="100" />

		<property name="inscritos" column="INSCRITOS" type="integer" />

		<property name="tnivel" column="TNIVEL" type="string" length="3" />
		<property name="nivel" column="NIVEL" type="string" length="75" />

	</class>
</hibernate-mapping>

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="co.edu.unal.hermes.modelo.laboratorios">
	<class name="LaboratorioCostosPersonal" table="HER_LAB_COSTOS_PERSONAL_SERV">
		<id name="id" column="HLCPS_ID" type="long">
			<generator class="sequence">
				<param name="sequence">SEQ_DETALLE</param>
			</generator>
		</id>
		<many-to-one name="costosServicio" class="LaboratorioCostosServicio"
			lazy="false" column="HLCS_ID" />
		<property name="nombrePersonal" column="HLCPS_NOMBRE_PERSONAL" />
		<property name="salarioMensual" column="HLCPS_SALARIO_MENSUAL" />
		<property name="tiempoMinutos" column="HLCPS_TIEMPO_MINUTOS" />
	</class>
</hibernate-mapping>
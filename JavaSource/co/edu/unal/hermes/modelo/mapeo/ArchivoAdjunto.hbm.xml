<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="co.edu.unal.hermes.modelo">
 <class name="ArchivoAdjunto" table="HER_ARCHIVO_ADJUNTO">
  <id name="id" column="ARA_ID" type="long">
   <generator class="sequence">
    <param name="sequence">SEQ_ARCHIVO_ADJUNTO</param>
   </generator>
  </id>
  <property name="nombre" column="ARA_NOMBRE"/>
  <property name="datos" type="blob" column="ARA_DATOS"/>
 </class>
</hibernate-mapping>

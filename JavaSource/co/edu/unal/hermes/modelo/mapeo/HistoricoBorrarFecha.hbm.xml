<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
                                   
<hibernate-mapping package="co.edu.unal.hermes.modelo">

 <class name="HistoricoBorrarFecha" table="HER_HISTORICO_BORRAR_FECHA">
  
  <id column="HBF_ID" name="id" type="long">
  	<generator class="sequence">
         <param name="sequence">SEQ_HISTORICO_BORRAR_FECHA</param>
    </generator>
  </id>
  
  <many-to-one name="proyecto" column="PRY_ID" class="Proyecto" not-null="true"/>
  
  <property name="fecha" column="HBF_FECHA" type="timestamp" />   
  <many-to-one name="responsable" class="co.edu.unal.hermes.modelo.Persona" 
	  	lazy="false">
		<column name="HBF_RESPONSABLE"/>
		<column name="HBF_TDO_ID"/>
	</many-to-one>
  
  <property name="fechaBorrada" column="HBF_FECHA_BORRADA" type="timestamp" /> 
 </class> 
</hibernate-mapping>
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 2.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="co.edu.unal.hermes.modelo">
 <class name="TipoRubro" table="HER_TIPO_RUBRO">
  <id name="id" column="TRU_ID" type="long">
   <generator class="assigned"/>
  </id>
  <property name="nombre" column="TRU_NOMBRE"/>
  <property name="descripcion" column="TRU_DESCRIPCION"/>
   <property name="quipu" column="TRU_QUIPU"/>
    <property name="codigoQuipu" column="TRU_CODIGO"/>
  <many-to-one name="padre" class="TipoRubro" column="TRU_ID_PADRE" not-null="true" lazy="false"/>
  <property name="nombreVRI" column="TRU_NOMBRE_VRI"/>
  <property name="rubroContrapartida" column="TRU_CONTRAPARTIDA" />
  <property name="estado" column="TRU_ESTADO" />
 </class>
</hibernate-mapping>

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 2.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="co.edu.unal.hermes.modelo">
	<class name="ArchivoPropiedadIntelectual" table="HER_ARCHIVO_PROPIEDAD_INT">
		<id name="id" column="API_ID" type="long">
			<generator class="sequence">
    			<param name="sequence">SEQ_ARCHIVO_PROPIEDAD_INT</param>
   			</generator>
		</id>

		<many-to-one name="propiedad" class="PropiedadIntelectual"  column="PRI_ID"/>
		<many-to-one name="tipo" class="TipoArchivo" column="TIA_ID" not-null="false" lazy="false"/>

		<property name="nombre" column="API_NOMBRE" type="string"/>
		<property name="descripcion" column="API_DESCRIPCION" type="string"/>
		<property name="estado" column="API_ESTADO" type="string"/>
		<property name="fechaCreacion" column="API_FECHA" />
		<property name="fechaBorrado" column="API_FECHA_BORRADO" />
		<property name="visibleDocente" column="API_VISIBLE" type="boolean" not-null="true"/>
		
		<many-to-one name="personaCarga" class="Persona">
			<column name="PER_ID" />
			<column name="TDO_ID" />
		</many-to-one>

		<many-to-one name="personaElimina" class="Persona">
			<column name="PER_ID_ELIMINA" />
			<column name="TDO_ID_ELIMINA" />
		</many-to-one>
		
		<property name="propiedadBorrado" column="PRI_ID_BORRADO" />
		
	</class>
</hibernate-mapping>
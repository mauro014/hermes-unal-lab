<?xml version="1.0" encoding="UTF-8"?>


<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<!--
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "D:\hermes\dtds\hibernate-mapping-3.0.dtd">
-->

<hibernate-mapping package="co.edu.unal.hermes.modelo">
 <class name="MovilidadSeguimientoEvento" table="HER_MOVSEG_EVENTO">
    
 
  <id name="id" column="MSE_ID" type="long" unsaved-value="-1">
   <generator class="sequence">
    <param name="sequence">SEQ_MOVILIDAD_EVENTO</param>
   </generator> 
  </id>	
  

    
  <property name="movilidadId" column="MOV_ID"/>
  <property name="detalleTipo" column="DOMDET_ID"/>
  <property name="asistente" column="MSE_ASISTENTES"/>
  
   <set name="asistentes" table="HER_MOVSEG_EVENTO_ASISTENTE" 
   	cascade="all-delete-orphan" fetch="join" lazy="false">
	    <key column="MSE_ID"/>
	    <one-to-many class="MovilidadSeguimientoEventoAsistente"/>
  </set>
  


    
 </class>
</hibernate-mapping>

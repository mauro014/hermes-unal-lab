<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping
	package="co.edu.unal.hermes.modelo.editorial">
	<class name="TipoMaterialGrafico"
		table="HER_TIPO_MATERIAL_GRAFICO">
		<id name="id" column="TCM_ID" type="short">
			<generator class="native" />
		</id>
		<property name="nombre" column="TCM_NOMBRE" />
		<property name="estado" column="TCM_ESTADO" type="boolean"
			not-null="true" />
	</class>
</hibernate-mapping>

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="co.edu.unal.hermes.modelo">
 <class name="LogAlertasAutomaticas" table="HER_LOG_ALERTAS_AUTOMATICAS">
  <id name="id" column="LAA_ID" type="long">
   <generator class="sequence">
    <param name="sequence">SEQ_LOG_ALERTAS_AUTOMATICAS</param>
   </generator>
  </id>
  <property name="id" column="LAA_ID"/>
  <property name="idObjeto" column="OBJ_ID"/>
  <property name="tipoObjeto" column="OBJ_TIPO"/>
  <property name="valorObjeto" column="OBJ_VALUE"/>
  <property name="fecha" column="LAA_FECHA"/>
  <property name="destinatarios" column="OBJ_DESTINATARIOS"/>
  <property name="cuerpoCorreo" column="OBJ_CUERPO_CORREO"/>
 </class>
</hibernate-mapping>

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="co.edu.unal.hermes.modelo">
 <class name="ArchivoRequerimiento" table="HER_ARCHIVO_REQUERIMIENTO">
 
  <id name="id" column="ARE_ID" type="long">
   <generator class="sequence">
    <param name="sequence">SEQ_ARCHIVO_REQUERIMIENTO</param>
   </generator>
  </id>
 
  <many-to-one name="requerimiento" class="co.edu.unal.hermes.modelo.Requerimiento" column="REQ_ID" not-null="false" lazy="false"/>
  
  <property name="nombre" column="ARE_NOMBRE"/>  
  <property name="archivo" type="blob" column="ARE_ARCHIVO"/>
  <property name="tipoArchivoReq" column="ARE_TIPO_ARCHIVO"/>
 
  
 </class>
</hibernate-mapping>

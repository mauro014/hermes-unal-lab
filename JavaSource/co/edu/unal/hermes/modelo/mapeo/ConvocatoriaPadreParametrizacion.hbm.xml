<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="co.edu.unal.hermes.modelo">
	<class name="ConvocatoriaPadreParametrizacion" table="HER_CONVOCATORIA_PADRE_PARAM">
		<id name="id" column="CPP_ID" type="long">
			<generator class="sequence">
				<param name="sequence">SEQ_CONVOCATORIA_PADRE_PARAM</param>
			</generator>
		</id>
		<many-to-one name="convocatoriaPadre" class="ConvocatoriaPadre"
			column="CNP_ID" lazy="false" />
		<many-to-one name="dependencia" class="Dependencia"
			column="DPN_ID" lazy="false" />
		<many-to-one name="tipoParametro" class="Tipos"
			column="CPP_TIPO_PARAM" lazy="false" />
		<property name="valorParametro" column="CPP_VALOR" />
	</class>
</hibernate-mapping>
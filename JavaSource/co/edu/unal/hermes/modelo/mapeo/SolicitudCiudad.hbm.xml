<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="co.edu.unal.hermes.modelo.seguimiento">

 <class name="SolicitudCiudad" table="HER_SOLICITUD_CIUDAD">
 
  <id name="id" column="SLC_ID" type="long">
   <generator class="sequence">
    <param name="sequence">SEQ_SOLICITUD_CIUDAD</param>
   </generator>
  </id>
   
  	<many-to-one name="solicitud" class="Solicitud"  column="SOL_ID" not-null="false" lazy="false"/>    
	<property name="fecha" column="SLC_FECHA" type="date" />  
	<many-to-one name="ciudad" class="co.edu.unal.hermes.modelo.Ciudad"  column="CIU_ID" lazy="false"/>
   
 </class>
</hibernate-mapping>







<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="co.edu.unal.hermes.modelo">
 <class name="LineaInvestigacion" table="HER_LINEA_INVESTIGACION">
  <id name="id" column="LIN_ID" type="long">
   <generator class="sequence">
    <param name="sequence">SEQ_LINEA_INVESTIGACION</param>
   </generator>
  </id>
  <property name="nombre" column="LIN_NOMBRE"/>
  <property name="origen" column="LIN_ORIGEN"/>
  
  <set name="proyectos" table="HER_PROYECTO_LINEA">
   <key column="LIN_ID"/>
   <many-to-many class="Proyecto" column="PRY_ID"/>
  </set>
  
  <set name="grupos" table="HER_GRUPO_LINEA">
   <key column="LIN_ID"/>
   <many-to-many class="Grupo" column="GRU_ID"/>
  </set>
  
  <set name="investigadores" table="HER_INVESTIGADOR_LINEA">
   <key column="LIN_ID"/>
   <many-to-many class="Investigador">
    <column name="INV_ID"/>
    <column name="TDO_ID"/>
   </many-to-many>
  </set>
 </class>
</hibernate-mapping>

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="co.edu.unal.hermes.modelo">

	<class name="DiagnosticoSoftware" table="HER_DIAG_SOFTWARE">

		<id name="id" column="HDS_ID" type="long">
			<generator class="sequence">
				<param name="sequence">SEQ_DETALLE</param>
			</generator>
		</id>

		<property name="documentoPersona" column="PER_ID" />
		<property name="tipoDocumentoPersona" column="TDO_ID" />
		<property name="fecha" column="HDS_FECHA" />

		<property name="cargoPersona" column="HDS_CARGO_PER" />

		<property name="tipoRegistro" column="HDS_TIPO_REGISTRO" />
		<property name="nombreSoftware" column="HDS_NOMBRE_SOFTWARE" />
		<property name="sistemaOperativo" column="HDS_SISTEMA_OPERATIVO" />
		<property name="descripcionSoftware" column="HDS_DESCRIPCION_SOFTWARE" />
		<property name="softwareLibre" column="HDS_SOFTWARE_LIBRE" />
		<property name="disponibidadEquipos" column="HDS_DISPONIBILIDAD_EQUIPOS" />

		<property name="comentarios" column="HDS_COMENTARIOS" />

		<many-to-one name="ejecucion" class="Tipos" lazy="false">
			<column name="HDS_EJECUCION_TIPO_ID" />
		</many-to-one>

		<many-to-one name="sede" class="Sede" lazy="false">
			<column name="SED_ID" />
		</many-to-one>

		<many-to-one name="facultad" class="Dependencia" column="HDS_FACULTAD"
			lazy="false" />

		<many-to-one name="departamento" class="Dependencia"
			column="HDS_DEPTO" lazy="false" />

		<property name="idPadre" column="HDS_ID_PADRE" />

		<many-to-one name="empresa" class="Empresa" column="HDS_EMP_ID"
			lazy="false" />

		<many-to-one name="asignatura" class="VAsignaturasSIA"
			column="HDS_ASIGNATURA" lazy="false" />

		<many-to-one name="areaConocimiento" class="ClasificacionConocimiento"
			column="CLC_ID" lazy="false" />

		<property name="profesores" column="HDS_PROFESORES" />
		<property name="estudiantesPregrado" column="HDS_ESTUDIANTES_PREGRADO" />
		<property name="estudiantesPosgrado" column="HDS_ESTUDIANTES_POSGRADO" />

	</class>

</hibernate-mapping>
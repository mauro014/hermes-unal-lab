<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="co.edu.unal.hermes.modelo">
	<class name="SemilleroInformeActividad"
		table="HER_SEMILLERO_INF_ACTIVIDAD">
		<id name="id" column="SIA_ID" type="integer">
			<generator class="sequence">
				<param name="sequence">SEQ_SEMILLERO_INF_ACTIVIDAD</param>
			</generator>
		</id>
		<many-to-one name="informe" class="SemilleroInforme"
			column="SIN_ID" lazy="false" />
			
		<many-to-one name="actividad" class="SemilleroActividad"
			lazy="false">
			<column name="SAC_ID"></column>
			
		</many-to-one>

		<property name="descripcionActividad" column="SAC_DESCRIPCION" />
		<property name="responsableActividad" column="SEI_ID" />
		<property name="porcentajeAvance" column="SIA_PORC_AVANCE" />
		<property name="avance" column="SIA_AVANCE" />
	</class>
</hibernate-mapping>
<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="co.edu.unal.hermes.modelo">
 <class name="InvestigadorLineaInvestigacion" table="HER_INVESTIGADOR_LINEA">
  <id name="id" column="ILI_ID" type="long">
   <generator class="sequence">
    <param name="sequence">SEQ_INVESTIGADOR_LINEA_INV</param>
   </generator>
  </id>
  
  <many-to-one name="investigador" class="Investigador" not-null="true" lazy="false">
  	<column name="INV_ID"/>
    <column name="TDO_ID"/>
  </many-to-one>
  
  <many-to-one name="linea" column="LIN_ID" class="LineaInvestigacion" lazy="false"/>  

 </class>
</hibernate-mapping>


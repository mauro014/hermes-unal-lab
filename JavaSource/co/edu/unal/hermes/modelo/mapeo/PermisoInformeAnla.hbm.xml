<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="co.edu.unal.hermes.modelo">
	<class name="PermisoInformeAnla" table="HER_PERMISO_INFORME_ANLA">
		<id name="id" column="PIA_ID" type="long">
			<generator class="sequence">
				<param name="sequence">SEQ_PERMISO_INFORME_ANLA</param>
			</generator>
		</id>

		<property name="numeroInformeAnla"
			column="PIA_NUMERO_INFORME_ANLA" type="integer" />
		<property name="codigoInformeAnla"
			column="PIA_CODIGO_INFORME_ANLA" type="string" />
		<property name="fechaEnvioInformeAnla"
			column="PIA_FECHA_ENVIO_INFORME_ANLA" type="date" />
		<property name="numeroOficioVri"
			column="PIA_NUMERO_OFICIO_VRI" type="integer" />
		<property name="eliminado"
			column="PIA_ELIMINADO" type="string" />
		<property name="fechaEliminado"
			column="PIA_FECHA_ELIMINADO" type="date" />

	</class>
</hibernate-mapping>

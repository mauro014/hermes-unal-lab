<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="co.edu.unal.hermes.modelo">
	<class name="ProyectoInformeActividad" table="HER_PROYECTO_INFORME_ACTIVIDAD">
		<id name="id" column="PIA_ID" type="long">
			<generator class="sequence">
				<param name="sequence">SEQ_PROYECTO_INFORME_ACTIVIDAD</param>
			</generator>
		</id>

		<many-to-one name="informe" class="ProyectoInforme" column="PIN_ID"
			not-null="true" />
		<many-to-one name="actividad" class="Actividad" column="ACT_ID"
			not-null="true" lazy="false"/>
		
		<property name="justificacionAvance" column="PIA_JUSTIFICACION_AVANCE" />
		<property name="porcentajeAvance" column="PIA_PORCENTAJE_AVANCE" />
		<property name="idObjetivo" column="OBJ_ID" />
		<property name="comentariosCoordinador" column="PIA_COMENTARIOS_COORDINADOR" />
		
	</class>
</hibernate-mapping>

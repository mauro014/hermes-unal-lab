<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="co.edu.unal.hermes.modelo">
	<class name="ConvocatoriaTerminosReferencia" table="HER_CONVOCATORIA_TER_REF">
		<id name="id" column="CON_TR_ID" type="long">
			<generator class="sequence">
				<param name="sequence">SEQ_CONVOCATORIA_TER_REF</param>
			</generator>
		</id>
		<property name="tipoConvocatoria" column="CON_TR_TIPO_CONVOCATORIA" />
		<property name="otroTipoConvocatoria" column="CON_TR_OTRO_TIPO_CONV" />
		<property name="titulo" column="CON_TR_TITULO" />
		<property name="introduccion" column="CON_TR_INTRODUCCION" />
		<property name="presentacion" column="CON_TR_PRESENTACION" />
		<property name="antecedentes" column="CON_TR_ANTECEDENTES" />
		<property name="objetivo" column="CON_TR_OBJETIVO" />
		<property name="dirigidoA" column="CON_TR_DIRIGIDO_A" />
		<property name="recursosDisponibles" column="CON_TR_RECURSOS_DISP" />
		<property name="unidadEjecutra" column="CON_TR_UNIDAD_EJECUTORA" />
		<property name="apoyoGanadores" column="CON_TR_APOYO_GANADORES" />
		<property name="liquidacionProyectos" column="CON_TR_LIQUIDACION_PRY" />
		<property name="duracion" column="CON_TR_DURACION" />
		<property name="dependeciaVerificacionRequisito" column="CON_TR_DEP_REQ" />
		<property name="tipoEvaluacion" column="CON_TR_TIPO_EVALUACION" />
		<property name="responsableProcesoEvaluacion" column="CON_TR_RESPONSABLE_EVAL" />
		<property name="descripcionProcesoEvaluacion" column="CON_TR_DESCR_PROC_EVALUACION" />
		<property name="tipoPuntajeSeleccion" column="CON_TR_TIPO_PUNTAJE_SEL" />
		<property name="responsableProcesoSeleccion" column="CON_TR_RESPONSABLE_SEL" />
		<property name="subtipoEvaluacion" column="CON_TR_SUBTIPO_EVALUACION" />
		<property name="tipoPuntajeEvaluacion" column="CON_TR_TIPO_PUNTAJE" />
		<property name="puntajeMinimoEvaluacion" column="CON_TR_PUNTAJE_MINIMO" />
		<property name="propuestasFinanciables" column="CON_TR_PROPUESTAS_FINANCIABLES" />		
		<property name="procesoSelecicon" column="CON_TR_PROCESO_SELECCION" />
		<property name="criteriosDesempate" column="CON_TR_CRITERIOS_DESEMPATE" />
		<property name="tipoReclamacion" column="CON_TR_RECLAMACIONES" />
		<property name="diasParaSolicitarReclamacionesReq" column="CON_TR_REC_REQ_DIAS_SOL" />
		<property name="dependenciaResponsableResponderReclamacionReq" column="CON_TR_DEP_RECLAMACION_REQ" />
		<property name="diasParaResponderReclamacionesReq" column="CON_TR_REC_REQ_DIAS_RES" />
		<property name="tipoReclamacionEvaluacion" column="CON_TR_RECLAMACIONES_EVA" />
		<property name="diasParaSolicitarReclamacionesEva" column="CON_TR_REC_EVA_DIAS_SOL" />
		<property name="dependenciaResponsableResponderReclamacionEva" column="CON_TR_DEP_RECLAMACION_EVA" />
		<property name="diasParaResponderReclamacionesEva" column="CON_TR_REC_EVA_DIAS_RES" />
		<property name="textoPublicacionGanadores" column="CON_TR_PUBLICACION_GANADORES" />
		<property name="textoProductosAcademicos" column="CON_TR_PRODUCTOS_ACADEMICOS" />
		<property name="textoResultados" column="CON_TR_RESULTADOS" />
		<property name="tipoCalendario" column="CON_TR_TIPO_CALENDARIO" />
		<property name="cronogramaCortes" column="CON_TR_CRONOGRAMA_CORTES" />
		<property name="fechaLanzamientoConvocatoria" column="CON_TR_FECHA_LANZ_CONVO" />
		<property name="fechaPublicacionResultados" column="CON_TR_FECHA_PUBL_RES" />
		<property name="fechaInicioInscripciones" column="CON_TR_FECHA_INI_INSCRIPCIONES" />
		<property name="fechaFinInscripciones" column="CON_TR_FECHA_FIN_INSCRIPCIONES" />
		<property name="fechaInicioReclamacionesRequisitos" column="CON_TR_FECHA_INI_REC_REQ" />
		<property name="fechaFinReclamacionesRequisitos" column="CON_TR_FECHA_FIN_REC_REQ" />
		<property name="fechaRespuestaReclamacionRequisitos" column="CON_TR_FECHA_RESPU_REC_REQ" />
		<property name="fechaInicioEvaluacion" column="CON_TR_FECHA_INI_EVA" />
		<property name="fechaFinEvaluacion" column="CON_TR_FECHA_FIN_EVA" />
		<property name="fechaPublicacionPropuestasSeleccionadas" column="CON_TR_FECHA_PUB_PROP_SEL" />
		<property name="fechaInicioReclamacionesEvaluacion" column="CON_TR_FECHA_INI_REC_EVA" />
		<property name="fechaFinReclamacionesEvaluacion" column="CON_TR_FECHA_FIN_REC_EVA" />
		<property name="fechaRespuestaReclamacionesEvaluacion" column="CON_TR_FECHA_RESPU_REC_EVA" />
		<property name="fechaPublicacionGanadores" column="CON_TR_FECHA_PUBLICACION_GANAD" />
		<property name="dependenciaResponsableSeguimientoTecnico" column="CON_TR_DEP_SEG_TEC_FIN" />
		<property name="propuestasModificablesEjecucion" column="CON_TR_PROP_MODIFICABLES" />
		<property name="consideracionesEticas" column="CON_TR_CONSIDEREACIONES_ETICAS" />
		<property name="propiedadIntelectual" column="CON_TR_PROPIEDAD_INTELECTUAL" />
		<property name="textoConsideraciones" column="CON_TR_CONSIDEREACIONES" />
		<property name="textoMayorInformacion" column="CON_TR_MAYOR_INFORMACION" />
		<many-to-one name="dependenciaPrincipal" class="Dependencia" column="CON_TR_DPN_PRINCIPAL" lazy="false" />
		<property name="estado" column="CON_TR_ESTADO" />
		<property name="fechaCreacion" column="CON_TR_FECHA_CREACION" />
		<property name="fechaModificacion" column="CON_TR_FECHA_MODIFICACION" />
		<many-to-one name="personaMod" class="Persona" not-null="false"
			lazy="false">
			<column name="PER_ID_MOD" />
			<column name="TDO_ID_MOD" />
		</many-to-one>
		
		<set name="dependenciasConvoctoriaTR" table="HER_CONVOCATORIA_TR_DEP"
			inverse="true" cascade="all-delete-orphan">
			<key column="CON_TR_ID" />
			<one-to-many class="DependenciaConvocatoriaTR" />
		</set>
		
		<set name="modalidadesConvoctoriaTR" table="HER_CONVOCATORIA_TR_MOD"
			inverse="true" cascade="all-delete-orphan">
			<key column="CON_TR_ID" />
			<one-to-many class="ModalidadConvocatoriaTR" />
		</set>
		
		<set name="requisitosConvoctoriaTR" table="HER_CONVOCATORIA_TR_REQUISITOS"
			inverse="true" cascade="all-delete-orphan">
			<key column="CON_TR_ID" />
			<one-to-many class="RequisitoConvocatoriaTR" />
		</set>
		
		<set name="documentacionConvoctoriaTR" table="HER_CONVOCATORIA_TR_DOCUMENTO"
			inverse="true" cascade="all-delete-orphan">
			<key column="CON_TR_ID" />
			<one-to-many class="DocumentoConvocatoriaTR" />
		</set>
		
		<set name="compromisosConvoctoriaTR" table="HER_CONVOCATORIA_TR_COMP"
			inverse="true" cascade="all-delete-orphan">
			<key column="CON_TR_ID" />
			<one-to-many class="CompromisoConvocatoriaTR" />
		</set>
		
		<set name="incompatibilidadesConvoctoriaTR" table="HER_CONVOCATORIA_TR_INCOM"
			inverse="true" cascade="all-delete-orphan">
			<key column="CON_TR_ID" />
			<one-to-many class="IncompatibilidadConvocatoriaTR" />
		</set>
		
		<set name="rubrosConvoctoriaTR" table="HER_CONVOCATORIA_TR_RUBROS"
			inverse="true" cascade="all-delete-orphan">
			<key column="CON_TR_ID" />
			<one-to-many class="RubrosFinanciablesConvocatoriaTR" />
		</set>
		
		<set name="criteriosEvaluacionSeleccionConvoctoriaTR" table="HER_CONVOCATORIA_TR_EVAL"
			inverse="true" cascade="all-delete-orphan">
			<key column="CON_TR_ID" />
			<one-to-many class="CriteriosEvaluacionConvocatoriaTR" />
		</set>
		
		<set name="productosConvoctoriaTR" table="HER_CONVOCATORIA_TR_PRODUCTOS"
			inverse="true" cascade="all-delete-orphan">
			<key column="CON_TR_ID" />
			<one-to-many class="ProductosConvocatoriaTR" />
		</set>
		
		<set name="camposAdicionalesConvoctoriaTR" table="HER_CONVOCATORIA_TR_CA"
			inverse="true" cascade="all-delete-orphan">
			<key column="CON_TR_ID" />
			<one-to-many class="CamposAdicionalesConvocatoriaTR" />
		</set>
		
		<set name="objetivosEspecificosConvoctoriaTR" table="HER_CONVOCATORIA_TR_OBJS"
			inverse="true" cascade="all-delete-orphan">
			<key column="CON_TR_ID" />
			<one-to-many class="ObjetivosEspecificosConvocatoriaTR" />
		</set>
		


	</class>
</hibernate-mapping>

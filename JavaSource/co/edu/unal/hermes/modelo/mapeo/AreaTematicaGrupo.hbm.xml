<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="co.edu.unal.hermes.modelo">
	<class name="AreaTematicaGrupo" table="HER_GRUPO_AREA_TEMATICA">
		<id name="id" column="ART_ID" type="long">
			<generator class="sequence">
				<param name="sequence">SEQ_GRUPO_AREA_TEMATICA</param>
			</generator>
		</id>

		<many-to-one name="grupo" class="Grupo" column="GRU_ID"
			not-null="true" />

		<many-to-one name="areaTematica" class="DominioDetalle" lazy="false">
			<column name="DOM_ID" />
			<column name="DOMDET_TIPO" />
		</many-to-one>
		
	</class>
</hibernate-mapping>

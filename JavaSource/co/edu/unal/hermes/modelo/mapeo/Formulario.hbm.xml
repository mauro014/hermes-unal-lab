<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="co.edu.unal.hermes.modelo">
 <class name="Formulario" table="HER_FORMULARIO">
  <id name="id" column="FRM_ID" type="long">
   <generator class="assigned"/>
  </id>
  <property name="nombre" column="FRM_NOMBRE"/>
  <property name="tipo" column="FRM_TIPO"/>
  <property name="accion" column="FRM_ACCION"/>
  <set name="tipoModalidad" table="HER_FORMULARIO_TIPO_MODALIDAD" order-by="FRM_ID">
   <key column="FRM_ID"/>
   <many-to-many class="TipoModalidad" column="TMO_ID"/>
  </set>
 </class>
</hibernate-mapping>

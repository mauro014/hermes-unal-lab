<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="co.edu.unal.hermes.modelo">
	<class name="HistoricoInfoEvaluador" table="HER_HISTORICO_INFO_EVALUADOR">
		<id name="id" column="HIE_ID" type="long">
			<generator class="sequence">
				<param name="sequence">SEQ_HISTORICO_INFO_EVALUADOR</param>
			</generator>
		</id>
				<property name="nombres" column="HIE_NOMBRES"/>
			    <property name="apellidos" column="HIE_APELLIDOS"/> 
			    <property name="email" column="HIE_EMAIL"/>            
				<property name="genero" column="HIE_GENERO"/>
				<property name="tipo" column="HIE_TIPO"/>
			    <property name="formacion" column="HIE_FORMACION"/>             
				<property name="areaCiencia" column="HIE_AREA_CIENCIA"/>
				<property name="subAreaCiencia" column="HIE_SUBAREA_CIENCIA"/>
				<property name="cvlac" column="HIE_CVLAC"/>
				<property name="minciencias" column="HIE_MINCIENCIAS"/>
				<property name="lineaInvestigacion" column="HIE_lIN_INV"/>
				<property name="institucionLabora" column="HIE_LABORA"/>
				<property name="fechaCambio" column="HIE_FECHA" type="timestamp" />
				<property name="observacion" column="HIE_OBSERVACION" />

	<many-to-one name="responsable" class="Persona" lazy="false">
			<column name="PER_ID" />
			<column name="TDO_ID" />
		</many-to-one>

	</class>
</hibernate-mapping>
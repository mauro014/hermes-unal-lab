<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="co.edu.unal.hermes.modelo">
	<class name="Coleccion" table="HER_COLECCION">
		<id name="id" column="COL_ID" type="long">
			<generator class="sequence">
				<param name="sequence">SEQ_COLECCION</param>
			</generator>
		</id>
		<many-to-one name="sede" class="Sede"
			column="SED_ID" lazy="false" />
		<many-to-one name="dependencia" class="Dependencia"
			column="DPN_ID" lazy="false" />
		<many-to-one name="ciudad" class="Ciudad"
			column="CIU_ID" lazy="false" />

		<property name="nombre" column="COL_NOMBRE" />
		<property name="nombreOtroTipo" column="COL_OTRO_TIPO" />
		<property name="acronimo" column="COL_ACRONIMO" />
		<property name="tipo" column="COL_TIPO" />
		<property name="fechaFundacion" column="COL_FECHA_FUNDACION" />
		<property name="sitioWeb" column="COL_ACTO_ADM" />
		<property name="descripcion" column="COL_DESCRIPCION" />
		<property name="direccion" column="COL_DIR_CORRESPONDENCIA" />
		<property name="telefono" column="COL_TELEFONO" />
		<property name="email" column="COL_EMAIL" />
		<property name="imagen" column="COL_IMAGEN" />
		<property name="infraestructura" column="COL_INFRAESTRUCTURA" />
		<property name="baseDatos" column="COL_BASE_DATOS" />
		<property name="coberturaTaxonomica" column="COL_COBERTURA_TAXONOMICA" />
		<property name="coberturaGeografica" column="COL_COBERTURA_GEOGRAFICA" />
		<property name="coberturaTemporal" column="COL_COBERTURA_TEMPORAL" />
		<property name="fechaActualizacion" column="COL_FECHA_ACTUALIZACION" />
		<property name="cantidadEjemplaresTipo" column="COL_EJEMPLARES_TIPO" />
		<property name="porcentajeEspeGeo" column="COL_EJEMPLARES_GEO" />
		<property name="sistematizacionPublicacion" column="COL_SISTEMATIZACION_PUB" />
		<property name="estado" column="COL_ESTADO" />
		<property name="historicoCuradores" column="COL_HISTORICO_CURADORES" />
		<property name="registroHumboldt" column="COL_REGISTRO_HUMBOLDT" />
		<property name="fechaUltimoRegistroHumboldt" column="COL_FEC_REGISTRO_HUMBOLDT" />
		<property name="controlAlertas" column="COL_CTRL_ALERTAS" />
		
		<property name="tipoActoCreacion" column="COL_TIPO_ACTO_CREACION" />
		<property name="numeroActo" column="COL_NUM_ACTO_CREACION" />
		<property name="fechaActoCreacion" column="COL_FECHA_ACTO_CREACION" />
		<property name="porcentajeEspeGeoNoBio" column="COL_EJEMPLARES_GEO_NO_BIO" />
		<property name="sistematizacionPublicacionNoBio" column="COL_SISTEMATIZACION_PUB_NO_BIO" />

		<property name="uab" column="COL_UAB" />
		<property name="observaciones" column="COL_OBSERVACIONES" />
		<property name="linkPortalColeccion" column="COL_LINK_PORTAL" />
		<property name="fechaCompromisoActualizacion" column="COL_PROXIMO_REG_RNC" />
		
		<set name="regiones" table="HER_COLECCION_TIPO_PRE" inverse="true" lazy="false">
			<key column="COL_ID" />
			<one-to-many class="ColeccionTipoPreservacion" />
		</set>
		
		<set name="tiposNomenclaturales" table="HER_COLECCION_NOMENCLATURA" inverse="true" lazy="false">
			<key column="COL_ID" />
			<one-to-many class="ColeccionNomenclatura" />
		</set>	
		
		<set name="catalogacionColeccion" table="HER_COLECCION_CATALOGACION" inverse="true" lazy="false">
			<key column="COL_ID" />
			<one-to-many class="ColeccionCatalogacion" />
		</set> 
		
		<set name="personalColeccion" table="HER_COLECCION_PERSONA" inverse="true" lazy="false">
			<key column="COL_ID" />
			<one-to-many class="ColeccionPersona" />
		</set> 
		
		<set name="autoridades" table="HER_COLECCION_AUTORIDAD" inverse="true" lazy="false">
			<key column="COL_ID" />
			<one-to-many class="ColeccionAutoridadCompetente" />
		</set>
		
		<set name="gestiones" table="HER_COLECCION_GESTION" inverse="true" lazy="false">
			<key column="COL_ID" />
			<one-to-many class="ColeccionGestion" />
		</set>
		
		<set name="clasificaciones" table="HER_COLECCION_CLASIFICACION" inverse="true" lazy="false">
			<key column="COL_ID" />
			<one-to-many class="ColeccionClasificacion" />
		</set>
		
		<set name="tipoObjetos" table="HER_COLECCION_TIPO_OBJETO" inverse="true" lazy="false">
			<key column="COL_ID" />
			<one-to-many class="ColeccionTipoObjeto" />
		</set>
		
		
		 
	</class>
</hibernate-mapping>

<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="co.edu.unal.hermes.modelo">
	<class name="ProyectoAreaGestionConocimiento" table="HER_PRY_AREA_GESTION_CONO">
		<id name="id" column="AGC_ID" type="long">
			<generator class="sequence">
				<param name="sequence">SEQ_PRY_AREA_GC</param>
			</generator>
		</id>
		<many-to-one name="proyecto" class="Proyecto"
			column="PRY_ID" not-null="true" lazy="false" />
		
		<many-to-one name="areaGestionConocimiento" class="DominioDetalle" lazy="false">
			<column name="DOM_ID" />
			<column name="DOMDET_TIPO" />
		</many-to-one>

	</class>
</hibernate-mapping>

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="co.edu.unal.hermes.modelo">
	<class name="PersonaAccesoHermes" table="HER_PERSONA_ACCESO_HERMES">
		<id name="id" column="HPAH_ID" type="long">
			<generator class="sequence">
				<param name="sequence">SEQ_PERSONA_ACCESO_HERMES</param>
			</generator>
		</id>
		<property name="ip" column="HPAH_IP" />
		<property name="documento" column="PER_ID" />
		<property name="tipoDocumento" column="TDO_ID" />
		<property name="fecha" column="HPAH_FECHA" />
		<property name="usoLdap" column="HPAH_USO_LDAP" />
	</class>
</hibernate-mapping>

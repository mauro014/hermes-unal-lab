<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="co.edu.unal.hermes.modelo">

	<class name="ProyectoCompromiso" table="HER_PROYECTO_COMPROMISO">

		<id name="id" column="COM_ID" type="long">
			<generator class="sequence">
				<param name="sequence">SEQ_PROYECTO_COMPROMISO</param>
			</generator>
		</id>

		<property name="cumplido" column="COM_CUMPLIDO" />

		<property name="fechaVencimiento" column="COM_FECHA_VENCIMIENTO"
			type="date" not-null="true" length="22" />

		<property name="tiempoAlerta" column="COM_TIEMPO_ALERTA"
			type="integer" not-null="false" length="22" />

		<many-to-one name="proyecto" class="Proyecto" column="PRY_ID"
			not-null="true" lazy="false" />

		<many-to-one name="tipoInforme" class="TipoInforme"
			column="TIN_ID" not-null="true" lazy="false" />

		<property name="fechaNotificacion" column="COM_FECHA_NOTIFICACION"
			type="date" not-null="false" length="22" />

		<property name="numeroNotificaciones" column="COM_NUMERO_NOTIFICACIONES"
			type="integer" length="22" />
			
		<property name="fechaVencProrroga" column="COM_FECHA_VENC_PRORROGA"
			type="date" not-null="false" length="22" />		
			
		<property name="fechaNotificacionAcumulada" column="COM_FECHA_NOTI_ACUMULADA"
			type="date" />				

		<property name="numeroNotificacionesAcumuladas" column="COM_NUMERO_NOTI_ACUMULADA"
			type="integer" length="22" />
			
		<many-to-one name="convenioObligacion" class="ConvenioObligacion"
			column="COB_ID" not-null="false" lazy="false"/>
			
		<property name="observaciones" column="COM_OBSERVACION_SEG_OBLIGA" type="string" />
		
		<property name="fechaSeguimiento" column="COM_FECHA_SEGUIMIENT_OBLIGA" type="date" />

	</class>
</hibernate-mapping>
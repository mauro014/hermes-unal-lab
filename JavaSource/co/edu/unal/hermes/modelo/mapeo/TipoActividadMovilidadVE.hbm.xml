<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 2.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="co.edu.unal.hermes.modelo">
	<class name="TipoActividadMovilidadVE" table="HER_TIPO_ACTIVIDAD_MOV_VE">
		<id name="id" column="TAMVE_ID" type="long">
			<generator class="assigned"/>
		</id>
		<property name="nombre" column="TAMVE_NOMBRE" type="string"/>
		<property name="vigencia" column="TAMVE_VIGENCIA" type="string"/>
	</class>
</hibernate-mapping>

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="co.edu.unal.hermes.modelo">
	<class name="SemilleroRevisionRequisito"
		table="HER_SEMILLERO_REV_REQUISITO">
		<id name="id" column="SREV_ID" type="integer">
			<generator class="sequence">
				<param name="sequence">SEQ_SEMILLERO_REV_REQUISITO</param>
			</generator>
		</id>
		<many-to-one name="solicitudSemillero" class="SemilleroSolicitud" not-null="true"
			lazy="false">
			<column name="SSO_ID" />
		</many-to-one>
		<many-to-one name="requisito" class="SemilleroRequisito"
			not-null="true" lazy="false">
			<column name="SRQ_ID" />
		</many-to-one>
		<property name="cumple" column="SREV_CUMPLE" />
	</class>
</hibernate-mapping>
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="co.edu.unal.hermes.modelo.seguimiento">
 	<class name="ObservacionProyecto" table="HER_OBSERVACION_PROYECTO">
  		<id name="id" column="OBPR_ID" type="long">
   			<generator class="sequence">
         		<param name="sequence">SEQ_OBSERVACION_PROYECTO</param>
	    	</generator>
	  	</id>
	  	
	  	<property name="fecha" column="OBPR_FECHA"/>
	  	<property name="descripcion" type="text" column="OBPR_DESCRIPCION"/>
	  	
	  	<many-to-one name="proyecto" class="co.edu.unal.hermes.modelo.Proyecto" column="PRY_ID" not-null="true" lazy="false"/>  
	  	<many-to-one name="asesor" class="co.edu.unal.hermes.modelo.Persona" not-null="true" lazy="false">
		  	<column name="PER_ID"/>
		    <column name="TDO_ID"/>
  		</many-to-one>
 	</class>
</hibernate-mapping>

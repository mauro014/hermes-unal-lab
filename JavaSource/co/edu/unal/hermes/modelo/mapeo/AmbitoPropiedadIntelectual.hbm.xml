<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="co.edu.unal.hermes.modelo">
	<class name="AmbitoPropiedadIntelectual" table="HER_PROPIEDAD_INT_AMBITO">
		<id name="id" column="PIA_ID" type="long">
			<generator class="sequence">
				<param name="sequence">SEQ_PROPIEDAD_INT_AMBITO</param>
			</generator>
		</id>
		<many-to-one name="propiedad" class="PropiedadIntelectual"
			column="PRI_ID" not-null="true" lazy="false" />
		
		<many-to-one name="ambito" class="DominioDetalle" lazy="false">
			<column name="DOM_ID" />
			<column name="DOMDET_TIPO" />
		</many-to-one>

		<property name="observaciones" column="PIA_OBSERVACIONES" />	
		 
	</class>
</hibernate-mapping>

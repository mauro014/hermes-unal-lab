<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="co.edu.unal.hermes.modelo">
	<class name="GrupoLaboratorio" table="HER_GRUPO_LABORATORIO">
		<composite-id>
			<key-many-to-one name="Grupo" class="Grupo"
				column="GRU_ID" lazy="false">
			</key-many-to-one>
			<key-many-to-one name="laboratorio" class="co.edu.unal.hermes.modelo.laboratorios.Laboratorio"
				lazy="false" column="LAB_ID">
			</key-many-to-one>
		</composite-id>
		<property name="fechaRegistro" column="GRL_FECHA_REGISTRO" />
		<property name="fechaBorrado" column="GRL_FECHA_BORRADO" />
		<many-to-one name="responsableRetiro" class="co.edu.unal.hermes.modelo.Persona"
			lazy="false">
			<column name="PER_ID" />
			<column name="TDO_ID" />
		</many-to-one>
	</class>
</hibernate-mapping>
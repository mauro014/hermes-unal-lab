<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="co.edu.unal.hermes.modelo.seguimiento">
	<class name="SolicitudProrrogaInvestigador" table="HER_SOLICITUD_PRORROGA_INV">
		<id name="id" column="SPI_ID" type="long">
			<generator class="sequence">
				<param name="sequence">SEQ_SOLICITUD_PRORROGA_INV</param>
			</generator>
		</id>
		<many-to-one name="investigador" class="co.edu.unal.hermes.modelo.Investigador"
			not-null="true" lazy="false">
			<column name="INV_ID" />
			<column name="TDO_ID" />
		</many-to-one>
  		<many-to-one name="tipo" column="SPI_TIPO" class="co.edu.unal.hermes.modelo.TipoInvestigador" lazy="false"/>

  		<many-to-one name="solicitud" class="Solicitud" column="SOL_ID" not-null="true" lazy="false"/>	
  		<property name="dedicacionHorasSemana" column="SPI_DEDICACION_HORAS_SEMANA"/>
  		<property name="estado" column="SPI_ESTADO"/>
  		<property name="numeroSemanasAdicional" column="SPI_NUMERO_SEMANAS"/>
		<property name="fechaProcesamiento" column="SPI_FECHA_PROCESAMIENTO" type="timestamp" />
		<property name="fechaBorrado" column="SPI_FECHA_BORRADO" type="timestamp" />
		<property name="valorPagar" column="SPI_VALOR_PAGAR"/>
		<property name="fechaProrroga" column="SPI_FECHA_PRORROGA" type="timestamp" />

	</class>
</hibernate-mapping>

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="co.edu.unal.hermes.modelo">
 <class name="CandidatoPosdoctorado" table="HER_CANDIDATO_POSDOCTORADO">
  
  <id name="id" column="CPO_ID" type="long" unsaved-value="-1">
   <generator class="sequence">
    <param name="sequence">SEQ_CANDIDATO_POSDOCTORADO</param>    					   
   </generator>
  </id>
  
  <property name="estancia" column="POD_ID"/>
  <property name="candidato" column="CPO_CANDIDATO"/>
  <property name="nacionalidad" column="CPO_NACIONALIDAD"/>
  <property name="ciudad" column="CPO_CIUDAD"/>
  <property name="titulo" column="CPO_TITULO"/>
  <property name="grado" column="CPO_ANO_GRADO"/>
  <property name="universidad" column="CPO_UNIVERSIDAD"/>
  <property name="institucion" column="CPO_INSTITUCION"/>
  <property name="perfil" column="CPO_PERFIL"/>
  <property name="pais" column="CPO_PAIS"/>
  <property name="paisDoctorado" column="CPO_PAIS_DOCTORADO"/>
    
 </class>
</hibernate-mapping>




<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="co.edu.unal.hermes.modelo">
 <class name="SolicitudInforme" table="HER_SOLICITUD_INFORME">
  <id name="id" column="SIN_ID" type="long">
   <generator class="sequence">
         <param name="sequence">SEQ_SOLICITUD_INFORME</param>
    </generator>
  </id>
   
  <property name="solicitudID" column="SOL_ID"  type="long"/>
  <property name="informeID" column ="PIN_ID"  type="long"/>
  

    
 </class>
</hibernate-mapping>

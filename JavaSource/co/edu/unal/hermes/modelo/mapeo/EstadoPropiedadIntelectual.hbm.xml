<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 2.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="co.edu.unal.hermes.modelo">
	<class name="EstadoPropiedadIntelectual" table="HER_PROPIEDAD_INT_ESTADO">
		<id name="id" column="PIE_ID" type="long">
		</id>
		
		<property name="nombre" column="PIE_NOMBRE" type="string"/>
		<property name="descripcion" column="PIE_DESCRIPCION" type="string"/>
		<many-to-one name="clasificacion" class="ClasificacionEstadoPropiedadIntelectual" column="PCE_ID" lazy="false"/>
		<many-to-one name="tipoPropiedad" class="TipoPropiedadIntelectual" column="PIT_ID"/>
		<property name="orden" column="PIE_ORDEN"/>
		
	</class>
</hibernate-mapping>
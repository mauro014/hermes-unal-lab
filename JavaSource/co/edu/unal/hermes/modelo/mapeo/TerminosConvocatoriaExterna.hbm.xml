<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 2.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="co.edu.unal.hermes.modelo">
	<class name="TerminosConvocatoriaExterna" table="HER_TERMINOS_CONVOCATORIA_EXT">

		<id name="id" column="TCE_ID" type="long">
			<generator class="sequence">
				<param name="sequence">SEQ_TERMINOS_CONVOCATORIA_EXT</param>
			</generator>
		</id>

		<property name="descripcion" column="TCE_DESCRIPCION" type="string" />
		<property name="vigenciaInicio" column="TCE_VIGENCIA_ABRE" type="date" />
		<property name="vigenciaTermina" column="TCE_VIGENCIA_CIERRA" type="date" />
		<property name="estado" column="TCE_ESTADO" type="string" />
		
		<many-to-one name="personaAbre" class="Persona">
			<column name="PER_ID_ABRE" />
			<column name="TDO_ID_ABRE" />
		</many-to-one>

		<many-to-one name="personaCierra" class="Persona">
			<column name="PER_ID_CIERRA" />
			<column name="TDO_ID_CIERRA" />
		</many-to-one>

	</class>
</hibernate-mapping>
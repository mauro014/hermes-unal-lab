<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="co.edu.unal.hermes.modelo">
	<class name="Sede" table="HER_SEDE">
		<id name="id" column="SED_ID" type="long">
			<generator class="native" />
		</id>
		<property name="nombre" column="SED_NOMBRE" />
		<property name="ciudad" column="SED_CIUDAD" />
	</class>
</hibernate-mapping>

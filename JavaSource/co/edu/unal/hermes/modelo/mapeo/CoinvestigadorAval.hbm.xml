<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 2.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="co.edu.unal.hermes.modelo">
	<class name="CoinvestigadorAval" table="HER_COINVESTIGADOR_AVAL">
		<id name="id" column="COA_ID" type="long">
			<generator class="sequence">
    			<param name="sequence">SEQ_COINVESTIGADOR_AVAL</param>
   			</generator>
		</id>
		
		<property name="idPersona" column="PER_ID" type="string"/>
		<property name="idDocumento" column="TDO_ID" type="string"/>
		<property name="horas" column="COA_HORAS"/>
		<!--property name="idAval" column="AVI_ID" type="long"/-->
		<property name="nombreCandidato" column="COA_NOMBRE" type="string"/>
		<property name="fechaNacimiento" column="COA_FECHA_NAC" type="date"/>
		<property name="tipoVinculacion" column="COA_TIPO_VINCULACION" type="string"/>
		<property name="dependenciaDoc" column="COA_DEPENDENCIA_DOC" type="string"/>
		<property name="facultadDoc" column="COA_FACULTAD_DOC" type="string"/>
		<property name="lugarExpDoc" column="LUGAR_EXP_DOC" type="string"/>
		
		<property name="semanasFormulacion" column="COA_SEMANAF"/>
		<property name="horasSemanaFormulacion" column="COA_HORAF"/>
		<property name="rol" column="COA_ROL"/>
		<property name="valorPagar" column="COA_VALOR_A_PAGAR"/>		
		
		 <many-to-one name="aval" class="Aval" column="AVI_ID" not-null="true"/>
		 
		<!-- many-to-one name="aval" class="Aval" column="AVI_ID" /-->
		
	</class>
</hibernate-mapping>
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="co.edu.unal.hermes.modelo">

	<class name="ProyectoRequisito" table="HER_PROYECTO_REQUISITO">

		<id name="id" column="REQ_ID" type="long">
			<generator class="sequence">
				<param name="sequence">SEQ_PROYECTO_REQUISITO</param>
			</generator>
		</id>

		<property name="cumplido" column="REQ_CUMPLIDO" />

		<many-to-one name="proyecto" class="Proyecto" column="PRY_ID"
			not-null="true" lazy="false" />
		<many-to-one name="requisito" class="TipoRequisito"
			column="TPR_ID" not-null="true" lazy="false" />

		<property name="comentario" column="REQ_COMENTARIO" />
		<property name="responsableId" column="REQ_RESPONSABLE_ID" />
		<property name="responsableTipoDocumento" column="REQ_RESPONSABLE_TDO_ID" />

	</class>
</hibernate-mapping>

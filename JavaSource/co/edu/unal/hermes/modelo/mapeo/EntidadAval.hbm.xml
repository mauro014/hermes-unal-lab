<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 2.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="co.edu.unal.hermes.modelo">
	<class name="EntidadArticulo" table="HER_ENTIDAD_AVAL">
		<id name="id" column="ENA_ID" type="long">
			<generator class="sequence">
    			<param name="sequence">SEQ_ENTIDAD_AVAL</param>
   			</generator>
		</id>
		
		<property name="nombre" column="ENA_NOMBRE" type="string"/>
		<property name="tipo" column="ENA_TIPO" type="string"/>
		<property name="fuente" column="ENA_FUENTE" type="string"/>
		<property name="especie" column="ENA_ESPECIE"/>
		<property name="frescos" column="ENA_FRESCOS"/>
		<property name="noPermitirEliminar" column="ENA_PER_ELIM"/>
		<property name="porcentaje" column="ENA_PORCENTAJE"/>
		<property name="descripcionRubro" column="ENA_DESCRIPCION_RUBRO"/>
		<!-- property name="idAval" column="AVI_ID" type="long"/-->

		<many-to-one name="aval" class="Aval" column="AVI_ID" not-null="true"/>
		<!-- many-to-one name="aval" class="Aval" column="AVI_ID" /-->
		<many-to-one name="tipoRubro" column="TRU_ID" class="TipoRubro" not-null="false" lazy="false"/>
		
		<many-to-one name="entidad" column="FFI_ID" class="FuenteFinanciacion" lazy="false"/>
		
	</class>
</hibernate-mapping>
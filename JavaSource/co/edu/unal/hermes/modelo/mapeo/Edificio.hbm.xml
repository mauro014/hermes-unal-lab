<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="co.edu.unal.hermes.modelo">
	<class name="Edificio" table="HER_EDIFICIO">

		<id name="id" column="EDF_ID" />

		<property name="nombre" column="EDF_NOMBBRE" />

		<many-to-one name="sede" class="Sede" column="SED_ID"
			not-null="true" />

		<property name="codigo" column="EDF_CODIGO" />

	</class>
</hibernate-mapping>

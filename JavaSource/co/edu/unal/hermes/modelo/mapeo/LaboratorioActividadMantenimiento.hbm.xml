<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="co.edu.unal.hermes.modelo.laboratorios">

	<class name="LaboratorioActividadMantenimiento" table="HER_LABORATORIO_ACT_MANTTO">

		<id name="id" column="HLAM_ID" type="long">
			<generator class="sequence">
				<param name="sequence">SEQ_DETALLE</param>
			</generator>
		</id>

		<many-to-one name="equipo"
			class="co.edu.unal.hermes.modelo.laboratorios.LaboratorioDetalleEquipos" column="LDE_ID"
			lazy="false" />

		<property name="nombreActividad" column="HLAM_NOMBRE_ACTIVIDAD" />

		<many-to-one name="frecuencia" class="co.edu.unal.hermes.modelo.Tipos"
			column="HLAM_FRECUENCIA_ID" lazy="false" />

		<property name="responsable" column="HLAM_RESPONSABLE" />

	</class>

</hibernate-mapping>
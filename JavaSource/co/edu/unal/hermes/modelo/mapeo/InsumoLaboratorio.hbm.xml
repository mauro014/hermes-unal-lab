<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="co.edu.unal.hermes.modelo.laboratorios">
	<class name="InsumoLaboratorio" table="HER_INSUMO_LABORATORIO">
		<id name="id" column="HIL_ID" type="long">
			<generator class="sequence">
				<param name="sequence">SEQ_DETALLE</param>
			</generator>
		</id>
		<property name="cas" column="HIL_CAS" />
		<property name="nombre" column="HIL_NOMBRE" />
		<many-to-one name="unidadDeMedida" class="co.edu.unal.hermes.modelo.Tipos"
			lazy="false">
			<column name="HIL_UNIDAD_DE_MEDIDA" />
		</many-to-one>
		<property name="controlado" column="HIL_CONTROLADO" />
		<property name="activo" column="HIL_ACTIVO" />
		
		<set name="archivos" table="HER_ARCHIVO_LABORATORIO" inverse="true"
			cascade="all-delete-orphan" lazy="false">
			<key column="HAL_HIL_ID" />
			<one-to-many class="ArchivoLaboratorio" />
		</set>
		
	</class>
</hibernate-mapping>
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
                                   
<hibernate-mapping package="co.edu.unal.hermes.modelo">

 <class name="CriterioEvaluacion" table="HER_CRITERIO_EVALUACION">
  
  <id column="CRI_ID" name="id" type="long">
   <generator class="sequence">
   	<param name="sequence">SEQ_CRITERIO_EVALUACION</param>
   </generator>
  </id>
  
  <property name="nombre" column="CRI_NOMBRE"/> 
  <property name="factor" type="float" column="CRI_FACTOR_PESO"/> 
  <property name="descripcion" type="text" column="CRI_DESCRIPCION"/>
  <property name="activo" type="text" column="CRI_ACTIVO"/>
  
  <many-to-one name="tipoInvestigacion" class="TipoInvestigacion" column="TIN_ID" not-null="false"/>    
 </class> 
</hibernate-mapping>

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="co.edu.unal.hermes.modelo.laboratorios">
 <class name="LaboratorioMetroMedidaFisica" table="HER_LAB_MEDIDAS_FISICAS">
  
  <id name="id" column="LMF_ID" type="long">
   <generator class="sequence">
    <param name="sequence">SEQ_LAB_MED_FISICAS</param>
   </generator>
  </id>
  
  <many-to-one name="laboratorio" class="co.edu.unal.hermes.modelo.laboratorios.Laboratorio" column="LAB_ID" not-null="true" lazy="false"/>  
  
  <property name="descripcionMensurando" column="LMF_DESCIP_MENSURANDO" />
  <property name="intervaloPuntoMedMinimo" column="LMF_INTERV_MIN" />
  <property name="intervaloPuntoMedMaximo" column="LMF_INTERV_MAX" />
  <property name="unidadesIntervaloSimbolo" column="LMF_UNID_INTERV_SIMBOLO" />
  <property name="incertidumbreMedicionValor" column="LMF_INCERT_MED_VALOR" />
  <property name="incertidumbreMedicionSimbolo" column="LMF_INCERT_MED_SIMBOLO" />
  <property name="factorCoberturaK" column="LMF_FACTOR_COBERTURA" />
  <property name="normaDocumentosMetodosReferencia" column="LMF_NORMA_DOC_MET_REF" />
  <property name="acreditado" column="LMF_ACREDITADO" />
  <property name="entidadAcreditadoraTipoDoc" column="LMF_ENT_ACRED_TIPO_DOC" />
  <property name="entidadAcreditadoraNumDoc" column="LMF_ENT_ACRED_NUM_DOC" />
  <property name="entidadAcreditadoraNombre" column="LMF_ENT_ACRED_NOMBRE" />
  
  <many-to-one name="magnitudFisica" class="co.edu.unal.hermes.modelo.Tipos" column="LMF_MAGNITUD_FISICA" not-null="true" lazy="false"/>
  <many-to-one name="campoAplicacion" class="co.edu.unal.hermes.modelo.Tipos" column="LMF_CAMPO_APLICACION" not-null="true" lazy="false"/>
  <many-to-one name="unidadesIntervaloPrefijo" class="co.edu.unal.hermes.modelo.Tipos" column="LMF_UNID_INTERV_PREFIJO" not-null="true" lazy="false"/>
  <many-to-one name="unidadesIntervaloUnidad" class="co.edu.unal.hermes.modelo.Tipos" column="LMF_UNID_INTERV_UNIDAD" not-null="true" lazy="false"/>
  <many-to-one name="incertidumbreMedicionIncertidumbre" class="co.edu.unal.hermes.modelo.Tipos" column="LMF_INCERT_MED_INCERT" not-null="true" lazy="false"/>
  <many-to-one name="incertidumbreMedicionPrefijo" class="co.edu.unal.hermes.modelo.Tipos" column="LMF_INCERT_MED_PREFIJO" not-null="true" lazy="false"/>
  <many-to-one name="incertidumbreMedicionUnidad" class="co.edu.unal.hermes.modelo.Tipos" column="LMF_INCERT_MED_UNIDAD" not-null="true" lazy="false"/>
  
  <property name="fechaRegistro" column="LMF_FECHA_REGISTRO" />

 </class>
</hibernate-mapping>

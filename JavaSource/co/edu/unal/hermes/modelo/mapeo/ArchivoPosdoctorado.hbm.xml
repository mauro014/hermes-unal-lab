<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 2.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="co.edu.unal.hermes.modelo">
	<class name="ArchivoPosdoctorado" table="HER_ARCHIVO_POSDOCTORADO">
		<id name="id" column="RPO_ID" type="long">
			<generator class="sequence">
    			<param name="sequence">SEQ_ARCHIVO_POSDOCTORADO</param>
   			</generator>
		</id>

		<property name="nombre" column="RPO_NOMBRE" type="string"/>
		<property name="archivo" column="RPO_ARCHIVO" type="blob"/>
		<property name="fecha" column="RPO_FECHA" type="date"/>
		<property name="estancia" column="POD_ID" type="string"/>
		<property name="tipo" column="RPO_TIPO" type="string"/>
		<property name="numInforme" column="RPO_NUM_INFORME" type="string"/>

		
		<many-to-one name="tipoArchivo" class="TipoArchivoEstancia" not-null="false" lazy="false">
		  	<column name="TAE_ID"/>
        </many-to-one>
		
		
	</class>
</hibernate-mapping>
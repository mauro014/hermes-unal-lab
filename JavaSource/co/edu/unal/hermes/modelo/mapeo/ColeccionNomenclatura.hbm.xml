<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="co.edu.unal.hermes.modelo">
	<class name="ColeccionNomenclatura" table="HER_COLECCION_NOMENCLATURA">
		<id name="id" column="CON_ID" type="long">
			<generator class="sequence">
				<param name="sequence">SEQ_COLECCION_NOMENCLATURA</param>
			</generator>
		</id>
		<many-to-one name="coleccion" class="Coleccion"
			column="COL_ID" not-null="true" lazy="false" />
			
		<many-to-one name="nomenclatura" class="DominioDetalle" lazy="false">
			<column name="DOM_ID" />
			<column name="DOMDET_TIPO" />
		</many-to-one>
		
		<many-to-one name="grupoBiologico" class="DominioDetalle" lazy="false">
			<column name="DOM_ID2" />
			<column name="DOMDET_TIPO2" />
		</many-to-one>

		<property name="cantidad" column="CON_CANTIDAD" />
		
		
			
		 
	</class>
</hibernate-mapping>

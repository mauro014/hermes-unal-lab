<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="co.edu.unal.hermes.modelo">
 <class name="CorreoTipoPersonaBoletin" table="HER_TIPO_CORREO_BOLETIN">
  <id name="id" column="TPB_ID" type="long">
		<generator class="assigned"/>
  </id>
   
  <property name="nombre" column="TPB_NOMBRE"/>
 <property name="enviado" column="TPB_ENVIADO"/>
 
<property name="fecha" column="TPB_FECHA" type = "date"/>
    
 </class>
</hibernate-mapping>

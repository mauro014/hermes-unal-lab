<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="co.edu.unal.hermes.modelo">

 <class name="MovilidadRequisito" table="HER_MOVILIDAD_REQUISITO">
 
  <id name="id" column="REQ_ID" type="long">
   <generator class="sequence">
    <param name="sequence">SEQ_MOVILIDAD_REQUISITO</param>
   </generator>
  </id>
  
  <property name="cumplido" column="REQ_CUMPLIDO"/>
  <property name="idMovilidad" column="MOV_ID"/>
  <many-to-one name="requisito" class="TipoRequisito" column="TPR_ID" not-null="true" lazy="false"/>
  
  <property name="comentario" column="REQ_COMENTARIO"/>
  <property name="responsable_id" column="REQ_RESPONSABLE_ID"/>
  <property name="responsable_tdo_id" column="REQ_RESPONSABLE_TDO_ID"/>
   
 </class>
</hibernate-mapping>

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
                                   
<hibernate-mapping package="co.edu.unal.hermes.modelo">

 <class name="Gasto" table="HER_GASTO">
   
  <id column="GST_ID" name="id" type="long">
  	<generator class="sequence">
         <param name="sequence">SEQ_GASTO</param>
    </generator>
  </id>

  <property column="GST_VIGENCIA" name="vigencia" not-null="true"/>
  <property column="GST_CANTIDAD" name="cantidad" not-null="true"/>
  <property column="GST_VALOR" name="valor" not-null="true"/>
  <property column="GST_VALOR2" name="valor2" />
  <property column="GST_VALOR3" name="valor3" />
  <property column="GST_VALOR4" name="valor4" />
  <property column="GST_VALOR5" name="valor5" />
  <property column="GST_VALOR6" name="valor6" />
  <property column="GST_DESCRIPCION" name="descripcion"/>
  <property column="GST_FECHA_DESEMBOLSO" name="fechaDesembolso"/>
  <property column="GST_FECHA_REAL_DESEMBOLSO" name="fechaRealDesembolso"/>
  <property column="GST_ANIO_VIGENCIA" name="anioVigencia"/>
  
  <many-to-one name="dependenciaIngreso" column="DPN_ID" class="Dependencia" not-null="false" lazy="false"/>
  <many-to-one name="tipoRubro" column="TRU_ID" class="TipoRubro" not-null="true" lazy="false"/>
  <many-to-one name="financiacion" column="FIN_ID" class="Financiacion" not-null="true" lazy="false"/>
  
 </class> 
</hibernate-mapping>
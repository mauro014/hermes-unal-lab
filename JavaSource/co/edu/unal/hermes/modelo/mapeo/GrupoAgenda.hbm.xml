<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="co.edu.unal.hermes.modelo">
	<class name="GrupoAgenda" table="HER_GRUPO_AGENDA">
		<id name="id" column="GAG_ID" type="long">
			<generator class="sequence">
				<param name="sequence">SEQ_GRUPO_AGENDA</param>
			</generator>
		</id>
		
		<many-to-one name="grupo" class="Grupo" column="GRU_ID"
			not-null="true" lazy="false"/>
		
		<many-to-one name="agenda" class="PosibleAgendaGrupo" column="AGG_ID"
			not-null="true" lazy="false"/>
	</class>
</hibernate-mapping>

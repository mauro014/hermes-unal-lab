<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="co.edu.unal.hermes.modelo">
 <class name="ActividadPosdoctorado" table="HER_ACTIVIDAD_POSDOCTORADO">
  
  <id name="id" column="APO_ID" type="long" unsaved-value="-1">
   <generator class="sequence">
    <param name="sequence">SEQ_ACTIVIDAD_POSDOCTORADO</param>    					   
   </generator>
  </id>
  
   <property name="nombre" column="APO_NOMBRE"/>
  
  <property name="descripcion" column="APO_DESCRIPCION"/>
  <property name="pertinencia" column="APO_PERTINENCIA"/>
  <property name="impacto" column="APO_IMPACTO"/>
  <property name="estancia" column="POD_ID"/>
  <property name="tipo" column="APO_TIPO"/>
  <property name="fechaRealizacion" column="APO_FECHA_REALIZACION"/>
  <property name="porcentajeAvance" column="APO_PORCENTAJE_AVANCE"/>
  <property name="numInforme" column="APO_NUM_INFORME"/>

 </class>
</hibernate-mapping>




<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="co.edu.unal.hermes.modelo">

	<class name="HistoricoEstadoInforme" table="HER_HISTORICO_ESTADO_INFORME">

		<id column="HEI_ID" name="id" type="long">
			<generator class="sequence">
				<param name="sequence">SEQ_HISTORICO_ESTADO_INFORME</param>
			</generator>
		</id>

		<many-to-one name="estadoInforme" column="EIN_ID" class="EstadoInforme"
			not-null="true" lazy="false" />
		<many-to-one name="proyectoInforme" column="PIN_ID" class="ProyectoInforme"
			not-null="true" />

		<property name="fecha" column="HEI_FECHA" type="timestamp" />
		<property name="comentarios" column="HEI_COMENTARIOS" />
		<many-to-one name="responsable" class="co.edu.unal.hermes.modelo.Persona"
			lazy="false">
			<column name="HEI_RESPONSABLE" />
			<column name="HEI_TDO_ID" />
		</many-to-one>

	</class>
</hibernate-mapping>
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="co.edu.unal.hermes.modelo">

	<class name="ProyectoCarta" table="HER_PROYECTO_CARTA">

		<id name="id" column="PCA_ID" type="long">
			<generator class="sequence">
				<param name="sequence">SEQ_PROYECTO_CARTA</param>
			</generator>
		</id>

		<many-to-one name="proyecto" class="Proyecto" column="PRY_ID"
			not-null="true" lazy="false" />
		<many-to-one name="carta" class="TipoCarta" column="TPC_ID"
			not-null="true" lazy="false" />
		<many-to-one name="estadoCarta" class="EstadoCarta"
			column="ETC_ID" not-null="true" lazy="false" />
			
		<many-to-one name="tipoActoAdministrativo" class="DominioDetalle"
			lazy="false">
			<column name="DOM_ID_TIPO_ACTO" />
			<column name="DOMDET_TIPO_ACTO" />
		</many-to-one>

		<property name="numeroActoAdministrativo" column="PCA_NUMERO"/>
		
		<many-to-one name="dependencia" class="Dependencia"
			column="DPN_ID" lazy="false" />
		
		<property name="fechaGeneracion" column="PCA_FECHA" type="timestamp" />
		<property name="fechaEliminacion" column="PCA_FECHA_ELIMINACION"
			type="date" />
		<property name="idAval" column="ID_AVAL" type="long" />

		<property name="idSolicitud" column="SOL_ID" type="long" />
		<property name="año" column="PCA_AÑO" type="string" />
		<property name="seq" column="PCA_SEQ" type="string" />

		<property name="sede" column="PCA_SEDE" type="string" />

		<property name="numActaInicioExt" column="PCA_NUM_ACTA_EXTERNA"
			type="long" />

		<many-to-one name="responsable" class="co.edu.unal.hermes.modelo.Persona"
			lazy="false">
			<column name="PER_ID" />
			<column name="TDO_ID" />
		</many-to-one>

		<many-to-one name="responsableEliminacion" class="co.edu.unal.hermes.modelo.Persona"
			lazy="false">
			<column name="PER_ID_ELIMINACION" />
			<column name="TDO_ID_ELIMINACION" />
		</many-to-one>

		<property name="subtipo" column="PCA_SUBTIPO" type="long" />

		<property name="fechaResolucion" column="PCA_FECHA_RESOLUCION" />

		<property name="tipoOrdenador" column="PCA_TIPO_ORDENADOR" />
		
		<property name="nuevoConsiderando" column="PCA_CONSIDERANDO" />
		
		<property name="numNotificaciones" column="PCA_NUMERO_NOTIFICACIONES" />
		<property name="fechaUltimaNotificacion" column="PCA_FECHA_NOTIFICACION" />
		
	</class>
</hibernate-mapping>
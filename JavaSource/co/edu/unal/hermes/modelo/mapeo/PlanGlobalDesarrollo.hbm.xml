<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
                                                                     
<hibernate-mapping package="co.edu.unal.hermes.modelo">

 <class name="PlanGlobalDesarrollo" table="HER_PLAN_GLOBAL_DESARROLLO">
  
  <id column="PGD_ID" name="id" type="long">
   <generator class="assigned"/>
  </id>
      
  
  <many-to-one name="padre" class="PlanGlobalDesarrollo" column="PGD_ID_INCLUIDA_EN"/>     
  <property name="nombre" column="PGD_DESCRIPCION"/> 
  <property name="periodo" column="PGD_PERIODO"/> 
   <property name="nombreCampoFormulario" column="PGD_ETIQUETA_FORMULARIO"/> 
   
 </class> 
</hibernate-mapping>

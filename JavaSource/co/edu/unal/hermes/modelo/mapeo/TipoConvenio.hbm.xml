<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 2.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="co.edu.unal.hermes.modelo">
	<class name="TipoConvenio" table="HER_TIPO_CONVENIO">
		<id name="id" column="TCO_ID" type="long">
			<generator class="sequence">
    			<param name="sequence">SEQ_TIPO_CONVENIO</param>
   			</generator>
		</id>
		
		<property name="descripcion" column="TCO_DESCRIPCION" type="string"/>
		
	</class>
</hibernate-mapping>
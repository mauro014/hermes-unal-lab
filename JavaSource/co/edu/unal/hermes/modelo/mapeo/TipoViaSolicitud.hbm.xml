<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="co.edu.unal.hermes.modelo.seguimiento">
 	<class name="TipoViaSolicitud" table="HER_TIPO_VIA_SOLICITUD">
  		<id name="id" column="TVSO_ID" type="long">
   			<generator class="sequence">
         		<param name="sequence">SEQ_TIPO_VIA_SOLICITUD</param>
	    	</generator>
	  	</id>
	  	<property name="nombre" column="TVSO_NOMBRE" type="string"/>
	  	<property name="descripcion" column="TVSO_DESCRIPCION" type="string"/>
	  	<property name="vigencia" column="TVSO_VIGENCIA" type="string"/>
	  	<property name="desdeVigencia" column="TVSO_DESDE_VIGENCIA" type="date"/>
	  	<property name="hastaVigencia" column="TVSO_HASTA_VIGENCIA" type="date"/>  
 	</class>
</hibernate-mapping>

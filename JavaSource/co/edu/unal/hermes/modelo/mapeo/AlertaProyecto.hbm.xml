<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="co.edu.unal.hermes.modelo.seguimiento">
	<class name="AlertaProyecto" table="HER_ALERTA_PROYECTO">
		<id name="id" column="ALPR_ID" type="long">
			<generator class="sequence">
				<param name="sequence">SEQ_ALERTA_PROYECTO</param>
			</generator>
		</id>
		<property name="estado" column="ALPR_ESTADO" />
		<property name="fechaGenera" column="ALPR_FECHA_GENERA" />
		<property name="mensaje" column="ALPR_MENSAJE" />
		<property name="fechaCierre" column="ALPR_FECHA_CIERRE" />
		<property name="productosMora" column="ALPR_PRODUCTOS_MORA" />
		<property name="numeroNotificaciones" column="ALPR_NUMERO_NOTIFICACION" />
		<property name="fechaNotificacion" column="ALPR_FECHA_NOTIFICACION" />
		<many-to-one name="asesor" class="co.edu.unal.hermes.modelo.Persona"
			not-null="true" lazy="false">
			<column name="PER_ID" />
			<column name="TDO_ID" />
		</many-to-one>
		<many-to-one name="proyecto" class="co.edu.unal.hermes.modelo.Proyecto"
			column="PRY_ID" not-null="true" lazy="false" />
		<many-to-one name="tipoAlerta" class="TipoAlerta" column="TAL_ID"
			not-null="false" lazy="false" />
		<many-to-one name="solicitud" class="Solicitud" column="SOL_ID"
			not-null="false" lazy="false" />
		<many-to-one name="proyectoProducto"
			class="co.edu.unal.hermes.modelo.ProyectoProducto" column="PRP_ID"
			not-null="false" lazy="false" />
	</class>
</hibernate-mapping>

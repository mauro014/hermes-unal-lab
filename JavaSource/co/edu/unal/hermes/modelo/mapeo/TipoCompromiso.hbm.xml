<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="co.edu.unal.hermes.modelo">
 <class name="TipoCompromiso" table="HER_TIPO_COMPROMISO">
  <id name="id" column="TPC_ID" type="long">
   <generator class="sequence">
   	<param name="sequence">SEQ_TIPO_COMPROMISO</param>
   </generator>
  </id>
  <many-to-one name="padre" class="TipoCompromiso" column="TPC_ID_PADRE"  />
  <property name="nombre" column="TPC_NOMBRE"/>
  <property name="descripcion" column="TPC_DESCRIPCION"></property>
 </class>
</hibernate-mapping>

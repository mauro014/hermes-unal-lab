<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="co.edu.unal.hermes.modelo">
 <class name="Dependencia" table="HER_DEPENDENCIA">
  <id name="id" column="DPN_ID" type="string">
   <generator class="assigned"/>
  </id>
  <many-to-one name="sede" class="Sede" column="SED_ID" not-null="true" lazy="false"/>
  <many-to-one name="padre" class="Dependencia" column="DPN_ID_2" lazy="false" />
  <many-to-one name="facultad" class="Dependencia" column="DPN_FACULTAD" lazy="false"/>

  <set name="grupos" table="HER_GRUPO_DEPENDENCIA">
   <key column="DPN_ID"/>
   <many-to-many class="Grupo" column="GRU_ID"/>
  </set>
    
  <property name="nombre" column="DPN_NOMBRE"/>
  <property name="estado" column="DPN_ESTADO"/>
  <property name="telefono" column="DPN_TELEFONO"/>
  <property name="extension" column="DPN_EXTENSION"/>
  <property name="abreviatura" column="DPN_ABREVIATURA"/>
  <property name="email" column="DPN_EMAIL"/>  
   <property name="codigoDivisionInvestigacion" column="DPN_CODIGO_DI"/>
  <property name="esFacultad" column="DPN_ES_FACULTAD" type="yes_no"/>
  <property name="esDepartamento" column="DPN_ES_DEPARTAMENTO" type="yes_no"/>  
  <property name="esSede" column="DPN_ES_SEDE" type="yes_no"/> 
  <property name="departamento" column="DPN_DEPARTAMENTO"/>
  <property name="paginaWeb" column="DPN_PAGINA_WEB"/>
  <property name="esInstitutoInterfacultad" column="DPN_ES_INSTITUTO_INTERFAC" type="yes_no"/> 
  
  <set name="avales" table="HER_DEPENDENCIA_AVAL">
   <key column="DPN_ID"/>
   <many-to-many class="Aval" column="AVI_ID"/>
  </set>
  
 </class>
</hibernate-mapping>

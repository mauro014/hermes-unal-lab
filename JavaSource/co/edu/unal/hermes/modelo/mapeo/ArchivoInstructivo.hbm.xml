<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 2.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="co.edu.unal.hermes.modelo">
	<class name="ArchivoInstructivo" table="HER_ARCHIVO_INSTRUCTIVO">

		<id name="id" column="ARI_ID" type="long">
			<generator class="sequence">
				<param name="sequence">SEQ_ARCHIVO_INSTRUCTIVO</param>
			</generator>
		</id>

		<property name="nombre" column="ARI_NOMBRE" type="string" />
		<property name="fechaCarga" column="ARI_FECHA_CARGADO" type="date" />
		<property name="fechaElimina" column="ARI_FECHA_ELIMINADO" type="date" />
		<property name="estado" column="ARI_ESTADO" type="string" />
		
		<many-to-one name="instructivo" class="Instructivo">
			<column name="INS_ID" />
		</many-to-one>
		
		<many-to-one name="personaCarga" class="Persona">
			<column name="PER_ID_CARGA" />
			<column name="TDO_ID_CARGA" />
		</many-to-one>

		<many-to-one name="personaElimina" class="Persona">
			<column name="PER_ID_ELIMINA" />
			<column name="TDO_ID_ELIMINA" />
		</many-to-one>

	</class>
</hibernate-mapping>
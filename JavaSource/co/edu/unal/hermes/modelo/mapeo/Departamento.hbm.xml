<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="co.edu.unal.hermes.modelo">
	<class name="Departamento" table="HER_DEPARTAMENTO">
		<id name="id" column="DEP_ID" type="string">
			<generator class="assigned" />
		</id>
		<many-to-one name="region" class="Region" column="REG_ID"
			not-null="true" lazy="false" />
		<many-to-one name="capital" class="Ciudad" column="CIU_ID"
			not-null="true" lazy="false" />
		<property name="nombre" column="DEP_NOMBRE" />
		<property name="sigla" column="DEP_SIGLA" />
	</class>
</hibernate-mapping>

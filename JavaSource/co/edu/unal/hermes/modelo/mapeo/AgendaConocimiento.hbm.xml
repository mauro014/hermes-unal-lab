<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="co.edu.unal.hermes.modelo">
	<class name="AgendaConocimiento" table="HER_AGENDA_CONOCIMIENTO">
		<id name="id" column="AGD_ID" type="string">
			<generator class="assigned" />
		</id>

		<many-to-one name="padre" class="AgendaConocimiento"
			column="AGD_INCLUIDA_EN" lazy="false" />

		<property name="nombre" column="AGD_NOMBRE" />
		<property name="estado" column="AGD_ESTADO" />

	</class>
</hibernate-mapping>

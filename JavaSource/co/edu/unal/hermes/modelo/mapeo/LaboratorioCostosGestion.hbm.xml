<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="co.edu.unal.hermes.modelo.laboratorios">
	<class name="LaboratorioCostosGestion" table="HER_LAB_COSTOS_GESTION">
		<id name="id" column="HLCG_ID" type="long">
			<generator class="sequence">
				<param name="sequence">SEQ_DETALLE</param>
			</generator>
		</id>
		<many-to-one name="costosServicio" class="LaboratorioCostosServicio"
			lazy="false" column="HLCS_ID" />
		<property name="nombreGestion" column="HLCG_NOMBRE_GESTION" />
		<property name="costoAnual" column="HLCG_COSTO_ANUAL" />
		<property name="tiempoUsoMinutos" column="HLCG_MINUTOS_USO" />
	</class>
</hibernate-mapping>
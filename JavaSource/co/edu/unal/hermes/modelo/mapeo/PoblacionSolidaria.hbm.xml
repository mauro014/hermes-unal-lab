<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 2.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="co.edu.unal.hermes.modelo">
	<class name="PoblacionSolidaria" table="HER_POBLACION_AVAL">
		<id name="id" column="PAV_ID" type="long">
			<generator class="sequence">
    			<param name="sequence">SEQ_POBLACION_AVAL</param>
   			</generator>
		</id>
		
		<property name="poblacion" column="PAV_POBLACION" type="string"/>
		<property name="poblaciontxt" column="PAV_POBLACIONTXT" type="string"/>
	

		 <many-to-one name="aval" class="Aval" column="AVI_ID" not-null="true"/>
		
		
	</class>
</hibernate-mapping>
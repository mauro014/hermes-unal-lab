<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="co.edu.unal.hermes.modelo">
	<class name="SemilleroActividad" table="HER_SEMILLERO_ACTIVIDAD">
<id name="id" column="SAC_ID" type="integer">
			<generator class="sequence">
				<param name="sequence">SEQ_SEMILLERO_ACTIVIDAD</param>
			</generator>
		</id>

			<many-to-one name="responsable"
				class="SemilleroIntegrante" column="SEI_ID" lazy="false">
			</many-to-one>
			<property name="descripcion"
				column="SAC_DESCRIPCION" />
		<property name="fechaInicio" column="SAC_FECHA_INICIO" />
		<property name="duracion" column="SAC_DURACION" />
		<property name="fechaRegistro" column="SAC_FECHA_REGISTRO" />
		
	</class>
</hibernate-mapping>
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="co.edu.unal.hermes.modelo">
	<class name="PosibleAgendaGrupo" table="HER_POSIBLE_AGENDA_GRUPO">
		<id name="id" column="AGG_ID">
			<generator class="assigned" />
		</id>
		<property name="nombre" column="AGG_NOMBRE" />
		<property name="estado" column="AGG_ESTADO" />
	</class>
</hibernate-mapping>

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="co.edu.unal.hermes.modelo">

	<class name="HistoricoEstadoMovilidad" table="HER_HISTORICO_ESTADO_MOVILIDAD">
		<id column="HEM_ID" name="id" type="long">
			<generator class="sequence">
				<param name="sequence">SEQ_HISTORICO_ESTADO_MOVILIDAD</param>
			</generator>
		</id>

		<property name="fecha" column="HEM_FECHA" type="timestamp" />

		<property name="aceptacion" column="MOV_ACEPT" />

		<property name="aprobacion" column="MOV_APROB" />

		<property name="idMovilidad" column="MOV_ID" />

		<property name="justificacion" column="HEM_JUSTIFICACION" />

		<many-to-one name="responsable" class="co.edu.unal.hermes.modelo.Persona"
			lazy="false">
			<column name="HEM_PER_ID" />
			<column name="HEM_TDO_ID" />
		</many-to-one>

	</class>
</hibernate-mapping>
<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="co.edu.unal.hermes.modelo">
	<class name="ProyectoPropiedadIntelectual" table="HER_PROPIEDAD_INT_PROYECTO">
		<id name="id" column="PIP_ID" type="long">
			<generator class="sequence">
				<param name="sequence">SEQ_PROPIEDAD_INT_PROYECTO</param>
			</generator>
		</id>
		<many-to-one name="propiedad" class="PropiedadIntelectual"
			column="PRI_ID" not-null="true" />
			
		<many-to-one name="proyecto" class="Proyecto" column="PRY_ID"/>
		
		<property name="nombreProyecto"
        formula="(select p.pry_nombre from her_proyecto p where p.pry_id = PRY_ID)"
        type="string" />

		<property name="tipoProyecto" column="PIP_TIPO" />	
		<property name="idProyectoExtension" column="PRY_ID_EXT" />	
		<property name="nombreProyectoExtension" column="PRY_NOMBRE_EXT" />	
		 
	</class>
</hibernate-mapping>

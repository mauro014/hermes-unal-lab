<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="co.edu.unal.hermes.modelo">
	<class name="CorreoDB" table="HER_CORREO">
		<id name="id" column="HCO_ID" type="integer">
			<generator class="sequence">
				<param name="sequence">SEQ_CORREO</param>
			</generator>
		</id>
		<property name="asunto" column="HCO_ASUNTO" />
		<property name="enviado" column="HCO_ENVIADO" />
		<property name="intentosEnvio" column="HCO_INTENTOS_ENVIO" />
		<property name="mensaje" column="HCO_MENSAJE" />
		<property name="ultimoError" column="HCO_ERROR" />
		<property name="fechaUltimoIntento"
			column="HCO_FECHA_ULTIMO_INTENTO" type="timestamp" />
		<property name="cco" column="HCO_CCO" />
		<property name="de" column="HCO_DE" />
		<property name="para" column="HCO_PARA" />
	</class>
</hibernate-mapping>

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="co.edu.unal.hermes.modelo">
 <class name="ProductosConvocatoriaTR" table="HER_CONVOCATORIA_TR_PRODUCTOS">
  <id name="id" column="CON_TR_PRD_ID" type="long">
   <generator class="sequence">
    <param name="sequence">SEQ_PRODUCTOS_CONV_TR</param>
   </generator>
  </id>
  
  <property name="otroProducto" column="CON_TR_PRD_OTRO"/>
  <property name="orden" column="CON_TR_PRD_ORDEN"/>
  <property name="cantidad" column="CON_TR_PRD_CANTIDAD"/> 
  <many-to-one name="convocatoriaTR" class="ConvocatoriaTerminosReferencia" column="CON_TR_ID" not-null="true" lazy="false"/> 
  <many-to-one name="producto" class="ProductoTipo" column="PRD_ID" not-null="true" lazy="false"/>  
  
 </class>
</hibernate-mapping>

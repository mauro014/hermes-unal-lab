<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 2.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="co.edu.unal.hermes.modelo">
	<class name="TrayectoriaColeccionProyecto" table="HER_COLECCION_TRAYECTORIA_PRY">
		<id name="id" column="TCOL_ID" type="long">
			<generator class="sequence">
    			<param name="sequence">SEQ_TRAYECTORIA_COLECCION_PRY</param>
   			</generator>
		</id>

		<many-to-one name="proyecto" class="Proyecto"  column="PRY_ID" not-null="true" lazy="false"/>

		<property name="trayectoria" column="TCOL_TRAYECTORIA" type="string"/>
		<property name="descripcion" column="TCOL_DESCRIPCION" type="string"/>
		
	</class>
</hibernate-mapping>
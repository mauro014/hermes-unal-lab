<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="co.edu.unal.hermes.modelo.seguimiento">
 	<class name="TipoAlerta" table="HER_TIPO_ALERTA">
  		<id name="id" column="TAL_ID" type="long">
   			<generator class="sequence">
         		<param name="sequence">SEQ_TIPO_ALERTA</param>
	    	</generator>
	  	</id>
	  	<property name="nombre" column="TAL_NOMBRE"/>
	  	<property name="descripcion" column="TAL_DESCRIPCION"/>
	  	<property name="sentencia" column="TAL_SENTENCIA"/>
	  	<property name="campoGenerador" column="TAL_CAMPO_GENERADOR"/>
	  	<property name="valorLimite" column="TAL_VALOR_LIMITE" type="long"/>
	  	<property name="tipoLimite" column="TAL_TIPO_LIMITE" type="long"/>
	  	<property name="vigencia" column="TAL_VIGENCIA"/>
	  	<property name="desdeVigencia" column="TAL_DESDE_VIGENCIA"/>
	  	<property name="hastaVigencia" column="TAL_HASTA_VIGENCIA"/>  
 	</class>
</hibernate-mapping>

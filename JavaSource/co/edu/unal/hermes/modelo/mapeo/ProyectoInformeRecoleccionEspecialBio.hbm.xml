<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="co.edu.unal.hermes.modelo">
	<class name="ProyectoInformeRecoleccionEspecialBio" table="HER_PROYECTO_INF_REC_ESP_BIO">
		<id name="id" column="PIR_ID" type="long">
			<generator class="sequence">
				<param name="sequence">SEQ_PROYECTO_INF_REC_ESP_BIO</param>
			</generator>
		</id>
		
		<many-to-one name="informe" class="ProyectoInforme" column="PIN_ID"
			not-null="true" />
		
		<property name="nombreCientifico" column="PIR_NOMBRE_CIENTIF" />
		<property name="fechaDesde" column="PIR_FECHA_DESDE" />
		<property name="fechaHasta" column="PIR_FECHA_HASTA" />
		<property name="categoria" column="PIR_CATEGORIA" />
		<property name="nroPermiso" column="PIR_PERMISO" />
		<property name="localidad" column="PIR_LOCALIDAD" />
		
	</class>
</hibernate-mapping>

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="co.edu.unal.hermes.modelo">
 <class name="ProyectoEquipoAdquisicion" table="HER_PROYECTO_ADQ_EQUIPO">
  <id name="id" column="PAE_ID" type="long">
   <generator class="sequence">
    <param name="sequence">SEQ_PROYECTO_ADQ_EQUIPO</param>
   </generator>
  </id>
  
  <many-to-one name="proyecto" class="Proyecto" column="PRY_ID" not-null="true" lazy="false"/>  
  
  <property name="nombreEquipo" column="PAE_NOMBRE_EQUIPO"/>
  <property name="ubicacion" column="PAE_UBICACION_EQUIPO"/>
  <property name="responsable" column="PAE_RESPONSABLE"/>
  <property name="servicio" column="PAE_SERVICIO_EQUIPO"/>
   <property name="justificacion" column="PAE_JUSTIFICACION"/>
  <property name="valor" column="PAE_VALOR"/>
  

 </class>
</hibernate-mapping>

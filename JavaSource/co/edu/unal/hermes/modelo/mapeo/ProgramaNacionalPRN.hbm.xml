<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="co.edu.unal.hermes.modelo">

 <class name="ProgramaNacionalPRN" table="HER_PROGRAMA_NACIONAL_PRN">
  
  <id name="id" column="PRY_ID" type="long">
   <generator class="assigned"/>
  </id>
  
  <property name="name" column="PRN_NAME" type="string"/>
  <property name="resumen" column="PRN_ABSTRACT" type="text"/>
  <property name="antecedentes" column="PRN_ANTECEDENTES" type="text"/>
  <property name="planteamiento" column="PRN_PLANTEAMIENTO" type="text"/>
  <property name="investigador" column="INV_ID" type="string"/>
  <property name="integracion" column="PRN_INTEGRACION" type="text"/>
  <property name="difusion" column="PRN_DIFUSION" type="text"/>
  <property name="internacionalizacion" column="PRN_INTERNACIONALIZACION" type="text"/>
  <property name="financiaCompleta" column="PRN_FINANCIA_COMPLETA" type="text"/>
  <property name="grupoPrincipal" column="GRU_ID"/>
  
  <!-- one-to-one name="proyecto" class="Proyecto" constrained="true"/-->
  <!-- one-to-one name="proyecto" class="Proyecto"/-->
  <!-- many-to-one name="proyecto" class="Proyecto" column="PRY_ID" not-null="true"/-->
  
 </class>
</hibernate-mapping>
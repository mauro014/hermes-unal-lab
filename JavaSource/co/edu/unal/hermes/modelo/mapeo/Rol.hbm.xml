<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="co.edu.unal.hermes.modelo">
 <class name="Rol" table="HER_ROL">
  <id name="id" column="ROL_ID" type="string">
   <generator class="assigned"/>
  </id>
  <property name="nombre" column="ROL_NOMBRE"/>
  <property name="comentario" column="ROL_COMENTARIO"/>
  <property name="visible" column="ROL_VISIBLE"/>
  
  <set name="servicios" table="HER_ROL_SERVICIO" lazy="false">
   <key column="ROL_ID"/>
   <many-to-many class="Servicio" column="SER_ID"/>
  </set>
 </class>
</hibernate-mapping>

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="co.edu.unal.hermes.modelo">

	<class name="HistoricoEstadoGestionColeccion" table="HER_HISTORICO_ESTADO_GEST">
  
		  <id column="HEG_ID" name="id" type="long">
		  	<generator class="sequence">
		         <param name="sequence">SEQ_HISTORICO_ESTADO_GEST</param>
		    </generator>
		  </id>  
		  
		   <many-to-one name="coleccionGestion" column="COG_ID" class="ColeccionGestion" not-null="true"/>
		  
		  <property name="fecha" column="HEG_FECHA" type="timestamp"/>
		  <property name="observacion" column="HEG_OBSERVACION"/>
		  <property name="estadoGestion" column="HEG_ESTADO"/>
		   
		  <many-to-one name="resposable" class="co.edu.unal.hermes.modelo.Persona" not-null="true" lazy="false">
			<column name="PER_ID"/>
			<column name="TDO_ID"/>
		  </many-to-one>
		
	</class> 
</hibernate-mapping>
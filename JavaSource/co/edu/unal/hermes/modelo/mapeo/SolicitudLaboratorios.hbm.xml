<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="co.edu.unal.hermes.modelo.laboratorios">

	<class name="SolicitudLaboratorios" table="HER_SOLICITUD_LABORATORIOS">

		<id name="id" column="HSL_ID" type="long">
			<generator class="sequence">
				<param name="sequence">SEQ_SOLICITUD</param>
			</generator>
		</id>

		<property name="fecha" column="HSL_FECHA" />

		<many-to-one name="persona" class="co.edu.unal.hermes.modelo.Persona"
			not-null="true" lazy="false">
			<column name="PER_ID" />
			<column name="TDO_ID" />
		</many-to-one>

		<many-to-one name="tipoSolicitud" column="TIPO_SOLICITUD"
			class="co.edu.unal.hermes.modelo.Tipos" lazy="false" />

		<many-to-one name="laboratorio" column="LAB_ID" class="Laboratorio"
			lazy="false" />

		<property name="justificacion" column="HSL_JUSTIFICACION" />

		<many-to-one name="estadoSolicitud" column="HSL_ESTADO"
			class="co.edu.unal.hermes.modelo.EstadoProyecto" lazy="false" />

		<many-to-one name="dirigidaA" column="DPN_ID_DIRIGIDA_A"
			class="co.edu.unal.hermes.modelo.Dependencia" lazy="false" />

		<property name="observaciones" column="HSL_OBSERVACIONES" />
		<property name="fechaRespuesta" column="HSL_FECHA_RESPUESTA" />

		<many-to-one name="laboratorioSolicitante" column="LAB_ID_2"
			class="Laboratorio" lazy="false" />

		<property name="cargoSolicitante" column="HSL_CARGO_SOLICITANTE" />

	</class>

</hibernate-mapping>

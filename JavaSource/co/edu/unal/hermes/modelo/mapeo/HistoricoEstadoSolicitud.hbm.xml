<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="co.edu.unal.hermes.modelo">

	<class name="HistoricoEstadoSolicitud" table="HER_HISTORICO_ESTADO_SOLICITUD">

		<id column="HES_ID" name="id" type="long">
			<generator class="sequence">
				<param name="sequence">SEQ_HISTORICO_ESTADO_SOLICITUD</param>
			</generator>
		</id>

		<many-to-one name="solicitud" column="SOL_ID" class="co.edu.unal.hermes.modelo.seguimiento.Solicitud"
			not-null="true" lazy="false" />

		<property name="respuesta" column="SOL_RESPUESTA" />

		<property name="fecha" column="HES_FECHA" type="timestamp" />
		<property name="comentarios" column="HES_COMENTARIOS" />
		<many-to-one name="responsable" class="co.edu.unal.hermes.modelo.Persona"
			lazy="false">
			<column name="HES_RESPONSABLE" />
			<column name="HES_TDO_ID" />
		</many-to-one>

	</class>
</hibernate-mapping>
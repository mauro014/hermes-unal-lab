<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="co.edu.unal.hermes.modelo">
	<class name="LaboratorioAval" table="her_aval_laboratorio">
		<composite-id>
			<key-many-to-one name="laboratorio"
				class="co.edu.unal.hermes.modelo.laboratorios.Laboratorio" column="LAB_ID" />
			<key-many-to-one name="aval" class="Aval"
				column="AVI_ID" />
		</composite-id>
	</class>
</hibernate-mapping>

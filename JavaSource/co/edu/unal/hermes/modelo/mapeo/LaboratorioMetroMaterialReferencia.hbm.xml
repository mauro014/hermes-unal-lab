<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="co.edu.unal.hermes.modelo.laboratorios">
 <class name="LaboratorioMetroMaterialReferencia" table="HER_LAB_MATERIALES_REFERENCIA">
  
  <id name="id" column="LMR_ID" type="long">
   <generator class="sequence">
    <param name="sequence">SEQ_LAB_MATERIALES_REFERENCIA</param>
   </generator>
  </id>
  
  <many-to-one name="laboratorio" class="co.edu.unal.hermes.modelo.laboratorios.Laboratorio" column="LAB_ID" not-null="true" lazy="false"/>
   
  <property name="nombreMaterialReferencia" column="LMR_NOMBRE" />
  <property name="productor" column="LMR_PRODUCTOR" />
  <property name="proveedor" column="LMR_PROVEEDOR" />
  <property name="materialDificilAdquisicion" column="LMR_DIFICIL_ADQUI" />
  <property name="usoAseguraTrazabilildadMedicion" column="LMR_USO_TRAZAB_MEDIC" />
  
  <many-to-one name="usaMaterialReferencia" class="co.edu.unal.hermes.modelo.Tipos" column="LMR_USA_MATERIAL" not-null="true" lazy="false"/>
  <many-to-one name="tipo" class="co.edu.unal.hermes.modelo.Tipos" column="LMR_TIPO" not-null="true" lazy="false"/>
  
  <property name="fechaRegistro" column="LMR_FECHA_REGISTRO" />

 </class>
</hibernate-mapping>

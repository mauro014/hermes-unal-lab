<hibernate-mapping package="co.edu.unal.hermes.modelo">
 <class name="Modalidad" table="HER_MODALIDAD">
  
  <id name="id" column="MOD_ID" type="long">
   <generator class="sequence">
    <param name="sequence">SEQ_MODALIDAD</param>
   </generator>

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="co.edu.unal.hermes.modelo">
	<class name="Archivo" table="HER_ARCHIVO">
		<id name="id" column="ARC_ID" type="long">
			<generator class="sequence">
				<param name="sequence">SEQ_ARCHIVO</param>
			</generator>
		</id>
		<property name="nombre" column="ARC_NOMBRE" />
		<property name="fecha" column="ARC_FECHA" />
		<property name="datos" type="blob" column="ARC_DATOS" />
		<many-to-one name="proyecto" class="Proyecto" column="PRY_ID"
			not-null="true" />
		<many-to-one name="tipoArchivo" class="TipoArchivo"
			column="TIA_ID" not-null="true" />
		<many-to-one name="responsable" class="co.edu.unal.hermes.modelo.Persona"
			lazy="false">
			<column name="ARC_RESPONSABLE" />
			<column name="ARC_TDO_ID" />
		</many-to-one>
	</class>
</hibernate-mapping>

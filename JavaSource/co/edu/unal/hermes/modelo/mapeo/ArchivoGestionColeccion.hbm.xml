<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 2.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="co.edu.unal.hermes.modelo">
	<class name="ArchivoGestionColeccion" table="HER_ARCHIVO_GESTION_COL">
		<id name="id" column="AGC_ID" type="long">
			<generator class="sequence"> 
    			<param name="sequence">SEQ_ARCHIVO_GESTION_COL</param>
   			</generator>
		</id>

		<many-to-one name="gestion" class="ColeccionGestion"  column="COG_ID" not-null="true" lazy="false"/>

		<property name="nombre" column="AGC_NOMBRE" type="string"/>
		<property name="fecha" column="AGC_FECHA" type="date"/>
		<property name="tipoUsuario" column="AGC_USUARIO" type="string"/>
		<property name="estado" column="AGC_ESTADO" type="string"/>
		
		<many-to-one name="responsable" class="Persona"
			not-null="true" lazy="false">
			<column name="PER_ID" />
			<column name="TDO_ID" />
		</many-to-one>
		
		<property name="fechaBorrado" column="AGC_FECHA_BORRADO" type="date"/>
		
	</class>
</hibernate-mapping>
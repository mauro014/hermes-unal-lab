<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

 
<hibernate-mapping package="co.edu.unal.hermes.modelo">
 <class name="SolicitudPersonaRol" table="HER_SOL_PERSONA_ROL">
 
 		<id name="id" column="SPR_ID" type="long">
			<generator class="sequence">
				<param name="sequence">SEQ_SOLICITUD_PERSONA_ROL</param>
			</generator>
		</id>
		
		<property name="idSolicitud" column="SLP_ID" />
		<!--  property name="rol" column="ROL_ID" /-->
		<property name="accion" column="SPR_ACCION" />
		<many-to-one name="rol" class="Rol"
			column="ROL_ID" lazy="false" />


  
 </class>
</hibernate-mapping>

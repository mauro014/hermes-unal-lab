<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="co.edu.unal.hermes.modelo">
	<class name="Empresa" table="HER_EMPRESA">
		<id name="id" column="EMP_ID" type="long">
			<generator class="sequence">
				<param name="sequence">SEQ_EMPRESA</param>
			</generator>
		</id>
		<property name="nit" column="EMP_NIT" />
		<property name="nombre" column="EMP_NOMBRE" />
		<property name="representanteLegal" column="EMP_REPRESENTANTE_LEGAL" />
		<property name="tipoEmpresa" column="EMP_TIPO_EMPRESA" />
		<property name="ubicacionCadenaProductiva" column="EMP_UBICACION_CADENA_PRODTIVA" />
		<property name="direccion" column="EMP_DIRECCION" />
		<property name="domicilio" column="EMP_DOMICILIO" />
		<property name="email" column="EMP_EMAIL" />
		<property name="paginaWeb" column="EMP_PAGINA_WEB" />
		<property name="telefono" column="EMP_TELEFONO" />
	</class>
</hibernate-mapping>

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="co.edu.unal.hermes.modelo.laboratorios">
 <class name="LaboratorioMetroProducto" table="HER_LAB_PRODUCTOS">
  
  <id name="id" column="LPR_ID" type="long">
   <generator class="sequence">
    <param name="sequence">SEQ_LAB_PRODUCTOS</param>
   </generator>
  </id>
  
  <many-to-one name="laboratorio" class="co.edu.unal.hermes.modelo.laboratorios.Laboratorio" column="LAB_ID" not-null="true" lazy="false"/>
   
  <property name="producto" column="LPR_PRODUCTO" />
  <property name="exportacion" column="LPR_EXPORTACION" />
  <property name="ciudad" column="LPR_CIUDAD" />
  
  <many-to-one name="subred" class="co.edu.unal.hermes.modelo.Tipos" column="LPR_SUBRED" lazy="false"/>
  <many-to-one name="pais" class="co.edu.unal.hermes.modelo.Pais" column="LPR_PAIS" lazy="false"/>
  
  <property name="fechaRegistro" column="LPR_FECHA_REGISTRO" />

 </class>
</hibernate-mapping>

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="co.edu.unal.hermes.modelo">
	<class name="ConvocatoriasExtension" table="HER_CONVOCATORIA_DNE">
		<id name="id" column="CON_DNE_ID" type="long">
			<generator class="sequence">
				<param name="sequence">SEQ_CONVOCATORIA_DNE</param>
			</generator>
		</id>
		<property name="nombre" column="CON_DNE_NOMBRE" type="string" />
		<property name="entidad" column="CON_DNE_ENTIDAD" type="string" />
		<property name="fechaCierre" column="CON_DNE_FECHA_CIERRE" type="date" />
		<property name="objeto" column="CON_DNE_OBJETO" type="string" />
		<property name="terminosReferencia" column="CON_DNE_TERMINOS" type="blob"/>
		<property name="nombreTerminosReferencia" column="CON_DNE_NOMBRE_TERMINOS" type="string" />
	    <many-to-one name="estadoConvocatoria" class="EstadoConvocatoria" column="CON_DNE_ESTADO" not-null="true" lazy="false" />
		<property name="fechaRegistro" column="CON_DNE_FECHA_REGISTRO" />
		
	</class>
</hibernate-mapping>
<hibernate-mapping package="co.edu.unal.hermes.modelo">
 <class name="MovilidadSeguimientoCooproducto" table="HER_MOVSEG_COOPRODUCTO">
    

  
  <id name="id" column="MOVCO_ID" type="long" unsaved-value="-1">
   <generator class="sequence">
    <param name="sequence">SEQ_MOVILIDAD_COOPRODUCTO</param>
   </generator> 
  </id>	
 
 
  <property name="idMovilidad" column="MOV_ID"/>
   <property name="tipo" column="DOMDET_TIPO"/>    
  <property name="detalle" column="DOMDET_DETALLE"/>
  


    
 </class>
</hibernate-mapping>

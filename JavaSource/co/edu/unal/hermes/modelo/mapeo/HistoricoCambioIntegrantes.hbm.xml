<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="co.edu.unal.hermes.modelo">

	<class name="HistoricoCambioIntegrantes" table="HER_HISTORICO_INTEGRANTES">
		<id column="HCI_ID" name="id" type="long">
			<generator class="sequence">
				<param name="sequence">SEQ_HISTORICO_INTEGRANTES</param>
			</generator>
		</id>
		<many-to-one name="grupo" class="Grupo" column="GRU_ID"
			lazy="false" />
		<property name="fechaIngreso" column="HCI_FECHA_INGRESO"
			type="timestamp" />
		<property name="fechaRetiro" column="HCI_FECHA_RETIRO" type="timestamp" />
		<many-to-one name="integrante" class="co.edu.unal.hermes.modelo.Persona"
			lazy="false">
			<column name="HCI_PER_ID" />
			<column name="HCI_TDO_ID" />
		</many-to-one>
		<property name="tipo" column="ING_TIPO" />
		<property name="tipoVinculacionGrupo" column="ING_TIPO_VINCULACION" />
		<many-to-one name="dependencia" class="Dependencia"
			column="DPN_ID" lazy="false" />
		<many-to-one name="sede" class="Sede" column="SED_ID"
			lazy="false" />
		<many-to-one name="tipoVinculacion" class="TipoVinculacion"
			column="TVI_ID" lazy="false" />
		<many-to-one name="tipoDedicacion" class="TipoDedicacion"
			column="TDE_ID" lazy="false" />
		<many-to-one name="tipoFormacion" class="TipoFormacion"
			column="TFO_ID" lazy="false" />
		<many-to-one name="planEstudios" class="PlanEstudios"
			column="PLE_ID" lazy="false" />
		<property name="semestreActual" column="EST_SEMESTRE_ACTUAL" />
		<property name="valorDedicacion" column="HCI_VALOR_DEDICACION"/>
		<many-to-one name="proyecto" class="Proyecto" column="PRY_ID"
			lazy="false" />
		<many-to-one name="tipoInvestigadorProyecto" class="TipoInvestigador"
			column="INP_TIPO" lazy="false" />
		<property name="mesesDedidacion" column="INP_TOTAL_HORAS_VINCULACION" />
		<property name="horasDedidacion" column="INP_DEDICACION_HORAS_SEMANA" />
		<many-to-one name="estadoCivil" class="EstadoCivil"
			column="ECI_ID" lazy="false" />
		<many-to-one name="semillero" class="Semillero"
			column="SEM_ID" lazy="false" />
		<many-to-one name="tipoInvestigadorSemillero" class="SemilleroIntegranteTipo"
			column="SIT_ID" lazy="false" />
	</class>
</hibernate-mapping>
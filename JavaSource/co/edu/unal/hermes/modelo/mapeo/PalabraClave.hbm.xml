<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="co.edu.unal.hermes.modelo">
 <class name="PalabraClave" table="HER_PALABRA_CLAVE">
     
  <id name="id" column="PCL_ID" type="long">
   <generator class="sequence">
    <param name="sequence">SEQ_PALABRA_CLAVE</param>
   </generator>
  </id>    
  
  <property name="palabra" column="PCL_PALABRA" not-null="true"/>
  <property name="palabraOriginal" column="PCL_PALABRA_ORIGINAL" not-null="true"/>
  <property name="idioma" column="PCL_IDIOMA" not-null="true"/>
  <set name="proyectos" table="HER_PROYECTO_PALABRA_CLAVE">
   <key column="PCL_ID"/>
   <many-to-many class="Proyecto" column="PRY_ID"/>
  </set>
  
  
  <set name="avales" table="HER_AVAL_PALABRA_CLAVE">
   <key column="PCL_ID"/>
   <many-to-many class="Aval" column="AVI_ID"/>
  </set>
  
  <set name="movilidadesVisitanteExtranjero" table="HER_MOV_VE_PALABRA_CLAVE">
   <key column="PCL_ID"/>
   <many-to-many class="MovilidadVisitanteExterior" column="MOV_ID"/>
  </set>
  
  <set name="movilidadesDocenteExtranjero" table="HER_MOV_DE_PALABRA_CLAVE">
   <key column="PCL_ID"/>
   <many-to-many class="MovilidadDocentesExterior" column="MOV_ID"/>
  </set>
  
  <set name="movilidadesEstudiantesPosgrado" table="HER_MOV_EP_PALABRA_CLAVE">
   <key column="PCL_ID"/>
   <many-to-many class="MovilidadEstudiantesPosgrado" column="MOV_ID"/>
  </set>
  
  <!--  
  <set name="evaluadores" table="HER_EVALUADOR_PALABRA_CLAVE">
   <key column="PCL_ID"/>
   <many-to-many class="Evaluador">
    <column name="INV_ID"/>
    <column name="TDO_ID"/>
   </many-to-many>
  </set>
  -->
  
 </class>
</hibernate-mapping>

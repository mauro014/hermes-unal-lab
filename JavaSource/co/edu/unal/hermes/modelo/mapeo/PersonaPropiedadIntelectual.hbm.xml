<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="co.edu.unal.hermes.modelo">
	<class name="PersonaPropiedadIntelectual" table="HER_PROPIEDAD_INT_PERSONA">
		<id name="id" column="PIP_ID" type="long">
			<generator class="sequence">
				<param name="sequence">SEQ_PROPIEDAD_INT_PERSONA</param>
			</generator>
		</id>
		<many-to-one name="propiedad" class="PropiedadIntelectual"
			column="PRI_ID" not-null="true" lazy="false" />
			
		<many-to-one name="entidad" class="FuenteFinanciacion" lazy="false">
			<column name="FFI_ID" />
		</many-to-one>
		
		<many-to-one name="persona" class="Investigador" lazy="false">
			<column name="INV_ID" />
			<column name="TDO_ID" />
		</many-to-one>

		<many-to-one name="tipoPersona" class="TipoPersonaPropiedadIntelectual"
			column="PTP_ID" not-null="false" lazy="false" />
			
		<property name="calidad" column="PIP_CALIDAD" type="string"/>
		<property name="ciudad" column="PIP_CIUDAD" type="string"/>
		<property name="sitioWeb" column="PIP_SITIO_WEB" type="string"/>
		
		<many-to-one name="dependencia" class="Dependencia"
			column="DPN_ID" lazy="false" />
			
		<many-to-one name="plan" class="PlanEstudios"
			column="PLE_ID" lazy="false" />
		
		<many-to-one name="obraFijadaFonograma" class="ObraFonogramaPropiedadIntelectual"
			column="POF_ID" lazy="false" />

		<many-to-one name="pais" class="Pais" not-null="false"
			lazy="false">
			<column name="PAIS_ID" />
		</many-to-one>
					 
	</class>
</hibernate-mapping>

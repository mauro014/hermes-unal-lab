<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="co.edu.unal.hermes.modelo.seguimiento">

 <class name="TramiteDocumento" table="HER_TRAMITE_DOCUMENTO">
 
  <id name="id" column="TRD_ID" type="long">
   <generator class="sequence">
    <param name="sequence">SEQ_TRAMITE_DOCUMENTO</param>
   </generator>
  </id>
   
  	<many-to-one name="tramite" class="TramiteSolicitud"  column="TRS_ID" not-null="false" lazy="false"/>
  	
  	<property name="archivo" column="TRD_ARCHIVO" type="blob"/>      
	<property name="fechaGeneracion" column="TRD_FECHA" type="date" />  
   
 </class>
</hibernate-mapping>







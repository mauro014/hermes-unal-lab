<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="co.edu.unal.hermes.modelo">
 <class name="ConvenioEstados" table="HER_EXT_CONVENIO_ESTADOS">
  <id name="id" column="ID_ESTADO_CONVENIO" type="integer">  
   <generator class="sequence">
    <param name="sequence">SEQ_CONVENIO_ESTADOS_EXT</param>
   </generator> 
  </id>  	
  	<property name="convenio" 		column="ID_CONVENIO"/>
  	<property name="estado" 		column="COD_ESTADO_CONVENIO"/>                                  		
  	<property name="fecest" 		column="FECHA_HORA_ESTADO"/>                                      				
  	<property name="observaciones" 	column="OBSERVACIONES_ESTADO"/>                                      			
  	<property name="compromisos" 	column="ID_USUARIO_CAMBIA_ESTADO"/>                                      			  	
 </class>
</hibernate-mapping>

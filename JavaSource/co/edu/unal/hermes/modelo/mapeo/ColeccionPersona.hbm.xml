<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="co.edu.unal.hermes.modelo">
	<class name="ColeccionPersona" table="HER_COLECCION_PERSONA">
		<id name="id" column="COP_ID" type="long">
			<generator class="sequence">
				<param name="sequence">SEQ_COLECCION_PERSONA</param>
			</generator>
		</id>
		<many-to-one name="coleccion" class="Coleccion"
			column="COL_ID" not-null="true" lazy="false" />
		<many-to-one name="persona" class="Persona" not-null="true" lazy="false">
  			<column name="PER_ID"/>
    		<column name="TDO_ID"/>
  		</many-to-one>

		<property name="tipoPersona" column="COP_TIPO" />
		<property name="especialidad" column="COP_ESPECIALIDAD_CURADOR" />
		<property name="perfilEnLinea" column="COP_PERFIL_LINEA" />
		
		<many-to-one name="subGrupoBiologicoCurador" class="DominioDetalle" lazy="false">
			<column name="DOM_ID" />
			<column name="DOMDET_TIPO" />
		</many-to-one>
			
	</class>
</hibernate-mapping>

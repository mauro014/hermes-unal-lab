<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="co.edu.unal.hermes.modelo">

	<class name="GrupoRequisito" table="HER_GRUPO_REQUISITO">

		<id name="id" column="RGR_ID" type="long">
			<generator class="sequence">
				<param name="sequence">SEQ_GRUPO_REQUISITO</param>
			</generator>
		</id>

		<property name="cumplido" column="RGR_CUMPLIDO" />

		<many-to-one name="grupo" class="Grupo" column="GRU_ID"
			not-null="true" lazy="false" />
		<many-to-one name="requisito" class="TipoRequisitoGrupo"
			column="TRG_ID" not-null="true" lazy="false" />

		<property name="comentario" column="RGR_COMENTARIO" />
		<property name="responsableId" column="RGR_RESPONSABLE_ID" />
		<property name="responsableTipoDocumento" column="RGR_RESPONSABLE_TDO_ID" />

	</class>
</hibernate-mapping>

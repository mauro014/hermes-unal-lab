<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 2.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="co.edu.unal.hermes.modelo.seguimiento">
	<class name="DetalleAdicionPresupuesto" table="HER_DETALLE_ADICION">
		<id name="id" column="DAP_ID" type="long">
			<generator class="sequence">
				<param name="sequence">SEQ_DETALLE_ADICION</param>
			</generator>
		</id>
						  	
		<property name="valorAdicionRubro" column="DAP_VALOR" type="long" />
		<property name="valorRubroAntesAdicion" column="DAP_VALOR_ANTERIOR" type="long" />
		<property name="valorRubroDespuesAdicion" column="DAP_VALOR_POSTERIOR" type="long" />
		
		<many-to-one name="solicitudAdicion" class="co.edu.unal.hermes.modelo.seguimiento.SolicitudAdicionPresupuestal" column="SAP_ID" lazy="false" />
		<many-to-one name="gasto" class="co.edu.unal.hermes.modelo.Gasto" column="GST_ID" not-null="false" lazy="false"/>
	  	<many-to-one name="tipoRubro" class="co.edu.unal.hermes.modelo.TipoRubro" column="TRU_ID" not-null="true" lazy="false"/>	  				
	</class>
</hibernate-mapping>
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="co.edu.unal.hermes.modelo.seguimiento">

 <class name="SolicitudDocumento" table="HER_SOLICITUD_DOCUMENTO">
 
  <id name="id" column="SLC_ID" type="long">
   <generator class="sequence">
    <param name="sequence">SEQ_SOLICITUD_DOCUMENTO</param>
   </generator>
  </id>
   
  	<many-to-one name="solicitud" class="Solicitud"  column="SOL_ID" not-null="false" lazy="false"/>
  	
  	<property name="archivo" column="SLC_ARCHIVO" type="blob"/>      
	<property name="fechaGeneracion" column="SLC_FECHA" type="date" /> 
	<property name="nombre" column="SLC_NOMBRE" />   
	
	<many-to-one name="tipo" class="co.edu.unal.hermes.modelo.TipoArchivo"  column="TIA_ID" lazy="false"/>
   
 </class>
</hibernate-mapping>







<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="co.edu.unal.hermes.modelo.laboratorios">

	<class name="LaboratorioDetalleEnsayosServicios" table="HER_LABORATORIO_DETALLE_ENSAYO">

		<id name="id" column="LDENS_ID" type="long">
			<generator class="sequence">
				<param name="sequence">SEQ_DETALLE</param>
			</generator>
		</id>

		<many-to-one name="laboratorio"
			class="co.edu.unal.hermes.modelo.laboratorios.Laboratorio" lazy="false">
			<column name="LAB_ID" />
		</many-to-one>

		<property name="nombre" column="LDENS_NOMBRE" type="string" not-null="true" length="100" />

		<property name="docencia" column="LDENS_DOCENCIA" />

		<property name="investigacion" column="LDENS_INVESTIGACION" />

		<property name="extension" column="LDENS_EXTENSION" />

		<property name="valorServicio" column="LDENS_VALOR_SERVICIO" />

		<property name="ensayosMes" column="LDENS_ENSAYOS_MES" />

		<property name="tiempoTotalEstimado" column="LDENS_TIEMPO_TOTAL_ESTIMADO" />

		<many-to-one name="unidadTiempoTotalEstimado" class="co.edu.unal.hermes.modelo.Tipos" column="LDENS_TIEMPO_TOTAL_ESTIMADO_UN" lazy="false" />

		<property name="personas" column="LDENS_PERSONAS" />
		
		<property name="acreditado" column="LDENS_ACREDITADO" />

		<property name="fechaRegistro" column="LDENS_FECHA_REGISTRO" />

		<set name="equipos" table="HER_LABORATORIO_ENSAYO_EQUIPOS" lazy="false">
			<key column="LDENS_ID" />
			<many-to-many class="LaboratorioDetalleEquipos" column="LDE_ID" />
		</set>
		
		<many-to-one name="tipoNormaTecnica" class="co.edu.unal.hermes.modelo.Tipos" column="LDENS_NORMA_TECNICA_TIPO" lazy="false" />
			
		<property name="numeroNormaTecnica" column="LDENS_NORMA_TECNICA_NUMERO" />
		
		<many-to-one name="tipoEnsayo" class="co.edu.unal.hermes.modelo.Tipos" column="LDENS_TIPO_ENSAYO" lazy="false" />
		<property name="tipoEnsayoOtros" column="LDENS_TIPO_ENSAYO_OTROS" />
		
		<property name="descripcion" column="LDENS_DESCRIPCION" />
		<many-to-one name="calibMagnitudArea" class="co.edu.unal.hermes.modelo.Tipos" column="LDENS_CALIB_MAGNITUD_AREA" lazy="false" />
		<property name="calibEquipo" column="LDENS_CALIB_EQUIPO_INSTRUMENTO" />
		<property name="versionNormaTecnica" column="LDENS_NORMA_TECNICA_VERSION" />
		<many-to-one name="acreditadoOrganismo" class="co.edu.unal.hermes.modelo.Tipos" column="LDENS_ACREDITADO_ORGANISMO" lazy="false" />
		
		<property name="intervaloPuntoMedMinimo" column="LDENS_INTERV_MIN" />
	    <property name="intervaloPuntoMedMaximo" column="LDENS_INTERV_MAX" />
	    <many-to-one name="unidadesIntervaloPrefijo" class="co.edu.unal.hermes.modelo.Tipos" column="LDENS_UNID_INTERV_PREFIJO" lazy="false"/>
	    <many-to-one name="unidadesIntervaloUnidad" class="co.edu.unal.hermes.modelo.Tipos" column="LDENS_UNID_INTERV_UNIDAD" lazy="false"/>
	    <property name="unidadesIntervaloSimbolo" column="LDENS_UNID_INTERV_SIMBOLO" />
	    <many-to-one name="incertidumbreMedicionIncertidumbre" class="co.edu.unal.hermes.modelo.Tipos" column="LDENS_INCERT_MED_INCERT" lazy="false"/>
	    <property name="incertidumbreMedicionValor" column="LDENS_INCERT_MED_VALOR" />
	    <many-to-one name="incertidumbreMedicionPrefijo" class="co.edu.unal.hermes.modelo.Tipos" column="LDENS_INCERT_MED_PREFIJO" lazy="false"/>
	    <many-to-one name="incertidumbreMedicionUnidad" class="co.edu.unal.hermes.modelo.Tipos" column="LDENS_INCERT_MED_UNIDAD" lazy="false"/>
	    <property name="incertidumbreMedicionSimbolo" column="LDENS_INCERT_MED_SIMBOLO" />

	</class>

</hibernate-mapping>
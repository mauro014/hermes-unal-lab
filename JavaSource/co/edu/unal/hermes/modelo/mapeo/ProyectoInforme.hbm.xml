<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="co.edu.unal.hermes.modelo">
	<class name="ProyectoInforme" table="HER_PROYECTO_INFORME">
		<id name="id" column="PIN_ID" type="long">
			<generator class="sequence">
				<param name="sequence">SEQ_PROYECTO_INFORME</param>
			</generator>
		</id>
		<many-to-one name="proyecto" class="Proyecto" column="PRY_ID"
			not-null="true" lazy="false" />
		<many-to-one name="tipoInforme" class="TipoInforme"
			column="TIN_ID" not-null="true" lazy="false" />
		<many-to-one name="estadoInforme" class="EstadoInforme"
			column="EIN_ID" not-null="true" lazy="false" />
		<many-to-one name="proyectoCompromiso" class="ProyectoCompromiso"
			column="COM_ID" not-null="false" lazy="false" />
		<property name="fechaGeneracion" column="PIN_FECHA" type="date" />
		<property name="avanceResumen" column="PIN_AVANCE" />
		<property name="avanceResultados" column="PIN_RESULTADOS" />
		<property name="dificultades" column="PIN_DIFICULTADES" />
		<property name="cuadroResultados" column="PIN_CUADRO_RESULTADOS"
			type="blob" />
		<property name="informeFinanciero" column="PIN_INFORME_FINANCIERO"
			type="blob" />
		<property name="cuadroNombre" column="PIN_CUADRO_NOMBRE" />
		<property name="financieroNombre" column="PIN_NOMBRE_FINANCIERO" />
		<property name="sipnosis" column="PIN_SIPNOSIS" />
		<property name="sipnosisD" column="PIN_SIPNOSIS_D" />
		<property name="impactoD" column="PIN_IMPACTO_D" />
		<property name="impacto" column="PIN_IMPACTO" />
		<property name="conclusiones" column="PIN_CONCLUSIONES" />
		<property name="resumenTecnico" column="PIN_RESUMEN_TECNICO" />
		<property name="noAprobacion" column="PIN_MOTIVO_NO_APROBACION" />
		<property name="noLectura" column="PIN_MOTIVO_NO_LECTURA" />
		<property name="dependenciaAvalFacultad" column="PIN_DEP_AVAL_FAC" />
		<property name="dependenciaInforme" column="DPN_ID" />
		<property name="documentoFacultad" column="PIN_DOCUMENTO_FACULTAD"
			type="blob" />
		<property name="nombreDocumentoFac" column="PIN_NOMBRE_DOCUMENTO_FAC" />
		<property name="fechaAprobacion" column="PIN_FECHA_APROBACION"
			type="date" />
		<property name="fechaLectura" column="PIN_FECHA_LECTURA"
			type="date" />
		<property name="compraEquipos" column="PIN_COMPRA_EQUIPOS" />
		<property name="formacionEstudiantes" column="PIN_FORMACION_EST" />
		<property name="compromisos" column="PIN_COMPROMISOS" />
		<property name="productosEnSara" column="PIN_PROD_SARA" />
		<property name="pryTieneSaldoEjecucion" column="PIN_TIENE_SALDO_EJEC" />
		<property name="numeroActoAdministrativoFacultad" column="PIN_ACTO_ADM_FAC" />
		<property name="observaciones" column="PIN_OBSERVACIONES" />
		<property name="fechaDesde" column="PIN_FECHA_DESDE" />
		<property name="fechaHasta" column="PIN_FECHA_HASTA" />
		<property name="porcentajeEjecucion" column="PIN_PORC_EJEC" />
		<property name="porcentajeEjecucionPresupuestal" column="PIN_PORC_EJEC_PRE" />
		<property name="montoTotalEjecutadoPeriodo" column="PIN_MONTO_EJEC_PERIODO" />
		<property name="idEstudiante" column="PIN_EST_ID" />
		<property name="tipoDocEstudiante" column="PIN_EST_TDO_ID" />
		<property name="calificacion" column="PIN_CALIFICACION" />
		<property name="idResponsable" column="PIN_RESP_ENVIO_ID" />
		<property name="tipoDocResponsable" column="PIN_RESP_ENVIO_TDO_ID" />
		<property name="montoSolicitado" column="PIN_MONTO_SOLICITADO" />
		<property name="fechaEliminacion" column="PIN_FECHA_ELIMINACION"
			type="date" />
		<property name="totalValorEjecutado" column="PIN_TOTAL_VALOR_EJECUTADO" />
		<property name="numeroParticipantesEvento" column="PIN_NUMERO_PARTICIPANTES" />
		<property name="numeroEstudiantesEvento" column="PIN_NUMERO_ESTUDIANTES" />
		<property name="numeroExternosEvento" column="PIN_NUMERO_EXTERNOS" />
		<property name="numeroNotificaciones" column="PIN_NUMERO_NOTIFICACION" />
		<property name="recolectaEspecimenes" column="PIN_RECOLECTA_ESPECIMENES" />
		
		<set name="productos" table="HER_PRODUCTO_SARA" lazy="false"
			inverse="true" cascade="all-delete-orphan">
			<key column="PIN_ID" />
			<one-to-many class="ProductoSara" />
		</set>
		<many-to-one name="revisorFacultad" class="co.edu.unal.hermes.modelo.Persona"
			lazy="false">
			<column name="PER_ID_REVISION_FACULTAD" />
			<column name="TDO_ID_REVISION_FACULTAD" />
		</many-to-one>
		<many-to-one name="revisorCoordinador" class="co.edu.unal.hermes.modelo.Persona"
			lazy="false">
			<column name="PER_ID_REVISION_COORDINADOR" />
			<column name="TDO_ID_REVISION_COORDINADOR" />
		</many-to-one>
		<many-to-one name="responsableEliminacion" class="co.edu.unal.hermes.modelo.Persona"
			lazy="false">
			<column name="PER_ID_ELIMINACION" />
			<column name="TDO_ID_ELIMINACION" />
		</many-to-one>
		
		<property name="porcentajeEjecucionPresupuestalExterno" column="PIN_PORC_EJEC_PRE_EXT" />
		<property name="montoTotalEjecutadoPeriodoExt" column="PIN_MONTO_EJEC_PERIODO_EXT" />
		<property name="mostartMontoEjecutadoExt" column="PIN_MOSTRAR_EJEC_EXT" />
		
		<set name="objetivos" table="HER_PROYECTO_INFORME_OBJ_ESP"
			inverse="true" cascade="all-delete-orphan" order-by="PIO_ID" lazy="false">
			<key column="PIN_ID" />
			<one-to-many class="ProyectoInformeObjetivoEspecifico" />
		</set>
		
		<set name="actividades" table="HER_PROYECTO_INFORME_ACTIVIDAD"
			inverse="true" cascade="all-delete-orphan" order-by="ACT_ID" lazy="false">
			<key column="PIN_ID" />
			<one-to-many class="ProyectoInformeActividad" />
		</set>
		
		<set name="resultados" table="HER_PROYECTO_INFORME_RESULTADO"
			inverse="true" cascade="all-delete-orphan" order-by="RST_ID" lazy="false">
			<key column="PIN_ID" />
			<one-to-many class="ProyectoInformeResultado" />
		</set>
		
	</class>
</hibernate-mapping>
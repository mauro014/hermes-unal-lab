<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
                                   
<hibernate-mapping package="co.edu.unal.hermes.modelo">

 <class name="HistoricoAsignacionProyecto" table="HER_HISTORICO_ASIGN_PROYECTO">
  
  <id column="HAP_ID" name="id" type="long">
  	<generator class="sequence">
         <param name="sequence">SEQ_HISTORICO_ASIGN_PROYECTO</param>
    </generator>
  </id>
  <many-to-one name="proyecto" column="PRY_ID" class="Proyecto" not-null="true"/>
  
  <many-to-one name="asesor" class="co.edu.unal.hermes.modelo.Persona" not-null="true" lazy="false">
	<column name="PER_ID_ASESOR"/>
	<column name="TDO_ID_ASESOR"/>
  </many-to-one>
  
  <many-to-one name="coordinador" class="co.edu.unal.hermes.modelo.Persona" not-null="true" lazy="false">
	<column name="PER_ID_COORDINADOR"/>
	<column name="TDO_ID_COORDINADOR"/>
  </many-to-one>
  
  <property name="fecha" column="HAP_FECHA"/>
  <property name="tipo" column="HAP_TIPO"/>
  
 </class> 
</hibernate-mapping>
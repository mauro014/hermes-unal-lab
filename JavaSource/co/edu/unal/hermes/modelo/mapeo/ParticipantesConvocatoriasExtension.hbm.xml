<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="co.edu.unal.hermes.modelo">
	<class name="ParticipantesConvocatoriasExtension" table="HER_PARTICIPANTES_CONV_DNE">
		<id name="id" column="PAR_ID" type="long">
			<generator class="sequence">
				<param name="sequence">SEQ_PARTICIPANTES_CONV_DNE</param>
			</generator>
		</id>

		<many-to-one name="investigador" class="Investigador"
			not-null="true" lazy="false">
			<column name="INV_ID" />
			<column name="TDO_ID" />
		</many-to-one>

		<many-to-one name="dependencia" class="Dependencia"
			column="DPN_ID" lazy="false" />

		<property name="comentarioParticipacion" column="PAR_COMENTARIO" />

		<many-to-one name="convocatoriaDNE" class="ConvocatoriasExtension"
			not-null="true" lazy="false">
			<column name="CON_DNE_ID" />
		</many-to-one>

		<property name="intencion" column="PAR_INTENCION" />
		
		<property name="fechaRegistro" column="PAR_FECHA_REGISTRO"
			not-null="true" />

	</class>
</hibernate-mapping>

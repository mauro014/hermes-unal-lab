<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="co.edu.unal.hermes.modelo">
 <class name="Region" table="HER_REGION">
  <id name="id" column="REG_ID" type="string">
   <generator class="assigned"/>
  </id>
  <many-to-one name="pais" class="Pais" column="PAIS_ID" not-null="true" lazy="false"/>
  <property name="nombre" column="REG_NOMBRE"/>
 </class>
</hibernate-mapping>

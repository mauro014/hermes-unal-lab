<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="co.edu.unal.hermes.modelo">
 <class name="TipoInforme" table="HER_TIPO_INFORME">
  <id name="id" column="TIN_ID" type="long">
   <generator class="sequence">
   	<param name="sequence">SEQ_TIPO_INFORME</param>
   </generator>
  </id>
  <property name="nombre" column="TIN_NOMBRE"/>
   <property name="archivoInforme" column="TIN_ARCHIVO" type="blob"/>   
  <property name="nombreArchivo" column="TIN_NOMBRE_ARCHIVO" />
  
 </class>	  
</hibernate-mapping>

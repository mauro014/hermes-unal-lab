<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="co.edu.unal.hermes.modelo">
	<class name="AvalComiteEtica" table="HER_AVAL_COMITE_ETICA">
		 <id name="id" column="ACE_ID" type="long" />
		 <property name="tipo" column="ACE_TIPO"/>
		 <property name="nombre" column="ACE_NOMBRE"/>
		 <many-to-one name="dependencia" class="Dependencia" column="DPN_ID" lazy="false"/>
		 <many-to-one name="cesi" class="AvalComiteEtica" column="ACE_ID_PADRE" lazy="false"/>
	</class>
</hibernate-mapping>

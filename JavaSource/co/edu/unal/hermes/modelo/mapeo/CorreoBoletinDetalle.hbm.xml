<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="co.edu.unal.hermes.modelo">
 <class name="CorreoBoletinDetalle" table="HER_CORREO_BOLETIN_DETALLE">
    
   <id name="id" column="CBD_ID" type="long">
   <generator class="sequence">
    <param name="sequence">SEQ_CORREO_BOL_DETALLE</param>
   </generator>
  </id>
   
  <property name="tipoPersonaCorreo" column="TPB_ID" type ="long"/>
  <property name="documentoPersona" column="PER_ID"/>
  <property name="tipoDocumento" column="TDO_ID"/>
  <property name="fecha" column="CBD_FECHA" />
  <property name="tipo" column="CBD_TIPO" type ="long"/>
 <property name="ultimaDireccion" column="CBD_ULTIMA_DIRECCION"/>
  <property name="idUltimaDireccion" column="CBD_ID_ULTIMA_DIRECCION" type ="long"/>
    
 </class>
</hibernate-mapping>

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 2.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="co.edu.unal.hermes.modelo">
 <class name="TipoArchivoMovilidad" table="HER_TIPO_ARCHIVO_MOVILIDAD">
  <id name="id" column="TAM_ID" type="long">
   <generator class="sequence">
    <param name="sequence">SEQ_TIPO_ARCHIVO_MOVILIDAD</param>
   </generator>
  </id>
  <property name="nombre" column="TAM_NOMBRE"/>
 </class>
</hibernate-mapping>

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="co.edu.unal.hermes.modelo.laboratorios">
	<class name="LaboratorioCostosMantenimientoCalibracion" table="HER_LAB_COSTOS_MANTTO_CALIB">
		<composite-id>
			<key-many-to-one name="costosServicio"
				class="co.edu.unal.hermes.modelo.laboratorios.LaboratorioCostosServicio"
				lazy="false">
				<column name="HLCS_ID" />
			</key-many-to-one>
			<key-many-to-one name="equipo"
				class="co.edu.unal.hermes.modelo.laboratorios.LaboratorioDetalleEquipos"
				lazy="false">
				<column name="LDE_ID" />
			</key-many-to-one>
			<key-many-to-one name="tipoActividad"
				class="co.edu.unal.hermes.modelo.Tipos" lazy="false">
				<column name="HLCMC_TIPO_ACTIVIDAD" />
			</key-many-to-one>
		</composite-id>
		<property name="costoAnual" column="HLCMC_COSTO_ANUAL" />
	</class>
</hibernate-mapping>
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="co.edu.unal.hermes.modelo">
	<class name="GrupoIntersedes" table="HER_GRUPO_INTERSEDE">
		<id name="id" column="GRI_ID" type="long">
			<generator class="sequence">
				<param name="sequence">SEQ_GRUPO_INTERSEDE</param>
			</generator>
		</id>
		<many-to-one name="sede" class="Sede"
			column="SED_ID" not-null="true" lazy="false" />
		<many-to-one name="grupo" class="Grupo"
			column="GRU_ID" not-null="true" lazy="false" />
		<property name="fechaRegistro" column="GRI_FECHA_REGISTRO" />
		<property name="fechaBorrado" column="GRI_FECHA_BORRADO" />
		<many-to-one name="responsableRetiro" class="co.edu.unal.hermes.modelo.Persona"
			lazy="false">
			<column name="PER_ID2" />
			<column name="TDO_ID2" />
		</many-to-one>
		<many-to-one name="responsableRegistro" class="co.edu.unal.hermes.modelo.Persona"
			lazy="false">
			<column name="PER_ID" />
			<column name="TDO_ID" />
		</many-to-one>
	</class>
</hibernate-mapping>

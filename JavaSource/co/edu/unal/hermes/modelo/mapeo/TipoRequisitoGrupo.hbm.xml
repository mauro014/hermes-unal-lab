<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="co.edu.unal.hermes.modelo">
	<class name="TipoRequisitoGrupo" table="HER_TIPO_REQUISITO_GRUPOS">
		<id name="id" column="TRG_ID" type="long">
			<generator class="sequence">
				<param name="sequence">SEQ_TIPO_REQUISITO_GRUPO</param>
			</generator>
		</id>
		<property name="vigencia" column="TRG_VIGENTE" />
		<property name="descripcion" column="TRG_TEXTO"></property>
	</class>
</hibernate-mapping>

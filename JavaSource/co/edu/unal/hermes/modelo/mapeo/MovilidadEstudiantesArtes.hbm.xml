<?xml version="1.0" encoding="UTF-8"?>


<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="co.edu.unal.hermes.modelo">
	<class name="MovilidadEstudiantesArtes" table="HER_MOVILIDAD_ESTUDIANTES_ART">

		<id name="id" column="MOV_ID" type="long" unsaved-value="-1">
			<generator class="sequence">
				<param name="sequence">SEQ_MOVILIDAD</param>
			</generator>
		</id>

		<property name="nombreArtistico" column="MOV_NOMBRE_ARTISTICO" />
		<property name="pasaporte" column="MOV_PASAPORTE" />
		<property name="paginaWeb" column="MOV_PAGINA_WEB" />
		<property name="telefonoFijo" column="MOV_TELEFONO_FIJO" />
		<property name="telefonoMovil" column="MOV_TELEFONO_MOVIL" />
		<property name="direccion" column="MOV_DIRECCION" />
		<property name="nombreProyecto" column="MOV_NOMBRE_PROYECTO" />
		<property name="fechainicial" column="MOV_FECHA_INICIO" />
		<property name="fechafinal" column="MOV_FECHA_FIN" />
		<property name="statementArtista" column="MOV_STATEMENT" />
		<property name="descripcionProyecto" column="MOV_DESCRIPCION_PROYECTO" />
		<property name="objetivoGeneral" column="MOV_OBJETIVO_GENERAL" />
		<property name="objetivoEspecifico" column="MOV_OBJETIVOS_ESPECIFICOS" />
		<property name="proyectoRelacionLocal" column="MOV_RELACION_LOCAL" />
		<property name="ciudad" column="MOV_CIUDAD" />
		<property name="areaArte" column="MOV_AREA_ARTE" />
		<property name="seleccionInstitucion" column="MOV_METODO_SELECCION" />
		<property name="institucion" column="MOV_INSTITUCION" />
		<property name="tipoInstitucion" column="MOV_TIPO_INSTITUCION" />
		<property name="anteriorResidencia" column="MOV_ANTERIOR_RESIDENCIA" />
		<property name="descripcionPrograma" column="MOV_DESCRIPCION_PROGRAMA" />
		<property name="proyectoFicha" column="PRY_ID" />

		<property name="tiquetesUN" column="MOV_TIQUETE_UN" />
		<property name="tallerUN" column="MOV_TALLER_UN" />
		<property name="alojamientoUN" column="MOV_ALOJAMIENTO_UN" />
		<property name="alimentacionUN" column="MOV_ALIMENTACION_UN" />
		<property name="materialesUN" column="MOV_MATERIALES_UN" />
		<property name="transporteUN" column="MOV_TRANSPORTE_UN" />
		<property name="socializacionUN" column="MOV_SOCIALIZACION_UN" />

		<property name="tiquetesP" column="MOV_TIQUETE_PRO" />
		<property name="tallerP" column="MOV_TALLER_PRO" />
		<property name="alojamientoP" column="MOV_ALOJAMIENTO_PRO" />
		<property name="alimentacionP" column="MOV_ALIMENTACION_PRO" />
		<property name="materialesP" column="MOV_MATERIALES_PRO" />
		<property name="transporteP" column="MOV_TRANSPORTE_PRO" />
		<property name="socializacionP" column="MOV_SOCIALIZACION_PRO" />


		<property name="descripcionFacultad" column="MOV_DESCRIPCION_FACULTAD" />
		<property name="descripcionSede" column="MOV_DESCRIPCION_SEDE" />

		<property name="planSocializacionResidencia" column="MOV_SOCIALIZACION_RESIDENCIA" />
		<property name="planSocializacionUN" column="MOV_SOCIALIZACION_CAMPUS" />

		<property name="trabajos" column="MOV_TRABAJOS" />
		<property name="estado" column="MOV_ESTADO" />
		<property name="etapa" column="MOV_ETAPA" />


		<property name="comoEntero" column="MOV_COMO_ENTERO" />
		<property name="aporteRedArtistas" column="MOV_APORTE_RED" />
		<property name="contribucion" column="MOV_CONTRIBUCION" />
		<property name="especialistasArea" column="MOV_ESPECIALISTAS_AREA" />
		<property name="aceptacionFacultad" column="MOV_AVAL_FACULTAD" />
		<property name="aprobacionSede" column="MOV_AVAL_SEDE" />
		<property name="fechasolicitud" column="MOV_FECHA_SOLICITUD" />

		<property name="totalUN" column="MOV_TOTAL_UN" />
		<property name="totalPropio" column="MOV_TOTAL_PROPIO" />

		<property name="papaEstudiante" column="MOV_EST_PAPA" />
		
		<property name="dispPresupuestal" column="MOV_DIS_PRESUPUESTAL"/>
  		<property name="dispPresupuestalSede" column="MOV_DIS_PRESUPUESTAL_SEDE"/>

		<many-to-one name="personaInv" class="Persona" not-null="false"
			lazy="false">
			<column name="MOV_ID_PER" />
			<column name="MOV_TDO_ID_PER" />
		</many-to-one>
		<many-to-one name="estudianteInv" class="Estudiante"
			not-null="false" lazy="false">
			<column name="MOV_ID_EST" />
			<column name="MOV_TDO_ID_EST" />
		</many-to-one>
		<many-to-one name="continente" class="Continente"
			not-null="false" lazy="false">
			<column name="MOV_CONTINENTE" />
		</many-to-one>
		<many-to-one name="pais" class="Pais" not-null="false"
			lazy="false">
			<column name="MOV_PAIS" />
		</many-to-one>
		<many-to-one name="nacionalidad" class="Pais" not-null="false"
			lazy="false">
			<column name="MOV_NACIONALIDAD" />
		</many-to-one>
		<many-to-one name="tipoMovilidad" class="TipoMovilidad"
			not-null="false" lazy="false">
			<column name="MOV_ID_TIPO" />
		</many-to-one>

		<set name="archivos" table="HER_ARCHIVO_MOVILIDAD" cascade="all-delete-orphan"
			lazy="false">
			<key column="MOV_ID" />
			<one-to-many class="ArchivoMovilidad" />
		</set>

		<set name="actividades" table="HER_ACTIVIDAD_MOVILIDAD" cascade="all-delete-orphan">
			<key column="MOV_ID" />
			<one-to-many class="ActividadMovilidad" />
		</set>


		<many-to-one name="convocatoria" class="Convocatoria"
			lazy="false">
			<column name="CON_ID" />
		</many-to-one>
		<property name="idPersonaAprobacion" column="MOV_ID_PER_APROB" />
		<property name="tipoIdPersonaAprobacion" column="MOV_TDO_ID_PER_APROB" />
		
		 <property name="calificacionA" column="MOV_CALIFICACION_A" />
		 <property name="calificacionB" column="MOV_CALIFICACION_B" />
		 <property name="calificacionC" column="MOV_CALIFICACION_C" />
		 <property name="segMovFecha" column="MOV_SEGMOV_FECHA" />
		 <property name="segMovDescripcion" column="MOV_SEGMOV_DESCRIPCION" />
		 <property name="realizacionMovilidad" column="MOV_REALIZACION_MOVILIDAD" />
		 <property name="razonesNoRealizacion" column="MOV_RAZONES_NO_REALIZACION" />
		 <property name="estadoSeguimiento" column="MOV_ESTADO_SEG" />
		 <property name="totalTiquetesUN" column="MOV_TOTAL_TIQUETE_UN"/>
		 <property name="totalTallerUN" column="MOV_TOTAL_TALLER_UN"/> 	
		 <property name="totalAlojamientoUN" column="MOV_TOTAL_ALOJAMIENTO_UN"/>
		 <property name="totalAlimentacionUN" column="MOV_TOTAL_ALIMENTACION_UN"/>
		 <property name="totalMaterialesUN" column="MOV_TOTAL_MATERIALES_UN"/>
		 <property name="totalTransporteUN" column="MOV_TOTAL_TRANSPORTE_UN"/>
		 <property name="totalSocializacionUN" column="MOV_TOTAL_SOCIALIZACION_UN"/>
		 <property name="totalApoyoUN" column="MOV_TOTAL_APOYO_UN"/>
		 <property name="experienciaResidencia" column="MOV_SEG_EXPERIENCIA"/>
		
		<set name="requisitosMovilidad" table="HER_MOVILIDAD_REQUISITO"
			inverse="true" order-by="TPR_ID ASC" cascade="all-delete-orphan">
			<key column="MOV_ID" />
			<one-to-many class="MovilidadRequisito" />
		</set>
		<property name="estadoRevisionSeguimiento" column="MOV_ESTADO_REVISION_SEG" />
	</class>
</hibernate-mapping>

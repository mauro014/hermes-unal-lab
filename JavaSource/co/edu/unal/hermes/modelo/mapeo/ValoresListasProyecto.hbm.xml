<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">



<hibernate-mapping package="co.edu.unal.hermes.modelo">
	<class name="ValoresListasProyecto" table="HER_PROYECTO_LISTAS_VAL">
		<id name="id" column="VAL_ID" type="long">
			<generator class="sequence">
				<param name="sequence">SEQ_PRY_LISTAS_VAL</param>
			</generator>
		</id>
		<many-to-one name="proyecto" class="Proyecto" column="PRY_ID" not-null="true" lazy="false"/>
		<property name="tipo" column="VAL_TIPO" />
		<property name="descripcion" column="VAL_DESCRIPCION" />
		<property name="valor" column="VAL_VALOR" />
		<property name="nombreValor" column="VAL_NOMBRE_VALOR" />		
		<property name="valorDos" column="VAL_VALOR2" />
		<property name="descripcionDos" column="VAL_DESCRIPCION2" />
		<property name="valorTres" column="VAL_VALOR3" />
		<property name="descripcionTres" column="VAL_DESCRIPCION3" />
		<property name="valorCuatro" column="VAL_VALOR4" />
		<property name="descripcionCuatro" column="VAL_DESCRIPCION4" />
	</class>
</hibernate-mapping>

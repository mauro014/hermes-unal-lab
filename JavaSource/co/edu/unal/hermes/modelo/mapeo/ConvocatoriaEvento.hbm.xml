<?xml version="1.0" encoding="UTF-8"?>


<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="co.edu.unal.hermes.modelo">
 <class name="ConvocatoriaEvento" table="HER_CONVOCATORIA_EVENTO">
    
  <id name="id" column="CNE_ID" type="long" unsaved-value="-1">
   <generator class="sequence">
    <param name="sequence">SEQ_CONVOCATORIA_UN</param>
   </generator> 
  </id>	
  
  <property name="fechaSolicitud" column="CNE_FECHA_SOLICITUD"/>  
  <property name="dependenciaSolicitud" column="CNE_DEPENDENCIA"/>
  <property name="nombreEvento" column="CNE_NOMBRE_EVENTO"/>	
  <property name="justificacion" column="CNE_JUSTIFICACION"/>    	
  <property name="tipoEvento" column="CNE_TIPO"/>
  <property name="otroTipo" column="CNE_OTRO_TIPO"/>    
  <property name="caracterEvento" column="CNE_CARACTER"/>  
  <property name="dependenciasUN" column="CNE_DEPENDENCIAS"/>
  <property name="dependenciasEXT" column="CNE_INSTITUCIONES"/>
  <property name="productos" column="CNE_TIPO_PRODUCTO"/>
  <property name="valorSolicitado" column="CNE_VALOR_SOLICITADO"/>
  <property name="dependenciaEjecutora" column="CNE_EJECUTORA"/>
  <property name="valorEvento" column="CNE_VALOR_TOTAL"/>
  <property name="actividades" column="CNE_ACTIVIDADES"/>
  <property name="estado" column="CNE_ESTADO"/>
  <property name="evaluacion" column="CNE_EVALUACION"/>
  <property name="comentarioEvaluacion" column="CNE_COMENTARIO_EVALUACION"/>
  <property name="requerimiento1" column="CNE_REQUERIMIENTO1"/>
  <property name="requerimiento2" column="CNE_REQUERIMIENTO2"/>
  <property name="requerimiento3" column="CNE_REQUERIMIENTO3"/>
  <property name="requerimiento4" column="CNE_REQUERIMIENTO4"/>
  <property name="montoAprobado" column="CNE_MONTO_APROBADO"/>
  <property name="tipoSolicitud" column="CNE_TIPO_SOLICITUD"/>
  <property name="fechaEvento" column="CNE_FECHA_EVENTO"/>
  <property name="fechaFinalizacionEvento" column="CNE_FECHA_FIN_EVENTO"/>
  <property name="lugar" column="CNE_LUGAR"/>
  <property name="aporteEconomico" column="CNE_APORTE_ECONOMICO"/>
  <property name="asistentes" column="CNE_ASISTENTES"/>
  <property name="conferencistasNacExt" column="CNE_CONFERENCISTAS_NAC_EXT"/>
  <property name="conferencistasNacVinc" column="CNE_CONFERENCISTAS_NAC_VINC"/>
  <property name="conferencistasInternac" column="CNE_CONFERENCISTAS_INTERNAC"/>
  <property name="tipoParticipacion" column="CNE_TIPO_PARTICIPACION"/>
  <property name="rei1" column="CNE_REI1"/>
  <property name="rei2" column="CNE_REI2"/>
  <property name="rei3" column="CNE_REI3"/>
  <property name="rei4" column="CNE_REI4"/>
  <property name="rei5" column="CNE_REI5"/>
  <property name="rei6" column="CNE_REI6"/>
  <property name="rei7" column="CNE_REI7"/>
  <property name="ren1" column="CNE_REN1"/>
  <property name="ren2" column="CNE_REN2"/>
  <property name="ren3" column="CNE_REN3"/>
  <property name="ren4" column="CNE_REN4"/>
  <property name="ren5" column="CNE_REN5"/>
  <property name="ren6" column="CNE_REN6"/>
  <property name="ren7" column="CNE_REN7"/>
  <property name="rel1" column="CNE_REL1"/>
  <property name="rel2" column="CNE_REL2"/>
  <property name="rel3" column="CNE_REL3"/>
  <property name="rel4" column="CNE_REL4"/>
  <property name="rel5" column="CNE_REL5"/>
  <property name="rel6" column="CNE_REL6"/>
  <property name="rel7" column="CNE_REL7"/>
  <property name="rel8" column="CNE_REL8"/>
  <property name="conferencistas" column="CNE_CONFERENCISTAS"/>
  <property name="actividadesRealizadas" column="CNE_ACTIV_REALIZADAS"/>
  <property name="asistentesEvento" column="CNE_ASISTENTES_EVENTO"/>
  <property name="alianzas" column="CNE_ALIANZAS"/>
  <property name="financiacionUN" column="CNE_FINANCIACION_UN"/>
  <property name="observaciones" column="CNE_OBSERVACIONES"/>
  <property name="resultados" column="CNE_RESULTADOS"/>
   <property name="observaciones_VRI" column="CNE_OBSERVACIONES_VRI"/>
         
  <many-to-one name="personaInv" class="Persona" not-null="false" lazy="false">
	<column name="PER_ID"/>
    <column name="TDO_ID"/>
  </many-to-one>        
  
  <set name="archivos" table="HER_ARCHIVO_CONVOCATORIA" cascade="all-delete-orphan" fetch="join">
	    <key column="ACN_CONVOCATORIA"/>
	    <one-to-many class="ArchivoConvocatoria"/>
  </set>  
     
 </class>
</hibernate-mapping>

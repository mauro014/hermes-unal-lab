<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="co.edu.unal.hermes.modelo">
 <class name="InvestigadorProyecto" table="HER_INVESTIGADOR_PROYECTO">
  <id name="id" column="INP_ID" type="long">
   <generator class="sequence">
    <param name="sequence">SEQ_INVESTIGADOR_PROYECTO</param>
   </generator>
  </id>
  
  <many-to-one name="proyecto" class="Proyecto" column="PRY_ID" not-null="true" lazy="false"/>
  <many-to-one name="investigador" class="Investigador" not-null="true" lazy="false">
  	<column name="INV_ID"/>
    <column name="TDO_ID"/>
  </many-to-one>
  
  <many-to-one name="tipo" column="INP_TIPO" class="TipoInvestigador" lazy="false"/>
  <many-to-one name="empresa" column="EMP_ID" class="Empresa" lazy="false"/>
  <property name="dedicacionHorasSemana" column="INP_DEDICACION_HORAS_SEMANA"/>
  <property name="totalHorasVinculacion" column="INP_TOTAL_HORAS_VINCULACION"/>
  <property name="funcion" column="INP_FUNCION"/>  
  <property name="horasJornadaDocente" column="INP_HORAS_JORNADA_DOCENTE"/>
  <property name="valorPagar" column="INP_VALOR_PAGAR"/>
  <property name="visible" column="INP_VISIBLE"/>    
  <many-to-one name="dependencia" column="DPN_ID" class="Dependencia" lazy="false" not-null="false"/>
  <many-to-one name="plan" column="PLE_ID" class="PlanEstudios" lazy="false" not-null="false"/>
  <many-to-one name="Institucion" column="INS_ID" class="Institucion" lazy="false"/>
  <many-to-one name="grupo" column="GRU_ID" class="Grupo" lazy="false" not-null="false"/>
  <property name="fechaVinculacion" column="INP_FECHA_VINCULACION" type="timestamp" />
  
 
 </class>
</hibernate-mapping>


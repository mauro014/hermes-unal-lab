<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="co.edu.unal.hermes.modelo">

	<class name="HistoricoEstadoLegalizacion" table="HER_HISTORICO_ESTADO_LEGALI">

		<id column="HEL_ID" name="id" type="long">
			<generator class="sequence">
				<param name="sequence">SEQ_HISTORICO_ESTADO_LEGALI</param>
			</generator>
		</id>
		
		<many-to-one name="proyecto" column="PRY_ID" class="Proyecto"
			not-null="true" />
		<many-to-one name="estadoProyecto" column="EPL_ID" class="EstadoProyecto"
			not-null="true" lazy="false" />
		
		<property name="fecha" column="HEL_FECHA" type="timestamp" />
		<property name="justificacion" column="HEL_JUSTIFICACION" />
		<many-to-one name="responsable" class="co.edu.unal.hermes.modelo.Persona"
			lazy="false">
			<column name="HEL_RESPONSABLE" />
			<column name="HER_TDO_ID" />
		</many-to-one>

	</class>
</hibernate-mapping>
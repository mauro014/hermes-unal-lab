<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="co.edu.unal.hermes.modelo">
	<class name="CorteConvocatoriaExterna" table="HER_CORTE_CONV_EXTERNA">
		<id name="id" column="CCE_ID" type="long">
			<generator class="sequence">
				<param name="sequence">SEQ_CORTE_CONV_EXTERNA</param>
			</generator>
		</id>

		<many-to-one name="convocatoriaExterna" class="ConvocatoriaExterna" column="CEX_ID"
			not-null="true" />
		<many-to-one name="sede" class="Sede" column="SED_ID"
			not-null="true" lazy="false"/>
		
		<property name="fechaLimite" column="CCE_FECHA_FINAL_SOL" />
		
	</class>
</hibernate-mapping>

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="co.edu.unal.hermes.modelo">
	<class name="SemilleroHistoricoInforme"
		table="HER_SEMILLERO_HIST_INFORME">
		<id name="id" column="SHI_ID" type="integer">
			<generator class="sequence">
				<param name="sequence">SEQ_SEMILLERO_HIST_INFORME</param>
			</generator>
		</id>
		<many-to-one name="informe" class="SemilleroInforme"
			column="SIN_ID" not-null="true" lazy="false" />
		<property name="fechaCompromiso"
			column="SHI_FECHA_COMPROMISO" type="date" />
		<property name="comentarios" column="SHI_COMENTARIOS"></property>
		<many-to-one name="responsable" class="Persona"
			not-null="true" lazy="false">
			<column name="INV_ID" />
			<column name="TDO_ID" />
		</many-to-one>
		<property name="fechaAjuste" column="SHI_FECHA_AJUSTE"
			type="date" />
		<many-to-one name="estado"
			class="SemilleroSolicitudRespuesta" not-null="true" lazy="false">
			<column name="SSR_ID" />
		</many-to-one>
	</class>
</hibernate-mapping>
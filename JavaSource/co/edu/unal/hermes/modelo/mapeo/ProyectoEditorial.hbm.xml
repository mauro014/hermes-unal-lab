<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="co.edu.unal.hermes.modelo">
	<class name="ProyectoEditorial" table="HER_PROYECTO_EDITORIAL">
		<id name="idProyecto" type="long">
			<column name="PRY_ID" />
			<generator class="foreign">
				<param name="property">proyecto</param>
			</generator>
		</id>
		<one-to-one name="proyecto" class="Proyecto"
			constrained="true"></one-to-one>
		<property name="tipoPublicacion"
			column="PRY_TIPO_PUBLICACION" />
		<property name="comitePuntaje" column="PRY_COMITE_PUNTAJE" />
		<property name="indicesAnaliticos"
			column="PRY_INDICES_ANALITICOS" />
		<property name="textoOtroIdioma"
			column="PRY_TEXTO_OTRO_IDIOMA" />
		<property name="otroIdioma" column="PRY_OTRO_IDIOMA" />
		<property name="materialGraficoBN"
			column="PRY_MATERIAL_GRAFICO_BN" />
		<property name="materialGraficoColor"
			column="PRY_MATERIAL_GRAFICO_COLOR" />
		<property name="materialGraficoAjeno"
			column="PRY_MATERIAL_GRAFICO_AJENO" />
		<property name="licenciaReproduccion"
			column="PRY_LICENCIA_REPRODUCCION" />
		<property name="origenProyecto"
			column="PRY_ORIGEN_PROYECTO" />
		<property name="otroOrigenProyecto"
			column="PRY_OTRO_ORIGEN_PROYECTO" />
		<property name="caracterProyecto"
			column="PRY_CARACTER_PROYECTO" />
		<property name="numeroAutores"
			column="PRY_NUMERO_AUTORES" />
		<property name="idGrupo"
			column="GRU_ID" />
		<property name="involucraGrupos"
			column="PRY_INVOLUCRA_GRUPOS" />
		<property name="aceptaTerminos"
			column="PRY_ACEPTA_TERMINOS" />
		<property name="breveDescripcionAudiencia"
			column="PRY_BREVE_DESCRIPCION_AUD" />
	</class>
</hibernate-mapping>
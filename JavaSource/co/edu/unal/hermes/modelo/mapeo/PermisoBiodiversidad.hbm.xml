<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
                                   
<hibernate-mapping package="co.edu.unal.hermes.modelo">
	<class name="PermisoBiodiversidad" table="HER_PERMISO_BIODIVERSIDAD">
		<id name="id" column="PEB_ID" type="long">
		
		</id>
		<property name="nombrePermiso" column="PEB_NOMBRE" type="string"/>
		<property name="tipoPermiso" column="PEB_TIPO" type="string"/>
		<property name="estado" column="PEB_ESTADO" type="string"/>
		<property name="mensajeResolucion" column="PEB_INFO_RESOLUCION" type="string"/>
		<property name="mensajeInclusionPermiso" column="PEB_INFO_INCLUSION" type="string"/>
		<property name="mensajeInfoAdicional" column="PEB_INFO_ADICIONAL" type="string"/>
		<property name="fechaInicio" column="PEB_FECHA_INICIO" type="date"/>
		<property name="fechaFin" column="PEB_FECHA_FIN" type="date"/>

	</class>
</hibernate-mapping>
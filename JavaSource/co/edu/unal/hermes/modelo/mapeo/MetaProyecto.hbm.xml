<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="co.edu.unal.hermes.modelo">
	<class name="MetaProyecto" table="HER_META_PROYECTO">
		
		<id name="id" column="MET_ID" type="long">
			<generator class="sequence">
				<param name="sequence">SEQ_META_PROYECTO</param>
			</generator>
		</id>
		
		<property name="nombre" column="MET_NOMBRE" />
		
		<many-to-one name="objetivo" class="ObjetivoEspecifico" column="OBJ_ID" not-null="true" />
		
		<property name="numeroOrden" column="MET_ORDEN" />
		
<!-- 		<many-to-one name="proyecto" class="Proyecto" column="PRY_ID" not-null="true" /> -->
		
	</class>
</hibernate-mapping>

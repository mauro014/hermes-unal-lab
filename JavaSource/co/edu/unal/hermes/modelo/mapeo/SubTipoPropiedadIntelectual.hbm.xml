<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 2.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="co.edu.unal.hermes.modelo">
	<class name="SubTipoPropiedadIntelectual" table="HER_PROPIEDAD_INT_SUBTIPO">
		<id name="id" column="PIS_ID" type="long">
		</id>
		
		<property name="nombre" column="PIS_NOMBRE" type="string"/>
		<property name="descripcion" column="PIS_DESCRIPCION" type="string"/>
		<property name="estado" column="PIS_ESTADO" type="string"/>
		<many-to-one name="tipo" class="TipoPropiedadIntelectual" column="PIT_ID" lazy="false"/>
		<property name="estadoGestor" column="PIS_ESTADO_GESTOR" type="string"/>
		
	</class>
</hibernate-mapping>
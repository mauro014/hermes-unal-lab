<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="co.edu.unal.hermes.modelo.laboratorios">

	<class name="LaboratorioProyectoEquipo" table="HER_LABORATORIO_PROYECTO_EQU">

		<id name="id" column="LPE_ID" type="long">
			<generator class="sequence">
				<param name="sequence">SEQ_LABORATORIO_PROYECTO_EQU</param>
			</generator>
		</id>

		<many-to-one name="laboratorio"
			class="co.edu.unal.hermes.modelo.laboratorios.Laboratorio" lazy="false">
			<column name="LAB_ID" />
		</many-to-one>
		
		<many-to-one name="proyecto"
			class="co.edu.unal.hermes.modelo.Proyecto" lazy="false">
			<column name="PRY_ID" />
		</many-to-one>
		
		<many-to-one name="equipo"
			class="co.edu.unal.hermes.modelo.laboratorios.LaboratorioDetalleEquipos" lazy="false">
			<column name="LDE_ID" />
		</many-to-one>

	</class>

</hibernate-mapping>
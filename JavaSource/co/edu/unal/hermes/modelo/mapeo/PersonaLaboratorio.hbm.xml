<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="co.edu.unal.hermes.modelo.laboratorios">

	<class name="PersonaLaboratorio" table="HER_PERSONA_LABORATORIO">

		<id name="id" column="HPL_ID" type="long">
			<generator class="sequence">
				<param name="sequence">SEQ_DETALLE</param>
			</generator>
		</id>

		<many-to-one name="persona" class="co.edu.unal.hermes.modelo.Persona"
			not-null="true" lazy="false">
			<column name="PER_ID" />
			<column name="TDO_ID" />
		</many-to-one>

		<many-to-one name="laboratorio" column="LAB_ID" class="Laboratorio"
			not-null="true" lazy="false" />

		<many-to-one name="rol" column="ROL_ID"
			class="co.edu.unal.hermes.modelo.Rol" not-null="true" lazy="false" />

		<property name="cargo" column="HPL_CARGO" />

		<many-to-one name="tipoVinculacion" class="co.edu.unal.hermes.modelo.Tipos"
			lazy="false">
			<column name="HPL_TIPO_VINCULACION" />
		</many-to-one>

		<property name="extension" column="HPL_EXTENSION" />
		<property name="permisoConsulta" column="HPL_CONSULTA" />
		<property name="permisoEdicion" column="HPL_EDICION" />
		<property name="fechaCreacion" column="HPL_FECHA_CREACION" />

	</class>

</hibernate-mapping>

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="co.edu.unal.hermes.modelo">

	<class name="ConvocatoriaPublicacionLibros" table="HER_CONV_PUBL_LIBROS">

		<id name="id" column="CPL_ID" type="long">
			<generator class="sequence">
				<param name="sequence">SEQ_PROYECTO</param>
			</generator>
		</id>

		<many-to-one name="investigador" class="Investigador"
			not-null="true" lazy="false">
			<column name="INV_ID" />
			<column name="TDO_ID" />
		</many-to-one>

		<property name="nombreLibro" column="CPL_NOMBRE_LIBRO" type="string"
			not-null="true" length="200" />

		<property name="fechaRegistro" column="CPL_FECHA_REGISTRO"
			not-null="true" />

	</class>
</hibernate-mapping>
<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="co.edu.unal.hermes.modelo">
 <class name="InvestigadorGrupo" table="HER_INVESTIGADOR_GRUPO">
  <id name="id" column="ING_ID" type="long">
   <generator class="sequence">
    <param name="sequence">SEQ_INVESTIGADOR_GRUPO</param>
   </generator>
  </id>
  
  <many-to-one name="grupo" class="Grupo" column="GRU_ID" not-null="true" lazy="false"/>
  <many-to-one name="investigador" class="Investigador" not-null="true" lazy="false">
  	<column name="INV_ID"/>
    <column name="TDO_ID"/>
  </many-to-one>
  
  <property name="tipo" column="ING_TIPO"/>
  <property name="funcion" column="ING_FUNCION"/>
  <property name="tipoVinculacion" column="ING_TIPO_VINCULACION"/>
  <many-to-one name="planEstudioEstudiante" class="PlanEstudios" column="EST_PLAN"
			lazy="false" />

 </class>
</hibernate-mapping>

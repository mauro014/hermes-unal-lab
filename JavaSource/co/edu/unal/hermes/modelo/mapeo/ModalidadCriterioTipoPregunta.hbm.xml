<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
                                   
<hibernate-mapping package="co.edu.unal.hermes.modelo">

 <class name="ModalidadCriterioTipoPregunta" table="HER_MODALIDAD_CRITERIO">
   
  <id column="ID" name="id" type="long">
  	<generator class="sequence">
         <param name="sequence">SEQ_MODALIDAD_CRITERIO</param>
    </generator>
  </id>

  <many-to-one name="modalidad" class="Modalidad" column="MOD_ID" not-null="true"/>
 <many-to-one name="tipoPregunta" class="TipoPregunta" column="TPP_ID" not-null="true" lazy="false"/>
 <many-to-one name="criterio" class="CriterioEvaluacion" column="CRI_ID" not-null="true" lazy="false"/>
 <property name="orden" column="MCR_ORDEN"/>
   
 </class> 
</hibernate-mapping>
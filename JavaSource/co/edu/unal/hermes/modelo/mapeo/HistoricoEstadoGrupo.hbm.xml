<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="co.edu.unal.hermes.modelo">

	<class name="HistoricoEstadoGrupo" table="HER_HISTORICO_ESTADO_GRUPO">
		<id column="HEG_ID" name="id" type="long">
			<generator class="sequence">
				<param name="sequence">SEQ_HISTORICO_ESTADO_GRUPO</param>
			</generator>
		</id>

		<property name="fecha" column="HEG_FECHA" type="timestamp" />

		<many-to-one name="grupo" column="GRU_ID" class="Grupo"
			not-null="true" />

		<many-to-one name="estadoGrupo" column="EGR_ID" class="EstadoGrupo"
			not-null="false" lazy="false" />

		<many-to-one name="estadoGrupoColciencias" column="EGC_ID"
			class="EstadoGrupoColciencias" not-null="false" lazy="false" />

		<many-to-one name="responsable" class="co.edu.unal.hermes.modelo.Persona"
			lazy="false">
			<column name="HEG_PER_ID" />
			<column name="HEG_TDO_ID" />
		</many-to-one>

		<property name="justificacion" column="HEG_JUSTIFICACION" />
		<property name="archivoCambio" column="HEG_ARCHIVO" />
		

	</class>
</hibernate-mapping>
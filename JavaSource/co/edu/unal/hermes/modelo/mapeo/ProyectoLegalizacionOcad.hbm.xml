<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="co.edu.unal.hermes.modelo">
	<class name="ProyectoLegalizacionOcad" table="HER_PROYECTO_LEG_OCAD">
		<id name="id" column="PLO_ID" type="long">
			<generator class="sequence">
				<param name="sequence">SEQ_PROYECTO_LEG_OCAD</param>
			</generator>
		</id>
		<property name="idProyecto" column="PRY_ID" type="long"/>
		<property name="codigoSigp" column="PLO_COD_SIGP" />
		<property name="codigoBpin" column="PLO_COD_BPIN" />
		<property name="ocadAprobo" column="PLO_OCAD_APRUEBA" />
		<property name="numeroAprobacionOcad" column="PLO_NUM_APROB_OCAD" />
		<property name="fechaAprobacionOcad" column="PLO_FECHA_APRUEBA" type="date" />
		<property name="nombreSupervisor" column="PLO_NOMBRE_SUPERVISOR"/>
		<property name="tieneProyectoExtension" column="PLO_TIENE_PRY_EXTENSION" />
		<property name="codigoProyectoExtension" column="PLO_COD_PRT_EXTENSION" />
		<property name="valorAprobadoSgr" column="PLO_VALOR_APROB_SGR" />
		<property name="valorOtraFinanciacion" column="PLO_VALOR_APROB_OTRA_FIN" />
		<property name="valorParticipantes" column="PLO_VALOR_PARTICIPANTES" />
		<property name="rolUniversidad" column="PLO_ROL_UNIVERSIDAD" />
		<property name="entidadEjecutora" column="FFI_ID_EJECUTORA"/>

		<many-to-one name="directorProyecto" class="Persona"
			lazy="false">
			<column name="PER_ID_DIRECTOR" />
			<column name="TDO_ID_DIRECTOR" />
		</many-to-one>
	</class>
</hibernate-mapping>
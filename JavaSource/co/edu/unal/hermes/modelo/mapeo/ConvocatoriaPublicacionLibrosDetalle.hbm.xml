<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="co.edu.unal.hermes.modelo">

	<class name="ConvocatoriaPublicacionLibrosDetalle" table="HER_CONV_PUBL_LIBROS_DETALLE">

		<id name="id" column="CPLD_ID" type="long">
			<generator class="sequence">
				<param name="sequence">SEQ_DETALLE</param>
			</generator>
		</id>

		<property name="convocatoriaPublicacionLibros" column="CPL_ID"
			type="long" not-null="true" />

		<property name="autor" column="CPLD_AUTOR" type="string"
			not-null="true" length="83" />

		<property name="identificacion" column="CPLD_IDENTIFICACION"
			type="string" not-null="true" length="15" />

		<property name="tipoDocumento" column="TDO_ID"
			type="string" not-null="true" length="2" />

		<property name="universidad" column="CPLD_UNIVERSIDAD" type="string"
			not-null="true" length="100" />

		<property name="facultadDependencia" column="CPLD_FACULTAD_DEPENDENCIA"
			type="string" not-null="true" length="200" />

		<property name="email" column="CPLD_EMAIL" type="string"
			not-null="true" length="60" />

		<property name="direccion" column="CPLD_DIRECCION" type="string"
			not-null="true" length="150" />

		<property name="telefono" column="CPLD_TELEFONO" type="string"
			not-null="true" length="36" />

		<property name="fechaRegistro" column="CPLD_FECHA_REGISTRO"
			not-null="true" />

	</class>
</hibernate-mapping>
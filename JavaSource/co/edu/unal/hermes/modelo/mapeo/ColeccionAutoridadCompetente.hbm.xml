<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="co.edu.unal.hermes.modelo">
	<class name="ColeccionAutoridadCompetente" table="HER_COLECCION_AUTORIDAD">
		<id name="id" column="COA_ID" type="long">
			<generator class="sequence">
				<param name="sequence">SEQ_COLECCION_AUTORIDAD</param>
			</generator>
		</id>
		<many-to-one name="autoridad" class="FuenteFinanciacion"
			column="FFI_ID" not-null="true" lazy="false" />
			
		<many-to-one name="estado" class="DominioDetalle" lazy="false">
			<column name="DOM_ID" />
			<column name="DOMDET_TIPO" />
		</many-to-one>

		<property name="idColeccion" column="COL_ID" />
		<property name="fechaActualizacion" column="COA_FECHA" />
		<property name="numeroRegistro" column="COA_NRO_REGISTRO" />
		
			
		 
	</class>
</hibernate-mapping>

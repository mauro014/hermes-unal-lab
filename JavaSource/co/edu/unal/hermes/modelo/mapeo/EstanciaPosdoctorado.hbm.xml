<?xml version="1.0" encoding="UTF-8"?>


<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="co.edu.unal.hermes.modelo">
 <class name="EstanciaPosdoctorado" table="HER_PROGRAMA_POSDOCTORADO">
    
  <id name="id" column="POD_ID" type="long" unsaved-value="-1">
   <generator class="sequence">
    <param name="sequence">SEQ_PROYECTO</param>
   </generator> 
  </id>	
  
  <property name="esAlianza" column="POD_ES_ALIANZA"/> 
  <property name="modalidad" column="POD_MODALIDAD"/>   	
  <property name="justificacion" column="POD_JUSTIFICACION"/>  
  <property name="mecanismos" column="POD_MECANISMOS"/>
  <property name="nombrePropuesta" column="POD_NOMBRE_PROPUESTA"/>
  <property name="estado" column="POD_ESTADO"/>
  <property name="etapa" column="POD_ETAPA"/>
  
  <property name="gastoSolicitado" column="POD_GASTO_SOLICITADO"/>
  <property name="gastoMensual" column="POD_GASTO_MENSUAL"/>
  <property name="gastoSubtotal" column="POD_GASTO_SUBTOTAL"/>  
  <property name="gastoPoliza" column="POD_GASTO_POLIZA"/>
  <property name="gastoDomicilio" column="POD_GASTO_DOMICILIO"/>
  <property name="gastoIdioma" column="POD_GASTO_IDIOMA"/>
  <property name="gastoTiquetes" column="POD_GASTO_TIQUETES"/>
  <property name="gastoMeses" column="POD_GASTO_MESES"/>
  
  <property name="fechaRegistro" column="POD_FECHA_REGISTRO"/>		  
  <property name="perfil" column="POD_PERFIL"/>
  <property name="convocatoria" column="MOD_ID"/>
  <property name="programa" column="PPS_ID"/>		 		
  
    
  <property name="item1" column="POD_ITEM_UNO"/>		  
  <property name="item2" column="POD_ITEM_DOS"/>
  <property name="item3" column="POD_ITEM_TRES"/>
  <property name="valor1" column="POD_VALOR_UNO"/>
   <property name="valor2" column="POD_VALOR_DOS"/>		  
  <property name="valor3" column="POD_VALOR_TRES"/>
  <property name="valorFacultad" column="POD_VALOR_FACULTAD"/>
  
  <property name="fechaPrimerInforme" column="POD_FECHA_PRIMER_INFORME"/>
  <property name="fechaSegundoInforme" column="POD_FECHA_SEGUNDO_INFORME"/>
  
  <property name="observacionesActividadesSeguimientoUno" column="POD_OBSERV_ACTI_UNO"/>
  <property name="observacionesActividadesSeguimientoDos" column="POD_OBSERV_ACTI_DOS"/>
  <property name="conceptoDireccionInformeUno" column="POD_CONCEPTO_DIR_UNO"/>  
  <property name="conceptoDireccionInformeDos" column="POD_CONCEPTO_DIR_DOS"/>
  <property name="fortalecimiento" column="POD_FORTALECIMIENTO"/>  
  <property name="logros" column="POD_LOGROS"/>
  <property name="dificultades" column="POD_DIFICULTADES"/>  
  <property name="sugerencias" column="POD_SUGERENCIAS"/>
  
  <property name="conceptoFacultadInformeUno" column="POD_CONCEPTO_FAC_UNO"/>  
  <property name="conceptoFacultadInformeDos" column="POD_CONCEPTO_FAC_DOS"/>
  
  <property name="avalDireccionInformeUno" column="POD_AVAL_SEG_DIR_UNO"/>  
  <property name="avalDireccionInformeDos" column="POD_AVAL_SEG_DIR_DOS"/>
  
  <property name="avalFacultadInformeUno" column="POD_AVAL_SEG_FAC_UNO"/>  
  <property name="avalFacultadInformeDos" column="POD_AVAL_SEG_FAC_DOS"/>
  
  <property name="fechaPrimerInformeFacultad" column="POD_FECHA_FAC_INF_UNO"/>
  <property name="fechaSegundoInformeFacultad" column="POD_FECHA_FAC_INF_DOS"/>
  
  <property name="fechaPrimerInformeDireccion" column="POD_FECHA_DIR_INF_UNO"/>
  <property name="fechaSegundoInformeDireccion" column="POD_FECHA_DIR_INF_DOS"/>
  	
    
  <many-to-one name="personaInv" class="Persona" not-null="false" lazy="false">
	<column name="PER_ID"/>
    <column name="TDO_ID"/>
  </many-to-one>        
  <many-to-one name="grupo" class="Grupo" not-null="false" lazy="false">
		  	<column name="GRU_ID"/>
  </many-to-one>  
  
  <set name="archivos" table="HER_ARCHIVO_POSDOCTORADO" cascade="all-delete-orphan" fetch="join">
	    <key column="POD_ID"/>
	    <one-to-many class="ArchivoPosdoctorado"/>
  </set>
  
    <set name="financiacion" table="HER_FINANCIACION_POSDOCTORADO" cascade="all-delete-orphan" fetch="join">
	    <key column="POD_ID"/>
	    <one-to-many class="FinanciacionPosdoctorado"/>
  </set>
  
  
  <set name="actividades" table="HER_ACTIVIDAD_POSDOCTORADO" cascade="all-delete-orphan" fetch="join">
	    <key column="POD_ID"/>
	    <one-to-many class="ActividadPosdoctorado"/>
  </set>
  
  <set name="candidatos" table="HER_CANDIDATO_POSDOCTORADO" cascade="all-delete-orphan" fetch="join">
	    <key column="POD_ID"/>
	    <one-to-many class="CandidatoPosdoctorado"/>
  </set>
  
    <set name="grupos" table="HER_GRUPO_POSDOCTORADO" cascade="all-delete-orphan" fetch="join">
	    <key column="POD_ID" />
	    <one-to-many class="GrupoPosdoctorado"/>
  </set>
    
 </class>
</hibernate-mapping>

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="co.edu.unal.hermes.modelo">
	<class name="TipoMovilidad" table="HER_TIPO_MOVILIDAD">
		<id name="id" column="MOV_ID_TIPO" type="string">
			<generator class="assigned" />
		</id>
		<property name="nombre" column="MOV_NOMBRE" />
		<property name="tabla" column="MOV_TABLA" />
		<property name="nombreVista" column="MOV_NOMBRE_VISTA" />
		<property name="esPasantia" column="MOV_ES_PASANTIA" />
	</class>
</hibernate-mapping>

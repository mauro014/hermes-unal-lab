<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="co.edu.unal.hermes.modelo">
	<class name="ProyectoPrograma" table="HER_PROYECTO_PROGRAMA">

		<id name="id" column="PRY_PRG_ID" type="long" unsaved-value="-1">
			<generator class="sequence">
				<param name="sequence">SEQ_PROYECTO_PROGRAMA</param>
			</generator>
		</id>

		<property name="nombre" column="PRY_PRG_NOMBRE" />
		<many-to-one name="fuente" column="FFI_ID" class="FuenteFinanciacion" not-null="true" lazy="false" />
		<many-to-one name="dependencia" class="co.edu.unal.hermes.modelo.Dependencia" column="DPN_ID" lazy="false" />
		<many-to-one name="proyecto" column="PRY_ID" class="Proyecto" not-null="true" />

	</class>
</hibernate-mapping>




<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
                                                                     
<hibernate-mapping package="co.edu.unal.hermes.modelo">

 <class name="ProductoTipo" table="HER_PRODUCTO_TIPO">
  
  <id column="PRD_ID" name="id" type="string">
	<generator class="sequence">
	  <param name="sequence">SEQ_PRODUCTO_TIPO</param>
	</generator>
  </id>
  
  <many-to-one name="padre" class="ProductoTipo" column="PRD_INCLUIDA_EN" lazy="false"/>
  
  <property name="nombre" column="PRD_NOMBRE"/> 
  <property name="nivel" column="PRD_NIVEL"/> 
  <property name="descripcion" column="PRD_DESCRIPCION"/> 
  <property name="estado" column="PRD_ESTADO"/> 
  
 </class> 
</hibernate-mapping>

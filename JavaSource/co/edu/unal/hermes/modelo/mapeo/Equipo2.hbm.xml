<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="co.edu.unal.hermes.modelo">
 <class name="Equipo2" table="HER_EQUIPO2">
  <id name="id" column="ID" type="long">
   <generator class="sequence">
    <param name="sequence">SEQ_EQUIPO</param>
   </generator>
  </id>
  <property name="nombreEquipo" column="NOMBRE_EQUIPO"/>
  <property name="marca" column="MARCA"/>
  <property name="modelo" column="MODELO"/>
  <property name="numeroSerie" column="NO_SERIE"/>
  <property name="placa" column="PLACA"/>
  <property name="fechaCompra" column="FECHA_COMPRA"/>
  <property name="proveedor" column="PROVEEDOR"/>
  <many-to-one name="poseeGarantia" class="Tipos" column="POSEE_GARANTIA" not-null="false" lazy="false"/>
  <property name="fechaVencimientoGarantia" column="FECHA_VENCIMIENTO_GARANTIA"/>
  <many-to-one name="poseeLicenciaFuncionamiento" class="Tipos" column="POSEE_LICENCIA_FUNCIONAMIENTO" not-null="false" lazy="false"/>
  <property name="licenciaExpedidaPor" column="LICENCIA_EXPEDIDA_POR" />
  <property name="valorCompra" column="VALOR_DE_COMPRA"/>  
  <many-to-one name="monedaExtranjera" class="Tipos" column="MONEDA_EXTRANJERA" not-null="false" lazy="false"/>
  <many-to-one name="tipoDocumentoFuncionario" class="TipoDocumento" column="TIPO_DOC_ID_FUNCIONARIO_ASIG" not-null="false" lazy="false"/>
  <property name="documentoFuncionarioAsignado" column="DOC_FUNCIONARIO_ASIGNADO"/>
  <property name="nombreFuncionarioAsignado" column="NOMBRE_FUNCIONARIO_ASIGNADO"/>
  <property name="cargoFuncionarioAsignado" column="CARGO_FUNCIONARIO_ASIGNADO"/>
  <property name="telefonoFuncionarioAsignado" column="TELEFONO_FUNCIONARIO_ASIGNADO"/>
  <property name="extencionFuncionarioAsignado" column="EXTENCION_FUNCIONARIO_ASIGNADO"/>
  <property name="faxFuncionarioAsignado" column="FAX_FUNCIONARIO_ASIGNADO"/>
  <many-to-one name="sedeFuncionarioAsignado" class="Sede" column="ID_SEDE_FUNCIONARIO_ASIGNADO" not-null="false" lazy="false"/>
  <many-to-one name="edificioFuncionarioAsignado" class="Edificio" column="ID_EDIFICIO_FUNCIONARIO_ASIGNA" not-null="false" lazy="false"/>
  <property name="salonFuncionarioAsignado" column="SALON_FUNCIONARIO_ASIGNADO"/>
  <property name="laboratorioFuncionarioAsignado" column="LABORATORIO_FUNCIONARIO_ASIGNA"/>
  <many-to-one name="poseeDocumentacion" class="Tipos" column="POSEE_DOCUMENTACION" not-null="false" lazy="false"/>  
  <many-to-one name="estadoEquipo" class="Tipos" column="ID_ESTADO_EQUIPO" not-null="false" lazy="false"/>
  <many-to-one name="tipoMantenimiento" class="Tipos" column="ID_TIPO_MANTENIMIENTO" not-null="false" lazy="false"/>
  <property name="numeroUsuariosPregrado" column="NUMERO_DE_USUARIOS_PREGRADO"/>
  <property name="numeroUsuariosMaestria" column="NUMERO_DE_USUARIOS_MAESTRIA"/>
  <property name="numeroUsuariosDoctorado" column="NUMERO_DE_USUARIOS_DOCTORADO"/>
  <many-to-one name="frecuenciaMantenimiento" class="Tipos" column="ID_FRECUENCIA_MANTENIMIENTO" not-null="false" lazy="false"/>
  <many-to-one name="requiereMantenimientoEspecializado" class="Tipos" column="MANTENIMIENTO_ESPECIALIZADO" not-null="false" lazy="false"/>
  <many-to-one name="tipoMantenimientoEspecializado" class="Tipos" column="ID_TIPO_MANTENIMIENTO_ESPECIA" not-null="false" lazy="false"/>
  <many-to-one name="tipoDocumentoPersonaMantenimiento" class="TipoDocumento" column="ID_TIPO_DOC_PERSONA_MANTENIMIE" not-null="false" lazy="false"/>
  <property name="documentoPersonaMantenimiento" column="DOCUMENTO_PERSONA_MANTENIMIENT"/>
  <many-to-one name="dependenciaMantenimiento" class="Dependencia" column="ID_DEPENDENCIA_MANTENIMIENTO" not-null="false" lazy="false"/>
  <property name="observacionesGenerales" column="OBSERVACIONES_GENERALES"/>
  <many-to-one name="proyecto" class="Proyecto" column="PRY_ID" not-null="true" lazy="false"/>
  <set name="tiposEquipo" table="Her_equipo_equipo_tipo" cascade="all-delete-orphan" lazy="false">
   <key column="EQU_ID"/>
   <many-to-many class="Tipos" column="EQT_TIPOS_ID"/>
  </set>
  <set name="documentacionEquipo" table="HER_EQUIPO_TIPOS_DOCUMENTACION" cascade="all-delete-orphan" lazy="false">
   <key column="EQU_ID"/>
   <many-to-many class="Tipos" column="TIPO_ID"/>
  </set>
  
  
 </class>
</hibernate-mapping>

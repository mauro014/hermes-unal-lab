<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="co.edu.unal.hermes.modelo">
	<class name="SemilleroGrupo" table="HER_SEMILLERO_GRUPO">
		<composite-id>
			<key-many-to-one name="semillero" class="Semillero"
				column="SEM_ID" lazy="false">
			</key-many-to-one>
			<key-many-to-one name="grupo" class="Grupo"
				lazy="false" column="GRU_ID">
			</key-many-to-one>
		</composite-id>
		<property name="fechaRegistro" column="SGR_FECHA_REGISTRO" />
		<property name="fechaBorrado" column="SGR_FECHA_BORRADO" />
		<property name="agregoSemillero" column="SGR_AGREGA" />
		
		<many-to-one name="responsable" class="co.edu.unal.hermes.modelo.Persona"
			lazy="false">
			<column name="PER_ID" />
			<column name="TDO_ID" />
		</many-to-one>
	</class>
</hibernate-mapping>
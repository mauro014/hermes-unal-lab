<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="co.edu.unal.hermes.modelo">
	<class name="SemilleroSolicitudRespuesta"
		table="HER_SEMILLERO_SOL_RESPUESTA">
		<id name="id" column="SSR_ID" type="integer">
			<generator class="assigned" />
		</id>
		<property name="nombre" column="SSR_NOMBRE" />
		<property name="estadoUAB" column="SSR_ESTADO_UAB" />
		<property name="estadoVif" column="SSR_ESTADO_VIF" />
		<property name="estadoDi" column="SSR_ESTADO_DI" />
		<property name="estadoCoordinador" column="SSR_ESTADO_COORD" />
	</class>
</hibernate-mapping>
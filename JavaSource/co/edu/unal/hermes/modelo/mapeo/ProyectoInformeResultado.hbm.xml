<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="co.edu.unal.hermes.modelo">
	<class name="ProyectoInformeResultado" table="HER_PROYECTO_INFORME_RESULTADO">
		<id name="id" column="PIR_ID" type="long">
			<generator class="sequence">
				<param name="sequence">SEQ_PROYECTO_INFORME_RESULTADO</param>
			</generator>
		</id>

		<many-to-one name="informe" class="ProyectoInforme" column="PIN_ID"
			not-null="true" />
		<many-to-one name="resultado" class="ResultadoProyecto" column="RST_ID"
			not-null="true" lazy="false"/>
		
		<property name="justificacion" column="PIR_JUSTIFICACION" />
		<property name="seEntrega" column="PIR_ENTREGADO" type="yes_no"/>
		<property name="fechaRealEntrega" column="PIR_FECHA_ENTREGA" />
		<property name="comentariosCoordinador" column="PIR_COMENTARIOS_COORDINADOR" />
		
	</class>
</hibernate-mapping>

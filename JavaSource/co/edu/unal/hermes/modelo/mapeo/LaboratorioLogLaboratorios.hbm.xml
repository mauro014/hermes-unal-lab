<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="co.edu.unal.hermes.modelo.laboratorios">

	<class name="LaboratorioLogLaboratorios" table="HER_LABORATORIO_LOG_LAB">

		<id name="id" column="LLL_ID" type="long">
			<generator class="sequence">
				<param name="sequence">SEQ_LABORATORIO_LOG_LAB</param>
			</generator>
		</id>

		<many-to-one name="laboratorio"
			class="co.edu.unal.hermes.modelo.laboratorios.Laboratorio" lazy="false">
			<column name="LAB_ID" />
		</many-to-one>
		
		<many-to-one name="responsable" class="co.edu.unal.hermes.modelo.Persona"
			not-null="true" lazy="false">
			<column name="PER_ID" />
			<column name="TDO_ID" />
		</many-to-one>

		<many-to-one name="tipoOperacion" class="co.edu.unal.hermes.modelo.Tipos"
			column="LLL_TIPO_OPERACION" lazy="false" />
		
		<property name="fechaRegistro" column="LLL_FECHA_REGISTRO" />

	</class>

</hibernate-mapping>
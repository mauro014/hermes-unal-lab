<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="co.edu.unal.hermes.modelo">
	<class name="SemilleroArchivo" table="HER_SEMILLERO_ARCHIVO">
		<id name="id" column="SAR_ID" type="integer">
			<generator class="sequence">
				<param name="sequence">SEQ_SEMILLERO_ARCHIVO</param>
			</generator>
		</id>
		<many-to-one name="semillero" class="Semillero"
			column="SEM_ID" lazy="false" />
		<property name="nombre" column="SAR_NOMBRE" />
	</class>
</hibernate-mapping>
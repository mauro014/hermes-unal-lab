<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="co.edu.unal.hermes.modelo.laboratorios">
	<class name="LaboratorioEnsayoEquipo" table="HER_LABORATORIO_ENSAYO_EQUIPOS">
		<composite-id>
			<key-many-to-one name="servicio"
				class="LaboratorioDetalleEnsayosServicios" column="LDENS_ID" lazy="false" />
			<key-many-to-one name="equipo" class="LaboratorioDetalleEquipos"
				column="LDE_ID" lazy="false" />
		</composite-id>
		<property name="tiempoUsoMinutos" column="HLEE_TIEMPO_USO_MINUTOS" />
	</class>
</hibernate-mapping>
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="co.edu.unal.hermes.modelo">
	<class name="SemilleroInformeResultado"
		table="HER_SEMILLERO_INF_RESULTADO">
		<id name="id" column="SER_ID" type="integer">
			<generator class="sequence">
				<param name="sequence">SEQ_SEMILLERO_INF_RESULTADO</param>
			</generator>
		</id>
		<many-to-one name="informe" class="SemilleroInforme"
			column="SIN_ID" lazy="false" />
		<many-to-one name="resultado" class="SemilleroResultado"
			lazy="false">
			<column name="SEM_ID"></column>
			<column name="SRE_RESULTADO"></column>
		</many-to-one>
		<many-to-one name="producto" class="ProductoTipo"
			column="PRD_ID" lazy="false" />
		<property name="avanceResultado" column="SRE_AVANCE" />
		<property name="nombreProducto" column="SRE_NOMBRE_PRODUCTO" />
		<property name="lugarDeposito" column="SRE_LUGAR_DEPOSITO" />
		<property name="fechaEntrega" column="SRE_FECHA_ENTREGA"
			type="date" />
		<property name="proteccion" column="SRE_PROTECCION" />
	</class>
</hibernate-mapping>
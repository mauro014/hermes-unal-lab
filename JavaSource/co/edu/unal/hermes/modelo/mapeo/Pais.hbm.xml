<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="co.edu.unal.hermes.modelo">
 <class name="Pais" table="HER_PAIS">
  <id name="id" column="PAIS_ID" type="string">
   <generator class="assigned"/>
  </id>
  <property name="nombre" column="PAIS_NOMBRE"/>
  <property name="sigla" column="PAIS_SIGLA"/>
  <property name="continente" column="PAIS_CONTINENTE"/>
 </class>
</hibernate-mapping>

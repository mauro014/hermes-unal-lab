<?xml version="1.0" encoding="UTF-8"?>


<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<!--
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "D:\hermes\dtds\hibernate-mapping-3.0.dtd">
-->

<hibernate-mapping package="co.edu.unal.hermes.modelo">
 <class name="MaterialBibliografico" table="HER_MATERIAL_BIBLIOGRAFICO">
    
  <id name="id" column="MBI_ID" type="long" unsaved-value="-1">
   <generator class="sequence">
    <param name="sequence">SEQ_MATERIAL_BIBLIOGRAFICO</param>
   </generator> 
  </id>
    
  <property name="titulo" column="MBI_TITULO"/>
  <property name="autor" column="MBI_AUTOR"/>
  <property name="codigo" column="MBI_CODIGO"/>
  <property name="edicion" column="MBI_EDICION"/>
  <property name="anoEntero" column="MBI_ANO"/>
  <property name="editorial" column="MBI_EDITORIAL"/>  
  <property name="cantidadEntero" column="MBI_CANTIDAD"/>  
  <property name="aval" column="MBI_AVAL"/>  
  <property name="avalDescripcion" column="MBI_AVAL_DESCRIPCION"/>  
   <property name="proyecto" column="PRY_ID"/>  
 
  
  <many-to-one name="curricular" class="Persona" not-null="false">
		  	<column name="PER_ID_CUR"/>
    		<column name="PER_ID_CUR_TDO"/>
  </many-to-one>	
   
  <many-to-one name="profesor" class="Persona" not-null="false">
		  	<column name="PER_ID_SOL"/>
    		<column name="PER_ID_SOL_TDO"/>
  </many-to-one>  
  
   <property name="fechaRegistro" column="MBI_FECHA_REGISTRO" />  
 
 </class>
</hibernate-mapping>

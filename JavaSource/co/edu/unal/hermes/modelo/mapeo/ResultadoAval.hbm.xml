<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="co.edu.unal.hermes.modelo">
	<class name="ResultadoAval" table="HER_AVAL_RESULTADO">
		<id name="id" column="AVI_RST_ID" type="long">
			<generator class="sequence">
				<param name="sequence">SEQ_RESULTADO_AVAL</param>
			</generator>
		</id>
		<property name="descripcion" column="RST_DESCRIPCION" />
		<many-to-one name="aval" class="Aval" column="AVI_ID"
			not-null="true" />
	</class>
</hibernate-mapping>

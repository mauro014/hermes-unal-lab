<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="co.edu.unal.hermes.modelo">
 <class name="EstadoProyecto" table="HER_ESTADO_PROYECTO">
  <id name="id" column="EPR_ID" type="string">
   <generator class="assigned"/>
  </id>
  <property name="nombre" column="EPR_NOMBRE"/>
  <property name="numero" column="EPR_ORDEN"/>
 </class>
</hibernate-mapping>

<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="co.edu.unal.hermes.modelo">
	<class name="ColeccionCatalogacion" table="HER_COLECCION_CATALOGACION">
		<id name="id" column="COC_ID" type="long">
			<generator class="sequence">
				<param name="sequence">SEQ_COLECCION_CATALOGACION</param>
			</generator>
		</id>
		<many-to-one name="coleccion" class="Coleccion"
			column="COL_ID" not-null="true" lazy="false" />
			
		<many-to-one name="grupoBiologico" class="DominioDetalle" lazy="false">
			<column name="DOM_ID" />
			<column name="DOMDET_TIPO" />
		</many-to-one>
		
		<many-to-one name="subGrupoBiologico" class="DominioDetalle" lazy="false">
			<column name="DOM_ID_SUBG" />
			<column name="DOMDET_TIPO_SUBG" />
		</many-to-one>

		<property name="ejemplaresCatalogados" column="COC_EJEM_CATALOG" />
		<property name="ejemplaresSistematizados" column="COC_EJEM_SIST" />
		<property name="ejemplaresIdentificadosFilum" column="COC_EJEM_FILUM" />
		<property name="ejemplaresIdentificadosOrden" column="COC_EJEM_IDENTORDEN" />
		<property name="ejemplaresIdentificadosFamilia" column="COC_EJEM_IDENTFAMILIA" />
		<property name="ejemplaresIdentificadosGenero" column="COC_EJEM_IDENTGENERO" />
		<property name="ejemplaresIdentificadosEspecie" column="COC_EJEM_IDENTESPECIE" />
		<property name="numeroEjemplares" column="COC_EJEMPLARES" />
		
		
		
		<property name="grupoNoBiologico" column="COC_GRUPO_NO_BIOLOGICO" />
		<property name="subGrupoNoBiologico" column="COC_SUBGRUPO_NO_BIO" />
		<property name="unidadMedidaNoBiologico" column="COC_UNIDAD_MEDIDA_NO_BIO" />
		<property name="numeroEjemplaresNoBiologico" column="COC_EJEMPLARES_NO_BIO" />

		 
	</class>
</hibernate-mapping>

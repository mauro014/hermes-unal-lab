<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 2.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="co.edu.unal.hermes.modelo">
 <class name="Vigencia" table="HER_VIGENCIA">
  <id name="id" column="VIG_ID" type="long">
   <generator class="sequence">
    <param name="sequence">SEQ_VIGENCIA</param>
   </generator>
  </id>
  <property name="vigencia" type="short" column="VIG_VIGENCIA"/>
  <property name="valor" type="long" column="VIG_VALOR"/>
  <many-to-one name="proyecto" class="Proyecto" column="PRY_ID" not-null="true"/>
 </class>
</hibernate-mapping>

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="co.edu.unal.hermes.modelo">
	<class name="SemilleroSolicitudTipo"
		table="HER_SEMILLERO_SOLICITUD_TIPO">
		<id name="id" column="SST_ID" type="integer">
			<generator class="assigned" />
		</id>
		<property name="nombre" column="SST_NOMBRE" />
		<property name="estado" column="SST_ESTADO" />
	</class>
</hibernate-mapping>
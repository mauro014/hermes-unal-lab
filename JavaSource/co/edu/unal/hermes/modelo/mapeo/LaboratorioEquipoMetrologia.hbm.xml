<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="co.edu.unal.hermes.modelo.laboratorios">

	<class name="LaboratorioEquipoMetrologia" table="HER_LABORATORIO_EQUIPO_METROL">

		<id name="id" column="LEQM_ID" type="long">
			<generator class="sequence">
				<param name="sequence">SEQ_DETALLE</param>
			</generator>
		</id>

		<many-to-one name="equipo"
			class="co.edu.unal.hermes.modelo.laboratorios.LaboratorioDetalleEquipos"
			column="LDE_ID" lazy="false" />

		<property name="magnitud" column="LEQM_MAGNITUD" />

		<many-to-one name="tipoMagnitud" class="co.edu.unal.hermes.modelo.Tipos"
			column="LQEM_MAGNITUD_ID" lazy="false" />

		<property name="unidad" column="LEQM_UNIDAD" />

		<property name="rangoMedicion" column="LEQM_RANGO_MEDICION" />

		<property name="divisionEscala" column="LEQM_DIVISION_ESCALA" />

		<many-to-one name="frecuenciaVerificacion" class="co.edu.unal.hermes.modelo.Tipos"
			column="LEQM_FREC_VERIF" lazy="false" />

		<many-to-one name="frecuenciaCalibracion" class="co.edu.unal.hermes.modelo.Tipos"
			column="LEQM_FREC_CALIBR" lazy="false" />

		<property name="fechaRegistro" column="LEQM_FECHA_REGISTRO" />
		
		<property name="equipoAltaPrecision" column="LEQM_EQUIPO_ALTA_PRECISION" />
		<property name="precisionValor" column="LEQM_PRECISION" />
		<property name="equipoAltaExactitud" column="LEQM_EQUIPO_ALTA_EXACTITUD" />
		<property name="exactitudValor" column="LEQM_EXACTITUD" />
		<property name="incertidumbre" column="LEQM_INCERTIDUMBRE" />
		<property name="errorMaximo" column="LEQM_ERROR_MAXIMO" />

	</class>

</hibernate-mapping>
<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="co.edu.unal.hermes.modelo">
	<class name="ColeccionTipoObjeto" table="HER_COLECCION_TIPO_OBJETO">
		<id name="id" column="CTO_ID" type="long">
			<generator class="sequence">
				<param name="sequence">SEQ_COLECCION_TIPO_OBJ</param>
			</generator>
		</id>
		<many-to-one name="coleccion" class="Coleccion"
			column="COL_ID" not-null="true" lazy="false" />
			
		<many-to-one name="tipoObjeto" class="DominioDetalle" lazy="false">
			<column name="DOM_ID" />
			<column name="DOMDET_TIPO" />
		</many-to-one>
		
		<many-to-one name="subTipoObjeto" class="DominioDetalle" lazy="false">
			<column name="DOM_ID_SUBTIPO" />
			<column name="DOMDET_TIPO_SUBTIPO" />
		</many-to-one>

		<property name="fechaAgregado" column="CTO_FECHA" />	
		 
	</class>
</hibernate-mapping>

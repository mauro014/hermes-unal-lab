<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
                                                                     
<hibernate-mapping package="co.edu.unal.hermes.modelo">

 <class name="ModuloCursoEscuela" table="HER_MODULO_CURSO_ESCUELA">
  
  <id column="MCE_ID" name="id" type="string">
	<generator class="assigned"/>
  </id>
  
  <many-to-one name="padre" class="ModuloCursoEscuela" column="MCE_PADRE" lazy="false"/>
  <property name="nombre" column="MCE_NOMBRE"/> 
  
  <property name="tipo" column="MCE_TIPO" type="string"/> 
   
  <property name="curso" column="MCE_CURSO" type="string"/> 
  <property name="modulo" column="MCE_MODULO" type="string"/> 
  <property name="tipoEstudiante" column="MCE_TIPO_ESTUDIANTE" type="string"/> 
     
  <property name="fechaInicial" column="MCE_FECHA_INI" type="date"/> 
  <property name="fechaFinal" column="MCE_FECHA_FIN" type="date"/> 
  <property name="valor" column="MCE_VALOR" type="string"/> 
  
  <property name="completo" column="MCE_COMPLETO" type="string"/> 
  <property name="dominio" column="DOMDET_ID"/>
  <property name="egresado_un" column="MCE_EGRESADO_UN" type="long"/> 
  <property name="pregrado" column="MCE_PREGRADO" type="long"/> 
  <property name="posgrado" column="MCE_POSGRADO" type="long"/> 
  
  <property name="fechaInicial2" column="MCE_FECHA_INI2" type="date"/> 
  <property name="fechaFinal2" column="MCE_FECHA_FIN2" type="date"/> 
  <property name="egresado_un2" column="MCE_EGRESADO_UN2" type="long"/> 
  <property name="pregrado2" column="MCE_PREGRADO2" type="long"/> 
  <property name="posgrado2" column="MCE_POSGRADO2" type="long"/> 
  <property name="horario" column="MCE_HORARIO" type="string"/> 
  <property name="codigoSIA" column="MCE_CODIGO_SIA" type="string"/> 
  <property name="valorDos" column="MCE_VALOR_DOS" type="string"/>
  <property name="requisitos" column="MCE_REQUISITOS" type="string"/>
  <property name="documentosAdjuntar" column="MCE_DOCUMENTOS" type="string"/>
  
  <property name="fecIniCancelaSinPerdida" column="MCE_FECINI_SIN_PERD_CRE" type="date"/> 
  <property name="fecFinCancelaSinPerdida" column="MCE_FECFIN_SIN_PERD_CRE" type="date"/>
  <property name="fecIniCancelaConPerdida" column="MCE_FECINI_CON_PERD_CRE" type="date"/> 
  <property name="fecFinCancelaConPerdida" column="MCE_FECFIN_CON_PERD_CRE" type="date"/>
  
  <property name="fecIniCancelaOtro" column="MCE_FECINI_CANCELA_OTRO" type="date"/> 
  <property name="fecFinCancelaOtro" column="MCE_FECFIN_CANCELA_OTRO" type="date"/>
  <property name="fecIniCurso" column="MCE_FECINI_CURSO" type="date"/> 
  <property name="fecFinCurso" column="MCE_FECFIN_CURSO" type="date"/>
  <property name="estado" column="MCE_ESTADO" type="string"/>
  
  
   
 </class> 
</hibernate-mapping>

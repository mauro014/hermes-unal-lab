<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 2.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="co.edu.unal.hermes.modelo">
	<class name="ArchivoColeccion" table="HER_ARCHIVO_COLECCION">
		<id name="id" column="ACOL_ID" type="long">
			<generator class="sequence">
    			<param name="sequence">SEQ_ARCHIVO_COLECCION</param>
   			</generator>
		</id>

		<many-to-one name="coleccion" class="Coleccion"  column="COL_ID" not-null="true" lazy="false"/>

		<property name="nombre" column="ACOL_NOMBRE" type="string"/>
		<property name="fecha" column="ACOL_FECHA" type="date"/>
		<property name="tipo" column="ACOL_TIPO" type="string"/>
		
	</class>
</hibernate-mapping>
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="co.edu.unal.hermes.modelo">
	<class name="ProyectoInformeImpacto" table="HER_PROYECTO_INFORME_IMPACTO">
		<id name="id" column="PII_ID" type="long">
			<generator class="sequence">
				<param name="sequence">SEQ_PROYECTO_INFORME_IMPACTO</param>
			</generator>
		</id>

		<many-to-one name="informe" class="ProyectoInforme" column="PIN_ID"
			not-null="true" />
				
		<property name="ods" column="PII_ODS" />
		<property name="tipo" column="PII_TIPO" />
		<property name="medicion" column="PII_MEDICION" />
		<property name="detalleImpacto" column="PII_DETALLE" />
		<property name="comentariosCoordinador" column="PII_COMENTARIOS_COORDINADOR" />
		
	</class>
</hibernate-mapping>

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="co.edu.unal.hermes.modelo">

 <class name="LaboratorioODSSec" table="HER_LABORATORIO_ODS_SEC">
 
	  <id name="id" column="LOS_ID" type="long">
		   <generator class="sequence">
		   		<param name="sequence">SEQ_LABORATORIO_ODS_SEC</param>
		   </generator>
	  </id>
	  <many-to-one name="laboratorio" class="co.edu.unal.hermes.modelo.laboratorios.Laboratorio" column="LAB_ID" not-null="true" lazy="false"/>
	  <many-to-one name="ODS" class="co.edu.unal.hermes.modelo.Tipos" column="ODS_ID" not-null="true" lazy="false"/>
 </class>
</hibernate-mapping>

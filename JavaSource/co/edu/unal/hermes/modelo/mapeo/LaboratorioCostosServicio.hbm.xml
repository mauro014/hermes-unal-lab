<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="co.edu.unal.hermes.modelo.laboratorios">

	<class name="LaboratorioCostosServicio" table="HER_LAB_COSTOS_SERVICIO">

		<id name="id" column="HLCS_ID" type="long">
			<generator class="sequence">
				<param name="sequence">SEQ_DETALLE</param>
			</generator>
		</id>

		<many-to-one name="servicio" class="LaboratorioDetalleEnsayosServicios"
			lazy="false">
			<column name="HLDENS_ID" />
		</many-to-one>

		<property name="annio" column="HLCS_ANNIO" />

		<property name="valorM2" column="HLCS_VALOR_M2" />

		<property name="iluminacionNombre" column="HLCS_ILUMINACION_NOMBRE" />
		<property name="iluminacionPotenciaW" column="HLCS_ILUMINACION_POTENCIA_W" />
		<property name="iluminacionTiempoMinutos" column="HLCS_ILUMIN_TIEMPO_MINUTOS" />

		<property name="consumoAcueductoM3" column="HLCS_CONSUMO_ACUEDUCTO_M3" />
		<property name="consumoAlcantarilladoM3" column="HLCS_CONSUMO_ALCANTARILLADO_M3" />

		<property name="fechaRegistro" column="HLCS_FECHA_REGISTRO" />

	</class>

</hibernate-mapping>
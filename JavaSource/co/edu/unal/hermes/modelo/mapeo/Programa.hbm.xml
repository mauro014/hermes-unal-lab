<hibernate-mapping package="co.edu.unal.hermes.modelo">

	<class name="Programa" table="HER_PROGRAMA_POSGRADO">

		<id name="id" column="PPS_ID"/>

		<property name="idDependencia" column="DPN_ID" />
		
		<property name="idTipoNivelPrograma" column="TNP_ID" />
		
		<property name="idEstadoPrograma" column="EPS_ID" />
		
		<property name="nombre" column="PPS_NOMBRE" />
		
	</class>

</hibernate-mapping>

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="co.edu.unal.hermes.modelo">
	<class name="GruposHorariosECP" table="HER_EXT_ECP_OFERTA_HORARIOS">

		<id name="id" column="GRU_HOR_ID" type="long">
			<generator class="sequence">
				<param name="sequence">SEC_HER_ECP_GRUPO_HORARIO</param>
			</generator>
		</id>
		
		<many-to-one name="grupo" column="ID_GRU_CUR" class="GruposCursosECP" lazy="false" not-null="true"/>		
		<many-to-one name="proyecto" column="PRY_ID" class="Proyecto" not-null="true"/>
		<property name="dia" column="DIA" />
		<property name="horaFin" column="HORA_FIN" />
		<property name="horaInicio" column="HORA_INICIO" />
	</class>
</hibernate-mapping>

<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="co.edu.unal.hermes.modelo">
	<class name="SolicitudUsuario" table="HER_SOL_PERSONA">

		<id name="id" column="SLP_ID" type="long">
			<generator class="sequence">
				<param name="sequence">SEQ_SOL_PERSONA</param>
			</generator>
		</id>

		<property name="usuarioDocumento" column="SPE_ID" />
		<property name="usuarioTipoDocumento" column="TDO_ID" />


		<property name="estadoSol" column="SPE_ESTADO_SOL" />
		<property name="apellido1" column="SPE_APELLIDO1" />
		<property name="apellido2" column="SPE_APELLIDO2" />
		<property name="nombre1" column="SPE_NOMBRE1" />
		<property name="nombre2" column="SPE_NOMBRE2" />
		<property name="email" column="SPE_EMAIL" />
		<property name="fechaSolicitud" column="SPE_FECHA_REGISTRO" />
		<property name="solicDocumento" column="SPE_SOLICITANTE_ID" />
		<property name="solicTipoDocumento" column="SPE_SOLICITANTE_TDO" />
		
		<property name="observaciones" column="SPE_OBSERVACIONES" />
		<property name="comentarios" column="SPE_COMENTARIOS" />
		<property name="fechaAprobacion" column="SPE_FECHA_REVISION" />
		<property name="responsableDocumento" column="SPE_REVISION_ID" />
		<property name="responsableTipoDocumento" column="SPE_REVISION_TDO" />
		<property name="fechaFin" column="SPE_FECHA_FIN" />
		
		<many-to-one name="dependencia" class="Dependencia"
					column="DPN_ID" lazy="false" />

	</class>
</hibernate-mapping>

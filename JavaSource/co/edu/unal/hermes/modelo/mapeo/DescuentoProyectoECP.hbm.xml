<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="co.edu.unal.hermes.modelo">
	<class name="DescuentoProyectoECP" table="HER_EXT_DESCUENTO_PROYECTO_ECP">
	
		<id name="id" column="DPR_ID" type="long">
			<generator class="sequence">
				<param name="sequence">SEC_DESCUENTO_PROYECTO_ECP</param>
			</generator>
		</id>
		
		<many-to-one name="proyecto" class="Proyecto" column="PRY_ID"
			not-null="true" lazy="false" />
			
		<many-to-one name="descuento" class="Descuento_ECP" column="DSC_ID"
			not-null="true" lazy="false" />
		
<!-- 		<many-to-one name="descuento" class="DominioDetalle" not-null="true" lazy="false"> -->
<!-- 			<column name="DOM_ID" /> -->
<!-- 			<column name="DOMDET_TIPO" /> -->
<!-- 		</many-to-one>	 -->
			
		<property name="porcentaje" column="DPR_PORCENTAJE"/>
		<property name="numParticipantesEsperado" column="DPR_NUM_PART_ESPERADO"/>
		<property name="numParticipantesDisponibles" column="DPR_NUM_PART_DISPONIBLES"/>
		<property name="descripcion" column="DPR_DESCRIPCION"/>
		
	
	</class>
</hibernate-mapping>
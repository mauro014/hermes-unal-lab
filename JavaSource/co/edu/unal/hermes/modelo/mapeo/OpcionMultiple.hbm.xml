<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
                                   
<hibernate-mapping package="co.edu.unal.hermes.modelo">

 <class name="OpcionMultiple" table="HER_OPCION_MULTIPLE">
   
  <id column="ID" name="id" type="long">
  	<generator class="sequence">
         <param name="sequence">SEQ_OPCION_MULTIPLE</param>
    </generator>
  </id>

  <property column="NOMBRE" name="nombre" type="text"/>
  <property column="VALOR" name="valor" type="double"/>
    
 </class> 
</hibernate-mapping>
<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="co.edu.unal.hermes.modelo">
	<class name="CorreoPlantilla" table="HER_CORREO_PLANTILLA">
		<id name="id" column="COP_ID" type="long">
			<generator class="sequence">
				<param name="sequence">SEQ_CORREO_PLANTILLA</param>
			</generator>
		</id>

		<property name="nombre" column="COP_NOMBRE" />
		<property name="descripcion" column="COP_DESCRIPCION" />
		<property name="asunto" column="COP_ASUNTO" />
		<property name="cuerpo" type="text" column="COP_CUERPO" />

		<property name="nombreAdjunto" column="COP_NOMBRE_ADJUNTO" />
		<property name="plantilla" column="COP_PLANTILLA" />
		<property name="evaluacion" column="COP_EVA" />
		<property name="tipo" column="COP_TIPO" />
		<property name="padre" column="COP_PADRE" />
		<many-to-one name="adjunto" class="ArchivoAdjunto" column="ARA_ID" />
		<property name="tipoModalidad" column="TMO_ID" />
		<many-to-one name="reporte" class="Reporte" column="REP_ID" lazy="false" />

	</class>
</hibernate-mapping>

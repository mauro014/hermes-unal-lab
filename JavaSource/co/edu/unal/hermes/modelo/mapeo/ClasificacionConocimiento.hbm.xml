<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
                                                                     
<hibernate-mapping package="co.edu.unal.hermes.modelo">

 <class name="ClasificacionConocimiento" table="HER_CLASIFICACION_CONOCIMIENTO">
  
  <id column="CLC_ID" name="id" type="string">
   <generator class="assigned"/>
  </id>
  
  <many-to-one name="padre" class="ClasificacionConocimiento" column="CLC_ID_INCLUIDA_EN"/>
  
  <property name="nombre" column="CLC_NOMBRE"/> 
  <property name="nivel" column="CLC_NIVEL"/> 
  
 </class> 
</hibernate-mapping>

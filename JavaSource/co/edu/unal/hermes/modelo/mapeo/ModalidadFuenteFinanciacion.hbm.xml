<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="co.edu.unal.hermes.modelo">
	<class name="ModalidadFuenteFinanciacion" table="HER_MODALIDAD_FUENTE_FCION">
		<id name="id" column="ID" type="long">
			<generator class="sequence">
				<param name="sequence">SEQ_MODALIDAD_FUENTE_FCION</param>
			</generator>
		</id>
		<property name="porcentaje" column="PORCENTAJE" />
		<property name="incluirContrapartida" column="MDF_INCLUIR_CONTRAPARTIDA" />
		<property name="arbol" column="MDF_ID_ARBOL" />
		<property name="montoMaximo" column="MDF_MONTO_MAXIMO" />
		<property name="montoMinimo" column="MDF_MONTO_MINIMO" />
		<many-to-one name="modalidad" class="Modalidad" column="MOD_ID"
			not-null="true" />
		<many-to-one name="fuenteFinanciacion" class="FuenteFinanciacion"
			column="FFI_ID" not-null="true" lazy="false" />
		<set name="rubrosFinanciablesArbol" table="HER_RUBRO_FINANCIABLE_ARBOL"
			lazy="false">
			<key column="MDF_ID" />
			<one-to-many class="RubroFinanciableArbol" />
		</set>
	</class>
</hibernate-mapping>

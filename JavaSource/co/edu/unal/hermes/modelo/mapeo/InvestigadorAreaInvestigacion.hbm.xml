<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="co.edu.unal.hermes.modelo">
 <class name="InvestigadorAreaInvestigacion" table="HER_INVESTIGADOR_AREA_INVESTIG">
  <id name="id" column="IAI_ID" type="long">
   <generator class="sequence">
    <param name="sequence">SEQ_INVESTIGADOR_AREA_INVESTIG</param>
   </generator>
  </id>
  
  <many-to-one name="investigador" class="InvestigadorInterno" not-null="true" lazy="false">
  	<column name="INV_ID"/>
    <column name="TDO_ID"/>
  </many-to-one>
  
  <many-to-one name="area" class="DominioDetalle" not-null="true" lazy="false">
   	<column name="DOM_ID"/>
   	<column name="DOMDET_TIPO"/>
  </many-to-one>

 </class>
</hibernate-mapping>


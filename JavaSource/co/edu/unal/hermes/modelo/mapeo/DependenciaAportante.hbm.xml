<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="co.edu.unal.hermes.modelo">
 <class name="DependenciaAportante" table="HER_PROYECTO_DPN_APORTA">
  <id name="id" column="PDA_ID" type="long">
   <generator class="sequence">
    <param name="sequence">SEQ_PROYECTO_DPN_APORTA</param>
   </generator>
  </id>
  
  <many-to-one name="proyecto" class="Proyecto" column="PRY_ID" not-null="true" lazy="false"/>  
  <many-to-one name="dependencia" class="Dependencia" column="DPN_ID" not-null="true" lazy="false"/>  

  <property name="valorAporte" column="PDA_VALOR_APORTE"/>
  <property name="valorAporteEspecie" column="PDA_VALOR_APORTE_ESPECIE"/>
  

 </class>
</hibernate-mapping>

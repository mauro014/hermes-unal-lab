<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="co.edu.unal.hermes.modelo">
 <class name="Actividad" table="HER_ACTIVIDAD">
  <id name="id" column="ACT_ID" type="long">
   <generator class="sequence">
    <param name="sequence">SEQ_ACTIVIDAD</param>
   </generator>
  </id>
  <property name="descripcion" column="ACT_DESCRIPCION"/>
  <property name="semanaInicial" column="ACT_SEMANA_INICIAL"/>
  <property name="duracionSemanas" column="ACT_DURACION_SEMANAS"/>
  <many-to-one name="proyecto" class="Proyecto" column="PRY_ID" not-null="true"/>
  <set name="actividadesPersona" table="HER_Actividad_Persona" inverse="true" cascade="all-delete-orphan" lazy="false">
   <key column="ACT_ID"/>
   <one-to-many class="ActividadPersona" />
  </set>
  
  <property name="meta" column="ACT_META"/>
  
  <many-to-one name="objetivoEspecifico" class="co.edu.unal.hermes.modelo.ObjetivoEspecifico"
			column="ACT_OBJETIVO_ESP" lazy="false" />
  
  <many-to-one name="metaObjeto" class="co.edu.unal.hermes.modelo.MetaProyecto"
			column="MET_ID" lazy="false" />
			
  <many-to-one name="resultado" class="co.edu.unal.hermes.modelo.ResultadoProyecto"
			column="RST_ID" lazy="false" />
  
  <property name="numeroOrden" column="ACT_ORDEN"/>
  
 </class>
</hibernate-mapping>

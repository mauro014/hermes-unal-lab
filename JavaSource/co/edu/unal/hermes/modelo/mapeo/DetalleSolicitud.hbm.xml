<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="co.edu.unal.hermes.modelo.seguimiento">
 	<class name="DetalleSolicitud" table="HER_DETALLE_SOLICITUD">
  		<id name="id" column="DESO_ID" type="long">
   			<generator class="sequence">
         		<param name="sequence">SEQ_DETALLE_SOLICITUD</param>
	    	</generator>
	  	</id>
	  	
	  	<property name="valor" column="DESO_VALOR" type="long"/>
	  	
	  	<many-to-one name="solicitud" class="Solicitud" column="SOL_ID" not-null="true" lazy="false"/>  
	  	<many-to-one name="gasto" class="co.edu.unal.hermes.modelo.Gasto" column="GST_ID" not-null="true" lazy="false"/>
	  	<many-to-one name="tipoRubro" class="co.edu.unal.hermes.modelo.TipoRubro" column="TRU_ID" not-null="true" lazy="false"/>
 	</class>
</hibernate-mapping>

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="co.edu.unal.hermes.modelo">

	<class name="HistoricoRequerimiento" table="HER_HISTORICO_REQUERIMIENTO">
		<id column="HRE_ID" name="id" type="long">
			<generator class="sequence">
				<param name="sequence">SEQ_HISTORICO_REQUERIMIENTO</param>
			</generator>
		</id>
		<many-to-one name="requerimiento" class="Requerimiento" column="REQ_ID" not-null="true" lazy="false"/>
		<property name="fechaCambio" column="HRE_FECHA" type="timestamp" not-null="true"/>
		<property name="comentariosUsuario" column="REQ_COMENTARIOS" />
	</class>
</hibernate-mapping>
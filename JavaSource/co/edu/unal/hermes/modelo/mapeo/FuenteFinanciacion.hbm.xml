<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="co.edu.unal.hermes.modelo">
 <class name="FuenteFinanciacion" table="HER_FUENTE_FINANCIACION">
  <id name="id" column="FFI_ID" type="string">  
   <generator class="sequence">
    <param name="sequence">SEQ_FUENTE_FINANCIACION</param>
   </generator> 
  </id>    
    <property name="descripcion" 	column="FFI_DESCRIPCION"/>
  	<property name="internaExterna" column="FFI_INTERNA_EXTERNA"/>
  	<property name="naturaleza" 	column="FFE_COD_NATURALEZA"/>
  	<property name="caracter" 	column="FFE_CARACTER"/> 
  	<property name="tipoFuente" 	column="FFE_TIPO_FUENTE"/>
  	<property name="nit" 	column="FFE_NIT_ENTIDAD"/>	
  	<property name="direccion" 	column="FFE_DIR_ENTIDAD"/>
  	<property name="telefono" 	column="FFE_TEL_ENTIDAD"/>
  	<property name="observaciones" 	column="FFE_OBSERVACIONES"/>
  	<property name="quipu" 	column="FFE_QUIPU"/>  
  	<property name="estado" 	column="FFE_ESTADO"/>  
  	<many-to-one name="pais" class="Pais" column="PAIS_ID" lazy="false"/>
  	<property name="autoridadCompetenteBiodiversidad" 	column="FFI_BIODIVERSIDAD"/>  
  	<property name="visibleAval" type="java.lang.Boolean">
  	  <column name="FFI_VISIBLE_AVAL" />
	</property>
  	
  	
 </class>
</hibernate-mapping>

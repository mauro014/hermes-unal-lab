<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="co.edu.unal.hermes.modelo.laboratorios">

	<class name="LaboratorioDetalleProyectos" table="HER_LABORATORIO_DET_PROYECTO">

		<id name="id" column="LDP_ID" type="long">
			<generator class="sequence">
				<param name="sequence">SEQ_DETALLE</param>
			</generator>
		</id>

		<many-to-one name="laboratorio"
			class="co.edu.unal.hermes.modelo.laboratorios.Laboratorio" lazy="false">
			<column name="LAB_ID" />
		</many-to-one>

		<many-to-one name="proyecto" class="co.edu.unal.hermes.modelo.Proyecto"
			lazy="false">
			<column name="PRY_ID" />
		</many-to-one>

		<many-to-one name="grupoInvestigacion" class="co.edu.unal.hermes.modelo.Grupo"
			lazy="false">
			<column name="GRU_ID" />
		</many-to-one>

		<property name="personasPregrado" column="LDP_PERSONAS_PREGRADO" />
		<property name="personasEspecializacion" column="LDP_PERSONAS_ESPECIALIZACION" />
		<property name="personasMaestria" column="LDP_PERSONAS_MAESTRIA" />
		<property name="personasDoctorado" column="LDP_PERSONAS_DOCTORADO" />
		<property name="horasSemanales" column="LDP_HORAS_SEMANALES" />
		<property name="fechaRegistro" column="LDP_FECHA_REGISTRO" />
		<property name="esProgramaLaboratorios" column="LDP_ES_PROGRAMA_LAB" />
		<property name="estado" column="LDP_ESTADO" />

<!-- 		<set name="equipos" table="HER_LABORATORIO_PROY_EQUIPOS" lazy="false"> -->
<!-- 			<key column="LDP_ID" /> -->
<!-- 			<many-to-many class="LaboratorioDetalleEquipos" column="LDE_ID" /> -->
<!-- 		</set> -->

	</class>

</hibernate-mapping>
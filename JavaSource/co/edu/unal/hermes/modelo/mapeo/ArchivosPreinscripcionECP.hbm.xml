<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 2.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="co.edu.unal.hermes.modelo">
	<class name="ArchivosPreinscripcionECP" table="HER_EXT_ARC_PREINS">
		
		<id name="idArchivo" column="ID_ARC" type="long">
			<generator class="sequence">
				<param name="sequence">SEQ_ARCHIVO</param>
			</generator>
		</id>
		
		<many-to-one name="preinscripcionECP" column="ID_PRE" class="Preinscripcion_ECP" not-null="true" />
		<property name="nombreArchivo" column="ARC_PREINS_NOMBRE" type="string" />
		<property name="tipoArchivo" column="ARC_PREINS_TIPO" type="string" /> 
		
	</class>
</hibernate-mapping>
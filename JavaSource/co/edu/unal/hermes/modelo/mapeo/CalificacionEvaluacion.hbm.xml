<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="co.edu.unal.hermes.modelo">
 <class name="CalificacionEvaluacion" table="HER_CALIFICACION_EVALUACION">
  <id name="id" column="CAE_ID" type="long">
   <generator class="sequence">
    <param name="sequence">SEQ_CALIFICACION_EVALUACION</param>
   </generator>
  </id>
  
  <many-to-one name="proyectoEvaluador" class="ProyectoEvaluador" column="PRE_ID" not-null="true"/>
  <many-to-one name="criterio" class="CriterioEvaluacion" column="CRI_ID" not-null="true" lazy="false"/>
  
  <property name="cualitativa" type="text" column="CAE_CUALITATIVA"/>
  <property name="cuantitativa" type="float" column="CAE_CUANTITATIVA"/>
  <property name="calificacionSeleccion" column="CAE_CALIFICACION_SELECCION"/>
    
 </class>
</hibernate-mapping>

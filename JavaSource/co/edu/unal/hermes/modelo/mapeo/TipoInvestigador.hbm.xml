<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="co.edu.unal.hermes.modelo">
	<class name="TipoInvestigador" table="HER_TIPO_INVESTIGADOR">
		<id name="id" column="TINV_ID" type="string">
			<generator class="assigned" />
		</id>
		<property name="nombre" column="TINV_NOMBRE" />
		<property name="tipoModalidad" column="TMO_ID" />
		<property name="documento" column="TINV_DOCUMENTO" />
		<property name="tipoDocumento" column="TINV_TDO" />
		<property name="tipo" column="TINV_TIPO" />
		<property name="tipoVinculacion" column="TINV_VINCULACION" />
		<property name="crearInvestigador" column="TINV_CREAR_INVESTIGADOR" />
        <property name="mostrarProgramaAcademico" column="TINV_MOSTRAR_PROG_ACAD" />
        <property name="mostrarDependencia" column="TINV_MOSTRAR_DEPENDENCIA" />
        <property name="enviarCorreoContrasenia" column="TINV_ENVIAR_CONTRASENIA" />
        <property name="esVisible" column="TINV_VISIBLE" />
	</class>
</hibernate-mapping>

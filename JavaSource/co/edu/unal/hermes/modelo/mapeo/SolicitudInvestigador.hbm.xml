<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="co.edu.unal.hermes.modelo.seguimiento">
	<class name="SolicitudInvestigador" table="HER_SOLICITUD_INVESTIGADOR">
		<id name="id" column="SIN_ID" type="long">
			<generator class="sequence">
				<param name="sequence">SEQ_SOLICITUD_INVESTIGADOR</param>
			</generator>
		</id>
		<many-to-one name="investigador" class="co.edu.unal.hermes.modelo.Investigador"
			not-null="true" lazy="false">
			<column name="INV_ID" />
			<column name="TDO_ID" />
		</many-to-one>
  		<many-to-one name="tipo" column="SIN_TIPO" class="co.edu.unal.hermes.modelo.TipoInvestigador" lazy="false"/>

  		<many-to-one name="solicitud" class="Solicitud" column="SOL_ID" not-null="true" lazy="false"/>
  		<property name="funcion" column="SIN_FUNCION"/>  		
  		<property name="dedicacionHorasSemana" column="SIN_DEDICACION_HORAS_SEMANA"/>
  		<property name="tipoSolicitud" column="SIN_TIPO_SOLICITUD"/>
  		<property name="estado" column="SIN_ESTADO"/>
  		<property name="numeroMeses" column="SIN_NUMERO_MESES"/>
		<property name="fechaProcesamiento" column="SIN_FECHA_PROCESAMIENTO" type="timestamp" />
		<property name="fechaBorrado" column="SIN_FECHA_BORRADO" type="timestamp" />
		<property name="valorPagar" column="SIN_VALOR_PAGAR"/>
		<property name="valorDedicacionOriginal" column="SIN_VALOR_DEDICACION_ORIGINAL"/>

	</class>
</hibernate-mapping>

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="co.edu.unal.hermes.modelo">
 <class name="Continente" table="HER_CONTINENTE">
  <id name="id" column="CONTINENTE_ID" type="long">
   <generator class="assigned"/>
  </id>
  <property name="nombre" column="CONTINENTE_NOMBRE"/>
 <property name="valor" column="CONTINENTE_VALOR"/>
 </class>
</hibernate-mapping>

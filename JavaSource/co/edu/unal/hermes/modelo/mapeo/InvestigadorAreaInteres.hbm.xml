<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="co.edu.unal.hermes.modelo">
 <class name="InvestigadorAreaInteres" table="HER_INVESTIGADOR_AREA_INTERES">
  <id name="id" column="IAIN_ID" type="long">
   <generator class="sequence">
    <param name="sequence">SEQ_INVESTIGADOR_AREA_INTERES</param>
   </generator>
  </id>
  
  <many-to-one name="investigador" class="InvestigadorInterno" not-null="true" lazy="false">
  	<column name="INV_ID"/>
    <column name="TDO_ID"/>
  </many-to-one>
  
  <property name="nombreAreaInteres" column="IAIN_NOMBRE_AREA_INT"/>

 </class>
</hibernate-mapping>


<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="co.edu.unal.hermes.modelo">
	<class name="SolicitudGrupo" table="HER_SOLICITUD_GRUPO">
		<id name="id" column="SOG_ID" type="long">
			<generator class="sequence">
				<param name="sequence">SEQ_SOLICITUD_GRUPO</param>
			</generator>
		</id>

		<property name="fecha" column="SOG_FECHA" type="timestamp" />
		<property name="respuesta" column="SOG_RESPUESTA" />
		<property name="descripcion" column="SOG_DESCRIPCION" />
		<property name="fechaRespuesta" column="SOG_FECHA_RESPUESTA" type="timestamp" />
		<property name="comentarios" column="SOG_COMENTARIOS" />
		
		<many-to-one name="grupo" class="co.edu.unal.hermes.modelo.Grupo"
			column="GRU_ID" not-null="true" lazy="false" />
		
		<many-to-one name="tipoSolicitud" class="co.edu.unal.hermes.modelo.TipoSolicitudGrupo"
			column="SOG_TIPO" not-null="true" lazy="false" />
			
		<many-to-one name="estadoSolicitado" class="co.edu.unal.hermes.modelo.EstadoGrupo"
			column="SOG_ESTADO_SOLICITADO" lazy="false" />
			
		<many-to-one name="responsable" class="co.edu.unal.hermes.modelo.Persona"
			lazy="false">
			<column name="PER_ID_RESPONSABLE" />
			<column name="TDO_ID_RESPONSABLE" />
		</many-to-one>
		
		<many-to-one name="solicitante" class="co.edu.unal.hermes.modelo.Persona"
			lazy="false">
			<column name="PER_ID_SOLICITANTE" />
			<column name="TDO_ID_SOLICITANTE" />
		</many-to-one>
		
		<many-to-one name="dependenciaRevision" class="Dependencia" column="DPN_ID" lazy="false"/>

		
		
	</class>
</hibernate-mapping>

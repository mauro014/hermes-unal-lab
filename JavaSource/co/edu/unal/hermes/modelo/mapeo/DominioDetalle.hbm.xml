<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="co.edu.unal.hermes.modelo">
	<class name="DominioDetalle" table="HER_DOMINIO_DETALLE">

		<composite-id class="IdDominioDetalle" name="identificador"
			unsaved-value="none">

			<key-property name="id" column="DOM_ID" />
			<key-property name="tipo" column="DOMDET_TIPO" />
		</composite-id>

		<property name="descripcion" column="DOMDET_DESCRIPCION" />
		<property name="estado" column="DOMDET_ESTADO" />
		<property name="observacion" column="DOMDET_OBSERVACION" />
	</class>
</hibernate-mapping>

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="co.edu.unal.hermes.modelo">
	<class name="ProyectoInformeConsultaBio" table="HER_PROYECTO_INF_CONSULTA_BIO">
		<id name="id" column="PIC_ID" type="long">
			<generator class="sequence">
				<param name="sequence">SEQ_PROYECTO_INF_CONSULTA_BIO</param>
			</generator>
		</id>
		
		<many-to-one name="informe" class="ProyectoInforme" column="PIN_ID" not-null="true" cascade="none"/>
		
		<property name="localidad" column="PIC_LOCALIDAD" />
		<property name="fecha" column="PIC_FECHA" />
		
	</class>
</hibernate-mapping>

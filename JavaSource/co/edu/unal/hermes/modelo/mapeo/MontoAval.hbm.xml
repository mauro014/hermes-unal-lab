<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 2.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="co.edu.unal.hermes.modelo">
	<class name="MontoAno" table="HER_MONTO_AVAL">
		<id name="id" column="MAV_ID" type="long">
			<generator class="sequence">
    			<param name="sequence">SEQ_MONTO_AVAL</param>
   			</generator>
		</id>
		
		<property name="monto" column="MAV_MONTO"/>
		<property name="ano" column="MAV_FECHA" type="string"/>
		<property name="region" column="MAV_REGION" type="string"/>
		<property name="subregion" column="MAV_SUBREGION" type="string"/>
		<property name="regiontxt" column="MAV_REGIONTXT" type="string"/>
		<property name="subregiontxt" column="MAV_SUBREGIONTXT" type="string"/>
		
		<!--property name="idAval" column="AVI_ID" type="long"/-->

		 <many-to-one name="aval" class="Aval" column="AVI_ID" not-null="true"/>
		<!-- many-to-one name="aval" class="Aval" column="AVI_ID" /-->
		
	</class>
</hibernate-mapping>
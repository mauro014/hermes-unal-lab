<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="co.edu.unal.hermes.modelo">
 <class name="CriteriosEvaluacionConvocatoriaTR" table="HER_CONVOCATORIA_TR_EVAL">
  <id name="id" column="CON_TR_CRI_ID" type="long">
   <generator class="sequence">
    <param name="sequence">SEQ_CRI_EVA_CONV_TR</param>
   </generator>
  </id>
  <many-to-one name="convocatoriaTR" class="ConvocatoriaTerminosReferencia" column="CON_TR_ID" not-null="true" lazy="false"/>  
  
  <property name="descripcion" column="CON_TR_CRI_DESCRIPCION"/>
  <property name="puntaje" column="CON_TR_CRI_PUNTAJE"/>
  <property name="tipoPuntaje" column="CON_TR_CRI_TIPO"/>  
  <property name="orden" column="CON_TR_CRI_ORDEN"/>
  
 </class>
</hibernate-mapping>

<?xml version="1.0" encoding="UTF-8"?>


<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="co.edu.unal.hermes.modelo">
	<class name="MovilidadVisitanteExterior" table="HER_MOVILIDAD_VISITANTES_EXT">

		<id name="id" column="MOV_ID" type="long" unsaved-value="-1">
			<generator class="sequence">
				<param name="sequence">SEQ_MOVILIDAD</param>
			</generator>
		</id>

		<set name="palabrasClaves" table="HER_MOV_VE_PALABRA_CLAVE" lazy="false">
			<key column="MOV_ID" />
			<many-to-many class="PalabraClave" column="PCL_ID" />
		</set>


		<many-to-one name="personaInv" class="Persona" not-null="false"
			lazy="false">
			<column name="MOV_ID_PER" />
			<column name="MOV_TDO_ID_PER" />
		</many-to-one>


		<many-to-one name="idprograma" class="PlanEstudios"
			not-null="false" lazy="false">
			<column name="MOV_ID_PROG" />
		</many-to-one>

		<property name="hojavida" column="MOV_HV_ADJ" />
		<property name="plan" column="MOV_PLAN" />
		<property name="costotiquete" column="MOV_COSTO_TIQ" />
		<property name="monto" column="MOV_MONTO" />
		<property name="numerodias" column="MOV_NUM_DIAS" />
		<property name="aprobacion" column="MOV_APROB" />

		<property name="calificacionA" column="MOV_CALIFICACION_A" />
		<property name="calificacionB" column="MOV_CALIFICACION_B" />
		<property name="calificacionC" column="MOV_CALIFICACION_C" />
		<property name="proyectoFicha" column="PRY_ID" />



		<many-to-one name="tipoMovilidad" class="TipoMovilidad"
			not-null="false" lazy="false">
			<column name="MOV_ID_SUBTIPO_MOV" />
		</many-to-one>

		<property name="fechasolicitud" column="MOV_FEC_SOL" />

		<many-to-one name="grupo" class="Grupo" not-null="false"
			lazy="false">
			<column name="MOV_ID_GRUPO" />
		</many-to-one>


		<property name="evento" column="MOV_EVENTO" />

		<many-to-one name="pais" class="Pais" not-null="false"
			lazy="false">
			<column name="MOV_PAIS" />
		</many-to-one>

		<property name="ciudad" column="MOV_CIUDAD" />
		<property name="fechainicial" column="MOV_FEC_INI_EV" />
		<property name="fechafinal" column="MOV_FEC_FIN_EV" />
		<property name="aceptacion" column="MOV_ACEPT" />
		<property name="universidad" column="MOV_UNIVERSIDAD" />
		<property name="tituloAspira" column="MOV_TITULO_ASPIRA" />
		<property name="nombreArchivo" column="MOV_NOMBRE_ARCHIVO" />
		<property name="documentoVisitante" column="MOV_DOC_VISITANTE" />
		<property name="nombreVisitante" column="MOV_NOMBRE_DOCENTE" />
		<property name="nacionalidad" column="MOV_NACIONALIDAD" />
		<property name="segMovFecha" column="MOV_SEGMOV_FECHA" />
		<property name="segMovDescripcion" column="MOV_SEGMOV_DESCRIPCION" />
		<property name="aportePrograma" column="MOV_APORTE_PROGRAMA" />
		<property name="emailVisitante" column="MOV_EMAIL_VISITANTE" />
		<property name="movilidadConvocatoriaFacultad" column="MOV_FACULTAD" />
		<property name="valorViaticos" column="MOV_VALOR_VIATICOS" />
		<property name="valorOtrosAportes" column="MOV_OTROS_APORTES" />
		<property name="valorAprobadoFacultad" column="MOV_VALOR_APORTE_FAC" />
		<property name="valorAprobadoSede" column="MOV_VALOR_APORTE_SEDE" />
		<property name="anioVigenciaAprFacultad" column="MOV_ANIO_VIGENCIA_APORTE_FAC" />
		<property name="anioVigenciaAprSede" column="MOV_ANIO_VIGENCIA_APORTE_SEDE" />
		<property name="fechaAceptacion" column="MOV_FECHA_ACEPTACION" />
		<property name="fechaAprobacion" column="MOV_FECHA_APROBACION" />
		<property name="cumpleRequisitos" column="MOV_CUMPLE_REQUISITOS" />
		<property name="tipoVisitante" column="MOV_TIPO_VISITANTE" />
		<property name="dispPresupuestal" column="MOV_DIS_PRESUPUESTAL"/>
  		<property name="dispPresupuestalSede" column="MOV_DIS_PRESUPUESTAL_SEDE"/>
		

		<set name="actividades" table="HER_ACTIVIDAD_MOVILIDAD_VE"
			cascade="all">
			<key column="MOV_ID" />
			<one-to-many class="ActividadMovilidadVE" />
		</set>


		<many-to-one name="sede" class="Sede" not-null="false"
			lazy="false">
			<column name="MOV_SEDE" />
		</many-to-one>


		<many-to-one name="dependencia" class="Dependencia" lazy="false">
			<column name="DPN_ID" />
		</many-to-one>

		<many-to-one name="convocatoria" class="Convocatoria" lazy="false">
			<column name="CON_ID" />
		</many-to-one>


		<set name="archivos" table="HER_ARCHIVO_MOVILIDAD_VE" lazy="false"
			inverse="true" cascade="all-delete-orphan">
			<key column="MOV_ID" />
			<one-to-many class="ArchivoMovilidadVE" />
		</set>



		<property name="comentariosFac" column="MOV_COMENTARIOS_FAC" />
		<property name="comentariosDir" column="MOV_COMENTARIOS_DIR" />
		<property name="idPersonaAprobacion" column="MOV_ID_PER_APROB" />
		<property name="tipoIdPersonaAprobacion" column="MOV_TDO_ID_PER_APROB" />
		<property name="idPersonaAprobacionSede" column="MOV_ID_PER_APROB_SED" />
		<property name="tipoIdPersonaAprobacionSede" column="MOV_TDO_ID_PER_APROB_SED" />

		<property name="numeroNotificaciones" column="MOV_NUMERO_NOTIFICACIONES"
			type="integer" length="22" />

		<property name="tipoNotificacion" column="MOV_TIPO_NOTIFICACION"
			type="integer" length="22" />

		<property name="fechaNotificacion" column="MOV_FECHA_NOTIFICACION" />

		<property name="valorTotalApoyo" column="MOV_TOTAL_APOYO" />

		<property name="valorTotalTiquetes" column="MOV_TOTAL_TIQUETES" />

		<property name="valorTotalViaticos" column="MOV_TOTAL_VIATICOS" />

		<property name="experienciasVisitante" column="MOV_EXPERIENCIAS_VISITANTE" />
		
		<property name="montoAdicionalEjecutado" column="MOV_MONTO_ADICIONAL_EJECUTADO" />

		<property name="estadoSeguimiento" column="MOV_ESTADO_SEG" />

		<property name="estadoRevisionSeguimiento" column="MOV_ESTADO_REVISION_SEG" />

		<property name="descripcionRevision" column="MOV_OBSERVACION_REV_SEG" />

		<many-to-one name="personaSeguimiento" class="Persona"
			lazy="false">
			<column name="MOV_PER_ID_REV_SEG" />
			<column name="MOV_TDO_ID_REV_SEG" />
		</many-to-one>

		<property name="fechaRevisionSeguimiento" column="MOV_FECHA_REV_SEG" />

		<property name="realizacionMovilidad" column="MOV_REALIZACION_MOVILIDAD" />

		<property name="razonesNoRealizacion" column="MOV_RAZONES_NO_REALIZACION" />

		<property name="comentariosAprobacionSeguimiento" column="MOV_OBSERVACIONES_APR_SEG" />
		
		<property name="estado" column="MOV_ESTADO" />
		
		<!-- RQUISITOS -->
		<set name="requisitosMovilidad" table="HER_MOVILIDAD_REQUISITO"
			inverse="true" order-by="TPR_ID ASC" cascade="all-delete-orphan">
			<key column="MOV_ID" />
			<one-to-many class="MovilidadRequisito" />
		</set>
		
		<property name="tipoSolicitante" column="MOV_TIPO_SOLICITANTE" />
		<property name="movilidadTipo" column="MOV_TIPO" />
		<property name="costoEstimuloVirtual" column="MOV_ESTIM_VIRTUAL" />
		<property name="movilidadDirigidaOtraDependencia" column="MOV_DIR_OTRA_DPN"/>
		

	</class>
</hibernate-mapping>

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="co.edu.unal.hermes.modelo">
	<class name="OfertaHorariosECP" table="HER_EXT_ECP_OFERTA_HORARIOS">
	
		<composite-id name="id" class="IdHorariosECP">
			<key-many-to-one name="proyecto" class="Proyecto" column="PRY_ID"/>
			<key-property name="dia" column="DIA" />
		</composite-id>
		
		<property name="horaFin" column="HORA_FIN" />
		<property name="horaInicio" column="HORA_INICIO" />
	</class>
</hibernate-mapping>

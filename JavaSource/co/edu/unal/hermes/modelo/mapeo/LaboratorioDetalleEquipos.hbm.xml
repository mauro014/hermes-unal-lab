<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="co.edu.unal.hermes.modelo.laboratorios">

	<class name="LaboratorioDetalleEquipos" table="HER_LABORATORIO_DETALLE_EQUIPO">

		<id name="id" column="LDE_ID" type="long">
			<generator class="sequence">
				<param name="sequence">SEQ_DETALLE</param>
			</generator>
		</id>

		<many-to-one name="laboratorio"
			class="co.edu.unal.hermes.modelo.laboratorios.Laboratorio" lazy="false">
			<column name="LAB_ID" />
		</many-to-one>

		<property name="placa" column="LDE_PLACA" type="string"
			not-null="true" length="20" />

		<property name="serial" column="LDE_SERIAL" type="string"
			length="20" />

		<property name="equipo" column="LDE_EQUIPO" type="string"
			length="256" />

		<property name="marca" column="LDE_MARCA" type="string"
			length="100" />

		<property name="modelo" column="LDE_MODELO" type="string"
			length="100" />

		<property name="idInterna" column="LDE_ID_INTERNA" type="string"
			length="100" />

		<property name="especializado" column="LDE_ESPECIALIZADO" />

		<property name="estadoFisico" column="LDE_ESTADO_FISICO" />

		<property name="estadoFisicoCenso" column="LDE_ESTADO_FISICO_CENSO" />

		<property name="mayorDiezAnnios" column="LDE_MAYOR_DIEZ_ANNIOS" />

		<property name="enUso" column="LDE_EN_USO" />

		<property name="mantenimiento" column="LDE_MANTENIMIENTO" />

		<property name="calibracion" column="LDE_CALIBRACION" />

		<property name="fechaRegistro" column="LDE_FECHA_REGISTRO" />

		<property name="idResponsable" column="LDE_ID_RESPONSABLE" />

		<property name="responsable" column="LDE_NOMBRE_RESPONSABLE" />
		
		<property name="responsableEmail" column="LDE_RESPONSABLE_EMAIL" />

		<property name="fechaServicio" column="LDE_FECHA_SERVICIO" />

		<property name="fechaAdquisicion" column="LDE_FECHA_ADQUISICION" />

		<property name="valor" column="LDE_VALOR" />

		<property name="annioFabricacion" column="LDE_ANNIO_FABRICACION" />

		<property name="mesesGarantia" column="LDE_MESES_GARANTIA" />

		<property name="vidaUtilAnnios" column="LDE_VIDA_UTIL_ANNIOS" />

		<property name="accesorios" column="LDE_ACCESORIOS" />

		<property name="software" column="LDE_SOFTWARE" />

		<many-to-one name="empresaFabricante" class="co.edu.unal.hermes.modelo.Empresa"
			lazy="false">
			<column name="LDE_EMP_FAB_ID" />
		</many-to-one>

		<many-to-one name="empresaDistribuidora" class="co.edu.unal.hermes.modelo.Empresa"
			lazy="false">
			<column name="LDE_EMP_DIST_ID" />
		</many-to-one>

		<property name="nombreVendendor" column="LDE_NOMBRE_VENDEDOR" />
		<property name="emailVendedor" column="LDE_EMAIL_VENDEDOR" />
		<property name="telefonoVendedor" column="LDE_TELEFONO_VENDEDOR" />
		<property name="nombreInstructor" column="LDE_NOMBRE_INSTRUCTOR" />

		<property name="sistemaAlimentacion" column="LDE_SISTEMA_ALIMENTACION" />
		<property name="potenciaW" column="LDE_POTENCIA_W" />
		<property name="voltajeV" column="LDE_VOLTAJE_V" />

		<property name="largoCm" column="LDE_LARGO_CM" />
		<property name="anchoCm" column="LDE_ANCHO_CM" />
		<property name="altoCm" column="LDE_ALTO_CM" />
		<property name="pesoKg" column="LDE_PESO_KG" />
		<property name="instalaciones" column="LDE_INSTALACIONES" />
		<property name="condicionesAlmacenamiento" column="LDE_CONDICIONES_ALMACENAMIENTO" />
		<property name="observaciones" column="LDE_OBSERVACIONES" />

		<property name="proceso" column="LDE_PROCESO" />
		<property name="ordenDeCompra" column="LDE_ORDEN_DE_COMPRA" />

		<many-to-one name="mecanismoAdquisicion" class="co.edu.unal.hermes.modelo.Tipos"
			lazy="false">
			<column name="LDE_MECANISMO_ADQUISICION_ID" />
		</many-to-one>

		<property name="manualesOperacion" column="LDE_MANUALES_OPERACION" />
		<property name="manualesInstalacion" column="LDE_MANUALES_INSTALACION" />
		<property name="fechaInstalacion" column="LDE_FECHA_INSTALACION" />

		<property name="documentoPersonaRegistro" column="LDE_DOCUMENTO_PERSONA_REGISTRO" />
		<property name="tipoDocumentoPersonaRegistro" column="LDE_TIPO_DOC_PERSONA_REGISTRO" />

		<property name="ubicacion" column="LDE_UBICACION" />

		<many-to-one name="sede" class="co.edu.unal.hermes.modelo.Sede"
			column="LDE_SEDE" lazy="false" />
		<many-to-one name="facultad" class="co.edu.unal.hermes.modelo.Dependencia"
			column="LDE_FACULTAD" lazy="false" />
		<many-to-one name="departamento" class="co.edu.unal.hermes.modelo.Dependencia"
			column="LDE_DEPARTAMENTO" lazy="false" />
		<many-to-one name="edificio" class="co.edu.unal.hermes.modelo.Edificio"
			column="LDE_EDIFICIO" lazy="false" />
		<property name="salon" column="LDE_SALON" />
		<property name="telefono" column="LDE_TELEFONO" />

		<property name="instrumentoMedicion" column="LDE_ES_INSTRUMENTO_MEDICION" />
		
		<property name="requiereMantenimiento" column="LDE_REQUIERE_MANTENIMIENTO" />

		<property name="tieneHojaDeVida" column="LDE_TIENE_HOJA_DE_VIDA" />

		<property name="existeEnBienes" column="LDE_EXISTE_EN_BIENES" />
		<property name="fechaBusquedaEnBienes" column="LDE_FECHA_BUSQUEDA_BIENES" />
		<property name="diferenciasConBienes" column="LDE_DIFERENCIAS_CON_BIENES" />

		<property name="dadoDeBaja" column="LDE_DADO_DE_BAJA" />

		<property name="porcentajeCompletitud" column="LDE_PORCENTAJE_COMPLETITUD" />
		<property name="informacionFaltante" column="LDE_INFORMACION_FALTANTE" />
		
		<property name="estaCalibrado" column="LDE_ESTA_CALIBRADO" />
		<property name="fechaCalibrado" column="LDE_FECHA_CALIBRADO" />
		<property name="resolucion" column="LDE_ESTA_RESOLUCION" />
		<many-to-one name="dondeCalibracion" class="co.edu.unal.hermes.modelo.Tipos"
			column="LDE_DONDE_CALIBRADO" lazy="false" />
		<many-to-one name="incertidumbre" class="co.edu.unal.hermes.modelo.Tipos"
			column="LDE_INCERT_CALIBRADO" lazy="false" />
		<property name="valorCalibracion" column="LDE_VALOR_CALIBRACION" />
		<property name="factorCoberturaK" column="LDE_FACTOR_COBERTURA_K" />
		<property name="entidadCalibra" column="LDE_NOMBRE_ENT_CALIB" />
		<property name="tipoDocEntidadCalibra" column="LDE_TIPO_DOC_ENT_CALIB" />
		<property name="numDocumentoEntidadCalibra" column="LDE_NUM_DOC_ENT_CALIB" />
		
		<property name="danado" column="LDE_DANADO" />
		<property name="perdido" column="LDE_PERDIDO" />
		
<!-- 		<many-to-one name="razonNoQuipu" class="co.edu.unal.hermes.modelo.Tipos" -->
<!-- 			column="LDE_RAZON_NO_ESTA_QUIPU" lazy="false" /> -->

		<property name="razonNoQuipu" column="LDE_RAZON_NO_ESTA_QUIPU" />
		<property name="razonNoQuipuOtros" column="LDE_RAZON_NO_ESTA_QUIPU_OTRO" />
		
		<property name="noAplicaVoltaje" column="LDE_NO_APLICA_VOLTAJE" />
		<property name="noAplicaPotencia" column="LDE_NO_APLICA_POTENCIA" />
		
		<property name="firmware" column="LDE_FIRMWARE" />
		<property name="ubicacionEspecifica" column="LDE_UBICACION_ESPECIFICA" />
		
		<many-to-one name="solicitudEliminarActiva"
			class="co.edu.unal.hermes.modelo.laboratorios.LaboratorioSolicitud" lazy="false">
			<column name="LDE_SOL_ELIMINACION_ACTIVA" />
		</many-to-one>
		
		<property name="robusto" column="LDE_ROBUSTO" />
		<property name="robustoEspecialidadCalidadAnalitica" column="LDE_ROBUSTO_ESP_CAL_ANALITICA" />
		<property name="robustoMayorValorReferencia" column="LDE_ROBUSTO_MAYOR_VALOR_DEF" />
		<property name="robustoAltaPrecision" column="LDE_ROBUSTO_ALTA_PRECISION" />
		<property name="robustoAltaExactitud" column="LDE_ROBUSTO_ALTA_EXACTITUD" />
		
		<property name="fechaDadoBaja" column="LDE_DADO_BAJA_FECHA" />
		<property name="motivoDadoBaja" column="LDE_DADO_BAJA_MOTIVO" />
		
		<many-to-one name="critEquiposImpactoOperaLab" class="co.edu.unal.hermes.modelo.Tipos"
			column="LDE_CE_IMP_OPER_LAB" lazy="false" />
		<many-to-one name="critEquiposImpactoSegUsuarios" class="co.edu.unal.hermes.modelo.Tipos"
			column="LDE_CE_IMP_SEG_USUARIOS" lazy="false" />
		<many-to-one name="critEquiposImpactoDaniosInfra" class="co.edu.unal.hermes.modelo.Tipos"
			column="LDE_CE_IMP_DANIOS_INFRA" lazy="false" />
		<many-to-one name="critEquiposImpactoDaniosAmbient" class="co.edu.unal.hermes.modelo.Tipos"
			column="LDE_CE_IMP_DANIOS_AMBIENT" lazy="false" />
		<many-to-one name="critEquiposImpactoImagenUN" class="co.edu.unal.hermes.modelo.Tipos"
			column="LDE_CE_IMP_IMAGEN_UN" lazy="false" />
		<many-to-one name="critEquiposImpactoQuejas" class="co.edu.unal.hermes.modelo.Tipos"
			column="LDE_CE_IMP_QUEJAS" lazy="false" />
		<many-to-one name="critEquiposImpactoEconomicos" class="co.edu.unal.hermes.modelo.Tipos"
			column="LDE_CE_IMP_IMPACTOS_ECON" lazy="false" />
		
		<many-to-one name="critEquiposProbRepFalla" class="co.edu.unal.hermes.modelo.Tipos"
			column="LDE_CE_PROB_REP_FALLA" lazy="false" />
		<many-to-one name="critEquiposProbTiempoTrabajo" class="co.edu.unal.hermes.modelo.Tipos"
			column="LDE_CE_PROB_TIEMPO_TRAB" lazy="false" />
		<many-to-one name="critEquiposProbCondAmbient" class="co.edu.unal.hermes.modelo.Tipos"
			column="LDE_CE_PROB_COND_AMB" lazy="false" />
		<many-to-one name="critEquiposProbMetrologia" class="co.edu.unal.hermes.modelo.Tipos"
			column="LDE_CE_PROB_METROLOGIA" lazy="false" />
			
		<property name="critEquiposValorImpacto" column="LDE_CALIFICACION_IMPACTO" />
		<property name="critEquiposValorProbabilidad" column="LDE_CALIFICACION_PROBABILIDAD" />
		<property name="critEquiposValorRiesgo" column="LDE_CALIFICACION_RIESGO" />
		
	</class>

</hibernate-mapping>
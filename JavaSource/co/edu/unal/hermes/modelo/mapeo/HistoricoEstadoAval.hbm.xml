<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
                                   
<hibernate-mapping package="co.edu.unal.hermes.modelo">

 <class name="HistoricoEstadoAval" table="HER_HISTORICO_ESTADO_AVAL">
  
  <id column="HEA_ID" name="id" type="long">
  	<generator class="sequence">
         <param name="sequence">SEQ_HISTORICO_ESTADO_AVAL</param>
    </generator>
  </id>  
   
  <many-to-one name="revisor" class="co.edu.unal.hermes.modelo.Persona" not-null="true" lazy="false">
	<column name="PER_ID"/>
	<column name="TDO_ID"/>
  </many-to-one>
  
   <many-to-one name="aval" column="AVI_ID" class="Aval" not-null="true"/>
  
  <property name="fecha" column="HEA_FECHA" type="timestamp"/>
  <property name="justificacion" column="HEA_JUSTIFICACION"/>
  <property name="estadoAval" column="AVI_ESTADO"/>
  <property name="avalUab" column="AVI_AVALUAB"/>
  <property name="avalFacultad" column="AVI_AVALFACULTAD"/>
  <property name="avalDireccion" column="AVI_AVALDIRECCION"/>
  <property name="avalVicerrectoria" column="AVI_AVALVICE"/>
	<property name="avalDRE" column="AVI_AVALDRE" />
	<property name="avalRectoria" column="AVI_AVALRECTORIA" />   
 </class> 
</hibernate-mapping>
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="co.edu.unal.hermes.modelo">
	<class name="ObservacionSeguimiento" table="HER_OBSERVACION_SEGUIMIENTO">
		<id name="id" column="SEP_ID" type="long">
			<generator class="sequence">
				<param name="sequence">SEQ_OBSERVACION_SEGUIMIENTO</param>
			</generator>
		</id>
		<property name="descripcion" column="SEP_DESCRIPCION" />
		<property name="fecha" column="SEP_FECHA" />
		<property name="fechaEliminacion" column="SEP_FECHA_ELIMINACION" />
		<property name="estado" column="SEP_ESTADO" />
		<property name="tipo" column="SEP_TIPO" />
		<property name="respuesta" column="SEP_RESPUESTA" />
		<property name="fechaRespuesta" column="SEP_FECHA_RESPUESTA" />		
  		<many-to-one name="proyecto" class="Proyecto" column="PRY_ID" not-null="true"/>
		<many-to-one name="responsable" class="Persona"
			not-null="true" lazy="false">
			<column name="PER_ID" />
			<column name="TDO_ID" />
		</many-to-one>
		<many-to-one name="responsableEliminacion" class="Persona"
			not-null="true" lazy="false">
			<column name="PER_ID_ELIMINACION" />
			<column name="TDO_ID_ELIMINACION" />
		</many-to-one>
	</class>
</hibernate-mapping>

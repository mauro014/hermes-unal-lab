<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="co.edu.unal.hermes.modelo.laboratorios">
	<class name="LaboratorioAreaOCDE" table="HER_LABORATORIO_AREA_OCDE">
		<id name="id" column="HLAO_ID" type="long">
			<generator class="sequence">
				<param name="sequence">SEQ_PROYECTO_AREA_TEMATICA</param>
			</generator>
		</id>
		<property name="idLaboratorio" column="LAB_ID" />
		<property name="fecha" column="HLAO_FECHA" />
		<many-to-one name="areaOCDE" lazy="false"
			class="co.edu.unal.hermes.modelo.DominioDetalle">
			<column name="DOM_ID" />
			<column name="DOMDET_TIPO" />
		</many-to-one>
	</class>
</hibernate-mapping>

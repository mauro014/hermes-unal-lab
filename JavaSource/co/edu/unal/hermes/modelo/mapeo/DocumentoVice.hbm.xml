<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="co.edu.unal.hermes.modelo">
	 <class name="DocumentoVice" table="HER_DOCUMENTO_VICE">
	  <id name="id" column="CVI_ID" type="long">
	  		<generator class="sequence">
				<param name="sequence">SEQ_DOCUMENTO_VICE</param>
			</generator></id>
	  <property name="nombre" column="CVI_NOMBRE"/>
	  <property name="estado" column="CVI_EST"/>
	  <property name="esArchivo" column="CVI_ES_ARCHIVO" />
	  <property name="idPadre" column="CVI_PADRE"/>
	 </class>
</hibernate-mapping>

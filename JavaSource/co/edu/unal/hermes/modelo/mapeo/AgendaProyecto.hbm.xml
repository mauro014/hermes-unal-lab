<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="co.edu.unal.hermes.modelo">
 <class name="AgendaProyecto" table="HER_PROYECTO_AGENDA">
  
  <composite-id>
           <key-many-to-one name="proyecto" class="Proyecto" column="PRY_ID" lazy="false"/>
           <key-many-to-one name="agenda" class="AgendaConocimiento" column="AGD_ID" lazy="false"/>
  </composite-id>

  <property name="orden" column="PAG_ORDEN"/>
 </class>
</hibernate-mapping>

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 2.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="co.edu.unal.hermes.modelo">
	<class name="PersonaTramiteBiodiversidad" table="HER_PERSONA_TRAM_BIODIVERSIDAD">

		<id column="PTB_ID" name="id" type="long" >
		  	<generator class="sequence">
		         <param name="sequence">SEQ_PERSONA_TRAM_BIO</param>
		    </generator>
		 </id>
		 
		<many-to-one name="personaEncargada" class="InvestigadorInterno" lazy="false">
			<column name="PER_ID" />
			<column name="TDO_ID" />
		</many-to-one>
		
		<many-to-one name="dependencia" class="Dependencia" column="DPN_ID" lazy="false"/>
		<many-to-one name="tipoTramite" class="TipoTramiteBiodiversidad" column="TTB_ID" lazy="false"/>
		
	</class>
</hibernate-mapping>
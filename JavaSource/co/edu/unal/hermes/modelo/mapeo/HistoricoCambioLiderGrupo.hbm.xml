<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="co.edu.unal.hermes.modelo">

	<class name="HistoricoCambioLiderGrupo" table="HER_HISTORICO_CAMBIO_LIDER">
		<id column="HCL_ID" name="id" type="long">
			<generator class="sequence">
				<param name="sequence">SEQ_HISTORICO_CAMBIO_LIDER</param>
			</generator>
		</id>

		<property name="fecha" column="HCL_FECHA" type="timestamp" />
		
		<many-to-one name="grupo" column="GRU_ID" class="Grupo"
			not-null="true" />
		
		<many-to-one name="liderAnterior" class="co.edu.unal.hermes.modelo.Persona"
			lazy="false">
			<column name="HCL_PER_ID" />
			<column name="HCL_TDO_ID" />
		</many-to-one>

	</class>
</hibernate-mapping>
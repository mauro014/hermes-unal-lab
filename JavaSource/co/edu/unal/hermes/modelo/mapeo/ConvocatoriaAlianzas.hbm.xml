<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC
	"-//Hibernate/Hibernate Mapping DTD//EN"
	"http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd" >

<hibernate-mapping package="co.edu.unal.hermes.modelo">
	<class name="ConvocatoriaAlianzas" table="HER_CONVOCATORIA_ALIANZAS">
		<meta attribute="sync-DAO">false</meta>
		<id name="id" column="COA_ID" type="long">
			<generator class="sequence">
				<param name="sequence">SEQ_PROYECTO</param>
			</generator>
		</id>

		<property name="coaTrayectoriaGrupo" column="COA_TRAYECTORIA_GRUPO"
			type="string" not-null="false" />
		<property name="coaFormacionEstudiantes" column="COA_FORMACION_EST"
			type="string" not-null="false" />
		<property name="coaProduccionAcademica" column="COA_PRODUCCION_ACADEMICA"
			type="string" not-null="false" />
		<property name="coaParticipacionEventos" column="COA_PARTICIPACION_EVENTOS"
			type="string" not-null="false" />
		<property name="coaDocentesParticipantes" column="COA_DOCENTES_PARTICIPANTES"
			type="string" not-null="false" />		
		<property name="coaGruposUnAlianza" column="COA_GRUPOS_UN_ALIANZA"
			type="string" not-null="false" />
		<property name="coaEntidadAliada" column="COA_ENTIDAD_ALIADA"
			type="string" not-null="false" />
		<property name="coaNombreProyecto" column="COA_NOMBRE_PROYECTO"
			type="string" not-null="false" length="1000" />
		<property name="coaObjetivo" column="COA_OBJETIVO" type="string"
			not-null="false" />
		<property name="coaContribucion" column="COA_CONTRIBUCION"
			type="string" not-null="false" />
		<property name="coaLineasInvestigacion" column="COA_LINEAS_INVESTIGACION"
			type="string" not-null="false" />
		<property name="coaConvocatoriaExterna" column="COA_CONVOCATORIA_EXTERNA"
			type="string" not-null="false" />
		<property name="coaResultados" column="COA_RESULTADOS" type="string"
			not-null="false" />
		<property name="coaActividades" column="COA_ACTIVIDADES"
			type="string" not-null="false" />
		<property name="coaProductosEsperados" column="COA_PRODUCTOS_ESPERADOS"
			type="string" not-null="false" />
		<property name="coaPropuestaPresupuestal" column="COA_PROPUESTA_PRESUPUESTAL"
			type="string" not-null="false" />
		<property name="coaContrapartida" column="COA_CONTRAPARTIDA"
			type="string" not-null="false" />
		<property name="coaPlanFormacion" column="COA_PLAN_FORMACION"
			type="string" not-null="false" />
		<property name="coaDuracionPropuesta" column="COA_DURACION_PROPUESTA"
			type="integer" not-null="false" />
		<property name="coaModId" column="COA_MOD_ID" type="string"
			not-null="true" length="2" />
		<property name="coaFechaConvExterna" column="COA_FECHA_CONV_EXTERNA"
			type="date" not-null="false" length="7" />
		<property name="coaFechaSolicitud" column="COA_FECHA_SOLICITUD"
			type="date" not-null="false" length="7" />
		<property name="coaEtapa" column="COA_ETAPA" type="integer"
			not-null="true" />
		<property name="coaEstado" column="COA_ESTADO" type="string"
			not-null="true" />
		<property name="coaAgendasConocimiento" column="COA_AGENDAS_CONOCIMIENTO"
			type="string" not-null="false" />

		<many-to-one name="grupoResponsable" class="Grupo"
			column="COA_GRUPO_RESPONSABLE" not-null="true" lazy="false" />

		<many-to-one name="investigador" class="Investigador"
			not-null="true" lazy="false">
			<column name="INV_ID" />
			<column name="TDO_ID" />
		</many-to-one>

		<set name="archivos" table="HER_ARCHIVO_CONVOCATORIA" cascade="all-delete-orphan"
			fetch="join">
			<key column="ACN_CONVOCATORIA" />
			<one-to-many class="ArchivoConvocatoria" />
		</set>

	</class>
</hibernate-mapping>
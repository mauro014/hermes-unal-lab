<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="co.edu.unal.hermes.modelo">
	<class name="ProyectoEditorialTitulo"
		table="HER_PROYECTO_EDITORIAL_TITULO">
		<id name="id" column="PET_ID" type="integer">
			<generator class="sequence">
				<param name="sequence">SEQ_PROYECTO_EDITORIAL_TITULO</param>
			</generator>
		</id>
		<many-to-one name="proyecto" class="Proyecto"
			column="PRY_ID" lazy="false" />
		<property name="titulo" column="PRY_TITULO" />
	</class>
</hibernate-mapping>
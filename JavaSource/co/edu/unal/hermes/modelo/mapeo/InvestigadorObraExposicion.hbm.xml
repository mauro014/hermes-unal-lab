<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="co.edu.unal.hermes.modelo">
 <class name="InvestigadorObraExposicion" table="HER_INVESTIGADOR_OBRA_EXP">
  <id name="id" column="IOE_ID" type="long">
   <generator class="sequence">
    <param name="sequence">SEQ_INVESTIGADOR_OBRA_EXP</param>
   </generator>
  </id>
  
  <many-to-one name="investigador" class="InvestigadorInterno" not-null="true" lazy="false">
  	<column name="INV_ID"/>
    <column name="TDO_ID"/>
  </many-to-one>
  
  <many-to-one name="pais" column="PAIS_ID" class="Pais" lazy="false"/>
  <property name="nombreObra" column="IOE_NOMBRE_OBRA"/>
  <property name="nombreExposicion" column="IOE_NOMBRE_EXPOSICION"/>
  <property name="organizador" column="IOE_ORGANIZADOR"/>  
  <property name="fechaExposicion" column="IOE_FECHA_EXPOSICION"/>
  <property name="fechaObra" column="IOE_FECHA_OBRA"/>
  <property name="ciudadPais" column="IOE_CIUDAD_PAIS"/>    

 </class>
</hibernate-mapping>


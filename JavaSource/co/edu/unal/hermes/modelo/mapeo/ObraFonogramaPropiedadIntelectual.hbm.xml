<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="co.edu.unal.hermes.modelo">
	<class name="ObraFonogramaPropiedadIntelectual" table="HER_PROPIEDAD_INT_OBR_FONOGR">
		<id name="id" column="POF_ID" type="long">
			<generator class="sequence">
				<param name="sequence">SEQ_PROPIEDAD_INT_OBR_FONOGR</param>
			</generator>
		</id>
		
		<property name="nombreObra" column="POF_NOMBRE_OBRA" />	
		
		<many-to-one name="propiedad" class="PropiedadIntelectual"
			column="PRI_ID" lazy="false" />
			
		<set name="autores" table="HER_PROPIEDAD_INT_PERSONA" lazy="false">
			<key column="POF_ID" />
			<one-to-many class="PersonaPropiedadIntelectual" />
		</set>
			
	</class>
</hibernate-mapping>

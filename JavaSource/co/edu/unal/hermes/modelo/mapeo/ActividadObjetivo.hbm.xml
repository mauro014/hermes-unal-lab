<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="co.edu.unal.hermes.modelo">
	<class name="ActividadObjetivo" table="HER_OBJ_ESP_ACTIVIDAD">
		<id name="id" column="ACT_ID" type="long">
			<generator class="sequence">
				<param name="sequence">SEQ_OBJ_ACT</param>
			</generator>
		</id>
		<property name="descripcion" column="ACT_DESCRIPCION" />
		<property name="mesInicial" column="ACT_SEMANA_INICIAL" />
		<property name="duracionMeses" column="ACT_DURACION_SEMANAS" />
		<many-to-one name="investigadorPro" class="Investigador"
			not-null="true" lazy="false">
			<column name="INV_ID" />
			<column name="TDO_ID" />
		</many-to-one>
		<many-to-one name="objetivoEspecifico" class="ObjetivoEspecifico"
			lazy="false" column="OBJ_ID" not-null="true" />
		<many-to-one name="resultadoProyecto" class="ResultadoProyecto"
			lazy="false" column="RES_ID" />
		<many-to-one name="proyecto" class="Proyecto" column="PRY_ID"
			not-null="true" />

	</class>
</hibernate-mapping>

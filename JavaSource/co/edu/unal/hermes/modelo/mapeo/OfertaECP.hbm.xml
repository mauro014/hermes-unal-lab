<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="co.edu.unal.hermes.modelo">
	<class name="OfertaECP" table="HER_EXT_ECP_OFERTAS">
		<id name="id" column="ID_OFERTA" type="long">
			<!-- <generator class="sequence"> <param name="sequence">SEQ_CATALOGO_ECP</param> 
				</generator> -->
		</id>
<!-- 		<many-to-one name="dependencia" class="Dependencia" -->
<!-- 			column="ID_DEPENDENCIA" lazy="false" /> -->
		<many-to-one name="catalogo" class="CatalogoECP" column="ID_CATALOGO"
			lazy="false" />
			
		<property name="vigencia" column="VIGENCIA" />
		<property name="semestre" column="SEMESTRE" />
		
		<property name="fechaInicio" column="FEC_INICIO" />
		<property name="numHoras" column="NUM_HORAS" />
		<property name="tipoCertificado" column="COD_TIPO_CERTIFICADO" />
		<property name="valorInscripcion" column="VALOR_INSCRIPCION" />
		<property name="contactoNombre" column="CONTACTO_NOMBRE" />
		<property name="contactoEmail" column="CONTACTO_EMAIL" />
		<property name="contactoTelefono" column="CONTACTO_TELEFONO" />
		<property name="contactoExtension" column="CONTACTO_EXTENSION" />
		<property name="contactoWeb" column="CONTACTO_WEB" />
		<property name="participanOtrasFacultades" column="PARTICIPAN_OTRAS_FACULTADES" />
		<property name="participanOtrasSedes" column="PARTICIPAN_OTRAS_SEDES" />
		<property name="observaciones" column="OBSERVACIONES" />
		<property name="estadoOferta" column="COD_ESTADO_OFERTA" />
		<property name="registroCompleto" column="REG_COMPLETO" />
		<property name="fechaRegistro" column="FEC_REGISTRO" />
<!-- 		<property name="persona" column="ID_SIGE_USUARIO" /> -->


	</class>
</hibernate-mapping>

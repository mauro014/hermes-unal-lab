<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="co.edu.unal.hermes.modelo">
 <class name="DependenciaConvocatoriaTR" table="HER_CONVOCATORIA_TR_DEP">
  <id name="id" column="CON_TR_DPN_ID" type="long">
   <generator class="sequence">
    <param name="sequence">SEQ_CONV_TR_DEPENDENCIA</param>
   </generator>
  </id>
  
  <many-to-one name="convocatoriaTR" class="ConvocatoriaTerminosReferencia" column="CON_TR_ID" not-null="true" lazy="false"/>  
  <many-to-one name="dependencia" class="Dependencia" column="DPN_ID" not-null="true" lazy="false"/>  

 </class>
</hibernate-mapping>

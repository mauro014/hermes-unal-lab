<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="co.edu.unal.hermes.modelo">
 <class name="TipoPonencia" table="HER_TIPO_PONENCIA">
  <id name="id" column="TPO_ID" type="long">
   <generator class="sequence">
   	<param name="sequence">SEQ_TIPO_PONENCIA</param>
   </generator>
  </id>
   <property name="descripcion" column="TPO_DESCRIPCION"></property>
    <property name="mostrar" column="TPO_MOVILIDAD_MOSTRAR"></property>
 </class>	  
</hibernate-mapping>

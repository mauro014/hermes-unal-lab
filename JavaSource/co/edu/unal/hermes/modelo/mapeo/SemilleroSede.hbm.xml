<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="co.edu.unal.hermes.modelo">
	<class name="SemilleroSede" table="HER_SEMILLERO_SEDE">
		<composite-id>
			<key-many-to-one name="semillero" class="Semillero"
				column="SEM_ID" lazy="false">
			</key-many-to-one>
			<key-many-to-one name="sede" class="Sede"
				lazy="false" column="SED_ID">
			</key-many-to-one>
		</composite-id>
		<property name="fechaRegistro" column="SSE_FECHA_REGISTRO" />
		<property name="fechaBorrado" column="SSE_FECHA_BORRADO" />
	</class>
</hibernate-mapping>
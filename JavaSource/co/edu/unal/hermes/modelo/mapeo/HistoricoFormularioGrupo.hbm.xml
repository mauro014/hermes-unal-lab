<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="co.edu.unal.hermes.modelo">
	<class name="HistoricoFormularioGrupo" table="HER_HISTORICO_FORMULARIO_GRUPO">
		<id column="HFG_ID" name="id" type="long">
			<generator class="sequence">
				<param name="sequence">SEQ_HISTORICO_FORMULARIO_GRUPO</param>
			</generator>
		</id>
		<many-to-one name="grupo" column="GRU_ID" class="Grupo"
			not-null="true" />
		<property name="fecha" column="HFG_FECHA" type="timestamp" />
		<property name="numero" column="HFG_NUMERO" />
		<many-to-one name="responsable" class="co.edu.unal.hermes.modelo.Persona"
			lazy="false">
			<column name="HFG_PER_ID" />
			<column name="HFG_TDO_ID" />
		</many-to-one>
	</class>
</hibernate-mapping>
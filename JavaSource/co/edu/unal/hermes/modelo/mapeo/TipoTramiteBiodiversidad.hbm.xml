<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 2.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="co.edu.unal.hermes.modelo">
	<class name="TipoTramiteBiodiversidad" table="HER_TIPO_TRAM_BIODIVERSIDAD">
		<id name="id" column="TTB_ID" type="long">
		</id>
		
		<property name="nombre" column="TTB_NOMBRE" type="string"/>
		<property name="descripcion" column="TTB_DESCRIPCION" type="string"/>
		<property name="estado" column="TTB_ESTADO" type="string"/>
		<property name="nivelTramite" column="TTB_NIVEL" type="string"/>
		
		<set name="personalEncargado" table="HER_PERSONA_TRAM_BIODIVERSIDAD" lazy="false" cascade="all-delete-orphan">
			<key column="TTB_ID" />
			<one-to-many class="PersonaTramiteBiodiversidad" />
		</set>
		
	</class>
</hibernate-mapping>
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="co.edu.unal.hermes.modelo.seguimiento">
 	<class name="ProyectoProrroga" table="HER_PROYECTO_PRORROGA">
  		<id name="id" column="PRPR_ID" type="long">
   			<generator class="sequence">
         		<param name="sequence">SEQ_PROYECTO_PRORROGA</param>
	    	</generator>
	  	</id>
	  	
	  	<property name="duracion" column="PRPR_DURACION"/>
	  	
	  	<property name="dias" column="PRPR_DIAS"/>
	  	<property name="fecha" column="PRPR_FECHA"/>
	  	
	  	<property name="diasVista" column="PRPR_DIAS_VISTA_AUX"/>
	  	<property name="mesesVista" column="PRPR_MESES_VISTA_AUX"/>
	  	
	  	<many-to-one name="proyecto" class="co.edu.unal.hermes.modelo.Proyecto" column="PRY_ID" not-null="true" lazy="false"/>
	  	
		<many-to-one name="responsable" class="co.edu.unal.hermes.modelo.Persona" 
		  	lazy="false">
			<column name="PRPR_ID_RESPONSABLE"/>
			<column name="PRPR_TDO_ID_RESPONSABLE"/>
		</many-to-one>	  	
		
	  	<property name="estado" column="PRPR_ESTADO"/>
		
	  	<property name="fechaEliminacion" column="PRPR_FECHA_ELIMINACION"/>
	  	
		<many-to-one name="responsableEliminacion" class="co.edu.unal.hermes.modelo.Persona" 
		  	lazy="false">
			<column name="PRPR_ID_RESP_ELIMINACION"/>
			<column name="PRPR_TDO_ID_RESPONSABLE_ELIMIN"/>
		</many-to-one>	 
		
	  	<property name="esPeriodoSuspension" column="PRPR_ES_PERIODO_SUSPENCION"/> 	
	  	<property name="aplicadaABiodiversidad" column="PRPR_APLICADA_BIO"/> 	
	  	
 	</class>
</hibernate-mapping>

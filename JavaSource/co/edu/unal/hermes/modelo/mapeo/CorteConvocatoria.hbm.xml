<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="co.edu.unal.hermes.modelo">
 <class name="CorteConvocatoria" table="HER_CORTE_CONVOCATORIA">
  <id name="id" column="CRT_ID" type="long">
   <generator class="sequence">
    <param name="sequence">CRT_ID_SEQ</param>
   </generator>
  </id>
  <property name="numero" column="CRT_NUMERO" />
  <property name="fechaInicial" column="CRT_FECHA_INICIAL" />
  <property name="fechaFinal" column="CRT_FECHA_FINAL" />
  <property name="fechaCreacion" column="CRT_FECHA_CREACION" />
  <property name="fechaEliminacion" column="CRT_FECHA_ELIMINACION" />
  <many-to-one name="convocatoriaPadre" 
  	class="ConvocatoriaPadre" 
  	column="CNP_ID" not-null="true"/>
  <property name="documento" column="PER_ID"/>
  <property name="tipoDocumento" column="TDO_ID"/>
  <property name="estado" column="CRT_ESTADO"/>
  <property name="fechaInicioReclamacion" column="CON_FECHA_INI_RECLAMACION"/>
  <property name="fechaFinalReclamacion" column="CON_FECHA_FIN_RECLAMACION"/>
  <property name="fechaInicioReclamacionEvaluacion" column="CON_FECHA_INI_RECLAMACION_EVAL"/>
  <property name="fechaFinalReclamacionEvaluacion" column="CON_FECHA_FIN_RECLAMACION_EVAL"/>
  <property name="tieneOficioElegibles" column="CRT_TIENE_OFICIO_ELEGIBLES" type="yes_no"/>
  <property name="textoOficioElegibles" column="CRT_TEXTO_OFICIO_ELEGIBLES" />
  <property name="fechaOficioElegibles" column="CRT_FECHA_OFICIO_ELEGIBLES" />
  <property name="idPersonaOficioElegibles" column="CRT_PER_ID_OFICIO_ELEGIBLES" />
  <property name="tipoIdPersonaOficioElegibles" column="CRT_TDO_ID_OFICIO_ELEGIBLES" />  
  <property name="tieneOficioAprobados" column="CRT_TIENE_OFICIO_APROBADOS" type="yes_no"/>
  <property name="textoOficioAprobados" column="CRT_TEXTO_OFICIO_APROBADOS" />
  <property name="fechaOficioAprobados" column="CRT_FECHA_OFICIO_APROBADOS" />
  <property name="idPersonaOficioAprobados" column="CRT_PER_ID_OFICIO_APROBADOS" />
  <property name="tipoIdPersonaOficioAprobados" column="CRT_TDO_ID_OFICIO_APROBADOS" />
  <property name="mostrarVigenciaAprobados" column="CRT_MOSTRAR_VIGENCIA_OFICIO_AP" type="yes_no"/>
  <property name="mostrarFirmaAprobados" column="CRT_FIRMA_OFICIO_APROBADOS" type="yes_no"/>
  <property name="responsableOficioAprobados" column="CRT_RESPONS_OFICIO_APROBADOS" />
  <property name="cargoResponsableOficioAprobados" column="CRT_CARGO_RESP_OFICIO_APROBADO" />
  <property name="numeroOficioAprobados" column="CRT_NUMERO_OFICIO_APROBAD" />
  <many-to-one name="dependenciaGeneradoraOficioAprobados" class="Dependencia" column="CRT_DEP_GENERACION_OFICIO_AP" lazy="false" />
  <property name="fechaGeneracionOficioAprobados" column="CRT_FECHA_GENERACION_OFICIO_AP" />
  <property name="vigenciaAprobados" column="CRT_VIGENCIA_OFICIO_APROBADOS" />
  <property name="fechaPublicacionResultados" column="CRT_FECHA_PUBLICACION_RESULTAD"/>
  <property name="numProyPorInvPorConvPorCorte" column="CRT_NUM_PROY_POR_PROFESOR"/>
  
  
  <many-to-one name="sede" lazy="false"
  	class="Sede" 
  	column="SED_ID" not-null="true"/>
 </class>
</hibernate-mapping>
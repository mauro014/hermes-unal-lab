<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="co.edu.unal.hermes.modelo">
	<class name="SemilleroIntegranteTipo"
		table="HER_SEMILLERO_INTEGRANTE_TIPO">
		<id name="id" column="SIT_ID" type="string">
			<generator class="assigned" />
		</id>
		<property name="tipo" column="SIT_TIPO" />
		<property name="nombre" column="SIT_NOMBRE" />
	</class>
</hibernate-mapping>
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="co.edu.unal.hermes.modelo">
 <class name="DependenciaAreaResponsabilidad" table="HER_PROYECTO_DEPENDENCIA">
  <id name="id" column="PRD_ID" type="long">
   <generator class="sequence">
    <param name="sequence">SEQ_PROYECTO_DEPENDENCIA</param>
   </generator>
  </id>
  
  <many-to-one name="proyecto" class="Proyecto" column="PRY_ID" not-null="true" lazy="false"/>  
  <many-to-one name="dependencia" class="Dependencia" column="DPN_ID" not-null="true" lazy="false"/>  
  
  <property name="areaResponsabilidad" column="PRD_AREA_RESPONSABILIDAD"/>
  <property name="valorAporte" column="PRD_VALOR_APORTE"/>
  

 </class>
</hibernate-mapping>

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="co.edu.unal.hermes.modelo.laboratorios">
	<class name="LaboratorioObservaciones" table="HER_LAB_OBSERVACIONES">
		<id name="id" column="LOB_ID" type="long">
			<generator class="sequence">
				<param name="sequence">SEQ_LAB_OBSERVACIONES</param>
			</generator>
		</id>
		<property name="formulario" column="LOB_FORM" />
		<property name="descripcion" column="LOB_DESCRIPCION" />
		<property name="fecha" column="LOB_FECHA" />

		<many-to-one name="laboratorio" class="Laboratorio" column="LAB_ID" not-null="true" />
		
		<many-to-one name="persona" class="co.edu.unal.hermes.modelo.Persona" not-null="true" lazy="false">
			<column name="PER_ID" />
			<column name="TDO_ID" />
		</many-to-one>		
		
	</class>
</hibernate-mapping>

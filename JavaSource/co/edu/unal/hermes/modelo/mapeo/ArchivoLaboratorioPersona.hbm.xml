<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="co.edu.unal.hermes.modelo.laboratorios">

	<class name="ArchivoLaboratorioPersona" table="HER_ARCHIVO_LAB_PERSONA">

		<id name="id" column="HALP_ID" type="long">
			<generator class="sequence">
				<param name="sequence">SEQ_ARCH_LABORATORIO_PERSONA</param>
			</generator>
		</id>

		<many-to-one name="persona" class="co.edu.unal.hermes.modelo.Persona" not-null="true" lazy="false">
			<column name="HALP_PER_ID" />
			<column name="HALP_TDO_ID" />
		</many-to-one>
		
		<many-to-one name="laboratorio" column="HALP_LAB_ID" class="Laboratorio"
			not-null="true" lazy="false" />

		<many-to-one name="tipoArchivo" class="co.edu.unal.hermes.modelo.Tipos"
			column="HALP_TIPO_ARCHIVO" lazy="false" />

		<property name="nombreArchivo" column="HALP_NOMBRE_ARCHIVO" />

		<property name="fechaRegistro" column="HALP_FECHA_REGISTRO" />

	</class>

</hibernate-mapping>
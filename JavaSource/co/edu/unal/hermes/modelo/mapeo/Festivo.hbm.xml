<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="co.edu.unal.hermes.modelo">
 <class name="Festivo" table="HER_FESTIVOS">
  <id name="id" column="FES_ID" type="long">
   <generator class="assigned"/>
  </id>
  <property name="dia" column="FES_DIA"/>
 <property name="mes" column="FES_MES"/>
 <property name="ano" column="FES_ANO"/>
 </class>
</hibernate-mapping>

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="co.edu.unal.hermes.modelo">

 <class name="MovilidadEstudiantesProducto" table="HER_MOV_EST_PRODUCTO">
 
  <id name="id" column="MOP_ID" type="long">
   <generator class="sequence">
    <param name="sequence">SEQ_MOV_EST_PRODUCTO</param>
   </generator>
  </id>
  
  <property name="descripcion" column="MOP_DESCRIPCION"/>
  
  <many-to-one name="movilidad" class="MovilidadEstudiantesPosgrado" 
  	column="MOV_ID"  lazy="false"
  	/>
  <many-to-one name="producto" class="ProductoTipo" 
  	column="PRD_ID" not-null="true" lazy="false"/>
   
 </class>
</hibernate-mapping>

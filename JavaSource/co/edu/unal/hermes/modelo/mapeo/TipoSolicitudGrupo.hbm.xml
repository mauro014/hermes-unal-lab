<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="co.edu.unal.hermes.modelo">
 	<class name="TipoSolicitudGrupo" table="HER_TIPO_SOLICITUD_GRUPO">
  		<id name="id" column="TSg_ID" type="long">
	  	</id>
	  	<property name="nombre" column="TSG_NOMBRE" type="string"/>
	  	<property name="descripcion" column="TSG_DESCRIPCION" type="string"/>
	  	<property name="vigencia" column="TSG_VIGENCIA"/> 
 	</class>
</hibernate-mapping>

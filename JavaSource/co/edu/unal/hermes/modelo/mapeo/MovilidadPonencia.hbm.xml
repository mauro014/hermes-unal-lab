<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 2.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="co.edu.unal.hermes.modelo">
 <class name="MovilidadPonencia" table="HER_MOVILIDAD_TIPO_DE">
 
  <id name="id" column="MOP_ID" type="long">
    <generator class="sequence">
    <param name="sequence">SEQ_MOVILIDAD_TIPO_DE</param>
   </generator> 
  </id>
  
  <many-to-one name="movilidad" class="MovilidadDocentesExterior"  column="MOV_ID" not-null="true" lazy="false"/>
  <many-to-one name="tipoMovilidad" class="TipoMovilidad"  column="MOV_ID_TIPO" not-null="true" lazy="false"/>
  <many-to-one name="ponencia" class="TipoPonencia"  column="TPO_ID" not-null="true" lazy="false"/>
  
  
   <property name="evento" column="MOV_EVENTO"/>
  <property name="titulo" column="MOV_TITULO"/>
  
  <property name="otra" column="MOP_OTRA"/>
  
 </class>
</hibernate-mapping>

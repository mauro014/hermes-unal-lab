<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="co.edu.unal.hermes.modelo">
 <class name="GrupoPosdoctorado" table="HER_GRUPO_POSDOCTORADO">
  
  <id name="id" column="GPO_ID" type="long" unsaved-value="-1">
   <generator class="sequence">
    <param name="sequence">SEQ_GRUPO_POSDOCTORADO</param>    					   
   </generator>
  </id>
  
   <property name="grupo" column="GRU_ID"/>
   <property name="estancia" column="POD_ID"/>
    
 </class>
</hibernate-mapping>




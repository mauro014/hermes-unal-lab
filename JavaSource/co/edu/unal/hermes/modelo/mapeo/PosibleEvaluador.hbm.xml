<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="co.edu.unal.hermes.modelo">
 <class name="PosibleEvaluador" table="HER_POSIBLE_EVALUADOR">
  <id name="id" column="PEV_ID" type="long">
   <generator class="sequence">
    <param name="sequence">SEQ_POSIBLE_EVALUADOR</param>
   </generator>
  </id>
  <property name="nombre" column="PEV_NOMBRE"/>
  <property name="email" column="PEV_EMAIL"/>
  <property name="telefono" column="PEV_TELEFONO"/>
  <property name="fax" column="PEV_FAX"/>
  <property name="institucion" column="PEV_INSTITUCION"/>
  <property name="experticia" column="PEV_EXPERTICIA"/>
  <property name="direccionPostal" column="PEV_DIRECION_POSTAL"/>
  <property name="apellido1" column="PEV_APELLIDO1"/>
  <property name="apellido2" column="PEV_APELLIDO2"/>
  <property name="ciudad" column="PEV_CIUDAD"/>
  <property name="tipo" column="PEV_TIPO"/>   
  
   <property name="documento" column="PER_ID"/>
   <property name="tipoDocumento" column="TDO_ID"/>
  
  
  <many-to-one name="proyecto" class="Proyecto" column="PRY_ID" not-null="true"/>
  <many-to-one name="clasificacionConocimiento" class="ClasificacionConocimiento" column="CLC_ID" lazy="false"/>
 </class>
</hibernate-mapping>

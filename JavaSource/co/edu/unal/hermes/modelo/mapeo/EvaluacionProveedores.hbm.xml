<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="co.edu.unal.hermes.modelo.laboratorios">

	<class name="EvaluacionProveedores" table="HER_LAB_EVALUACION_PROVEEDORES">

		<id name="id" column="HLEP_ID" type="long">
			<generator class="sequence">
				<param name="sequence">SEQ_DETALLE</param>
			</generator>
		</id>

		<property name="tipoDocumento" column="HLEP_TDO_ID" />

		<property name="documento" column="HLEP_PER_ID" />

		<property name="fechaRegistro" column="HLEP_FECHA_REGISTRO" />

		<property name="cargo" column="HLEP_CARGO" />

		<many-to-one name="sede" class="co.edu.unal.hermes.modelo.Sede"
			column="HLEP_SED_ID" lazy="false" />

		<many-to-one name="facultad" class="co.edu.unal.hermes.modelo.Dependencia"
			column="HLEP_FACULTAD_ID" lazy="false" />

		<many-to-one name="departamento" class="co.edu.unal.hermes.modelo.Dependencia"
			column="HLEP_DEPARTAMENTO_ID" lazy="false" />

		<many-to-one name="mecanismoAdquisicion" class="co.edu.unal.hermes.modelo.Tipos"
			column="HLEP_MECANISMO_ADQUISICION_ID" lazy="false" />

		<many-to-one name="tipoAdquisicion" class="co.edu.unal.hermes.modelo.Tipos"
			column="HLEP_TIPO_ADQUISICION_ID" lazy="false" />

		<property name="numeroOrden" column="HLEP_NUMERO_ORDEN" />

		<property name="annioOrden" column="HLEP_ANNIO_ORDEN" />

		<property name="objetoContrato" column="HLEP_OBJETO" />

		<many-to-one name="empresa" class="co.edu.unal.hermes.modelo.Empresa"
			column="HLEP_EMPRESA_ID" lazy="false" />

		<property name="otrosProductos" column="HLEP_OTROS_PRODUCTOS" />

		<property name="calidad" column="HLEP_CALIDAD_TIPO_ID" />
		<property name="comentarioCalidad" column="HLEP_COMENTARIO_CALIDAD" />
		<property name="oportunidad" column="HLEP_OPORTUNIDAD_TIPO_ID" />
		<property name="comentarioOportunidad" column="HLEP_COMENTARIO_OPORTUNIDAD" />
		<property name="documentos" column="HLEP_DOCUMENTOS_TIPO_ID" />
		<property name="comentarioDocumentos" column="HLEP_COMENTARIO_DOCUMENTOS" />
		<property name="comportamiento" column="HLEP_COMPORTAMIENTO_TIPO_ID" />
		<property name="comentarioComportamiento" column="HLEP_COMENTARIO_COMPORTAMIENTO" />
		<property name="asesoria" column="HLEP_ASESORIA_TIPO_ID" />
		<property name="comentarioAsesoria" column="HLEP_COMENTARIO_ASESORIA" />
		<property name="recomendacion" column="HLEP_RECOMENDACION_TIPO_ID" />
		<property name="comentarioRecomendacion" column="HLEP_COMENTARIO_RECOMENDACION" />

	</class>

</hibernate-mapping>
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="co.edu.unal.hermes.modelo.laboratorios">

	<class name="LaboratorioEquipoConsumibleRepuesto" table="HER_LAB_EQUIPO_CONSUM_REPUESTO">

		<id name="id" column="LECR_ID" type="long">
			<generator class="sequence">
				<param name="sequence">SEQ_LAB_EQUIPO_CONSUM_REPUESTO</param>
			</generator>
		</id>

		<many-to-one name="equipo"
			class="co.edu.unal.hermes.modelo.laboratorios.LaboratorioDetalleEquipos"
			column="LDE_ID" lazy="false" />

		<property name="nombre" column="LECR_NOMBRE" />

		<property name="referencia" column="LECR_REFERENCIA" />

		<property name="cantidad" column="LECR_CANTIDAD" />

		<property name="tiempoEstimado" column="LECR_TIEMPO_ESTIMADO" />

		<property name="fechaRegistro" column="LECR_FECHA_REGISTRO" />

		<property name="fechaActualizacion" column="LECR_FECHA_ACTUALIZACIÓN" />
		
		<property name="fechaCambio" column="LECR_FECHA_CAMBIO" />
		<property name="costo" column="LECR_COSTO" />

	</class>

</hibernate-mapping>
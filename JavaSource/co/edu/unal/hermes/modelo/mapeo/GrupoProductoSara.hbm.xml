<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="co.edu.unal.hermes.modelo">
	<class name="GrupoProductoSara" table="HER_GRUPO_PRODUCTO_SARA">
		<id name="id" column="GPS_ID" type="long">
			<generator class="sequence">
				<param name="sequence">SEQ_GRUPO_PRODUCTO_SARA</param>
			</generator>
		</id>
		<many-to-one name="grupo" class="Grupo"
			column="GRU_ID" not-null="true" lazy="false" />

		<property name="tipoProducto" column="GPS_TIPO" />
		<property name="nombreProducto" column="GPS_NOMBRE" />		
		 
	</class>
</hibernate-mapping>

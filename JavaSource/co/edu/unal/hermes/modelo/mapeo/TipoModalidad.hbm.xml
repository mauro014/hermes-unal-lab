<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="co.edu.unal.hermes.modelo">
 <class name="TipoModalidad" table="HER_TIPO_MODALIDAD">
  <id name="id" column="TMO_ID" type="text">
   <generator class="assigned"/>
  </id>
  <property name="nombre" column="TMO_NOMBRE"/>
  <property name="estado" column="TMO_ESTADO"/>
   <set name="tiposInvestigacion" table="HER_TIPOMOD_TIPOINVCON" lazy="false" inverse="false" >
      <key>
        <column name="TMO_ID" not-null="false"/>
      </key>
      <many-to-many class="TipoInvestigacion">
        <column name="TIN_ID" not-null="false" />
      </many-to-many>
    </set>
	<set name="formularios" table="HER_FORMULARIO_TIPO_MODALIDAD" lazy="false" inverse="false" order-by="FRM_ID">
   <key column="TMO_ID"/>
   <many-to-many class="Formulario" column="FRM_ID"/>
  </set>
 </class>
</hibernate-mapping>

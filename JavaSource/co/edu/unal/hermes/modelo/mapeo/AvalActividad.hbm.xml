<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="co.edu.unal.hermes.modelo">
 <class name="AvalActividad" table="HER_AVAL_ACTIVIDAD">
  <id name="id" column="ACT_ID" type="long">
   <generator class="sequence">
    <param name="sequence">SEQ_AVAL_ACTIVIDAD</param>
   </generator>
  </id>
  <property name="descripcion" column="ACT_DESCRIPCION"/>
  <property name="mesInicial" column="ACT_MES_INICIAL"/>
  <property name="duracionMeses" column="ACT_DURACION_MESES"/>
  <many-to-one name="aval" class="Aval" column="AVI_ID" not-null="true"/>
 </class>
</hibernate-mapping>

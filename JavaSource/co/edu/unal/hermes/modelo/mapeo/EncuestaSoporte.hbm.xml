<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="co.edu.unal.hermes.modelo">
 <class name="EncuestaSoporte" table="HER_ENCUESTA_SOPORTE">
  <id name="id" column="ENC_ID" type="long">
   <generator class="sequence">
    <param name="sequence">SEQ_ENCUESTA_SOPORTE</param>
   </generator>
  </id>
 
  <property name="atencion" column="ENC_ATENCION" not-null="true"/>
  <property name="tiempo" column="ENC_TIEMPO" not-null="true"/>
  <property name="proceso" column="ENC_PROCESO" />
  <property name="fecha" column="ENC_FECHA" not-null="true"/>
   
   <many-to-one name="idSede" column="SED_ID"
			class="co.edu.unal.hermes.modelo.Sede" lazy="false" />
 
   <property name="solucion" column="ENC_SOLUCION" />
   <property name="observaciones" column="ENC_OBSERVACIONES" />
   
   
 </class>
</hibernate-mapping>

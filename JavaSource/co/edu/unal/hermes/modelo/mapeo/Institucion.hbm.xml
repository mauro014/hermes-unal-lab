<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="co.edu.unal.hermes.modelo">
 <class name="Institucion" table="HER_INSTITUCION">
  <id name="id" column="INS_ID" type="string">
	 <generator class="sequence">
	    <param name="sequence">SEQ_INSTITUCION</param>
	 </generator>
  </id>
  <property name="nombre" column="INS_NOMBRE"/>
 </class>
</hibernate-mapping>

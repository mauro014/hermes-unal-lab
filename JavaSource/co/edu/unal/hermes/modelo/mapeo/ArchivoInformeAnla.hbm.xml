<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 2.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="co.edu.unal.hermes.modelo">
	<class name="ArchivoInformeAnla" table="HER_ARCHIVO_INFORME_ANLA">
		<id name="id" column="AIA_ID" type="long">
			<generator class="sequence">
    			<param name="sequence">SEQ_ARCHIVO_INFORME_ANLA</param>
   			</generator>
		</id>

		<many-to-one name="informe" class="PermisoInformeAnla"  column="PIA_ID" not-null="true" lazy="false"/>

		<property name="nombre" column="AIA_NOMBRE" type="string"/>
		<property name="fecha" column="AIA_FECHA" type="date"/>
		
	</class>
</hibernate-mapping>
<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="co.edu.unal.hermes.modelo">
 <class name="InvestigadorEvento" table="HER_INVESTIGADOR_EVENTO">
  <id name="id" column="INE_ID" type="long">
   <generator class="sequence">
    <param name="sequence">SEQ_INVESTIGADOR_EVENTO</param>
   </generator>
  </id>
  
  <many-to-one name="investigador" class="InvestigadorInterno" not-null="true" lazy="false">
  	<column name="INV_ID"/>
    <column name="TDO_ID"/>
  </many-to-one>
  
  <many-to-one name="pais" column="PAIS_ID" class="Pais" lazy="false"/>
  <property name="nombre" column="INE_NOMBRE_EVENTO"/>
  <property name="tituloTrabajo" column="INE_TITULO_TRABAJO"/>  
  <property name="fecha" column="INE_FECHA"/>
  <property name="ciudadPais" column="INE_CIUDAD_PAIS"/>    

 </class>
</hibernate-mapping>


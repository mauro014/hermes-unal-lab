<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="co.edu.unal.hermes.modelo">

 <class name="ProyectoProducto" table="HER_PROYECTO_PRODUCTO">
 
  <id name="id" column="PRP_ID" type="long">
   <generator class="sequence">
    <param name="sequence">SEQ_PROYECTO_PRODUCTO</param>
   </generator>
  </id>
  
  <property name="cantidad" column="PRP_CANTIDAD"/>
  <property name="descripcion" column="PRP_DESCRIPCION"/>
  
  <many-to-one name="proyecto" class="Proyecto" column="PRY_ID" not-null="true" lazy="false"/>
  <many-to-one name="producto" class="ProductoTipo" column="PRD_ID" not-null="true" lazy="false"/>
   
 </class>
</hibernate-mapping>

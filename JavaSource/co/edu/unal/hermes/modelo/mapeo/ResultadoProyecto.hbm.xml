<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="co.edu.unal.hermes.modelo">
 <class name="ResultadoProyecto" table="HER_RESULTADO_PROYECTO">
  <id name="id" column="RST_ID" type="long">
   <generator class="sequence">
    <param name="sequence">SEQ_RESULTADO_PROYECTO</param>
   </generator>
  </id>
  <property name="descripcion" column="RST_DESCRIPCION"/>
  <property name="entregable" column="RST_ENTREGABLE"/>
  <property name="fechaEntregable" column="RST_FECHA_ENTREGABLE"/>
  <many-to-one name="proyecto" class="Proyecto" column="PRY_ID" not-null="true"/>
  
  <property name="numeroOrden" column="RST_ORDEN" />
  
 </class>
</hibernate-mapping>

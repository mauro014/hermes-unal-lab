<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="co.edu.unal.hermes.modelo">
 <class name="TipoPregunta" table="HER_TIPO_PREGUNTA">
  <id name="id" column="ID" type="long">
   <generator class="assigned"/>
  </id>
  <property name="nombre" column="NOMBRE"/>
  <property name="minimo" column="MIN"/>
  <property name="maximo" column="MAX"/>
  <property name="pagina" column="PAGINA"/>
  <property name="seTieneParaPromedio" column="SE_TIENE_PARA_PROMEDIO"/>
  <set name="opciones" table="HER_OPC_MUL_TIPO_PREGUNTA" lazy="false" order-by="OPC_ID asc">
  	<key column="TPP_ID"/>
  	<many-to-many class="OpcionMultiple" column="OPC_ID"/>   
  </set>
 </class>
</hibernate-mapping>

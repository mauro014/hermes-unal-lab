<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="co.edu.unal.hermes.modelo">
 <class name="CorreoPersonaBoletin" table="HER_CORREO_PERSONA">
  <id name="id" column="PER_ID" type="long">
		<generator class="assigned"/>
  </id>
   
  <property name="correoPersona" column="PER_EMAIL"/>
   <property name="sede" column="PER_SEDE"/>

    
 </class>
</hibernate-mapping>

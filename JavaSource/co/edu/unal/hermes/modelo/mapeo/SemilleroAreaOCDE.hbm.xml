<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="co.edu.unal.hermes.modelo">
	<class name="SemilleroAreaOCDE"
		table="HER_SEMILLERO_AREA_OCDE">
		<composite-id>
			<key-many-to-one name="semillero" class="Semillero"
				column="SEM_ID" lazy="false">
			</key-many-to-one>
			<key-many-to-one name="subAreaOCDE"
				class="DominioDetalle" lazy="false">
				<column name="DOM_ID" />
				<column name="DOMDET_TIPO" />
			</key-many-to-one>
		</composite-id>
	</class>
</hibernate-mapping>
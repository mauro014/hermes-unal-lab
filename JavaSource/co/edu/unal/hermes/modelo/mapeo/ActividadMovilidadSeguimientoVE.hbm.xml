<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="co.edu.unal.hermes.modelo">
	<class name="ActividadMovilidadSeguimientoVE" table="HER_ACTIVIDAD_SEGUIMIENTO_VE">

		<id name="id" column="ACS_MOV_ID" type="long" unsaved-value="-1">
			<generator class="sequence">
				<param name="sequence">SEQ_ACTIVIDAD_SEGUIMIENTO_VE</param>
			</generator>
		</id>

		<property name="descripcion" column="ACS_MOV_DESCRIPCION" />
		<many-to-one name="movilidad" class="MovilidadVisitanteExterior"
			column="MOV_ID" />
	</class>
</hibernate-mapping>

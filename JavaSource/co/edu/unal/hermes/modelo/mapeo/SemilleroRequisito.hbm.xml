<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="co.edu.unal.hermes.modelo">
	<class name="SemilleroRequisito"
		table="HER_SEMILLERO_REQUISITO">
		<id name="id" column="SRQ_ID" type="integer">
			<generator class="assigned" />
		</id>
		<property name="nombre" column="SRQ_NOMBRE" />
		<property name="visible" column="SRQ_VISIBLE" />
	</class>
</hibernate-mapping>
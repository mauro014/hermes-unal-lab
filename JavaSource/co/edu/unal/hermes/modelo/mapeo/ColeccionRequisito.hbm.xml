<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="co.edu.unal.hermes.modelo">
	<class name="ColeccionRequisito" table="HER_COLECCION_REQUISITO">
		<id name="id" column="COR_ID" type="long">
			<generator class="sequence">
				<param name="sequence">SEQ_COLECCION_REQUISITO</param>
			</generator>
		</id>
			
		<many-to-one name="requisito" class="DominioDetalle" lazy="false">
			<column name="DOM_REQUISITO" />
			<column name="DOMDET_REQUISITO" />
		</many-to-one>
		
		<property name="cumplido" column="COR_CUMPLE" />
		
		<many-to-one name="gestion" column="COG_ID" class="ColeccionGestion"
			lazy="false" />
			
	</class>
</hibernate-mapping>

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="co.edu.unal.hermes.modelo.laboratorios">
 <class name="LaboratorioAreasSecundariasOCDE" table="HER_LABORATORIO_AREA_SEC_OCDE">
  
  <id name="id" column="LAS_ID" type="long">
   <generator class="sequence">
    <param name="sequence">SEQ_AREAS_SEC_LABORATORIOS</param>
   </generator>
  </id>
  
  <many-to-one name="laboratorio" class="co.edu.unal.hermes.modelo.laboratorios.Laboratorio" column="LAB_ID" not-null="true" lazy="false"/>  
  <many-to-one name="area" class="co.edu.unal.hermes.modelo.Tipos" column="LAS_AREA" not-null="true" lazy="false"/>
  <many-to-one name="subarea" class="co.edu.unal.hermes.modelo.Tipos" column="LAS_SUBAREA" not-null="true" lazy="false"/>
  <property name="fechaRegistro" column="LAS_FECHA_REGISTRO" />

 </class>
</hibernate-mapping>

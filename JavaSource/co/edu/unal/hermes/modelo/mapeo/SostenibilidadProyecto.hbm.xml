<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="co.edu.unal.hermes.modelo">
 <class name="SostenibilidadProyecto" table="HER_PROYECTO_SOSTENIBILIDAD">
  <id name="id" column="SOS_ID" type="long">
   <generator class="sequence">
    <param name="sequence">SEQ_SOSTENIBILIDAD</param>
   </generator>
  </id>
  <property name="nivelSostenibilidad" type="string" column="SOS_NIVEL"/>
  <property name="porqueNivelSostenibilidad" type="string" column="SOS_POR_QUE_NIVEL"/>
  <property name="continuidadProyecto" type="string" column="SOS_CONTINUIDAD"/>
  <property name="porqueContinuidadProyecto" type="string" column="SOS_POR_QUE_CONTINUIDAD"/>
  <property name="articulacionIniciativas" type="string" column="SOS_ARTICULACION_INICIATIVAS"/>
  <property name="aliados" type="string" column="SOS_ALIADOS"/>
  <property name="observaciones" type="string" column="SOS_OBSERVACIONES"/>
  <many-to-one name="proyecto" class="Proyecto" column="PRY_ID" not-null="true"/>
 </class>
</hibernate-mapping>

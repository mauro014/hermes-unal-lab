<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="co.edu.unal.hermes.modelo">
	<class name="SemilleroSolicitudArchivo"
		table="HER_SEMILLERO_SOL_ARCHIVO">
		<id name="id" column="SSA_ID" type="integer">
			<generator class="sequence">
				<param name="sequence">SEQ_SEMILLERO_SOL_ARCHIVO</param>
			</generator>
		</id>
		<many-to-one name="solicitud" class="SemilleroSolicitud"
			column="SSO_ID" lazy="false"/>
		<property name="nombre" column="SSA_NOMBRE" />
		<property name="tipo" column="SSA_TIPO" />
	</class>
</hibernate-mapping>
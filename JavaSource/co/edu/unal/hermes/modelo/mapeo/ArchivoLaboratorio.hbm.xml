<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="co.edu.unal.hermes.modelo.laboratorios">

	<class name="ArchivoLaboratorio" table="HER_ARCHIVO_LABORATORIO">

		<id name="id" column="HAL_ID" type="long">
			<generator class="sequence">
				<param name="sequence">SEQ_ARCHIVO</param>
			</generator>
		</id>

		<property name="idDetalle" column="HAL_LDE_ID" />

		<property name="idLab" column="HAL_LAB_ID" />

		<property name="nombreArchivo" column="HAL_NOMBRE_ARCHIVO" />

		<many-to-one name="tipoArchivo" class="co.edu.unal.hermes.modelo.Tipos"
			column="HAL_TIPO_ARCHIVO" lazy="false" />
			
<!-- 		<many-to-one name="actividad" class="co.edu.unal.hermes.modelo.laboratorios.ArchivoLaboratorioActividad" not-null="true" lazy="false"> -->
<!-- 			<column name="HAL_HLAE" /> -->
<!-- 		</many-to-one>  -->

		<property name="fechaArchivo" column="HAL_FECHA_ARCHIVO" />
		
<!-- 		<property name="idSol" column="HAL_LAB_ID" /> -->
		
<!-- 		<property name="idActividad" column="HAL_LAB_ID" /> -->
		
		<many-to-one name="solicitud" class="co.edu.unal.hermes.modelo.laboratorios.LaboratorioSolicitud"
			column="HAL_SOLICITUD" lazy="false" />
			
		<many-to-one name="actividad" class="co.edu.unal.hermes.modelo.laboratorios.LaboratorioActividadEquipo"
			column="HAL_HLAE" lazy="false" />
		
		<many-to-one name="reporteDanio" class="co.edu.unal.hermes.modelo.laboratorios.LaboratorioEquipoReporteDanio"
			column="LERD_ID" lazy="false" />
		
		<many-to-one name="insumo" class="co.edu.unal.hermes.modelo.laboratorios.InsumoLaboratorio"
			column="HAL_HIL_ID" lazy="false" />

	</class>

</hibernate-mapping>
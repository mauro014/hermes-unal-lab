<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="co.edu.unal.hermes.modelo.seguimiento">
 	<class name="TramiteSolicitud" table="HER_TRAMITE_SOLICITUD">
  		<id name="id" column="TRS_ID" type="long">
   			<generator class="sequence">
         		<param name="sequence">SEQ_TRAMITE_SOLICITUD</param>
	    	</generator>
	  	</id>
	  	
	  	<property name="fecha" column="TRS_FECHA" type="date"/>
	  	<property name="descripcion" column="TRS_DESCRIPCION" type="string"/>
	  	
	  	<many-to-one name="asesor" class="co.edu.unal.hermes.modelo.Persona" not-null="true" lazy="false">
  			<column name="PER_ID"/>
    		<column name="TDO_ID"/>
  		</many-to-one>
	  	<many-to-one name="solicitud" class="Solicitud" column="SOL_ID" not-null="false" lazy="false"/><!--
	  	
	  	<set name="documentos" table="HER_TRAMITE_DOCUMENTO" inverse="true" cascade="all-delete-orphan">
	  		<key column="TRS_ID"/>
	  		<one-to-many class="TramiteDocumento"/>
	  	</set>
	  		  	
 	--></class>
</hibernate-mapping>

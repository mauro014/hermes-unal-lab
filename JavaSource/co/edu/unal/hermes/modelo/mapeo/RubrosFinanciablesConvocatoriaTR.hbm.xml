<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="co.edu.unal.hermes.modelo">

	<class name="RubrosFinanciablesConvocatoriaTR" table="HER_CONVOCATORIA_TR_RUBROS">

		<id column="CON_TR_TRU_ID" name="id" type="long">
			<generator class="sequence">
				<param name="sequence">SEQ_RUBROS_CONV_TR</param>
			</generator>
		</id>
		<property name="justificacion" column="CON_TR_TRU_JUSTIFICACION" />
		<property name="orden" column="CON_TR_TRU_ORDEN"/>		
		<many-to-one name="convocatoriaTR" class="ConvocatoriaTerminosReferencia" column="CON_TR_ID" not-null="true" lazy="false"/>
		<many-to-one name="tipoRubro" column="TRU_ID" class="TipoRubro"
			not-null="true" lazy="false" />
	</class>
</hibernate-mapping>
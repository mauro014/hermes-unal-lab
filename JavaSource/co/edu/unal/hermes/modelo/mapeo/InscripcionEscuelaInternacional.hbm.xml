<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
                                                                     
<hibernate-mapping package="co.edu.unal.hermes.modelo">

 <class name="InscripcionEscuelaInternacional" table="HER_INSCRIPCION_ESC_INT">
  
  <id column="IEI_ID" name="id" type="long">
	
	<generator class="sequence">
    			<param name="sequence">SEQ_INSCRIPCION_ESC_INT</param>
   			</generator>
  </id>
  
  <property name="nombres" column="IEI_NOMBRES"/>
  <property name="apellidos" column="IEI_APELLIDOS"/>
  <property name="tipoDocumento" column="IEI_TDO"/>
  <property name="documento" column="IEI_DOCUMENTO"/>
  <property name="carrera" column="IEI_CARRERA"/>
  <property name="universidad" column="IEI_UNIVERSIDAD"/>
  <property name="promedio" column="IEI_PROMEDIO"/>
  <property name="credito" column="IEI_CREDITO"/>
  <property name="certificado" column="IEI_CERTIFICADO"/>
  <property name="experiencia" column="IEI_EXPERIENCIA"/>
  <property name="relacion" column="IEI_RELACION"/>
  <property name="correo" column="IEI_CORREO"/>
  <many-to-one name="tipoPersona" class="TipoPersonaEscuela"  column="IEI_TIPO_PERSONA" not-null="true" lazy="false"/>
  <property name="semestre" column="IEI_SEMESTRE"  type="long"/>
  <property name="estudianteUN" column="IEI_ESTUDIANTE_UNAL"/>
  
  <property name="actividad" column="IEI_ACTIVIDAD"/>
  <property name="institucion" column="IEI_INSTITUCION"/>
  <property name="fecha" column="IEI_FECHA"/> 
  <property name="modulo" column="IEI_MODULO" type="long"/>
  <property name="curso" column="IEI_CURSO" type="long"/> 
  
   <property name="telefonoFijo" column="IEI_TELEFONO_FIJO"/> 
  <property name="telefonoMovil" column="IEI_TELEFONO_MOVIL" />
  <property name="Facultad" column="IEI_FACULTAD" /> 
  
  
  <property name="ciudad" column="IEI_CIUDAD" type="string"/> 
  <property name="direccion" column="IEI_DIRECCION" type="string"/> 
  <property name="pais" column="IEI_PAIS" type="string"/> 
  <property name="link" column="IEI_LINK" type="string"/> 
  <property name="soporte1Nombre" column="IEI_SOPORTE1_NOMBRE" type="string"/>
  <property name="soporte1" column="IEI_SOPORTE1" type="blob"/>
  <property name="empresa" column="IEI_EMPRESA" type="string"/>
  <property name="cargo" column="IEI_CARGO" type="string"/>
  <property name="profesion" column="IEI_PROFESION" type="string"/>
  <property name="modalidad" column="IEI_MODALIDAD" type="string"/>
  <property name="estado" column="IEI_ESTADO" type="string"/>
  <property name="fechaCancela" column="IEI_FECHA_CANCELA" type="date"/>
  <property name="aceptado" column="IEI_ACEPTADO"/>
  
  <property name="aceptaFormulario" column="IEI_ACEPTA_FORM" type="string"/>
  <property name="motivacion" column="IEI_MOTIVACION" type="string"/>
  
  
 </class> 
</hibernate-mapping>

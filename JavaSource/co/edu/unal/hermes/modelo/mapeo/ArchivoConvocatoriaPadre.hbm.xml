<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 2.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="co.edu.unal.hermes.modelo">
	<class name="ArchivoConvocatoriaPadre" table="HER_ARCHIVO_CONVOCATORIA_PADRE">
		<id name="id" column="ACN_ID" type="long">
			<generator class="sequence">
    			<param name="sequence">SEQ_ARCHIVO_CONVOCATORIA_PADRE</param>
   			</generator>
		</id>
		<property name="nombre" column="ACN_NOMBRE" type="string"/>
		<property name="tipoArchivo" column="ACN_TIPO" type="string"/>
		<property name="convocatoriaPadre" column="CNP_ID" type="string"/>
		<property name="terminos" column="ACN_TERMINOS" type="string"/>
		<property name="etiqueta" column="ACN_ETIQUETA" type="string"/>
		<property name="visiblePagina" column="ACN_VISIBLE_EXT" type="string"/>
		
	</class>
</hibernate-mapping>
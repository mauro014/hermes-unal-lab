<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="co.edu.unal.hermes.modelo">
	<class name="GrupoInstitucion" table="HER_GRUPO_INSTITUCION">
		<composite-id>
			<key-many-to-one name="grupo" class="Grupo"
				column="GRU_ID" lazy="false">
			</key-many-to-one>
			<key-many-to-one name="institucion" class="FuenteFinanciacion"
				lazy="false" column="FFi_ID">
			</key-many-to-one>
		</composite-id>
	</class>
</hibernate-mapping>
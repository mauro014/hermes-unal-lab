<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="co.edu.unal.hermes.modelo">
	<class name="NegociacionPropiedadIntelectual" table="HER_PROPIEDAD_INT_NEGOCIACION">
		<id name="id" column="PIN_ID" type="long">
			<generator class="sequence">
				<param name="sequence">SEQ_PROPIEDAD_INT_NEGOCIACION</param>
			</generator>
		</id>
		<many-to-one name="propiedad" class="PropiedadIntelectual"
			column="PRI_ID" not-null="true" />
			
		<many-to-one name="entidad" class="FuenteFinanciacion"
			column="FFI_ID" lazy="false" />
		
		<property name="tiempoAnos" column="PIN_TIEMPO" />	
		<property name="formaPago" column="PIN_FORMA_PAGO" />	
		 
	</class>
</hibernate-mapping>

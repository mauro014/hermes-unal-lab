<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="co.edu.unal.hermes.modelo">
	<class name="CatalogoECP" table="HER_EXT_ECP_CATALOGO">
		<id name="id" column="ID_CATALOGO" type="long">
			<!-- <generator class="sequence"> <param name="sequence">SEQ_CATALOGO_ECP</param> 
				</generator> -->
		</id>
<!-- 		<many-to-one name="dependencia" class="Dependencia" column="ID_DEPENDENCIA" lazy="false" /> -->
		<property name="nombre" column="NOM_ACTIVIDAD" />
		<property name="objeto" column="OBJETO_ACTIVIDAD" />
		<property name="modalidad" column="COD_SUBMODALIDAD" />
		<property name="tipoEvento" column="COD_TIPO_EVENTO" />
		<property name="poblacionObjeto" column="POBLACION_OBJETIVO" />
		<property name="esOfertaPermanente" column="ES_OFERTA_PERMANENTE" />
		<property name="AnioPrimeraVez" column="ANIO_PRIMERA_VEZ" />
		<property name="MesPrimeraVez" column="MES_PRIMERA_VEZ" />
		<property name="numVersiones" column="NUM_VERSIONES" />
		<many-to-one name="ejeTematico" class="AgendaConocimiento" column="ID_EJE_DNE" lazy="false" />
		<many-to-one name="areaGeneral" class="AgendaConocimiento" column="ID_AREA_GENERAL" lazy="false" />
		<many-to-one name="areaEspecifica" class="AgendaConocimiento" column="ID_AREA_ESPECIFICA" lazy="false" />
		<property name="registroCompleto" column="REG_COMPLETO" />
		<property name="fechaRegistro" column="FEC_REGISTRO" />

<!-- 		<property name="persona" column="ID_SIGE_USUARIO" /> -->

		<property name="tieneCertificadoCalidad" column="TIENE_CERTIFICADO_CALIDAD" />
		<property name="copiaCertificadoCalidad" column="COPIA_CERTIFICADO_CALIDAD" />
		<set name="ofertaECP" table="HER_EXT_ECP_OFERTA" lazy="false">
			<key column="ID_CATALOGO" />
			<one-to-many class="OfertaECP" />
		</set>



	</class>
</hibernate-mapping>

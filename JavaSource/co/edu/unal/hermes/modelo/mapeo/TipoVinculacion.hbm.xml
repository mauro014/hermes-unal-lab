<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="co.edu.unal.hermes.modelo">
 <class name="TipoVinculacion" table="HER_TIPO_VINCULACION">
 
  <id name="id" column="TVI_ID" type="string">
   <generator class="assigned"/>
  </id>
  
  <property name="nombre" column="TVI_NOMBRE"/>
  <property name="esDocente" column="TVI_ES_DOCENTE"/>
  <property name="esAdministrativo" column="TVI_ES_ADMINISTRATIVO"/>
 </class>
</hibernate-mapping>

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 2.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="co.edu.unal.hermes.modelo">
 <class name="MovilidadArchivo" table="HER_MOVILIDAD_ARCHIVO">
 
 <id name="id" column="MAR_ID" type="long">
   <generator class="sequence">
    <param name="sequence">SEQ_MOVILIDAD_ARCHIVO</param>
   </generator>
  </id>
    
  <many-to-one name="tipoArchivo" class="TipoArchivoMovilidad"  column="TAM_ID" not-null="true" lazy="false"/>
  <many-to-one name="tipoMovilidad" class="TipoMovilidad"  column="MOV_ID_TIPO" not-null="true" lazy="false"/>
  <property name="esObligatorio" column="MAR_OBLIGATORIO" />
  <property name="submodalidad" column="MAR_SUBMODALIDAD" />
  
  
 </class>
</hibernate-mapping>

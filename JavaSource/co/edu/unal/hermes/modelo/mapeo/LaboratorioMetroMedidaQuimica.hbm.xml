<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="co.edu.unal.hermes.modelo.laboratorios">
 <class name="LaboratorioMetroMedidaQuimica" table="HER_LAB_MEDIDAS_QUIMICAS">
  
  <id name="id" column="LMQ_ID" type="long">
   <generator class="sequence">
    <param name="sequence">SEQ_LAB_MED_QUIMICA</param>
   </generator>
  </id>
  
  <many-to-one name="laboratorio" class="co.edu.unal.hermes.modelo.laboratorios.Laboratorio" column="LAB_ID" not-null="true" lazy="false"/>  
  <many-to-one name="sector" class="co.edu.unal.hermes.modelo.Tipos" column="LMQ_SECTOR" not-null="true" lazy="false"/>
  <many-to-one name="matriz" class="co.edu.unal.hermes.modelo.Tipos" column="LMQ_MATRIZ" not-null="true" lazy="false"/>
  <many-to-one name="mensurando" class="co.edu.unal.hermes.modelo.Tipos" column="LMQ_MENSURANDO" not-null="true" lazy="false"/>
  <many-to-one name="tecnica" class="co.edu.unal.hermes.modelo.Tipos" column="LMQ_TECNICA" not-null="true" lazy="false"/>
  <many-to-one name="concentracionintervaloMedicion" class="co.edu.unal.hermes.modelo.Tipos" column="LMQ_CONCEN_INTERV" not-null="true" lazy="false"/>
  
  <property name="metodoValidado" column="LMQ_METODO_VALIDO" />
  <property name="metodoValidadoDesc" column="LMQ_METODO_VALIDO_DESC" />
  
  <property name="materialesReferencia" column="LMQ_MATERIALES_REF" />
  <property name="normaMetodoReferencia" column="LMQ_NORMA_METODO_REF" />
  
  <property name="fechaRegistro" column="LMQ_FECHA_REGISTRO" />

 </class>
</hibernate-mapping>

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="co.edu.unal.hermes.modelo.laboratorios">

	<class name="LaboratorioEquipoActualizacionSoftware" table="HER_LAB_EQUIPO_ACT_SOFT">

		<id name="id" column="LEAS_ID" type="long">
			<generator class="sequence">
				<param name="sequence">SEQ_LAB_EQUIPO_ACT_SOFT</param>
			</generator>
		</id>

		<many-to-one name="equipo"
			class="co.edu.unal.hermes.modelo.laboratorios.LaboratorioDetalleEquipos"
			column="LDE_ID" lazy="false" />
			
		<many-to-one name="tipo" class="co.edu.unal.hermes.modelo.Tipos"
			column="LEAS_TIPO" lazy="false" />

		<property name="versionAnterior" column="LEAS_VERSION_ANT" />

		<property name="versionNueva" column="LEAS_VERSION_NUEVA" />

		<property name="fechaActualizacionSoftware" column="LEAS_FECHA" />
		
		<property name="responsable" column="LEAS_RESPONSABLE" />

		<property name="fechaRegistro" column="LEAS_FECHA_REGISTRO" />
		
		<property name="fechaActualizacion" column="LEAS_FECHA_ACTUALIZACIÓN" />

	</class>

</hibernate-mapping>
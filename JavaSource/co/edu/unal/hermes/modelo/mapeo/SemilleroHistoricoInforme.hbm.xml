<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="co.edu.unal.hermes.modelo">
<class name="SemilleroHistoricoCambios"
		table="HER_SEMILLERO_HIST_CAMBIOS">
		<id name="id" column="SHC_ID" type="integer">
			<generator class="sequence">
				<param name="sequence">SEQ_SEMILLERO_HIST_CAMBIOS</param>
			</generator>
		</id>
		<many-to-one name="semillero" class="Semillero"
			column="SEM_ID" lazy="false">
		</many-to-one>
		<property name="descripcion" column="SHC_DESCRIPCION" />
		<property name="fecha" column="SHC_FECHA" type="date" />
		<property name="documentoResponsable" column="PER_ID" />
		<property name="tipoDocResponsable" column="TDO_ID"/>
	</class>
</hibernate-mapping>
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 2.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="co.edu.unal.hermes.modelo">
	<class name="ArchivoAval" table="HER_ARCHIVO_AVAL">
		<id name="id" column="AAV_ID" type="long">
			<generator class="sequence">
    			<param name="sequence">SEQ_ARCHIVO_AVAL</param>
   			</generator>
		</id>
		
		<property name="nombre" column="AAV_NOMBRE" type="string"/>
		<property name="descripcion" column="AAV_DESCRIPCION" type="string"/>
		<property name="aval" column="AVI_ID" type="long"/>
		<property name="avalCoor" column="AVI_ID_COOR" type="long"/>
		<property name="tipo" column="AAV_TIPO" type="string"/>
		<property name="fechaCreacion" column="AAV_FECHA_SUBIDO" />
		<property name="fechaBorrado" column="AAV_FECHA_BORRADO" />
		<many-to-one name="tipoArchivo" class="TipoArchivo" column="TIA_ID" not-null="false" lazy="false"/>
		<!-- many-to-one name="aval" class="Aval" column="AVI_ID" /-->
		
	</class>
</hibernate-mapping>
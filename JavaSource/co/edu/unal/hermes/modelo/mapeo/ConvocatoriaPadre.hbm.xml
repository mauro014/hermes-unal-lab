<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="co.edu.unal.hermes.modelo">
	<class name="ConvocatoriaPadre" table="HER_CONVOCATORIA_PADRE">
		<id name="id" column="CNP_ID" type="long">
			<generator class="sequence">
				<param name="sequence">SEQ_CONVOCATORIA_PADRE</param>
			</generator>
		</id>
		<many-to-one name="estadoConvocatoria" class="EstadoConvocatoria"
			column="CNP_ESTADO" not-null="true" lazy="false" />
		<property name="titulo" column="CNP_TITULO" />
		<property name="ano" column="CNP_ANO" />
		<many-to-one name="dependencia" class="Dependencia"
			column="DNP_ID" lazy="false" />
		<property name="esPermanente" column="CNP_PERMANENTE" />
		<property name="esCorte" column="CNP_CORTE" />
		<property name="informacion" column="CNP_INFO" />
		<property name="categoria" column="CNP_CATEGORIA" />
		<property name="vinculo" column="CNP_VINCULO_CONVOCATORIA" />
		<property name="tipoFormularioInformes" column="CNP_TIPO_FORMULARIO_INFORMES" />
		<property name="informacionAdicionalRegistro" column="CON_INFO_ADIC_REGISTRO" />
		<property name="informeCoordinador" column="CNP_INFORME_COORDINADOR" />
		<property name="informeSedeMovilidad" column="CNP_INFORME_SEDE_MOV" />
		<property name="mostrarPropiedadIntelectual" column="CNP_MOSTRAR_PI" type="boolean" not-null="true"/>
		<property name="tieneOficioElegibles" column="CNP_TIENE_OFICIO_ELEGIBLES" type="yes_no"/>
		<property name="textoOficioElegibles" column="CNP_TEXTO_OFICIO_ELEGIBLES" />
		<property name="fechaOficioElegibles" column="CNP_FECHA_OFICIO_ELEGIBLES" />
		<property name="idPersonaOficioElegibles" column="CNP_PER_ID_OFICIO_ELEGIBLES" />
		<property name="tipoIdPersonaOficioElegibles" column="CNP_TDO_ID_OFICIO_ELEGIBLES" />		
		<property name="tieneOficioAprobados" column="CNP_TIENE_OFICIO_APROBADOS" type="yes_no"/>
		<property name="textoOficioAprobados" column="CNP_TEXTO_OFICIO_APROBADOS" />
		<property name="fechaOficioAprobados" column="CNP_FECHA_OFICIO_APROBADOS" />
		<property name="idPersonaOficioAprobados" column="CNP_PER_ID_OFICIO_APROBADOS" />
		<property name="tipoIdPersonaOficioAprobados" column="CNP_TDO_ID_OFICIO_APROBADOS" />
		<property name="mostrarVigenciaAprobados" column="CNP_MOSTRAR_VIGENCIA_OFICIO_AP" type="yes_no"/>
		<property name="mostrarFirmaAprobados" column="CNP_FIRMA_OFICIO_APROBADOS" type="yes_no"/>
		<property name="responsableOficioAprobados" column="CNP_RESPONS_OFICIO_APROBADOS" />
		<property name="cargoResponsableOficioAprobados" column="CNP_CARGO_RESP_OFICIO_APROBADO" />
		<property name="numeroOficioAprobados" column="CNP_NUMERO_OFICIO_APROBAD" />
		<many-to-one name="dependenciaGeneradoraOficioAprobados" class="Dependencia" column="CNP_DEP_GENERACION_OFICIO_AP" lazy="false" />
		<property name="fechaGeneracionOficioAprobados" column="CNP_FECHA_GENERACION_OFICIO_AP" />
		<property name="vigenciaAprobados" column="CNP_VIGENCIA_OFICIO_APROBADOS" />
		<property name="tipoProyecto" column="CNP_TIPO_PROYECTO" />
		<property name="tipoConvocatoria" column="CNP_TIPO_CONVOCATORIA" />
		<property name="numeroProyectosPorProfesor" column="CNP_NUM_PROY_POR_PROFESOR"/>
		<property name="numeroMovilidadesPorEstudiante" column="CNP_NUM_POR_ESTUDIANTE"/>
	</class>
</hibernate-mapping>
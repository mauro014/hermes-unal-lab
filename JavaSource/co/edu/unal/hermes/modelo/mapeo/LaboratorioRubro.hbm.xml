<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="co.edu.unal.hermes.modelo.laboratorios">

	<class name="LaboratorioRubro" table="HER_LABORATORIO_RUBRO">

		<id name="id" column="HLR_ID" type="long">
			<generator class="sequence">
				<param name="sequence">SEQ_DETALLE</param>
			</generator>
		</id>

		<property name="fechaRegistro" column="HLR_FECHA_REGISTRO" />

		<property name="idLaboratorio" column="LAB_ID" />

		<many-to-one name="tipoRubro" class="co.edu.unal.hermes.modelo.TipoRubro"
			column="TRU_ID" lazy="false" />

		<property name="valor" column="HLR_VALOR" />

		<property name="descripcion" column="HLR_DESCRIPCION" />

		<many-to-one name="fuenteFinanciacion"
			class="co.edu.unal.hermes.modelo.FuenteFinanciacion" column="FFI_ID"
			lazy="false" />

	</class>

</hibernate-mapping>
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 2.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="co.edu.unal.hermes.modelo">
	<class name="Convenio" table="HER_CONVENIO">
		<id name="id" column="CNV_ID" type="long">
			<generator class="sequence">
    			<param name="sequence">SEQ_CONVENIO</param>
   			</generator>
		</id>
		
		<property name="nombre" column="CNV_NOMBRE" type="string"/>
		<property name="objeto" column="CNV_OBJETO" type="string"/>
		<many-to-one name="tipo" class="TipoConvenio" column="TCO_ID"/>
		<many-to-one name="entidad" class="FuenteFinanciacion" column="FFI_ID"/>
		<property name="fechaInicio" column="CNV_FECHA_INICIO"/>
		<property name="fechaFinalizacion" column="CNV_FECHA_FIN"/>
		<property name="estado" column="CNV_ESTADO"/>
		<property name="archivo" column="CNV_ARCHIVO"/>
		
		
		<property name="dependenciaFirma" column="CNV_DEPENDENCIA_FIRMA"/>
		<property name="designadoFirma" column="CNV_DESIGNADO_FIRMA"/>
		<property name="numeroContrato" column="CNV_NUM_CONTRATO"/>		
		<property name="vigenciaContrato" column="CNV_VIGENCIA"/>
		
		<property name="codActividad" column="CNV_COD_ACTIVIDAD"/>
		<property name="especialidadRUP" column="CNV_ESPECIALIDAD_RUP"/>
		<property name="propiedadIntelectual" column="CNV_PROPIEDAD_INTELECT"/>
		<property name="confidencialidad" column="CNV_CONFIDENCIALIDAD"/>
		<property name="clausulaPenal" column="CNV_CLAUSULA_PENAL"/>
		<property name="clausulaMultas" column="CNV_CLAUSULA_MULTAS"/>
		<property name="propiedadBienes" column="CNV_PROPIEDAD_BIENES"/>
		
		<property name="valorTotalContrato" column="CNV_VALOR_TOTAL"/>
		<property name="valorEfectivoContrato" column="CNV_VALOR_EFECTIVO"/>
		<property name="valorEspecieContrato" column="CNV_VALOR_ESPECIE"/>
		<property name="montoEjecutarUN" column="CNV_MONTO_EJECUTAR_UN"/>
		<property name="valorEjecucionUN" column="CNV_VALOR_EJECUCION_UN"/>
		
		<property name="supervisorExterno" column="CNV_SUPERVISOR_EXT"/>
		<property name="supervisorExtCargo" column="CNV_SUPERVISOR_EXT_CARGO"/>
		<property name="supervisorEntidad" column="CNV_SUPERVISOR_ENTIDAD"/>
		<property name="supervisorIntCargo" column="CNV_SUPERVISOR_INT_CARGO"/>
		<property name="supervisorInterno" column="CNV_SUPERVISOR_INTERNO"/>
		<property name="asistenteProyecto" column="CNV_ASISTENTE_PRY"/>
		<property name="asistenteExtension" column="CNV_ASISTENTE_EXTENSION"/>
		<property name="codEntidadExterna" column="CNV_COD_ENT_EXTERNA"/>		
		<property name="asistenteCargo" column="CNV_CARGO_ASISTENTE"/>
		<property name="vigenciaLegalizacion" column="CNV_VIGENCIA_LEG"/>	
		<property name="modalidadContratacion" column="CNV_MODALIDAD_CONTRAT"/>	
		<property name="cargoDesignadoFirma" column="CNV_DESIGNADO_CARGO"/>	
		
		<property name="requiereAutorizacCR" column="CNV_AUTORIZACION_CR"></property>
		<property name="requiereAutorizacCC" column="CNV_AUTORIZACION_CC"></property>
		<property name="requiereAutorizacCI" column="CNV_AUTORIZACION_CI"></property>
			
		<property name="idProyecto" column="PRY_ID" type="long"/> 
        
        <set name="obligaciones" table="HER_CONVENIO_OBLIGACION"
            inverse="true" cascade="all-delete-orphan" lazy="false">
            <key column="CNV_ID" />
            <one-to-many class="ConvenioObligacion" />
        </set>
		
		<set name="otrosi" table="HER_CONVENIO_OTROSI"
            inverse="true" cascade="all-delete-orphan" lazy="false">
            <key column="CNV_ID" />
            <one-to-many class="ConvenioOtrosi" />
        </set>
	</class>
</hibernate-mapping>
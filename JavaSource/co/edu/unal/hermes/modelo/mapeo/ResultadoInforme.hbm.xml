<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="co.edu.unal.hermes.modelo">
 <class name="ResultadoInforme" table="HER_RESULTADO_INFORME">
  <id name="id" column="RIN_ID" type="long">
   <generator class="sequence">
    <param name="sequence">SEQ_RESULTADO_INFORME</param>
   </generator>
  </id>
  <property name="logrado" column="RIN_LOGRADO"/>
  <property name="observaciones" column="RIN_OBSERVACIONES"/>
  <many-to-one name="proyectoInforme" class="ProyectoInforme" column="PIN_ID" not-null="true"/>
  <many-to-one name="resultadoProyecto" class="ResultadoProyecto" column="RST_ID" not-null="true" lazy="false"/>
 </class>
</hibernate-mapping>

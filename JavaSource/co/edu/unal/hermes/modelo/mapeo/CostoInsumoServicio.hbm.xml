<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="co.edu.unal.hermes.modelo.laboratorios">
	<class name="CostoInsumoServicio" table="HER_LAB_COSTOS_INSUMO_SERVICIO">
		<composite-id>
			<key-many-to-one name="costosServicio" class="LaboratorioCostosServicio"
				column="HLCS_ID" lazy="false" />
			<key-many-to-one name="insumo" class="InsumoLaboratorio"
				column="HIL_ID" lazy="false" />
		</composite-id>
		<property name="cantidadUnidadesInsumo" column="HLCIS_CANTIDAD_INSUMO" />
		<property name="costoUnidad" column="HLCIS_COSTO_UNIDAD" />
	</class>
</hibernate-mapping>
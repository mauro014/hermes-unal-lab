<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="co.edu.unal.hermes.modelo.laboratorios">

	<class name="LaboratorioDetallePersona" table="HER_LABORATORIO_DET_PERSONA">

		<id name="id" column="HLDP_ID" type="long">
			<generator class="sequence">
				<param name="sequence">SEQ_DETALLE</param>
			</generator>
		</id>

		<property name="idDetalle" column="LDE_ID" />

		<property name="nombrePersona" column="HLDP_NOMBRE_PERSONA" />

		<property name="tipoDocumento" column="HLDP_TDO_ID" />

		<property name="documento" column="HLDP_PER_ID" />

		<property name="cargo" column="HLDP_CARGO" />

		<property name="fechaRegistro" column="HLDP_FECHA_REGISTRO" />

	</class>

</hibernate-mapping>
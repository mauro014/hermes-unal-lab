<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="co.edu.unal.hermes.modelo">

 <class name="ProyectoSaldoFinanciacion" table="HER_PROYECTO_SAL_FINANCIACION">
 
  <id name="id" column="PSF_ID" type="long">
   <generator class="sequence">
    <param name="sequence">SEQ_PROYECTO_SAL_FINANCIACION</param>
   </generator>
  </id>
   
 
  	<property name="idProyecto" column="PRY_ID" type="long"/>      
	<property name="saldo" column="PSF_VALOR" />  
	
   
 </class>
</hibernate-mapping>







<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="co.edu.unal.hermes.modelo.laboratorios">

	<class name="LaboratorioActividadEquipo" table="HER_LABORATORIO_ACT_EQUIPO">

		<id name="id" column="HLAE_ID" type="long">
			<generator class="sequence">
				<param name="sequence">SEQ_DETALLE</param>
			</generator>
		</id>

		<many-to-one name="equipo"
			class="co.edu.unal.hermes.modelo.laboratorios.LaboratorioDetalleEquipos"
			column="LDE_ID" lazy="false" />

		<property name="fechaRegistro" column="HLAE_FECHA_REGISTRO" />
		
		<property name="fechaActualizacion" column="HLAE_FECHA_ACTUALIZACION" />

		<many-to-one name="tipoActividad" class="co.edu.unal.hermes.modelo.Tipos"
			column="HLAE_TIPO_ACTIVIDAD" lazy="false" />

		<property name="fechaActividad" column="HLAE_FECHA_ACTIVIDAD" />

		<property name="fechaEjecucion" column="HLAE_FECHA_EJECUCION" />

		<property name="observaciones" column="HLAE_OBSERVACIONES" />

		<property name="fechaAlerta" column="HLAE_FECHA_ALERTA" />

		<property name="estadoActividad" column="HLAE_ESTADO_ACTIVIDAD" />

		<property name="costoActividad" column="HLAE_COSTO_ACTIVIDAD" />
		
		<property name="responsable" column="HLAE_RESPONSABLE" />
		
		<property name="activa" column="HLAE_ACTIVA" />
		
		<many-to-one name="modalidad" class="co.edu.unal.hermes.modelo.Tipos"
			column="HLAE_MODALIDAD" lazy="false" />
		
		<property name="alertaEnviada" column="HLAE_ALERTA_ENVIADA" />
		
		<property name="textoAlerta" column="HLAE_TEXTO_ALERTA" />

		<many-to-one name="frecuencia" class="co.edu.unal.hermes.modelo.Tipos"
			column="HLAE_FRECUENCIA" lazy="false" />
		
		<property name="manttoCodInforme" column="HLAE_MANTTO_COD_INFORME" />
		
<!-- 		<many-to-one name="calibEmpresa" class="co.edu.unal.hermes.modelo.Empresa" lazy="false"> -->
<!-- 			<column name="HLAE_CALIB_EMPRESA_CALIB" /> -->
<!-- 		</many-to-one> -->
		
		<property name="calibEmpresa" column="HLAE_CALIB_EMPRESA_CALIB" />
		
		<property name="calibEmpresaAcreditada" column="HLAE_CALIB_EMPRESA_ACRED" />
		
		<property name="calibCodInforme" column="HLAE_CALIB_COD_INFORME" />
		
		<property name="calibIntervaloMed" column="HLAE_CALIB_INTERVALO_MED" />
		
		<property name="calibAdecuadoUso" column="HLAE_CALIB_ADEC_USO" />
		
		<property name="calibAdecuadoUsoNoDesc" column="HLAE_CALIB_ADEC_USO_NO_DESC" />
		
		<property name="programarProximaActividad" column="HLAE_PROGRAM_PROX_ACT" />

	</class>

</hibernate-mapping>
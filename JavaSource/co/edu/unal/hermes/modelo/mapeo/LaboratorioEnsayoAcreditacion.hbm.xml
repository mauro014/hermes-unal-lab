<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="co.edu.unal.hermes.modelo.laboratorios">

	<class name="LaboratorioEnsayoAcreditacion" table="HER_LABORATORIO_ENSAYO_ACR">

		<id name="id" column="LEA_ID" type="long">
			<generator class="sequence">
				<param name="sequence">SEQ_ENSAYO_ACREDITACION</param>
			</generator>
		</id>

		<many-to-one name="proyecto" class="co.edu.unal.hermes.modelo.Proyecto"
			lazy="false">
			<column name="PRY_ID" />
		</many-to-one>

		<property name="nombreEnsayo" column="LEA_NOMBRE_ENSAYO" />
		<property name="areaAcreditacion" column="LEA_AREA_ACREDITACION" />
		<property name="documentoReferencia" column="LEA_DOCUMENTO" />

	</class>

</hibernate-mapping>
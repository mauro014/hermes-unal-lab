<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="co.edu.unal.hermes.modelo">
	<class name="Requerimiento" table="HER_REQUERIMIENTO">
		<id name="id" column="REQ_ID" type="long">
			<generator class="sequence">
				<param name="sequence">SEQ_REQUERIMIENTO</param>
			</generator>
		</id>
		<property name="nombre" column="REQ_NOMBRE" />
		<property name="idPersona" column="PER_ID" />
		<many-to-one name="tipoDoc" column="TDO_ID"
			class="co.edu.unal.hermes.modelo.TipoDocumento" lazy="false" />
		<many-to-one name="idDependencia" column="DPN_ID"
			class="co.edu.unal.hermes.modelo.Dependencia" lazy="false" />
		<property name="personaRequerimiento" column="REQ_PERSONA" />
		<property name="modulo" column="MDL_NOMBRE" />
		<property name="fechaEntrega" column="REQ_FECHA_ENTREGA" />
		<property name="fechaSolicitud" column="REQ_FECHA_SOLICITUD" />
		<property name="estSelRequerimiento" column="REQ_ESTADO" />
		<property name="comentarios" column="REQ_COMENTARIOS" />
		<property name="seqRequerimiento" column="REQ_SECUENCIA" />
		<property name="descripcionSolic" column="REQ_DESCRIPCION" />
		<property name="prioridad" column="REQ_PRIORIDAD" />
		<property name="ingenieroAsignado" column="REQ_RECURSO" />
		<property name="tipo" column="REQ_TIPO" />
		<property name="comentariosIngeniero" column="REQ_COMENTARIOS_ING" />
		<property name="dependenciaAsociada" column="REQ_DEPENDENCIA" />
		<property name="emailSolicitante" column="REQ_EMAIL_SOLICITANTE" />
		<property name="proceso" column="REQ_PROCESO" />
		<property name="observacionesIng" column="REQ_OBSERVACION_ING" />
		<property name="fechaEstimada" column="REQ_FECHA_ESTIMADA" />
		<property name="fechaTramite" column="REQ_FECHA_TRAMITE" />
		<property name="alertaEnviada" column="REQ_ALERTA_ENVIADA" />
		<property name="sprint" column="REQ_SPRINT" />
		<set name="documentos" table="HER_ARCHIVO_REQUERIMIENTO" inverse="true"
			cascade="all-delete-orphan" lazy="false">
			<key column="REQ_ID" />
			<one-to-many class="ArchivoRequerimiento" />
		</set>
	</class>
</hibernate-mapping>
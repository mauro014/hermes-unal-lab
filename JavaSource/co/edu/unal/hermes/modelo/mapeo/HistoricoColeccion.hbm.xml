<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="co.edu.unal.hermes.modelo">

	<class name="HistoricoColeccion" table="HER_HISTORICO_COLECCION">
		<id column="HIC_ID" name="id" type="long">
			<generator class="sequence">
				<param name="sequence">SEQ_HISTORICO_COLECCION</param>
			</generator>
		</id>

		<property name="fecha" column="HIC_FECHA" type="timestamp" />

		<many-to-one name="coleccion" column="COL_ID" class="Coleccion"
			not-null="true" />
	

		<many-to-one name="responsable" class="co.edu.unal.hermes.modelo.Persona"
			lazy="false">
			<column name="PER_ID" />
			<column name="TDO_ID" />
		</many-to-one>

		<property name="justificacion" column="HIC_JUSTIFICACION" />
		<property name="seccionFormulario" column="HIC_SECCION" />
		<property name="estado" column="HIC_ESTADO" />
		

	</class>
</hibernate-mapping>
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="co.edu.unal.hermes.modelo">
	<class name="GruposCursosECP" table="HER_EXT_ECP_GRUPOS_CURSO">
		
		<id name="id" column="ID_GRU_CUR" type="long">
			<generator class="sequence">
				<param name="sequence">SEC_HER_ECP_GRUPO_CURSOS</param>
			</generator>
		</id>

		<many-to-one name="proyecto" column="PRY_ID" class="Proyecto" not-null="true"/>
		<property name="descripcionGrupo" column="GRU_CUR_DESCRIPCION" />
		<property name="numeroAsistentesGrupo" column="GRU_CUR_ASISTENTES" />
		<property name="idCoordinadorGrupo" column="GRU_COORDINADOR_ID" />
		<property name="tipoDocCoordinadorGrupo" column="GRU_COORDINADOR_TDO" />
		
		
		
		<set name="horarioGrupo" table="HER_EXT_ECP_OFERTA_HORARIOS" inverse="true" cascade="all-delete-orphan">
	   		<key column="GRUPO"/>
	   		<one-to-many class="GruposHorariosECP"/>
	  	</set>
		

	</class>
</hibernate-mapping>

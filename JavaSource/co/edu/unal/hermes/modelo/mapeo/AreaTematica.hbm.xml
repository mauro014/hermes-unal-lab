<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="co.edu.unal.hermes.modelo">
	<class name="AreaTematica" table="HER_PROYECTO_AREA_TEMATICA">
		<id name="id" column="ART_ID" type="long">
			<generator class="sequence">
				<param name="sequence">SEQ_PROYECTO_AREA_TEMATICA</param>
			</generator>
		</id>

		<property name="tipo" column="ART_TIPO" />

		<many-to-one name="proyecto" class="Proyecto" column="PRY_ID"
			not-null="true" />

		<many-to-one name="proyectoAreaTematica" class="DominioDetalle" lazy="false">
			<column name="DOM_ID" />
			<column name="DOMDET_TIPO" />
		</many-to-one>
	</class>
</hibernate-mapping>

<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="co.edu.unal.hermes.modelo">
	<class name="ColeccionClasificacion" table="HER_COLECCION_CLASIFICACION">
		<id name="id" column="COC_ID" type="long">
			<generator class="sequence">
				<param name="sequence">SEQ_COLECCION_CLASIFICACION</param>
			</generator>
		</id>
		<many-to-one name="coleccion" class="Coleccion"
			column="COL_ID" not-null="true" lazy="false" />
			
		<many-to-one name="clasificacion" class="DominioDetalle" lazy="false">
			<column name="DOM_ID" />
			<column name="DOMDET_TIPO" />
		</many-to-one>

		<property name="fechaAgregado" column="COC_FECHA" />	
		 
	</class>
</hibernate-mapping>

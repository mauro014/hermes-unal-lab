<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="co.edu.unal.hermes.modelo.seguimiento">
 	<class name="TipoSolicitud" table="HER_TIPO_SOLICITUD">
  		<id name="id" column="TSO_ID" type="long">
   			<generator class="sequence">
         		<param name="sequence">SEQ_TIPO_SOLICITUD</param>
	    	</generator>
	  	</id>
	  	<property name="nombre" column="TSO_NOMBRE" type="string"/>
	  	<property name="descripcion" column="TSO_DESCRIPCION" type="string"/>
	  	<property name="movimientoRubros" column="TSO_MOVIMIENTO_RUBROS" type="string"/>
	  	<property name="vigencia" column="TSO_VIGENCIA" type="string"/>
	  	<property name="desdeVigencia" column="TSO_DESDE_VIGENCIA" type="date"/>
	  	<property name="hastaVigencia" column="TSO_HASTA_VIGENCIA" type="date"/>  
 	</class>
</hibernate-mapping>

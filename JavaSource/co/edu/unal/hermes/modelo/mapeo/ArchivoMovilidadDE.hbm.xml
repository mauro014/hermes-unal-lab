<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 2.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="co.edu.unal.hermes.modelo">
	<class name="ArchivoMovilidadDE" table="HER_ARCHIVO_MOVILIDAD_DE">
		<id name="id" column="AMV_ID" type="long">
			<generator class="sequence">
    			<param name="sequence">SEQ_ARCHIVO</param>
   			</generator>
		</id>

		<many-to-one name="movilidad" class="MovilidadDocentesExterior"  column="MOV_ID" not-null="true" lazy="false"/>
		<many-to-one name="tipoMovilidad" class="TipoMovilidad"  column="MOV_ID_TIPO" not-null="true" lazy="false"/>

		<property name="nombre" column="AMV_NOMBRE" type="string"/>
		<property name="archivo" column="AMV_ARCHIVO" type="blob"/>
		<property name="fecha" column="AMV_FECHA" type="date"/>
		
		<many-to-one name="tipoArchivo" class="TipoArchivoMovilidad"  column="TAM_ID" not-null="true" lazy="false"/>
		
		<many-to-one name="persona" class="co.edu.unal.hermes.modelo.Persona" lazy="false">
			<column name="PER_ID" />
			<column name="TDO_ID" />
		</many-to-one>
		
		
	</class>
</hibernate-mapping>
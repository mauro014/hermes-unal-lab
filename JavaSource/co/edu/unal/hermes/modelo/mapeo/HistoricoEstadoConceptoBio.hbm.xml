<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
                                   
<hibernate-mapping package="co.edu.unal.hermes.modelo">

 <class name="HistoricoEstadoConceptoBio" table="HER_HISTORICO_ESTADO_BIO">
  
  <id column="HEB_ID" name="id" type="long">
  	<generator class="sequence">
         <param name="sequence">SEQ_HISTORICO_ESTADO_BIO</param>
    </generator>
  </id>  
   
  <many-to-one name="revisor" class="co.edu.unal.hermes.modelo.Persona" not-null="true" lazy="false">
	<column name="PER_ID"/>
	<column name="TDO_ID"/>
  </many-to-one>
  
   <many-to-one name="concepto" column="CCB_ID" class="ConceptoContratoBiodiversidad" not-null="true"/>
  
  <property name="fecha" column="HEB_FECHA" type="timestamp"/>
  <property name="justificacion" column="HEB_JUSTIFICACION"/>
  <property name="estadoConcepto" column="HEB_ESTADO"/>

 </class> 
</hibernate-mapping>
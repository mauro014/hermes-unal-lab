<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="co.edu.unal.hermes.modelo">
	<class name="Semillero" table="HER_SEMILLERO">
		<id name="id" column="SEM_ID" type="integer">
			<generator class="sequence">
				<param name="sequence">SEQ_SEMILLERO</param>
			</generator>
		</id>
		<property name="nombre" column="SEM_NOMBRE" />
		<property name="presentacion" column="SEM_PRESENTACION" />
		<property name="fechaRegistro" column="SEM_FECHAREGISTRO" />
		<property name="fechaCreacion" column="SEM_FECHACREACION" />
		<property name="email" column="SEM_EMAIL" />
		<property name="interfacultades" column="SEM_INTERFACULTADES" />
		<property name="intersedes" column="SEM_INTERSEDES" />
		<property name="pertinencia" column="SEM_PERTINENCIA" />
		<property name="objetivoGeneral" column="SEM_OBJETIVO" />
		<property name="justificacion" column="SEM_JUSTIFICACION" />
		<property name="enfoque" column="SEM_ENFOQUE" />
		<property name="areaOCDEPrincipal"
			column="SEM_AREA_OCDE_PRINCIPAL" />
		<property name="subAreaOCDEPrincipal"
			column="SEM_SUBAREA_OCDE_PRINCIPAL" />
		<set name="sedes" table="HER_SEMILLERO_SEDE" inverse="true"
			cascade="all-delete-orphan" lazy="false">
			<key column="SEM_ID" />
			<one-to-many class="SemilleroSede" />
		</set>
		<set name="facultades" table="HER_SEMILLERO_FACULTAD"
			inverse="true" cascade="all-delete-orphan" lazy="false">
			<key column="SEM_ID" />
			<one-to-many class="SemilleroFacultad" />
		</set>
		<set name="objetivosEspecificos" table="HER_SEMILLERO_OBJETIVO"
			inverse="true" cascade="all-delete-orphan" lazy="false">
			<key column="SEM_ID" />
			<one-to-many class="SemilleroObjetivo" />
		</set>
		<set name="grupos" table="HER_SEMILLERO_GRUPO" inverse="true"
			cascade="all-delete-orphan" lazy="false">
			<key column="SEM_ID" />
			<one-to-many class="SemilleroGrupo" />
		</set>
		<set name="laboratorios" table="HER_SEMILLERO_LABORATORIO"
			inverse="true" cascade="all-delete-orphan" lazy="false">
			<key column="SEM_ID" />
			<one-to-many class="SemilleroLaboratorio" />
		</set>
		<set name="integrantes" table="HER_SEMILLERO_INTEGRANTE"
			inverse="true" lazy="false">
			<key column="SEM_ID" />
			<one-to-many class="SemilleroIntegrante" />
		</set>
		<set name="areasOCDESecundarias" table="HER_SEMILLERO_AREA_OCDE"
			inverse="true" cascade="all-delete-orphan" lazy="false">
			<key column="SEM_ID" />
			<one-to-many class="SemilleroAreaOCDE" />
		</set>
		<many-to-one name="agendaPrincipal"
			cascade="all-delete-orphan" class="PosibleAgendaGrupo"
			column="AGG_ID" lazy="false" />
		<set name="agendasSecundarias" table="HER_SEMILLERO_AGENDA"
			inverse="true" cascade="all-delete-orphan" lazy="false">
			<key column="SEM_ID" />
			<one-to-many class="SemilleroAgenda" />
		</set>
		<property name="objetivoDesarrolloSosteniblePrincipal"
			column="SEM_ODS_PRINCIPAL" />
		<property name="objetivoDesarrolloSostenibleSecundario"
			column="SEM_ODS_SECUNDARIO" />
		<set name="lineasInvestigacion" table="HER_SEMILLERO_LINEA"
			inverse="true" cascade="all-delete-orphan" lazy="false">
			<key column="SEM_ID" />
			<one-to-many class="SemilleroLinea" />
		</set>
		<property name="metodologia" column="SEM_METODOLOGIA" />
		<set name="resultados" table="HER_SEMILLERO_RESULTADO"
			inverse="true" cascade="all-delete-orphan" lazy="false">
			<key column="SEM_ID" />
			<one-to-many class="SemilleroResultado" />
		</set>
		<set name="archivos" table="HER_SEMILLERO_ARCHIVO" inverse="true"
			cascade="all-delete-orphan" lazy="false">
			<key column="SEM_ID" />
			<one-to-many class="SemilleroArchivo" />
		</set>
		<property name="fase" column="SEM_FASE" />
		<set name="historicoEstados"
			table="HER_SEMILLERO_HISTORICO_ESTADO" inverse="true"
			cascade="all-delete-orphan" lazy="false">
			<key column="SEM_ID" />
			<one-to-many class="SemilleroHistoricoEstado" />
		</set>
		<set name="solicitudes" table="HER_SEMILLERO_SOLICITUD"
			inverse="true" cascade="all-delete-orphan" lazy="false">
			<key column="SEM_ID" />
			<one-to-many class="SemilleroSolicitud" />
		</set>
		<property name="documentoCoordinador"
			column="INV_ID_COORDINADOR" />
		<property name="tipoDocumentoCoordinador"
			column="TDO_ID_COORDINADOR" />
		<property name="documentoAsesor"
			column="INV_ID_ASESOR" />
		<property name="tipoDocAsesor"
			column="TDO_ID_ASESOR" />
		<property name="fechaCambioCoordinador"
			column="SEM_CAMBIO_COORD" />
		<set name="informes" table="HER_SEMILLERO_INFORME" inverse="true"
			cascade="all-delete-orphan" lazy="false">
			<key column="SEM_ID" />
			<one-to-many class="SemilleroInforme" />
		</set>
		<set name="proyectos" table="HER_SEMILLERO_PROYECTO"
			inverse="true" cascade="all-delete-orphan" lazy="false">
			<key column="SEM_ID" />
			<one-to-many class="SemilleroProyecto" />
		</set>
		<set name="historicoCambios" table="HER_SEMILLERO_HIST_CAMBIOS"
			inverse="true" cascade="all-delete-orphan" lazy="false">
			<key column="SEM_ID" />
			<one-to-many class="SemilleroHistoricoCambios" />
		</set>
	</class>
</hibernate-mapping>
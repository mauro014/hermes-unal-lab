<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 2.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="co.edu.unal.hermes.modelo">
	<class name="TipoPersonaPropiedadIntelectual" table="HER_PROPIEDAD_INT_TIPO_PER">
		<id name="id" column="PTP_ID" type="long">
		</id>
		
		<property name="nombre" column="PTP_NOMBRE" type="string"/>
		<many-to-one name="subTipoPropiedad" class="SubTipoPropiedadIntelectual" column="PIS_ID"/>
		<many-to-one name="tipoPropiedad" class="TipoPropiedadIntelectual" column="PIT_ID"/>
		
	</class>
</hibernate-mapping>
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="co.edu.unal.hermes.modelo">
	<class name="SesionCurso" table="HER_SESION_CURSO">


		<id name="id" column="SES_ID" type="long">
			<generator class="sequence">
				<param name="sequence">SEC_HER_SESION_CURSO</param>
			</generator>
		</id>
		
		<many-to-one name="proyecto" column="PRY_ID" class="Proyecto" not-null="true"/>
		
		<property name="numero" column="SES_NUMERO" />
		<property name="tema" column="SES_TEMA" />
		<property name="contenido" column="SES_CONTENIDO" />
		
		<set name="materiales" table="HER_MATERIAL_SESION" inverse="true" cascade="all-delete-orphan" lazy="false">
	   		<key column="SES_ID"/>
	   		<one-to-many class="materialSesion"/>
	  	</set>

	</class>
</hibernate-mapping>

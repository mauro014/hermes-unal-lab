<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="co.edu.unal.hermes.modelo.laboratorios">

	<class name="LaboratorioDetalleLineasInvestigacion" table="HER_LABORATORIO_DET_LINEA_INV">

		<id name="id" column="LDLI_ID" type="long">
			<generator class="sequence">
				<param name="sequence">SEQ_DETALLE</param>
			</generator>
		</id>

		<many-to-one name="laboratorio"
			class="co.edu.unal.hermes.modelo.laboratorios.Laboratorio" lazy="false">
			<column name="LAB_ID" />
		</many-to-one>

		<many-to-one name="lineaInvestigacion" class="co.edu.unal.hermes.modelo.LineaInvestigacion"
			column="LIN_ID" lazy="false" />

		<property name="fechaRegistro" column="LDLI_FECHA_REGISTRO" />

	</class>

</hibernate-mapping>
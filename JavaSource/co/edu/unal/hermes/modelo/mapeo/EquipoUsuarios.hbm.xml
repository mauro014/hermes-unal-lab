<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="co.edu.unal.hermes.modelo">
 <class name="EquipoUsuarios" table="HER_EQUIPO_USUARIOS">
  
  <composite-id>
                       
            <key-many-to-one name="equipo" class="Equipo" column="EQU_PLACA_INVENTARIO_ID" />
            <key-many-to-one name="vinculacionUsuario" class="VinculacionUN" column="VIU_ID" />
    
            
  </composite-id>

  <property name="cantidadUsuarios" column="EUS_CANTIDAD_USUARIOS"/>
  
   

 </class>
</hibernate-mapping>
 
<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="co.edu.unal.hermes.modelo">
 <class name="EvaluadorCorreo" table="HER_EVALUADOR_CORREO">
  
  <composite-id>
                       
            <key-many-to-one name="proyecto" class="Proyecto" column="PRY_ID" lazy="false"/>
            <key-many-to-one name="investigador" class="Investigador" lazy="false">
              <column name="INV_ID"/>
              <column name="TDO_ID"/>
            </key-many-to-one>
            <!-- key-many-to-one name="investigadorId" class="Investigador" column="INV_ID" /-->
            <!-- key-many-to-one name="tipo" class="Investigador" column="TDO_ID" /-->
            
  </composite-id>
   
  <!-- many-to-one name="proyecto" class="Proyecto" column="PRY_ID" not-null="true" lazy="false"/>
  
  <many-to-one name="evaluador" class="Investigador" not-null="true" lazy="false">
  	<column name="INV_ID"/>
    <column name="TDO_ID"/>
  </many-to-one-->  
    
  <property name="contactado" column="CONTACTADO"/>
  <property name="respuesta" column="RESPUESTA"/>
  <property name="nombre" column="NOMBRE"/> 
 
 </class>
</hibernate-mapping>

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="co.edu.unal.hermes.modelo.laboratorios">
 <class name="LaboratorioMetroMedidaMicro" table="HER_LAB_MEDIDAS_MICROBIO">
  
  <id name="id" column="LMM_ID" type="long">
   <generator class="sequence">
    <param name="sequence">SEQ_LAB_MED_MICROBIO</param>
   </generator>
  </id>
  
  <many-to-one name="laboratorio" class="co.edu.unal.hermes.modelo.laboratorios.Laboratorio" column="LAB_ID" not-null="true" lazy="false"/>
  
  <property name="materialReferenciaCepaUtilizada" column="LMM_MAT_REF_CEPA_USADA" />
  
  <many-to-one name="sector" class="co.edu.unal.hermes.modelo.Tipos" column="LMM_SECTOR" not-null="true" lazy="false"/>
  <many-to-one name="matriz" class="co.edu.unal.hermes.modelo.Tipos" column="LMM_MATRIZ" not-null="true" lazy="false"/>
  <many-to-one name="tipoEnsayo" class="co.edu.unal.hermes.modelo.Tipos" column="LMM_TIPO_ENSAYO" not-null="true" lazy="false"/>
  <many-to-one name="nombreEnsayo" class="co.edu.unal.hermes.modelo.Tipos" column="LMM_NOMBRE_ENSAYO" not-null="true" lazy="false"/>
  <many-to-one name="tecnica" class="co.edu.unal.hermes.modelo.Tipos" column="LMM_TECNICA" not-null="true" lazy="false"/>
  <many-to-one name="normaTecnica" class="co.edu.unal.hermes.modelo.Tipos" column="LMM_NORMA_TECNICA" not-null="true" lazy="false"/>
  <many-to-one name="materialReferenciaCepaCertificada" class="co.edu.unal.hermes.modelo.Tipos" column="LMM_MAT_REF_CEPA_CERT" not-null="true" lazy="false"/>
  
  <property name="validacion" column="LMM_VALIDACION" />
  <property name="validacionDesc" column="LMM_VALIDACION_DESC" />
  <property name="controCalidadMediosCultivo" column="LMM_CONTROL_CALIDAD" />
  <property name="controCalidadMediosCultivoDesc" column="LMM_CONTROL_CALIDAD_DESC" />
  <property name="condicionesAmbientales" column="LMM_COND_AMBIENTALES" />
  <property name="condicionesAmbientalesDesc" column="LMM_COND_AMBIENTALES_DESC" />
  
  <property name="fechaRegistro" column="LMM_FECHA_REGISTRO" />

 </class>
</hibernate-mapping>

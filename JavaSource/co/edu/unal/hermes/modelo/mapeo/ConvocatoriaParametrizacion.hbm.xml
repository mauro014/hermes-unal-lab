<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="co.edu.unal.hermes.modelo">
	<class name="ConvocatoriaParametrizacion" table="HER_CONVOCATORIA_PARAM">
		<id name="id" column="COP_ID" type="long">
			<generator class="sequence">
				<param name="sequence">SEQ_CONVOCATORIA_PARAM</param>
			</generator>
		</id>
		<many-to-one name="convocatoria" class="Convocatoria" column="CON_ID" lazy="false" />
		<many-to-one name="tipoParametro" class="Tipos" column="CON_TIPO_PARAM" lazy="false" />
		<property name="valorParametro" column="CON_VALOR" />
		<many-to-one name="dependencia" class="Dependencia" column="DPN_ID" lazy="false" />
		
		<property name="año" column="COP_ANIO" />
		<many-to-one name="objetoMovilidad" class="TipoPonencia" column="TPO_ID" lazy="false" />
		<property name="montoMaximo" column="COP_MONTO_MAXIMO" />
		<property name="tipoPlanStudios" column="COP_TIPO_PLAN_ESTUDIOS" />
		<many-to-one name="pais" class="Pais" column="PAIS_ID" lazy="false" />
		
		
	</class>
</hibernate-mapping>
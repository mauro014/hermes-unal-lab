<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="co.edu.unal.hermes.modelo">
 <class name="ActividadMovilidad" table="HER_ACTIVIDAD_MOVILIDAD">
  
  <id name="id" column="ACT_MOV_ID" type="long" unsaved-value="-1">
   <generator class="sequence">
    <param name="sequence">SEQ_ACTIVIDAD_MOVILIDAD</param>    					   
   </generator>
  </id>
  
  <property name="descripcion" column="ACT_MOV_DESCRIPCION"/>
  <property name="fecha" column="ACT_MOV_FECHA"/>
  <property name="duracion" column="ACT_MOV_DURACION"/>
  <property name="movilidad" column="MOV_ID"/>
  <property name="tipoActividad" column="MOV_ACT_TIPO"/>
    
 </class>
</hibernate-mapping>




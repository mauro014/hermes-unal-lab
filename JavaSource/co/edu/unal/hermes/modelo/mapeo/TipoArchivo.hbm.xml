<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="co.edu.unal.hermes.modelo">
 <class name="TipoArchivo" table="HER_TIPO_ARCHIVO">
  <id name="id" column="TIA_ID" type="short">
   <generator class="native"/>
  </id>
  <property name="nombre" column="TIA_NOMBRE"/>
  <property name="parametro" column="TIA_PARAMETRO"/>
  <property name="estado" column="TIA_ESTADO"/>
  <property name="obligatorio" column="TIA_OBLIGATORIO"/>
  <property name="convocatoriaExterna" column="TIA_CONVOCATORIA_EXTERNA"/>
 </class>
</hibernate-mapping>

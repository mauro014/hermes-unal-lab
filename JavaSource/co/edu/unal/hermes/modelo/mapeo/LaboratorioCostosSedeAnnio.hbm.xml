<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="co.edu.unal.hermes.modelo.laboratorios">
	<class name="LaboratorioCostosSedeAnnio" table="HER_LAB_COSTOS_SEDE_ANNIO">
		<composite-id>
			<key-property name="annio" column="HLCS_ANNIO" />
			<key-many-to-one name="sede"
				class="co.edu.unal.hermes.modelo.Sede" lazy="false">
				<column name="SED_ID" />
			</key-many-to-one>
		</composite-id>
		<property name="valorkWh" column="HLCS_VALOR_KWH" />
		<property name="valorM2" column="HLCS_VALOR_M2" />
		<property name="valorM3Acueducto" column="HLCS_VALOR_M3_ACUEDUCTO" />
		<property name="valorM3Alcantarillado" column="HLCS_VALOR_M3_ALCANTARILLADO" />
	</class>
</hibernate-mapping>
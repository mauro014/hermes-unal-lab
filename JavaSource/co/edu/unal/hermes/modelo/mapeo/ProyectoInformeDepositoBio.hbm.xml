<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="co.edu.unal.hermes.modelo">
	<class name="ProyectoInformeDepositoBio" table="HER_PROYECTO_INF_DEPOSITO_BIO">
		<id name="id" column="PID_ID" type="long">
			<generator class="sequence">
				<param name="sequence">SEQ_PROYECTO_INF_DEPOSITO_BIO</param>
			</generator>
		</id>

		<many-to-one name="informe" class="ProyectoInforme" column="PIN_ID"
			not-null="true" />
			
		<many-to-one name="coleccion" class="Coleccion"
			column="COL_ID" not-null="true" lazy="false" />

		<property name="tipo" column="PID_TIPO" />
		<property name="numeroespecimenes" column="PID_NRO_ESPECIMENES" />
		
	</class>
</hibernate-mapping>

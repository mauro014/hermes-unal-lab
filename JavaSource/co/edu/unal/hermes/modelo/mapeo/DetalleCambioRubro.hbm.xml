<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="co.edu.unal.hermes.modelo.seguimiento">
 	<class name="DetalleCambioRubro" table="HER_DETALLE_CAMBIO_RUBRO">
  		<id name="id" column="DCR_ID" type="long">
   			<generator class="sequence">
         		<param name="sequence">SEQ_DETALLE_CAMBIO_RUBRO</param>
	    	</generator>
	  	</id>
	  	
	  	<property name="valor" column="DCR_VALOR" type="long"/>
	  	
		<property name="apropiacionOrigen" column="DCR_APROPIACION_ORIGEN" type="long"/>
		<property name="apropiacionDestino" column="DCR_APROPIACION_DESTINO" type="long"/>
		<property name="saldoOrigen" column="DCR_SALDO_ORIGEN" type="long"/>
		<property name="saldoDestino" column="DCR_SALDO_DESTINO" type="long"/>
	  	
	  	<many-to-one name="solicitud" class="Solicitud" column="SOL_ID" not-null="true" lazy="false"/>  
	  	<many-to-one name="gasto" class="co.edu.unal.hermes.modelo.Gasto" column="GST_ID" not-null="true" lazy="false"/>
	  	<many-to-one name="tipoRubro" class="co.edu.unal.hermes.modelo.TipoRubro" column="TRU_ID" not-null="true" lazy="false"/>
 	</class>
</hibernate-mapping>

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 2.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="co.edu.unal.hermes.modelo">
	<class name="ArchivoConvocatoriaExterna" table="HER_ARCHIVO_CONVOCATORIA_EXT">

		<id name="id" column="ACE_ID" type="long">
			<generator class="sequence">
				<param name="sequence">SEQ_ARCHIVO_CONVOCATORIA_EXT</param>
			</generator>
		</id>

		<property name="nombre" column="ACE_NOMBRE" type="string" />
		<property name="convocatoria" column="CEX_ID" />
		<property name="fechaCarga" column="ACE_FECHA_CARGADO" type="date" />
		<property name="fechaElimina" column="ACE_FECHA_ELIMINADO" type="date" />
		<property name="estado" column="ACE_ESTADO" type="string" />
		
		<many-to-one name="personaCarga" class="Persona">
			<column name="PER_ID_CARGA" />
			<column name="TDO_ID_CARGA" />
		</many-to-one>

		<many-to-one name="personaElimina" class="Persona">
			<column name="PER_ID_ELIMINA" />
			<column name="TDO_ID_ELIMINA" />
		</many-to-one>


	</class>
</hibernate-mapping>
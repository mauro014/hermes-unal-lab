<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="co.edu.unal.hermes.modelo">
	<class name="SolicitudFuente" table="HER_SOL_FUENTE">

		<id name="id" column="SLF_ID" type="long">
			<generator class="sequence">
				<param name="sequence">SEQ_SOL_FUENTE</param>
			</generator>
		</id>

		<property name="idSolicitante" column="SPER_SOLICITANTE_ID" />
		<property name="tdoIdSolicitante" column="SPER_SOLICITANTE_TDO_ID" />
		<property name="estado" column="SLF_ESTADO" />
		<property name="fechaRegistro" column="SLF_FECHA_REGISTRO" />
		<property name="idIngeniero" column="SPER_INGENIERO_ID" />
		<property name="tdoIdIngeniero" column="SPER_INGENIERO_TDO_ID" />
		<property name="fechaAtencion" column="SLF_FECHA_ATENCION" />
		<property name="nombreSolicitante" column="SPER_SOLICIT_NOMBRE" />
		<property name="apellidoSolicitante" column="SPER_SOLICIT_APELLIDO" />
		<property name="emailSolicitante" column="SPER_SOLICIT_EMAIL" />
		<property name="idFuenteFinanciacion" column="FFI_ID" />
		
		
	</class>
</hibernate-mapping>

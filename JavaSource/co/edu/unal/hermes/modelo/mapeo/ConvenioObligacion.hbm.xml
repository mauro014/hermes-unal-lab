<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 2.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="co.edu.unal.hermes.modelo">
	<class name="ConvenioObligacion" table="HER_CONVENIO_OBLIGACION">
		<id name="id" column="COB_ID" type="long">
			<generator class="sequence">
				<param name="sequence">SEQ_CONVENIO_OBLIGAC</param>
			</generator>
		</id>

		<property name="obligacion" column="COB_OBLIGACION" type="string" />
		<property name="fecha" column="COB_FECHA" type="date" />
		<many-to-one name="convenio" class="Convenio" column="CNV_ID"
			lazy="false" />
			
	</class>
</hibernate-mapping>
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="co.edu.unal.hermes.modelo">

	<class name="HistoricoEstadoEvaluacion" table="HER_HISTORICO_ESTADO_EVAL">
		<id column="HEV_ID" name="id" type="long">
			<generator class="sequence">
				<param name="sequence">SEQ_HISTORICO_ESTADO_EVAL</param>
			</generator>
		</id>

		<property name="fecha" column="HEV_FECHA" type="timestamp" />
		
		<many-to-one name="proyectoEvaluador" column="PRE_ID" class="ProyectoEvaluador"
			not-null="true" />		

		<property name="estadoEvaluacion" column="PRE_ESTADO_EVALUACION" />

		<property name="observaciones" column="HEV_OBSERVACIONES" />
		
		<many-to-one name="responsable" class="co.edu.unal.hermes.modelo.Persona"
			lazy="false">
			<column name="HEV_PER_ID" />
			<column name="HEV_TDO_ID" />
		</many-to-one>

	</class>
</hibernate-mapping>
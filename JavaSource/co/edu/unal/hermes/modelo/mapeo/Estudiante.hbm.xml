<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="co.edu.unal.hermes.modelo">
	<class name="Estudiante" table="HER_TMP_ESTUDIANTE">
		<composite-id class="IdPersona" name="id" unsaved-value="none">
			<key-property name="documento" column="EST_ID" />
			<key-property name="tipoDocumento" column="TDO_ID" />
		</composite-id>
		<many-to-one name="estadoCivil" class="EstadoCivil"
			column="ECI_ID" not-null="true" />
		<many-to-one name="ciudadDomicilio" class="Ciudad"
			column="CIU_DOMICILIO_ID" not-null="true" lazy="false" />
		<many-to-one name="ciudadNacimiento" class="Ciudad"
			column="CIU_NACIMIENTO_ID" />
		<many-to-one name="ciudadExpedicion" class="Ciudad"
			column="CIU_EXPEDICION_ID" />
		<property name="nombre1" column="EST_NOMBRE1" />
		<property name="nombre2" column="EST_NOMBRE2" />
		<property name="apellido1" column="EST_APELLIDO1" />
		<property name="apellido2" column="EST_APELLIDO2" />
		<property name="genero" column="EST_GENERO" />
		<property name="email" column="EST_EMAIL" />
		<property name="direccion" column="EST_DIRECCION" />
		<property name="telefono" column="EST_TELEFONO" />
		<property name="fechaNacimiento" column="EST_FNACIMIENTO" />
		<property name="nombreCarrera" column="EST_NOMBRE_CARRERA" />
		<property name="semestreActual" column="EST_SEMESTRE_ACTUAL" />
		<many-to-one name="categoriaInvestigador" class="CategoriaInvestigador"
			column="CAT_ID" not-null="true" />
		<property name="interno" column="EST_INTERNO" />
		<property name="papa" column="EST_PAPA" />
		<many-to-one name="dependencia" class="Dependencia"
			column="DPN_ID" lazy="false" />
		<many-to-one name="plan" class="PlanEstudios" column="EST_PLAN"
			lazy="false" />
	</class>
</hibernate-mapping>

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="co.edu.unal.hermes.modelo">

	<class name="Campus" table="HER_CAMPUS">

		<id name="id" column="CAMPUS_ID" type="long">
			<generator class="native" />
		</id>

		<property name="nombre" column="CAMPUS_NOMBRE" />

		<many-to-one name="sede" class="Sede" lazy="false">
			<column name="SED_ID" />
		</many-to-one>
		
		<property name="direccion" column="CAMPUS_DIRECCION" />
		
		<property name="telefono" column="CAMPUS_TELEFONO" />

	</class>

</hibernate-mapping>

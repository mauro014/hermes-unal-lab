<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="co.edu.unal.hermes.modelo">
	<class name="TipoRequisito" table="HER_TIPO_REQUISITO">
		<id name="id" column="TPR_ID" type="long">
			<generator class="sequence">
				<param name="sequence">SEQ_TIPO_REQUISITO</param>
			</generator>
		</id>
		<many-to-one name="padre" class="TipoRequisito" column="TPR_ID_PADRE" />
		<property name="nombre" column="TPR_NOMBRE" />
		<property name="seleccion" column="REQ_SELECCION" />
		<property name="descripcion" column="TPR_DESCRIPCION"></property>
	</class>
</hibernate-mapping>

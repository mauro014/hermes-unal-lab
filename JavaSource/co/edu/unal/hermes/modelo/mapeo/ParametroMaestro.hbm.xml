<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="co.edu.unal.hermes.modelo">
 <class name="ParametroMaestro" table="HER_PARAMETRO_MAESTRO">
  <id name="id" column="ID" type="long">
   <generator class="sequence">
    <param name="sequence">SEQ_PARAMETRO_MAESTRO</param>
   </generator>
  </id>
  <property name="descripcion" column="DESCRIPCION"/>
  <property name="valor" column="VALOR"/>
  <property name="nombre" column="NOMBRE"/>
  <property name="infoAdicional" column="INFORMACION_ADICIONAL"/>
 </class>
</hibernate-mapping>

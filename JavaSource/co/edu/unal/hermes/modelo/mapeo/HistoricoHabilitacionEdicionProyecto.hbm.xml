<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
                                   
<hibernate-mapping package="co.edu.unal.hermes.modelo">

 <class name="HistoricoHabilitacionEdicionProyecto" table="HER_HIST_HAB_EDI_PROYECTO">
  
  <id column="HHP_ID" name="id" type="long">
  	<generator class="sequence">
         <param name="sequence">SEQ_HIST_HAB_EDI_PROYECTO</param>
    </generator>
  </id>
  <many-to-one name="proyecto" column="PRY_ID" class="Proyecto" not-null="true"/>
 
  <many-to-one name="coordinador" class="co.edu.unal.hermes.modelo.Persona" not-null="true" lazy="false">
	<column name="PER_ID_COORDINADOR"/>
	<column name="TDO_ID_COORDINADOR"/>
  </many-to-one>
  
  <property name="fecha" column="HHP_FECHA"/>
  <property name="asignacion" column="HHP_ASIGNACION"/>
  <property name="comentarios" column="HHP_COMENTARIOS"/>
  
 </class> 
</hibernate-mapping>
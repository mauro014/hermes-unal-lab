<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="co.edu.unal.hermes.modelo.laboratorios">
 <class name="LaboratorioMetroGrupoTrabajo" table="HER_LAB_GRUPOS_TRABAJO">
  
  <id name="id" column="LGT_ID" type="long">
   <generator class="sequence">
    <param name="sequence">SEQ_LAB_GRUPOS_TRABAJO</param>
   </generator>
  </id>
  
   <many-to-one name="laboratorio" class="co.edu.unal.hermes.modelo.laboratorios.Laboratorio" column="LAB_ID" not-null="true" lazy="false"/>  
  
  <property name="nombre" column="LGT_NOMBRE_GRUPO" />
  
  <many-to-one name="tipoGrupo" class="co.edu.unal.hermes.modelo.Tipos" column="LGT_TIPO_GRUPO" not-null="true" lazy="false"/>
  <many-to-one name="periodoParticipacion" class="co.edu.unal.hermes.modelo.Tipos" column="LGT_PERIODO_PARTICIP" not-null="true" lazy="false"/>
  
  <property name="fechaRegistro" column="LGT_FECHA_REGISTRO" />

 </class>
</hibernate-mapping>

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="co.edu.unal.hermes.modelo.laboratorios">

	<class name="LaboratorioDetalleInsumos" table="HER_LABORATORIO_DET_INSUMO">

		<id name="id" column="LDI_ID" type="long">
			<generator class="sequence">
				<param name="sequence">SEQ_LAB_DET_INSUMO_LAB</param>
			</generator>
		</id>

		<many-to-one name="laboratorio"
			class="co.edu.unal.hermes.modelo.laboratorios.Laboratorio" lazy="false">
			<column name="LAB_ID" />
		</many-to-one>

		<many-to-one name="insumo" class="co.edu.unal.hermes.modelo.laboratorios.InsumoLaboratorio"
			column="HIL_ID" lazy="false" />
		
		<property name="consumo" column="LDI_CONSUMO" />
		<property name="almacenamiento" column="LDI_ALMACENAMIENTO" />
		<property name="mes" column="LDI_MES" />
		<property name="annio" column="LDI_ANNIO" />
		<property name="fechaRegistro" column="LDI_FECHA_REGISTRO" />
		<property name="fechaActualizacion" column="LDI_FECHA_ACTUALIZACION" />
		
		<many-to-one name="actividadManejo" class="co.edu.unal.hermes.modelo.Tipos"
			column="LDI_ACTIVIDAD_MANEJO" lazy="false" />
			
		<many-to-one name="proveedor" class="co.edu.unal.hermes.modelo.Empresa"
			column="LDI_PROVEEDOR" lazy="false" />
			
		<property name="descActividadConsumo" column="LDI_DESC_ACT_CONSUMO" />
		<property name="almacenamientoDetalle" column="LDI_ALMACENAMIENTO_DETALLE" />
		
		<many-to-one name="unidadMedida" class="co.edu.unal.hermes.modelo.Tipos"
			column="LDI_UNIDAD_MEDIDA" lazy="false" />
		<many-to-one name="unidadConcentracion" class="co.edu.unal.hermes.modelo.Tipos"
			column="LDI_UNIDAD_CONCENTRACION" lazy="false" />
		<property name="valorConcentracion" column="LDI_VALOR_CONCENTRACION" />

	</class>

</hibernate-mapping>
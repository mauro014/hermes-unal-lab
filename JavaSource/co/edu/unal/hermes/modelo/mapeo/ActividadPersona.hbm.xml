<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="co.edu.unal.hermes.modelo">
 <class name="ActividadPersona" table="HER_ACTIVIDAD_PERSONA">
  <id name="id" column="ACP_ID" type="long">
   <generator class="sequence">
    <param name="sequence">SEQ_ACTIVIDAD_PERSONA</param>
   </generator>
  </id>
  
  <many-to-one name="actividad" class="Actividad" column="ACT_ID" not-null="true" lazy="false"/>
  <many-to-one name="investigador" class="Investigador" not-null="true" lazy="false">
  	<column name="INV_ID"/>
    <column name="TDO_ID"/>
  </many-to-one>
  
  <property name="semanaInicial" column="ACP_SEMANA_INICIAL"/>
  <property name="duracionSemanas" column="ACP_DURACION_SEMANAS"/>
  <property name="inversion" column="ACP_INVERSION"/>
 </class>
</hibernate-mapping>

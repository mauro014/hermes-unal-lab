<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 2.0//EN"
                                   "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="co.edu.unal.hermes.modelo">
	<class name="ArchivoInforme" table="HER_ARCHIVO_INFORME">
		<id name="id" column="AIN_ID" type="long">
			<generator class="sequence">
    			<param name="sequence">SEQ_ARCHIVO_INFORME</param>
   			</generator>
		</id>

		<many-to-one name="informe" class="ProyectoInforme"  column="PIN_ID" not-null="true" lazy="false"/>

		<property name="nombre" column="AIN_NOMBRE" type="string"/>
		<property name="archivo" column="AIN_ARCHIVO" type="blob"/>
		<property name="descripcion" column="AIN_DESCRIPCION" type="string"/>
		<property name="estado" column="AIN_ESTADO" type="string"/>
		<property name="fecha" column="AIN_FECHA" type="date"/>
		<property name="fechaEliminacion" column="AIN_FECHA_ELIMINACION" type="date" /> 
		<many-to-one name="tipoArchivo" class="TipoArchivo" column="TIA_ID" not-null="false" lazy="false"/>
		<many-to-one name="responsable" class="co.edu.unal.hermes.modelo.Persona" 
		  	lazy="false">
			<column name="PER_ID"/>
			<column name="TDO_ID"/>
		</many-to-one>	
		<many-to-one name="responsableEliminacion" class="co.edu.unal.hermes.modelo.Persona" 
		  	lazy="false">
			<column name="PER_ID_ELIMINACION"/>
			<column name="TDO_ID_ELIMINACION"/>
		</many-to-one>	 
	</class>
</hibernate-mapping>